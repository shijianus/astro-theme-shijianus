# ==========================================
# EpoCanvas / shijianus Blog Environment Configuration
# ==========================================
# 复制此文件为 .env (本地 Astro 开发) 或 .dev.vars (Wrangler Pages 本地开发)
# 生产环境请在 Cloudflare Pages 控制台 (Settings -> Environment variables) 中配置

# ------------------------------------------
# Telegram Bot 通知配置 (敏感凭证，严禁硬编码)
# ------------------------------------------
# 从 @BotFather 获取的 Bot Token
TELEGRAM_BOT_TOKEN=

# 接收赞赏通知的 Telegram Chat ID 或 User ID (可通过 @userinfobot 获取)
TELEGRAM_CHAT_ID=

# ------------------------------------------
# Stripe 国际收银台配置 (敏感凭证，严禁硬编码)
# ------------------------------------------
# Stripe Secret Key (以 sk_live_ 或 sk_test_ 开头)
STRIPE_SECRET_KEY=

# Stripe Publishable Key (以 pk_live_ 或 pk_test_ 开头，公开给前端使用)
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------
# 加密货币 & 备用支付通道配置 (公开信息)
# ------------------------------------------
PUBLIC_USDT_ARBITRUM_ADDRESS=
PUBLIC_USDT_TRC20_ADDRESS=
PUBLIC_USDT_ERC20_ADDRESS=
PUBLIC_PAYPAL_ME_URL=
PUBLIC_PAYPAL_UK_ME_URL=
