# ==========================================
# EpoCanvas / shijianus Blog Environment Configuration
# ==========================================
# 复制此文件为 .env (本地 Astro 开发) 或 .dev.vars (Wrangler Pages 本地开发)
# 生产环境请在 Cloudflare Pages 控制台 (Settings -> Environment variables) 中配置

# ------------------------------------------
# Telegram Bot 通知配置 (敏感凭证，严禁硬编码)
# ------------------------------------------
# 从 @BotFather 获取的 Bot Token
TELEGRAM_BOT_TOKEN=

# 接收赞赏通知的 Telegram Chat ID 或 User ID (可通过 @userinfobot 获取)
TELEGRAM_CHAT_ID=

# ------------------------------------------
# Stripe 国际收银台配置 (敏感凭证，严禁硬编码)
# ------------------------------------------
# Stripe Secret Key (以 sk_live_ 或 sk_test_ 开头)
STRIPE_SECRET_KEY=

# Stripe Publishable Key (以 pk_live_ 或 pk_test_ 开头，公开给前端使用)
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------
# 加密货币 & 备用支付通道配置 (公开信息)
# ------------------------------------------
PUBLIC_USDT_ARBITRUM_ADDRESS=
PUBLIC_USDT_TRC20_ADDRESS=
PUBLIC_USDT_ERC20_ADDRESS=
PUBLIC_PAYPAL_ME_URL=
PUBLIC_PAYPAL_UK_ME_URL=

# ------------------------------------------
# AI 辅助全站广播与构建更新日志配置 (可选)
# ------------------------------------------
# 是否开启构建前 AI 自动对比 Git 变更并撰写通告 (默认关闭: false)
ENABLE_AI_BROADCAST=false

# AI API Key (兼容 OpenAI / DeepSeek / Moonshot / Qwen 等)
AI_BROADCAST_API_KEY=

# API 端点基础 URL (默认 https://api.openai.com/v1，如 DeepSeek 可设 https://api.deepseek.com/v1)
AI_BROADCAST_BASE_URL=https://api.openai.com/v1

# 模型名称 (默认 deepseek-chat 或 gpt-4o-mini)
AI_BROADCAST_MODEL=deepseek-chat

# ------------------------------------------
# AI 总结档位控制 (AI Summary Tier Level)
# ------------------------------------------
# 档位选择: low (低档-省token默认) | medium (中档-架构剖析) | high (高档-全量正文知识库与自由总结)
# 默认未设置时自动降级为低档位 (low)，站长可随时修改此变量在 low / medium / high 之间无缝切换
AI_SUMMARY_LEVEL=high

# ------------------------------------------
# AI 总结模型选择与模型池控制 (Model Selection & Pool)
# ------------------------------------------
# 1. 固定指定模型节点方式（例如设为 kimi-k3-free, openai/gpt-oss-120b, deepseek-v4-pro-free 等，方便需要固定某个模型的场景）
# AI_SUMMARY_FIXED_MODEL=

# ------------------------------------------
# ChronralAI / Instance AI API 配置 (与 AI 摘要共用)
# ------------------------------------------
# API 密钥，兼容 OpenAI 格式 (ChronralAI, DeepSeek, Moonshot, Qwen 等)
INSTANCE_AI_API_KEY=

# API 端点基础 URL (默认 https://ai.121628.xyz/v1)
INSTANCE_AI_BASE_URL=https://ai.121628.xyz/v1

# 默认模型名称 (默认 kimi-k3-free)
INSTANCE_AI_MODEL=kimi-k3-free

# Groq API 配置 (备用高速 API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------
# AI 辅助文章多语言 (i18n) 构建配置 (内置接口，默认关闭)
# ------------------------------------------
# 是否开启构建时 AI 自动检测并生成缺失的 i18n 文章版本 (默认关闭: false)
#
# 完整逻辑：
#   1. 扫描所有 Markdown 文章，按 i18nKey 分组
#   2. 用户手写的各语言版本具有最高优先级，严禁覆盖
#   3. 若目标语言文章缺失，调用 ChronralAI 接口自动生成
#   4. 生成文件写入 src/content/posts/ 并标记 isAiGenerated: true
#   5. 构建后部署的网站将展示对应语言的文章版本
#
# 如何触发：将下方 ENABLE_ARTICLE_AI_I18N 设为 true 并执行 npm run build
# 构建前执行 npm run sync:i18n 可单独测试翻译流程（不触发完整 Astro 构建）
#
ENABLE_ARTICLE_AI_I18N=false

# 目标生成语言列表 (以逗号分隔)
# 支持：en, fr, es, de, zh-Hant
# 示例：en,fr,de
ARTICLE_AI_I18N_LOCALES=en

# 文章 i18n 作用域过滤 (可选)
# 以逗号分隔文章的 i18nKey 或 slug，留空则自动处理所有缺失翻译的文章
# 示例：ARTICLE_AI_I18N_POSTS=hello-world,my-article
# ARTICLE_AI_I18N_POSTS=

# 专属文章 i18n API 配置 (可选)
# 若未配置，默认与 ChronralAI 共用同一个 API 接口 (INSTANCE_AI_* 或 GROQ_*)
# ARTICLE_AI_I18N_API_KEY=
# ARTICLE_AI_I18N_BASE_URL=https://ai.121628.xyz/v1
# ARTICLE_AI_I18N_MODEL=kimi-k3-free
