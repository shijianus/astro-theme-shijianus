// Solara Player Integration Styles
#nav-music
  .solara-current-song-info
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    display: flex
    flex-direction: column
    align-items: center
    justify-content: center
    text-align: center
    opacity: 0
    transition: opacity 0.3s ease
    padding: 5px
    box-sizing: border-box
    background-color: rgba(0,0,0,0.7) // Semi-transparent background
    border-radius: 50% // Match the button's shape

    .solara-album-cover
      width: 40px
      height: 40px
      border-radius: 50%
      object-fit: cover
      margin-bottom: 5px
      box-shadow: 0 0 5px rgba(0,0,0,0.5)

    .solara-song-details
      display: flex
      flex-direction: column
      color: var(--anzhiyu-white)
      font-size: 0.7em
      .solara-song-title
        font-weight: bold
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis
        width: 100%
      .solara-artist-name
        font-size: 0.9em
        color: var(--anzhiyu-meta-font-color) // Lighter color for artist
        white-space: nowrap
        overflow: hidden
        text-overflow: ellipsis
        width: 100%

  &:hover .solara-current-song-info
    opacity: 1 // Show song info on hover

  .solara-search-button
    position: absolute
    bottom: 5px
    right: 5px
    background: var(--anzhiyu-main)
    color: var(--anzhiyu-white)
    border: none
    border-radius: 50%
    width: 24px
    height: 24px
    display: flex
    align-items: center
    justify-content: center
    cursor: pointer
    opacity: 0.8
    transition: opacity 0.3s ease
    i
      font-size: 0.8em

    &:hover
      opacity: 1

// Music Search Modal Styles
#music-search-modal
  display: none
  position: fixed
  z-index: 1000
  left: 0
  top: 0
  width: 100%
  height: 100%
  overflow: auto
  background-color: rgba(0,0,0,0.4) // Dark overlay

  .anzhiyu-modal-content
    background-color: var(--anzhiyu-card-bg)
    margin: 10% auto
    padding: 20px
    border: 1px solid #888
    width: 80%
    max-width: 600px
    border-radius: 10px
    box-shadow: 0 5px 15px rgba(0,0,0,0.3)
    position: relative

    .anzhiyu-modal-header
      display: flex
      justify-content: space-between
      align-items: center
      padding-bottom: 10px
      border-bottom: 1px solid var(--anzhiyu-border-color)

      h2
        margin: 0
        color: var(--anzhiyu-font-color)

      .close-button
        color: #aaa
        font-size: 28px
        font-weight: bold
        cursor: pointer
        &:hover, &:focus
          color: #000
          text-decoration: none
          cursor: pointer

    .anzhiyu-modal-body
      padding: 20px 0

      .music-search-input-group
        display: flex
        margin-bottom: 15px

        input
          flex-grow: 1
          padding: 8px 12px
          border: 1px solid var(--anzhiyu-border-color)
          border-radius: 5px 0 0 5px
          font-size: 1em
          outline: none
          background-color: var(--anzhiyu-bg-color)
          color: var(--anzhiyu-font-color)

          &:focus
            border-color: var(--anzhiyu-main)

        button
          background-color: var(--anzhiyu-main)
          color: var(--anzhiyu-white)
          border: none
          padding: 8px 15px
          border-radius: 0 5px 5px 0
          cursor: pointer
          font-size: 1em
          transition: background-color 0.3s ease

          &:hover
            background-color: darken(var(--anzhiyu-main), 10%)

      .music-search-results
        max-height: 300px
        overflow-y: auto
        border: 1px solid var(--anzhiyu-border-color)
        border-radius: 5px
        padding: 10px
        background-color: var(--anzhiyu-bg-color)

        .music-search-result-item
          display: flex
          justify-content: space-between
          align-items: center
          padding: 8px 0
          border-bottom: 1px dashed var(--anzhiyu-border-color)
          &:last-child
            border-bottom: none

          .song-info
            flex-grow: 1
            display: flex
            flex-direction: column
            color: var(--anzhiyu-font-color)

            .song-title
              font-weight: bold
              white-space: nowrap
              overflow: hidden
              text-overflow: ellipsis

            .song-artist
              font-size: 0.85em
              color: var(--anzhiyu-meta-font-color)
              white-space: nowrap
              overflow: hidden
              text-overflow: ellipsis

          button
            background-color: var(--anzhiyu-main)
            color: var(--anzhiyu-white)
            border: none
            border-radius: 3px
            padding: 5px 10px
            margin-left: 10px
            cursor: pointer
            font-size: 0.9em
            transition: background-color 0.3s ease

            &:hover
              background-color: darken(var(--anzhiyu-main), 10%)

            &.add-to-playlist-btn
              background-color: var(--anzhiyu-blue)
            &.play-song-btn
              background-color: var(--anzhiyu-green)

      .loading-spinner
        display: flex
        align-items: center
        justify-content: center
        padding: 20px
        color: var(--anzhiyu-font-color)
        i
          margin-right: 10px
          font-size: 1.5em

    .anzhiyu-modal-footer
      padding-top: 15px
      border-top: 1px solid var(--anzhiyu-border-color)
      text-align: right

      button
        background-color: var(--anzhiyu-theme-color) // Use a neutral color or theme color
        color: var(--anzhiyu-white)
        border: none
        border-radius: 5px
        padding: 10px 20px
        cursor: pointer
        font-size: 1em
        transition: background-color 0.3s ease

        &:hover
          background-color: darken(var(--anzhiyu-theme-color), 10%)