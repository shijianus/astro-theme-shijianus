---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import LoadingScreen from '../components/LoadingScreen.astro';
import { SiteHeader } from '../components/SiteHeader';
import AnzhiyuDashboardIcon from '../components/AnzhiyuDashboardIcon.astro';
import { ThemeDock } from '../components/ThemeDock';
import { ThemeOverlays } from '../components/ThemeOverlays';
import { ThemeUniverse } from '../components/ThemeUniverse';
import { ShortcutPanel } from '../components/ShortcutPanel';
import LocaleRuntime from '../components/LocaleRuntime.astro';
import CodeBlockEnhancer from '../components/CodeBlockEnhancer.astro';
import MindmapEnhancer from '../components/MindmapEnhancer.astro';
import Footer from '../components/theme/Footer.astro';
import { MusicPocket } from '../components/theme/MusicPocket';
import Sidebar from '../components/theme/Sidebar.astro';
import MobileTocDrawer from '../components/theme/MobileTocDrawer.astro';
import { getExcerpt, getPostPath, resolveCategory, resolveCover, estimateWordCount, estimateReadingMinutes } from '../lib/content';
import {
  getCommentsProviderLabel,
  hasConfiguredCommentDatabase,
  isRemoteDatabaseConfigured,
} from '../lib/comment-integration';
import { type SidebarData, createSidebarData } from '../lib/theme';
import '../styles/global.css';
import '../styles/rebuild.css';
import '../styles/final-pass.css';
import '../styles/runtime-widgets.css';
import 'katex/dist/katex.min.css';
import '../styles/markdown-enhancements.css';

interface Props {
  title: string;
  description?: string;
  showAside?: boolean;
  sidebarData?: SidebarData;
  pageType?: string;
}

const {
  title,
  description = siteConfig.site.description,
  showAside = true,
  sidebarData,
  pageType = 'page',
} = Astro.props;

// Fetch global data for overlays to ensure they are populated on all routes
const allPosts = await getCollection('posts');

// Data slimming: map posts to essential fields to reduce payload and memory usage
const slimPosts = allPosts.map((post) => {
  // We MUST calculate these before we lose the body
  const wordCount = estimateWordCount(post);
  const readingMinutes = estimateReadingMinutes(post);
  
  return {
    ...post,
    body: post.data.description || '', // Drop full body
    data: {
      ...post.data,
      wordCount, // Pass these along if createSidebarData can use them, 
      readingMinutes, // but SidebarData doesn't natively support them in CollectionEntry.
    }
  };
});

// Since createSidebarData recalculates metrics from the body, 
// and we just emptied the body, we should probably calculate the totals here 
// and pass them to Sidebar or modify createSidebarData.

// Actually, let's just calculate the totals here and override globalData.
const totalReadingMinutes = allPosts.reduce((acc, post) => acc + estimateReadingMinutes(post), 0);
const totalWords = allPosts.reduce((acc, post) => acc + estimateWordCount(post), 0);

const globalData = createSidebarData(slimPosts as any);
globalData.totalReadingMinutes = totalReadingMinutes;
globalData.totalWords = totalWords;

const overlayPosts = globalData.recentPosts.map((entry) => ({
  title: entry.data.title,
  href: getPostPath(entry),
  description: getExcerpt(entry, 96),
  category: resolveCategory(entry),
  cover: resolveCover(entry),
  date: entry.data.pubDate.toLocaleDateString('zh-CN'),
}));

const overlayTags = globalData.tags.map((tag) => ({
  label: tag.label,
  href: `/tags/${tag.slug}/`,
  count: tag.count,
}));

const overlayArchives = globalData.archives;

const overlayStats = {
  posts: globalData.totalPosts ?? 0,
  categories: globalData.totalCategories ?? 0,
  tags: globalData.totalTags ?? 0,
  readingMinutes: globalData.totalReadingMinutes ?? 0,
  totalWords: globalData.totalWords ?? 0,
};

const overlayFeatures = {
  searchPanel: siteConfig.theme.features.searchPanel,
  centerConsole: siteConfig.theme.features.centerConsole,
  rightClickMenu: siteConfig.theme.features.rightClickMenu,
  particles: false,
};

const consolePanel = {
  enabled: siteConfig.theme.consolePanel.enabled,
  defaultOpen: siteConfig.theme.consolePanel.defaultOpen,
  disabledNotice: siteConfig.theme.consolePanel.disabledNotice,
};

const commentsEnabled = hasConfiguredCommentDatabase(siteConfig.integrations.comments);
const remoteDbConfigured = isRemoteDatabaseConfigured(siteConfig.integrations.comments);
const remoteCommentConnected = siteConfig.integrations.comments.provider !== 'local' && commentsEnabled;
const accountPanel = {
  enabled: true,
  remoteConnected: remoteCommentConnected,
  providerLabel: remoteCommentConnected ? getCommentsProviderLabel(siteConfig.integrations.comments) : '本地身份',
  title: siteConfig.post.comments.accountTitle,
  summary: siteConfig.post.comments.accountSummary,
  disabledNotice: siteConfig.post.comments.disabledNotice,
  loginHint: siteConfig.post.comments.loginHint,
};

const bodyClasses = ['theme-body'];
const rawRuntimeApiBase = process.env.PUBLIC_RUNTIME_API_BASE?.trim() || '';
const runtimeApiBase = rawRuntimeApiBase.replace(/\/api\/?$/, '');
const musicApiBase = runtimeApiBase ? `${runtimeApiBase}/api` : '/api';
if (overlayFeatures.centerConsole && consolePanel.enabled && consolePanel.defaultOpen) {
  bodyClasses.push('theme-overlay-open');
}
---

<!doctype html>
<html
  lang={siteConfig.site.locale}
  data-theme={siteConfig.theme.defaultMode}
  data-aside="expanded"
  data-background={siteConfig.theme.background.defaultMode}
  data-locale-variant={siteConfig.site.locale}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} | {siteConfig.site.title}</title>
    <link rel="stylesheet" href="/fonts/anzhiyu/anzhiyu-iconfont.css" />
    <slot name="head" />
    <script is:inline>
      (() => {
        try {
          const savedVariant = window.localStorage.getItem('shijianus-locale-variant');
          const localeVariant = savedVariant === 'zh-Hant' || savedVariant === 'en' ? savedVariant : 'zh-CN';
          document.documentElement.dataset.localeVariant = localeVariant;
          document.documentElement.lang = localeVariant;
        } catch {
          document.documentElement.dataset.localeVariant = 'zh-CN';
          document.documentElement.lang = 'zh-CN';
        }
      })();
    </script>
    <script is:inline>
      // Page Visibility API: pause CSS background animations when tab is hidden
      // This works with the animation-play-state rules in final-pass.css
      (() => {
        const setVisible = () => {
          document.documentElement.dataset.pageVisible = document.hidden ? 'false' : 'true';
        };
        setVisible();
        document.addEventListener('visibilitychange', setVisible);
      })();
    </script>
  </head>
  <body class:list={bodyClasses} data-type={pageType}>
    {siteConfig.theme.features.loadingScreen && (
      <LoadingScreen brandName={siteConfig.site.name} avatar={siteConfig.site.author.avatar} />
    )}

    <div id="web_bg" aria-hidden="true"></div>
    <ThemeUniverse client:visible />

    <div class="page" id="body-wrap">
      <SiteHeader
        client:idle
        brandName={siteConfig.site.name}
        domainLabel={siteConfig.site.domainLabel}
        currentPath={Astro.url.pathname}
        primary={siteConfig.navigation.primary}
        utility={siteConfig.navigation.utility}
        quickActions={siteConfig.navigation.quickActions}
        showCenterConsoleTrigger={siteConfig.theme.features.centerConsole}
        showNotificationTrigger={true}
        isAccountEnabled={remoteDbConfigured && accountPanel.enabled}
        hasDatabase={commentsEnabled}
      >
        <AnzhiyuDashboardIcon slot="consoleIcon" />
      </SiteHeader>

      <main id="blog-container">
        {Astro.slots.has('hero') && (
          <div class="page-shell__hero">
            <slot name="hero" />
          </div>
        )}

        <div id="content-inner" class:list={['layout', showAside && sidebarData ? 'page-grid--with-aside' : '']}>
          <main class="page-main">
            <slot />
          </main>

          {showAside && sidebarData && (
            <aside class="page-aside">
              <div class="page-aside__sticky">
                <Sidebar {...sidebarData} pageType={pageType} />
              </div>
            </aside>
          )}
        </div>
      </main>

      <Footer stats={overlayStats} />

      {pageType === 'post' && sidebarData?.headings && sidebarData.headings.length > 0 && (
        <MobileTocDrawer headings={sidebarData.headings} />
      )}

      <ThemeDock
        client:visible
        defaultBackground={siteConfig.theme.background.defaultMode}
        darkBackground={siteConfig.theme.background.darkMode}
        backgroundModes={siteConfig.theme.background.modes}
        pageType={pageType}
      />
      <MusicPocket client:visible apiBase={musicApiBase} />
      <ThemeOverlays
        client:idle
        brandName={siteConfig.site.name}
        authorName={siteConfig.site.author.name}
        authorMotto={siteConfig.site.author.motto}
        posts={overlayPosts}
        tags={overlayTags}
        archives={overlayArchives}
        navItems={siteConfig.navigation.primary}
        quickActions={siteConfig.navigation.quickActions}
        stats={overlayStats}
        features={overlayFeatures}
        particleCount={siteConfig.post.hero.motionParticles}
        defaultBackground={siteConfig.theme.background.defaultMode}
        darkBackground={siteConfig.theme.background.darkMode}
        backgroundModes={siteConfig.theme.background.modes}
        pageType={pageType}
        consolePanel={consolePanel}
        accountPanel={accountPanel}
      />
      <LocaleRuntime />
      <CodeBlockEnhancer />
      <MindmapEnhancer />
      <ShortcutPanel client:idle />
    </div>

    <!-- Global Universal Activity & Anzhiyu Snackbar Notification (对应 id="nav" 顶部位置展示) -->
    <div
      id="global-activity-bar"
      class="snackbar-container snackbar-css snackbar-pos top-center"
      aria-live="polite"
      role="status"
    >
      <p id="global-activity-message"></p>
      <button type="button" class="action" id="global-activity-action" style="display: none;">知道了</button>
    </div>

    <script
      is:inline
      define:vars={{
        snackbarDefaultDuration: siteConfig.theme.snackbar.duration,
        snackbarMinRecommended: siteConfig.theme.snackbar.minRecommendedDuration,
        snackbarMaxRecommended: siteConfig.theme.snackbar.maxRecommendedDuration,
      }}
    >
      (() => {
        let timer = null;
        let lastMsg = '';
        let lastTime = 0;
        const bar = document.getElementById('global-activity-bar');
        const text = document.getElementById('global-activity-message');
        const actionBtn = document.getElementById('global-activity-action');

        const MIN_SAFE_DURATION = 1000;
        const MAX_SAFE_DURATION = 4000;
        const DEFAULT_DURATION = snackbarDefaultDuration || 2000;

        const hideActivity = () => {
          if (timer) {
            clearTimeout(timer);
            timer = null;
          }
          if (bar) {
            bar.classList.remove('show');
          }
        };

        const showActivity = (
          message,
          showActionFunction = false,
          customDuration = DEFAULT_DURATION,
          actionText = false
        ) => {
          if (!message || typeof message !== 'string' || !message.trim()) return;
          const cleanMsg = message.trim();
          lastMsg = cleanMsg;
          lastTime = Date.now();

          // Parameter polymorphism normalization
          let duration = DEFAULT_DURATION;
          let onAction = null;
          let actionLabel = '';

          if (typeof showActionFunction === 'number') {
            duration = showActionFunction;
            if (typeof customDuration === 'string') actionLabel = customDuration;
          } else {
            if (typeof showActionFunction === 'function') {
              onAction = showActionFunction;
            }
            if (typeof customDuration === 'number') {
              duration = customDuration;
            }
            if (typeof actionText === 'string') {
              actionLabel = actionText;
            } else if (typeof customDuration === 'string' && typeof showActionFunction !== 'number') {
              actionLabel = customDuration;
            }
          }

          // Safety check & Console Warning for optimal duration interval
          if (duration < MIN_SAFE_DURATION) {
            console.warn(
              `[Snackbar Warning] 提示持续时间 (${duration}ms) 过短（推荐 >= ${snackbarMinRecommended || 1500}ms，默认 2000ms）。读者人眼可能无法完整获取与阅读提示内容。`
            );
          } else if (duration > MAX_SAFE_DURATION) {
            console.warn(
              `[Snackbar Warning] 提示持续时间 (${duration}ms) 过长（推荐 <= ${snackbarMaxRecommended || 3500}ms，默认 2000ms）。长时间占用顶部导航栏（#nav）可能遮挡重要导航与菜单交互。`
            );
          }

          // Update CSS timer animation variable
          document.documentElement.style.setProperty('--anzhiyu-snackbar-time', `${duration}ms`);
          document.documentElement.style.setProperty('--site-snackbar-time', `${duration}ms`);

          if (text) {
            text.textContent = cleanMsg;
          }

          if (actionBtn) {
            if (actionLabel || onAction) {
              actionBtn.textContent = actionLabel || '知道了';
              actionBtn.style.display = 'inline-flex';
              actionBtn.onclick = (e) => {
                e.stopPropagation();
                if (typeof onAction === 'function') {
                  try {
                    onAction();
                  } catch (err) {
                    console.error('[Snackbar Action Error]', err);
                  }
                }
                hideActivity();
              };
            } else {
              actionBtn.style.display = 'none';
              actionBtn.onclick = null;
            }
          }

          if (bar) {
            bar.classList.remove('show');
            void bar.offsetWidth; // Reflow to reset and trigger smooth progress bar animation
            bar.classList.add('show');
          }

          if (timer) clearTimeout(timer);
          timer = setTimeout(() => {
            hideActivity();
          }, duration);
        };

        // Click on snackbar anywhere to quickly dismiss and restore full navbar access
        if (bar) {
          bar.addEventListener('click', (e) => {
            if (e.target === actionBtn) return;
            hideActivity();
          });
        }

        // Global interfaces (support standard showToast, Anzhiyu snackbarShow, and window.anzhiyu)
        window.showToast = (msg, duration, actionText, onAction) => {
          if (typeof duration === 'function') {
            showActivity(msg, duration, actionText, onAction);
          } else {
            showActivity(msg, onAction, duration, actionText);
          }
        };

        window.snackbarShow = (text, showActionFunction = false, duration = DEFAULT_DURATION, actionText = false) => {
          showActivity(text, showActionFunction, duration, actionText);
        };

        window.anzhiyu = window.anzhiyu || {};
        window.anzhiyu.snackbarShow = window.snackbarShow;

        window.addEventListener('shijianus:activity', (event) => {
          const detail = event?.detail;
          if (typeof detail === 'string') {
            showActivity(detail);
          } else if (detail && typeof detail === 'object') {
            const message = detail.message || '';
            const duration = typeof detail.duration === 'number' ? detail.duration : DEFAULT_DURATION;
            const actionText = detail.actionText || false;
            const onAction = typeof detail.onAction === 'function' ? detail.onAction : false;
            showActivity(message, onAction, duration, actionText);
          }
        });

        document.addEventListener('copy', () => {
          if (Date.now() - lastTime < 500 && lastMsg.includes('复制')) return;
          showActivity('已复制当前内容到剪贴板');
        });
      })();
    </script>

    <script src="../scripts/sticky-sidebar.ts"></script>

    <script is:inline>
      (() => {
        const DEFAULT_LOCAL_FALLBACK = '/media/shijianus/default.png';
        const DEFAULT_REMOTE_FALLBACK =
          'https://drawing.shijian.qzz.io/file/AgACAgEAAyEGAAS6jkJbAAMUapQaP6X-fJmi1j0qYD5NgooECLwAAlEMaxuQM6BEoSo1dHbP8ioBAAMCAAN3AAM9BA.png';

        const handleImageError = (image) => {
          if (!(image instanceof HTMLImageElement)) return;
          const currentSrc = image.src;
          if (currentSrc === DEFAULT_REMOTE_FALLBACK) return;

          const localFallback = image.getAttribute('data-fallback-src') || DEFAULT_LOCAL_FALLBACK;
          const remoteFallback = image.getAttribute('data-remote-fallback-src') || DEFAULT_REMOTE_FALLBACK;

          const step = Number(image.dataset.fallbackStep || '0');
          if (step === 0) {
            image.dataset.fallbackStep = '1';
            if (!currentSrc.endsWith(localFallback)) {
              image.src = localFallback;
              return;
            }
          }
          image.dataset.fallbackStep = '2';
          image.src = remoteFallback;
        };

        const bindMediaFallbacks = (root = document) => {
          root.querySelectorAll('img').forEach((image) => {
            if (!(image instanceof HTMLImageElement)) return;
            if (image.dataset.fallbackBound === 'true') return;
            image.dataset.fallbackBound = 'true';

            image.addEventListener('error', () => {
              handleImageError(image);
            });
          });

          root.querySelectorAll('video[data-fallback-src]').forEach((video) => {
            if (!(video instanceof HTMLVideoElement)) return;
            if (video.dataset.fallbackBound === 'true') return;
            video.dataset.fallbackBound = 'true';

            video.addEventListener('error', () => {
              const fallbackSrc = video.getAttribute('data-fallback-src') || DEFAULT_LOCAL_FALLBACK;
              const nextImage = document.createElement('img');
              nextImage.src = fallbackSrc;
              nextImage.alt = document.title;
              nextImage.loading = 'eager';
              nextImage.decoding = 'async';
              nextImage.setAttribute('data-fallback-src', fallbackSrc);
              nextImage.setAttribute('data-remote-fallback-src', DEFAULT_REMOTE_FALLBACK);
              nextImage.className = video.className.replace(/\bpost-hero__video\b/g, 'post-hero__image');
              video.replaceWith(nextImage);
              bindMediaFallbacks(nextImage.parentElement || document);
            }, { once: true });
          });
        };

        window.addEventListener('error', (event) => {
          if (event.target instanceof HTMLImageElement) {
            handleImageError(event.target);
          }
        }, true);

        bindMediaFallbacks();
        document.addEventListener('astro:page-load', () => bindMediaFallbacks());
      })();
    </script>

    <script is:inline>
      (() => {
        const isInteractiveTarget = (target) => {
          return target instanceof HTMLElement && Boolean(target.closest('a, button, input, textarea, select, summary, details, [data-ignore-card-link]'));
        };

        const getElementTarget = (target) => {
          if (target instanceof HTMLElement) return target;
          if (target instanceof Node) return target.parentElement;
          return null;
        };

        const navigateFromCard = (card) => {
          const href = card?.dataset?.cardLink;
          if (!href) return;
          window.location.href = href;
        };

        document.addEventListener('click', (event) => {
          const target = getElementTarget(event.target);
          if (!(target instanceof HTMLElement)) return;
          if (window.getSelection?.()?.toString()) return;
          if (isInteractiveTarget(target)) return;

          const card = target.closest('[data-card-link]');
          if (!(card instanceof HTMLElement)) return;
          navigateFromCard(card);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          const target = getElementTarget(event.target);
          if (!(target instanceof HTMLElement)) return;
          if (isInteractiveTarget(target) && !target.matches('[data-card-link]')) return;

          const card = target.closest('[data-card-link]');
          if (!(card instanceof HTMLElement)) return;
          event.preventDefault();
          navigateFromCard(card);
        });
      })();
    </script>
  </body>
</html>
