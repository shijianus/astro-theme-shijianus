---
import { siteConfig } from '../config/site';
import { LoadingScreen } from '../components/LoadingScreen';
import { SiteHeader } from '../components/SiteHeader';
import { ThemeDock } from '../components/ThemeDock';
import { ThemeOverlays } from '../components/ThemeOverlays';
import Footer from '../components/theme/Footer.astro';
import Sidebar from '../components/theme/Sidebar.astro';
import { getExcerpt, getPostPath, resolveCategory, resolveCover } from '../lib/content';
import type { SidebarData } from '../lib/theme';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  showAside?: boolean;
  sidebarData?: SidebarData;
}

const {
  title,
  description = siteConfig.site.description,
  showAside = true,
  sidebarData,
} = Astro.props;

const overlayPosts =
  sidebarData?.recentPosts.map((entry) => ({
    title: entry.data.title,
    href: getPostPath(entry),
    description: getExcerpt(entry, 96),
    category: resolveCategory(entry),
    cover: resolveCover(entry),
    date: entry.data.pubDate.toLocaleDateString('zh-CN'),
  })) ?? [];

const overlayTags =
  sidebarData?.tags.map((tag) => ({
    label: tag.label,
    href: `/tags/${tag.slug}/`,
    count: tag.count,
  })) ?? [];

const overlayArchives = sidebarData?.archives ?? [];

const overlayStats = {
  posts: sidebarData?.totalPosts ?? 0,
  categories: sidebarData?.totalCategories ?? 0,
  tags: sidebarData?.totalTags ?? 0,
  readingMinutes: sidebarData?.totalReadingMinutes ?? 0,
};

const overlayFeatures = {
  searchPanel: siteConfig.theme.features.searchPanel,
  centerConsole: siteConfig.theme.features.centerConsole,
  rightClickMenu: siteConfig.theme.features.rightClickMenu,
  particles: siteConfig.theme.features.particles,
};
---

<!doctype html>
<html lang={siteConfig.site.locale} data-theme={siteConfig.theme.defaultMode} data-aside="expanded">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title} | {siteConfig.site.title}</title>
  </head>
  <body class="theme-body" data-type="shijianus">
    {siteConfig.theme.features.loadingScreen && (
      <LoadingScreen
        client:load
        brandName={siteConfig.site.name}
        avatar={siteConfig.site.author.avatar}
        durationMs={siteConfig.theme.motion.pageRevealDurationMs}
      />
    )}

    <div id="web_bg" aria-hidden="true"></div>

    <div class="page" id="body-wrap">
      <SiteHeader
        client:load
        brandName={siteConfig.site.name}
        domainLabel={siteConfig.site.domainLabel}
        currentPath={Astro.url.pathname}
        primary={siteConfig.navigation.primary}
        utility={siteConfig.navigation.utility}
        quickActions={siteConfig.navigation.quickActions}
      />

      <main id="blog-container">
        {Astro.slots.has('hero') && (
          <div class="page-shell__hero">
            <slot name="hero" />
          </div>
        )}

        <div id="content-inner" class:list={['layout', showAside && sidebarData ? 'page-grid--with-aside' : '']}>
          <main class="page-main">
            <slot />
          </main>

          {showAside && sidebarData && (
            <aside class="page-aside">
              <div class="page-aside__sticky">
                <Sidebar {...sidebarData} />
              </div>
            </aside>
          )}
        </div>
      </main>

      <Footer />

      <ThemeDock client:load />
      <ThemeOverlays
        client:load
        brandName={siteConfig.site.name}
        authorName={siteConfig.site.author.name}
        authorMotto={siteConfig.site.author.motto}
        posts={overlayPosts}
        tags={overlayTags}
        archives={overlayArchives}
        navItems={siteConfig.navigation.primary}
        quickActions={siteConfig.navigation.quickActions}
        stats={overlayStats}
        features={overlayFeatures}
        particleCount={siteConfig.theme.motion.heroParticles}
      />
    </div>
  </body>
</html>
