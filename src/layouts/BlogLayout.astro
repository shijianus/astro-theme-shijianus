---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import LoadingScreen from '../components/LoadingScreen.astro';
import { SiteHeader } from '../components/SiteHeader';
import { ThemeDock } from '../components/ThemeDock';
import { ThemeOverlays } from '../components/ThemeOverlays';
import { ThemeUniverse } from '../components/ThemeUniverse';
import { StickySidebarObserver } from '../components/StickySidebarObserver';
import LocaleRuntime from '../components/LocaleRuntime.astro';
import CodeBlockEnhancer from '../components/CodeBlockEnhancer.astro';
import Footer from '../components/theme/Footer.astro';
import { MusicPocket } from '../components/theme/MusicPocket';
import Sidebar from '../components/theme/Sidebar.astro';
import { getExcerpt, getPostPath, resolveCategory, resolveCover } from '../lib/content';
import {
  getCommentsProviderLabel,
  hasConfiguredCommentDatabase,
  isRemoteDatabaseConfigured,
} from '../lib/comment-integration';
import { type SidebarData, createSidebarData } from '../lib/theme';
import '../styles/global.css';
import '../styles/rebuild.css';
import '../styles/final-pass.css';
import '../styles/runtime-widgets.css';
import '../styles/alignment.css';

interface Props {
  title: string;
  description?: string;
  showAside?: boolean;
  sidebarData?: SidebarData;
  pageType?: string;
}

const {
  title,
  description = siteConfig.site.description,
  showAside = true,
  sidebarData,
  pageType = 'page',
} = Astro.props;

// Fetch global data for overlays to ensure they are populated on all routes
const allPosts = await getCollection('posts');
const globalData = createSidebarData(allPosts);

const overlayPosts = globalData.recentPosts.map((entry) => ({
  title: entry.data.title,
  href: getPostPath(entry),
  description: getExcerpt(entry, 96),
  category: resolveCategory(entry),
  cover: resolveCover(entry),
  date: entry.data.pubDate.toLocaleDateString('zh-CN'),
}));

const overlayTags = globalData.tags.map((tag) => ({
  label: tag.label,
  href: `/tags/${tag.slug}/`,
  count: tag.count,
}));

const overlayArchives = globalData.archives;

const overlayStats = {
  posts: globalData.totalPosts ?? 0,
  categories: globalData.totalCategories ?? 0,
  tags: globalData.totalTags ?? 0,
  readingMinutes: globalData.totalReadingMinutes ?? 0,
  totalWords: globalData.totalWords ?? 0,
};

const overlayFeatures = {
  searchPanel: siteConfig.theme.features.searchPanel,
  centerConsole: siteConfig.theme.features.centerConsole,
  rightClickMenu: siteConfig.theme.features.rightClickMenu,
  particles: false,
};

const consolePanel = {
  enabled: siteConfig.theme.consolePanel.enabled,
  defaultOpen: siteConfig.theme.consolePanel.defaultOpen,
  disabledNotice: siteConfig.theme.consolePanel.disabledNotice,
};

const commentsEnabled = hasConfiguredCommentDatabase(siteConfig.integrations.comments);
const remoteDbConfigured = isRemoteDatabaseConfigured(siteConfig.integrations.comments);
const remoteCommentConnected = siteConfig.integrations.comments.provider !== 'local' && commentsEnabled;
const accountPanel = {
  enabled: true,
  remoteConnected: remoteCommentConnected,
  providerLabel: remoteCommentConnected ? getCommentsProviderLabel(siteConfig.integrations.comments) : '本地身份',
  title: siteConfig.post.comments.accountTitle,
  summary: siteConfig.post.comments.accountSummary,
  disabledNotice: siteConfig.post.comments.disabledNotice,
  loginHint: siteConfig.post.comments.loginHint,
};

const bodyClasses = ['theme-body'];
const rawRuntimeApiBase = process.env.PUBLIC_RUNTIME_API_BASE?.trim() || '';
const runtimeApiBase = rawRuntimeApiBase.replace(/\/api\/?$/, '');
const musicApiBase = runtimeApiBase ? `${runtimeApiBase}/api` : '/api';
if (overlayFeatures.centerConsole && consolePanel.enabled && consolePanel.defaultOpen) {
  bodyClasses.push('theme-overlay-open');
}
---

<!doctype html>
<html
  lang={siteConfig.site.locale}
  data-theme={siteConfig.theme.defaultMode}
  data-aside="expanded"
  data-background={siteConfig.theme.background.defaultMode}
  data-locale-variant={siteConfig.site.locale}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} | {siteConfig.site.title}</title>
    <link rel="stylesheet" href="https://unpkg.com/anzhiyu-theme-static@1.1.9/icon/ali_iconfont_css.css" />
    <slot name="head" />
    <script is:inline>
      (() => {
        try {
          const savedVariant = window.localStorage.getItem('shijianus-locale-variant');
          const localeVariant = savedVariant === 'zh-Hant' || savedVariant === 'en' ? savedVariant : 'zh-CN';
          document.documentElement.dataset.localeVariant = localeVariant;
          document.documentElement.lang = localeVariant;
        } catch {
          document.documentElement.dataset.localeVariant = 'zh-CN';
          document.documentElement.lang = 'zh-CN';
        }
      })();
    </script>
  </head>
  <body class:list={bodyClasses} data-type={pageType}>
    {siteConfig.theme.features.loadingScreen && (
      <LoadingScreen brandName={siteConfig.site.name} avatar={siteConfig.site.author.avatar} />
    )}

    <div id="web_bg" aria-hidden="true"></div>
    {pageType === 'home' && <ThemeUniverse client:visible />}

    <div class="page" id="body-wrap">
      <SiteHeader
        client:load
        brandName={siteConfig.site.name}
        domainLabel={siteConfig.site.domainLabel}
        currentPath={Astro.url.pathname}
        primary={siteConfig.navigation.primary}
        utility={siteConfig.navigation.utility}
        quickActions={siteConfig.navigation.quickActions}
        showCenterConsoleTrigger={siteConfig.theme.features.centerConsole}
        showNotificationTrigger={true}
        isAccountEnabled={remoteDbConfigured && accountPanel.enabled}
        hasDatabase={commentsEnabled}
      />

      <main id="blog-container">
        {Astro.slots.has('hero') && (
          <div class="page-shell__hero">
            <slot name="hero" />
          </div>
        )}

        <div id="content-inner" class:list={['layout', showAside && sidebarData ? 'page-grid--with-aside' : '']}>
          <main class="page-main">
            <slot />
          </main>

          {showAside && sidebarData && (
            <aside class="page-aside">
              <div class="page-aside__sticky">
                <Sidebar {...sidebarData} pageType={pageType} />
              </div>
            </aside>
          )}
        </div>
      </main>

      <Footer stats={overlayStats} />

      <ThemeDock
        client:visible
        defaultBackground={siteConfig.theme.background.defaultMode}
        darkBackground={siteConfig.theme.background.darkMode}
        backgroundModes={siteConfig.theme.background.modes}
        pageType={pageType}
      />
      <MusicPocket client:visible apiBase={musicApiBase} />
      <ThemeOverlays
        client:visible
        brandName={siteConfig.site.name}
        authorName={siteConfig.site.author.name}
        authorMotto={siteConfig.site.author.motto}
        posts={overlayPosts}
        tags={overlayTags}
        archives={overlayArchives}
        navItems={siteConfig.navigation.primary}
        quickActions={siteConfig.navigation.quickActions}
        stats={overlayStats}
        features={overlayFeatures}
        particleCount={siteConfig.post.hero.motionParticles}
        defaultBackground={siteConfig.theme.background.defaultMode}
        darkBackground={siteConfig.theme.background.darkMode}
        backgroundModes={siteConfig.theme.background.modes}
        pageType={pageType}
        consolePanel={consolePanel}
        accountPanel={accountPanel}
      />
      <LocaleRuntime />
      <CodeBlockEnhancer />
      <StickySidebarObserver pageType={pageType} client:load />
    </div>

    <script is:inline>
      (() => {
        const bindMediaFallbacks = (root = document) => {
          root.querySelectorAll('img[data-fallback-src]').forEach((image) => {
            if (!(image instanceof HTMLImageElement)) return;
            if (image.dataset.fallbackBound === 'true') return;
            image.dataset.fallbackBound = 'true';

            image.addEventListener('error', () => {
              const fallbackSrc = image.getAttribute('data-fallback-src') || '';
              if (!fallbackSrc || image.src.endsWith(fallbackSrc)) return;
              image.src = fallbackSrc;
            });
          });

          root.querySelectorAll('video[data-fallback-src]').forEach((video) => {
            if (!(video instanceof HTMLVideoElement)) return;
            if (video.dataset.fallbackBound === 'true') return;
            video.dataset.fallbackBound = 'true';

            video.addEventListener('error', () => {
              const fallbackSrc = video.getAttribute('data-fallback-src') || '';
              if (!fallbackSrc) return;

              const nextImage = document.createElement('img');
              nextImage.src = fallbackSrc;
              nextImage.alt = document.title;
              nextImage.loading = 'eager';
              nextImage.decoding = 'async';
              nextImage.setAttribute('data-fallback-src', fallbackSrc);
              nextImage.className = video.className.replace(/\bpost-hero__video\b/g, 'post-hero__image');
              video.replaceWith(nextImage);
            }, { once: true });
          });
        };

        bindMediaFallbacks();
      })();
    </script>

    <script is:inline>
      (() => {
        const isInteractiveTarget = (target) => {
          return target instanceof HTMLElement && Boolean(target.closest('a, button, input, textarea, select, summary, details, [data-ignore-card-link]'));
        };

        const getElementTarget = (target) => {
          if (target instanceof HTMLElement) return target;
          if (target instanceof Node) return target.parentElement;
          return null;
        };

        const navigateFromCard = (card) => {
          const href = card?.dataset?.cardLink;
          if (!href) return;
          window.location.href = href;
        };

        document.addEventListener('click', (event) => {
          const target = getElementTarget(event.target);
          if (!(target instanceof HTMLElement)) return;
          if (window.getSelection?.()?.toString()) return;
          if (isInteractiveTarget(target)) return;

          const card = target.closest('[data-card-link]');
          if (!(card instanceof HTMLElement)) return;
          navigateFromCard(card);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return;
          const target = getElementTarget(event.target);
          if (!(target instanceof HTMLElement)) return;
          if (isInteractiveTarget(target) && !target.matches('[data-card-link]')) return;

          const card = target.closest('[data-card-link]');
          if (!(card instanceof HTMLElement)) return;
          event.preventDefault();
          navigateFromCard(card);
        });
      })();
    </script>
  </body>
</html>
