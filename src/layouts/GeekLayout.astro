---
import { ProfileWidget } from '../components/ProfileWidget';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-[#050505] text-white selection:bg-primary/30 selection:text-primary">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | SmartKevin's Lab</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="font-sans antialiased overflow-x-hidden min-h-screen">
		<!-- Cyber Background -->
		<div class="fixed inset-0 -z-50 overflow-hidden">
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(17,24,39,1),rgba(3,7,18,1))]" />
			<div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]" />
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] bg-primary/20 blur-[120px] rounded-full opacity-30 pointer-events-none animate-pulse" />
		</div>

		<nav class="sticky top-0 z-50 border-b border-white/5 bg-black/50 backdrop-blur-xl">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
				<div class="flex items-center gap-8">
					<a href="/" class="group flex items-center gap-2">
						<div class="h-8 w-8 rounded-lg bg-gradient-to-br from-primary to-accent flex items-center justify-center font-bold text-black group-hover:rotate-12 transition-transform">
							SK
						</div>
						<span class="text-xl font-extrabold tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-white to-gray-400">
							SMARTKEVIN
						</span>
					</a>
					<div class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-400">
						<a href="/posts" class="hover:text-primary transition-colors">ARCHIVES</a>
						<a href="/categories" class="hover:text-primary transition-colors">SPACES</a>
						<a href="/about" class="hover:text-primary transition-colors">TERMINAL</a>
					</div>
				</div>
				<div class="flex items-center gap-4">
					<div class="h-8 w-24 rounded-full bg-white/5 border border-white/10 flex items-center px-3 gap-2">
						<div class="h-2 w-2 rounded-full bg-green-500 animate-pulse" />
						<span class="text-[10px] font-mono text-gray-400">ONLINE</span>
					</div>
				</div>
			</div>
		</nav>

		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 lg:grid-cols-12 gap-8">
			<div class="lg:col-span-8 space-y-12">
				<slot />
			</div>
			<aside class="lg:col-span-4 space-y-8">
				<ProfileWidget client:load />
				<div class="p-6 rounded-3xl bg-white/5 border border-white/10 space-y-4">
					<h3 class="text-sm font-bold text-gray-400 uppercase tracking-widest">Recent Activity</h3>
					<div class="space-y-4">
						{[1, 2, 3].map((i) => (
							<div class="flex items-start gap-3 text-sm">
								<div class="mt-1.5 h-1.5 w-1.5 rounded-full bg-primary shadow-[0_0_8px_rgba(var(--primary-rgb),0.8)]" />
								<div>
									<p class="text-gray-300">Ported Anzhiyu UI to Astro</p>
									<span class="text-[10px] text-gray-500 uppercase tracking-wider">2 HOURS AGO</span>
								</div>
							</div>
						))}
					</div>
				</div>
			</aside>
		</main>

		<footer class="border-t border-white/5 bg-black/50 py-12">
			<div class="max-w-7xl mx-auto px-4 text-center">
				<p class="text-sm text-gray-500">© 2026 SMARTKEVIN. BUILT WITH ASTRO + REACT + TAILWIND.</p>
			</div>
		</footer>

		<style is:global>
			:root {
				--primary-rgb: 59, 130, 246;
				--accent-rgb: 139, 92, 246;
			}
			@theme {
				--color-primary: oklch(0.7 0.2 250);
				--color-accent: oklch(0.6 0.2 300);
			}
			.font-mono {
				font-family: 'Fira Code', monospace;
			}
			.custom-scrollbar::-webkit-scrollbar {
				width: 6px;
				height: 6px;
			}
			.custom-scrollbar::-webkit-scrollbar-track {
				background: transparent;
			}
			.custom-scrollbar::-webkit-scrollbar-thumb {
				background: #333;
				border-radius: 10px;
			}
			.custom-scrollbar::-webkit-scrollbar-thumb:hover {
				background: #444;
			}
		</style>
	</body>
</html>
