---
interface Props {
  brandName: string;
  avatar: string;
}

const { brandName, avatar } = Astro.props;
---

<div id="loading-box" aria-hidden="true">
  <div class="loading-bg">
    <div class="loading-stars" aria-hidden="true">
      {Array.from({ length: 10 }).map((_, index) => (
        <span style={`--i:${index};--x:${8 + ((index * 29) % 84)}%;--y:${12 + ((index * 37) % 76)}%`}></span>
      ))}
    </div>
    <div class="loading-orbit" aria-hidden="true"></div>
    <img class="loading-img" alt={`${brandName} loading avatar`} src={avatar} />
    <div class="loading-image-dot"></div>
    <p class="loading-title">{brandName}</p>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const loadingBox = document.getElementById('loading-box');
    if (!loadingBox) return;

    let ended = false;
    const startedAt = performance.now();
    const sessionKey = 'shijianus-loader-seen';
    const hasSeenLoader = () => {
      try {
        return sessionStorage.getItem(sessionKey) === 'true';
      } catch {
        return false;
      }
    };
    const markSeen = () => {
      try {
        sessionStorage.setItem(sessionKey, 'true');
      } catch {}
    };

    // 若当前会话已完成过加载过场，或在同站点内流转，坚决不二次弹出遮挡，即时清理
    if (hasSeenLoader()) {
      loadingBox.style.setProperty('display', 'none', 'important');
      loadingBox.style.setProperty('pointer-events', 'none', 'important');
      root.classList.add('theme-ready');
      loadingBox.remove();
      return;
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const compactViewport = window.innerWidth < 540;
    // 首次进站顺畅体验：桌面约 680ms，移动端约 520ms，平滑自然过渡
    const minimumDuration = prefersReducedMotion ? 0 : (compactViewport ? 520 : 680);
    const removeDelay = 380;

    const preloadVisuals = () => {
      const candidates = Array.from(
        document.querySelectorAll('img[src], [data-preload-image]')
      )
        .map((node) => {
          if (!(node instanceof HTMLElement)) return '';
          if (node instanceof HTMLImageElement) return node.currentSrc || node.src;
          return node.dataset.preloadImage || '';
        })
        .filter(Boolean)
        .slice(0, 12);

      candidates.forEach((src) => {
        const img = new Image();
        img.decoding = 'async';
        img.src = src;
      });
    };

    loadingBox.classList.add('is-first-visit');

    const endLoading = () => {
      if (ended) return;
      const complete = () => {
        if (ended) return;
        ended = true;
        root.classList.add('theme-ready');
        markSeen();
        loadingBox.classList.add('loaded');
        window.setTimeout(() => {
          loadingBox.remove();
        }, removeDelay);
      };

      const elapsed = performance.now() - startedAt;
      const remaining = Math.max(0, minimumDuration - elapsed);
      window.setTimeout(complete, remaining);
    };

    const dismissImmediately = () => {
      if (ended) return;
      ended = true;
      root.classList.add('theme-ready');
      markSeen();
      loadingBox.classList.add('loaded');
      loadingBox.style.setProperty('display', 'none', 'important');
      loadingBox.style.setProperty('pointer-events', 'none', 'important');
      window.setTimeout(() => {
        loadingBox.remove();
      }, 0);
    };

    root.classList.remove('theme-ready');
    preloadVisuals();
    loadingBox.addEventListener('click', dismissImmediately, { once: true });
    loadingBox.addEventListener('touchstart', dismissImmediately, { once: true, passive: true });
    window.addEventListener('keydown', dismissImmediately, { once: true });

    if (document.readyState === 'complete') {
      endLoading();
    } else {
      window.addEventListener('load', endLoading, { once: true });
      window.setTimeout(endLoading, 3000);
    }
  })();
</script>
