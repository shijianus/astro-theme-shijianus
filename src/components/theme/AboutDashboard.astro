---
import { siteConfig } from '../../config/site';

interface Props {
  stats: {
    posts: number;
    categories: number;
    tags: number;
    readingMinutes: number;
  };
}

const { stats } = Astro.props;
const about = siteConfig.pages.about;
const skillMarquee = [...siteConfig.home.hero.skillFlow, ...siteConfig.home.hero.chips];
---

<section id="about-page">
  <!-- 1. 顶部作者形象与浮动标签 -->
  <div class="author-box">
    <div class="author-tag-left">
      {about.floatingTagsLeft.map((item) => (
        <span class="author-tag">{item}</span>
      ))}
    </div>

    <div class="author-img">
      <img src={siteConfig.site.author.avatar} alt={siteConfig.site.author.name} loading="eager" />
      <span class="online-indicator" title={about.onlineStatus || "当前在线 · 持续构建中"}></span>
    </div>

    <div class="author-tag-right">
      {about.floatingTagsRight.map((item) => (
        <span class="author-tag">{item}</span>
      ))}
    </div>
  </div>

  <p class="p center logo large">{about.title}</p>
  <p class="p center small">{about.subtitle}</p>

  <!-- 2. 破冰打招呼与造物追求 -->
  <div class="author-content">
    <div class="author-content-item myInfoAndSayHello">
      <div class="title1">{about.helloTips}</div>
      <div class="title2">
        <span>我叫</span> <span class="inline-word">{siteConfig.site.author.name}</span>
      </div>
      <div class="title1 role-desc">{about.helloDescription}</div>
      <div class="hello-tag-chips">
        {about.helloChips ? about.helloChips.map((chip) => (
          <span>{chip}</span>
        )) : (
          <>
            <span>#Astro</span>
            <span>#TypeScript</span>
            <span>#Tailwind</span>
            <span>#Cloudflare</span>
            <span>#UI/UX</span>
            <span>#系统架构</span>
            <span>#数据主权</span>
          </>
        )}
      </div>
    </div>

    <div class="author-content-item aboutsiteTips">
      <div class="author-content-item-tips">{about.siteTips.tips}</div>
      <h2>
        {about.siteTips.titleTop}
        <br />
        {about.siteTips.titleBottom}
        <div class="mask">
          {about.siteTips.words.map((word, index) => (
            <span data-show={index === about.siteTips.words.length - 1 ? true : undefined} data-up={index === about.siteTips.words.length - 2 ? true : undefined}>
              {word}
            </span>
          ))}
        </div>
      </h2>
      <p class="aboutsite-lead">
        {about.siteTips.lead || '深潜底层打磨隐秘细脉，拓越远方构筑长效通衢。在信息快餐与算法喧嚣的时代，为你我保留一处专注慢思考、深度阅读与自由构建的数字静地。'}
      </p>
    </div>
  </div>

  <!-- 3. 全宽动态图腾横幅 -->
  <div class="hello-about">
    <div class="shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>
    <div class="content">
      <h1>{about.helloWordmark}</h1>
    </div>
  </div>

  <!-- 4. 技能矩阵与生涯长期演进 -->
  <div class="author-content">
    <div class="author-content-item skills">
      <div class="card-content">
        <div class="author-content-item-tips">{about.skills.tips}</div>
        <span class="author-content-item-title">{about.skills.title}</span>

        <div class="skills-style-group">
          <div class="skills-style-group__track">
            {[...skillMarquee, ...skillMarquee].map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>

        <div class="skills-list">
          {about.skills.items.map((item) => (
            <div class="skill-info">
              <div class="skill-icon" style={`background:${item.accent}`}>
                <span>{item.icon}</span>
              </div>
              <div class="skill-name">
                <span>{item.label}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="author-content-item careers">
      <div class="card-content">
        <div class="author-content-item-tips">{about.careers.tips}</div>
        <span class="author-content-item-title">{about.careers.title}</span>
        <div class="careers-group">
          {about.careers.items.map((item) => (
            <div class="career-item">
              <div class="circle" style={`background:${item.accent}`}></div>
              <div class="name">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
      <img class="author-content-img" src="/media/shijianus/system.jpg" alt="career board" loading="lazy" />
    </div>
  </div>

  <!-- 5. 站点数据统计与世界坐标雷达 -->
  <div class="author-content">
    <div class="about-statistic author-content-item">
      <div class="card-content">
        <div class="author-content-item-tips">{about.statistics.tips}</div>
        <span class="author-content-item-title">{about.statistics.title}</span>
        <div class="about-statistic__grid">
          <div>
            <strong>{stats.posts}</strong>
            <span>文章总量</span>
          </div>
          <div>
            <strong>{stats.categories}</strong>
            <span>专题分类</span>
          </div>
          <div>
            <strong>{stats.tags}</strong>
            <span>知识标签</span>
          </div>
          <div>
            <strong>{stats.readingMinutes}</strong>
            <span>阅读分钟</span>
          </div>
        </div>
        <div class="banner-button-group">
          <a class="banner-button" href={about.statistics.buttonHref}>
            <span class="banner-button-text">
              <span>{about.statistics.buttonLabel}</span>
              <span class="btn-arrow">→</span>
            </span>
          </a>
        </div>
      </div>
    </div>

    <div class="author-content-item-group column mapAndInfo">
      <div class="author-content-item map single">
        <div class="map-inner">
          <span class="map-title">
            {about.map.title}
            <b>{about.map.accent}</b>
          </span>
          <div class="map-live-info">
            <div class="live-clock-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span id="about-live-clock">--:--:-- PST</span>
            </div>
            <div class="live-status-pill">
              <span class="pulse-dot"></span>
              <span>灵感涌现 · 持续构建中</span>
            </div>
          </div>
        </div>
      </div>

      <div class="author-content-item selfInfo single">
        {about.selfInfo.map((item) => (
          <div>
            <span class="selfInfo-title">{item.label}</span>
            <span class="selfInfo-content" style={`color:${item.accent}`}>{item.value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 6. MBTI特质深度解析与数字工作室 -->
  <div class="author-content">
    <div class="author-content-item personalities">
      <div class="card-content">
        <div class="personality-top">
          <div>
            <div class="author-content-item-tips">{about.personality.tips}</div>
            <div class="personality-badge">{about.personality.type}</div>
            <span class="author-content-item-title personality-title">{about.personality.title}</span>
          </div>
        </div>
        
        <p class="personality-summary">{about.personality.summary}</p>

        {about.personality.traits && (
          <div class="personality-traits-grid">
            {about.personality.traits.map((trait) => (
              <div class="trait-item">
                <div class="trait-header">
                  <span class="trait-label">{trait.label}</span>
                  <span class="trait-value">{trait.value}%</span>
                </div>
                <div class="trait-bar">
                  <div class="trait-fill" style={`width: ${trait.value}%`}></div>
                </div>
              </div>
            ))}
          </div>
        )}

        <div class="personality-link-wrap">
          <a class="personality-more-link" href={about.personality.link} target="_blank" rel="noopener noreferrer">
            <span>深入了解 16Personalities</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V8H8"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="author-content-item myphoto">
      <img class="author-content-img" src={siteConfig.site.author.cover} alt={about.photoTitle} loading="lazy" />
      <div class="photo-overlay-tag">
        <span class="photo-icon">✦</span>
        <span>Clean Desk, Clear Mind · 工作台一角</span>
      </div>
    </div>
  </div>

  <!-- 7. 我的装备与生产力工作流 (Hardware & Software) -->
  {about.gear && (
    <div class="author-content">
      <div class="author-content-item gear-card hardware">
        <div class="card-content">
          <div class="author-content-item-tips">{about.gear.hardwareTips || '实用装备 / Gear'}</div>
          <span class="author-content-item-title">{about.gear.hardwareTitle || '日常学习与开发伙伴'}</span>
          <p class="gear-desc">{about.gear.hardwareDesc || '工欲善其事，实用当先。用高性价比的平价设备，在自习室与宿舍搭建专注写码的轻量桌面。'}</p>
          <div class="gear-grid">
            {about.gear.hardware.map((item) => (
              <div class="gear-item">
                <div class="gear-item__icon">
                  {item.icon === 'terminal' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>}
                  {item.icon === 'monitor' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>}
                  {item.icon === 'phone' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>}
                  {item.icon === 'headphones' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>}
                  {item.icon === 'laptop' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="20" x2="22" y2="20"></line></svg>}
                  {item.icon === 'keyboard' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="6" y1="8" x2="6" y2="8.01"></line><line x1="10" y1="8" x2="10" y2="8.01"></line><line x1="14" y1="8" x2="14" y2="8.01"></line><line x1="18" y1="8" x2="18" y2="8.01"></line><line x1="6" y1="12" x2="6" y2="12.01"></line><line x1="18" y1="12" x2="18" y2="12.01"></line><line x1="7" y1="16" x2="17" y2="16"></line></svg>}
                </div>
                <div class="gear-item__content">
                  <div class="gear-item__name">
                    <strong>{item.name}</strong>
                    {item.badge && <span class="gear-badge">{item.badge}</span>}
                  </div>
                  <span class="gear-item__desc">{item.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="author-content-item gear-card software">
        <div class="card-content">
          <div class="author-content-item-tips">{about.gear.softwareTips || '实用工具 / Software'}</div>
          <span class="author-content-item-title">{about.gear.softwareTitle || '学习与开发工作流'}</span>
          <p class="gear-desc">{about.gear.softwareDesc || '轻量敏捷、注重实效。用好基础开源与免费工具，满足日常求索与写码需求。'}</p>
          <div class="gear-grid">
            {about.gear.software.map((item) => (
              <div class="gear-item">
                <div class="gear-item__icon software-icon">
                  {item.icon === 'code' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>}
                  {item.icon === 'zap' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>}
                  {item.icon === 'figma' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 5.5A3.5 3.5 0 0 1 8.5 2H12v7H8.5A3.5 3.5 0 0 1 5 5.5z"></path><path d="M12 2h3.5a3.5 3.5 0 1 1 0 7H12V2z"></path><path d="M12 12.5a3.5 3.5 0 1 1 7 0 3.5 3.5 0 1 1-7 0z"></path><path d="M5 19.5A3.5 3.5 0 0 1 8.5 16H12v3.5a3.5 3.5 0 1 1-7 0z"></path><path d="M5 12.5A3.5 3.5 0 0 1 8.5 9H12v7H8.5A3.5 3.5 0 0 1 5 12.5z"></path></svg>}
                  {item.icon === 'cloud' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg>}
                </div>
                <div class="gear-item__content">
                  <div class="gear-item__name">
                    <strong>{item.name}</strong>
                    {item.badge && <span class="gear-badge">{item.badge}</span>}
                  </div>
                  <span class="gear-item__desc">{item.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- 8. 数字花园建站宣言与造物初心 -->
  {about.manifesto && (
    <div class="author-content">
      <div class="author-content-item single manifesto-card">
        <div class="card-content">
          <div class="manifesto-header">
            <span class="manifesto-pill">
              <span class="manifesto-pill__sparkle">✦</span>
              {about.manifesto.tips}
            </span>
            <h2 class="manifesto-title">{about.manifesto.title}</h2>
            <p class="manifesto-subtitle">{about.manifesto.subtitle}</p>
          </div>

          <div class="manifesto-pillars">
            {about.manifesto.pillars.map((pillar) => (
              <div class="pillar-card">
                <div class="pillar-card__head">
                  <span class="pillar-card__tag">{pillar.tag}</span>
                  <div class="pillar-card__icon">
                    {pillar.icon === 'shield' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>}
                    {pillar.icon === 'feather' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path><line x1="16" y1="8" x2="2" y2="22"></line><line x1="17.5" y1="15" x2="9" y2="15"></line></svg>}
                    {pillar.icon === 'hammer' && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 12-8.5 8.5c-.83.83-2.17.83-3 0 0 0 0 0 0 0a2.12 2.12 0 0 1 0-3L12 9"></path><path d="M17.64 15 22 10.64"></path><path d="m20.91 3.26-6.36 6.36"></path></svg>}
                  </div>
                </div>
                <strong class="pillar-card__title">{pillar.title}</strong>
                <p class="pillar-card__desc">{pillar.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- 8.5 全栈工程架构三层拓扑与云端底座 (Topology & Cloud Deck) -->
  {about.topology && (
    <div class="author-content">
      <div class="author-content-item single topology-card">
        <div class="card-content">
          <div class="author-content-item-tips">{about.topology.tips}</div>
          <span class="author-content-item-title">{about.topology.title}</span>
          <p class="topology-lead">
            {about.topology.lead}
          </p>

          <div class="topology-tiers-grid">
            {about.topology.tiers.map((tier) => (
              <div class="topology-tier-box">
                <div class="topology-tier-head">
                  <span class="tier-badge-num">{tier.num}</span>
                  <div class="tier-badge-title">
                    <strong>{tier.title}</strong>
                    <span>{tier.subtitle}</span>
                  </div>
                </div>
                <div class="topology-chips-flow">
                  {tier.items.map((item) => (
                    <div class="topology-item">
                      <span class={`tier-dot ${item.color}`}></span>
                      <strong class="item-name">{item.name}</strong>
                      <span class="item-role">{item.role}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- 9. 灵感黑胶唱机与次元精神角落 -->
  <div class="author-content">
    <div class="author-content-item like-music">
      <div class="card-content">
        <div class="author-content-item-tips">{about.soundtrack ? about.soundtrack.tips : about.likeMusic.tips}</div>
        <span class="author-content-item-title">{about.soundtrack ? about.soundtrack.title : about.likeMusic.title}</span>
        
        <!-- 黑胶唱片动效与音波组件 -->
        <div class="vinyl-player-widget">
          <div class="vinyl-disc-container">
            <div class="vinyl-disc">
              <div class="vinyl-grooves"></div>
              <img class="vinyl-cover" src={about.soundtrack?.cover || '/media/audio/covers/way_back_home.jpg'} alt="Record Cover" />
              <div class="vinyl-center-hole"></div>
            </div>
            <div class="vinyl-stylus"></div>
          </div>
          
          <div class="vinyl-meta">
            <div class="vinyl-title-row">
              <strong class="vinyl-song-title">{about.soundtrack?.song || 'Way Back Home'}</strong>
              <div class="equalizer-bars">
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
                <span class="bar bar-3"></span>
                <span class="bar bar-4"></span>
              </div>
            </div>
            <span class="vinyl-artist">{about.soundtrack?.artist || 'Inspiration Soundtrack'}</span>
            <p class="vinyl-summary">{about.soundtrack?.summary || about.likeMusic.summary}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="author-content-item game-yuanshen">
      <div class="card-content">
        <div class="author-content-item-tips">{about.game.tips}</div>
        <span class="author-content-item-title">{about.game.title}</span>
        <div class="content-bottom">
          <div class="tips">{about.game.summary}</div>
          <div class="comic-box">
            {about.comic.items.map((item) => (
              <span class="comic-item">{item}</span>
            ))}
          </div>
        </div>
        <div class="loading-bar-wrap">
          <div class="loading-bar-inner"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 9.5 站点演进足迹与造物里程碑 (Evolution Milestones) -->
  {about.milestones && (
    <div class="author-content">
      <div class="author-content-item single milestones-card">
        <div class="card-content">
          <div class="author-content-item-tips">{about.milestones.tips}</div>
          <span class="author-content-item-title">{about.milestones.title}</span>
          <p class="milestones-lead">
            {about.milestones.lead}
          </p>

          <div class="milestones-track">
            {about.milestones.items.map((item) => (
              <div class="milestone-node">
                <div class="node-indicator">
                  <span class={`node-dot ${item.dotClass || ''}`}></span>
                  {item.hasLine !== false && <span class="node-line"></span>}
                </div>
                <div class="node-body">
                  <div class="node-meta">
                    <span class={`node-year ${item.yearClass || ''}`}>{item.year}</span>
                    <span class={`node-tag ${item.tagClass || ''}`}>{item.tag}</span>
                  </div>
                  <strong class="node-title">{item.title}</strong>
                  <p class="node-desc">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- 10. 箴言与状态加成 -->
  <div class="author-content">
    <div class="author-content-item maxim">
      <div class="card-content">
        <div class="author-content-item-tips">{about.maxim.tips}</div>
        <span class="maxim-title">
          <span>{about.maxim.top}</span>
          <span>{about.maxim.bottom}</span>
        </span>
        <p class="maxim-annotation">{about.maxim.annotation || '深潜底层打磨隐秘细脉，拓越远方构筑长效通衢。'}</p>
      </div>
    </div>

    <div class="author-content-item buff">
      <div class="card-content">
        <div class="author-content-item-tips">{about.buff.tips}</div>
