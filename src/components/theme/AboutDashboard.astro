<!-- 实时时钟与微交互运行脚本 -->
<script is:inline>
  (() => {
    // 1. 实时 PST/PDT 太平洋时间更新
    const updateClock = () => {
      const clockEl = document.getElementById('about-live-clock');
      if (!clockEl) return;
      try {
        const now = new Date();
        const formatter = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/Los_Angeles',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        });
        clockEl.textContent = `${formatter.format(now)} PST`;
      } catch (err) {
        // Fallback
      }
    };
    updateClock();
    setInterval(updateClock, 1000);
  })();
</script>

