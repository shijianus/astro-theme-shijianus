---
import PostComments from './PostComments';
import { siteConfig } from '../../config/site';

const site = siteConfig.site;

const sampleDanmaku = [
  { text: '🎉 祝博主的博客长青！界面太惊艳了！', author: 'GeekExplorer', time: '10分钟前', tag: '祝愿' },
  { text: '🚀 Astro + React 19 的岛屿架构真丝滑！', author: 'FrontendDev', time: '25分钟前', tag: '技术' },
  { text: '☕ 从 Twitter 过来的，留个脚印支持！', author: 'CoffeeLover', time: '1小时前', tag: '足迹' },
  { text: '💡 3D 纸飞机和星轨效果非常棒，已加入书签！', author: 'UIArchitect', time: '2小时前', tag: '点赞' },
  { text: '✨ 在这个算法时代，坚持写独立博客令人敬佩。', author: 'SolitaryThinker', time: '3小时前', tag: '随感' },
  { text: '🌱 友链申请已提，期待共同交流生长！', author: 'CyberNomad', time: '4小时前', tag: '友邻' },
];

const quickStamps = [
  { icon: '🎉', label: '祝愿常青', template: '🎉 祝愿博客长青，内容常新！' },
  { icon: '☕', label: '敬一杯咖啡', template: '☕ 路过点赞，敬作者一杯热咖啡！继续加油！' },
  { icon: '🚀', label: '灵感爆发', template: '🚀 界面设计与工程实现极具启发性，灵感爆发！' },
  { icon: '💡', label: '探讨交流', template: '💡 想就本站的系统架构和岛屿组件方案交流探讨一番~' },
  { icon: '🌟', label: '留下足迹', template: '🌟 2026 探访留念，数字花园漫游打卡！' },
];
---

<section id="guestbook-dashboard" class="guestbook-dashboard">
  <!-- 1. 顶部 Hero 看板与弹幕流 -->
  <div class="guestbook-hero theme-card">
    <div class="guestbook-hero__copy">
      <div class="guestbook-hero__eyebrow">
        <span class="pulse-dot"></span>
        <span>GUESTBOOK · 读者留言墙</span>
      </div>
      <h1 class="guestbook-hero__title">海内存知己，尺素寄寸心</h1>
      <p class="guestbook-hero__summary">
        欢迎来到 EpoCanvas 留言板。无论是技术推演、设计交流，还是一句简单的问候，都可以在这里写下你的声音。
      </p>

      <div class="guestbook-hero__stats">
        <div class="stat-pill">
          <span class="stat-icon">⚡</span>
          <span class="stat-text">D1 边缘毫秒落盘</span>
        </div>
        <div class="stat-pill">
          <span class="stat-icon">🔔</span>
          <span class="stat-text">Telegram 实时提醒</span>
        </div>
        <div class="stat-pill">
          <span class="stat-icon">🛡️</span>
          <span class="stat-text">零虚假评论保证</span>
        </div>
      </div>
    </div>

    <!-- 弹幕开关与展示视窗 -->
    <div class="guestbook-danmaku-wrap">
      <div class="danmaku-header">
        <span class="danmaku-header__title">💬 实时弹幕墙</span>
        <button id="toggle-danmaku-btn" class="danmaku-toggle-btn" type="button" title="开启/隐藏弹幕">
          <span class="toggle-icon">📺</span>
          <span id="danmaku-toggle-text">弹幕已开启</span>
        </button>
      </div>

      <div id="danmaku-viewport" class="danmaku-viewport">
        <div class="danmaku-track track-1">
          {sampleDanmaku.slice(0, 3).map((item) => (
            <div class="danmaku-item">
              <span class="danmaku-tag">{item.tag}</span>
              <span class="danmaku-author">{item.author}:</span>
              <span class="danmaku-text">{item.text}</span>
            </div>
          ))}
        </div>
        <div class="danmaku-track track-2">
          {sampleDanmaku.slice(3, 6).map((item) => (
            <div class="danmaku-item">
              <span class="danmaku-tag is-warm">{item.tag}</span>
              <span class="danmaku-author">{item.author}:</span>
              <span class="danmaku-text">{item.text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 2. 一键快捷盖章栏 (Quick Stamps) -->
  <div class="quick-stamps-bar theme-card">
    <div class="stamps-header">
      <span class="stamps-title">✨ 一键快捷问候 (点击直接注入评论区)</span>
      <span class="stamps-hint">免去打字烦恼，选一枚徽章向博主打个招呼吧：</span>
    </div>

    <div class="stamps-grid">
      {quickStamps.map((stamp) => (
        <button class="stamp-chip" type="button" data-template={stamp.template}>
          <span class="stamp-icon">{stamp.icon}</span>
          <span class="stamp-label">{stamp.label}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- 3. 正式留言系统流 (原生 D1 留言系统) -->
  <div id="guestbook-comment-container" class="guestbook-comments-wrap">
    <PostComments
      client:load
      postSlug="guestbook"
      postTitle="全站公开留言板"
      postUrl="/guestbook/"
    />
  </div>
</section>

<script is:inline>
  (() => {
    // 1. 弹幕开关逻辑
    const toggleBtn = document.getElementById('toggle-danmaku-btn');
    const viewport = document.getElementById('danmaku-viewport');
    const toggleText = document.getElementById('danmaku-toggle-text');
    let isDanmakuOn = true;

    if (toggleBtn && viewport) {
      toggleBtn.addEventListener('click', () => {
        isDanmakuOn = !isDanmakuOn;
        if (isDanmakuOn) {
          viewport.style.opacity = '1';
          viewport.style.pointerEvents = 'auto';
          if (toggleText) toggleText.textContent = '弹幕已开启';
          toggleBtn.classList.remove('is-off');
        } else {
          viewport.style.opacity = '0.2';
          viewport.style.pointerEvents = 'none';
          if (toggleText) toggleText.textContent = '弹幕已静音';
          toggleBtn.classList.add('is-off');
        }
      });
    }

    // 2. 快捷问候戳记注入评论框
    const stampChips = document.querySelectorAll('.stamp-chip');
    stampChips.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tpl = btn.dataset.template;
        if (!tpl) return;

        const textarea = document.querySelector('.tk-input.el-textarea');
        if (textarea) {
          textarea.value = (textarea.value ? textarea.value + '\n' : '') + tpl;
          textarea.dispatchEvent(new Event('input', { bubbles: true }));
          textarea.focus();
          textarea.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          // 若评论区未完成挂载，平滑滚动至输入区
          const container = document.getElementById('guestbook-comment-container');
          if (container) container.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  })();
</script>

<style>
  .guestbook-dashboard {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 20px 80px;
    box-sizing: border-box;
  }

  /* 1. Hero 看板 */
  .guestbook-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding: 36px 40px;
    border-radius: 12px;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--style-border, #e2e8f0);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
  }

  :root[data-theme='dark'] .guestbook-hero {
    background: #181c27;
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
  }

  .guestbook-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    font-family: var(--font-family-code, monospace);
    color: #425aef;
    background: rgba(66, 90, 239, 0.08);
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 16px;
  }

  :root[data-theme='dark'] .guestbook-hero__eyebrow {
    color: #a5b4fc;
    background: rgba(99, 102, 241, 0.15);
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.3);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .guestbook-hero__title {
    font-size: 32px;
    font-weight: 800;
    color: var(--font-color, #1e293b);
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  :root[data-theme='dark'] .guestbook-hero__title {
    color: #f1f5f9;
  }

  .guestbook-hero__summary {
    font-size: 15px;
    line-height: 1.6;
    color: #64748b;
    margin: 0 0 24px;
  }

  :root[data-theme='dark'] .guestbook-hero__summary {
    color: #94a3b8;
  }

  .guestbook-hero__stats {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.03);
    color: var(--font-color, #334155);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  :root[data-theme='dark'] .stat-pill {
    background: rgba(255, 255, 255, 0.04);
    color: #cbd5e1;
    border-color: rgba(255, 255, 255, 0.08);
  }

  /* 弹幕视窗 */
  .guestbook-danmaku-wrap {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(66, 90, 239, 0.03);
    border: 1px dashed rgba(66, 90, 239, 0.2);
    border-radius: 10px;
    padding: 16px 20px;
    overflow: hidden;
  }

  :root[data-theme='dark'] .guestbook-danmaku-wrap {
    background: rgba(99, 102, 241, 0.05);
    border-color: rgba(99, 102, 241, 0.25);
  }

  .danmaku-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .danmaku-header__title {
    font-size: 13px;
    font-weight: 700;
    color: #425aef;
  }

  :root[data-theme='dark'] .danmaku-header__title {
    color: #a5b4fc;
  }

  .danmaku-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 4px;
    background: #ffffff;
    border: 1px solid rgba(66, 90, 239, 0.2);
    color: #425aef;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :root[data-theme='dark'] .danmaku-toggle-btn {
    background: #1e2433;
    border-color: rgba(255, 255, 255, 0.1);
    color: #a5b4fc;
  }

  .danmaku-toggle-btn.is-off {
    opacity: 0.6;
    filter: grayscale(1);
  }

  .danmaku-viewport {
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: hidden;
    position: relative;
    height: 110px;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .danmaku-track {
    display: flex;
    gap: 24px;
    white-space: nowrap;
    width: max-content;
  }

  .track-1 {
    animation: drift 25s linear infinite;
  }

  .track-2 {
    animation: drift 20s linear infinite 2s;
  }

  @keyframes drift {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .danmaku-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 20px;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--style-border, #e2e8f0);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    font-size: 13px;
  }

  :root[data-theme='dark'] .danmaku-item {
    background: #181c27;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .danmaku-tag {
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    background: rgba(16, 185, 129, 0.1);
    color: #059669;
  }

  .danmaku-tag.is-warm {
    background: rgba(245, 158, 11, 0.1);
    color: #d97706;
  }

  .danmaku-author {
    font-weight: 700;
    color: var(--font-color, #1e293b);
  }

  :root[data-theme='dark'] .danmaku-author {
    color: #f1f5f9;
  }

  .danmaku-text {
    color: #475569;
  }

  :root[data-theme='dark'] .danmaku-text {
    color: #cbd5e1;
  }

  /* 2. 一键盖章栏 */
  .quick-stamps-bar {
    padding: 20px 28px;
    border-radius: 10px;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--style-border, #e2e8f0);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    margin-bottom: 24px;
  }

  :root[data-theme='dark'] .quick-stamps-bar {
    background: #181c27;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .stamps-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stamps-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--font-color, #1e293b);
  }

  :root[data-theme='dark'] .stamps-title {
    color: #f1f5f9;
  }

  .stamps-hint {
    font-size: 12px;
    color: #64748b;
  }

  :root[data-theme='dark'] .stamps-hint {
    color: #94a3b8;
  }

  .stamps-grid {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .stamp-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 8px;
    background: rgba(66, 90, 239, 0.05);
    border: 1px solid rgba(66, 90, 239, 0.15);
    color: #425aef;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .stamp-chip:hover {
    background: #425aef;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(66, 90, 239, 0.25);
  }

  :root[data-theme='dark'] .stamp-chip {
    background: rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.25);
    color: #a5b4fc;
  }

  :root[data-theme='dark'] .stamp-chip:hover {
    background: #425aef;
    color: #ffffff;
  }

  .stamp-icon {
    font-size: 16px;
  }

  /* 3. 评论流包裹层 */
  .guestbook-comments-wrap {
    width: 100%;
  }

  @media (max-width: 900px) {
    .guestbook-hero {
      grid-template-columns: 1fr;
      padding: 24px 20px;
    }
  }
</style>
