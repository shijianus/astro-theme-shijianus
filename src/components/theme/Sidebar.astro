---
import { Archive, FileText, FolderOpen, HeartHandshake, Info, ListTree, Megaphone, MessageCircle, Tags } from 'lucide-react';
import { siteConfig } from '../../config/site';
import { getCategoryPath, getPostPath, getTagPath, resolveCover } from '../../lib/content';
import type { SidebarData } from '../../lib/theme';
import { TocObserver } from '../TocObserver';
import { ProfileWidget } from '../ProfileWidget';

interface Props extends SidebarData {
  pageType?: string;
}

const {
  recentPosts,
  tags,
  archives,
  categories,
  totalPosts,
  totalCategories,
  totalTags,
  totalReadingMinutes,
  headings = [],
  postContext,
  pageType = 'page',
} = Astro.props;

const isPostPage = pageType === 'post';
const isHomePage = pageType === 'home';
const utilityOnlyPageTypes = new Set(['home', 'page']);
const tocHeadings = headings.filter((heading) => heading.depth >= 1 && heading.depth <= 4);
const showUtilityAside = utilityOnlyPageTypes.has(pageType);
const showPostAsideFeed = isPostPage;
const showRecentPosts = recentPosts.length > 0 && !isHomePage && (showUtilityAside || showPostAsideFeed);
const showToc = isPostPage && siteConfig.theme.features.postToc && tocHeadings.length > 0;
const showCategories = siteConfig.theme.features.asideCategories && categories.length > 0 && !isHomePage && !isPostPage && showUtilityAside;
const showFeatureCard = pageType === 'home' && siteConfig.theme.features.asideFeatureCard;
const showTags = siteConfig.theme.features.asideTags && tags.length > 0 && !isHomePage && (showUtilityAside || showPostAsideFeed);
const showArchives = siteConfig.theme.features.asideArchives && archives.length > 0 && !isHomePage && (showUtilityAside || showPostAsideFeed);
const showWebInfo = siteConfig.theme.features.asideWebInfo && !isPostPage && (isHomePage || showUtilityAside);
const postContextData = isPostPage ? postContext : undefined;
const showPostContext = Boolean(postContextData);
const runtimeDays = Math.max(
  1,
  Math.floor((Date.now() - new Date(siteConfig.footer.startedAt).valueOf()) / 86_400_000),
);
const startedAtLabel = new Date(siteConfig.footer.startedAt).toLocaleDateString('zh-CN').replaceAll('/', '.');
const currentPhase = siteConfig.home.statusCards[0]?.value ?? siteConfig.site.author.statusLabel;
const latestPublishedAt = recentPosts[0]?.data.pubDate ?? null;
const latestPublishedLabel = latestPublishedAt ? latestPublishedAt.toLocaleDateString('zh-CN').replaceAll('/', '.') : '持续更新';
---

<div class="aside-content" id="aside-content">
  {!isPostPage && siteConfig.theme.features.asideAuthor && (
    <ProfileWidget
      name={siteConfig.site.author.name}
      role={siteConfig.site.author.role}
      motto={siteConfig.site.author.motto}
      bio={siteConfig.site.author.bio}
      avatar={siteConfig.site.author.avatar}
      cover={siteConfig.site.author.cover}
      statusLabel={siteConfig.site.author.statusLabel}
      location={siteConfig.site.author.location}
      email={siteConfig.site.author.email}
      stats={{
        posts: totalPosts,
        categories: totalCategories,
        tags: totalTags,
      }}
      stack={siteConfig.aside.stack}
    />
  )}

  {!isPostPage && isHomePage && siteConfig.theme.features.asideStatus && (
    <section class="card-widget card-announcement">
      <div class="item-headline">
        <Megaphone className="aside-title-icon" aria-hidden="true" />
        <span>公告</span>
      </div>
      <div class="announcement_content">
        <p>{siteConfig.aside.announcement}</p>
      </div>
    </section>
  )}

  {showFeatureCard && (
    <section class="card-widget card-feature-panel">
      <div class="feature-card__eyebrow">{siteConfig.aside.featureCard.eyebrow}</div>
      <h3>{siteConfig.aside.featureCard.title}</h3>
      <p>{siteConfig.aside.featureCard.summary}</p>
      <div class="feature-card__chips">
        {siteConfig.aside.featureCard.chips.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </section>
  )}

  {showCategories && (
    <section class="card-widget card-categories">
      <div class="item-headline">
        <FolderOpen className="aside-title-icon" aria-hidden="true" />
        <span>分类</span>
      </div>
      <ul class="card-category-list">
        {categories.slice(0, 8).map((item) => (
          <li class="card-category-list-item">
            <a class="card-category-list-link" href={getCategoryPath(item.slug)}>
              <span class="card-category-list-name">{item.label}</span>
              <span class="card-category-list-count-group">
                <span class="card-category-list-count">{item.count}</span>
                <span>篇</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div class="sticky_layout">
    {showToc && (
      <section class="card-widget" id="card-toc">
        <div class="item-headline">
          <ListTree className="aside-title-icon" aria-hidden="true" />
          <span>文章目录</span>
          <span class="toc-count">{tocHeadings.length} 节</span>
          <span class="toc-percentage"></span>
        </div>
        <div class="toc-progress" aria-hidden="true">
          <span class="toc-progress__bar"></span>
        </div>
        <div class="toc-current" aria-live="polite">
          <span class="toc-current__eyebrow">当前定位</span>
          <div class="toc-current__body">
            <strong class="toc-current__title">等待进入正文</strong>
            <span class="toc-current__meta">H2 · 00/00</span>
          </div>
        </div>
        <div class="toc-content">
          {tocHeadings
            .map((heading, index) => (
              <a
                href={`#${heading.slug}`}
                class={`toc-link ${heading.depth > 2 ? 'is-nested' : ''}`}
                data-depth={heading.depth}
                data-heading-id={heading.slug}
                aria-current="false"
              >
                <span class="toc-index">{String(index + 1).padStart(2, '0')}</span>
                <span class="toc-text-group">
                  <span class="toc-text">{heading.text}</span>
                  <span class="toc-depth">H{heading.depth}</span>
                </span>
              </a>
            ))}
        </div>
        <TocObserver client:only="react" />
      </section>
    )}

    {showPostContext && (
      <section class="card-widget card-post-context">
        <div class="item-headline">
          <FileText className="aside-title-icon" aria-hidden="true" />
          <span>文章卡片</span>
        </div>
        <div class="post-context-card">
          <span class="post-context-card__eyebrow">shijianus article</span>
          <strong class="post-context-card__title">{postContextData?.title}</strong>
          {postContextData?.summary && <p class="post-context-card__summary">{postContextData.summary}</p>}
          <div class="post-context-card__meta">
            <a href={postContextData?.category.href} class="post-context-card__category">
              {postContextData?.category.label}
            </a>
            {postContextData?.meta.map((item) => (
              <span>{item}</span>
            ))}
          </div>
          {Boolean(postContextData?.tags.length) && (
            <div class="post-context-card__tags">
              {postContextData?.tags.map((tag) => (
                <a href={tag.href}>{tag.label}</a>
              ))}
            </div>
          )}
          <div class="post-context-card__actions">
            {postContextData?.actions.map((action) => (
              <a href={action.href} class="post-context-card__action">
                {action.kind === 'comment' && <MessageCircle className="post-context-card__action-icon" aria-hidden="true" />}
                {action.kind === 'reward' && <HeartHandshake className="post-context-card__action-icon" aria-hidden="true" />}
                {action.kind === 'archive' && <Archive className="post-context-card__action-icon" aria-hidden="true" />}
                <span>{action.label}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    {showRecentPosts && (
      <section class="card-widget card-recent-post">
        <div class="item-headline">
          <span class="aside-title-icon aside-title-icon--text" aria-hidden="true">N</span>
          <span>{isPostPage ? '继续阅读' : '最近文章'}</span>
        </div>
        <div class="aside-list">
          {recentPosts.slice(0, 5).map((entry) => (
            <a href={getPostPath(entry)} class="aside-list-item">
              <span class="thumbnail">
                <img src={resolveCover(entry)} alt={entry.data.title} loading="lazy" />
              </span>
              <span class="content">
                <span class="title">{entry.data.title}</span>
                <time>{entry.data.pubDate.toLocaleDateString('zh-CN')}</time>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    {showTags && (
      <section class="card-widget card-tags">
        <div class="item-headline">
          <Tags className="aside-title-icon" aria-hidden="true" />
          <span>{isPostPage ? '相关标签' : '标签'}</span>
        </div>
        <div class="card-tag-cloud">
          {tags.slice(0, 24).map((tag) => (
            <a href={getTagPath(tag.slug)}>
              {tag.label}
              <sup>{tag.count}</sup>
            </a>
          ))}
        </div>
      </section>
    )}

    {showArchives && (
      <section class="card-widget card-archives">
        <div class="item-headline">
          <Archive className="aside-title-icon" aria-hidden="true" />
          <span>{isPostPage ? '时间线' : '归档'}</span>
        </div>
        <ul class="card-archive-list">
          {archives.slice(0, 8).map((item) => (
            <li class="card-archive-list-item">
              <a class="card-archive-list-link" href="/archives/">
                <span class="card-archive-list-date">{item.label}</span>
                <span class="card-archive-list-count-group">
                  <span class="card-archive-list-count">{item.count}</span>
                  <span>篇</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {showWebInfo && (
      <section class="card-widget card-webinfo">
        <div class="item-headline">
          <Info className="aside-title-icon" aria-hidden="true" />
          <span>站点信息</span>
        </div>
        <div class="webinfo-panel">
          <div class="workboard-panel webinfo-workboard">
            <div class="webinfo-workboard__head">
              <div class="workboard-status">
                <span class="workboard-dot" aria-hidden="true"></span>
                <span class="workboard-label">{siteConfig.footer.runtime.label}</span>
                <strong>{siteConfig.footer.runtime.workLabel}</strong>
              </div>
              <span class="webinfo-workboard__since">始于 {startedAtLabel}</span>
            </div>
            <p>{siteConfig.footer.runtime.workDetail}</p>
            <div class="webinfo-highlight-grid">
              <article class="webinfo-highlight-card webinfo-highlight-card--primary">
                <span>站点运行</span>
                <strong>{runtimeDays} 天</strong>
                <small>起始于 {startedAtLabel}</small>
              </article>
              <article class="webinfo-highlight-card">
                <span>最近更新</span>
                <strong>{latestPublishedLabel}</strong>
                <small>内容仍在持续整理</small>
              </article>
              <article class="webinfo-highlight-card">
                <span>当前阶段</span>
                <strong>{currentPhase}</strong>
                <small>优先修正阅读与侧栏体验</small>
              </article>
            </div>
            <div class="workboard-chip-list">
              <span>{siteConfig.footer.runtime.workLabel}</span>
              <span>{siteConfig.site.author.statusLabel}</span>
              <span>{siteConfig.home.announcement.eyebrow}</span>
            </div>
          </div>
          <div class="webinfo webinfo-grid">
            <div class="webinfo-item">
              <div class="webinfo-item-title">
                <span class="item-name">文章总数</span>
              </div>
              <div class="item-count">{totalPosts}</div>
            </div>
            <div class="webinfo-item">
              <div class="webinfo-item-title">
                <span class="item-name">分类总数</span>
              </div>
              <div class="item-count">{totalCategories}</div>
            </div>
            <div class="webinfo-item">
              <div class="webinfo-item-title">
                <span class="item-name">标签总数</span>
              </div>
              <div class="item-count">{totalTags}</div>
            </div>
            <div class="webinfo-item">
              <div class="webinfo-item-title">
                <span class="item-name">阅读时长</span>
              </div>
              <div class="item-count">{totalReadingMinutes}m</div>
            </div>
          </div>
        </div>
      </section>
    )}
  </div>
</div>
