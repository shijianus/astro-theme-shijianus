<script>
  const TOC_I18N: Record<string, { title: string; unit: string }> = {
    'zh-CN': { title: '文章目录', unit: '节' },
    'zh-Hant': { title: '文章目錄', unit: '節' },
    en: { title: 'Contents', unit: 'sections' },
    es: { title: 'Contenido', unit: 'secciones' },
    de: { title: 'Inhalt', unit: 'Abschnitte' },
    fr: { title: 'Sommaire', unit: 'sections' },
  };

  let scrollListenerCleanup: (() => void) | null = null;

  function initTocScrollSpy(activeLang?: string) {
    if (scrollListenerCleanup) {
      scrollListenerCleanup();
      scrollListenerCleanup = null;
    }

    const tocCard = document.getElementById('card-toc');
    if (!tocCard) return;
    const tocContent = tocCard.querySelector('.toc-content');
    if (!tocContent) return;

    const currentLang = activeLang || document.documentElement.lang || 'zh-CN';
    const activeList = tocCard.querySelector(`.variant-toc-list[data-lang="${currentLang}"]`) ||
                       tocCard.querySelector('.variant-toc-list:not([style*="display: none"])') ||
                       tocCard.querySelector('.toc-content');

    const links = Array.from(activeList ? activeList.querySelectorAll('.toc-link') : []) as HTMLAnchorElement[];
    
    // Target the visible article container
    const activeArticleVariant = document.querySelector(`.article-translation-variant[data-lang="${currentLang}"]:not([style*="display: none"])`) ||
                                document.querySelector('.article-translation-variant:not([style*="display: none"])') ||
                                document.getElementById('article-container');

    const headings = links.map(link => {
      let hash = '';
      try {
        hash = decodeURIComponent(link.hash.replace(/^#/, ''));
      } catch (e) {
        hash = link.hash.replace(/^#/, '');
      }
      let el: HTMLElement | null = null;
      if (activeArticleVariant && hash) {
        try {
          el = activeArticleVariant.querySelector(`[id="${CSS.escape(hash)}"]`) as HTMLElement;
        } catch (_) {}
      }
      if (!el && hash) {
        try {
          el = document.getElementById(hash);
        } catch (_) {}
      }
      const depth = parseInt(link.getAttribute('data-depth') || '2', 10);
      return { id: hash, el, link, depth };
    }).filter((h): h is { id: string; el: HTMLElement; link: HTMLAnchorElement; depth: number } => Boolean(h.el));

    if (!headings.length) return;

    // Smooth click handler for active TOC links with header offset
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        let hash = '';
        try {
          hash = decodeURIComponent(link.hash.replace(/^#/, ''));
        } catch (err) {
          hash = link.hash.replace(/^#/, '');
        }
        let targetEl: HTMLElement | null = null;
        if (activeArticleVariant && hash) {
          try {
            targetEl = activeArticleVariant.querySelector(`[id="${CSS.escape(hash)}"]`) as HTMLElement;
          } catch (_) {}
        }
        if (!targetEl && hash) {
          try {
            targetEl = document.getElementById(hash);
          } catch (_) {}
        }
        if (targetEl) {
          const isReadMode =
            document.body.classList.contains('read-mode') ||
            document.documentElement.getAttribute('data-readmode') === 'true';
          const topOffset = isReadMode ? 24 : 80;
          const rect = targetEl.getBoundingClientRect();
          const targetY = window.scrollY + rect.top - topOffset;
          window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });
          if (history.pushState) {
            history.pushState(null, '', '#' + encodeURIComponent(hash));
          }
          setTimeout(updateActive, 100);
        }
      });
    });

    const isLinkVisible = (link: HTMLElement) => {
      const item = link.closest('.toc-item');
      if (!item) return false;
      return window.getComputedStyle(item).display !== 'none';
    };

    const setActive = (targetHeading: { id: string; el: HTMLElement; link: HTMLAnchorElement; depth: number }) => {
      let activeLink = targetHeading.link;

      // If the targeted heading is hidden by depth filter, find the nearest visible ancestor or preceding visible item
      if (!isLinkVisible(activeLink)) {
        let parentItem = activeLink.closest('.toc-item')?.parentElement?.closest('.toc-item');
        while (parentItem) {
          const parentLink = parentItem.querySelector(':scope > .toc-link') as HTMLAnchorElement | null;
          if (parentLink && isLinkVisible(parentLink)) {
            activeLink = parentLink;
            break;
          }
          parentItem = parentItem.parentElement?.closest('.toc-item');
        }

        if (!isLinkVisible(activeLink)) {
          const idx = headings.findIndex(h => h.id === targetHeading.id);
          for (let i = idx; i >= 0; i--) {
            if (isLinkVisible(headings[i]!.link)) {
              activeLink = headings[i]!.link;
              break;
            }
          }
        }
      }

      links.forEach((link) => {
        const isMatch = link === activeLink;
        link.classList.toggle('active', isMatch);
        const item = link.closest('.toc-item');
        if (item) item.classList.toggle('active', isMatch);
      });

      if (activeLink && tocContent) {
        const contentRect = tocContent.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        if (linkRect.top < contentRect.top + 10) {
          tocContent.scrollTop -= (contentRect.top - linkRect.top + 20);
        } else if (linkRect.bottom > contentRect.bottom - 10) {
          tocContent.scrollTop += (linkRect.bottom - contentRect.bottom + 20);
        }
      }
    };

    const updateActive = () => {
      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;
      const isReadMode =
        document.body.classList.contains('read-mode') ||
        document.documentElement.getAttribute('data-readmode') === 'true';
      const topOffset = isReadMode ? 32 : 100;

      // Bottom of page: activate last heading
      if (scrollY + windowHeight >= docHeight - 40) {
        setActive(headings[headings.length - 1]!);
        return;
      }

      // Find last heading whose top has reached or passed topOffset
      let current = headings[0]!;
      for (let i = 0; i < headings.length; i++) {
        const rect = headings[i]!.el.getBoundingClientRect();
        if (rect.top <= topOffset) {
          current = headings[i]!;
        } else {
          break;
        }
      }

      setActive(current);
    };

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    const onDepthChanged = () => setTimeout(updateActive, 40);
    const onReadModeChanged = () => setTimeout(updateActive, 60);
    window.addEventListener('shijianus:toc-depth-changed', onDepthChanged);
    window.addEventListener('shijianus:readmode-changed', onReadModeChanged);

    scrollListenerCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      window.removeEventListener('shijianus:toc-depth-changed', onDepthChanged);
      window.removeEventListener('shijianus:readmode-changed', onReadModeChanged);
    };

    updateActive();
  }

  // Universal Dynamic TOC synchronizer & heading scanner
  function syncActiveToc(targetLang: string) {
    const tocCard = document.getElementById('card-toc');
    if (!tocCard) return;

    const tMeta = TOC_I18N[targetLang] || TOC_I18N['zh-CN'];

    // 1. Update Title Header
    const titleEl = tocCard.querySelector('[data-i18n-toc-title]');
    if (titleEl) titleEl.textContent = tMeta.title;

    // 2. Locate or dynamically build the variant TOC list
    let variantList = tocCard.querySelector(`.variant-toc-list[data-lang="${targetLang}"]`) as HTMLElement | null;
    const tocContent = tocCard.querySelector('.toc-content');

    if (!variantList && tocContent) {
      // Dynamic heading scan fallback for active variant in DOM
      const activeArticleVariant = document.querySelector(`.article-translation-variant[data-lang="${targetLang}"]:not([style*="display: none"])`) ||
                                  document.querySelector('.article-translation-variant:not([style*="display: none"])') ||
                                  document.getElementById('article-container');

      if (activeArticleVariant) {
        const domHeadings = Array.from(activeArticleVariant.querySelectorAll('h2, h3, h4, h5, h6')) as HTMLElement[];
        if (domHeadings.length > 0) {
          variantList = document.createElement('div');
          variantList.className = 'variant-toc-list';
          variantList.dataset.lang = targetLang;
          variantList.dataset.tocTitle = tMeta.title;
          variantList.dataset.tocCount = `${domHeadings.length} ${tMeta.unit}`;

          const ol = document.createElement('ol');
          ol.className = 'toc-list';

          domHeadings.forEach((h, index) => {
            const depth = parseInt(h.tagName.substring(1), 10);
            const level = Math.max(0, depth - 2);
            let id = h.id;
            if (!id) {
              id = 'heading-' + index;
              h.id = id;
            }
            const li = document.createElement('li');
            li.className = 'toc-item';
            li.style.setProperty('--toc-level', String(level));

            const a = document.createElement('a');
            a.href = '#' + id;
            a.className = `toc-link level-${level}`;
            a.dataset.depth = String(depth);
            a.dataset.headingId = id;
            a.setAttribute('aria-current', 'false');

            const textGroup = document.createElement('span');
            textGroup.className = 'toc-text-group';
            const textSpan = document.createElement('span');
            textSpan.className = 'toc-text';
            textSpan.textContent = h.textContent?.trim() || `Section ${index + 1}`;
            textGroup.appendChild(textSpan);
            a.appendChild(textGroup);
            li.appendChild(a);
            ol.appendChild(li);
          });

          variantList.appendChild(ol);
          tocContent.appendChild(variantList);
        }
      }
    }

    // 3. Switch visible variant TOC list
    tocCard.querySelectorAll('.variant-toc-list').forEach((vl) => {
      const isMatch = (vl as HTMLElement).dataset.lang === targetLang;
      (vl as HTMLElement).style.display = isMatch ? '' : 'none';
      if (isMatch) {
        const countEl = tocCard.querySelector('[data-i18n-toc-count]');
        if (countEl && (vl as HTMLElement).dataset.tocCount) {
          countEl.textContent = (vl as HTMLElement).dataset.tocCount!;
        }
      }
    });

    // 4. Re-bind ScrollSpy to the active list
    initTocScrollSpy(targetLang);
  }

  function initTocDepthFilter() {
    const cardToc = document.getElementById('card-toc');
    if (!cardToc) return;

    const depthLevels = ['all', '1', '2', '3'];

    const savedDepth = localStorage.getItem('shijianus-toc-depth-filter') || 'all';
    applyDepth(savedDepth);

    const cycleDepth = () => {
      const current = cardToc.getAttribute('data-depth-filter') || 'all';
      const currentIndex = depthLevels.indexOf(current);
      const nextIndex = (currentIndex + 1) % depthLevels.length;
      const nextDepth = depthLevels[nextIndex]!;
      applyDepth(nextDepth);
      localStorage.setItem('shijianus-toc-depth-filter', nextDepth);
    };

    window.addEventListener('shijianus:toggle-toc-depth', (e) => {
      const targetDepth = (e as CustomEvent)?.detail;
      if (targetDepth && depthLevels.includes(targetDepth)) {
        applyDepth(targetDepth);
        localStorage.setItem('shijianus-toc-depth-filter', targetDepth);
      } else {
        cycleDepth();
      }
    });

    function applyDepth(depth: string) {
      if (!depthLevels.includes(depth)) depth = 'all';
      cardToc.setAttribute('data-depth-filter', depth);
      window.dispatchEvent(new CustomEvent('shijianus:toc-depth-changed', { detail: depth }));
    }
  }

  function setupSidebarToc() {
    const activeLang = document.documentElement.lang || 'zh-CN';
    syncActiveToc(activeLang);
    initTocDepthFilter();
  }

  window.addEventListener('shijianus:localechange', (e: any) => {
    const lang = e?.detail;
    if (lang) syncActiveToc(lang);
  });

  document.addEventListener('astro:page-load', setupSidebarToc);
  document.addEventListener('DOMContentLoaded', setupSidebarToc);
</script>

<script is:inline>
  function adjustTocFlex() {
    const tocCards = document.querySelectorAll('#card-toc');
    const isReadMode =
      document.body.classList.contains('read-mode') ||
      document.documentElement.getAttribute('data-readmode') === 'true';
    tocCards.forEach(card => {
      if (isReadMode) {
        card.style.setProperty('flex', '1 1 auto', 'important');
        return;
      }
      const tocList = card.querySelector('.toc-list');
      if (tocList) {
        if (tocList.scrollHeight < 250) {
          card.style.setProperty('flex', '0 1 auto', 'important');
        } else {
          card.style.setProperty('flex', '1 1 auto', 'important');
        }
      }
    });
  }
  adjustTocFlex();
  document.addEventListener('astro:page-load', adjustTocFlex);
  window.addEventListener('resize', adjustTocFlex);
  window.addEventListener('shijianus:readmode-changed', adjustTocFlex);
</script>
