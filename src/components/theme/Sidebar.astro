<script>
  function initTocScrollSpy() {
    const tocCard = document.getElementById('card-toc');
    if (!tocCard) return;
    const tocContent = tocCard.querySelector('.toc-content');
    const links = Array.from(tocCard.querySelectorAll('.toc-link')) as HTMLAnchorElement[];
    
    const headings = links.map(link => {
      let hash = '';
      try {
        hash = decodeURIComponent(link.hash.replace(/^#/, ''));
      } catch (e) {
        hash = link.hash.replace(/^#/, '');
      }
      const el = document.getElementById(hash);
      const depth = parseInt(link.getAttribute('data-depth') || '2', 10);
      return { id: hash, el, link, depth };
    }).filter((h): h is { id: string; el: HTMLElement; link: HTMLAnchorElement; depth: number } => Boolean(h.el));

    if (!headings.length) return;

    // Smooth click handler for TOC links with header offset
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        let hash = '';
        try {
          hash = decodeURIComponent(link.hash.replace(/^#/, ''));
        } catch (err) {
          hash = link.hash.replace(/^#/, '');
        }
        const targetEl = document.getElementById(hash);
        if (targetEl) {
          const topOffset = 80;
          const rect = targetEl.getBoundingClientRect();
          const targetY = window.scrollY + rect.top - topOffset;
          window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });
          if (history.pushState) {
            history.pushState(null, '', '#' + encodeURIComponent(hash));
          }
          setTimeout(updateActive, 100);
        }
      });
    });

    const isLinkVisible = (link: HTMLElement) => {
      const item = link.closest('.toc-item');
      if (!item) return false;
      return window.getComputedStyle(item).display !== 'none';
    };

    const setActive = (targetHeading: { id: string; el: HTMLElement; link: HTMLAnchorElement; depth: number }) => {
      let activeLink = targetHeading.link;

      // If the targeted heading is hidden by depth filter, find the nearest visible ancestor or preceding visible item
      if (!isLinkVisible(activeLink)) {
        let parentItem = activeLink.closest('.toc-item')?.parentElement?.closest('.toc-item');
        while (parentItem) {
          const parentLink = parentItem.querySelector(':scope > .toc-link') as HTMLAnchorElement | null;
          if (parentLink && isLinkVisible(parentLink)) {
            activeLink = parentLink;
            break;
          }
          parentItem = parentItem.parentElement?.closest('.toc-item');
        }

        if (!isLinkVisible(activeLink)) {
          const idx = headings.findIndex(h => h.id === targetHeading.id);
          for (let i = idx; i >= 0; i--) {
            if (isLinkVisible(headings[i]!.link)) {
              activeLink = headings[i]!.link;
              break;
            }
          }
        }
      }

      links.forEach((link) => {
        const isMatch = link === activeLink;
        link.classList.toggle('active', isMatch);
        const item = link.closest('.toc-item');
        if (item) item.classList.toggle('active', isMatch);
      });

      if (activeLink && tocContent) {
        const contentRect = tocContent.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        if (linkRect.top < contentRect.top) {
          tocContent.scrollTop -= (contentRect.top - linkRect.top + 20);
        } else if (linkRect.bottom > contentRect.bottom) {
          tocContent.scrollTop += (linkRect.bottom - contentRect.bottom + 20);
        }
      }
    };

    const updateActive = () => {
      const scrollY = window.scrollY;
      const windowHeight = window.innerHeight;
      const docHeight = document.documentElement.scrollHeight;
      const topOffset = 100;

      // Bottom of page: activate last heading
      if (scrollY + windowHeight >= docHeight - 40) {
        setActive(headings[headings.length - 1]!);
        return;
      }

      // Find last heading whose top has reached or passed topOffset
      let current = headings[0]!;
      for (let i = 0; i < headings.length; i++) {
        const rect = headings[i]!.el.getBoundingClientRect();
        if (rect.top <= topOffset) {
          current = headings[i]!;
        } else {
          break;
        }
      }

      setActive(current);
    };

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateActive();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    window.addEventListener('shijianus:toc-depth-changed', () => {
      setTimeout(updateActive, 40);
    });

    updateActive();
  }

  function initTocDepthFilter() {
    const cardToc = document.getElementById('card-toc');
    const depthBtn = document.getElementById('toc-depth-btn');
    if (!cardToc) return;

    const depthLevels = ['all', '1', '2', '3'];
    const depthLabels: Record<string, string> = {
      'all': '全部',
      '1': '1级',
      '2': '至2级',
      '3': '至3级',
    };

    const savedDepth = localStorage.getItem('shijianus-toc-depth-filter') || 'all';
    applyDepth(savedDepth);

    const cycleDepth = () => {
      const current = cardToc.getAttribute('data-depth-filter') || 'all';
      const currentIndex = depthLevels.indexOf(current);
      const nextIndex = (currentIndex + 1) % depthLevels.length;
      const nextDepth = depthLevels[nextIndex]!;
      applyDepth(nextDepth);
      localStorage.setItem('shijianus-toc-depth-filter', nextDepth);
    };

    if (depthBtn) {
      depthBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        cycleDepth();
      });
    }

    window.addEventListener('shijianus:toggle-toc-depth', () => {
      cycleDepth();
    });

    function applyDepth(depth: string) {
      if (!depthLevels.includes(depth)) depth = 'all';
      cardToc.setAttribute('data-depth-filter', depth);
      if (depthBtn) {
        const labelEl = depthBtn.querySelector('.toc-depth-btn__text');
        if (labelEl) {
          labelEl.textContent = depthLabels[depth] || '全部';
        }
      }
      window.dispatchEvent(new CustomEvent('shijianus:toc-depth-changed', { detail: depth }));
    }
  }

  function setupSidebarToc() {
    initTocScrollSpy();
    initTocDepthFilter();
  }

  document.addEventListener('astro:page-load', setupSidebarToc);
  document.addEventListener('DOMContentLoaded', setupSidebarToc);
</script>

<script is:inline>
  function adjustTocFlex() {
    const tocCards = document.querySelectorAll('#card-toc');
    tocCards.forEach(card => {
      const tocList = card.querySelector('.toc-list');
      if (tocList) {
        if (tocList.scrollHeight < 250) {
          card.style.setProperty('flex', '0 1 auto', 'important');
        } else {
          card.style.setProperty('flex', '1 1 auto', 'important');
        }
      }
    });
  }
  adjustTocFlex();
  document.addEventListener('astro:page-load', adjustTocFlex);
  window.addEventListener('resize', adjustTocFlex);
</script>
