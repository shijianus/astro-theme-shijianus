---
import { Archive, FolderOpen, Info, ListTree, Megaphone, Tags } from 'lucide-react';
import { siteConfig } from '../../config/site';
import {
  getCategoryPath,
  getDisplayPostTitle,
  getPostPath,
  getTagPath,
  resolveDisplayCover,
} from '../../lib/content';
import { createWeightedTaxonomy, type SidebarData, type WeightedTaxonomyItem } from '../../lib/theme';
import { ProfileWidget } from '../ProfileWidget';
import PromoWidgetCard from './PromoWidgetCard.astro';

interface Props extends SidebarData {
  pageType?: string;
  asideId?: string;
}

const {
  recentPosts,
  tags,
  archives,
  categories,
  totalPosts,
  totalCategories,
  totalTags,
  totalReadingMinutes,
  headings = [],
  pageType = 'page',
  asideId = 'aside-content',
} = Astro.props;

const isPostPage = pageType === 'post';
const isPostTocPage = pageType === 'post-toc';
const isPostSecondaryPage = pageType === 'post-secondary';
const isHomePage = pageType === 'home';
const utilityOnlyPageTypes = new Set(['home', 'page', 'post-secondary']);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 6);
const recentPostEntries = recentPosts;

const weightedTags = createWeightedTaxonomy(tags).slice(0, 32);
const formattedArchives = archives.slice(0, 12).map((item) => {
  const date = new Date(item.year, item.month - 1);
  const monthLabel = date.toLocaleDateString('zh-CN', { month: 'long' });
  return {
    ...item,
    formattedMonth: monthLabel,
    fullYear: item.year,
  };
});

const showUtilityAside = utilityOnlyPageTypes.has(pageType);
const showRecentPosts = recentPostEntries.length > 0 && (isHomePage || isPostSecondaryPage || showUtilityAside);
const showToc = (isPostPage || isPostTocPage) && siteConfig.theme.features.postToc && tocHeadings.length > 0;
const showCategories = siteConfig.theme.features.asideCategories && categories.length > 0 && !isHomePage;
const showHomeOverview = isHomePage && (siteConfig.theme.features.asideFeatureCard || siteConfig.theme.features.asideWebInfo);
const showTags = siteConfig.theme.features.asideTags && tags.length > 0;
const showArchives = siteConfig.theme.features.asideArchives && archives.length > 0;
const showWebInfo = siteConfig.theme.features.asideWebInfo;
const showTelegramCard = Boolean(siteConfig.aside.telegramWidget) && (isHomePage || showUtilityAside || isPostTocPage || isPostSecondaryPage);
const showAuthorCard = siteConfig.theme.features.asideAuthor && !isPostSecondaryPage;
const showAnnouncement = siteConfig.theme.features.asideStatus && (isHomePage || isPostPage);
const showStickyUtilityLayout = showHomeOverview || showRecentPosts || showTags || showArchives || showWebInfo;

const runtimeDays = Math.max(
  1,
  Math.floor((Date.now() - new Date(siteConfig.footer.startedAt).valueOf()) / 86_400_000),
);
const startedAtLabel = new Date(siteConfig.footer.startedAt).toLocaleDateString('zh-CN').replaceAll('/', '.');
const currentPhase = siteConfig.home.statusCards[0]?.value ?? siteConfig.site.author.statusLabel;
const latestPublishedAt = recentPosts[0]?.data.pubDate ?? null;
const latestPublishedLabel = latestPublishedAt ? latestPublishedAt.toLocaleDateString('zh-CN').replaceAll('/', '.') : '持续更新';

const escapeHtml = (value: string) =>
  value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

const renderTocNodes = (headings: any[]) =>
  headings
    .map((heading, index) => {
      const indexLabel = String(index + 1).padStart(2, '0');
      return `
        <li class="toc-item" style="--toc-level:${Math.max(0, heading.depth - 2)};">
          <a href="#${escapeHtml(heading.slug)}" class="toc-link" data-depth="${heading.depth}" data-heading-id="${escapeHtml(heading.slug)}">
            <span class="toc-index">${indexLabel}</span>
            <span class="toc-text">${escapeHtml(heading.text)}</span>
          </a>
        </li>
      `;
    })
    .join('');

const getTagStyle = (item: WeightedTaxonomyItem) => {
  const baseSize = 0.85;
  const maxSize = 1.35;
  const fontSize = (baseSize + (maxSize - baseSize) * item.weight).toFixed(2);
  const opacity = (0.55 + 0.45 * item.weight).toFixed(2);
  return `font-size: ${fontSize}rem; opacity: ${opacity}; background: transparent !important; padding: 0 !important; border: none !important; box-shadow: none !important;`;
};
---

<div class="aside-content" id={asideId}>
  {showAuthorCard && (
    <ProfileWidget
      client:load
      name={siteConfig.site.author.name}
      role={siteConfig.site.author.role}
      motto={siteConfig.site.author.motto}
      bio={siteConfig.site.author.bio}
      avatar={siteConfig.site.author.avatar}
      cover={siteConfig.site.author.cover}
      statusLabel={siteConfig.site.author.statusLabel}
      location={siteConfig.site.author.location}
      email={siteConfig.site.author.email}
      stats={{
        posts: totalPosts,
        categories: totalCategories,
        tags: totalTags,
      }}
      stack={siteConfig.aside.stack}
    />
  )}

  {showAnnouncement && (
    <section class="card-widget card-announcement">
      <div class="item-headline">
        <Megaphone className="aside-title-icon" aria-hidden="true" />
        <span>公告</span>
      </div>
      <div class="announcement_content">
        <p>{siteConfig.aside.announcement}</p>
      </div>
    </section>
  )}

  {showTelegramCard && !isPostSecondaryPage && (
    <PromoWidgetCard id="card-telegram" platform="telegram" />
  )}

  {showCategories && (
    <section class="card-widget card-categories">
      <div class="item-headline">
        <FolderOpen className="aside-title-icon" aria-hidden="true" />
        <span>分类</span>
      </div>
      <ul class="card-category-list">
        {categories.slice(0, 8).map((item) => (
          <li class="card-category-list-item">
            <a class="card-category-list-link" href={getCategoryPath(item.slug)}>
              <span class="card-category-list-name">{item.label}</span>
              <span class="card-category-list-count-group">
                <span class="card-category-list-count">{item.count}</span>
                <span>篇</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {showToc && (
    <div class="sticky_layout sticky_layout--toc">
      <section class="card-widget" id="card-toc">
        <div class="item-headline">
          <ListTree className="aside-title-icon" aria-hidden="true" />
          <span>文章目录</span>
          <span class="toc-count">{tocHeadings.length} 节</span>
        </div>
        <div class="toc-content">
          <ol class="toc-list">
            <Fragment set:html={renderTocNodes(tocHeadings)} />
          </ol>
        </div>
      </section>
    </div>
  )}

  {showStickyUtilityLayout && !isPostTocPage && (
    <div id="anzhiyu-aside-sticky" class="sticky_layout aside-sticky-tail">
      {showHomeOverview && (
        <section class="card-widget card-feature-panel card-feature-panel--overview">
          <div class="card-content">
            <div class="feature-card__eyebrow">{siteConfig.aside.featureCard.eyebrow}</div>
            <h3>{siteConfig.aside.featureCard.title}</h3>
            <p>{siteConfig.aside.featureCard.summary}</p>
            <div class="feature-card__chips">
              {siteConfig.aside.featureCard.chips.map((item) => (
                <span>{item}</span>
              ))}
            </div>

            <div class="webinfo-panel">
              <div class="workboard-panel webinfo-workboard">
                <div class="webinfo-workboard__head">
                  <div class="workboard-status">
                    <span class="workboard-dot" aria-hidden="true"></span>
                    <strong>{siteConfig.footer.runtime.workLabel}</strong>
                  </div>
                  <span class="webinfo-workboard__since">始于 {startedAtLabel}</span>
                </div>
                <div class="webinfo-highlight-grid">
                  <article class="webinfo-highlight-card webinfo-highlight-card--primary">
                    <span>站点运行</span>
                    <strong>{runtimeDays} 天</strong>
                  </article>
                </div>
              </div>

              <div class="webinfo-list">
                <div class="webinfo-item">
                  <div class="item-name">文章总数</div>
                  <div class="item-count">{totalPosts}</div>
                </div>
                <div class="webinfo-item">
                  <div class="item-name">标签总数</div>
                  <div class="item-count">{totalTags}</div>
                </div>
                <div class="webinfo-item">
                  <div class="item-name">阅读总量</div>
                  <div class="item-count">{totalReadingMinutes} 分钟</div>
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      {showRecentPosts && !isHomePage && (
        <section class="card-widget card-recent-post">
          <div class="item-headline">
            <span class="aside-title-icon aside-title-icon--text" aria-hidden="true">N</span>
            <span>最新发布</span>
          </div>
          <div class="aside-list">
            {recentPostEntries.slice(0, 6).map((entry) => (
              <a href={getPostPath(entry)} class="aside-list-item">
                <span class="thumbnail">
                  <img src={resolveDisplayCover(entry, true)} alt={getDisplayPostTitle(entry, true)} loading="lazy" />
                </span>
                <span class="content">
                  <span class="title">{getDisplayPostTitle(entry, true)}</span>
                  <time>{entry.data.pubDate.toLocaleDateString('zh-CN')}</time>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      {showTags && !isHomePage && (
        <section class="card-widget card-tags">
          <div class="item-headline">
            <Tags className="aside-title-icon" aria-hidden="true" />
            <span>标签</span>
          </div>
          <div class="card-tag-cloud">
            {weightedTags.map((tag) => (
              <a href={getTagPath(tag.slug)} style={getTagStyle(tag)}>
                {tag.label}
                <sup>{tag.count}</sup>
              </a>
            ))}
          </div>
        </section>
      )}

      {showArchives && !isHomePage && (
        <section class="card-widget card-archives">
          <div class="item-headline">
            <Archive className="aside-title-icon" aria-hidden="true" />
            <span>归档</span>
          </div>
          <div class="card-archive-grid">
            {formattedArchives.map((item) => (
              <a class="archive-grid-item" href="/archives/">
                <span class="archive-month">{item.formattedMonth}</span>
                <span class="archive-year">{item.fullYear}</span>
                <span class="archive-count">{item.count} 篇</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {showWebInfo && !isHomePage && (
        <section class="card-widget card-webinfo">
          <div class="item-headline">
            <Info className="aside-title-icon" aria-hidden="true" />
            <span>站点信息</span>
          </div>
          <div class="webinfo-list">
            <div class="webinfo-item">
              <div class="item-name">文章总数</div>
              <div class="item-count">{totalPosts}</div>
            </div>
            <div class="webinfo-item">
              <div class="item-name">运行时间</div>
              <div class="item-count">{runtimeDays} 天</div>
            </div>
            <div class="webinfo-item">
              <div class="item-name">阅读时长</div>
              <div class="item-count">{totalReadingMinutes} 分钟</div>
            </div>
          </div>
        </section>
      )}
    </div>
  )}

  {isPostSecondaryPage && showTelegramCard && (
    <PromoWidgetCard id="card-telegram-post" platform="telegram" className="card-telegram--post" />
  )}
</div>

<style is:inline>
  /* Use is:inline to bypass Astro scoping and guarantee override */
  
  #anzhiyu-aside-sticky {
    position: sticky !important;
    top: 80px;
    z-index: 10;
    transition: top 0.3s ease;
  }

  .aside-content .card-widget {
    background: var(--card-bg) !important;
    color: var(--font-color) !important;
    border: 1px solid var(--card-border) !important;
    border-radius: 12px !important;
    margin-bottom: 1rem;
    box-shadow: var(--shadow-border) !important;
  }

  /* Tag Cloud */
  .aside-content .card-tag-cloud {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.6rem !important;
    justify-content: flex-start !important;
    padding: 0.4rem 0.2rem !important;
  }

  .aside-content .card-tag-cloud a {
    color: var(--font-color) !important;
    text-decoration: none !important;
    background: transparent !important;
    padding: 0 !important;
    margin: 0 !important;
    border: none !important;
    transition: color 0.2s ease, opacity 0.2s ease !important;
    white-space: nowrap !important;
  }

  .aside-content .card-tag-cloud a:hover {
    color: var(--theme-main) !important;
    opacity: 1 !important;
  }

  .aside-content .card-tag-cloud sup {
    display: inline-block !important;
    margin-left: 1px !important;
    font-size: 0.65em !important;
    opacity: 0.5 !important;
    vertical-align: super !important;
    border: none !important;
    background: transparent !important;
  }

  /* Archives Grid */
  .aside-content .card-archive-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 0.5rem !important;
    margin-top: 0.8rem !important;
  }

  .aside-content .archive-grid-item {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0.8rem !important;
    background: rgba(255, 255, 255, 0.05) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    border-radius: 10px !important;
    text-decoration: none !important;
    transition: all 0.2s ease !important;
  }

  :root[data-theme='light'] .aside-content .archive-grid-item {
    background: rgba(0, 0, 0, 0.03) !important;
    border-color: rgba(0, 0, 0, 0.05) !important;
  }

  .aside-content .archive-grid-item:hover {
    background: var(--theme-main) !important;
    color: #fff !important;
    border-color: transparent !important;
  }

  .aside-content .archive-month { font-size: 0.75rem !important; opacity: 0.7 !important; }
  .aside-content .archive-year { font-size: 0.65rem !important; opacity: 0.4 !important; }
  .aside-content .archive-count { font-size: 1.1rem !important; font-weight: 700 !important; }

  .aside-content .archive-grid-item:hover :is(.archive-month, .archive-year, .archive-count) {
    color: #fff !important;
    opacity: 1 !important;
  }

  /* WebInfo List */
  .aside-content .webinfo-list {
    margin-top: 1rem !important;
    padding-top: 1rem !important;
    border-top: 1px dashed rgba(255, 255, 255, 0.12) !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 0.6rem !important;
  }

  :root[data-theme='light'] .aside-content .webinfo-list {
    border-top-color: rgba(0, 0, 0, 0.1) !important;
  }

  .aside-content .webinfo-item {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    font-size: 0.9rem !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    min-height: 0 !important;
    box-shadow: none !important;
  }

  .aside-content .item-name { color: var(--secondtext) !important; font-weight: normal !important; }
  .aside-content .item-count { color: var(--font-color) !important; font-weight: 700 !important; }
</style>

<script is:inline>
  (() => {
    const aside = document.getElementById('anzhiyu-aside-sticky');
    if (!aside) return;

    const updateSticky = () => {
      const height = aside.offsetHeight;
      const viewportHeight = window.innerHeight;
      const header = document.getElementById('page-header');
      const headerHeight = header ? header.offsetHeight : 60;
      const padding = 20;

      if (height + headerHeight + padding < viewportHeight) {
        aside.style.top = (headerHeight + padding) + 'px';
      } else {
        aside.style.top = (viewportHeight - height - padding) + 'px';
      }
    };

    window.addEventListener('scroll', updateSticky, { passive: true });
    window.addEventListener('resize', updateSticky, { passive: true });
    
    // Initial runs
    updateSticky();
    setTimeout(updateSticky, 100);
    setTimeout(updateSticky, 1000);
    
    if (window.ResizeObserver) {
      new ResizeObserver(updateSticky).observe(aside);
    }
  })();
</script>
