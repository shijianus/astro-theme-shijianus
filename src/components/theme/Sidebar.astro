---
import { Archive, Compass, FolderOpen, History, Info, ListTree, Megaphone, Tags, Activity } from 'lucide-react';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import {
  getCategoryPath,
  getDisplayPostTitle,
  getPostPath,
  getTagPath,
  resolveDisplayCover,
  collectTags,
  collectArchives,
  estimateWordCount,
} from '../../lib/content';
import type { SidebarData } from '../../lib/theme';
import { ProfileWidget } from '../ProfileWidget';
import PromoWidgetCard from './PromoWidgetCard.astro';

interface Props extends SidebarData {
  pageType?: string;
  asideId?: string;
}

type TocHeading = Props['headings'][number];
type TocNode = {
  heading: TocHeading;
  index: number;
  level: number;
  children: TocNode[];
};

const {
  recentPosts,
  tags,
  archives,
  categories,
  totalPosts,
  totalCategories,
  totalTags,
  totalReadingMinutes,
  headings = [],
  variantHeadings = {},
  pageType = 'page',
  asideId = 'aside-content',
  previousPost = null,
  nextPost = null,
  lang: currentLang = 'zh-CN',
} = Astro.props;

const TOC_I18N: Record<string, { title: string; unit: string }> = {
  'zh-CN': { title: '文章目录', unit: '节' },
  'zh-Hant': { title: '文章目錄', unit: '節' },
  en: { title: 'Contents', unit: 'sections' },
  es: { title: 'Contenido', unit: 'secciones' },
  de: { title: 'Inhalt', unit: 'Abschnitte' },
  fr: { title: 'Sommaire', unit: 'sections' },
};
const defaultTocMeta = TOC_I18N[currentLang] || TOC_I18N['zh-CN'];

// Fetch real data for dynamic widgets
const allPublicPosts = await getCollection('posts', ({ data }) => !data.draft);
const realTotalPosts = allPublicPosts.length;
const realTotalWords = allPublicPosts.reduce((acc, post) => acc + estimateWordCount(post), 0);
const realTotalWordsK = (realTotalWords / 1000).toFixed(1);
const realTags = collectTags(allPublicPosts);
const realArchives = collectArchives(allPublicPosts);
const realRuntimeDays = Math.max(
  1,
  Math.floor((Date.now() - new Date('2021-03-31T16:00:00.000Z').valueOf()) / 86_400_000),
);

const isPostPage = pageType === 'post';
const isHomePage = pageType === 'home';

function buildTocTree(rawHeadings: typeof headings) {
  const filtered = (rawHeadings || []).filter((heading) => heading.depth >= 2 && heading.depth <= 6);
  const baseDepth = filtered[0]?.depth ?? 2;
  const roots: TocNode[] = [];
  const stack: TocNode[] = [];

  filtered.forEach((heading, index) => {
    const node: TocNode = {
      heading,
      index,
      level: Math.max(0, heading.depth - baseDepth),
      children: [],
    };

    while (stack.length > 0 && stack[stack.length - 1]!.heading.depth >= heading.depth) {
      stack.pop();
    }

    if (stack.length === 0) {
      roots.push(node);
    } else {
      stack[stack.length - 1]!.children.push(node);
    }

    stack.push(node);
  });

  return { tree: roots, count: filtered.length, headings: filtered };
}

const defaultToc = buildTocTree(headings);
const tocHeadings = defaultToc.headings;
const tocTree = defaultToc.tree;

const variantTocEntries = Object.entries(variantHeadings || {}).map(([vLang, vHeadings]) => ({
  lang: vLang,
  ...buildTocTree(vHeadings as any),
}));

const recentPostEntries = recentPosts;

const showRecentPosts = recentPostEntries.length > 0 && !isHomePage;
const showToc = isPostPage && siteConfig.theme.features.postToc && tocHeadings.length > 0;
const isShortToc = showToc && tocHeadings.length <= 6;
const showCategories = siteConfig.theme.features.asideCategories && categories.length > 0 && !isHomePage;
const showHomeOverview = isHomePage && (siteConfig.theme.features.asideFeatureCard || siteConfig.theme.features.asideWebInfo);
const showTags = siteConfig.theme.features.asideTags && tags.length > 0 && !isHomePage && !isPostPage;
const showArchives = siteConfig.theme.features.asideArchives && archives.length > 0 && !isHomePage && !isPostPage;
const showWebInfo = siteConfig.theme.features.asideWebInfo && !isHomePage && !isPostPage;
const showTelegramCard = Boolean(siteConfig.aside.telegramWidget);
const showAuthorCard = siteConfig.theme.features.asideAuthor;
const showAnnouncement = siteConfig.theme.features.asideStatus && isHomePage;

const allHomeTags = tags && tags.length > 0 ? tags : realTags;
const sortedHomeTags = [...allHomeTags].sort(
  (a, b) => b.count - a.count || a.label.localeCompare(b.label),
);
const HOME_TAG_LIMIT = (siteConfig.aside as any).overviewCard?.tagsLimit || 24;
const displayedHomeTags = sortedHomeTags.slice(0, HOME_TAG_LIMIT);

// Real metrics synchronized with ThemeOverlays console-webinfo
const sortedPublicPosts = [...allPublicPosts].sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
const trueLatestPost = sortedPublicPosts[0];
const trueLatestPostDate = trueLatestPost
  ? (() => {
      const d = new Date(trueLatestPost.data.pubDate);
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${y}.${m}.${day}`;
    })()
  : '-';
const trueLatestPostHref = trueLatestPost ? getPostPath(trueLatestPost) : '/archives/';

// Dynamic Active Level (Posts in last 30 days) - Synchronized with console-webinfo
const thirtyDaysAgo = new Date();
thirtyDaysAgo.setDate(new Date().getDate() - 30);
const recentPostCount30d = allPublicPosts.filter(
  (p) => new Date(p.data.pubDate) >= thirtyDaysAgo,
).length;
let dynamicActiveLevel = 'Status 0';
if (recentPostCount30d > 8) dynamicActiveLevel = 'Status 4';
else if (recentPostCount30d >= 5) dynamicActiveLevel = 'Status 3';
else if (recentPostCount30d >= 3) dynamicActiveLevel = 'Status 2';
else if (recentPostCount30d >= 1) dynamicActiveLevel = 'Status 1';

// Dynamic Content Density
const avgWordsPerPost = realTotalPosts > 0 ? Math.round(realTotalWords / realTotalPosts) : 0;
let dynamicDensityLevel = 'Level 1';
if (avgWordsPerPost > 3000) dynamicDensityLevel = 'Level 4';
else if (avgWordsPerPost > 1500) dynamicDensityLevel = 'Level 3';
else if (avgWordsPerPost > 800) dynamicDensityLevel = 'Level 2';

const effectiveReadingMinutes = totalReadingMinutes || Math.max(1, Math.ceil(realTotalWords / 300));

// Webinfo Metrics Dictionary (纯数字规范排布，彻底消除不同语系单位长度差异造成的排版错乱)
const WEBINFO_METRIC_DEFAULTS: Record<
  string,
  { label: string; value: string; href?: string; tooltip?: string }
> = {
  posts: {
    label: currentLang === 'en' ? 'Total Posts' : '文章总数',
    value: `${realTotalPosts}`,
    href: '/archives/',
    tooltip: currentLang === 'en' ? `Published ${realTotalPosts} public posts` : `已发布 ${realTotalPosts} 篇公开文章`,
  },
  runtime: {
    label: currentLang === 'en' ? 'Uptime Days' : '建站天数',
    value: `${realRuntimeDays}`,
    tooltip: currentLang === 'en' ? `Operational for ${realRuntimeDays} days` : `安全稳定运行 ${realRuntimeDays} 天`,
  },
  words: {
    label: currentLang === 'en' ? 'Total Words' : '全站字数',
    value: `${realTotalWordsK}k`,
    tooltip: currentLang === 'en' ? `Calculated from ${realTotalPosts} posts (${realTotalWords.toLocaleString()} words)` : `基于全站 ${realTotalPosts} 篇文章精算 (${realTotalWords.toLocaleString()} 字)`,
  },
  lastUpdate: {
    label: currentLang === 'en' ? 'Last Push' : '最后推送',
    value: trueLatestPostDate,
    href: trueLatestPostHref,
    tooltip: currentLang === 'en' ? `Latest post: ${trueLatestPost?.data.title || 'Latest'}` : `最新发布: ${trueLatestPost?.data.title || '最新文章'}`,
  },
  tags: {
    label: currentLang === 'en' ? 'Total Tags' : '标签总数',
    value: `${allHomeTags.length}`,
    href: '/tags/',
    tooltip: currentLang === 'en' ? `Covering ${allHomeTags.length} tags` : `共涵盖 ${allHomeTags.length} 个技术标签`,
  },
  version: {
    label: currentLang === 'en' ? 'Version' : '版本协议',
    value: '2.6.0',
    href: '/version/',
    tooltip: '核心架构版本与协议规范',
  },
  activeLevel: {
    label: currentLang === 'en' ? 'Active Level' : '活跃等级',
    value: dynamicActiveLevel.replace('Status ', 'Lv.'),
    href: '/standards/',
    tooltip: currentLang === 'en' ? `Published ${recentPostCount30d} posts in last 30d` : `近30天发布 ${recentPostCount30d} 篇内容`,
  },
  density: {
    label: currentLang === 'en' ? 'Density' : '内容密度',
    value: dynamicDensityLevel.replace('Level ', 'Lv.'),
    href: '/standards/',
    tooltip: currentLang === 'en' ? `Avg words per post: ~${avgWordsPerPost}` : `平均单篇字数约 ${avgWordsPerPost} 字`,
  },
  reading: {
    label: currentLang === 'en' ? 'Reading Time' : '阅读时长',
    value: `${effectiveReadingMinutes}`,
    tooltip: currentLang === 'en' ? `Est. total reading time: ${effectiveReadingMinutes} min` : `预估全站平均总阅读时长 ${effectiveReadingMinutes} 分钟`,
  },
  architecture: {
    label: currentLang === 'en' ? 'Architecture' : '系统架构',
    value: 'Edge',
    tooltip: '基于 Astro 核心引擎与 Edge Functions',
  },
};

// Site Info 严格限制展示 4 个指标卡片为上限，其余作为可自由配置切换的单一卡片候选池
const configuredWebinfoItems = (
  (siteConfig.aside as any).overviewCard?.webinfo?.items || [
    { key: 'posts' },
    { key: 'runtime' },
    { key: 'words' },
    { key: 'lastUpdate' },
  ]
).slice(0, 4);

const resolvedWebinfoItems = configuredWebinfoItems.map((item: any) => {
  const def = WEBINFO_METRIC_DEFAULTS[item.key] || {
    label: item.label || item.key,
    value: item.value || '-',
    href: item.href,
  };
  return {
    label: item.label || def.label,
    value: item.value || def.value,
    href: item.href === 'auto' ? def.href : (item.href ?? def.href),
    tooltip: item.tooltip ?? def.tooltip,
  };
});

const runtimeDays = Math.max(
  1,
  Math.floor((Date.now() - new Date(siteConfig.footer.startedAt).valueOf()) / 86_400_000),
);
const startedAtLabel = new Date(siteConfig.footer.startedAt).toLocaleDateString('zh-CN').replaceAll('/', '.');
const currentPhase = siteConfig.home.statusCards[0]?.value ?? siteConfig.site.author.statusLabel;
const latestPublishedAt = recentPosts[0]?.data.pubDate ?? null;
const latestPublishedLabel = latestPublishedAt ? latestPublishedAt.toLocaleDateString('zh-CN').replaceAll('/', '.') : '持续更新';
const featurePanelRecentPosts = recentPostEntries.slice(0, 6);
const postRecentPosts = recentPostEntries.slice(0, 3);

const escapeHtml = (value: string) =>
  value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

const renderTocNodes = (nodes: TocNode[]) =>
  nodes
    .map((node) => {
      const { heading, index, level, children } = node;
      const childrenHtml = children.length > 0 ? `<ol class="toc-child-list">${renderTocNodes(children)}</ol>` : '';
      return `
        <li class="toc-item" style="--toc-level:${level};">
          <a href="#${escapeHtml(heading.slug)}" class="toc-link level-${level}" data-depth="${heading.depth}" data-heading-id="${escapeHtml(heading.slug)}" aria-current="false">
            <span class="toc-text-group">
              <span class="toc-text">${escapeHtml(heading.text)}</span>
            </span>
          </a>
          ${childrenHtml}
        </li>
      `;
    })
    .join('');
---

<div class="aside-content" id={asideId} data-toc-compact={isShortToc ? 'true' : 'false'}>
  {showAuthorCard && (
    <ProfileWidget
      client:visible
      name={siteConfig.site.author.name}
      role={siteConfig.site.author.role}
      motto={siteConfig.site.author.motto}
      bio={siteConfig.site.author.bio}
      avatar={siteConfig.site.author.avatar}
      cover={siteConfig.site.author.cover}
      statusLabel={siteConfig.site.author.statusLabel}
      location={siteConfig.site.author.location}
      email={siteConfig.site.author.email}
      stats={{
        posts: totalPosts,
        categories: totalCategories,
        tags: totalTags,
      }}
      stack={siteConfig.aside.stack}
    />
  )}

  {isPostPage ? (
    <div class="sticky_layout" id="post-sticky-layout">
      {/* 1. Track: Article TOC */}
      <div class="aside-track aside-track--toc" id="aside-track-toc">
        <div class="aside-sticky-box" id="aside-sticky-box-toc">
          {showToc && (
            <section class="card-widget" id="card-toc" data-depth-filter="all">
              <div class="item-headline">
                <div class="item-headline__left">
                  <ListTree className="aside-title-icon" aria-hidden="true" />
                  <span class="toc-title-text" data-i18n-toc-title>{defaultTocMeta.title}</span>
                  <span class="toc-count" data-i18n-toc-count>{tocHeadings.length} {defaultTocMeta.unit}</span>
                </div>
                <span class="toc-percentage"></span>
              </div>
              <div class="toc-progress" aria-hidden="true">
                <span class="toc-progress__bar"></span>
              </div>
              <div class="toc-content">
                {variantTocEntries.length > 0 ? (
                  variantTocEntries.map(({ lang: vLang, tree: vTree, count: vCount }) => {
                    const vMeta = TOC_I18N[vLang] || TOC_I18N['zh-CN'];
                    return (
                      <div
                        class="variant-toc-list"
                        data-lang={vLang}
                        data-toc-title={vMeta.title}
                        data-toc-count={`${vCount} ${vMeta.unit}`}
                        style={vLang === currentLang ? '' : 'display: none;'}
                      >
                        <ol class="toc-list">
                          <Fragment set:html={renderTocNodes(vTree)} />
                        </ol>
                      </div>
                    );
                  })
                ) : (
                  <ol class="toc-list">
                    <Fragment set:html={renderTocNodes(tocTree)} />
                  </ol>
                )}
              </div>
            </section>
          )}
        </div>
      </div>

      {/* 2. Track: Recent posts. It can sit under a short TOC before the copyright line. */}
      {showRecentPosts && (
        <div class="aside-track aside-track--recent" id="aside-track-recent">
          <div class="aside-sticky-box" id="aside-sticky-box-recent">
            <section class="card-widget card-recent-post" id="card-recent-post">
              <div class="item-headline">
                <History className="aside-title-icon" aria-hidden="true" />
                <span>最新发布</span>
              </div>
              <div class="aside-list">
                {postRecentPosts.map((entry) => (
                  <a href={getPostPath(entry)} class="aside-list-item">
                    <span class="thumbnail">
                      <img
                        src={resolveDisplayCover(entry, true)}
                        alt={getDisplayPostTitle(entry, true)}
                        loading="lazy"
                        decoding="async"
                        data-fallback-src={siteConfig.post.hero.fallbackImage || '/media/shijianus/default.png'}
                        data-remote-fallback-src={siteConfig.post.hero.remoteFallbackImage || '/media/shijianus/default.png'}
                        onerror={`if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';if(!this.src.endsWith('${siteConfig.post.hero.fallbackImage || '/media/shijianus/default.png'}')){this.src='${siteConfig.post.hero.fallbackImage || '/media/shijianus/default.png'}';}else{this.onerror=null;}}else{this.onerror=null;}`}
                      />
                    </span>
                    <span class="content">
                      <span class="title">{getDisplayPostTitle(entry, true)}</span>
                      <time>{entry.data.pubDate.toLocaleDateString('zh-CN')}</time>
                    </span>
                  </a>
                ))}
              </div>
            </section>

          </div>
        </div>
      )}

      {/* 3. Track: Support Sticky Group (TG Push, Categories). Starts at copyright only. */}
      <div class="aside-track aside-track--support" id="aside-track-support">
        <div class="aside-sticky-box" id="aside-sticky-box-support">
          {showTelegramCard && (
            <PromoWidgetCard id="card-telegram" platform="telegram" className="card-telegram--post" />
          )}

          {showCategories && (
            <section class="card-widget card-categories" id="card-categories">
              <div class="item-headline">
                <FolderOpen className="aside-title-icon" aria-hidden="true" />
                <span>分类</span>
              </div>
              <ul class="card-category-list">
                {categories.slice(0, 6).map((item) => (
                  <li class="card-category-list-item">
                    <a class="card-category-list-link" href={getCategoryPath(item.slug)}>
                      <span class="card-category-list-name">{item.label}</span>
                      <span class="card-category-list-count-group">
                        <span class="card-category-list-count">{item.count}</span>
                        <span>篇</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>
    </div>
  ) : (
    /* Non-Post Pages Layout */
    <>
      {showAnnouncement && (
        <section class="card-widget card-announcement">
          <div class="item-headline">
            <Megaphone className="aside-title-icon" aria-hidden="true" />
            <span>公告</span>
          </div>
          <div class="announcement_content">
            <p>{siteConfig.aside.announcement}</p>
          </div>
        </section>
      )}

      {showTelegramCard && (
        <PromoWidgetCard id="card-telegram" platform="telegram" />
      )}

      {showCategories && (
        <section class="card-widget card-categories">
          <div class="item-headline">
            <FolderOpen className="aside-title-icon" aria-hidden="true" />
            <span>分类</span>
          </div>
          <ul class="card-category-list">
            {categories.slice(0, 8).map((item) => (
              <li class="card-category-list-item">
                <a class="card-category-list-link" href={getCategoryPath(item.slug)}>
                  <span class="card-category-list-name">{item.label}</span>
                  <span class="card-category-list-count-group">
                    <span class="card-category-list-count">{item.count}</span>
                    <span>篇</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="sticky_layout" id="home-sticky-layout">
        {showHomeOverview && (
          <div class="aside-track aside-track--overview" id="aside-track-overview">
            <div class="aside-sticky-box" id="aside-sticky-box-overview">
              <section
                class="card-widget card-feature-panel card-feature-panel--overview card-tag-cloud-panel is-sticky-active"
                id="card-tag-cloud-overview"
              >
                <!-- 1. 热门标签板块 (设置展示上限 24 个，避免无限制扩展) -->
                <div class="overview-section overview-section--tags">
                  <div class="item-headline">
                    <a class="item-headline__left item-headline__title-link" href="/tags/" title={currentLang === 'en' ? 'View all tags' : '查看全部标签'}>
                      <Tags className="aside-title-icon" aria-hidden="true" />
                      <span>{currentLang === 'en' ? 'Popular Tags' : '热门标签'}</span>
                    </a>
                  </div>
                  <div class="card-tag-cloud">
                    {displayedHomeTags.map((tag) => (
                      <a
                        href={getTagPath(tag.slug)}
                        class="tag-cloud-item"
                        title={`${tag.label} (${tag.count})`}
                      >
                        <span class="tag-name">{tag.label}</span>
                        <sup class="tag-count">{tag.count}</sup>
                      </a>
                    ))}
                  </div>
                </div>

                <!-- 2. 精选分类速达 (加宽丰富内容，一键直达核心主题) -->
                {categories.length > 0 && (
                  <div class="overview-section overview-section--categories">
                    <div class="item-headline item-headline--sub">
                      <a class="item-headline__left item-headline__title-link" href="/categories/" title={currentLang === 'en' ? 'View all categories' : '查看全部分类'}>
                        <FolderOpen className="aside-title-icon" aria-hidden="true" />
                        <span>{currentLang === 'en' ? 'Featured Categories' : '精选分类'}</span>
                      </a>
                    </div>
                    <div class="card-category-chips">
                      {categories.slice(0, 6).map((cat) => (
                        <a
                          href={getCategoryPath(cat.slug)}
                          class="category-chip"
                          title={`${cat.label} (${cat.count} 篇)`}
                        >
                          <span class="category-chip__name">{cat.label}</span>
                          <span class="category-chip__count">{cat.count}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                <!-- 3. 网站资讯与极客统计 (深度同步 console-card console-webinfo 扫描引擎，上限严格4个) -->
                <div class="overview-section overview-section--webinfo">
                  <div class="item-headline item-headline--sub">
                    <div class="item-headline__left">
                      <Activity className="aside-title-icon" aria-hidden="true" />
                      <span>{currentLang === 'en' ? 'Site Pulse' : '站点资讯'}</span>
                    </div>
                    <span class="webinfo-live-badge">
                      <span class="webinfo-live-dot" aria-hidden="true"></span>
                      <span>{(siteConfig.aside as any).overviewCard?.webinfo?.liveStatusText || (currentLang === 'en' ? 'Operational' : '正常运行')}</span>
                    </span>
                  </div>
                  <div class="card-webinfo-grid">
                    {resolvedWebinfoItems.map((stat: any) =>
                      stat.href ? (
                        <a href={stat.href} class="webinfo-item webinfo-item--link" title={stat.tooltip || stat.label}>
                          <span class="webinfo-label">{stat.label}</span>
                          <span class="webinfo-val">{stat.value}</span>
                        </a>
                      ) : (
                        <div class="webinfo-item" title={stat.tooltip || stat.label}>
                          <span class="webinfo-label">{stat.label}</span>
                          <span class="webinfo-val">{stat.value}</span>
                        </div>
                      )
                    )}
                  </div>
                </div>
              </section>
            </div>
          </div>
        )}

        {showTags && (
          <section class="card-widget card-tags">
            <div class="item-headline">
              <Tags className="aside-title-icon" aria-hidden="true" />
              <span>标签</span>
            </div>
            <div class="card-tag-cloud">
              {realTags.slice(0, 40).map((tag) => (
                <a href={getTagPath(tag.slug)} style={`font-size: ${Math.min(1.2, 0.95 + tag.count * 0.05)}rem;`}>
                  {tag.label}<sup>{tag.count}</sup>
                </a>
              ))}
            </div>
          </section>
        )}

        {showArchives && (
          <section class="card-widget card-archives">
            <div class="item-headline">
              <Archive className="aside-title-icon" aria-hidden="true" />
              <span>归档</span>
              <a class="card-more-btn" href="/archives/" title="查看更多">
                <i class="anzhiyufont anzhiyu-icon-angle-right"></i>
              </a>
            </div>
            <ul class="card-archive-list">
              {realArchives.slice(0, 8).map((item) => (
                <li class="card-archive-list-item">
                  <a class="card-archive-list-link" href={`/archives/${item.year}/${String(item.month).padStart(2, '0')}/`}>
                    <span class="card-archive-list-date">{new Date(item.year, item.month - 1).toLocaleDateString('zh-CN', { month: 'long', year: 'numeric' })}</span>
                    <div class="card-archive-list-count-group"><span class="card-archive-list-count">{item.count}</span><span>篇</span></div>
                  </a>
