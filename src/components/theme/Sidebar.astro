---
import { Archive, Compass, FolderOpen, Info, ListTree, Megaphone, Tags } from 'lucide-react';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import {
  getCategoryPath,
  getDisplayPostTitle,
  getPostPath,
  getTagPath,
  resolveDisplayCover,
  collectTags,
  collectArchives,
  estimateWordCount,
} from '../../lib/content';
import type { SidebarData } from '../../lib/theme';
import { ProfileWidget } from '../ProfileWidget';
import PromoWidgetCard from './PromoWidgetCard.astro';

interface Props extends SidebarData {
  pageType?: string;
  asideId?: string;
}

type TocHeading = Props['headings'][number];
type TocNode = {
  heading: TocHeading;
  index: number;
  level: number;
  children: TocNode[];
};

const {
  recentPosts,
  tags,
  archives,
  categories,
  totalPosts,
  totalCategories,
  totalTags,
  totalReadingMinutes,
  headings = [],
  pageType = 'page',
  asideId = 'aside-content',
  previousPost = null,
  nextPost = null,
} = Astro.props;

// Fetch real data for dynamic widgets
const allPublicPosts = await getCollection('posts', ({ data }) => !data.draft);
const realTotalPosts = allPublicPosts.length;
const realTotalWords = allPublicPosts.reduce((acc, post) => acc + estimateWordCount(post), 0);
const realTotalWordsK = (realTotalWords / 1000).toFixed(1);
const realTags = collectTags(allPublicPosts);
const realArchives = collectArchives(allPublicPosts);
const realRuntimeDays = Math.max(
  1,
  Math.floor((Date.now() - new Date('2021-03-31T16:00:00.000Z').valueOf()) / 86_400_000),
);

const isPostPage = pageType === 'post';
const isHomePage = pageType === 'home';
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 6);
const recentPostEntries = recentPosts;
const tocBaseDepth = tocHeadings[0]?.depth ?? 2;
const tocTree = (() => {
  const roots: TocNode[] = [];
  const stack: TocNode[] = [];

  tocHeadings.forEach((heading, index) => {
    const node: TocNode = {
      heading,
      index,
      level: Math.max(0, heading.depth - tocBaseDepth),
      children: [],
    };

    while (stack.length > 0 && stack[stack.length - 1]!.heading.depth >= heading.depth) {
      stack.pop();
    }

    if (stack.length === 0) {
      roots.push(node);
    } else {
      stack[stack.length - 1]!.children.push(node);
    }

    stack.push(node);
  });

  return roots;
})();

const showRecentPosts = recentPostEntries.length > 0 && !isHomePage;
const showToc = isPostPage && siteConfig.theme.features.postToc && tocHeadings.length > 0;
const isShortToc = showToc && tocHeadings.length <= 6;
const showCategories = siteConfig.theme.features.asideCategories && categories.length > 0 && !isHomePage;
const showHomeOverview = isHomePage && (siteConfig.theme.features.asideFeatureCard || siteConfig.theme.features.asideWebInfo);
const showTags = siteConfig.theme.features.asideTags && tags.length > 0 && !isHomePage && !isPostPage;
const showArchives = siteConfig.theme.features.asideArchives && archives.length > 0 && !isHomePage && !isPostPage;
const showWebInfo = siteConfig.theme.features.asideWebInfo && !isHomePage && !isPostPage;
const showTelegramCard = Boolean(siteConfig.aside.telegramWidget);
const showAuthorCard = siteConfig.theme.features.asideAuthor;
const showAnnouncement = siteConfig.theme.features.asideStatus && isHomePage;

const runtimeDays = Math.max(
  1,
  Math.floor((Date.now() - new Date(siteConfig.footer.startedAt).valueOf()) / 86_400_000),
);
const startedAtLabel = new Date(siteConfig.footer.startedAt).toLocaleDateString('zh-CN').replaceAll('/', '.');
const currentPhase = siteConfig.home.statusCards[0]?.value ?? siteConfig.site.author.statusLabel;
const latestPublishedAt = recentPosts[0]?.data.pubDate ?? null;
const latestPublishedLabel = latestPublishedAt ? latestPublishedAt.toLocaleDateString('zh-CN').replaceAll('/', '.') : '持续更新';
const featurePanelRecentPosts = recentPostEntries.slice(0, 6);
const postRecentPosts = recentPostEntries.slice(0, 3);

const escapeHtml = (value: string) =>
  value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

const renderTocNodes = (nodes: TocNode[]) =>
  nodes
    .map((node) => {
      const { heading, index, level, children } = node;
      const childrenHtml = children.length > 0 ? `<ol class="toc-child-list">${renderTocNodes(children)}</ol>` : '';
      return `
        <li class="toc-item" style="--toc-level:${level};">
          <a href="#${escapeHtml(heading.slug)}" class="toc-link level-${level}" data-depth="${heading.depth}" data-heading-id="${escapeHtml(heading.slug)}" aria-current="false">
            <span class="toc-text-group">
              <span class="toc-text">${escapeHtml(heading.text)}</span>
            </span>
          </a>
          ${childrenHtml}
        </li>
      `;
    })
    .join('');
---

<div class="aside-content" id={asideId} data-toc-compact={isShortToc ? 'true' : 'false'}>
  {showAuthorCard && (
    <ProfileWidget
      client:visible
      name={siteConfig.site.author.name}
      role={siteConfig.site.author.role}
      motto={siteConfig.site.author.motto}
      bio={siteConfig.site.author.bio}
      avatar={siteConfig.site.author.avatar}
      cover={siteConfig.site.author.cover}
      statusLabel={siteConfig.site.author.statusLabel}
      location={siteConfig.site.author.location}
      email={siteConfig.site.author.email}
      stats={{
        posts: totalPosts,
        categories: totalCategories,
        tags: totalTags,
      }}
      stack={siteConfig.aside.stack}
    />
  )}

  {isPostPage ? (
    <div class="sticky_layout" id="post-sticky-layout">
      {/* 1. Track: Article TOC */}
      <div class="aside-track aside-track--toc" id="aside-track-toc">
        <div class="aside-sticky-box" id="aside-sticky-box-toc">
          {showToc && (
            <section class="card-widget" id="card-toc">
              <div class="item-headline">
                <ListTree className="aside-title-icon" aria-hidden="true" />
                <span>文章目录</span>
                <span class="toc-count">{tocHeadings.length} 节</span>
                <span class="toc-percentage"></span>
              </div>
              <div class="toc-progress" aria-hidden="true">
                <span class="toc-progress__bar"></span>
              </div>
              <div class="toc-content">
                <ol class="toc-list">
                  <Fragment set:html={renderTocNodes(tocTree)} />
                </ol>
              </div>
            </section>
          )}
        </div>
      </div>

      {/* 2. Track: Support Sticky Group (Recent Posts, TG Push, Categories) */}
      <div class="aside-track aside-track--support" id="aside-track-support">
        <div class="aside-sticky-box" id="aside-sticky-box-support">
          {showRecentPosts && (
            <section class="card-widget card-recent-post" id="card-recent-post">
              <div class="item-headline">
                <span class="aside-title-icon aside-title-icon--text" aria-hidden="true">N</span>
                <span>最新发布</span>
              </div>
              <div class="aside-list">
                {postRecentPosts.map((entry) => (
                  <a href={getPostPath(entry)} class="aside-list-item">
                    <span class="thumbnail">
                      <img
                        src={resolveDisplayCover(entry, true)}
                        alt={getDisplayPostTitle(entry, true)}
                        loading="lazy"
                        data-fallback-src={siteConfig.post.hero.fallbackImage}
                      />
                    </span>
                    <span class="content">
                      <span class="title">{getDisplayPostTitle(entry, true)}</span>
                      <time>{entry.data.pubDate.toLocaleDateString('zh-CN')}</time>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          )}

          {showTelegramCard && (
            <PromoWidgetCard id="card-telegram" platform="telegram" className="card-telegram--post" />
          )}

          {showCategories && (
            <section class="card-widget card-categories" id="card-categories">
              <div class="item-headline">
                <FolderOpen className="aside-title-icon" aria-hidden="true" />
                <span>分类</span>
              </div>
              <ul class="card-category-list">
                {categories.slice(0, 6).map((item) => (
                  <li class="card-category-list-item">
                    <a class="card-category-list-link" href={getCategoryPath(item.slug)}>
                      <span class="card-category-list-name">{item.label}</span>
                      <span class="card-category-list-count-group">
                        <span class="card-category-list-count">{item.count}</span>
                        <span>篇</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>
    </div>
  ) : (
    /* Non-Post Pages Layout */
    <>
      {showAnnouncement && (
        <section class="card-widget card-announcement">
          <div class="item-headline">
            <Megaphone className="aside-title-icon" aria-hidden="true" />
            <span>公告</span>
          </div>
          <div class="announcement_content">
            <p>{siteConfig.aside.announcement}</p>
          </div>
        </section>
      )}

      {showTelegramCard && (
        <PromoWidgetCard id="card-telegram" platform="telegram" />
      )}

      {showCategories && (
        <section class="card-widget card-categories">
          <div class="item-headline">
            <FolderOpen className="aside-title-icon" aria-hidden="true" />
            <span>分类</span>
          </div>
          <ul class="card-category-list">
            {categories.slice(0, 8).map((item) => (
              <li class="card-category-list-item">
                <a class="card-category-list-link" href={getCategoryPath(item.slug)}>
                  <span class="card-category-list-name">{item.label}</span>
                  <span class="card-category-list-count-group">
                    <span class="card-category-list-count">{item.count}</span>
                    <span>篇</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="sticky_layout">
        {showHomeOverview && (
          <section class="card-widget card-feature-panel card-feature-panel--overview is-sticky-active">
            <div class="card-content">
              <div class="feature-card__eyebrow">{siteConfig.aside.featureCard.eyebrow}</div>
              <h3>{siteConfig.aside.featureCard.title}</h3>
              <p>{siteConfig.aside.featureCard.summary}</p>
              <div class="feature-card__chips">
                {siteConfig.aside.featureCard.chips.map((item) => (
                  <span>{item}</span>
                ))}
              </div>

              <div class="webinfo-panel">
                <div class="workboard-panel webinfo-workboard">
                  <div class="webinfo-workboard__head">
                    <div class="workboard-status">
                      <span class="workboard-dot" aria-hidden="true"></span>
                      <span class="workboard-label">{siteConfig.footer.runtime.label}</span>
                      <strong>{siteConfig.footer.runtime.workLabel}</strong>
                    </div>
                    <span class="webinfo-workboard__since">始于 {startedAtLabel}</span>
                  </div>
                  <p>{siteConfig.footer.runtime.workDetail}</p>
                  <div class="webinfo-highlight-grid">
                    <article class="webinfo-highlight-card webinfo-highlight-card--primary">
                      <span>站点运行</span>
                      <strong>{runtimeDays} 天</strong>
                      <small>起始于 {startedAtLabel}</small>
                    </article>
                    <article class="webinfo-highlight-card">
                      <span>最近更新</span>
                      <strong>{latestPublishedLabel}</strong>
                      <small>内容仍在持续整理</small>
                    </article>
                    <article class="webinfo-highlight-card">
                      <span>当前阶段</span>
                      <strong>{currentPhase}</strong>
                      <small>优先修正阅读与侧栏体验</small>
                    </article>
                  </div>
                  <div class="workboard-chip-list">
                    <span>{siteConfig.footer.runtime.workLabel}</span>
                    <span>{siteConfig.site.author.statusLabel}</span>
                    <span>{siteConfig.home.announcement.eyebrow}</span>
                  </div>
                </div>

                <div class="webinfo webinfo-grid">
                  <div class="webinfo-item">
                    <div class="webinfo-item-title">
                      <span class="item-name">文章总数</span>
                    </div>
                    <div class="item-count">{totalPosts}</div>
                  </div>
                  <div class="webinfo-item">
                    <div class="webinfo-item-title">
                      <span class="item-name">分类总数</span>
                    </div>
                    <div class="item-count">{totalCategories}</div>
                  </div>
                  <div class="webinfo-item">
                    <div class="webinfo-item-title">
                      <span class="item-name">标签总数</span>
                    </div>
                    <div class="item-count">{totalTags}</div>
                  </div>
                  <div class="webinfo-item">
                    <div class="webinfo-item-title">
                      <span class="item-name">阅读总量</span>
                    </div>
                    <div class="item-count">{totalReadingMinutes} 分钟</div>
                  </div>
                </div>

                {isHomePage && featurePanelRecentPosts.length > 0 && (
                  <div class="feature-panel-recent">
                    <div class="item-headline item-headline--embedded">
                      <span class="aside-title-icon aside-title-icon--text" aria-hidden="true">N</span>
                      <span>最新发布</span>
                    </div>
                    <div class="aside-list">
                      {featurePanelRecentPosts.map((entry) => (
                        <a href={getPostPath(entry)} class="aside-list-item">
                          <span class="thumbnail">
                            <img
                              src={resolveDisplayCover(entry, true)}
                              alt={getDisplayPostTitle(entry, true)}
                              loading="lazy"
                              data-fallback-src={siteConfig.post.hero.fallbackImage}
                            />
                          </span>
                          <span class="content">
                            <span class="title">{getDisplayPostTitle(entry, true)}</span>
                            <time>{entry.data.pubDate.toLocaleDateString('zh-CN')}</time>
                          </span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </section>
        )}

        {showTags && (
          <section class="card-widget card-tags">
            <div class="item-headline">
              <Tags className="aside-title-icon" aria-hidden="true" />
              <span>标签</span>
            </div>
            <div class="card-tag-cloud">
              {realTags.slice(0, 40).map((tag) => (
                <a href={getTagPath(tag.slug)} style={`font-size: ${Math.min(1.2, 0.95 + tag.count * 0.05)}rem;`}>
                  {tag.label}<sup>{tag.count}</sup>
                </a>
              ))}
            </div>
          </section>
        )}

        {showArchives && (
          <section class="card-widget card-archives">
            <div class="item-headline">
              <Archive className="aside-title-icon" aria-hidden="true" />
              <span>归档</span>
              <a class="card-more-btn" href="/archives/" title="查看更多">
                <i class="anzhiyufont anzhiyu-icon-angle-right"></i>
              </a>
            </div>
            <ul class="card-archive-list">
              {realArchives.slice(0, 8).map((item) => (
                <li class="card-archive-list-item">
                  <a class="card-archive-list-link" href={`/archives/${item.year}/${String(item.month).padStart(2, '0')}/`}>
                    <span class="card-archive-list-date">{new Date(item.year, item.month - 1).toLocaleDateString('zh-CN', { month: 'long', year: 'numeric' })}</span>
                    <div class="card-archive-list-count-group"><span class="card-archive-list-count">{item.count}</span><span>篇</span></div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {showWebInfo && (
          <section class="card-widget card-webinfo">
            <div class="item-headline">
              <Info className="aside-title-icon" aria-hidden="true" />
              <span>网站资讯</span>
            </div>
            <div class="webinfo">
              <div class="webinfo-item">
                <div class="webinfo-item-title">
                  <i class="anzhiyufont anzhiyu-icon-file-lines"></i>
                  <div class="item-name">文章总数 :</div>
                </div>
                <div class="item-count">{realTotalPosts}</div>
              </div>
              <div class="webinfo-item">
                <div class="webinfo-item-title">
                  <i class="anzhiyufont anzhiyu-icon-stopwatch"></i>
                  <div class="item-name">建站天数 :</div>
                </div>
                <div class="item-count" id="runtimeshow" data-publishdate="2021-03-31T16:00:00.000Z">
                  {realRuntimeDays} 天
                </div>
              </div>
              <div class="webinfo-item">
                <div class="webinfo-item-title">
                  <i class="anzhiyufont anzhiyu-icon-font"></i>
                  <div class="item-name">全站字数 :</div>
                </div>
                <div class="item-count">{realTotalWordsK}k</div>
              </div>
            </div>
          </section>
        )}

        {showRecentPosts && (
          <section class="card-widget card-recent-post">
            <div class="item-headline">
              <span class="aside-title-icon aside-title-icon--text" aria-hidden="true">N</span>
              <span>最新发布</span>
            </div>
            <div class="aside-list">
              {recentPostEntries.slice(0, 6).map((entry) => (
                <a href={getPostPath(entry)} class="aside-list-item">
                  <span class="thumbnail">
                    <img
                      src={resolveDisplayCover(entry, true)}
                      alt={getDisplayPostTitle(entry, true)}
                      loading="lazy"
                      data-fallback-src={siteConfig.post.hero.fallbackImage}
                    />
                  </span>
                  <span class="content">
                    <span class="title">{getDisplayPostTitle(entry, true)}</span>
                    <time>{entry.data.pubDate.toLocaleDateString('zh-CN')}</time>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </>
  )}
</div>

<style is:global>
  #aside-content {
    width: 300px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
  }

  #aside-content .card-widget {
    margin: 0 !important;
    position: relative;
    border-radius: 12px;
    box-sizing: border-box;
  }

  .sticky_layout {
    position: relative !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 20px !important;
    width: 100%;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Aside Tracks for Post Page */
  .aside-track {
    position: relative !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .aside-track--toc {
    min-height: 120px;
  }

  .aside-track--support {
    min-height: 120px;
  }

  .aside-sticky-box {
    position: -webkit-sticky !important;
    position: sticky !important;
    top: var(--sticky-column-top, 80px) !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 20px !important;
    width: 100% !important;
    z-index: 10 !important;
    transition: top 0.25s ease;
  }
  
  .aside-sticky-box > .card-widget:not(#card-toc) {
    flex-shrink: 0;
  }

  /* b8f2436 EXACT MATCH for #card-toc */
  #card-toc {
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: 20px 24px !important;
    border-radius: 12px !important;
  }

  #aside-content[data-toc-type='long'] #card-toc {
    max-height: calc(100vh - var(--sticky-column-top, 80px) - 32px) !important;
  }
  
  #card-toc .toc-content {
    min-height: 0;
    overflow-y: auto !important;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
    margin-bottom: 0 !important;
  }
  
  body[data-type='post'] #card-toc .toc-content::before,
  body[data-type='post'] #card-toc .toc-content::after {
    display: none !important;
  }

  #card-toc .item-headline,
  #card-toc .toc-content {
    margin: 0 !important;
    padding: 0 !important;
  }
  
  /* Nested Hierarchy Styles - Exact b8f2436 */
  #card-toc .toc-list {
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }
  
  #card-toc .toc-child-list {
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
    border-left: none !important;
  }

  #card-toc .toc-item {
    margin: 4px 0 !important;
    padding: 0 !important;
  }

  /* Add extra space before top-level items (H2) for breathing room, except the first one */
  #card-toc .toc-list > .toc-item + .toc-item {
    margin-top: 14px !important;
  }

  #card-toc .toc-link {
    display: flex !important;
    align-items: center !important;
    padding: 4px 0 !important;
    text-decoration: none !important;
    transition: color 0.2s ease, font-weight 0.2s ease !important;
    width: 100% !important;
    box-sizing: border-box !important;
    border-left: none !important;
    background: transparent !important;
  }

  #card-toc .toc-text-group {
    flex: 1 !important;
    line-height: 1.4 !important;
  }
  
  #card-toc .toc-text {
    display: inline !important;
  }

  #card-toc .toc-link:hover {
    color: var(--theme-main) !important;
    background-color: transparent !important;
  }

  /* Level 0 (H2) */
  #card-toc .toc-link.level-0 {
    font-size: 15px !important;
    font-weight: 600 !important;
    color: var(--font-color) !important;
    padding-left: 4px !important;
  }

  /* Level 1 (H3) */
  #card-toc .toc-link.level-1 {
    font-size: 13px !important;
    font-weight: 500 !important;
    color: color-mix(in srgb, var(--font-color) 80%, transparent) !important;
    padding-left: 12px !important;
  }

  /* Level 2+ (H4+) */
  #card-toc .toc-link.level-2,
  #card-toc .toc-link.level-3,
  #card-toc .toc-link.level-4,
  #card-toc .toc-link.level-5 {
    font-size: 11.5px !important;
    font-weight: 400 !important;
    color: color-mix(in srgb, var(--font-color) 62%, transparent) !important;
    padding-left: 20px !important;
  }

  /* Active highlighting (Current Item) */
  #card-toc .toc-link.active {
    color: var(--theme-main) !important;
    font-weight: 700 !important;
    background-color: transparent !important;
    border-left: none !important;
  }
  
  /* Reset pseudo elements just in case */
  #card-toc .toc-item::before,
  #card-toc .toc-item::after,
  #card-toc .toc-link::before,
  #card-toc .toc-link::after {
    display: none !important;
  }

  /* Refined Categories Card in Post Sidebar */
  .card-categories {
    padding: 18px 20px !important;
  }
  .card-categories .item-headline {
    margin: 0 0 10px 0 !important;
    font-size: 14px !important;
  }
  .card-categories .card-category-list {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: space-between !important;
    gap: 8px !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }
  .card-categories .card-category-list-item {
    width: 100% !important;
    flex: 0 0 calc(50% - 4px) !important;
    box-sizing: border-box !important;
  }
  .card-categories .card-category-list-link {
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
    padding: 8px 10px !important;
    border: var(--style-border-always) !important;
    border-radius: 8px !important;
    color: var(--font-color) !important;
    transition: all 0.25s ease !important;
    text-decoration: none !important;
    box-sizing: border-box !important;
    background: color-mix(in srgb, var(--card-bg, #fff) 80%, var(--font-color) 4%) !important;
  }
  .card-categories .card-category-list-link:hover {
    border-color: transparent !important;
    background: var(--theme-main, #425aef) !important;
    color: #ffffff !important;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--theme-main, #425aef) 30%, transparent) !important;
    transform: translateY(-1px) !important;
  }
  .card-categories .card-category-list-name {
    font-size: 12.5px !important;
    font-weight: 500 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    line-height: 1.2 !important;
  }
  .card-categories .card-category-list-count-group {
    display: flex !important;
    align-items: baseline !important;
    gap: 2px !important;
    line-height: 1 !important;
  }
  .card-categories .card-category-list-count {
    font-size: 13px !important;
    font-weight: 700 !important;
  }
  .card-categories .card-category-list-count-group span:last-child {
    font-size: 11px !important;
    opacity: 0.7 !important;
  }

  @media screen and (max-width: 1200px) {
    .page-aside {
      display: none !important;
    }
  }

  body[data-type='post'] #content-inner.layout {
    overflow: visible !important;
    overflow-x: visible !important;
  }
</style>

<script>
  function initTocScrollSpy() {
    const tocCard = document.getElementById('card-toc');
    if (!tocCard) return;
    const tocContent = tocCard.querySelector('.toc-content');
    const links = Array.from(tocCard.querySelectorAll('.toc-link'));
    
    const headings = links.map(link => {
      let hash = '';
      try {
        hash = decodeURIComponent(link.hash.replace(/^#/, ''));
      } catch (e) {
        hash = link.hash.replace(/^#/, '');
      }
      const el = document.getElementById(hash);
      return { id: hash, el, link };
    }).filter(h => h.el);

    if (!headings.length) return;

    // Smooth click handler for TOC links with header offset
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        let hash = '';
        try {
          hash = decodeURIComponent(link.hash.replace(/^#/, ''));
        } catch (err) {
          hash = link.hash.replace(/^#/, '');
        }
        const targetEl = document.getElementById(hash);
        if (targetEl) {
          const topOffset = 80;
          const rect = targetEl.getBoundingClientRect();
          const targetY = window.scrollY + rect.top - topOffset;
          window.scrollTo({ top: Math.max(0, targetY), behavior: 'smooth' });
          if (history.pushState) {
            history.pushState(null, '', '#' + encodeURIComponent(hash));
          }
        }
      });
    });

    const setActive = (activeId) => {
      let currentActive = null;
      let activeIndex = headings.findIndex(h => h.id === activeId);

      links.forEach((link, index) => {
        link.classList.remove('active', 'dist-1', 'dist-2', 'dist-3');
        let parent = link.parentElement;
        while(parent && parent.classList.contains('toc-item')) {
          parent.classList.remove('active');
          parent = parent.parentElement?.closest('.toc-item');
        }
        
        if (activeIndex !== -1) {
          const dist = Math.abs(index - activeIndex);
          if (dist === 0) {
            link.classList.add('active');
            currentActive = link;
            let p = link.parentElement;
            while(p && p.classList.contains('toc-item')) {
              p.classList.add('active');
              p = p.parentElement?.closest('.toc-item');
            }
          } else if (dist <= 3) {
            link.classList.add(`dist-${dist}`);
          }
        }
      });

      if (currentActive && tocContent) {
        const contentRect = tocContent.getBoundingClientRect();
        const linkRect = currentActive.getBoundingClientRect();
        
        if (linkRect.top < contentRect.top) {
          tocContent.scrollTop -= (contentRect.top - linkRect.top + 20);
        } else if (linkRect.bottom > contentRect.bottom) {
          tocContent.scrollTop += (linkRect.bottom - contentRect.bottom + 20);
        }
      }
    };

    let activeId = headings[0]?.id;
    const observer = new IntersectionObserver((entries) => {
      let intersectingEntry = null;
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          intersectingEntry = entry;
        }
      });
      if (intersectingEntry) {
        activeId = intersectingEntry.target.id;
        setActive(activeId);
      }
    }, { rootMargin: '-80px 0px -70% 0px' });
    
    headings.forEach(h => observer.observe(h.el));
    if (activeId) setActive(activeId);
  }

  document.addEventListener('astro:page-load', initTocScrollSpy);
  document.addEventListener('DOMContentLoaded', initTocScrollSpy);
</script>

<script is:inline>
  function adjustTocFlex() {
    const tocCards = document.querySelectorAll('#card-toc');
    tocCards.forEach(card => {
      const tocList = card.querySelector('.toc-list');
      if (tocList) {
        if (tocList.scrollHeight < 250) {
          card.style.setProperty('flex', '0 1 auto', 'important');
        } else {
          card.style.setProperty('flex', '1 1 auto', 'important');
        }
      }
    });
  }
  adjustTocFlex();
  document.addEventListener('astro:page-load', adjustTocFlex);
  window.addEventListener('resize', adjustTocFlex);
</script>
