---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  meta?: string[];
}

const { eyebrow, title, summary, image, imageAlt, meta = [] } = Astro.props;
---

<section class="relative overflow-hidden rounded-md border border-[var(--line)] bg-[var(--surface)]">
  <img
    src={image}
    alt={imageAlt}
    class="absolute inset-0 h-full w-full object-cover opacity-30"
    loading="eager"
  />
  <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(10,15,13,0.18),rgba(10,15,13,0.82))]" />
  <div class="relative z-10 grid min-h-[320px] gap-8 px-6 py-8 md:min-h-[360px] md:px-10 md:py-10 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="flex flex-col justify-end gap-4">
      <p class="eyebrow text-white/70">{eyebrow}</p>
      <h1 class="max-w-3xl text-4xl font-semibold leading-tight text-white md:text-5xl">
        {title}
      </h1>
      <p class="max-w-2xl text-base leading-7 text-white/80 md:text-lg">
        {summary}
      </p>
    </div>
    {meta.length > 0 && (
      <div class="self-end rounded-md border border-white/15 bg-black/20 p-4 backdrop-blur-sm">
        <p class="eyebrow text-white/60">Snapshot</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {meta.map((item) => (
            <span class="rounded-md border border-white/15 px-2.5 py-1 text-xs text-white/80">
              {item}
            </span>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
