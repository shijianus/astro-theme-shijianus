---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  meta?: string[];
}

const { eyebrow, title, summary, image, imageAlt, meta = [] } = Astro.props;
---

<section class="theme-card theme-card--accent page-hero">
  <img src={image} alt={imageAlt} class="page-hero__image" loading="eager" />
  <div class="page-hero__overlay"></div>
  <div class="page-hero__grid">
    <div class="space-y-4">
      <p class="eyebrow text-white/70">{eyebrow}</p>
      <h1 class="max-w-3xl text-4xl font-semibold leading-tight text-white md:text-5xl">{title}</h1>
      <p class="max-w-2xl text-sm leading-7 text-white/78 md:text-base">{summary}</p>
    </div>

    {meta.length > 0 && (
      <div class="page-hero__meta">
        <p class="eyebrow text-white/60">Snapshot</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {meta.map((item) => (
            <span class="theme-chip theme-chip--soft text-white/85">{item}</span>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
