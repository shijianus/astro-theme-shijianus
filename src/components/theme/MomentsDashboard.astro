    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .radar-ping {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: radarPulse 1.8s infinite;
  }

  @keyframes radarPulse {
    0% { transform: scale(0.9); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.4; }
    100% { transform: scale(0.9); opacity: 1; }
  }

  .profile-bio {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-secondary, #64748b);
  }

  .qzone-stats-grid {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.75rem 1.25rem;
    background: rgba(66, 90, 239, 0.05);
    border: 1px solid rgba(66, 90, 239, 0.12);
    border-radius: 10px;
  }

  .space-stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .stat-number {
    font-size: 1.15rem;
    font-weight: 850;
  }

  .stat-number.is-accent { color: #f59e0b; }
  .stat-number.is-purple { color: #8b5cf6; }
  .stat-number.is-blue { color: #3b82f6; }
  .stat-number.is-pink { color: #ec4899; }
  .stat-number.is-teal { color: #0d9488; }

  .stat-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-secondary, #64748b);
  }

  /* QQ 空间子导航栏 */
  .qzone-subnav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 2rem;
    border-top: 1px solid rgba(66, 90, 239, 0.1);
    background: rgba(66, 90, 239, 0.02);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .subnav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .subnav-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.88rem;
    font-weight: 750;
    color: var(--font-color);
    text-decoration: none;
    transition: all 0.2s ease;
    background: rgba(0, 0, 0, 0.03);
  }

  :root[data-theme='dark'] .subnav-item {
    background: rgba(255, 255, 255, 0.05);
  }

  .subnav-item:hover {
    color: var(--theme-main, #425aef);
    background: rgba(66, 90, 239, 0.1);
  }

  .subnav-item.is-active {
    background: var(--theme-main, #425aef);
    color: #fff;
    box-shadow: 0 4px 12px rgba(66, 90, 239, 0.3);
  }

  /* QQ 空间式赞者头像流 */
  .moment-likes-preview {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background: rgba(66, 90, 239, 0.04);
    border-radius: 8px;
    font-size: 0.8rem;
    color: var(--text-secondary, #64748b);
    margin-top: 0.25rem;
  }

  .likes-preview-heart {
    font-size: 0.85rem;
  }

  .likes-avatar-stack {
    display: flex;
    align-items: center;
    margin-left: 2px;
  }

  .likes-avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--card-bg, #fff);
    margin-left: -6px;
    object-fit: cover;
    transition: transform 0.2s;
  }

  .likes-avatar:first-child {
    margin-left: 0;
  }

  .likes-avatar:hover {
    transform: scale(1.2);
    z-index: 2;
  }

  .likes-avatar.is-my-like {
    border-color: #ef4444;
    animation: heartBeat 0.5s ease;
  }

  .likes-preview-text {
    font-weight: 700;
    margin-left: 4px;
  }

  /* 访客头像与输入布局 */
  .comment-form-avatar-layout {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .comment-visitor-avatar-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    flex-shrink: 0;
  }

  .comment-visitor-avatar-img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(66, 90, 239, 0.25);
    background: rgba(0, 0, 0, 0.03);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .comment-visitor-avatar-img:hover {
    transform: scale(1.05);
    border-color: var(--theme-main, #425aef);
  }

  .visitor-avatar-label {
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--text-secondary, #64748b);
  }

  .comment-form-main-fields {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* 踩一踩浮动动画 */
  .qzone-floating-paw {
    position: fixed;
    z-index: 99999;
    color: #d97706;
    font-size: 0.95rem;
    font-weight: 850;
    pointer-events: none;
    animation: floatUpPaw 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    background: rgba(254, 243, 199, 0.95);
    padding: 4px 10px;
    border-radius: 12px;
    border: 1px solid rgba(245, 158, 11, 0.4);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.25);
  }

  @keyframes floatUpPaw {
    0% {
      opacity: 0;
      transform: translate(-50%, 0) scale(0.6);
    }
    20% {
      opacity: 1;
      transform: translate(-50%, -20px) scale(1.1);
    }
    80% {
      opacity: 0.9;
      transform: translate(-50%, -60px) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -90px) scale(0.9);
    }
  }

  /* 2. 主舞台容器 */
  .moments-main-stage {
    position: relative;
    width: 100%;
  }

  .moments-stream-view {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .moments-stream-header {
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .moments-search-input-wrap {
    position: relative;
    width: 100%;
    max-width: 360px;
  }

  .moments-search-input-wrap .search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--text-secondary, #94a3b8);
  }

  .moments-search-input-wrap input {
    width: 100%;
    padding: 8px 12px 8px 36px;
    border-radius: 20px;
    border: 1px solid rgba(66, 90, 239, 0.2);
    background: rgba(0, 0, 0, 0.02);
    font-size: 0.85rem;
    color: var(--font-color);
    box-sizing: border-box;
    transition: all 0.2s ease;
  }

  :root[data-theme='dark'] .moments-search-input-wrap input {
    background: rgba(255, 255, 255, 0.04);
  }

  .moments-search-input-wrap input:focus {
    outline: none;
    border-color: var(--theme-main, #425aef);
    box-shadow: 0 0 0 3px rgba(66, 90, 239, 0.15);
  }

  /* 说说瀑布流网格与卡片 */
  .moments-feed {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .moment-card {
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    border-radius: 12px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .moment-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(66, 90, 239, 0.08);
  }

  .moment-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .moment-author-link {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    background: transparent;
    border: none;
    padding: 0;
    text-align: left;
  }

  .author-avatar-wrap {
    position: relative;
    width: 46px;
    height: 46px;
  }

  .moment-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(66, 90, 239, 0.2);
  }

  .avatar-crown-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    background: #f59e0b;
    color: #fff;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    border: 1px solid #fff;
  }

  .moment-author-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .moment-author-name {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .name-text {
    font-size: 0.98rem;
    font-weight: 850;
    color: var(--font-color);
  }

  .badge-pill {
    font-size: 0.7rem;
    font-weight: 750;
    padding: 1px 6px;
    border-radius: 4px;
  }

  .badge-pill.is-owner {
    background: rgba(245, 158, 11, 0.15);
    color: #d97706;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .badge-pill.is-friend {
    background: rgba(66, 90, 239, 0.12);
    color: var(--theme-main, #425aef);
    border: 1px solid rgba(66, 90, 239, 0.25);
  }

  .mood-pill {
    font-size: 0.72rem;
    padding: 1px 6px;
    border-radius: 10px;
    background: rgba(66, 90, 239, 0.06);
    color: var(--text-secondary, #64748b);
  }

  .moment-meta-sub {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--text-secondary, #64748b);
  }

  .device-pill {
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.04);
  }

  :root[data-theme='dark'] .device-pill {
    background: rgba(255, 255, 255, 0.06);
  }

  .moment-category-tag {
    font-size: 0.78rem;
    font-weight: 750;
    color: var(--theme-main, #425aef);
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(66, 90, 239, 0.08);
  }

  .moment-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .moment-title {
    margin: 0;
  }

  .moment-title-btn {
    background: transparent;
    border: none;
    padding: 0;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--font-color);
    text-align: left;
    cursor: pointer;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .moment-title-btn:hover {
    color: var(--theme-main, #425aef);
  }

  .moment-summary-bubble {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--font-color);
    position: relative;
  }

  .moment-summary-bubble.is-clamped .moment-summary {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .btn-toggle-expand {
    background: transparent;
    border: none;
    padding: 4px 0;
    font-size: 0.85rem;
    font-weight: 750;
    color: var(--theme-main, #425aef);
    cursor: pointer;
  }

  .moment-photos-grid {
    display: grid;
    gap: 8px;
    margin: 0.25rem 0;
  }

  .photos-count-1 { grid-template-columns: 1fr; max-width: 480px; }
  .photos-count-2, .photos-count-4 { grid-template-columns: repeat(2, 1fr); max-width: 480px; }
  .photos-count-3, .photos-count-5, .photos-count-6, .photos-count-7, .photos-count-8, .photos-count-9 {
    grid-template-columns: repeat(3, 1fr);
    max-width: 620px;
  }

  .moment-photo-item {
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    background: rgba(0, 0, 0, 0.04);
  }

  .moment-photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .moment-photo-item:hover img {
    transform: scale(1.04);
  }

  .photos-more-badge {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 800;
  }

  .moment-tags {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .moment-tag {
    font-size: 0.75rem;
    color: var(--theme-main, #425aef);
    opacity: 0.85;
  }

  .moment-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(66, 90, 239, 0.08);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-action-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .moment-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.06);
    color: var(--font-color);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :root[data-theme='dark'] .moment-action-btn {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .moment-action-btn:hover {
    background: rgba(66, 90, 239, 0.08);
    color: var(--theme-main, #425aef);
  }

  .moment-like-btn.is-liked {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.2);
  }

  .heart-burst {
    animation: heartBeat 0.6s ease;
  }

  @keyframes heartBeat {
    0% { transform: scale(1); }
    30% { transform: scale(1.4); }
    60% { transform: scale(0.9); }
    100% { transform: scale(1); }
  }

  .footer-detail-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .moment-detail-open-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    border-radius: 6px;
    background: rgba(66, 90, 239, 0.08);
    border: 1px solid rgba(66, 90, 239, 0.18);
    color: var(--theme-main, #425aef);
    font-size: 0.85rem;
    font-weight: 750;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .moment-detail-open-btn:hover {
    background: var(--theme-main, #425aef);
    color: #fff;
  }

  .moment-origin-tag {
    font-size: 0.8rem;
    color: var(--text-secondary, #64748b);
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.04);
  }

  .moment-origin-tag:hover {
    color: var(--theme-main, #425aef);
  }

  /* 评论抽屉 */
  .moment-comments-drawer {
    margin-top: 0.5rem;
    border-top: 1px dashed rgba(66, 90, 239, 0.15);
    padding-top: 1rem;
    animation: fadeIn 0.2s ease;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    font-weight: 750;
  }

  .drawer-hint {
    font-size: 0.78rem;
    color: var(--text-secondary, #64748b);
  }

  .moment-comments-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 1rem;
    max-height: 280px;
    overflow-y: auto;
  }

  .comment-item {
    display: flex;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    background: rgba(66, 90, 239, 0.03);
    font-size: 0.85rem;
  }

  .comment-item.is-master-comment {
    background: rgba(245, 158, 11, 0.06);
    border-left: 3px solid #f59e0b;
  }

  .comment-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .comment-content-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .comment-header-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
  }

  .comment-author-name {
    font-weight: 750;
    color: var(--font-color);
  }

  .comment-role-badge {
    font-size: 0.68rem;
    padding: 1px 5px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.06);
  }

  .comment-role-badge.is-master {
    background: #f59e0b;
    color: #fff;
  }

  .comment-geo-flag {
    font-size: 0.7rem;
    color: var(--text-secondary, #64748b);
  }

  .comment-time {
    color: var(--text-secondary, #94a3b8);
    margin-left: auto;
  }

  .comment-message-body {
    line-height: 1.5;
    color: var(--font-color);
    word-break: break-word;
  }

  .comment-item-actions {
    display: flex;
    justify-content: flex-end;
  }

  .btn-reply-comment {
    background: transparent;
    border: none;
    font-size: 0.75rem;
    color: var(--theme-main, #425aef);
    cursor: pointer;
    padding: 0;
  }

  /* 发评表单 */
  .moment-quick-comment-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-row-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  @media (max-width: 600px) {
    .form-row-meta {
      grid-template-columns: 1fr;
    }
  }

  .meta-input-group {
    position: relative;
    display: flex;
    align-items: center;
  }

  .meta-input-group .input-icon {
    position: absolute;
    left: 10px;
    font-size: 0.85rem;
  }

  .meta-input-group .btn-random-nickname {
    position: absolute;
    right: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .comment-input {
    width: 100%;
    padding: 6px 10px 6px 32px;
    border-radius: 6px;
    border: 1px solid rgba(66, 90, 239, 0.18);
    background: rgba(0, 0, 0, 0.02);
    font-size: 0.82rem;
    color: var(--font-color);
    box-sizing: border-box;
  }

  :root[data-theme='dark'] .comment-input {
    background: rgba(255, 255, 255, 0.03);
  }

  .comment-textarea {
    width: 100%;
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid rgba(66, 90, 239, 0.18);
    background: rgba(0, 0, 0, 0.02);
    font-size: 0.85rem;
    color: var(--font-color);
    box-sizing: border-box;
    resize: vertical;
  }

  :root[data-theme='dark'] .comment-textarea {
    background: rgba(255, 255, 255, 0.03);
  }

  .form-row-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }

  .emoji-quick-bar {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .quick-emoji-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    padding: 2px 4px;
    border-radius: 4px;
    transition: background 0.15s;
  }

  .quick-emoji-btn:hover {
    background: rgba(66, 90, 239, 0.1);
  }

  .comment-submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    border-radius: 6px;
    background: var(--theme-main, #425aef);
    color: #fff;
    border: none;
    font-size: 0.85rem;
    font-weight: 750;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .comment-submit-btn:hover {
    background: #3549d4;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(66, 90, 239, 0.35);
  }

  /* 瀑布流终点提示 */
  .stream-timeline-end {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 2.5rem 0 1rem;
  }

  .stream-timeline-end .end-line {
    flex: 1;
    height: 1px;
    background: rgba(66, 90, 239, 0.15);
  }

  .stream-timeline-end .end-pill {
    font-size: 0.85rem;
    color: var(--text-secondary, #64748b);
    padding: 6px 18px;
    border-radius: 20px;
    background: rgba(66, 90, 239, 0.05);
    border: 1px solid rgba(66, 90, 239, 0.12);
  }

  /* 视图 B：说说详情页面内加载容器 (完全内嵌，非弹窗) */
  .moment-inpage-detail-view {
    padding: 0;
    overflow: hidden;
    animation: fadeIn 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .inpage-nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.75rem;
    border-bottom: 1px solid rgba(66, 90, 239, 0.12);
    background: rgba(66, 90, 239, 0.04);
  }

  .btn-inpage-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 8px;
    background: rgba(66, 90, 239, 0.1);
    color: var(--theme-main, #425aef);
    border: 1px solid rgba(66, 90, 239, 0.2);
    font-size: 0.88rem;
    font-weight: 750;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-inpage-back:hover {
    background: var(--theme-main, #425aef);
    color: #fff;
  }

  .inpage-header-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--font-color);
  }

  .btn-inpage-share {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 0.85rem;
    font-weight: 750;
    color: var(--font-color);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :root[data-theme='dark'] .btn-inpage-share {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .btn-inpage-share:hover {
    background: rgba(66, 90, 239, 0.1);
    color: var(--theme-main, #425aef);
  }

  .inpage-header {
    padding: 1.5rem 1.75rem 1rem;
    border-bottom: 1px solid rgba(66, 90, 239, 0.08);
  }

