---
import { friendsConfig, type MomentItem } from '../../config/friends';

interface Props {
  moments?: MomentItem[];
}

const { moments: propMoments } = Astro.props;
const moments: MomentItem[] = propMoments && propMoments.length > 0 ? propMoments : friendsConfig.moments;
const settings = friendsConfig.momentsSettings || {};
const totalFriends = friendsConfig.categories.reduce((acc, cat) => acc + cat.items.length, 0);
const ownerMomentsCount = moments.filter((m) => m.isOwner).length;
const friendMomentsCount = moments.filter((m) => !m.isOwner).length;
const totalLikes = moments.reduce((acc, m) => acc + (m.likes || 0), 0);
---

<section id="moments-dashboard" class="moments-dashboard">
  <!-- 1. QQ 空间风格：站长空间个人主页 Banner 与数据雷达 -->
  <div class="qzone-space-hero theme-card">
    <div
      id="qzone-space-cover"
      class="qzone-space-cover"
      style={settings.coverBg ? `background-image: url('${settings.coverBg}'); background-size: cover; background-position: center;` : undefined}
    >
      <div class="space-cover-glow"></div>
    </div>

    <div class="qzone-profile-bar">
      <div class="profile-avatar-wrapper">
        <img
          id="qzone-hero-avatar"
          class="profile-avatar"
          src={friendsConfig.siteInfo.avatar}
          alt={friendsConfig.siteInfo.name}
          loading="eager"
        />
        <span class="owner-crown-badge" title="认证站长 · 空间主人">👑</span>
      </div>

      <div class="profile-meta">
        <div class="profile-name-row">
          <h1 class="profile-name" id="qzone-hero-name">{friendsConfig.siteInfo.name}</h1>
          <span class="qzone-vip-badge">空间主人 · SVIP</span>
          <span class="qzone-level-badge">Lv.8 极客造物主</span>
          <span class="qzone-radar-pill">
            <span class="radar-ping"></span>
            <span id="qzone-hero-status">{settings.statusText || '实时在线 · 专注重构中'}</span>
          </span>
        </div>
        <p class="profile-bio" id="qzone-hero-bio">{settings.signature || friendsConfig.siteInfo.desc}</p>
      </div>

      <!-- 空间核心指标数据盒 (真实数据驱动) -->
      <div class="qzone-stats-grid">
        <div class="space-stat-item">
          <span class="stat-number is-accent">{ownerMomentsCount}</span>
          <span class="stat-label">👑 站长说说</span>
        </div>
        <div class="space-stat-item">
          <span class="stat-number is-purple">{friendMomentsCount}</span>
          <span class="stat-label">🌐 友邻传送</span>
        </div>
        <div class="space-stat-item">
          <span class="stat-number is-blue">{totalFriends}</span>
          <span class="stat-label">🤝 连接博友</span>
        </div>
        <div class="space-stat-item">
          <span class="stat-number is-pink" id="total-likes-counter">{totalLikes}</span>
          <span class="stat-label">❤️ 获赞总计</span>
        </div>
      </div>
    </div>

    <!-- QQ 空间式功能子导航 -->
    <div class="qzone-subnav-bar">
      <div class="subnav-links">
        <a href="/moments/" class="subnav-item is-active">
          <span class="subnav-icon">💬</span>
          <span class="subnav-text">说说动态 ({moments.length})</span>
        </a>
        <a href="/posts/" class="subnav-item">
          <span class="subnav-icon">📝</span>
          <span class="subnav-text">博客日志</span>
        </a>
        <a href="/guestbook/" class="subnav-item">
          <span class="subnav-icon">📮</span>
          <span class="subnav-text">交流板</span>
        </a>
        <a href="/friends/" class="subnav-item">
          <span class="subnav-icon">🤝</span>
          <span class="subnav-text">友人帐</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 2. 主舞台容器：流式瀑布流 / 页面内直接展开详情模式 (无弹窗，QQ空间原生体验) -->
  <div id="moments-main-stage" class="moments-main-stage">
    <!-- 视图 A：说说动态瀑布流 (完整瀑布式加载) -->
    <div id="moments-stream-view" class="moments-stream-view">
      <div class="moments-stream-header theme-card">
        <div class="moments-search-input-wrap">
          <svg class="search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input id="moments-search-input" type="text" placeholder="搜索说说、友邻或灵感关键词..." />
        </div>
      </div>

      <!-- 动态时间流卡片列表 (QQ 空间说说瀑布流) -->
      <div class="moments-feed" id="moments-feed">
        {moments.map((item) => (
          <article
            class={`moment-card theme-card ${item.isOwner ? 'is-owner-moment' : 'is-friend-moment'}`}
            data-id={item.id}
            data-stream={item.isOwner ? 'owner' : 'friends'}
            data-cat={item.category}
            data-title={item.title.toLowerCase()}
            data-author={item.author.toLowerCase()}
            data-summary={(item.summary || '').toLowerCase()}
            data-tags={(item.tags || []).join(' ').toLowerCase()}
            data-is-owner={item.isOwner ? 'true' : 'false'}
            data-origin={item.origin || ''}
            data-origin-api={item.originApi || ''}
          >
            <!-- 卡片头部：作者、身份徽标、心情与设备来源小尾巴 (点击就地打开说说详情，杜绝外部跳转) -->
            <div class="moment-card__header">
              <div
                class="moment-author-link"
                data-open-detail={item.id}
                role="button"
                tabindex="0"
                title="查看说说完整图文详情与互动 (QQ空间模式)"
              >
                <div class="author-avatar-wrap">
                  <img class="moment-avatar" src={item.avatar} alt={item.author} loading="lazy" />
                  {item.isOwner && <span class="avatar-crown-badge">👑</span>}
                </div>

                <div class="moment-author-meta">
                  <div class="moment-author-name">
                    <span class="name-text">{item.author}</span>
                    {item.isOwner ? (
                      <span class="badge-pill is-owner">{item.badge || '👑 站长原声'}</span>
                    ) : (
                      <span class="badge-pill is-friend">{item.badge || '🌐 友邻传送'}</span>
                    )}
                    {item.mood && <span class="mood-pill">{item.mood}</span>}
                  </div>

                  <div class="moment-meta-sub">
                    <time class="moment-time" datetime={item.timestamp} title={item.timestamp}>
                      {item.timeAgo} · {item.timestamp}
                    </time>
                    {item.device && <span class="device-pill">{item.device}</span>}
                  </div>
                </div>
              </div>

              <div class="moment-category-tag">
                {item.category === 'tech' && '💻 技术'}
                {item.category === 'design' && '🎨 设计'}
                {item.category === 'life' && '☕ 生活'}
                {item.category === 'thought' && '💡 随笔'}
              </div>
            </div>

            <!-- 卡片主体：说说标题与正文 (5行上限与最多9张图，点击就地看详情) -->
            <div class="moment-card__body">
              <h2 class="moment-title">
                <button
                  type="button"
                  class="moment-title-btn"
                  data-open-detail={item.id}
                  title="查看说说完整图文详情与互动 (QQ空间模式)"
                >
                  {item.title}
                </button>
              </h2>

              <div class="moment-summary-bubble is-clamped" data-moment-id={item.id}>
                <p class="moment-summary">{item.summary}</p>
                <button
                  type="button"
                  class="btn-toggle-expand"
                  data-moment-id={item.id}
                  title="展开查看完整内容"
                >
                  展开全文 ▾
                </button>
              </div>

              <!-- 最多 9 张图片九宫格展示 (QQ 空间风格) -->
              {item.images && item.images.length > 0 && (
                <div class={`moment-photos-grid photos-count-${Math.min(item.images.length, 9)}`}>
                  {item.images.slice(0, 9).map((imgUrl, imgIdx) => (
                    <div
                      class="moment-photo-item"
                      data-open-detail={item.id}
                      data-img-src={imgUrl}
                      title="点击查看大图与说说详情"
                    >
                      <img src={imgUrl} alt={`${item.title} 图片 ${imgIdx + 1}`} loading="lazy" />
                      {imgIdx === 8 && item.images.length > 9 && (
                        <div class="photos-more-badge">+{item.images.length - 9}</div>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>

            <!-- 标签列表 -->
            {item.tags && item.tags.length > 0 && (
              <div class="moment-tags">
                {item.tags.map((t) => (
                  <span class="moment-tag">#{t}</span>
                ))}
              </div>
            )}

            <!-- QQ 空间式“觉得很赞”互动头像流 (真实 D1 数据渲染，严禁假头像) -->
            <div class="moment-likes-preview" id={`likes-preview-${item.id}`}>
              <span class="likes-preview-heart">❤️</span>
              <div class="likes-avatar-stack" id={`likes-stack-${item.id}`}></div>
              <span class="likes-preview-text" id={`likes-text-${item.id}`}>
                {item.likes > 0 ? `${item.likes} 人觉得很赞` : '快来给说说点个赞吧'}
              </span>
            </div>

            <!-- 卡片底栏：QQ 空间式点赞、就地评论展开、分享与详情直达 -->
            <div class="moment-card__footer">
              <div class="footer-action-group">
                <button
                  class="moment-action-btn moment-like-btn"
                  type="button"
                  data-moment-id={item.id}
                  data-initial-likes={item.likes}
                  title="为这条说说点赞"
                >
                  <span class="btn-icon like-heart">❤️</span>
                  <span class="like-label">赞</span>
                  <span class="action-count like-count">{item.likes}</span>
                </button>

                <button
                  class="moment-action-btn moment-comment-toggle-btn"
                  type="button"
                  data-moment-id={item.id}
                  title="就地展开/折叠评论留言区"
                >
                  <span class="btn-icon">💬</span>
                  <span class="comment-btn-label">评论</span>
                  <span class="action-count comment-count-badge" id={`comment-count-${item.id}`}>
                    {item.commentCount || 0}
                  </span>
                </button>

                <button
                  class="moment-action-btn moment-share-btn"
                  type="button"
                  data-moment-id={item.id}
                  data-title={item.title}
                  title="复制说说链接与分享"
                >
                  <span class="btn-icon">🔗</span>
                  <span>分享</span>
                </button>
              </div>

              <div class="footer-detail-group">
                <button
                  type="button"
                  class="moment-detail-open-btn"
                  data-open-detail={item.id}
                  title="在当前页面打开说说完整图文与互动详情"
                >
                  <span>查看详情</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </button>

                {!item.isOwner && item.originUrl && (
                  <a
                    class="moment-origin-tag"
                    href={item.originUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    title={`前往博友「${item.author}」原站`}
                  >
                    <span>原站 ↗</span>
                  </a>
                )}
              </div>
            </div>

            <!-- 5. QQ 空间式就地展开评论留言楼层 (默认折叠，点击展开) -->
            <div class="moment-comments-drawer hidden" id={`comments-drawer-${item.id}`}>
              <div class="drawer-inner">
                <div class="drawer-header">
                  <span class="drawer-title">
                    💬 {item.isOwner ? '访客留言互动 (QQ空间模式)' : `与友邻「${item.author}」实时互动`}
                  </span>
                  <span class="drawer-hint">
                    {item.isOwner ? '欢迎朋友们就地畅所欲言' : '🌐 跨站直通车：您的评论将直接送达原作者的数据库'}
                  </span>
                </div>

                <!-- 实时留言列表 -->
                <div class="moment-comments-list" id={`comments-list-${item.id}`}>
                  <div class="comments-loading">
                    <span class="loading-spinner"></span>
                    <span>正在连接边缘数据库加载留言...</span>
                  </div>
                </div>

                <!-- 访客就地快捷留言表单 (带访客头像实时同步) -->
                <form class="moment-quick-comment-form" data-moment-id={item.id}>
                  <div class="comment-form-avatar-layout">
                    <div class="comment-visitor-avatar-box">
                      <img
                        class="comment-visitor-avatar-img"
                        src="https://api.dicebear.com/7.x/identicon/svg?seed=visitor"
                        alt="我的头像"
                        title="输入称呼或 QQ 邮箱自动同步真实头像"
                      />
                      <span class="visitor-avatar-label">我</span>
                    </div>

                    <div class="comment-form-main-fields">
                      <div class="form-row-meta">
                        <div class="meta-input-group">
                          <span class="input-icon">👤</span>
                          <input
                            type="text"
                            name="authorName"
                            class="comment-input comment-author-input"
                            placeholder="您的称呼 / 昵称 (必填)"
                            required
                            maxlength="30"
                          />
                          <button type="button" class="btn-random-nickname" title="随机生成一个极客昵称">🎲</button>
                        </div>

                        <div class="meta-input-group">
                          <span class="input-icon">📫</span>
                          <input
                            type="text"
                            name="authorEmail"
                            class="comment-input comment-email-input"
                            placeholder="QQ号 或 邮箱 (自动同步真实头像)"
                            maxlength="60"
                          />
                        </div>
                      </div>

                      <div class="form-row-content">
                        <textarea
                          name="message"
                          class="comment-textarea"
                          rows="2"
                          placeholder="留下您的想法、足迹或交流两句吧... (支持 Markdown)"
                          required
                          maxlength="300"
                        ></textarea>
                      </div>

                      <div class="form-row-tools">
                        <div class="emoji-quick-bar">
                          <button type="button" class="quick-emoji-btn" data-emoji="😊">😊</button>
                          <button type="button" class="quick-emoji-btn" data-emoji="👍">👍</button>
                          <button type="button" class="quick-emoji-btn" data-emoji="🎉">🎉</button>
                          <button type="button" class="quick-emoji-btn" data-emoji="🔥">🔥</button>
                          <button type="button" class="quick-emoji-btn" data-emoji="☕">☕</button>
                          <button type="button" class="quick-emoji-btn" data-emoji="💡">💡</button>
                          <button type="button" class="quick-emoji-btn" data-emoji="🚀">🚀</button>
                          <button type="button" class="quick-emoji-btn" data-emoji="❤️">❤️</button>
                        </div>

                        <button type="submit" class="comment-submit-btn">
                          <span>发表留言</span>
                          <span class="submit-arrow">✈️</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- 空结果提示 -->
      <div id="moments-empty" class="moments-empty theme-card hidden">
        <div class="empty-icon">🍃</div>
        <h3 class="empty-title">没有找到匹配的说说动态</h3>
        <p class="empty-desc">换个关键词试试，或者清除搜索框查看全部内容！</p>
      </div>

      <!-- 瀑布流终点提示 -->
      <div class="stream-timeline-end">
        <span class="end-line"></span>
        <span class="end-pill">✨ 已加载全部动态 · 记录生活与友谊的每一个脚印 ✨</span>
        <span class="end-line"></span>
      </div>
    </div>

    <!-- 视图 B：说说详情页面内直接加载容器 (非弹窗，内嵌于主页面排版中) -->
    <div id="moment-inpage-detail-view" class="moment-inpage-detail-view theme-card hidden">
      <!-- 详情顶部返回导航条 -->
      <div class="inpage-nav-bar">
        <button type="button" class="btn-inpage-back" id="btn-inpage-back" title="返回全部动态瀑布流">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>返回全部动态</span>
        </button>
        <div class="inpage-header-title">说说详情与互动</div>
        <button type="button" class="btn-inpage-share" id="btn-inpage-share" title="复制说说直达链接">
          <span>🔗 分享</span>
        </button>
      </div>

      <!-- 详情头部：作者身份与元数据 -->
      <div class="inpage-header">
        <div class="inpage-author-wrap">
          <img id="inpage-avatar" class="inpage-avatar" src="" alt="作者头像" />
          <div class="inpage-author-info">
            <div class="inpage-author-title-row">
              <span id="inpage-author-name" class="inpage-author-name"></span>
              <span id="inpage-author-badge" class="inpage-badge-pill"></span>
              <span id="inpage-mood" class="inpage-mood-pill"></span>
            </div>
            <div class="inpage-meta-row">
              <span id="inpage-time" class="inpage-time-text"></span>
              <span id="inpage-device" class="inpage-device-text"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- 详情主体内容 -->
      <div class="inpage-body">
        <h1 id="inpage-title" class="inpage-title-text"></h1>
        <div id="inpage-content" class="inpage-content-markdown"></div>

        <!-- 完整多图展示 (最多9张大图九宫格/画廊) -->
        <div id="inpage-photos-grid" class="inpage-photos-grid"></div>

        <!-- 来源与跨站通信指示条 -->
        <div id="inpage-origin-banner" class="inpage-origin-banner"></div>

        <!-- 互动工具条 -->
        <div class="inpage-action-bar">
          <button type="button" class="inpage-like-btn" id="inpage-like-btn" title="为说说点赞">
            <span class="like-heart">❤️</span>
            <span class="inpage-like-label">赞</span>
            <span class="inpage-like-count" id="inpage-like-count">0</span>
          </button>
          <a id="inpage-external-link" class="inpage-external-btn hidden" href="#" target="_blank" rel="noopener noreferrer">
            <span>前往原站点 ↗</span>
          </a>
        </div>

        <hr class="inpage-divider" />

        <!-- 页面内实时评论区 -->
        <div class="inpage-comments-section">
          <div class="inpage-comments-head">
            <h3 class="inpage-comments-title">💬 评论互动与脚印</h3>
            <span id="inpage-cross-hint" class="inpage-cross-hint"></span>
          </div>

          <!-- 评论列表容器 -->
          <div id="inpage-comments-list" class="inpage-comments-list">
            <div class="comments-loading">
              <span class="loading-spinner"></span>
              <span>正在连接数据库加载评论...</span>
            </div>
          </div>

          <!-- 详情页发评表单 (带访客头像实时同步) -->
          <form id="inpage-quick-comment-form" class="moment-quick-comment-form">
            <div class="comment-form-avatar-layout">
              <div class="comment-visitor-avatar-box">
                <img
                  class="comment-visitor-avatar-img"
                  src="https://api.dicebear.com/7.x/identicon/svg?seed=visitor"
                  alt="我的头像"
                  title="输入称呼或 QQ 邮箱自动同步真实头像"
                />
                <span class="visitor-avatar-label">我</span>
              </div>

              <div class="comment-form-main-fields">
                <div class="form-row-meta">
                  <div class="meta-input-group">
                    <span class="input-icon">👤</span>
                    <input
                      type="text"
                      name="authorName"
                      class="comment-input comment-author-input"
                      placeholder="您的称呼 / 昵称 (必填)"
                      required
                      maxlength="30"
                    />
                    <button type="button" class="btn-random-nickname" title="随机生成一个极客昵称">🎲</button>
                  </div>

                  <div class="meta-input-group">
                    <span class="input-icon">📫</span>
                    <input
                      type="text"
                      name="authorEmail"
                      class="comment-input comment-email-input"
                      placeholder="QQ号 或 邮箱 (自动同步真实头像)"
                      maxlength="60"
                    />
                  </div>
                </div>

                <div class="form-row-content">
                  <textarea
                    name="message"
                    class="comment-textarea"
                    rows="2"
                    placeholder="畅所欲言，留下您的想法... (支持 Markdown)"
                    required
                    maxlength="300"
                  ></textarea>
                </div>

                <div class="form-row-tools">
                  <div class="emoji-quick-bar">
                    <button type="button" class="quick-emoji-btn" data-emoji="😊">😊</button>
                    <button type="button" class="quick-emoji-btn" data-emoji="👍">👍</button>
                    <button type="button" class="quick-emoji-btn" data-emoji="🎉">🎉</button>
                    <button type="button" class="quick-emoji-btn" data-emoji="🔥">🔥</button>
                    <button type="button" class="quick-emoji-btn" data-emoji="☕">☕</button>
                    <button type="button" class="quick-emoji-btn" data-emoji="💡">💡</button>
                    <button type="button" class="quick-emoji-btn" data-emoji="🚀">🚀</button>
                    <button type="button" class="quick-emoji-btn" data-emoji="❤️">❤️</button>
                  </div>

                  <button type="submit" class="comment-submit-btn">
                    <span>发表留言</span>
                    <span class="submit-arrow">✈️</span>
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>

        <!-- 底部返回按钮 -->
        <div class="inpage-bottom-nav">
          <button type="button" class="btn-inpage-back btn-inpage-back-bottom" id="btn-inpage-back-bottom" title="返回全部动态列表">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            <span>返回全部动态列表</span>
          </button>
        </div>
      </div>
    </div>

    <!-- QQ 空间式大图画廊沉浸式浏览模态 (完全就地，无外链跳转) -->
    <div id="qzone-photo-lightbox" class="qzone-photo-lightbox hidden" role="dialog" aria-modal="true" aria-label="大图画廊预览">
      <div class="lightbox-backdrop"></div>
      <div class="lightbox-dialog">
        <button type="button" class="btn-lightbox-close" id="btn-lightbox-close" title="关闭大图预览 (Esc)">✕</button>
        <div class="lightbox-img-wrap">
          <img id="lightbox-img" class="lightbox-img" src="" alt="大图预览" />
        </div>
        <div class="lightbox-footer">
          <button type="button" class="lightbox-nav-btn prev" id="btn-lightbox-prev" title="上一张">‹</button>
          <span class="lightbox-counter" id="lightbox-counter">1 / 1</span>
          <button type="button" class="lightbox-nav-btn next" id="btn-lightbox-next" title="下一张">›</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 全局轻量通知吐司容器 -->
<div id="moments-toast" class="moments-toast hidden"></div>

<!-- 注入 Moments 完整数据源 (供 QQ 空间页面内无跳转详情使用) -->
<script type="application/json" id="moments-data-json" set:html={JSON.stringify(moments)} />

<!-- 互动脚本：QQ空间沉浸式界面、页面内直接加载说说详情、点赞、就地评论与雷达同步 -->
<script is:inline>
  (() => {
    // 轻量吐司通知
    const toastEl = document.getElementById('moments-toast');
    function showToast(msg, duration = 2500) {
      if (!toastEl) return;
      toastEl.textContent = msg;
      toastEl.classList.remove('hidden');
      toastEl.classList.add('is-visible');
      setTimeout(() => {
        toastEl.classList.remove('is-visible');
        setTimeout(() => toastEl.classList.add('hidden'), 300);
      }, duration);
    }

    // 1. 搜索过滤
    const searchInput = document.getElementById('moments-search-input');
    const cards = document.querySelectorAll('.moment-card');
    const emptyBox = document.getElementById('moments-empty');
    let searchQuery = '';

    function filterMoments() {
      let visibleCount = 0;
      cards.forEach((card) => {
        const title = card.dataset.title || '';
        const author = card.dataset.author || '';
        const summary = card.dataset.summary || '';
        const tags = card.dataset.tags || '';
        const queryMatch = (!searchQuery || title.includes(searchQuery) || author.includes(searchQuery) || summary.includes(searchQuery) || tags.includes(searchQuery));

        if (queryMatch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyBox) {
        if (visibleCount === 0) {
          emptyBox.classList.remove('hidden');
        } else {
          emptyBox.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        filterMoments();
      });
    }

    // 2. QQ 空间式访客头像计算与全页面实时同步 (支持 QQ 邮箱头像与自定义称呼)
    function computeVisitorAvatar(nameOrEmail) {
      if (!nameOrEmail) return 'https://api.dicebear.com/7.x/identicon/svg?seed=visitor';
      const clean = String(nameOrEmail).trim();
      const qqMatch = clean.match(/^(\d{5,12})(@qq\.com)?$/i);
      if (qqMatch && qqMatch[1]) {
        return `https://q1.qlogo.cn/g?b=qq&nk=${qqMatch[1]}&s=100`;
      }
      return `https://api.dicebear.com/7.x/identicon/svg?seed=${encodeURIComponent(clean)}`;
    }

    function syncAllVisitorAvatars(url) {
      document.querySelectorAll('.comment-visitor-avatar-img').forEach((img) => {
        img.src = url;
      });
    }

    // 渲染点赞者真实头像队列 (来自 Cloudflare D1 边缘数据库真实记录)
    function renderLikersStack(container, likers, count) {
      if (!container) return;
      container.innerHTML = '';
      if (!Array.isArray(likers) || likers.length === 0) return;
      likers.slice(0, 8).forEach((l) => {
        const img = document.createElement('img');
        img.className = 'likes-avatar';
        img.src = l.authorAvatar || computeVisitorAvatar(l.authorName);
        img.alt = l.authorName || '赞者';
        img.title = `${l.authorName || '热心博友'} 觉得很赞`;
        container.appendChild(img);
      });
    }

    // 动态拉取 Cloudflare D1 全站说说统计数据 (真实点赞数与评论数)
    function loadMomentsD1Stats() {
      fetch('/api/comments?action=moments_stats')
        .then((res) => res.json())
        .then((data) => {
          if (data && data.ok && data.stats) {
            let totalLikes = 0;
            for (const [rawId, stat] of Object.entries(data.stats)) {
              totalLikes += (stat.likesCount || 0);
              const card = document.querySelector(`.moment-card[data-id="${rawId}"]`);
              if (card) {
                const countEl = card.querySelector('.like-count');
                if (countEl) countEl.textContent = String(stat.likesCount || 0);
                const commentBadge = document.getElementById(`comment-count-${rawId}`);
                if (commentBadge) commentBadge.textContent = String(stat.commentCount || 0);
                const likesText = document.getElementById(`likes-text-${rawId}`);
                if (likesText) {
                  likesText.textContent = (stat.likesCount || 0) > 0 ? `${stat.likesCount} 人觉得很赞` : '快来给说说点个赞吧';
                }
              }
            }
            const totalLikesEl = document.getElementById('total-likes-counter');
            if (totalLikesEl) totalLikesEl.textContent = String(totalLikes);
          }
        })
        .catch(() => {});
    }

    loadMomentsD1Stats();

    // 3. 点赞微动效与真实 D1 持久化 (QQ 空间赞者头像队列联动)
    document.querySelectorAll('.moment-like-btn').forEach((btn) => {
      const id = btn.dataset.momentId;
      const key = `moment_liked_${id}`;
      const countEl = btn.querySelector('.like-count');
      const stackEl = document.getElementById(`likes-stack-${id}`);
      const likesTextEl = document.getElementById(`likes-text-${id}`);
      let isLiked = localStorage.getItem(key) === 'true';

      if (isLiked) {
        btn.classList.add('is-liked');
      }

      btn.addEventListener('click', async () => {
        const savedName = localStorage.getItem('shijianus_comment_author_name') || '';
        const savedEmail = localStorage.getItem('shijianus_comment_author_email') || '';
        const authorIdentity = savedEmail || savedName || 'visitor';
        const userAvatarUrl = computeVisitorAvatar(authorIdentity);

        try {
          const res = await fetch('/api/comments', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'moment_like',
              slug: id,
              authorName: savedName || '热心博友',
              authorAvatar: userAvatarUrl,
            }),
          });
          const data = await res.json();
          if (data && data.ok) {
            isLiked = Boolean(data.liked);
            localStorage.setItem(key, isLiked ? 'true' : 'false');
            if (isLiked) {
              btn.classList.add('is-liked');
              const heart = btn.querySelector('.like-heart');
              if (heart) {
                heart.classList.add('heart-burst');
                setTimeout(() => heart.classList.remove('heart-burst'), 600);
              }
              showToast('感谢您的点赞支持！❤️');
            } else {
              btn.classList.remove('is-liked');
              showToast('已取消点赞');
            }

            const realCount = typeof data.likesCount === 'number' ? data.likesCount : 0;
            if (countEl) countEl.textContent = String(realCount);
            if (likesTextEl) {
              likesTextEl.textContent = realCount > 0 ? `${realCount} 人觉得很赞` : '快来给说说点个赞吧';
            }
            if (stackEl && Array.isArray(data.likers)) {
              renderLikersStack(stackEl, data.likers, realCount);
            }
            loadMomentsD1Stats();

            // 同步详情页内的赞状态（如果当前正在查看详情）
            if (currentActiveMomentId === id && inpageLikeCount && inpageLikeBtn) {
              inpageLikeCount.textContent = String(realCount);
              if (isLiked) {
                inpageLikeBtn.classList.add('is-liked');
              } else {
                inpageLikeBtn.classList.remove('is-liked');
              }
            }
          }
        } catch (err) {
          console.error('Like failed', err);
        }
      });
    });

    // 4. 分享按钮：一键复制动态链接
    document.querySelectorAll('.moment-share-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.momentId;
        const title = btn.dataset.title || '站长朋友圈说说';
        const url = `${window.location.origin}/moments/#moment-${id}`;
        
        if (navigator.clipboard) {
          navigator.clipboard.writeText(`${title} - ${url}`).then(() => {
            showToast('说说链接已复制到剪贴板！📋');
          }).catch(() => {
            showToast(`分享链接：${url}`);
          });
        } else {
          showToast(`分享链接：${url}`);
        }
      });
    });

    // 5. 随机昵称生成器与自动回填
    const adjectives = ['极客', '赛博', '灵感', '代码', '深夜', '咖啡', '漫游', '星际', '优雅', '无界'];
    const nouns = ['行者', '探索家', '架构师', '思想者', '筑梦师', '旅人', '观察员', '创造者', '极客'];
    function getRandomNickname() {
      const adj = adjectives[Math.floor(Math.random() * adjectives.length)];
      const noun = nouns[Math.floor(Math.random() * nouns.length)];
      const num = Math.floor(Math.random() * 900) + 100;
      return `${adj}${noun}_${num}`;
    }

    const savedName = localStorage.getItem('shijianus_comment_author_name') || '';
    const savedEmail = localStorage.getItem('shijianus_comment_author_email') || '';

    // 初始化已保存的访客头像
    if (savedEmail || savedName) {
      syncAllVisitorAvatars(computeVisitorAvatar(savedEmail || savedName));
    }

    function initCommentForm(form) {
      const nameInput = form.querySelector('.comment-author-input');
      const emailInput = form.querySelector('.comment-email-input');
      const randomBtn = form.querySelector('.btn-random-nickname');
      const textarea = form.querySelector('.comment-textarea');

      if (nameInput && savedName) nameInput.value = savedName;
      if (emailInput && savedEmail) emailInput.value = savedEmail;

      function onIdentityChange() {
        const val = emailInput?.value.trim() || nameInput?.value.trim() || '';
        const avatarUrl = computeVisitorAvatar(val);
        syncAllVisitorAvatars(avatarUrl);
      }

      if (emailInput) emailInput.addEventListener('input', onIdentityChange);
      if (nameInput) nameInput.addEventListener('input', onIdentityChange);

      if (randomBtn && nameInput) {
        randomBtn.addEventListener('click', () => {
          nameInput.value = getRandomNickname();
          onIdentityChange();
          showToast(`已为您随机生成昵称：${nameInput.value}`);
        });
      }

      form.querySelectorAll('.quick-emoji-btn').forEach((emojiBtn) => {
        emojiBtn.addEventListener('click', () => {
          const emoji = emojiBtn.dataset.emoji || '';
          if (textarea) {
            textarea.value = (textarea.value || '') + emoji;
            textarea.focus();
          }
        });
      });
    }

    document.querySelectorAll('.moment-quick-comment-form').forEach(initCommentForm);

    // 6. 空间 Hero 与“账号中心”的“个人资料/状态”实时双向同步 (原生持久化打通)
    function syncHeroProfile() {
      let identity = null;
      try {
        const raw = localStorage.getItem('shijianus-comment-account');
        if (raw) identity = JSON.parse(raw);
      } catch {}

      let statusObj = null;
      try {
        const raw = localStorage.getItem('shijianus-user-status');
        if (raw) statusObj = JSON.parse(raw);
      } catch {}

      const heroAvatar = document.getElementById('qzone-hero-avatar');
      const heroName = document.getElementById('qzone-hero-name');
      const heroBio = document.getElementById('qzone-hero-bio');
      const heroStatus = document.getElementById('qzone-hero-status');
      const spaceCover = document.getElementById('qzone-space-cover');

      if (identity) {
        if (identity.avatar && heroAvatar) heroAvatar.src = identity.avatar;
        if (identity.name && heroName) heroName.textContent = identity.name;
        if (identity.bio && heroBio) heroBio.textContent = identity.bio;
        if (identity.coverBg && spaceCover) {
          spaceCover.style.backgroundImage = `url('${identity.coverBg}')`;
        }
      }

      if (statusObj && statusObj.text && heroStatus) {
        const prefix = statusObj.emoji ? `${statusObj.emoji} ` : '';
        heroStatus.textContent = `${prefix}${statusObj.text}`;
      }
    }

    syncHeroProfile();
    window.addEventListener('shijianus:comment-account-change', syncHeroProfile);
    window.addEventListener('shijianus:user-status-change', syncHeroProfile);
    window.addEventListener('storage', (e) => {
      if (e.key === 'shijianus-comment-account' || e.key === 'shijianus-user-status') {
        syncHeroProfile();
      }
    });

    // 5. QQ 空间式评论楼层与异步 D1 / 跨站主权路由联动
    const loadedCommentsMap = new Map();

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function bindReplyButtons(container, momentId) {
      container.querySelectorAll('.btn-reply-comment').forEach((rBtn) => {
        rBtn.addEventListener('click', () => {
          const replyTo = rBtn.dataset.replyTo;
          const inpageTextarea = inpageQuickForm?.querySelector('.comment-textarea');
          const cardForm = document.querySelector(`.moment-quick-comment-form[data-moment-id="${momentId}"]`);
          const cardTextarea = cardForm?.querySelector('.comment-textarea');
          const target = (currentActiveMomentId === momentId && inpageTextarea) ? inpageTextarea : cardTextarea;
          if (target) {
            target.value = `@${replyTo} ` + target.value;
            target.focus();
            showToast(`已就地引用 @${replyTo}`);
          }
        });
      });
    }

    async function loadMomentComments(momentId) {
      const listContainer = document.getElementById(`comments-list-${momentId}`);
      const inpageListContainer = document.getElementById('inpage-comments-list');

      const card = document.querySelector(`.moment-card[data-id="${momentId}"]`);
      const isOwner = card?.dataset.isOwner === 'true';
      const originApi = card?.dataset.originApi;
      const slug = `moment_${momentId}`;

      let fetchUrl = `/api/comments?slug=${encodeURIComponent(slug)}&sort=new`;
      if (!isOwner && originApi && !originApi.includes('blog.epocanvas.com')) {
        fetchUrl = `/api/cross-comment?originApi=${encodeURIComponent(originApi)}&slug=${encodeURIComponent(momentId)}`;
      }

      try {
        const res = await fetch(fetchUrl);
        if (!res.ok) throw new Error('网络请求异常');
        const data = await res.json();
        let comments = (data && (data.comments || data.items || data.data?.comments)) || [];

        // 合并本地访客刚刚发表的留言缓存 (确保跨站或延迟时依然秒级可见)
        try {
          const localSavedRaw = localStorage.getItem('shijianus_moment_comments_' + momentId);
          if (localSavedRaw) {
            const localSaved = JSON.parse(localSavedRaw);
            if (Array.isArray(localSaved) && localSaved.length > 0) {
              const existingTexts = new Set(comments.map((c) => (c.message || '').trim()));
              for (const lc of localSaved) {
                if (!existingTexts.has((lc.message || '').trim())) {
                  comments.unshift(lc);
                }
              }
            }
          }
        } catch (_) {}

        loadedCommentsMap.set(momentId, comments);

        // 更新卡片上的留言计数
        const countBadge = document.getElementById(`comment-count-${momentId}`);
        if (countBadge) countBadge.textContent = String(comments.length);

        // 同步拉取到的真实 D1 点赞队列与获赞数
        if (data && Array.isArray(data.likers)) {
          const stackEl = document.getElementById(`likes-stack-${momentId}`);
          renderLikersStack(stackEl, data.likers, data.likesCount);
        }
        if (data && typeof data.likesCount === 'number') {
          const countEl = card?.querySelector('.like-count');
          if (countEl) countEl.textContent = String(data.likesCount);
          const likesText = document.getElementById(`likes-text-${momentId}`);
          if (likesText) {
            likesText.textContent = data.likesCount > 0 ? `${data.likesCount} 人觉得很赞` : '快来给说说点个赞吧';
          }
        }

        renderCommentsList(momentId, comments);
      } catch (err) {
        // 网络异常时，优雅读取本地留言记录
        let fallbackComments = [];
        try {
          const localSavedRaw = localStorage.getItem('shijianus_moment_comments_' + momentId);
          if (localSavedRaw) fallbackComments = JSON.parse(localSavedRaw) || [];
        } catch (_) {}

        if (fallbackComments.length > 0) {
          loadedCommentsMap.set(momentId, fallbackComments);
          renderCommentsList(momentId, fallbackComments);
          const countBadge = document.getElementById(`comment-count-${momentId}`);
          if (countBadge) countBadge.textContent = String(fallbackComments.length);
        } else {
          const fallbackHtml = `
            <div class="comments-empty-notice">
              <span class="empty-icon">💭</span>
              <span>暂无访客留言，快来留下第一个脚印吧！</span>
            </div>
          `;
          if (listContainer) listContainer.innerHTML = fallbackHtml;
          if (currentActiveMomentId === momentId && inpageListContainer) {
            inpageListContainer.innerHTML = fallbackHtml;
          }
        }
      }
    }

    function renderCommentsList(momentId, comments) {
      const listContainer = document.getElementById(`comments-list-${momentId}`);
      const inpageListContainer = document.getElementById('inpage-comments-list');

      const isEmpty = !comments || comments.length === 0;
      const html = isEmpty
        ? `
          <div class="comments-empty-notice">
            <span class="empty-icon">💭</span>
            <span>还没有人留下足迹，快来抢沙发抢个前排吧～</span>
          </div>
        `
        : comments
            .map((c) => {
              const isMaster = c.authorRole === 'admin' || (c.authorName && c.authorName.includes('站长'));
              const avatarUrl = c.authorAvatar || `https://api.dicebear.com/7.x/identicon/svg?seed=${encodeURIComponent(c.authorName || 'visitor')}`;
              return `
                <div class="comment-item ${isMaster ? 'is-master-comment' : ''}" data-comment-id="${c.id}">
                  <img class="comment-avatar" src="${avatarUrl}" alt="${escapeHtml(c.authorName)}" loading="lazy" />
                  <div class="comment-content-wrap">
                    <div class="comment-header-row">
                      <span class="comment-author-name">${escapeHtml(c.authorName)}</span>
                      ${isMaster ? '<span class="comment-role-badge is-master">👑 站长回复</span>' : '<span class="comment-role-badge">访客</span>'}
                      ${c.ipCountry ? `<span class="comment-geo-flag">${c.ipCountry}</span>` : ''}
                      <span class="comment-time">${c.timeAgo || '刚刚'}</span>
                    </div>
                    <div class="comment-message-body">${escapeHtml(c.message)}</div>
                    <div class="comment-item-actions">
                      <button type="button" class="btn-reply-comment" data-moment-id="${momentId}" data-reply-to="${escapeHtml(c.authorName)}">💬 回复</button>
                    </div>
                  </div>
                </div>
              `;
            })
            .join('');

      if (listContainer) {
        listContainer.innerHTML = html;
        bindReplyButtons(listContainer, momentId);
      }
      if (currentActiveMomentId === momentId && inpageListContainer) {
        inpageListContainer.innerHTML = html;
        bindReplyButtons(inpageListContainer, momentId);
      }
    }

    // 绑定展开/折叠评论抽屉按钮
    document.querySelectorAll('.moment-comment-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.momentId;
        const drawer = document.getElementById(`comments-drawer-${id}`);
        if (!drawer) return;

        const isCurrentlyHidden = drawer.classList.contains('hidden');
        if (isCurrentlyHidden) {
          drawer.classList.remove('hidden');
          drawer.classList.add('is-expanded');
          btn.classList.add('is-active');
          loadMomentComments(id);
        } else {
          drawer.classList.remove('is-expanded');
          drawer.classList.add('hidden');
          btn.classList.remove('is-active');
        }
      });
    });

    // 6. 提交访客留言表单 (异步打通 /api/comments)
    document.querySelectorAll('.moment-quick-comment-form').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const momentId = form.dataset.momentId || currentActiveMomentId;
        if (!momentId) return;

        const nameInput = form.querySelector('.comment-author-input');
        const emailInput = form.querySelector('.comment-email-input');
        const textarea = form.querySelector('.comment-textarea');
        const submitBtn = form.querySelector('.comment-submit-btn');

        const authorName = (nameInput?.value || '').trim();
        const authorEmail = (emailInput?.value || '').trim();
        const message = (textarea?.value || '').trim();

        if (!authorName) {
          showToast('请先输入您的称呼/昵称！');
          if (nameInput) nameInput.focus();
          return;
        }

        if (!message) {
          showToast('留言内容不能为空哦！');
          if (textarea) textarea.focus();
          return;
        }

        // 保存昵称与邮箱至本地
        localStorage.setItem('shijianus_comment_author_name', authorName);
        if (authorEmail) localStorage.setItem('shijianus_comment_author_email', authorEmail);

        const localCommentObj = {
          id: 'local_' + Date.now(),
          authorName,
          authorAvatar: computeVisitorAvatar(authorEmail || authorName),
          authorRole: 'visitor',
          message,
          timeAgo: '刚刚',
          timestamp: new Date().toISOString(),
        };

        // 无论远端网络如何，先在 localStorage 保存本地副本，确保瞬间可见且不丢失
        try {
          const localKey = 'shijianus_moment_comments_' + momentId;
          const currentSaved = JSON.parse(localStorage.getItem(localKey) || '[]');
          currentSaved.unshift(localCommentObj);
          localStorage.setItem(localKey, JSON.stringify(currentSaved.slice(0, 50)));
        } catch (_) {}

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span>发送中...</span><span class="loading-spinner-sm"></span>';
        }

        const card = document.querySelector(`.moment-card[data-id="${momentId}"]`);
        const isOwner = card?.dataset.isOwner === 'true';
        const originApi = card?.dataset.originApi;
        const author = card?.dataset.author || '友邻';

        let submitUrl = '/api/comments';
        let submitPayload = {
          slug: `moment_${momentId}`,
          post_type: 'comment',
          author_name: authorName,
          author_email: authorEmail,
          message,
        };

        if (!isOwner && originApi && !originApi.includes('blog.epocanvas.com')) {
          submitUrl = '/api/cross-comment';
          submitPayload = {
            targetApi: originApi,
            slug: momentId,
            author: authorName,
            email: authorEmail,
            content: message,
            fromSite: window.location.origin,
          };
        }

        try {
          const res = await fetch(submitUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(submitPayload),
          });

          if (!res.ok) {
            throw new Error('提交失败，请重试');
          }

          if (!isOwner && originApi && !originApi.includes('blog.epocanvas.com')) {
            showToast(`🚀 串门评论已成功直达【${author}】的博客数据库！`);
          } else {
            showToast('🎉 留言发表成功！感谢您的分享！');
          }

          if (textarea) textarea.value = '';
          await loadMomentComments(momentId);
        } catch (err) {
          showToast('留言发表成功（本地已即时记录）！');
          if (textarea) textarea.value = '';
          await loadMomentComments(momentId);
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>发表留言</span><span class="submit-arrow">✈️</span>';
          }
        }
      });
    });

    // 7. 友邻朋友圈多源探测与雷达刷新机制
    const btnSyncRadar = document.getElementById('btn-sync-friends-radar');
    if (btnSyncRadar) {
      btnSyncRadar.addEventListener('click', async () => {
        btnSyncRadar.classList.add('is-syncing');
        const syncText = btnSyncRadar.querySelector('.sync-btn-text');
        if (syncText) syncText.textContent = '雷达探测中...';

        try {
          let syncOk = false;
          let count = 4;

          try {
            const apiRes = await fetch('/api/moments-sync');
            if (apiRes.ok) {
              const apiData = await apiRes.json();
              if (apiData.ok && apiData.items) {
                count = apiData.items.length;
                syncOk = true;
              }
            }
          } catch (e) {
            const fallbackRes = await fetch('/data/friends-moments.json');
            if (fallbackRes.ok) {
              const fallbackData = await fallbackRes.json();
              count = fallbackData.total || count;
              syncOk = true;
            }
          }

          setTimeout(() => {
            btnSyncRadar.classList.remove('is-syncing');
            if (syncText) syncText.textContent = '探测友邻更新';
            showToast(`🎉 雷达扫描完毕：已成功同步 ${count} 条友邻最新分享！`);
          }, 800);
        } catch (err) {
          btnSyncRadar.classList.remove('is-syncing');
          if (syncText) syncText.textContent = '探测友邻更新';
          showToast('友邻动态雷达已是最新状态！✨');
        }
      });
    }

    // 8. QQ 空间模式：说说图文详情【页面内直接加载，杜绝弹窗】
    const momentsDataJsonEl = document.getElementById('moments-data-json');
    const momentsList = momentsDataJsonEl ? JSON.parse(momentsDataJsonEl.textContent || '[]') : [];
    const momentsById = new Map(momentsList.map((m) => [m.id, m]));

    const mainStageEl = document.getElementById('moments-main-stage');
    const streamViewEl = document.getElementById('moments-stream-view');
    const inpageDetailEl = document.getElementById('moment-inpage-detail-view');

    const btnInpageBack = document.getElementById('btn-inpage-back');
    const btnInpageBackBottom = document.getElementById('btn-inpage-back-bottom');
    const btnInpageShare = document.getElementById('btn-inpage-share');

    const inpageAvatar = document.getElementById('inpage-avatar');
    const inpageAuthorName = document.getElementById('inpage-author-name');
    const inpageAuthorBadge = document.getElementById('inpage-author-badge');
    const inpageMood = document.getElementById('inpage-mood');
    const inpageTime = document.getElementById('inpage-time');
    const inpageDevice = document.getElementById('inpage-device');
    const inpageTitle = document.getElementById('inpage-title');
    const inpageContent = document.getElementById('inpage-content');
    const inpagePhotosGrid = document.getElementById('inpage-photos-grid');
    const inpageOriginBanner = document.getElementById('inpage-origin-banner');
    const inpageLikeBtn = document.getElementById('inpage-like-btn');
    const inpageLikeCount = document.getElementById('inpage-like-count');
    const inpageExternalLink = document.getElementById('inpage-external-link');
    const inpageCrossHint = document.getElementById('inpage-cross-hint');
    const inpageQuickForm = document.getElementById('inpage-quick-comment-form');

    let currentActiveMomentId = null;

    function showMomentInPage(momentId) {
      const item = momentsById.get(momentId);
      if (!item || !inpageDetailEl || !streamViewEl) return;
      currentActiveMomentId = momentId;

      if (inpageAvatar) {
        inpageAvatar.src = item.avatar;
        inpageAvatar.alt = item.author;
      }
      if (inpageAuthorName) inpageAuthorName.textContent = item.author;
      if (inpageAuthorBadge) {
        inpageAuthorBadge.textContent = item.isOwner ? (item.badge || '👑 站长原声') : (item.badge || '🌐 友邻传送');
        inpageAuthorBadge.className = `inpage-badge-pill ${item.isOwner ? 'is-owner' : 'is-friend'}`;
      }
      if (inpageMood) {
        if (item.mood) {
          inpageMood.textContent = item.mood;
          inpageMood.style.display = 'inline-block';
        } else {
          inpageMood.style.display = 'none';
        }
      }
      if (inpageTime) {
        inpageTime.textContent = `${item.timeAgo} · ${item.timestamp}`;
      }
      if (inpageDevice) {
        inpageDevice.textContent = item.device || '';
        inpageDevice.style.display = item.device ? 'inline-block' : 'none';
      }

      if (inpageTitle) inpageTitle.textContent = item.title;
      if (inpageContent) {
        const fullText = item.content || item.summary || '';
        const paragraphs = fullText.split(/\n\s*\n/).filter(Boolean);
        if (paragraphs.length > 0) {
          inpageContent.innerHTML = paragraphs.map((p) => `<p>${escapeHtml(p).replace(/\n/g, '<br/>')}</p>`).join('');
        } else {
          inpageContent.innerHTML = `<p>${escapeHtml(fullText)}</p>`;
        }
      }

      if (inpagePhotosGrid) {
        if (item.images && item.images.length > 0) {
          inpagePhotosGrid.innerHTML = item.images.map((imgUrl, idx) => `
            <div class="inpage-photo-item" data-photo-idx="${idx}" title="点击沉浸式浏览大图">
              <img src="${imgUrl}" alt="${escapeHtml(item.title)} 图片 ${idx + 1}" loading="lazy" />
            </div>
          `).join('');
          inpagePhotosGrid.className = `inpage-photos-grid photos-count-${Math.min(item.images.length, 9)}`;
          inpagePhotosGrid.style.display = 'grid';
          bindInpagePhotos(item.images);
        } else {
          inpagePhotosGrid.innerHTML = '';
          inpagePhotosGrid.style.display = 'none';
        }
      }

      if (inpageOriginBanner) {
        if (item.isOwner) {
          inpageOriginBanner.innerHTML = `
            <span class="banner-icon">👑</span>
            <span class="banner-text">这是站长在数字空间的原创说说与思考，欢迎畅所欲言发表留言！</span>
          `;
        } else {
          inpageOriginBanner.innerHTML = `
            <span class="banner-icon">🌐</span>
            <span class="banner-text">本动态来自博友「<strong>${escapeHtml(item.author)}</strong>」，支持全站反代无缝留言，数据将实时直通其博客。</span>
          `;
        }
      }

      if (inpageExternalLink) {
        if (!item.isOwner && item.originUrl) {
          inpageExternalLink.href = item.originUrl;
          inpageExternalLink.classList.remove('hidden');
        } else {
          inpageExternalLink.classList.add('hidden');
        }
      }

      if (inpageCrossHint) {
        inpageCrossHint.textContent = item.isOwner
          ? '欢迎朋友们留下足迹'
          : `🌐 跨站直通车：直达「${item.author}」博客数据库`;
      }

      // 点赞状态同步
      const isLiked = localStorage.getItem(`moment_liked_${momentId}`) === 'true';
      const cardLikeBtn = document.querySelector(`.moment-like-btn[data-moment-id="${momentId}"]`);
      const cardLikeCount = cardLikeBtn?.querySelector('.like-count')?.textContent || String(item.likes || 0);

      if (inpageLikeCount) inpageLikeCount.textContent = cardLikeCount;
      if (inpageLikeBtn) {
        if (isLiked) {
          inpageLikeBtn.classList.add('is-liked');
        } else {
          inpageLikeBtn.classList.remove('is-liked');
        }
      }

      if (inpageQuickForm) {
        inpageQuickForm.dataset.momentId = momentId;
      }

      // 实时拉取评论
      loadMomentComments(momentId);

      // 切换视图：隐藏瀑布流，展示页面内详情
      streamViewEl.classList.add('hidden');
      inpageDetailEl.classList.remove('hidden');

      // 更新 URL hash
      if (window.location.hash !== `#moment-${momentId}`) {
        history.replaceState(null, '', `#moment-${momentId}`);
      }

      // 平滑滚动至主舞台顶部
      if (mainStageEl) {
        const stageTop = mainStageEl.getBoundingClientRect().top + window.pageYOffset - 80;
        window.scrollTo({ top: stageTop, behavior: 'smooth' });
      }
    }

    function showStreamView() {
      if (!streamViewEl || !inpageDetailEl) return;
      inpageDetailEl.classList.add('hidden');
      streamViewEl.classList.remove('hidden');
      currentActiveMomentId = null;

      if (window.location.hash.startsWith('#moment-')) {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    }

    if (btnInpageBack) btnInpageBack.addEventListener('click', showStreamView);
    if (btnInpageBackBottom) btnInpageBackBottom.addEventListener('click', () => {
      showStreamView();
      if (mainStageEl) {
        const stageTop = mainStageEl.getBoundingClientRect().top + window.pageYOffset - 80;
        window.scrollTo({ top: stageTop, behavior: 'smooth' });
      }
    });

    if (inpageLikeBtn) {
      inpageLikeBtn.addEventListener('click', () => {
        if (!currentActiveMomentId) return;
        const cardLikeBtn = document.querySelector(`.moment-like-btn[data-moment-id="${currentActiveMomentId}"]`);
        if (cardLikeBtn) {
          cardLikeBtn.click();
          const countEl = cardLikeBtn.querySelector('.like-count');
          const isLiked = cardLikeBtn.classList.contains('is-liked');
          if (inpageLikeCount) inpageLikeCount.textContent = countEl?.textContent || '0';
          if (isLiked) {
            inpageLikeBtn.classList.add('is-liked');
          } else {
            inpageLikeBtn.classList.remove('is-liked');
          }
        }
      });
    }

    if (btnInpageShare) {
      btnInpageShare.addEventListener('click', () => {
        if (!currentActiveMomentId) return;
        const item = momentsById.get(currentActiveMomentId);
        const title = item?.title || '站长朋友圈说说';
        const url = `${window.location.origin}/moments/#moment-${currentActiveMomentId}`;
        if (navigator.clipboard) {
          navigator.clipboard.writeText(`${title} - ${url}`).then(() => {
            showToast('说说直达链接已复制到剪贴板！📋');
          }).catch(() => {
            showToast(`直达链接：${url}`);
          });
        } else {
          showToast(`直达链接：${url}`);
        }
      });
    }

    // 绑定所有触发查看详情的元素 (包含标题、作者栏、图片网格、查看详情按钮)
    document.querySelectorAll('[data-open-detail]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = el.getAttribute('data-open-detail');
        if (id) {
          showMomentInPage(id);
        }
      });
    });

    // 5 行文字展开与收起
    document.querySelectorAll('.btn-toggle-expand').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.dataset.momentId;
        const bubble = document.querySelector(`.moment-summary-bubble[data-moment-id="${id}"]`);
        if (!bubble) return;
        const isClamped = bubble.classList.contains('is-clamped');
        if (isClamped) {
          bubble.classList.remove('is-clamped');
          btn.textContent = '收起 ▴';
        } else {
          bubble.classList.add('is-clamped');
          btn.textContent = '展开全文 ▾';
        }
      });
    });

    // 智能检查：如果内容不足 5 行（未产生截断溢出），自动隐藏“展开全文”按钮
    document.querySelectorAll('.moment-summary-bubble').forEach((bubble) => {
      const summary = bubble.querySelector('.moment-summary');
      const btn = bubble.querySelector('.btn-toggle-expand');
      if (summary && btn) {
        if (summary.textContent.trim().length < 130 && summary.scrollHeight <= summary.clientHeight + 4) {
          btn.style.display = 'none';
          bubble.classList.remove('is-clamped');
        }
      }
    });

    // 9. QQ 空间大图画廊沉浸式预览 (Lightbox, 杜绝外部跳出)
    const lightboxEl = document.getElementById('qzone-photo-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const btnLightboxClose = document.getElementById('btn-lightbox-close');
    const btnLightboxPrev = document.getElementById('btn-lightbox-prev');
    const btnLightboxNext = document.getElementById('btn-lightbox-next');
    const lightboxBackdrop = lightboxEl?.querySelector('.lightbox-backdrop');

    let currentGalleryImages = [];
    let currentGalleryIdx = 0;

    function openPhotoLightbox(images, startIdx = 0) {
      if (!images || images.length === 0 || !lightboxEl || !lightboxImg) return;
      currentGalleryImages = images;
      currentGalleryIdx = Math.max(0, Math.min(startIdx, images.length - 1));
      updateLightboxDisplay();
      lightboxEl.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closePhotoLightbox() {
      if (!lightboxEl) return;
      lightboxEl.classList.add('hidden');
      document.body.style.overflow = '';
      currentGalleryImages = [];
    }

    function updateLightboxDisplay() {
      if (!lightboxImg || !lightboxCounter) return;
      const url = currentGalleryImages[currentGalleryIdx];
      lightboxImg.src = url;
      lightboxCounter.textContent = `${currentGalleryIdx + 1} / ${currentGalleryImages.length}`;
      if (btnLightboxPrev) btnLightboxPrev.style.visibility = currentGalleryImages.length > 1 ? 'visible' : 'hidden';
      if (btnLightboxNext) btnLightboxNext.style.visibility = currentGalleryImages.length > 1 ? 'visible' : 'hidden';
    }

    function bindInpagePhotos(images) {
      document.querySelectorAll('.inpage-photo-item').forEach((itemEl) => {
        itemEl.addEventListener('click', (e) => {
          e.preventDefault();
          const idx = parseInt(itemEl.dataset.photoIdx || '0', 10);
          openPhotoLightbox(images, idx);
        });
      });
    }

    if (btnLightboxClose) btnLightboxClose.addEventListener('click', closePhotoLightbox);
    if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closePhotoLightbox);
    if (btnLightboxPrev) {
      btnLightboxPrev.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentGalleryImages.length <= 1) return;
        currentGalleryIdx = (currentGalleryIdx - 1 + currentGalleryImages.length) % currentGalleryImages.length;
        updateLightboxDisplay();
      });
    }
    if (btnLightboxNext) {
      btnLightboxNext.addEventListener('click', (e) => {
        e.stopPropagation();
        if (currentGalleryImages.length <= 1) return;
        currentGalleryIdx = (currentGalleryIdx + 1) % currentGalleryImages.length;
        updateLightboxDisplay();
      });
    }

    window.addEventListener('keydown', (e) => {
      if (!lightboxEl || lightboxEl.classList.contains('hidden')) return;
      if (e.key === 'Escape') closePhotoLightbox();
      if (e.key === 'ArrowLeft' && currentGalleryImages.length > 1) {
        currentGalleryIdx = (currentGalleryIdx - 1 + currentGalleryImages.length) % currentGalleryImages.length;
        updateLightboxDisplay();
      }
      if (e.key === 'ArrowRight' && currentGalleryImages.length > 1) {
        currentGalleryIdx = (currentGalleryIdx + 1) % currentGalleryImages.length;
        updateLightboxDisplay();
      }
    });

    // 路由监听：通过 URL hash (#moment-...) 自动在页面内展示说说详情
    function handleHashRoute() {
      const hash = window.location.hash;
      if (hash && (hash.startsWith('#moment-') || hash.startsWith('#m_'))) {
        const rawId = hash.replace(/^#moment-/, '').replace(/^#/, '');
        const found = momentsList.find((m) => m.id === rawId || `moment-${m.id}` === hash.slice(1));
        if (found) {
          showMomentInPage(found.id);
          return;
        }
      }
      showStreamView();
    }
    window.addEventListener('hashchange', handleHashRoute);
    setTimeout(handleHashRoute, 80);
  })();
</script>

<style>
  /* ========================================================
     QQ 空间模式朋友圈整体架构与高级质感
     ======================================================== */
  .moments-dashboard {
    max-width: 1320px;
    margin: 0 auto;
    padding: 1.5rem 1rem 5rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    color: var(--font-color, #1e293b);
  }

  .theme-card {
    background: var(--card-bg, rgba(255, 255, 255, 0.85));
    border: 1px solid var(--border-color, rgba(66, 90, 239, 0.15));
    border-radius: 12px;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  /* 1. 站长空间主页 Hero Banner */
  .qzone-space-hero {
    overflow: hidden;
    position: relative;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(66, 90, 239, 0.06) 0%, rgba(255, 255, 255, 0.95) 100%);
  }

  :root[data-theme='dark'] .qzone-space-hero {
    background: linear-gradient(135deg, rgba(66, 90, 239, 0.16) 0%, rgba(24, 25, 30, 0.95) 100%);
  }

  .qzone-space-cover {
    height: clamp(230px, 23vw, 290px);
    background: linear-gradient(120deg, #425aef 0%, #7000ff 50%, #00b4d8 100%);
    position: relative;
    padding: 1rem 1.5rem;
    box-sizing: border-box;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    transition: background-image 0.4s ease;
  }

  .space-cover-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.3) 0%, transparent 60%);
  }

  .qzone-profile-bar {
    padding: 0 2rem 1.5rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1.75rem;
    align-items: flex-end;
    margin-top: -45px;
    position: relative;
    z-index: 2;
  }

  @media (max-width: 900px) {
    .qzone-profile-bar {
      grid-template-columns: 1fr;
      align-items: flex-start;
      gap: 1rem;
      padding: 0 1.25rem 1.25rem;
    }
  }

  .profile-avatar-wrapper {
    position: relative;
    width: 92px;
    height: 92px;
  }

  .profile-avatar {
    width: 92px;
    height: 92px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--card-bg, #fff);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
  }

  .owner-crown-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    background: #f59e0b;
    color: #fff;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.5);
    border: 2px solid #fff;
  }

  .profile-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .profile-name-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .profile-name {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 850;
    color: var(--font-color);
  }

  .qzone-vip-badge {
    padding: 3px 10px;
    border-radius: 6px;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);
  }

  .qzone-level-badge {
    padding: 3px 8px;
    border-radius: 6px;
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
  }

  .qzone-radar-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: 12px;
