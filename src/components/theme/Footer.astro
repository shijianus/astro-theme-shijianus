---
import { siteConfig } from '../../config/site';
---

<footer class="border-t border-[var(--line)]">
  <div class="mx-auto grid max-w-[1400px] gap-6 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:px-8">
    <div class="space-y-3">
      <p class="eyebrow">shijianus theme system</p>
      <h2 class="text-xl font-semibold text-[var(--text-strong)]">
        为内容优先、配置优先和后续 API 接入准备的一套 Astro 主题骨架
      </h2>
      <div class="flex flex-wrap gap-2">
        {siteConfig.footer.badges.map((badge) => (
          <span class="rounded-md border border-[var(--line)] bg-[var(--surface-muted)] px-2.5 py-1 text-xs text-[var(--text-soft)]">
            {badge}
          </span>
        ))}
      </div>
    </div>

    <div class="space-y-4 lg:text-right">
      <p class="text-sm text-[var(--text-soft)]">
        © {siteConfig.footer.since} - {new Date().getFullYear()} {siteConfig.site.name}
      </p>
      <div class="flex flex-wrap gap-3 lg:justify-end">
        {siteConfig.footer.links.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noreferrer' : undefined}
            class="text-sm text-[var(--text-muted)] transition-colors hover:text-[var(--text-strong)]"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
