---
import { Archive, BookOpenText, Github, House, Link2, Mail, MessageCircleMore, Rss, Tags, UserRound } from 'lucide-react';
import { siteConfig } from '../../config/site';

const iconMap = {
  github: Github,
  mail: Mail,
  archive: Archive,
  tags: Tags,
  about: UserRound,
  home: House,
  rss: Rss,
  link: Link2,
  book: BookOpenText,
  message: MessageCircleMore,
} as const;
---

<footer id="footer" class="site-footer">
  <div id="footer-wrap">
    <div class="footer-main-shell">
      {siteConfig.theme.features.footerSocialBar && (
        <div id="footer_deal">
          {siteConfig.footer.socialBar.left.map((item) => {
            const Icon = iconMap[item.icon ?? 'home'];
            return (
              <a
                class="deal_link"
                href={item.href}
                title={item.label}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noreferrer' : undefined}
              >
                <Icon class="footer-deal-icon" aria-hidden="true" />
              </a>
            );
          })}

          <button type="button" class="footer_mini_logo" title="返回顶部" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })">
            <img alt={siteConfig.site.author.name} src={siteConfig.site.author.avatar} />
          </button>

          {siteConfig.footer.socialBar.right.map((item) => {
            const Icon = iconMap[item.icon ?? 'home'];
            return (
              <a
                class="deal_link"
                href={item.href}
                title={item.label}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noreferrer' : undefined}
              >
                <Icon class="footer-deal-icon" aria-hidden="true" />
              </a>
            );
          })}
        </div>
      )}

      {siteConfig.footer.customText && <div class="footer_custom_text">{siteConfig.footer.customText}</div>}

      <div id="site-footer-grid">
        {siteConfig.footer.groups.map((group) => (
          <section class="footer-group">
            <div class="footer-title-group">
              <span class="footer-title">{group.title}</span>
            </div>
            <div class="footer-links">
              {group.links.map((item) => (
                <a
                  class="footer-item"
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noreferrer' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>

      <p id="ghbdages">
        {siteConfig.footer.badges.map((badge) => (
          <span class="github-badge">{badge}</span>
        ))}
      </p>
    </div>
  </div>

  <div id="footer-bar">
    <div class="footer-bar-links">
      <div class="footer-bar-left">
        <div id="footer-bar-tips">
          <div class="copyright">
            © {siteConfig.footer.since} - {new Date().getFullYear()} By
            <a class="footer-bar-link" href="/" title={siteConfig.site.name}>{siteConfig.site.name}</a>
          </div>
          <div id="footer-type-tips">
            <span>{siteConfig.footer.quote}</span>
          </div>
        </div>
      </div>
      <div class="footer-bar-right">
        {siteConfig.footer.links.map((item) => (
          <a
            class="footer-bar-link"
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noreferrer' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
