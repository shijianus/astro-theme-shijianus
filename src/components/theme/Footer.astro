---
import { siteConfig } from '../../config/site';
---

<footer id="footer" class="site-footer">
  <div id="footer-wrap">
    <section class="footer-brand-card">
      <div>
        <p class="eyebrow">shijianus theme system</p>
        <h2>{siteConfig.footer.quote}</h2>
        <p>保留高信息密度、圆角卡片、悬浮反馈和模块化布局，同时把所有用户可见品牌统一到 shijianus。</p>
      </div>
      <div class="footer-badges">
        {siteConfig.footer.badges.map((badge) => (
          <span class="theme-chip">{badge}</span>
        ))}
      </div>
    </section>

    <div class="footer-group-wrap">
      {siteConfig.footer.groups.map((group) => (
        <section class="footer-group">
          <div class="footer-title-group">
            <span class="footer-title">{group.title}</span>
          </div>
          <div class="footer-links">
            {group.links.map((item) => (
              <a
                class="footer-item"
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noreferrer' : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <div id="footer-bar">
    <div class="footer-bar-links">
      <div class="footer-bar-left">
        <div id="footer-bar-tips">
          <div class="copyright">
            © {siteConfig.footer.since} - {new Date().getFullYear()} By
            <a class="footer-bar-link" href="/" title={siteConfig.site.name}>{siteConfig.site.name}</a>
          </div>
        </div>
      </div>
      <div class="footer-bar-right">
        {siteConfig.footer.links.map((item) => (
          <a
            class="footer-bar-link"
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noreferrer' : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
