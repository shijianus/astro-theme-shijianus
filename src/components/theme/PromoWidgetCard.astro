---
import QRCode from 'qrcode';
import { siteConfig } from '../../config/site';

interface Props {
  id?: string;
  className?: string;
  platform?: 'telegram' | 'wechat' | 'facebook' | 'whatsapp';
  config?: {
    href: string;
    qrImage: string;
    title: string;
    subtitle: string;
    backTitle?: string;
    backSubtitle?: string;
  };
}

const {
  id = 'promo-widget',
  className = '',
  platform = 'telegram',
} = Astro.props;

const defaultCopy = {
  telegram: {
    title: 'Telegram',
    subtitle: '专注隐私传播。海外更新、测试第一时间获取。',
    backTitle: '扫码加入',
    backSubtitle: '海外更新、测试通知与动态首发。',
    badge: '官方社群',
    ctaText: '立即直达'
  },
  wechat: {
    title: 'WeChat',
    subtitle: '微信公众号。快人一步获取最新文章与动态。',
    backTitle: '扫一扫关注',
    backSubtitle: '不错过精彩内容 · 微信动态订阅',
    badge: '官方微信',
    ctaText: '关注我们'
  },
  facebook: {
    title: 'Facebook',
    subtitle: '开放社群。加入我们，结识同好畅所欲言。',
    backTitle: '扫码关注主页',
    backSubtitle: '探索更多可能 · 开放社群交流',
    badge: '官方主页',
    ctaText: '前往主页'
  },
  whatsapp: {
    title: 'WhatsApp',
    subtitle: '快捷简单安全。即刻加入，随时保持密切联系。',
    backTitle: '扫码添加联系',
    backSubtitle: '开启即时通讯 · 保持密切连结',
    badge: '即时联系',
    ctaText: '添加好友'
  }
};

const platformConfigs = {
  telegram: {
    href: siteConfig.aside.telegramWidget?.href || 'https://t.me/chronoral',
    qrImage: siteConfig.aside.telegramWidget?.qrImage || '',
    title: siteConfig.aside.telegramWidget?.title || defaultCopy.telegram.title,
    subtitle: siteConfig.aside.telegramWidget?.subtitle || defaultCopy.telegram.subtitle,
    backTitle: siteConfig.aside.telegramWidget?.backLabel || defaultCopy.telegram.backTitle,
    backSubtitle: siteConfig.aside.telegramWidget?.summary || defaultCopy.telegram.backSubtitle,
    badge: defaultCopy.telegram.badge,
    ctaText: defaultCopy.telegram.ctaText,
  },
  wechat: {
    href: '#',
    qrImage: '',
    title: defaultCopy.wechat.title,
    subtitle: defaultCopy.wechat.subtitle,
    backTitle: defaultCopy.wechat.backTitle,
    backSubtitle: defaultCopy.wechat.backSubtitle,
    badge: defaultCopy.wechat.badge,
    ctaText: defaultCopy.wechat.ctaText,
  },
  whatsapp: {
    href: '#',
    qrImage: '',
    title: defaultCopy.whatsapp.title,
    subtitle: defaultCopy.whatsapp.subtitle,
    backTitle: defaultCopy.whatsapp.backTitle,
    backSubtitle: defaultCopy.whatsapp.backSubtitle,
    badge: defaultCopy.whatsapp.badge,
    ctaText: defaultCopy.whatsapp.ctaText,
  },
  facebook: {
    href: '#',
    qrImage: '',
    title: defaultCopy.facebook.title,
    subtitle: defaultCopy.facebook.subtitle,
    backTitle: defaultCopy.facebook.backTitle,
    backSubtitle: defaultCopy.facebook.backSubtitle,
    badge: defaultCopy.facebook.badge,
    ctaText: defaultCopy.facebook.ctaText,
  }
};

const finalConfig = Astro.props.config || platformConfigs[platform];

// Generate truly embedded high-resolution vector QR Code data URI
let embeddedQrDataUrl = '';
try {
  embeddedQrDataUrl = await QRCode.toDataURL(finalConfig.href, {
    margin: 1,
    width: 256,
    color: {
      dark: '#0369a1',
      light: '#ffffff'
    },
    errorCorrectionLevel: 'M'
  });
} catch (e) {
  console.error('Failed to generate embedded QR code', e);
  embeddedQrDataUrl = finalConfig.qrImage || '';
}
---

<div class:list={['card-widget promo-widget', className]} id={id}>
  <div id="flip-wrapper">
    <div id="flip-content">
      
      <!-- ============================================== -->
      <!-- FRONT FACE: 方案A 极光流体天蓝 + 破空航线电波正面 -->
      <!-- ============================================== -->
      <div
        class="face front-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感升维：破空虚线航迹、广播同心电波与星轨节点 (Aurora & Flight Trail) -->
        <div class="promo-scene-art promo-watermark" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- 航迹主线 (带虚线航迹) -->
            <path d="M-10 110 C70 95, 150 65, 255 18" stroke="rgba(255,255,255,0.26)" stroke-width="1.8" stroke-dasharray="4 4" />
            <path d="M10 125 C90 110, 170 80, 275 32" stroke="rgba(255,255,255,0.16)" stroke-width="1.2" />
            <!-- 无线电发射同心波纹 -->
            <circle cx="282" cy="24" r="16" stroke="rgba(255,255,255,0.24)" stroke-width="1.2" />
            <circle cx="282" cy="24" r="34" stroke="rgba(255,255,255,0.16)" stroke-width="1" />
            <circle cx="282" cy="24" r="52" stroke="rgba(255,255,255,0.08)" stroke-width="0.8" />
            <!-- 发光星轨与信号节点 -->
            <circle cx="282" cy="24" r="3.2" fill="#ffffff" opacity="0.85" />
            <circle cx="215" cy="38" r="2.2" fill="#ffffff" opacity="0.6" />
            <circle cx="165" cy="62" r="1.6" fill="#ffffff" opacity="0.45" />
            <circle cx="250" cy="72" r="2.5" fill="#ffffff" opacity="0.5" />
            <circle cx="295" cy="68" r="1.8" fill="#ffffff" opacity="0.4" />
            <!-- 破空远景领航微型纸飞机 -->
            <path d="M274 20 L294 10 L287 28 L283 23 Z" fill="#ffffff" opacity="0.55" />
          </svg>
        </div>

        <!-- 正面主体布局：毛玻璃微光圆舱 + 官方白折纸飞机 -->
        <div class="promo-front-body">
          <div class="promo-icon-emblem">
            <svg width="27" height="27" viewBox="14 68 168 118" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M98 175c-3.8 0-3.2-1.5-4.5-5.2L82 132.2 152.8 88" fill="rgba(255,255,255,0.72)" />
              <path d="M98 175c3 0 4.3-1.4 6-3l16-15.5-20-12" fill="rgba(255,255,255,0.48)" />
              <path d="M100 144.5l48.4 35.7c5.6 3.1 9.6 1.5 11-5.2l19.5-92c2-8.3-3.2-12-8.6-9.6L24.8 111c-8 3.2-8 7.7-1.4 9.7l37.4 11.7 86.8-54.8c4.1-2.5 7.8-1.2 4.7 1.6" fill="#ffffff" />
            </svg>
          </div>
          <div class="promo-front-info">
            <div class="promo-title-row">
              <span class="promo-title">{finalConfig.title}</span>
              <span class="promo-badge">{platformConfigs[platform].badge}</span>
            </div>
            <div class="promo-subtitle">{finalConfig.subtitle}</div>
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- BACK FACE: 完整设计的正向展示扫码后板         -->
      <!-- ============================================== -->
      <div
        class="face back-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感：背面对应微透电波底纹 -->
        <div class="promo-scene-art promo-scene-art--back promo-watermark promo-watermark--back" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="282" cy="24" r="16" stroke="rgba(255,255,255,0.2)" stroke-width="1.2" />
            <circle cx="282" cy="24" r="34" stroke="rgba(255,255,255,0.12)" stroke-width="1" />
            <circle cx="282" cy="24" r="52" stroke="rgba(255,255,255,0.06)" stroke-width="0.8" />
            <circle cx="282" cy="24" r="3" fill="#ffffff" opacity="0.6" />
            <circle cx="215" cy="38" r="2" fill="#ffffff" opacity="0.4" />
            <circle cx="165" cy="62" r="1.5" fill="#ffffff" opacity="0.3" />
          </svg>
        </div>

        <!-- 背面主体左右网格布局 -->
        <div class="promo-back-grid">
          <!-- 左侧文字说明与快捷按钮 -->
          <div class="promo-back-left">
            <div class="promo-back-title">{finalConfig.backTitle}</div>
            <div class="promo-back-subtitle">{finalConfig.backSubtitle}</div>
            <div class="promo-cta-action">
              <a
                href={finalConfig.href}
                target="_blank"
                rel="noopener noreferrer"
                class="promo-cta-btn"
                onclick="event.stopPropagation();"
              >
                <span>{platformConfigs[platform].ctaText}</span>
                <span class="cta-arrow">&nearr;</span>
              </a>
            </div>
          </div>

          <!-- 右侧内嵌高清矢量二维码 -->
          <div class="promo-qr-chassis">
            <div class="promo-qr-wrapper">
              <img
                src={embeddedQrDataUrl}
                alt={`${finalConfig.title} 二维码`}
                class="promo-qr-img"
                loading="eager"
                decoding="sync"
              />
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .promo-widget {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    padding: 0 !important;
    border: none;
    height: 114px;
    border-radius: 8px;
    margin: 0 !important;
    overflow: visible !important;
    cursor: pointer;
  }

  #flip-wrapper {
    -webkit-perspective: 1000px;
    perspective: 1000px;
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    /* 核心：方案A 极光四阶多色域流体渐变 (皇家宝蓝 -> 电光蓝 -> 晴空蓝 -> 湖绿青) */
    --promo-bg-gradient: 
      radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.35) 0%, transparent 40%),
      radial-gradient(circle at 92% 82%, rgba(6, 182, 212, 0.45) 0%, transparent 45%),
      linear-gradient(135deg, #1d4ed8 0%, #2563eb 38%, #0284c7 72%, #06b6d4 100%);
    --promo-card-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.38), 0 2px 6px rgba(0, 0, 0, 0.05);
    --promo-border-color: rgba(255, 255, 255, 0.48);
  }

  :global([data-theme="dark"]) #flip-wrapper {
    --promo-bg-gradient: 
      radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.15) 0%, transparent 40%),
      radial-gradient(circle at 92% 82%, rgba(6, 182, 212, 0.25) 0%, transparent 45%),
      linear-gradient(135deg, #0f172a 0%, #1e3a8a 38%, #1d4ed8 72%, #0369a1 100%);
    --promo-card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6), 0 2px 6px rgba(0, 0, 0, 0.4);
    --promo-border-color: rgba(255, 255, 255, 0.22);
  }

  #flip-content {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .face {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    box-sizing: border-box !important;
    border-radius: 8px;
    background: var(--promo-bg-gradient);
    border: 1px solid var(--promo-border-color);
    box-shadow: var(--promo-card-shadow);
    color: #ffffff;
    overflow: hidden;
    padding: 12px 16px !important;
    display: flex !important;
    align-items: center !important;
    -webkit-backface-visibility: hidden !important;
    backface-visibility: hidden !important;
    /* 核心动画优化：0.85s 从容丝滑缓动曲线 */
    transition: transform 0.85s cubic-bezier(0.25, 1, 0.35, 1), opacity 0.35s ease, visibility 0.35s ease;
    will-change: transform, opacity;
  }

  /* 正面板：默认正对用户 (0deg) */
  .front-face {
    -webkit-transform: rotateY(0deg) !important;
    transform: rotateY(0deg) !important;
    z-index: 2;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* 背面板：默认背对用户 (-180deg) */
  .back-face {
    -webkit-transform: rotateY(-180deg) !important;
    transform: rotateY(-180deg) !important;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* 悬停或聚焦时：正面翻出 (180deg) 且淡出；背面翻入正向 (0deg) 且显现 */
  .promo-widget:hover .front-face,
  .promo-widget:focus-within .front-face,
  #flip-wrapper:hover .front-face {
    -webkit-transform: rotateY(180deg) !important;
    transform: rotateY(180deg) !important;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition-delay: 0.15s;
  }

  .promo-widget:hover .back-face,
  .promo-widget:focus-within .back-face,
  #flip-wrapper:hover .back-face {
    -webkit-transform: rotateY(0deg) !important;
    transform: rotateY(0deg) !important;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 3;
    transition-delay: 0.15s;
  }

  /* 方案A 破空航线与广播电波全景场景 (Aurora & Flight Trail) */
  .promo-scene-art,
  .promo-watermark {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none !important;
    z-index: 1 !important;
    overflow: hidden !important;
  }

  .promo-scene-art svg,
  .promo-watermark svg {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  /* FRONT FACE 样式 */
  .promo-front-body {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 13px;
    width: 100%;
  }

  .promo-icon-emblem {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.45);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.6), 0 4px 10px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .promo-icon-emblem svg {
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.15));
  }

  .promo-front-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    flex: 1;
  }

  .promo-title-row {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 3px;
  }

  .promo-title {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.2px;
    color: #ffffff;
    line-height: 1.2;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .promo-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1.5px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: #ffffff;
    line-height: 1.2;
    white-space: nowrap;
  }

  .promo-subtitle {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  /* BACK FACE 样式 */
  .promo-back-grid {
    position: relative;
    z-index: 2;
    display: grid !important;
    grid-template-columns: 1fr 76px !important;
    align-items: center !important;
    gap: 12px !important;
    width: 100% !important;
    height: 100% !important;
  }

  .promo-back-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .promo-back-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 2px;
    line-height: 1.2;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .promo-back-subtitle {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.35;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .promo-cta-action {
    display: flex;
  }

  .promo-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 12px;
    background: #ffffff;
    color: #0369a1;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
    transition: all 0.2s ease;
    width: fit-content;
  }

  .promo-cta-btn:hover {
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 4px 12px rgba(3, 105, 161, 0.25);
    color: #0284c7;
  }

  .cta-arrow {
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1;
  }

  /* 内嵌二维码容器 */
  .promo-qr-chassis {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .promo-qr-wrapper {
    width: 76px;
    height: 76px;
    background: #ffffff;
    border-radius: 6px;
    padding: 3px;
    box-sizing: border-box;
    box-shadow: 0 4px 12px rgba(3, 105, 161, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.85);
    overflow: hidden;
  }

  .promo-qr-wrapper img,
  .promo-qr-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    object-position: center !important;
    display: block !important;
    image-rendering: pixelated;
  }
</style>
