---
import QRCode from 'qrcode';
import { siteConfig } from '../../config/site';

interface Props {
  id?: string;
  className?: string;
  platform?: 'telegram' | 'wechat' | 'facebook' | 'whatsapp';
  config?: {
    href: string;
    qrImage: string;
    title: string;
    subtitle: string;
    backTitle?: string;
    backSubtitle?: string;
  };
}

const {
  id = 'promo-widget',
  className = '',
  platform = 'telegram',
} = Astro.props;

const defaultCopy = {
  telegram: {
    title: 'Telegram',
    subtitle: '专注隐私传播。海外更新、测试第一时间获取。',
    backTitle: '扫码加入',
    backSubtitle: '海外更新、测试通知与动态首发。',
    badge: '官方社群',
    ctaText: '立即直达'
  },
  wechat: {
    title: 'WeChat',
    subtitle: '微信公众号。快人一步获取最新文章与动态。',
    backTitle: '扫一扫关注',
    backSubtitle: '不错过精彩内容 · 微信动态订阅',
    badge: '官方微信',
    ctaText: '关注我们'
  },
  facebook: {
    title: 'Facebook',
    subtitle: '开放社群。加入我们，结识同好畅所欲言。',
    backTitle: '扫码关注主页',
    backSubtitle: '探索更多可能 · 开放社群交流',
    badge: '官方主页',
    ctaText: '前往主页'
  },
  whatsapp: {
    title: 'WhatsApp',
    subtitle: '快捷简单安全。即刻加入，随时保持密切联系。',
    backTitle: '扫码添加联系',
    backSubtitle: '开启即时通讯 · 保持密切连结',
    badge: '即时联系',
    ctaText: '添加好友'
  }
};

const platformConfigs = {
  telegram: {
    href: siteConfig.aside.telegramWidget?.href || 'https://t.me/chronoral',
    qrImage: siteConfig.aside.telegramWidget?.qrImage || '',
    title: siteConfig.aside.telegramWidget?.title || defaultCopy.telegram.title,
    subtitle: siteConfig.aside.telegramWidget?.subtitle || defaultCopy.telegram.subtitle,
    backTitle: siteConfig.aside.telegramWidget?.backLabel || defaultCopy.telegram.backTitle,
    backSubtitle: siteConfig.aside.telegramWidget?.summary || defaultCopy.telegram.backSubtitle,
    badge: defaultCopy.telegram.badge,
    ctaText: defaultCopy.telegram.ctaText,
  },
  wechat: {
    href: '#',
    qrImage: '',
    title: defaultCopy.wechat.title,
    subtitle: defaultCopy.wechat.subtitle,
    backTitle: defaultCopy.wechat.backTitle,
    backSubtitle: defaultCopy.wechat.backSubtitle,
    badge: defaultCopy.wechat.badge,
    ctaText: defaultCopy.wechat.ctaText,
  },
  whatsapp: {
    href: '#',
    qrImage: '',
    title: defaultCopy.whatsapp.title,
    subtitle: defaultCopy.whatsapp.subtitle,
    backTitle: defaultCopy.whatsapp.backTitle,
    backSubtitle: defaultCopy.whatsapp.backSubtitle,
    badge: defaultCopy.whatsapp.badge,
    ctaText: defaultCopy.whatsapp.ctaText,
  },
  facebook: {
    href: '#',
    qrImage: '',
    title: defaultCopy.facebook.title,
    subtitle: defaultCopy.facebook.subtitle,
    backTitle: defaultCopy.facebook.backTitle,
    backSubtitle: defaultCopy.facebook.backSubtitle,
    badge: defaultCopy.facebook.badge,
    ctaText: defaultCopy.facebook.ctaText,
  }
};

const finalConfig = Astro.props.config || platformConfigs[platform];

// Generate truly embedded high-resolution vector QR Code data URI
let embeddedQrDataUrl = '';
try {
  embeddedQrDataUrl = await QRCode.toDataURL(finalConfig.href, {
    margin: 1,
    width: 256,
    color: {
      dark: '#0369a1',
      light: '#ffffff'
    },
    errorCorrectionLevel: 'M'
  });
} catch (e) {
  console.error('Failed to generate embedded QR code', e);
  embeddedQrDataUrl = finalConfig.qrImage || '';
}

---

<div class:list={['card-widget promo-widget', className]} id={id}>
  <div id="flip-wrapper">
    <div id="flip-content">
      
      <!-- ============================================== -->
      <!-- FRONT FACE: 方案A 极光流体天蓝 + 超音速破空航迹与空间广播电波 -->
      <!-- ============================================== -->
      <div
        class="face front-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 核心背景：超音速破空航迹流光 (与官方纸飞机完美呼应，避开文字排版区) -->
        <div class="promo-scene-art promo-watermark" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- 1. 破空主航迹线：从左下自然上扬，沿文字底部优雅接入机尾 -->
            <path class="contrail-primary" d="M -10 108 C 50 106, 120 104, 180 98 C 220 94, 252 82, 274 66" 
                  stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" opacity="0.65" />
            <!-- 2. 伴飞副气流线 (天青微光) -->
            <path class="contrail-secondary" d="M 15 112 C 75 110, 140 108, 195 102 C 230 96, 258 84, 278 62" 
                  stroke="#bae6fd" stroke-width="1.0" stroke-linecap="round" opacity="0.4" />
            <!-- 3. 高空平流层风洞微气流 (位于顶部空白区) -->
            <path class="wind-stream" d="M 120 14 Q 220 8, 330 18" stroke="#ffffff" stroke-width="0.8" opacity="0.3" stroke-linecap="round" stroke-dasharray="25 60" />
            <path class="wind-stream" d="M 160 22 Q 240 16, 320 24" stroke="#7dd3fc" stroke-width="0.6" opacity="0.25" stroke-linecap="round" stroke-dasharray="20 40" />
            <!-- 4. 尾流微型翼尖涡流环 -->
            <ellipse cx="258" cy="74" rx="10" ry="5" transform="rotate(-15 258 74)" stroke="#bae6fd" stroke-width="0.8" stroke-dasharray="3 3" opacity="0.35" />
          </svg>
        </div>

        <!-- 权威开源 Telegram 官方立体折纸飞机 (Wikimedia Commons 3-Tone Shaded 真实物理光影与官方折痕) -->
        <div class="promo-hero-plane" aria-hidden="true">
          <svg width="74" height="74" viewBox="48 60 135 115" style="overflow: visible; filter: drop-shadow(0 8px 16px rgba(15, 23, 42, 0.45)) drop-shadow(0 2px 4px rgba(2, 44, 120, 0.35));">
            <!-- 1. 下折底翼 (天青浅蓝底面) -->
            <path d="M81.229,128.772l14.237,39.406s1.78,3.687,3.686,3.687,30.255-29.492,30.255-29.492l31.525-60.89L81.737,118.6Z" fill="#bae6fd"/>
            <!-- 2. 机腹中脊 (亮海蓝立体折角) -->
            <path d="M100.106,138.878l-2.733,29.046s-1.144,8.9,7.754,0,17.415-15.763,17.415-15.763" fill="#60a5fa"/>
            <!-- 3. 主翼面 (官方纯白挺拔折纸，负空间内切弧度完全忠实官方) -->
            <path d="M81.486,130.178,52.2,120.636s-3.5-1.42-2.373-4.64c.232-.664.7-1.229,2.1-2.2,6.489-4.523,120.106-45.36,120.106-45.36s3.208-1.081,5.1-.362a2.766,2.766,0,0,1,1.885,2.055,9.357,9.357,0,0,1,.254,2.585c-.009.752-.1,1.449-.169,2.542-.692,11.165-21.4,94.493-21.4,94.493s-1.239,4.876-5.678,5.043A8.13,8.13,0,0,1,146.1,172.5c-8.711-7.493-38.819-27.727-45.472-32.177a1.27,1.27,0,0,1-.546-.9c-.093-.469.417-1.05.417-1.05s52.426-46.6,53.821-51.492c.108-.379-.3-.566-.848-.4-3.482,1.281-63.844,39.4-70.506,43.607A3.21,3.21,0,0,1,81.486,130.178Z" fill="#ffffff"/>
          </svg>
        </div>

        <!-- 正面主体布局：立体深空微光探测舱 + 形象化 3D 纸飞机 -->
        <div class="promo-front-body">
          <div class="promo-icon-emblem">
            <svg class="promo-icon-plane" width="24" height="24" viewBox="48 60 135 115" xmlns="http://www.w3.org/2000/svg">
              <path d="M81.229,128.772l14.237,39.406s1.78,3.687,3.686,3.687,30.255-29.492,30.255-29.492l31.525-60.89L81.737,118.6Z" fill="#bae6fd"/>
              <path d="M100.106,138.878l-2.733,29.046s-1.144,8.9,7.754,0,17.415-15.763,17.415-15.763" fill="#60a5fa"/>
              <path d="M81.486,130.178,52.2,120.636s-3.5-1.42-2.373-4.64c.232-.664.7-1.229,2.1-2.2,6.489-4.523,120.106-45.36,120.106-45.36s3.208-1.081,5.1-.362a2.766,2.766,0,0,1,1.885,2.055,9.357,9.357,0,0,1,.254,2.585c-.009.752-.1,1.449-.169,2.542-.692,11.165-21.4,94.493-21.4,94.493s-1.239,4.876-5.678,5.043A8.13,8.13,0,0,1,146.1,172.5c-8.711-7.493-38.819-27.727-45.472-32.177a1.27,1.27,0,0,1-.546-.9c-.093-.469.417-1.05.417-1.05s52.426-46.6,53.821-51.492c.108-.379-.3-.566-.848-.4-3.482,1.281-63.844,39.4-70.506,43.607A3.21,3.21,0,0,1,81.486,130.178Z" fill="#ffffff"/>
            </svg>
          </div>
          <div class="promo-front-info">
            <div class="promo-title-row">
              <span class="promo-title">{finalConfig.title}</span>
              <span class="promo-badge">{platformConfigs[platform].badge}</span>
            </div>
            <div class="promo-subtitle">{finalConfig.subtitle}</div>
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- BACK FACE: 完整设计的正向展示扫码后板         -->
      <!-- ============================================== -->
      <div
        class="face back-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感：背面对应微透广播电波底纹 (以二维码为中心向外发散) -->
        <div class="promo-scene-art promo-scene-art--back promo-watermark promo-watermark--back" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="260" cy="57" r="42" stroke="#ffffff" stroke-width="1.0" stroke-dasharray="10 8" opacity="0.25" />
            <circle cx="260" cy="57" r="75" stroke="#bae6fd" stroke-width="0.8" stroke-dasharray="14 10" opacity="0.18" />
            <circle cx="260" cy="57" r="115" stroke="#7dd3fc" stroke-width="0.5" opacity="0.12" />
          </svg>
        </div>

        <!-- 背面主体左右网格布局 -->
        <div class="promo-back-grid">
          <!-- 左侧文字说明与快捷按钮 -->
          <div class="promo-back-left">
            <div class="promo-back-title">{finalConfig.backTitle}</div>
            <div class="promo-back-subtitle">{finalConfig.backSubtitle}</div>
            <div class="promo-cta-action">
              <a
                href={finalConfig.href}
                target="_blank"
                rel="noopener noreferrer"
                class="promo-cta-btn"
                onclick="event.stopPropagation();"
              >
                <span>{platformConfigs[platform].ctaText}</span>
                <span class="cta-arrow">&nearr;</span>
              </a>
            </div>
          </div>

          <!-- 右侧内嵌高清矢量二维码 -->
          <div class="promo-qr-chassis">
            <div class="promo-qr-wrapper">
              <img
                src={embeddedQrDataUrl}
                alt={`${finalConfig.title} 二维码`}
                class="promo-qr-img"
                loading="eager"
                decoding="sync"
              />
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .promo-widget {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    padding: 0 !important;
    border: none;
    height: 114px;
    border-radius: 8px;
    margin: 0 !important;
    overflow: visible !important;
    cursor: pointer;
  }

  #flip-wrapper {
    -webkit-perspective: 1000px;
    perspective: 1000px;
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    /* 核心：方案A 极光四阶多色域流体渐变 (皇家宝蓝 -> 电光蓝 -> 晴空蓝 -> 湖绿青) */
    --promo-bg-gradient: 
      radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.35) 0%, transparent 40%),
      radial-gradient(circle at 92% 82%, rgba(6, 182, 212, 0.45) 0%, transparent 45%),
      linear-gradient(135deg, #1d4ed8 0%, #2563eb 38%, #0284c7 72%, #06b6d4 100%);
    --promo-card-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.38), 0 2px 6px rgba(0, 0, 0, 0.05);
    --promo-border-color: rgba(255, 255, 255, 0.48);
  }

  :global([data-theme="dark"]) #flip-wrapper {
    --promo-bg-gradient: 
      radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.15) 0%, transparent 40%),
      radial-gradient(circle at 92% 82%, rgba(6, 182, 212, 0.25) 0%, transparent 45%),
      linear-gradient(135deg, #0f172a 0%, #1e3a8a 38%, #1d4ed8 72%, #0369a1 100%);
    --promo-card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6), 0 2px 6px rgba(0, 0, 0, 0.4);
    --promo-border-color: rgba(255, 255, 255, 0.22);
  }

  #flip-content {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .face {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    box-sizing: border-box !important;
    border-radius: 8px;
    background: var(--promo-bg-gradient);
    border: 1px solid var(--promo-border-color);
    box-shadow: var(--promo-card-shadow);
    color: #ffffff;
    overflow: hidden;
    padding: 12px 16px !important;
    display: flex !important;
    align-items: center !important;
    -webkit-backface-visibility: hidden !important;
    backface-visibility: hidden !important;
    /* 核心动画优化：0.85s 从容丝滑缓动曲线 */
    transition: transform 0.85s cubic-bezier(0.25, 1, 0.35, 1), opacity 0.35s ease, visibility 0.35s ease;
    will-change: transform, opacity;
  }

  /* 正面板：默认正对用户 (0deg) */
  .front-face {
    -webkit-transform: rotateY(0deg) !important;
    transform: rotateY(0deg) !important;
    z-index: 2;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* 背面板：默认背对用户 (-180deg) */
  .back-face {
    -webkit-transform: rotateY(-180deg) !important;
    transform: rotateY(-180deg) !important;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* 悬停或聚焦时：正面翻出 (180deg) 且淡出；背面翻入正向 (0deg) 且显现 */
  .promo-widget:hover .front-face,
  .promo-widget:focus-within .front-face,
  #flip-wrapper:hover .front-face {
    -webkit-transform: rotateY(180deg) !important;
    transform: rotateY(180deg) !important;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition-delay: 0.15s;
  }

  .promo-widget:hover .back-face,
  .promo-widget:focus-within .back-face,
  #flip-wrapper:hover .back-face {
    -webkit-transform: rotateY(0deg) !important;
    transform: rotateY(0deg) !important;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 3;
    transition-delay: 0.15s;
  }

  /* 方案A 破空航线与广播电波全景场景 (Aurora & Flight Trail) */
  .promo-scene-art,
  .promo-watermark {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none !important;
    z-index: 1 !important;
    overflow: hidden !important;
  }

  .promo-scene-art svg,
  .promo-watermark svg {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  /* FRONT FACE 样式 */
  .promo-front-body {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 13px;
    width: 100%;
  }

  .promo-icon-emblem {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.38) 0%, rgba(255, 255, 255, 0.14) 65%, rgba(2, 44, 120, 0.25) 100%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.7), 0 4px 12px rgba(2, 44, 120, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .promo-icon-plane {
    width: 24px;
    height: 24px;
    filter: drop-shadow(0 2px 4px rgba(2, 44, 120, 0.3));
    transition: transform 0.3s ease;
  }

  .promo-widget:hover .promo-icon-plane {
    transform: scale(1.08) translate(1px, -1px);
  }

  /* ======================================================== */
  /* 核心动态化动效体系 (Aerodynamic Contrail & Radio Waves)  */
  /* ======================================================== */

  /* 1. 破空超音速航迹流光 (Aerodynamic Contrail Stream) */
  .contrail-primary {
    stroke-dasharray: 8 6;
    animation: streamFlow 1.6s linear infinite;
  }
  .contrail-secondary {
    stroke-dasharray: 5 7;
    animation: streamFlow 1.2s linear infinite;
  }
  @keyframes streamFlow {
    from { stroke-dashoffset: 28; }
    to { stroke-dashoffset: 0; }
  }

  /* 2. 平流层高空气流微动 */
  .wind-stream {
    animation: windDrift 6s ease-in-out infinite alternate;
  }
  @keyframes windDrift {
    from { transform: translateX(0); }
    to { transform: translateX(8px); }
  }

  /* 3. 背面二维码广播微透脉冲 */
  .back-pulse {
    animation: backPulse 4s ease-in-out infinite;
    transform-origin: 260px 57px;
  }
  @keyframes backPulse {
    0%, 100% { transform: scale(1); opacity: 0.25; }
    50% { transform: scale(1.05); opacity: 0.45; }
  }

  /* 2. 官方权威 Telegram 立体折纸飞机悬浮微动与交互 */
  .promo-hero-plane {
    position: absolute;
    right: 18px;
    top: 20px;
    z-index: 5;
    pointer-events: none;
    animation: heroPlaneFloat 4.2s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes heroPlaneFloat {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-3.5px) rotate(1.5deg);
    }
  }

  /* 悬停时纸飞机轻微俯冲加速 */
  .promo-widget:hover .promo-hero-plane {
    transform: translateY(-5px) scale(1.06) rotate(3deg);
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.35, 1);
  }

  .promo-front-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    flex: 1;
  }

  .promo-title-row {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 3px;
  }

  .promo-title {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.2px;
    color: #ffffff;
    line-height: 1.2;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .promo-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1.5px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.45);
    color: #ffffff;
    line-height: 1.2;
    white-space: nowrap;
  }

  .promo-subtitle {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  /* BACK FACE 样式 */
  .promo-back-grid {
    position: relative;
    z-index: 2;
    display: grid !important;
    grid-template-columns: 1fr 76px !important;
    align-items: center !important;
    gap: 12px !important;
    width: 100% !important;
    height: 100% !important;
  }

  .promo-back-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .promo-back-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 2px;
    line-height: 1.2;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .promo-back-subtitle {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.35;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .promo-cta-action {
    display: flex;
  }

  .promo-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
