---
import QRCode from 'qrcode';
import { siteConfig } from '../../config/site';

interface Props {
  id?: string;
  className?: string;
  platform?: 'telegram' | 'wechat' | 'facebook' | 'whatsapp';
  config?: {
    href: string;
    qrImage: string;
    title: string;
    subtitle: string;
    backTitle?: string;
    backSubtitle?: string;
  };
}

const {
  id = 'promo-widget',
  className = '',
  platform = 'telegram',
} = Astro.props;

const defaultCopy = {
  telegram: {
    title: 'Telegram',
    subtitle: '专注隐私传播。海外更新、测试第一时间获取。',
    backTitle: '扫码加入',
    backSubtitle: '海外更新、测试通知与动态首发。',
    badge: '官方社群',
    ctaText: '立即直达'
  },
  wechat: {
    title: 'WeChat',
    subtitle: '微信公众号。快人一步获取最新文章与动态。',
    backTitle: '扫一扫关注',
    backSubtitle: '不错过精彩内容 · 微信动态订阅',
    badge: '官方微信',
    ctaText: '关注我们'
  },
  facebook: {
    title: 'Facebook',
    subtitle: '开放社群。加入我们，结识同好畅所欲言。',
    backTitle: '扫码关注主页',
    backSubtitle: '探索更多可能 · 开放社群交流',
    badge: '官方主页',
    ctaText: '前往主页'
  },
  whatsapp: {
    title: 'WhatsApp',
    subtitle: '快捷简单安全。即刻加入，随时保持密切联系。',
    backTitle: '扫码添加联系',
    backSubtitle: '开启即时通讯 · 保持密切连结',
    badge: '即时联系',
    ctaText: '添加好友'
  }
};

const platformConfigs = {
  telegram: {
    href: siteConfig.aside.telegramWidget?.href || 'https://t.me/chronoral',
    qrImage: siteConfig.aside.telegramWidget?.qrImage || '',
    title: siteConfig.aside.telegramWidget?.title || defaultCopy.telegram.title,
    subtitle: siteConfig.aside.telegramWidget?.subtitle || defaultCopy.telegram.subtitle,
    backTitle: siteConfig.aside.telegramWidget?.backLabel || defaultCopy.telegram.backTitle,
    backSubtitle: siteConfig.aside.telegramWidget?.summary || defaultCopy.telegram.backSubtitle,
    badge: defaultCopy.telegram.badge,
    ctaText: defaultCopy.telegram.ctaText,
  },
  wechat: {
    href: '#',
    qrImage: '',
    title: defaultCopy.wechat.title,
    subtitle: defaultCopy.wechat.subtitle,
    backTitle: defaultCopy.wechat.backTitle,
    backSubtitle: defaultCopy.wechat.backSubtitle,
    badge: defaultCopy.wechat.badge,
    ctaText: defaultCopy.wechat.ctaText,
  },
  whatsapp: {
    href: '#',
    qrImage: '',
    title: defaultCopy.whatsapp.title,
    subtitle: defaultCopy.whatsapp.subtitle,
    backTitle: defaultCopy.whatsapp.backTitle,
    backSubtitle: defaultCopy.whatsapp.backSubtitle,
    badge: defaultCopy.whatsapp.badge,
    ctaText: defaultCopy.whatsapp.ctaText,
  },
  facebook: {
    href: '#',
    qrImage: '',
    title: defaultCopy.facebook.title,
    subtitle: defaultCopy.facebook.subtitle,
    backTitle: defaultCopy.facebook.backTitle,
    backSubtitle: defaultCopy.facebook.backSubtitle,
    badge: defaultCopy.facebook.badge,
    ctaText: defaultCopy.facebook.ctaText,
  }
};

const finalConfig = Astro.props.config || platformConfigs[platform];

// Generate truly embedded high-resolution vector QR Code data URI
let embeddedQrDataUrl = '';
try {
  embeddedQrDataUrl = await QRCode.toDataURL(finalConfig.href, {
    margin: 1,
    width: 256,
    color: {
      dark: '#0369a1',
      light: '#ffffff'
    },
    errorCorrectionLevel: 'M'
  });
} catch (e) {
  console.error('Failed to generate embedded QR code', e);
  embeddedQrDataUrl = finalConfig.qrImage || '';
}

// 天文长曝光旋转同心星轨算法 (Celestial Pole Star Trails)
function arcPath(cx: number, cy: number, r: number, startDeg: number, endDeg: number) {
  const startRad = (startDeg * Math.PI) / 180;
  const endRad = (endDeg * Math.PI) / 180;
  const x1 = cx + r * Math.cos(startRad);
  const y1 = cy + r * Math.sin(startRad);
  const x2 = cx + r * Math.cos(endRad);
  const y2 = cy + r * Math.sin(endRad);
  const largeArc = Math.abs(endDeg - startDeg) > 180 ? 1 : 0;
  const sweep = endDeg > startDeg ? 1 : 0;
  return `M ${x1.toFixed(1)} ${y1.toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 ${largeArc} ${sweep} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
}

// 纯净天文同心星轨群 A (天极中心 cx: 330, cy: -35，360 度圆周分布，顺滑无顿挫自转)
const frontStarTrailsA = [
  { r: 60, s: 70, span: 45, sw: 0.8, op: 0.42, c: '#ffffff' },
  { r: 85, s: 125, span: 55, sw: 0.6, op: 0.32, c: '#bae6fd' },
  { r: 105, s: 75, span: 60, sw: 1.1, op: 0.55, c: '#ffffff' },
  { r: 120, s: 155, span: 42, sw: 0.5, op: 0.28, c: '#7dd3fc' },
  { r: 145, s: 90, span: 65, sw: 0.75, op: 0.38, c: '#e0f2fe' },
  { r: 165, s: 55, span: 52, sw: 1.15, op: 0.58, c: '#ffffff' },
  { r: 185, s: 115, span: 68, sw: 0.6, op: 0.3, c: '#38bdf8' },
  { r: 210, s: 80, span: 58, sw: 0.9, op: 0.42, c: '#bae6fd' },
  { r: 235, s: 100, span: 62, sw: 0.6, op: 0.28, c: '#7dd3fc' },
  { r: 260, s: 65, span: 72, sw: 1.0, op: 0.48, c: '#ffffff' },
  { r: 290, s: 110, span: 52, sw: 0.5, op: 0.24, c: '#38bdf8' },
  { r: 320, s: 75, span: 65, sw: 0.8, op: 0.32, c: '#bae6fd' },
  { r: 350, s: 92, span: 58, sw: 0.55, op: 0.22, c: '#e0f2fe' },
  { r: 385, s: 105, span: 50, sw: 0.45, op: 0.18, c: '#7dd3fc' },
  { r: 75, s: 230, span: 50, sw: 0.7, op: 0.38, c: '#ffffff' },
  { r: 115, s: 210, span: 60, sw: 0.9, op: 0.48, c: '#bae6fd' },
  { r: 155, s: 245, span: 65, sw: 0.6, op: 0.32, c: '#7dd3fc' },
  { r: 195, s: 205, span: 55, sw: 1.1, op: 0.52, c: '#ffffff' },
  { r: 245, s: 255, span: 68, sw: 0.75, op: 0.38, c: '#e0f2fe' },
  { r: 295, s: 225, span: 58, sw: 0.5, op: 0.22, c: '#38bdf8' },
  { r: 340, s: 265, span: 52, sw: 0.7, op: 0.28, c: '#bae6fd' }
].map(a => ({
  d: arcPath(330, -35, a.r, a.s, a.s + a.span),
  strokeWidth: a.sw,
  opacity: a.op,
  color: a.c
}));

// 纯净天文同心星轨群 B (形成长曝光深邃差速视差)
const frontStarTrailsB = [
  { r: 70, s: 105, span: 40, sw: 0.65, op: 0.35, c: '#e0f2fe' },
  { r: 95, s: 50, span: 48, sw: 0.85, op: 0.45, c: '#ffffff' },
  { r: 130, s: 135, span: 58, sw: 0.55, op: 0.26, c: '#38bdf8' },
  { r: 150, s: 70, span: 62, sw: 0.95, op: 0.5, c: '#ffffff' },
  { r: 175, s: 100, span: 50, sw: 0.6, op: 0.3, c: '#bae6fd' },
  { r: 220, s: 140, span: 66, sw: 0.75, op: 0.36, c: '#e0f2fe' },
  { r: 275, s: 85, span: 60, sw: 0.85, op: 0.4, c: '#ffffff' },
  { r: 330, s: 125, span: 54, sw: 0.5, op: 0.22, c: '#7dd3fc' },
  { r: 85, s: 260, span: 45, sw: 0.6, op: 0.32, c: '#bae6fd' },
  { r: 140, s: 190, span: 55, sw: 0.9, op: 0.46, c: '#ffffff' },
  { r: 180, s: 280, span: 60, sw: 0.55, op: 0.28, c: '#7dd3fc' },
  { r: 230, s: 215, span: 64, sw: 0.8, op: 0.38, c: '#e0f2fe' },
  { r: 285, s: 270, span: 56, sw: 0.6, op: 0.26, c: '#bae6fd' }
].map(a => ({
  d: arcPath(330, -35, a.r, a.s, a.s + a.span),
  strokeWidth: a.sw,
  opacity: a.op,
  color: a.c
}));

// 背面 13 轨极简连续星轨
const backStarTrails = [
  { r: 70, s: 90, span: 55, sw: 0.6, op: 0.24, c: '#e0f2fe' },
  { r: 105, s: 120, span: 60, sw: 0.8, op: 0.3, c: '#bae6fd' },
  { r: 145, s: 80, span: 50, sw: 0.5, op: 0.2, c: '#7dd3fc' },
  { r: 185, s: 110, span: 65, sw: 0.7, op: 0.26, c: '#ffffff' },
  { r: 230, s: 75, span: 70, sw: 0.5, op: 0.18, c: '#38bdf8' },
  { r: 280, s: 100, span: 60, sw: 0.6, op: 0.22, c: '#bae6fd' },
  { r: 330, s: 85, span: 55, sw: 0.45, op: 0.16, c: '#e0f2fe' },
  { r: 85, s: 250, span: 50, sw: 0.55, op: 0.22, c: '#bae6fd' },
  { r: 125, s: 220, span: 60, sw: 0.75, op: 0.28, c: '#ffffff' },
  { r: 165, s: 260, span: 55, sw: 0.5, op: 0.2, c: '#7dd3fc' },
  { r: 210, s: 210, span: 65, sw: 0.65, op: 0.24, c: '#e0f2fe' },
  { r: 260, s: 245, span: 58, sw: 0.45, op: 0.16, c: '#38bdf8' },
  { r: 310, s: 230, span: 52, sw: 0.55, op: 0.18, c: '#bae6fd' }
].map(a => ({
  d: arcPath(330, -35, a.r, a.s, a.s + a.span),
  strokeWidth: a.sw,
  opacity: a.op,
  color: a.c
}));
---

<div class:list={['card-widget promo-widget', className]} id={id}>
  <div id="flip-wrapper">
    <div id="flip-content">
      
      <!-- ============================================== -->
      <!-- FRONT FACE: 方案A 极光流体天蓝 + 动态长曝光星轨正面 -->
      <!-- ============================================== -->
      <div
        class="face front-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感升维：纯净天文旋转同心星轨 (0 随机滑动杂星，0 十字光刺) -->
        <div class="promo-scene-art promo-watermark" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- 官方标准 3D Telegram 纸飞机专属立体光影渐变与高反差投影 -->
              <linearGradient id="hero-tg-body" x1="20" y1="110" x2="175" y2="75" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="70%" stop-color="#ffffff" />
                <stop offset="100%" stop-color="#f0f7ff" />
              </linearGradient>
              <linearGradient id="hero-tg-keel" x1="82" y1="132" x2="152" y2="88" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#2563eb" />
                <stop offset="100%" stop-color="#1d4ed8" />
              </linearGradient>
              <linearGradient id="hero-tg-flap" x1="98" y1="175" x2="120" y2="140" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#60a5fa" />
                <stop offset="100%" stop-color="#2563eb" />
              </linearGradient>
              <linearGradient id="hero-tg-underwing" x1="100" y1="144" x2="148" y2="180" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#93c5fd" />
                <stop offset="100%" stop-color="#60a5fa" />
              </linearGradient>
              <filter id="hero-plane-shadow" x="-40%" y="-40%" width="180%" height="180%">
                <feDropShadow dx="-2" dy="6" stdDeviation="4" flood-color="rgba(15, 23, 42, 0.42)" />
                <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="rgba(2, 44, 120, 0.3)" />
              </filter>
            </defs>

            <!-- 纯净天文旋转星轨群 A (42s 连续天体旋转，0 随机杂星，0 虚线滑动) -->
            <g class="celestial-wheel-a">
              {frontStarTrailsA.map((trail) => (
                <path
                  d={trail.d}
                  fill="none"
                  stroke={trail.color}
                  stroke-width={trail.strokeWidth}
                  opacity={trail.opacity}
                  stroke-linecap="round"
                />
              ))}
            </g>

            <!-- 纯净天文旋转星轨群 B (64s 差速双层深邃星空视差) -->
            <g class="celestial-wheel-b">
              {frontStarTrailsB.map((trail) => (
                <path
                  d={trail.d}
                  fill="none"
                  stroke={trail.color}
                  stroke-width={trail.strokeWidth}
                  opacity={trail.opacity}
                  stroke-linecap="round"
                />
              ))}
            </g>
          </svg>
        </div>

        <!-- 极度醒目、一眼必识、绝对清晰立体的 3D Telegram 纸飞机 (昂首翱翔，高反差浮雕质感) -->
        <div class="promo-hero-plane" aria-hidden="true">
          <svg width="68" height="68" viewBox="10 65 175 125" fill="none" style="overflow: visible; filter: url(#hero-plane-shadow);">
            <!-- 1. 折叠机腹内层三角 (深邃群青蓝) -->
            <path d="M98 175c-3.8 0-3.2-1.5-4.5-5.2L82 132.2 152.8 88" fill="url(#hero-tg-keel)" />
            <!-- 2. 中腹折叠小角 (天青宝蓝) -->
            <path d="M98 175c3 0 4.3-1.4 6-3l16-15.5-20-12" fill="url(#hero-tg-flap)" />
            <!-- 3. 主折纸机身大翼面 (纯白挺拔破空主翼) -->
            <path d="M100 144.5l48.4 35.7c5.6 3.1 9.6 1.5 11-5.2l19.5-92c2-8.3-3.2-12-8.6-9.6L24.8 111c-8 3.2-8 7.7-1.4 9.7l37.4 11.7 86.8-54.8c4.1-2.5 7.8-1.2 4.7 1.6" fill="url(#hero-tg-body)" />
            <!-- 4. 下折副翼立体阴影层 -->
            <path d="M100 144.5 L 148.4 180.2 C 154 183.3 158 181.7 159.4 175 L 178.9 83 C 180.9 74.7 175.7 71 170.3 73.4 L 62.2 122.7 Z" fill="url(#hero-tg-underwing)" opacity="0.3" />
            <!-- 5. 机脊纯白极锐折线 -->
            <path d="M62.2 122.7 L 170.3 73.4" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" />
            <!-- 6. 机尖破空耀斑微亮点 -->
            <circle cx="178.9" cy="83" r="2.2" fill="#ffffff" />
          </svg>
        </div>

        <!-- 正面主体布局：立体深空微光探测舱 + 形象化 3D 纸飞机 -->
        <div class="promo-front-body">
          <div class="promo-icon-emblem">
            <svg class="promo-icon-plane" width="24" height="24" viewBox="14 68 168 118" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M98 175c-3.8 0-3.2-1.5-4.5-5.2L82 132.2 152.8 88" fill="rgba(255,255,255,0.78)" />
              <path d="M98 175c3 0 4.3-1.4 6-3l16-15.5-20-12" fill="rgba(255,255,255,0.52)" />
              <path d="M100 144.5l48.4 35.7c5.6 3.1 9.6 1.5 11-5.2l19.5-92c2-8.3-3.2-12-8.6-9.6L24.8 111c-8 3.2-8 7.7-1.4 9.7l37.4 11.7 86.8-54.8c4.1-2.5 7.8-1.2 4.7 1.6" fill="#ffffff" />
            </svg>
          </div>
          <div class="promo-front-info">
            <div class="promo-title-row">
              <span class="promo-title">{finalConfig.title}</span>
              <span class="promo-badge">{platformConfigs[platform].badge}</span>
            </div>
            <div class="promo-subtitle">{finalConfig.subtitle}</div>
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- BACK FACE: 完整设计的正向展示扫码后板         -->
      <!-- ============================================== -->
      <div
        class="face back-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感：背面对应微透天文同心星轨底纹 (0 闪烁杂星，0 十字光刺) -->
        <div class="promo-scene-art promo-scene-art--back promo-watermark promo-watermark--back" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g class="celestial-wheel-back">
              {backStarTrails.map((trail) => (
                <path
                  d={trail.d}
                  fill="none"
                  stroke={trail.color}
                  stroke-width={trail.strokeWidth}
                  opacity={trail.opacity}
                  stroke-linecap="round"
                />
              ))}
            </g>
          </svg>
        </div>

        <!-- 背面主体左右网格布局 -->
        <div class="promo-back-grid">
          <!-- 左侧文字说明与快捷按钮 -->
          <div class="promo-back-left">
            <div class="promo-back-title">{finalConfig.backTitle}</div>
            <div class="promo-back-subtitle">{finalConfig.backSubtitle}</div>
            <div class="promo-cta-action">
              <a
                href={finalConfig.href}
                target="_blank"
                rel="noopener noreferrer"
                class="promo-cta-btn"
                onclick="event.stopPropagation();"
              >
                <span>{platformConfigs[platform].ctaText}</span>
                <span class="cta-arrow">&nearr;</span>
              </a>
            </div>
          </div>

          <!-- 右侧内嵌高清矢量二维码 -->
          <div class="promo-qr-chassis">
            <div class="promo-qr-wrapper">
              <img
                src={embeddedQrDataUrl}
                alt={`${finalConfig.title} 二维码`}
                class="promo-qr-img"
                loading="eager"
                decoding="sync"
              />
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .promo-widget {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    padding: 0 !important;
    border: none;
    height: 114px;
    border-radius: 8px;
    margin: 0 !important;
    overflow: visible !important;
    cursor: pointer;
  }

  #flip-wrapper {
    -webkit-perspective: 1000px;
    perspective: 1000px;
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    /* 核心：方案A 极光四阶多色域流体渐变 (皇家宝蓝 -> 电光蓝 -> 晴空蓝 -> 湖绿青) */
    --promo-bg-gradient: 
      radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.35) 0%, transparent 40%),
      radial-gradient(circle at 92% 82%, rgba(6, 182, 212, 0.45) 0%, transparent 45%),
      linear-gradient(135deg, #1d4ed8 0%, #2563eb 38%, #0284c7 72%, #06b6d4 100%);
    --promo-card-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.38), 0 2px 6px rgba(0, 0, 0, 0.05);
    --promo-border-color: rgba(255, 255, 255, 0.48);
  }

  :global([data-theme="dark"]) #flip-wrapper {
    --promo-bg-gradient: 
      radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.15) 0%, transparent 40%),
      radial-gradient(circle at 92% 82%, rgba(6, 182, 212, 0.25) 0%, transparent 45%),
      linear-gradient(135deg, #0f172a 0%, #1e3a8a 38%, #1d4ed8 72%, #0369a1 100%);
    --promo-card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6), 0 2px 6px rgba(0, 0, 0, 0.4);
    --promo-border-color: rgba(255, 255, 255, 0.22);
  }

  #flip-content {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .face {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    box-sizing: border-box !important;
    border-radius: 8px;
    background: var(--promo-bg-gradient);
    border: 1px solid var(--promo-border-color);
    box-shadow: var(--promo-card-shadow);
    color: #ffffff;
    overflow: hidden;
    padding: 12px 16px !important;
    display: flex !important;
    align-items: center !important;
    -webkit-backface-visibility: hidden !important;
    backface-visibility: hidden !important;
    /* 核心动画优化：0.85s 从容丝滑缓动曲线 */
    transition: transform 0.85s cubic-bezier(0.25, 1, 0.35, 1), opacity 0.35s ease, visibility 0.35s ease;
    will-change: transform, opacity;
  }

  /* 正面板：默认正对用户 (0deg) */
  .front-face {
    -webkit-transform: rotateY(0deg) !important;
    transform: rotateY(0deg) !important;
    z-index: 2;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* 背面板：默认背对用户 (-180deg) */
  .back-face {
    -webkit-transform: rotateY(-180deg) !important;
    transform: rotateY(-180deg) !important;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* 悬停或聚焦时：正面翻出 (180deg) 且淡出；背面翻入正向 (0deg) 且显现 */
  .promo-widget:hover .front-face,
  .promo-widget:focus-within .front-face,
  #flip-wrapper:hover .front-face {
    -webkit-transform: rotateY(180deg) !important;
