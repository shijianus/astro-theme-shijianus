---
import { siteConfig } from '../../config/site';

interface Props {
  id?: string;
  className?: string;
  platform?: 'telegram' | 'wechat' | 'facebook' | 'whatsapp';
  config?: {
    href: string;
    qrImage: string;
    title: string;
    subtitle: string;
    backTitle?: string;
    backSubtitle?: string;
    qrCrop?: {
      enable: boolean;
      scale?: number;
      offsetX?: string;
      offsetY?: string;
    };
  };
}

const {
  id = 'promo-widget',
  className = '',
  platform = 'telegram',
} = Astro.props;

const defaultCopy = {
  telegram: {
    title: 'Telegram',
    subtitle: '专注隐私传播。海外更新、测试第一时间获取。',
    backTitle: '扫码加入',
    backSubtitle: '无缝安全交流'
  },
  wechat: {
    title: 'WeChat',
    subtitle: '微信公众号。快人一步获取最新文章与动态。',
    backTitle: '扫一扫关注',
    backSubtitle: '不错过精彩内容'
  },
  facebook: {
    title: 'Facebook',
    subtitle: '开放社群。加入我们，结识千万同好畅所欲言。',
    backTitle: '扫码关注主页',
    backSubtitle: '探索更多可能'
  },
  whatsapp: {
    title: 'WhatsApp',
    subtitle: '快捷简单安全。即刻加入，随时保持密切联系。',
    backTitle: '扫码添加联系',
    backSubtitle: '开启即时通讯'
  }
};

const platformConfigs = {
  telegram: {
    href: siteConfig.aside.telegramWidget?.href || '#',
    qrImage: siteConfig.aside.telegramWidget?.qrImage || '',
    title: siteConfig.aside.telegramWidget?.title || defaultCopy.telegram.title,
    subtitle: siteConfig.aside.telegramWidget?.subtitle || defaultCopy.telegram.subtitle,
    backTitle: siteConfig.aside.telegramWidget?.backLabel || defaultCopy.telegram.backTitle,
    backSubtitle: siteConfig.aside.telegramWidget?.summary || defaultCopy.telegram.backSubtitle,
    qrCrop: siteConfig.aside.telegramWidget?.qrCrop,
    iconPath: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z'
  },
  wechat: {
    href: '#', 
    qrImage: '',
    title: defaultCopy.wechat.title,
    subtitle: defaultCopy.wechat.subtitle,
    backTitle: defaultCopy.wechat.backTitle,
    backSubtitle: defaultCopy.wechat.backSubtitle,
    iconPath: 'M17.333 11.333c0-3.313-3.284-6-7.333-6S2.667 8.02 2.667 11.333c0 1.84 1.01 3.486 2.63 4.545l-.697 2.121 2.502-1.252c.904.254 1.88.386 2.9.386 4.049 0 7.331-2.687 7.331-6zm-9.333-1.333a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm5.333 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm8 4c0-2.576-2.537-4.667-5.667-4.667-.113 0-.223.006-.333.013.432.842.667 1.776.667 2.766 0 3.864-3.731 7-8.333 7-.53 0-1.045-.038-1.543-.109 1.155 1.583 3.324 2.664 5.876 2.664.815 0 1.595-.106 2.324-.31l2.001 1.002-.558-1.697c1.296-.847 2.103-2.163 2.103-3.636zm-3.666-.667a.833.833 0 1 1-1.667 0 .833.833 0 0 1 1.667 0zm-4.334 0a.833.833 0 1 1-1.667 0 .833.833 0 0 1 1.667 0z'
  },
  whatsapp: {
    href: '#',
    qrImage: '',
    title: defaultCopy.whatsapp.title,
    subtitle: defaultCopy.whatsapp.subtitle,
    backTitle: defaultCopy.whatsapp.backTitle,
    backSubtitle: defaultCopy.whatsapp.backSubtitle,
    iconPath: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01a1.096 1.096 0 0 0-.792.371c-.297.322-1.139 1.114-1.139 2.716s1.164 3.146 1.337 3.37c.173.223 2.302 3.518 5.577 4.935 2.187.947 2.923.8 3.541.748.723-.06 2.303-.941 2.625-1.849.322-.909.322-1.688.223-1.849-.099-.161-.371-.247-.669-.396zM12 21.6A9.6 9.6 0 0 1 3.731 16.7l-1.312 4.79 4.908-1.288A9.553 9.553 0 0 1 12 21.6c5.3 0 9.6-4.3 9.6-9.6S17.3 2.4 12 2.4 2.4 6.7 2.4 12c0 1.676.433 3.25 1.196 4.593L2.4 21.6l5.132-1.35A9.57 9.57 0 0 0 12 21.6z'
  },
  facebook: {
    href: '#',
    qrImage: '',
    title: defaultCopy.facebook.title,
    subtitle: defaultCopy.facebook.subtitle,
    backTitle: defaultCopy.facebook.backTitle,
    backSubtitle: defaultCopy.facebook.backSubtitle,
    iconPath: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z'
  }
};

const finalConfig = Astro.props.config || platformConfigs[platform];
const iconPath = platformConfigs[platform].iconPath;

const isCropEnabled = finalConfig.qrCrop?.enable ?? false;
const qrScale = isCropEnabled ? (finalConfig.qrCrop?.scale || 1.0) : 1.0;
const qrOffsetX = isCropEnabled ? (finalConfig.qrCrop?.offsetX || '0px') : '0px';
const qrOffsetY = isCropEnabled ? (finalConfig.qrCrop?.offsetY || '0px') : '0px';

// JSON encode the themes to pass them safely to the client script
const themesJson = JSON.stringify({
  telegram: [
    { bg: 'linear-gradient(135deg, #1cb5e0 0%, #000851 100%)', textLight: '#89f7fe', badgeBg: 'rgba(28, 181, 224, 0.3)', badgeText: '#89f7fe' },
    { bg: 'linear-gradient(to right, #00c6ff 0%, #0072ff 100%)', textLight: '#e0c3fc', badgeBg: 'rgba(0, 198, 255, 0.3)', badgeText: '#e0c3fc' },
    { bg: 'linear-gradient(to right, #4facfe 0%, #00f2fe 100%)', textLight: '#fdfbfb', badgeBg: 'rgba(79, 172, 254, 0.3)', badgeText: '#fff' }
  ],
  wechat: [
    { bg: 'linear-gradient(135deg, #07c160 0%, #036b35 100%)', textLight: '#d4fc79', badgeBg: 'rgba(7, 193, 96, 0.4)', badgeText: '#d4fc79' },
    { bg: 'linear-gradient(to right, #11998e 0%, #38ef7d 100%)', textLight: '#fdfbfb', badgeBg: 'rgba(56, 239, 125, 0.3)', badgeText: '#fff' },
    { bg: 'linear-gradient(to right, #00b09b 0%, #96c93d 100%)', textLight: '#e2ebf0', badgeBg: 'rgba(0, 176, 155, 0.3)', badgeText: '#e2ebf0' }
  ],
  whatsapp: [
    { bg: 'linear-gradient(135deg, #25d366 0%, #128c7e 100%)', textLight: '#d4fc79', badgeBg: 'rgba(37, 211, 102, 0.4)', badgeText: '#d4fc79' },
    { bg: 'linear-gradient(to right, #11998e 0%, #38ef7d 100%)', textLight: '#fdfbfb', badgeBg: 'rgba(17, 153, 142, 0.4)', badgeText: '#fff' },
    { bg: 'linear-gradient(to right, #00b09b 0%, #96c93d 100%)', textLight: '#e2ebf0', badgeBg: 'rgba(0, 176, 155, 0.4)', badgeText: '#e2ebf0' }
  ],
  facebook: [
    { bg: 'linear-gradient(135deg, #1877f2 0%, #0e458e 100%)', textLight: '#a1c4fd', badgeBg: 'rgba(24, 119, 242, 0.4)', badgeText: '#a1c4fd' },
    { bg: 'linear-gradient(to right, #3a7bd5 0%, #3a6073 100%)', textLight: '#e2ebf0', badgeBg: 'rgba(58, 123, 213, 0.4)', badgeText: '#e2ebf0' },
    { bg: 'linear-gradient(to right, #2b5876 0%, #4e4376 100%)', textLight: '#fdfbfb', badgeBg: 'rgba(78, 67, 118, 0.4)', badgeText: '#fff' }
  ]
});
---

<div class:list={['card-widget promo-widget', className]} id={id}>
  <div id="flip-wrapper" data-platform={platform} data-themes={themesJson}>
    <div id="flip-content">
      
      <!-- Front Face -->
      <div class="face front-face" onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}>
        <!-- Cybernetic Grid & Circuit Matrix SVG Background -->
        <div class="promo-tech-canvas" aria-hidden="true">
          <svg class="tech-grid-svg" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <pattern id={`tech-grid-dots-${id}`} width="18" height="18" patternUnits="userSpaceOnUse">
                <circle cx="2" cy="2" r="0.75" fill="rgba(255, 255, 255, 0.22)" />
              </pattern>
              <linearGradient id={`tech-trace-grad-${id}`} x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="rgba(255, 255, 255, 0)" />
                <stop offset="35%" stop-color="rgba(255, 255, 255, 0.35)" />
                <stop offset="70%" stop-color="rgba(137, 247, 254, 0.45)" />
                <stop offset="100%" stop-color="rgba(255, 255, 255, 0)" />
              </linearGradient>
            </defs>
            <rect width="100%" height="100%" fill={`url(#tech-grid-dots-${id})`} opacity="0.8" />
            <path d="M 0 32 L 65 32 L 90 56 L 180 56 L 205 82 L 340 82" stroke={`url(#tech-trace-grad-${id})`} stroke-width="1.2" fill="none" />
            <path d="M 130 12 L 165 12 L 185 32 L 270 32" stroke={`url(#tech-trace-grad-${id})`} stroke-width="0.8" fill="none" opacity="0.6" />
            <circle cx="90" cy="56" r="2" fill="rgba(137, 247, 254, 0.85)" />
            <circle cx="180" cy="56" r="2" fill="rgba(137, 247, 254, 0.85)" />
          </svg>
          <div class="hud-crosshair hud-ch-tl">+</div>
          <div class="hud-crosshair hud-ch-br">+</div>
          <div class="hud-tag hud-tag-bottom">[SECURE CHANNEL // ENCRYPTED]</div>
        </div>

        <!-- Theme Toggle Button (Mode chip) -->
        <button class="theme-toggle-btn" aria-label="切换色调" onclick="event.stopPropagation(); window.togglePromoTheme(this)">
          <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
        </button>

        <!-- High-Tech Radar Compass & Watermark Vector Art -->
        <div class="promo-radar-watermark" aria-hidden="true">
          <svg viewBox="0 0 160 160" width="160" height="160" fill="none" stroke="currentColor">
            <circle cx="80" cy="80" r="72" stroke="rgba(255,255,255,0.12)" stroke-width="1" stroke-dasharray="4 4" />
            <circle cx="80" cy="80" r="54" stroke="rgba(255,255,255,0.18)" stroke-width="1" />
            <circle cx="80" cy="80" r="36" stroke="rgba(255,255,255,0.10)" stroke-width="1" stroke-dasharray="2 3" />
            <line x1="80" y1="4" x2="80" y2="156" stroke="rgba(255,255,255,0.14)" stroke-width="0.8" />
            <line x1="4" y1="80" x2="156" y2="80" stroke="rgba(255,255,255,0.14)" stroke-width="0.8" />
            <path d="M 80 80 L 132 46" stroke="rgba(137,247,254,0.4)" stroke-width="1.2" />
            <g transform="translate(48, 48) scale(2.6)" fill="rgba(255,255,255,0.14)">
              <path d={iconPath} />
            </g>
          </svg>
        </div>

        <div class="promo-content">
          <!-- Holographic Cyber Orb with Glow Ring -->
          <div class="promo-icon-cyber-wrap">
            <div class="promo-icon-ring"></div>
            <div class="promo-icon">
              <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor">
                <path d={iconPath} />
              </svg>
            </div>
          </div>
          <div class="promo-text">
            <div class="promo-title-wrapper">
              <span class="promo-title">{finalConfig.title}</span>
              <div class="promo-status-badge">
                <span class="status-pulse-dot"></span>
                <span class="promo-badge">ONLINE</span>
              </div>
            </div>
            <div class="promo-subtitle">{finalConfig.subtitle}</div>
          </div>
        </div>
      </div>

      <!-- Back Face -->
      <div class="back face back-face" onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}>
        <!-- Cyber Tech Mesh Background -->
        <div class="promo-tech-canvas" aria-hidden="true">
          <svg class="tech-grid-svg" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <rect width="100%" height="100%" fill={`url(#tech-grid-dots-${id})`} opacity="0.6" />
            <path d="M 0 75 L 70 75 L 95 95 L 340 95" stroke={`url(#tech-trace-grad-${id})`} stroke-width="1" fill="none" opacity="0.4" />
          </svg>
          <div class="hud-tag hud-tag-top">[COMM MATRIX // 256-BIT]</div>
        </div>

        <div class="promo-back-grid">
          <div class="promo-back-info">
            <div class="promo-back-channel-tag">
              <span class="channel-dot"></span>
              <span>{siteConfig.aside.telegramWidget?.handle || '@chronoral'}</span>
            </div>
            <div class="promo-back-title">{finalConfig.backTitle}</div>
            <div class="promo-back-subtitle">{finalConfig.backSubtitle}</div>
            <div class="promo-cta-wrapper">
              <span class="promo-cta-btn">
                <span class="promo-cta-text">立即加入</span>
                <span class="promo-cta-arrow">&rarr;</span>
              </span>
            </div>
          </div>

          <!-- Embedded Complete QR Matrix with Cyber HUD Reticle -->
          <div class="promo-qr-hud-box">
            <span class="hud-corner-bracket bracket-tl"></span>
            <span class="hud-corner-bracket bracket-tr"></span>
            <span class="hud-corner-bracket bracket-bl"></span>
            <span class="hud-corner-bracket bracket-br"></span>
            <div class="promo-qr-container">
              <img
                src={finalConfig.qrImage}
                alt={`${finalConfig.title} QR Code`}
                class="promo-qr-img"
                loading="eager"
                decoding="async"
                style={isCropEnabled ? `transform: scale(${qrScale}) translate(${qrOffsetX}, ${qrOffsetY});` : undefined}
              />
            </div>
            <div class="hud-qr-scan-bar">
              <span>扫码直连</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script is:inline>
  window.togglePromoTheme = function(btn) {
    const wrapper = btn.closest('#flip-wrapper');
    if (!wrapper) return;
    
    const platform = wrapper.getAttribute('data-platform');
    const themesStr = wrapper.getAttribute('data-themes');
    if (!platform || !themesStr) return;

    try {
      const themes = JSON.parse(themesStr);
      const platformThemes = themes[platform];
      if (!platformThemes || platformThemes.length === 0) return;

      let currentIndex = parseInt(wrapper.getAttribute('data-theme-idx') || '0', 10);
      currentIndex = (currentIndex + 1) % platformThemes.length;
      
      const theme = platformThemes[currentIndex];
      wrapper.style.setProperty('--promo-bg-gradient', theme.bg);
      wrapper.style.setProperty('--promo-text-light', theme.textLight);
      wrapper.style.setProperty('--promo-badge-bg', theme.badgeBg);
      wrapper.style.setProperty('--promo-badge-text', theme.badgeText);
      wrapper.setAttribute('data-theme-idx', currentIndex.toString());
    } catch(e) {
      console.error('Failed to parse promo themes', e);
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('#flip-wrapper').forEach(wrapper => {
      const platform = wrapper.getAttribute('data-platform');
      const themesStr = wrapper.getAttribute('data-themes');
      if (platform && themesStr) {
        try {
          const themes = JSON.parse(themesStr);
          if (themes[platform] && themes[platform].length > 0) {
            const theme = themes[platform][0];
            wrapper.style.setProperty('--promo-bg-gradient', theme.bg);
            wrapper.style.setProperty('--promo-text-light', theme.textLight);
            wrapper.style.setProperty('--promo-badge-bg', theme.badgeBg);
            wrapper.style.setProperty('--promo-badge-text', theme.badgeText);
          }
        } catch (e) {}
      }
    });
  });
</script>

<style>
  .promo-widget {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    padding: 0 !important;
    border: none;
    height: 120px;
    border-radius: 8px;
    box-shadow: var(--card-box-shadow);
    color: #fff;
    overflow: visible !important;
    margin: 0 !important;
  }
  
  :global([data-theme="dark"]) .promo-widget {
    background: transparent;
    border: none;
  }

  #flip-wrapper {
    -webkit-perspective: 1000px;
    perspective: 1000px;
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    box-sizing: border-box;
    border-radius: 8px;
    z-index: 1;
    /* Defaults */
    --promo-bg-gradient: linear-gradient(135deg, #1cb5e0 0%, #000851 100%);
    --promo-text-light: #89f7fe;
    --promo-badge-bg: rgba(28, 181, 224, 0.3);
    --promo-badge-text: #89f7fe;
  }
  
  #flip-content {
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    box-sizing: border-box;
    -webkit-transform-style: preserve-3d;
    transform-style: preserve-3d;
    transition: transform 0.65s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform;
    border-radius: 8px;
  }
  
  .face {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    box-sizing: border-box !important;
    -webkit-backface-visibility: hidden !important;
    backface-visibility: hidden !important;
    -webkit-transform-style: preserve-3d;
    transform-style: preserve-3d;
    border-radius: 8px;
    cursor: pointer;
    overflow: hidden;
    background-image: var(--promo-bg-gradient);
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Cybernetic Background Canvas & HUD */
  .promo-tech-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .tech-grid-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hud-crosshair {
    position: absolute;
    font-family: monospace, ui-monospace, sans-serif;
    font-size: 11px;
    line-height: 1;
    color: var(--promo-text-light);
    opacity: 0.45;
    pointer-events: none;
  }

  .hud-ch-tl {
    top: 6px;
    left: 8px;
  }

  .hud-ch-br {
    bottom: 6px;
    right: 8px;
  }

  .hud-tag {
    position: absolute;
    font-family: monospace, ui-monospace, monospace;
    font-size: 7.5px;
    letter-spacing: 0.8px;
    color: var(--promo-text-light);
    opacity: 0.55;
    pointer-events: none;
  }

  .hud-tag-bottom {
    bottom: 6px;
    left: 18px;
  }

  .hud-tag-top {
    top: 6px;
    left: 14px;
  }

  .theme-toggle-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 6px;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    cursor: pointer;
    z-index: 10;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .theme-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.28);
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.4);
    transform: rotate(90deg);
  }

  .promo-radar-watermark {
    position: absolute;
    right: -28px;
    bottom: -28px;
    width: 156px;
    height: 156px;
    opacity: 0.35;
    z-index: 0;
    pointer-events: none;
    transform: rotate(-10deg);
  }
  
  .front-face {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    z-index: 2;
    transform: rotateY(0deg) translateZ(1px) !important;
    -webkit-transform: rotateY(0deg) translateZ(1px) !important;
  }
  
  .promo-content {
    display: flex;
    align-items: center;
    padding: 0 1.15rem;
    gap: 0.95rem;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    z-index: 2;
  }
  
  .promo-icon-cyber-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
