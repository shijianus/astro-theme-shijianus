---
import QRCode from 'qrcode';
import { siteConfig } from '../../config/site';

interface Props {
  id?: string;
  className?: string;
  platform?: 'telegram' | 'wechat' | 'facebook' | 'whatsapp';
  config?: {
    href: string;
    qrImage: string;
    title: string;
    subtitle: string;
    backTitle?: string;
    backSubtitle?: string;
    qrCrop?: {
      enable: boolean;
      scale?: number;
      offsetX?: string;
      offsetY?: string;
    };
  };
}

const {
  id = 'promo-widget',
  className = '',
  platform = 'telegram',
} = Astro.props;

const defaultCopy = {
  telegram: {
    title: 'Telegram',
    subtitle: '专注隐私传播。海外更新、测试第一时间获取。',
    backTitle: '扫码直连社群',
    backSubtitle: '无缝安全交流 · 极客动态首发'
  },
  wechat: {
    title: 'WeChat',
    subtitle: '微信公众号。快人一步获取最新文章与动态。',
    backTitle: '扫一扫关注',
    backSubtitle: '不错过精彩内容 · 微信动态订阅'
  },
  facebook: {
    title: 'Facebook',
    subtitle: '开放社群。加入我们，结识千万同好畅所欲言。',
    backTitle: '扫码关注主页',
    backSubtitle: '探索更多可能 · 开放社群交流'
  },
  whatsapp: {
    title: 'WhatsApp',
    subtitle: '快捷简单安全。即刻加入，随时保持密切联系。',
    backTitle: '扫码添加联系',
    backSubtitle: '开启即时通讯 · 保持密切连结'
  }
};

const platformConfigs = {
  telegram: {
    href: siteConfig.aside.telegramWidget?.href || '#',
    qrImage: siteConfig.aside.telegramWidget?.qrImage || '',
    title: siteConfig.aside.telegramWidget?.title || defaultCopy.telegram.title,
    subtitle: siteConfig.aside.telegramWidget?.subtitle || defaultCopy.telegram.subtitle,
    backTitle: siteConfig.aside.telegramWidget?.backLabel || defaultCopy.telegram.backTitle,
    backSubtitle: siteConfig.aside.telegramWidget?.summary || defaultCopy.telegram.backSubtitle,
    qrCrop: siteConfig.aside.telegramWidget?.qrCrop,
    iconPath: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z'
  },
  wechat: {
    href: '#', 
    qrImage: '',
    title: defaultCopy.wechat.title,
    subtitle: defaultCopy.wechat.subtitle,
    backTitle: defaultCopy.wechat.backTitle,
    backSubtitle: defaultCopy.wechat.backSubtitle,
    iconPath: 'M17.333 11.333c0-3.313-3.284-6-7.333-6S2.667 8.02 2.667 11.333c0 1.84 1.01 3.486 2.63 4.545l-.697 2.121 2.502-1.252c.904.254 1.88.386 2.9.386 4.049 0 7.331-2.687 7.331-6zm-9.333-1.333a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm5.333 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm8 4c0-2.576-2.537-4.667-5.667-4.667-.113 0-.223.006-.333.013.432.842.667 1.776.667 2.766 0 3.864-3.731 7-8.333 7-.53 0-1.045-.038-1.543-.109 1.155 1.583 3.324 2.664 5.876 2.664.815 0 1.595-.106 2.324-.31l2.001 1.002-.558-1.697c1.296-.847 2.103-2.163 2.103-3.636zm-3.666-.667a.833.833 0 1 1-1.667 0 .833.833 0 0 1 1.667 0zm-4.334 0a.833.833 0 1 1-1.667 0 .833.833 0 0 1 1.667 0z'
  },
  whatsapp: {
    href: '#',
    qrImage: '',
    title: defaultCopy.whatsapp.title,
    subtitle: defaultCopy.whatsapp.subtitle,
    backTitle: defaultCopy.whatsapp.backTitle,
    backSubtitle: defaultCopy.whatsapp.backSubtitle,
    iconPath: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01a1.096 1.096 0 0 0-.792.371c-.297.322-1.139 1.114-1.139 2.716s1.164 3.146 1.337 3.37c.173.223 2.302 3.518 5.577 4.935 2.187.947 2.923.8 3.541.748.723-.06 2.303-.941 2.625-1.849.322-.909.322-1.688.223-1.849-.099-.161-.371-.247-.669-.396zM12 21.6A9.6 9.6 0 0 1 3.731 16.7l-1.312 4.79 4.908-1.288A9.553 9.553 0 0 1 12 21.6c5.3 0 9.6-4.3 9.6-9.6S17.3 2.4 12 2.4 2.4 6.7 2.4 12c0 1.676.433 3.25 1.196 4.593L2.4 21.6l5.132-1.35A9.57 9.57 0 0 0 12 21.6z'
  },
  facebook: {
    href: '#',
    qrImage: '',
    title: defaultCopy.facebook.title,
    subtitle: defaultCopy.facebook.subtitle,
    backTitle: defaultCopy.facebook.backTitle,
    backSubtitle: defaultCopy.facebook.backSubtitle,
    iconPath: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z'
  }
};

const finalConfig = Astro.props.config || platformConfigs[platform];
const iconPath = platformConfigs[platform].iconPath;

// Generate truly embedded high-resolution vector QR Code and data URI
let embeddedQrDataUrl = '';
try {
  embeddedQrDataUrl = await QRCode.toDataURL(finalConfig.href, {
    margin: 1,
    width: 256,
    color: {
      dark: '#030816',
      light: '#ffffff'
    },
    errorCorrectionLevel: 'M'
  });
} catch (e) {
  console.error('Failed to generate embedded QR code', e);
  embeddedQrDataUrl = finalConfig.qrImage || '';
}

// JSON encode themes for client-side mode toggling
const themesJson = JSON.stringify({
  telegram: [
    { bg: 'linear-gradient(135deg, #0b1a30 0%, #00122e 45%, #05244f 100%)', textLight: '#00f2fe', badgeBg: 'rgba(0, 242, 254, 0.18)', badgeText: '#00f2fe', accentGlow: '#00f2fe' },
    { bg: 'linear-gradient(135deg, #0d1b2a 0%, #1b263b 50%, #003566 100%)', textLight: '#80ed99', badgeBg: 'rgba(128, 237, 153, 0.18)', badgeText: '#80ed99', accentGlow: '#80ed99' },
    { bg: 'linear-gradient(135deg, #1f1035 0%, #0f0c29 50%, #24243e 100%)', textLight: '#f72585', badgeBg: 'rgba(247, 37, 133, 0.22)', badgeText: '#ff70a6', accentGlow: '#f72585' }
  ],
  wechat: [
    { bg: 'linear-gradient(135deg, #041c10 0%, #022c19 50%, #074728 100%)', textLight: '#25d366', badgeBg: 'rgba(37, 211, 102, 0.2)', badgeText: '#25d366', accentGlow: '#25d366' },
    { bg: 'linear-gradient(135deg, #0a2318 0%, #113f28 50%, #0d5c38 100%)', textLight: '#a7f3d0', badgeBg: 'rgba(167, 243, 208, 0.2)', badgeText: '#a7f3d0', accentGlow: '#34d399' }
  ],
  whatsapp: [
    { bg: 'linear-gradient(135deg, #042017 0%, #063829 50%, #0a4f3b 100%)', textLight: '#25d366', badgeBg: 'rgba(37, 211, 102, 0.2)', badgeText: '#25d366', accentGlow: '#25d366' }
  ],
  facebook: [
    { bg: 'linear-gradient(135deg, #0a1733 0%, #0d2857 50%, #154080 100%)', textLight: '#60a5fa', badgeBg: 'rgba(96, 165, 250, 0.2)', badgeText: '#60a5fa', accentGlow: '#3b82f6' }
  ]
});
---

<div class:list={['card-widget promo-widget', className]} id={id}>
  <div id="flip-wrapper" data-platform={platform} data-themes={themesJson}>
    <div id="flip-content">
      
      <!-- ============================================== -->
      <!-- FRONT FACE: Cyber Holographic Interface        -->
      <!-- ============================================== -->
      <div
        class="face front-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- Background Cyber Mesh & Vector Circuit Canvas -->
        <div class="promo-tech-canvas" aria-hidden="true">
          <svg class="tech-grid-svg" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <pattern id={`tech-grid-dots-${id}`} width="16" height="16" patternUnits="userSpaceOnUse">
                <circle cx="2" cy="2" r="0.75" fill="rgba(0, 242, 254, 0.25)" />
              </pattern>
              <linearGradient id={`tech-trace-grad-${id}`} x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="rgba(0, 242, 254, 0)" />
                <stop offset="40%" stop-color="rgba(0, 242, 254, 0.45)" />
                <stop offset="80%" stop-color="rgba(255, 255, 255, 0.65)" />
                <stop offset="100%" stop-color="rgba(0, 242, 254, 0)" />
              </linearGradient>
            </defs>
            <rect width="100%" height="100%" fill={`url(#tech-grid-dots-${id})`} />
            <!-- High-Tech Circuit Traces -->
            <path d="M 0 28 L 70 28 L 95 48 L 180 48 L 205 72 L 360 72" stroke={`url(#tech-trace-grad-${id})`} stroke-width="1.2" fill="none" />
            <path d="M 120 14 L 160 14 L 180 32 L 290 32" stroke={`url(#tech-trace-grad-${id})`} stroke-width="0.8" fill="none" opacity="0.6" />
            <circle cx="95" cy="48" r="2.2" fill="var(--promo-text-light, #00f2fe)" />
            <circle cx="205" cy="72" r="2.2" fill="var(--promo-text-light, #00f2fe)" />
          </svg>
        </div>

        <!-- High-Tech Radar Compass & Huge Vector Watermark -->
        <div class="promo-radar-watermark" aria-hidden="true">
          <svg viewBox="0 0 160 160" width="160" height="160" fill="none" stroke="currentColor">
            <circle cx="80" cy="80" r="74" stroke="rgba(0, 242, 254, 0.15)" stroke-width="1" stroke-dasharray="4 4" />
            <circle cx="80" cy="80" r="56" stroke="rgba(0, 242, 254, 0.22)" stroke-width="1" />
            <circle cx="80" cy="80" r="38" stroke="rgba(0, 242, 254, 0.12)" stroke-width="1" stroke-dasharray="2 3" />
            <line x1="80" y1="2" x2="80" y2="158" stroke="rgba(0, 242, 254, 0.15)" stroke-width="0.8" />
            <line x1="2" y1="80" x2="158" y2="80" stroke="rgba(0, 242, 254, 0.15)" stroke-width="0.8" />
            <path d="M 80 80 L 138 42" stroke="rgba(0, 242, 254, 0.45)" stroke-width="1.2" />
            <g transform="translate(46, 46) scale(2.8)" fill="rgba(255, 255, 255, 0.12)">
              <path d={iconPath} />
            </g>
          </svg>
        </div>

        <!-- Top Telemetry Status Header -->
        <div class="hud-top-bar">
          <div class="hud-band-badge">
            <span class="hud-node-dot"></span>
            <span class="hud-node-text">[CHRONORAL // PROTO-V2]</span>
          </div>

          <!-- Dynamic Waveform Equalizer Bars -->
          <div class="hud-waveform-bars" aria-hidden="true">
            <span class="eq-bar eq-bar-1"></span>
            <span class="eq-bar eq-bar-2"></span>
            <span class="eq-bar eq-bar-3"></span>
            <span class="eq-bar eq-bar-4"></span>
          </div>

          <div class="hud-header-controls">
            <!-- Theme Mode Chip Button -->
            <button
              class="theme-toggle-btn"
              aria-label="切换色调"
              onclick="event.stopPropagation(); window.togglePromoTheme(this)"
              title="切换极客频谱"
            >
              <svg viewBox="0 0 24 24" width="13" height="13" stroke="currentColor" stroke-width="2" fill="none">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
              </svg>
            </button>
            <div class="status-pulse-wrapper">
              <span class="status-pulse-dot"></span>
              <span class="status-pulse-label">LIVE</span>
            </div>
          </div>
        </div>

        <!-- Main Body: Hologram Crest + Typography -->
        <div class="promo-main-body">
          <div class="promo-icon-cyber-wrap">
            <div class="promo-icon-orbit-ring"></div>
            <div class="promo-icon-inner-glow"></div>
            <div class="promo-icon">
              <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
                <path d={iconPath} />
              </svg>
            </div>
          </div>
          <div class="promo-info-col">
            <div class="promo-title-row">
              <span class="promo-title">{finalConfig.title}</span>
              <span class="promo-chip-badge">OFFICIAL</span>
            </div>
            <div class="promo-desc">{finalConfig.subtitle}</div>
          </div>
        </div>

        <!-- Bottom HUD Tracking Footer -->
        <div class="hud-bottom-tracker">
          <span class="hud-tracker-label">⚡ HOVER TO DECRYPT QR // 悬停开启量子二维码</span>
          <span class="hud-tracker-arrow">&rarr;</span>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- BACK FACE: Holographic Quantum Scanner Pod     -->
      <!-- ============================================== -->
      <div
        class="back face back-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- Background Tech Grid -->
        <div class="promo-tech-canvas" aria-hidden="true">
          <svg class="tech-grid-svg" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
            <rect width="100%" height="100%" fill={`url(#tech-grid-dots-${id})`} opacity="0.4" />
            <path d="M 0 90 L 90 90 L 115 110 L 360 110" stroke={`url(#tech-trace-grad-${id})`} stroke-width="0.9" fill="none" opacity="0.3" />
          </svg>
        </div>

        <!-- Back Header -->
        <div class="hud-back-header">
          <div class="hud-back-tag">
            <span class="hud-scan-pulse"></span>
            <span>[SCANNER POD // {siteConfig.aside.telegramWidget?.handle || '@chronoral'}]</span>
          </div>
          <span class="hud-crypto-badge">AES-256</span>
        </div>

        <!-- Back Main Content -->
        <div class="promo-back-grid">
          <div class="promo-back-console">
            <div class="promo-back-title">{finalConfig.backTitle}</div>
            <div class="promo-back-subtitle">{finalConfig.backSubtitle}</div>
            <div class="promo-cta-action">
              <span class="promo-uplink-btn">
                <span class="uplink-dot"></span>
                <span class="uplink-text">立即加入</span>
                <span class="uplink-arrow">&nearr;</span>
              </span>
            </div>
          </div>

          <!-- Embedded High-Definition Vector QR Matrix Chamber -->
          <div class="promo-qr-hud-box">
            <!-- 4 Corner Reticle Brackets -->
            <span class="hud-corner-bracket bracket-tl"></span>
            <span class="hud-corner-bracket bracket-tr"></span>
            <span class="hud-corner-bracket bracket-bl"></span>
            <span class="hud-corner-bracket bracket-br"></span>

            <!-- Animated Laser Scanline Effect -->
            <div class="hud-laser-scanline" aria-hidden="true"></div>

            <!-- Truly Embedded QR Code Container -->
            <div class="promo-qr-container">
              <img
                src={embeddedQrDataUrl}
                alt={`${finalConfig.title} Embedded Vector QR Code`}
                class="promo-qr-img"
                loading="eager"
                decoding="sync"
              />
            </div>

            <div class="hud-qr-scan-bar">
              <span>SCAN TO JOIN</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script is:inline>
  window.togglePromoTheme = function(btn) {
    const wrapper = btn.closest('#flip-wrapper');
    if (!wrapper) return;
    
    const platform = wrapper.getAttribute('data-platform');
    const themesStr = wrapper.getAttribute('data-themes');
    if (!platform || !themesStr) return;

    try {
      const themes = JSON.parse(themesStr);
      const platformThemes = themes[platform];
      if (!platformThemes || platformThemes.length === 0) return;

      let currentIndex = parseInt(wrapper.getAttribute('data-theme-idx') || '0', 10);
      currentIndex = (currentIndex + 1) % platformThemes.length;
      
      const theme = platformThemes[currentIndex];
      wrapper.style.setProperty('--promo-bg-gradient', theme.bg);
      wrapper.style.setProperty('--promo-text-light', theme.textLight);
      wrapper.style.setProperty('--promo-badge-bg', theme.badgeBg);
      wrapper.style.setProperty('--promo-badge-text', theme.badgeText);
      wrapper.setAttribute('data-theme-idx', currentIndex.toString());
    } catch(e) {
      console.error('Failed to parse promo themes', e);
    }
  };

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('#flip-wrapper').forEach(wrapper => {
      const platform = wrapper.getAttribute('data-platform');
      const themesStr = wrapper.getAttribute('data-themes');
      if (platform && themesStr) {
        try {
          const themes = JSON.parse(themesStr);
          if (themes[platform] && themes[platform].length > 0) {
            const theme = themes[platform][0];
            wrapper.style.setProperty('--promo-bg-gradient', theme.bg);
            wrapper.style.setProperty('--promo-text-light', theme.textLight);
            wrapper.style.setProperty('--promo-badge-bg', theme.badgeBg);
            wrapper.style.setProperty('--promo-badge-text', theme.badgeText);
          }
        } catch (e) {}
      }
    });
  });
</script>

<style>
  .promo-widget {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    padding: 0 !important;
    border: none;
    height: 140px;
    border-radius: 10px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15), 0 0 1px rgba(0, 242, 254, 0.35);
    color: #fff;
    overflow: visible !important;
    margin: 0 !important;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .promo-widget:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.3), 0 0 14px rgba(0, 242, 254, 0.4);
  }

  :global([data-theme="dark"]) .promo-widget {
    background: transparent;
    border: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 1px rgba(0, 242, 254, 0.4);
  }

  #flip-wrapper {
    -webkit-perspective: 1200px;
    perspective: 1200px;
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    box-sizing: border-box;
    border-radius: 10px;
    z-index: 1;
    background: transparent !important;
    border: none !important;
    /* Cyber Defaults */
    --promo-bg-gradient: linear-gradient(135deg, #0b1a30 0%, #00122e 45%, #05244f 100%);
    --promo-text-light: #00f2fe;
    --promo-badge-bg: rgba(0, 242, 254, 0.18);
    --promo-badge-text: #00f2fe;
  }

  #flip-content {
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    box-sizing: border-box;
    -webkit-transform-style: preserve-3d;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
    will-change: transform;
    border-radius: 10px;
    background: transparent !important;
    border: none !important;
  }

  .face {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    box-sizing: border-box !important;
    -webkit-backface-visibility: hidden !important;
    backface-visibility: hidden !important;
    -webkit-transform-style: preserve-3d;
    transform-style: preserve-3d;
    border-radius: 10px;
    cursor: pointer;
    overflow: hidden;
    background-image: var(--promo-bg-gradient);
    border: 1px solid rgba(0, 242, 254, 0.28);
    margin: 0 !important;
    padding: 10px 12px !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
  }

  /* Cyber Canvas & Vector Layers */
  .promo-tech-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .tech-grid-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .promo-radar-watermark {
    position: absolute;
    right: -24px;
    bottom: -24px;
    width: 160px;
    height: 160px;
    opacity: 0.38;
    z-index: 0;
    pointer-events: none;
    transform: rotate(-10deg);
  }

  /* FRONT FACE SPECIFICS */
  .front-face {
    z-index: 2;
    transform: rotateY(0deg) translateZ(1px) !important;
    -webkit-transform: rotateY(0deg) translateZ(1px) !important;
  }

  /* Top HUD Bar */
  .hud-top-bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 20px;
  }

  .hud-band-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: monospace, ui-monospace, sans-serif;
    font-size: 8.5px;
    font-weight: 700;
