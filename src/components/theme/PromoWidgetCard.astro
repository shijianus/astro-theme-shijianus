---
import QRCode from 'qrcode';
import { siteConfig } from '../../config/site';

interface Props {
  id?: string;
  className?: string;
  platform?: 'telegram' | 'wechat' | 'facebook' | 'whatsapp';
  config?: {
    href: string;
    qrImage: string;
    title: string;
    subtitle: string;
    backTitle?: string;
    backSubtitle?: string;
  };
}

const {
  id = 'promo-widget',
  className = '',
  platform = 'telegram',
} = Astro.props;

const defaultCopy = {
  telegram: {
    title: 'Telegram',
    subtitle: '专注隐私传播。海外更新、测试第一时间获取。',
    backTitle: '扫码加入',
    backSubtitle: '无缝安全交流 · 极客动态首发',
    badge: '官方社群',
    ctaText: '立即直达'
  },
  wechat: {
    title: 'WeChat',
    subtitle: '微信公众号。快人一步获取最新文章与动态。',
    backTitle: '扫一扫关注',
    backSubtitle: '不错过精彩内容 · 微信动态订阅',
    badge: '官方微信',
    ctaText: '关注我们'
  },
  facebook: {
    title: 'Facebook',
    subtitle: '开放社群。加入我们，结识同好畅所欲言。',
    backTitle: '扫码关注主页',
    backSubtitle: '探索更多可能 · 开放社群交流',
    badge: '官方主页',
    ctaText: '前往主页'
  },
  whatsapp: {
    title: 'WhatsApp',
    subtitle: '快捷简单安全。即刻加入，随时保持密切联系。',
    backTitle: '扫码添加联系',
    backSubtitle: '开启即时通讯 · 保持密切连结',
    badge: '即时联系',
    ctaText: '添加好友'
  }
};

const platformConfigs = {
  telegram: {
    href: siteConfig.aside.telegramWidget?.href || 'https://t.me/chronoral',
    qrImage: siteConfig.aside.telegramWidget?.qrImage || '',
    title: siteConfig.aside.telegramWidget?.title || defaultCopy.telegram.title,
    subtitle: siteConfig.aside.telegramWidget?.subtitle || defaultCopy.telegram.subtitle,
    backTitle: siteConfig.aside.telegramWidget?.backLabel || defaultCopy.telegram.backTitle,
    backSubtitle: siteConfig.aside.telegramWidget?.summary || defaultCopy.telegram.backSubtitle,
    badge: defaultCopy.telegram.badge,
    ctaText: defaultCopy.telegram.ctaText,
    iconPath: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z'
  },
  wechat: {
    href: '#',
    qrImage: '',
    title: defaultCopy.wechat.title,
    subtitle: defaultCopy.wechat.subtitle,
    backTitle: defaultCopy.wechat.backTitle,
    backSubtitle: defaultCopy.wechat.backSubtitle,
    badge: defaultCopy.wechat.badge,
    ctaText: defaultCopy.wechat.ctaText,
    iconPath: 'M17.333 11.333c0-3.313-3.284-6-7.333-6S2.667 8.02 2.667 11.333c0 1.84 1.01 3.486 2.63 4.545l-.697 2.121 2.502-1.252c.904.254 1.88.386 2.9.386 4.049 0 7.331-2.687 7.331-6zm-9.333-1.333a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm5.333 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm8 4c0-2.576-2.537-4.667-5.667-4.667-.113 0-.223.006-.333.013.432.842.667 1.776.667 2.766 0 3.864-3.731 7-8.333 7-.53 0-1.045-.038-1.543-.109 1.155 1.583 3.324 2.664 5.876 2.664.815 0 1.595-.106 2.324-.31l2.001 1.002-.558-1.697c1.296-.847 2.103-2.163 2.103-3.636zm-3.666-.667a.833.833 0 1 1-1.667 0 .833.833 0 0 1 1.667 0zm-4.334 0a.833.833 0 1 1-1.667 0 .833.833 0 0 1 1.667 0z'
  },
  whatsapp: {
    href: '#',
    qrImage: '',
    title: defaultCopy.whatsapp.title,
    subtitle: defaultCopy.whatsapp.subtitle,
    backTitle: defaultCopy.whatsapp.backTitle,
    backSubtitle: defaultCopy.whatsapp.backSubtitle,
    badge: defaultCopy.whatsapp.badge,
    ctaText: defaultCopy.whatsapp.ctaText,
    iconPath: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01a1.096 1.096 0 0 0-.792.371c-.297.322-1.139 1.114-1.139 2.716s1.164 3.146 1.337 3.37c.173.223 2.302 3.518 5.577 4.935 2.187.947 2.923.8 3.541.748.723-.06 2.303-.941 2.625-1.849.322-.909.322-1.688.223-1.849-.099-.161-.371-.247-.669-.396zM12 21.6A9.6 9.6 0 0 1 3.731 16.7l-1.312 4.79 4.908-1.288A9.553 9.553 0 0 1 12 21.6c5.3 0 9.6-4.3 9.6-9.6S17.3 2.4 12 2.4 2.4 6.7 2.4 12c0 1.676.433 3.25 1.196 4.593L2.4 21.6l5.132-1.35A9.57 9.57 0 0 0 12 21.6z'
  },
  facebook: {
    href: '#',
    qrImage: '',
    title: defaultCopy.facebook.title,
    subtitle: defaultCopy.facebook.subtitle,
    backTitle: defaultCopy.facebook.backTitle,
    backSubtitle: defaultCopy.facebook.backSubtitle,
    badge: defaultCopy.facebook.badge,
    ctaText: defaultCopy.facebook.ctaText,
    iconPath: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z'
  }
};

const finalConfig = Astro.props.config || platformConfigs[platform];
const iconPath = platformConfigs[platform].iconPath;

// Generate truly embedded high-resolution vector QR Code data URI
let embeddedQrDataUrl = '';
try {
  embeddedQrDataUrl = await QRCode.toDataURL(finalConfig.href, {
    margin: 1,
    width: 256,
    color: {
      dark: '#1c3d5a',
      light: '#ffffff'
    },
    errorCorrectionLevel: 'M'
  });
} catch (e) {
  console.error('Failed to generate embedded QR code', e);
  embeddedQrDataUrl = finalConfig.qrImage || '';
}
---

<div class:list={['card-widget promo-widget', className]} id={id}>
  <div id="flip-wrapper">
    <div id="flip-content">
      
      <!-- ============================================== -->
      <!-- FRONT FACE: 亮色调清新优雅浅蓝正面            -->
      <!-- ============================================== -->
      <div
        class="face front-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感：右侧倾斜 15 度半透明纯净矢量大水印 -->
        <div class="promo-watermark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d={iconPath} />
          </svg>
        </div>

        <!-- 正面主体布局 -->
        <div class="promo-front-body">
          <div class="promo-icon-box">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="#ffffff">
              <path d={iconPath} />
            </svg>
          </div>
          <div class="promo-front-info">
            <div class="promo-title-row">
              <span class="promo-title">{finalConfig.title}</span>
              <span class="promo-badge">{platformConfigs[platform].badge}</span>
            </div>
            <div class="promo-subtitle">{finalConfig.subtitle}</div>
          </div>
        </div>

        <!-- 正面底栏轻量提示 -->
        <div class="promo-front-hint">
          <span class="hint-text">悬停翻转直达二维码</span>
          <svg class="hint-arrow" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- BACK FACE: 完整设计的正向展示扫码后板         -->
      <!-- ============================================== -->
      <div
        class="face back-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感：背面对应微透水印 -->
        <div class="promo-watermark promo-watermark--back" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d={iconPath} />
          </svg>
        </div>

        <!-- 背面主体左右网格布局 -->
        <div class="promo-back-grid">
          <!-- 左侧文字说明与快捷按钮 -->
          <div class="promo-back-left">
            <div class="promo-back-title">{finalConfig.backTitle}</div>
            <div class="promo-back-subtitle">{finalConfig.backSubtitle}</div>
            <div class="promo-cta-action">
              <a
                href={finalConfig.href}
                target="_blank"
                rel="noopener noreferrer"
                class="promo-cta-btn"
                onclick="event.stopPropagation();"
              >
                <span>{platformConfigs[platform].ctaText}</span>
                <span class="cta-arrow">&nearr;</span>
              </a>
            </div>
          </div>

          <!-- 右侧内嵌高清矢量二维码 -->
          <div class="promo-qr-chassis">
            <div class="promo-qr-wrapper">
              <img
                src={embeddedQrDataUrl}
                alt={`${finalConfig.title} 二维码`}
                class="promo-qr-img"
                loading="eager"
                decoding="sync"
              />
            </div>
            <span class="promo-qr-label">扫码加入</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .promo-widget {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    padding: 0 !important;
    border: none;
    height: 130px;
    border-radius: 8px;
    margin: 0 !important;
    overflow: visible !important;
    cursor: pointer;
  }

  #flip-wrapper {
    -webkit-perspective: 1000px;
    perspective: 1000px;
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    /* 核心：亮色调清新优雅浅蓝渐变 */
    --promo-bg-gradient: linear-gradient(135deg, #2481cc 0%, #3598dc 50%, #4aaff6 100%);
    --promo-card-shadow: 0 4px 16px rgba(36, 129, 204, 0.28);
    --promo-border-color: rgba(255, 255, 255, 0.45);
  }

  :global([data-theme="dark"]) #flip-wrapper {
    --promo-bg-gradient: linear-gradient(135deg, #185a8c 0%, #1a4f78 50%, #1f4263 100%);
    --promo-card-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    --promo-border-color: rgba(255, 255, 255, 0.2);
  }

  #flip-content {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .face {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    box-sizing: border-box !important;
    border-radius: 8px;
    background: var(--promo-bg-gradient);
    border: 1px solid var(--promo-border-color);
    box-shadow: var(--promo-card-shadow);
    color: #ffffff;
    overflow: hidden;
    padding: 12px 14px !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    -webkit-backface-visibility: hidden !important;
    backface-visibility: hidden !important;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease, visibility 0.3s ease;
    will-change: transform, opacity;
  }

  /* 正面板：默认正对用户 (0deg) */
  .front-face {
    -webkit-transform: rotateY(0deg) !important;
    transform: rotateY(0deg) !important;
    z-index: 2;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* 背面板：默认背对用户 (-180deg) */
  .back-face {
    -webkit-transform: rotateY(-180deg) !important;
    transform: rotateY(-180deg) !important;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* 悬停或聚焦时：正面翻出 (180deg) 且淡出；背面翻入正向 (0deg) 且显现 */
  .promo-widget:hover .front-face,
  .promo-widget:focus-within .front-face,
  #flip-wrapper:hover .front-face {
    -webkit-transform: rotateY(180deg) !important;
    transform: rotateY(180deg) !important;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .promo-widget:hover .back-face,
  .promo-widget:focus-within .back-face,
  #flip-wrapper:hover .back-face {
    -webkit-transform: rotateY(0deg) !important;
    transform: rotateY(0deg) !important;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 3;
  }

  /* 大尺寸画面感半透明矢量水印 */
  .promo-watermark {
    position: absolute;
    right: -18px;
    bottom: -18px;
    width: 125px;
    height: 125px;
    opacity: 0.13;
    pointer-events: none;
    transform: rotate(-12deg);
    color: #ffffff;
    z-index: 0;
  }

  .promo-watermark svg {
    width: 100%;
    height: 100%;
  }

  /* FRONT FACE 样式 */
  .promo-front-body {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .promo-icon-box {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  }

  .promo-front-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    flex: 1;
  }

  .promo-title-row {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 2px;
  }

  .promo-title {
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.3px;
    color: #ffffff;
    line-height: 1.2;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.15);
  }

  .promo-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 1.5px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.38);
    color: #ffffff;
    line-height: 1.2;
    white-space: nowrap;
  }

  .promo-subtitle {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .promo-front-hint {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.88);
    padding-top: 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hint-arrow {
    transition: transform 0.25s ease;
  }

  .promo-widget:hover .hint-arrow {
    transform: translateX(3px);
  }

  /* BACK FACE 样式 */
  .promo-back-grid {
    position: relative;
    z-index: 2;
    display: grid !important;
    grid-template-columns: 1fr 78px !important;
    align-items: center !important;
    gap: 10px !important;
    height: 100% !important;
  }

  .promo-back-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .promo-back-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 2px;
    line-height: 1.2;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .promo-back-subtitle {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.35;
    margin-bottom: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .promo-cta-action {
    display: flex;
  }

  .promo-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3.5px 12px;
    background: #ffffff;
    color: #2481cc;
    font-size: 0.74rem;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .promo-cta-btn:hover {
    transform: translateY(-1px) scale(1.02);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.22);
  }

  .cta-arrow {
    font-size: 0.82rem;
    font-weight: 800;
    line-height: 1;
  }

  /* 内嵌二维码容器 */
  .promo-qr-chassis {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .promo-qr-wrapper {
    width: 74px;
    height: 74px;
    background: #ffffff;
    border-radius: 6px;
    padding: 3px;
    box-sizing: border-box;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .promo-qr-wrapper img,
  .promo-qr-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
    object-position: center !important;
    display: block !important;
    image-rendering: pixelated;
  }

  .promo-qr-label {
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.92);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.3px;
  }
</style>
