---
import QRCode from 'qrcode';
import { siteConfig } from '../../config/site';

interface Props {
  id?: string;
  className?: string;
  platform?: 'telegram' | 'wechat' | 'facebook' | 'whatsapp';
  config?: {
    href: string;
    qrImage: string;
    title: string;
    subtitle: string;
    backTitle?: string;
    backSubtitle?: string;
  };
}

const {
  id = 'promo-widget',
  className = '',
  platform = 'telegram',
} = Astro.props;

const defaultCopy = {
  telegram: {
    title: 'Telegram',
    subtitle: '专注隐私传播。海外更新、测试第一时间获取。',
    backTitle: '扫码加入',
    backSubtitle: '海外更新、测试通知与动态首发。',
    badge: '官方社群',
    ctaText: '立即直达'
  },
  wechat: {
    title: 'WeChat',
    subtitle: '微信公众号。快人一步获取最新文章与动态。',
    backTitle: '扫一扫关注',
    backSubtitle: '不错过精彩内容 · 微信动态订阅',
    badge: '官方微信',
    ctaText: '关注我们'
  },
  facebook: {
    title: 'Facebook',
    subtitle: '开放社群。加入我们，结识同好畅所欲言。',
    backTitle: '扫码关注主页',
    backSubtitle: '探索更多可能 · 开放社群交流',
    badge: '官方主页',
    ctaText: '前往主页'
  },
  whatsapp: {
    title: 'WhatsApp',
    subtitle: '快捷简单安全。即刻加入，随时保持密切联系。',
    backTitle: '扫码添加联系',
    backSubtitle: '开启即时通讯 · 保持密切连结',
    badge: '即时联系',
    ctaText: '添加好友'
  }
};

const platformConfigs = {
  telegram: {
    href: siteConfig.aside.telegramWidget?.href || 'https://t.me/chronoral',
    qrImage: siteConfig.aside.telegramWidget?.qrImage || '',
    title: siteConfig.aside.telegramWidget?.title || defaultCopy.telegram.title,
    subtitle: siteConfig.aside.telegramWidget?.subtitle || defaultCopy.telegram.subtitle,
    backTitle: siteConfig.aside.telegramWidget?.backLabel || defaultCopy.telegram.backTitle,
    backSubtitle: siteConfig.aside.telegramWidget?.summary || defaultCopy.telegram.backSubtitle,
    badge: defaultCopy.telegram.badge,
    ctaText: defaultCopy.telegram.ctaText,
  },
  wechat: {
    href: '#',
    qrImage: '',
    title: defaultCopy.wechat.title,
    subtitle: defaultCopy.wechat.subtitle,
    backTitle: defaultCopy.wechat.backTitle,
    backSubtitle: defaultCopy.wechat.backSubtitle,
    badge: defaultCopy.wechat.badge,
    ctaText: defaultCopy.wechat.ctaText,
  },
  whatsapp: {
    href: '#',
    qrImage: '',
    title: defaultCopy.whatsapp.title,
    subtitle: defaultCopy.whatsapp.subtitle,
    backTitle: defaultCopy.whatsapp.backTitle,
    backSubtitle: defaultCopy.whatsapp.backSubtitle,
    badge: defaultCopy.whatsapp.badge,
    ctaText: defaultCopy.whatsapp.ctaText,
  },
  facebook: {
    href: '#',
    qrImage: '',
    title: defaultCopy.facebook.title,
    subtitle: defaultCopy.facebook.subtitle,
    backTitle: defaultCopy.facebook.backTitle,
    backSubtitle: defaultCopy.facebook.backSubtitle,
    badge: defaultCopy.facebook.badge,
    ctaText: defaultCopy.facebook.ctaText,
  }
};

const finalConfig = Astro.props.config || platformConfigs[platform];

// Generate truly embedded high-resolution vector QR Code data URI
let embeddedQrDataUrl = '';
try {
  embeddedQrDataUrl = await QRCode.toDataURL(finalConfig.href, {
    margin: 1,
    width: 256,
    color: {
      dark: '#0369a1',
      light: '#ffffff'
    },
    errorCorrectionLevel: 'M'
  });
} catch (e) {
  console.error('Failed to generate embedded QR code', e);
  embeddedQrDataUrl = finalConfig.qrImage || '';
}

// 天文长曝光同心星轨真实算法 (Astrophotography Celestial Star Trails)
// 旋转中心置于视区右上外侧 (cx: 330, cy: -35)，锁定北天极 Polaris 视坐标
const CELESTIAL_POLE_X = 330;
const CELESTIAL_POLE_Y = -35;

function arcPath(cx: number, cy: number, r: number, startDeg: number, endDeg: number) {
  const startRad = (startDeg * Math.PI) / 180;
  const endRad = (endDeg * Math.PI) / 180;
  const x1 = cx + r * Math.cos(startRad);
  const y1 = cy + r * Math.sin(startRad);
  const x2 = cx + r * Math.cos(endRad);
  const y2 = cy + r * Math.sin(endRad);
  const largeArc = Math.abs(endDeg - startDeg) > 180 ? 1 : 0;
  const sweep = endDeg > startDeg ? 1 : 0;
  return `M ${x1.toFixed(1)} ${y1.toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 ${largeArc} ${sweep} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
}

// 1. Tier 1: 极细深空星尘同心光轨底幕 (Micro Star-Dust Trails, 58条密织微弧线, 构筑浩瀚天幕真丝质感)
const microColors = ['#ffffff', '#bae6fd', '#7dd3fc', '#e0f2fe', '#fed7aa'];
const frontMicroTrails: Array<{ d: string; strokeWidth: number; opacity: number; color: string }> = [];
for (let r = 40; r <= 440; r += 7) {
  const s = ((r * 23) % 360);
  const span = 200 + ((r * 11) % 95);
  const sw = Number((0.35 + (r % 4) * 0.08).toFixed(2));
  const op = Number((0.15 + ((r * 31) % 18) / 100).toFixed(2));
  frontMicroTrails.push({
    d: arcPath(CELESTIAL_POLE_X, CELESTIAL_POLE_Y, r, s, s + span),
    strokeWidth: sw,
    opacity: op,
    color: microColors[r % microColors.length]
  });
}

// 2. Tier 2: 中等视星等恒星光谱弧线 (Mid-magnitude Spectral Trails, 18条色彩分级星轨)
const spectralPalette = [
  { c: '#ffffff', glow: '#93c5fd' }, // A型纯白
  { c: '#bae6fd', glow: '#38bdf8' }, // B型天青蓝
  { c: '#fef08a', glow: '#f59e0b' }, // G型金黄 (五车二)
  { c: '#fed7aa', glow: '#ea580c' }, // K型暖橙 (大角星)
  { c: '#7dd3fc', glow: '#0284c7' }  // 深空电光蓝
];
const frontMidTrails: Array<{ d: string; strokeWidth: number; opacity: number; color: string }> = [];
for (let i = 0; i < 18; i++) {
  const r = 55 + i * 21;
  const s = (i * 53) % 360;
  const span = 195 + (i * 17) % 80;
  const sw = Number((0.75 + (i % 3) * 0.18).toFixed(2));
  const op = Number((0.42 + (i % 4) * 0.08).toFixed(2));
  const p = spectralPalette[i % spectralPalette.length];
  frontMidTrails.push({
    d: arcPath(CELESTIAL_POLE_X, CELESTIAL_POLE_Y, r, s, s + span),
    strokeWidth: sw,
    opacity: op,
    color: p.c
  });
}

// 3. Tier 3: 5条一等亮主星辉光层 (Alpha Stars with Optical Bloom + Glowing Star Heads + Diffraction Spikes)
const alphaStarDefs = [
  { r: 85, s: 65, span: 245, sw: 1.4, op: 1.0, c: '#ffffff', glowC: '#38bdf8', flareSize: 7.5 }, // 天狼星 / 织女星
  { r: 145, s: 105, span: 230, sw: 1.3, op: 0.95, c: '#fef08a', glowC: '#eab308', flareSize: 6.5 }, // 五车二 (金色)
  { r: 215, s: 45, span: 250, sw: 1.55, op: 1.0, c: '#ffffff', glowC: '#60a5fa', flareSize: 8.0 },  // 参宿七 (蓝白)
  { r: 290, s: 90, span: 235, sw: 1.35, op: 0.95, c: '#fed7aa', glowC: '#f97316', flareSize: 6.5 },  // 大角星 (暖橙)
  { r: 370, s: 35, span: 240, sw: 1.45, op: 0.98, c: '#e0f2fe', glowC: '#0284c7', flareSize: 7.0 }   // 参宿四外轨
];
const frontAlphaTrails = alphaStarDefs.map(t => {
  const headRad = ((t.s + t.span) * Math.PI) / 180;
  const hx = Number((CELESTIAL_POLE_X + t.r * Math.cos(headRad)).toFixed(1));
  const hy = Number((CELESTIAL_POLE_Y + t.r * Math.sin(headRad)).toFixed(1));
  return {
    ...t,
    d: arcPath(CELESTIAL_POLE_X, CELESTIAL_POLE_Y, t.r, t.s, t.s + t.span),
    hx,
    hy
  };
});

// 4. 深空微星噪点 / 静态星尘散点 (Static Deep Space Star Dust, 16颗高亮微星与微闪)
const staticStars = [
  { x: 28, y: 18, r: 1.1, op: 0.75, twinkle: 'promo-twinkle-a' },
  { x: 55, y: 88, r: 1.2, op: 0.8, twinkle: 'promo-twinkle-b' },
  { x: 82, y: 32, r: 0.8, op: 0.55, twinkle: '' },
  { x: 115, y: 96, r: 1.0, op: 0.65, twinkle: 'promo-twinkle-a' },
  { x: 140, y: 15, r: 1.3, op: 0.85, twinkle: 'promo-twinkle-b' },
  { x: 172, y: 78, r: 0.85, op: 0.6, twinkle: '' },
  { x: 198, y: 24, r: 1.1, op: 0.75, twinkle: 'promo-twinkle-a' },
  { x: 226, y: 92, r: 0.9, op: 0.6, twinkle: '' },
  { x: 254, y: 38, r: 1.25, op: 0.82, twinkle: 'promo-twinkle-b' },
  { x: 278, y: 84, r: 0.8, op: 0.5, twinkle: '' },
  { x: 302, y: 18, r: 1.0, op: 0.7, twinkle: 'promo-twinkle-a' },
  { x: 42, y: 64, r: 0.85, op: 0.55, twinkle: '' },
  { x: 95, y: 52, r: 1.1, op: 0.72, twinkle: 'promo-twinkle-b' },
  { x: 160, y: 44, r: 0.95, op: 0.65, twinkle: '' },
  { x: 212, y: 66, r: 1.0, op: 0.68, twinkle: 'promo-twinkle-a' },
  { x: 285, y: 55, r: 0.85, op: 0.55, twinkle: '' }
];

// 背面极简连贯星轨 (低对比度同轴大弧线，保护二维码清晰度)
const backStarTrails = [
  { r: 85, s: 75, span: 160, sw: 0.55, op: 0.18, c: '#ffffff' },
  { r: 135, s: 105, span: 170, sw: 0.5, op: 0.16, c: '#bae6fd' },
  { r: 185, s: 60, span: 175, sw: 0.65, op: 0.2, c: '#ffffff' },
  { r: 240, s: 115, span: 165, sw: 0.45, op: 0.15, c: '#7dd3fc' },
  { r: 300, s: 80, span: 170, sw: 0.55, op: 0.18, c: '#e0f2fe' },
  { r: 150, s: 220, span: 160, sw: 0.5, op: 0.16, c: '#bae6fd' },
  { r: 220, s: 235, span: 165, sw: 0.6, op: 0.18, c: '#ffffff' }
].map(a => ({
  d: arcPath(CELESTIAL_POLE_X, CELESTIAL_POLE_Y, a.r, a.s, a.s + a.span),
  strokeWidth: a.sw,
  opacity: a.op,
  color: a.c
}));
---

<div class:list={['card-widget promo-widget', className]} id={id}>
  <div id="flip-wrapper">
    <div id="flip-content">
      
      <!-- ============================================== -->
      <!-- FRONT FACE: 方案A 极光流体天蓝 + 动态长曝光星轨正面 -->
      <!-- ============================================== -->
      <div
        class="face front-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感升维：真实天文长曝光同心星轨 (北极星天球枢轴 + 视星等与光谱色温分级 + 镜头Bloom光晕) -->
        <div class="promo-scene-art promo-watermark" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- 镜头光学高斯漫反射发光 (Multi-tier Astrophotography Optical Bloom) -->
              <filter id="promoStarBloom" x="-35%" y="-35%" width="170%" height="170%">
                <feGaussianBlur in="SourceGraphic" stdDeviation="2.4" result="broadGlow" />
                <feGaussianBlur in="SourceGraphic" stdDeviation="0.9" result="coreGlow" />
                <feMerge>
                  <feMergeNode in="broadGlow" />
                  <feMergeNode in="coreGlow" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <!-- 领航亮星热核光晕 (Stellar Core Corona) -->
              <radialGradient id="starCoronaGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                <stop offset="25%" stop-color="#bae6fd" stop-opacity="0.9" />
                <stop offset="60%" stop-color="#38bdf8" stop-opacity="0.45" />
                <stop offset="100%" stop-color="#38bdf8" stop-opacity="0" />
              </radialGradient>
              <!-- 北天极极星枢纽光斑 (Polaris Celestial Pivot) -->
              <radialGradient id="polarisCoreGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
                <stop offset="30%" stop-color="#93c5fd" stop-opacity="0.65" />
                <stop offset="65%" stop-color="#38bdf8" stop-opacity="0.3" />
                <stop offset="100%" stop-color="#0284c7" stop-opacity="0" />
              </radialGradient>
            </defs>

            <!-- 静态深空璀璨星野 (Static Deep Space Star Dust + Twinkle) -->
            <g class="promo-static-dust">
              {staticStars.map(s => (
                <g class={s.twinkle}>
                  <circle cx={s.x} cy={s.y} r={Number((s.r * 1.8).toFixed(1))} fill="#38bdf8" opacity={Number((s.op * 0.35).toFixed(2))} filter="url(#promoStarBloom)" />
                  <circle cx={s.x} cy={s.y} r={s.r} fill="#ffffff" opacity={s.op} />
                </g>
              ))}
            </g>

            <!-- 统一天球物理角速度自转系统 (单一恒星日公转周期，无差速几何矛盾) -->
            <g class="celestial-vault-unified">
              <!-- Tier 1: 极细深空星尘同心光轨底幕 (58条微弧线，构筑致密真丝天幕) -->
              <g class="tier-micro-trails">
                {frontMicroTrails.map((trail) => (
                  <path
                    d={trail.d}
                    fill="none"
                    stroke={trail.color}
                    stroke-width={trail.strokeWidth}
                    opacity={trail.opacity}
                    stroke-linecap="round"
                  />
                ))}
              </g>

              <!-- Tier 2: 中等视星等恒星光谱弧线 (18条色彩分级星轨) -->
              <g class="tier-mid-trails">
                {frontMidTrails.map((trail) => (
                  <path
                    d={trail.d}
                    fill="none"
                    stroke={trail.color}
                    stroke-width={trail.strokeWidth}
                    opacity={trail.opacity}
                    stroke-linecap="round"
                  />
                ))}
              </g>

              <!-- Tier 3: 5条一等亮主星辉光层 (带三层 Bloom 发散漫射底轮廓与纯白高亮核心) -->
              <g class="tier-alpha-trails" filter="url(#promoStarBloom)">
                <!-- 广域柔和漫射外晕 -->
                {frontAlphaTrails.map((trail) => (
                  <path
                    d={trail.d}
                    fill="none"
                    stroke={trail.glowC}
                    stroke-width={Number((trail.sw * 3.2).toFixed(1))}
                    opacity={Number((trail.op * 0.32).toFixed(2))}
                    stroke-linecap="round"
                  />
                ))}
                <!-- 明亮彩色光晕环 -->
                {frontAlphaTrails.map((trail) => (
                  <path
                    d={trail.d}
                    fill="none"
                    stroke={trail.glowC}
                    stroke-width={Number((trail.sw * 1.9).toFixed(1))}
                    opacity={Number((trail.op * 0.58).toFixed(2))}
                    stroke-linecap="round"
                  />
                ))}
                <!-- 纯白白热高亮核心 -->
                {frontAlphaTrails.map((trail) => (
                  <path
                    d={trail.d}
                    fill="none"
                    stroke="#ffffff"
                    stroke-width={trail.sw}
                    opacity={trail.op}
                    stroke-linecap="round"
                  />
                ))}
              </g>

              <!-- Tier 4: 恒星璀璨领航星核光斑 + 四角十字衍射星芒 (Alpha Star Heads with Diffraction Flare) -->
              <g class="tier-alpha-heads">
                {frontAlphaTrails.map((trail) => {
                  const sz = trail.flareSize;
                  const half = Number((sz * 0.16).toFixed(1));
                  return (
                    <g transform={`translate(${trail.hx}, ${trail.hy})`}>
                      <!-- 外层漫射光晕圈 -->
                      <circle cx="0" cy="0" r={Number((sz * 0.65).toFixed(1))} fill="url(#starCoronaGlow)" />
                      <!-- 纯白热核 -->
                      <circle cx="0" cy="0" r="1.3" fill="#ffffff" />
                      <!-- 四角十字衍射星芒 -->
                      <polygon
                        points={`0,-${sz} ${half},-${half} ${sz},0 ${half},${half} 0,${sz} -${half},${half} -${sz},0 -${half},-${half}`}
                        fill="#ffffff"
                        opacity="0.9"
                        filter="url(#promoStarBloom)"
                      />
                    </g>
                  );
                })}
              </g>

              <!-- Tier 5: 北天极极星微光枢纽 (Polaris Celestial Pivot) -->
              <circle cx={CELESTIAL_POLE_X} cy={CELESTIAL_POLE_Y} r="11" fill="url(#polarisCoreGlow)" />
              <circle cx={CELESTIAL_POLE_X} cy={CELESTIAL_POLE_Y} r="1.8" fill="#ffffff" />
              <!-- 极星十字微星芒 -->
              <g transform={`translate(${CELESTIAL_POLE_X}, ${CELESTIAL_POLE_Y})`}>
                <polygon points="0,-8 1.2,-1.2 8,0 1.2,1.2 0,8 -1.2,1.2 -8,0 -1.2,-1.2" fill="#ffffff" opacity="0.8" />
              </g>
            </g>
          </svg>
        </div>

        <!-- 权威开源 Telegram 官方立体折纸飞机 (Wikimedia Commons 3-Tone Shaded 真实物理光影与官方折痕) -->
        <div class="promo-hero-plane" aria-hidden="true">
          <svg width="74" height="74" viewBox="48 60 135 115" style="overflow: visible; filter: drop-shadow(0 8px 16px rgba(15, 23, 42, 0.45)) drop-shadow(0 2px 4px rgba(2, 44, 120, 0.35));">
            <!-- 1. 下折底翼 (天青浅蓝底面) -->
            <path d="M81.229,128.772l14.237,39.406s1.78,3.687,3.686,3.687,30.255-29.492,30.255-29.492l31.525-60.89L81.737,118.6Z" fill="#bae6fd"/>
            <!-- 2. 机腹中脊 (亮海蓝立体折角) -->
            <path d="M100.106,138.878l-2.733,29.046s-1.144,8.9,7.754,0,17.415-15.763,17.415-15.763" fill="#60a5fa"/>
            <!-- 3. 主翼面 (官方纯白挺拔折纸，负空间内切弧度完全忠实官方) -->
            <path d="M81.486,130.178,52.2,120.636s-3.5-1.42-2.373-4.64c.232-.664.7-1.229,2.1-2.2,6.489-4.523,120.106-45.36,120.106-45.36s3.208-1.081,5.1-.362a2.766,2.766,0,0,1,1.885,2.055,9.357,9.357,0,0,1,.254,2.585c-.009.752-.1,1.449-.169,2.542-.692,11.165-21.4,94.493-21.4,94.493s-1.239,4.876-5.678,5.043A8.13,8.13,0,0,1,146.1,172.5c-8.711-7.493-38.819-27.727-45.472-32.177a1.27,1.27,0,0,1-.546-.9c-.093-.469.417-1.05.417-1.05s52.426-46.6,53.821-51.492c.108-.379-.3-.566-.848-.4-3.482,1.281-63.844,39.4-70.506,43.607A3.21,3.21,0,0,1,81.486,130.178Z" fill="#ffffff"/>
          </svg>
        </div>

        <!-- 正面主体布局：立体深空微光探测舱 + 形象化 3D 纸飞机 -->
        <div class="promo-front-body">
          <div class="promo-icon-emblem">
            <svg class="promo-icon-plane" width="24" height="24" viewBox="48 60 135 115" xmlns="http://www.w3.org/2000/svg">
              <path d="M81.229,128.772l14.237,39.406s1.78,3.687,3.686,3.687,30.255-29.492,30.255-29.492l31.525-60.89L81.737,118.6Z" fill="#bae6fd"/>
              <path d="M100.106,138.878l-2.733,29.046s-1.144,8.9,7.754,0,17.415-15.763,17.415-15.763" fill="#60a5fa"/>
              <path d="M81.486,130.178,52.2,120.636s-3.5-1.42-2.373-4.64c.232-.664.7-1.229,2.1-2.2,6.489-4.523,120.106-45.36,120.106-45.36s3.208-1.081,5.1-.362a2.766,2.766,0,0,1,1.885,2.055,9.357,9.357,0,0,1,.254,2.585c-.009.752-.1,1.449-.169,2.542-.692,11.165-21.4,94.493-21.4,94.493s-1.239,4.876-5.678,5.043A8.13,8.13,0,0,1,146.1,172.5c-8.711-7.493-38.819-27.727-45.472-32.177a1.27,1.27,0,0,1-.546-.9c-.093-.469.417-1.05.417-1.05s52.426-46.6,53.821-51.492c.108-.379-.3-.566-.848-.4-3.482,1.281-63.844,39.4-70.506,43.607A3.21,3.21,0,0,1,81.486,130.178Z" fill="#ffffff"/>
            </svg>
          </div>
          <div class="promo-front-info">
            <div class="promo-title-row">
              <span class="promo-title">{finalConfig.title}</span>
              <span class="promo-badge">{platformConfigs[platform].badge}</span>
            </div>
            <div class="promo-subtitle">{finalConfig.subtitle}</div>
          </div>
        </div>
      </div>

      <!-- ============================================== -->
