---
import QRCode from 'qrcode';
import { siteConfig } from '../../config/site';

interface Props {
  id?: string;
  className?: string;
  platform?: 'telegram' | 'wechat' | 'facebook' | 'whatsapp';
  config?: {
    href: string;
    qrImage: string;
    title: string;
    subtitle: string;
    backTitle?: string;
    backSubtitle?: string;
  };
}

const {
  id = 'promo-widget',
  className = '',
  platform = 'telegram',
} = Astro.props;

const defaultCopy = {
  telegram: {
    title: 'Telegram',
    subtitle: '专注隐私传播。海外更新、测试第一时间获取。',
    backTitle: '扫码加入',
    backSubtitle: '海外更新、测试通知与动态首发。',
    badge: '官方社群',
    ctaText: '立即直达'
  },
  wechat: {
    title: 'WeChat',
    subtitle: '微信公众号。快人一步获取最新文章与动态。',
    backTitle: '扫一扫关注',
    backSubtitle: '不错过精彩内容 · 微信动态订阅',
    badge: '官方微信',
    ctaText: '关注我们'
  },
  facebook: {
    title: 'Facebook',
    subtitle: '开放社群。加入我们，结识同好畅所欲言。',
    backTitle: '扫码关注主页',
    backSubtitle: '探索更多可能 · 开放社群交流',
    badge: '官方主页',
    ctaText: '前往主页'
  },
  whatsapp: {
    title: 'WhatsApp',
    subtitle: '快捷简单安全。即刻加入，随时保持密切联系。',
    backTitle: '扫码添加联系',
    backSubtitle: '开启即时通讯 · 保持密切连结',
    badge: '即时联系',
    ctaText: '添加好友'
  }
};

const platformConfigs = {
  telegram: {
    href: siteConfig.aside.telegramWidget?.href || 'https://t.me/chronoral',
    qrImage: siteConfig.aside.telegramWidget?.qrImage || '',
    title: siteConfig.aside.telegramWidget?.title || defaultCopy.telegram.title,
    subtitle: siteConfig.aside.telegramWidget?.subtitle || defaultCopy.telegram.subtitle,
    backTitle: siteConfig.aside.telegramWidget?.backLabel || defaultCopy.telegram.backTitle,
    backSubtitle: siteConfig.aside.telegramWidget?.summary || defaultCopy.telegram.backSubtitle,
    badge: defaultCopy.telegram.badge,
    ctaText: defaultCopy.telegram.ctaText,
  },
  wechat: {
    href: '#',
    qrImage: '',
    title: defaultCopy.wechat.title,
    subtitle: defaultCopy.wechat.subtitle,
    backTitle: defaultCopy.wechat.backTitle,
    backSubtitle: defaultCopy.wechat.backSubtitle,
    badge: defaultCopy.wechat.badge,
    ctaText: defaultCopy.wechat.ctaText,
  },
  whatsapp: {
    href: '#',
    qrImage: '',
    title: defaultCopy.whatsapp.title,
    subtitle: defaultCopy.whatsapp.subtitle,
    backTitle: defaultCopy.whatsapp.backTitle,
    backSubtitle: defaultCopy.whatsapp.backSubtitle,
    badge: defaultCopy.whatsapp.badge,
    ctaText: defaultCopy.whatsapp.ctaText,
  },
  facebook: {
    href: '#',
    qrImage: '',
    title: defaultCopy.facebook.title,
    subtitle: defaultCopy.facebook.subtitle,
    backTitle: defaultCopy.facebook.backTitle,
    backSubtitle: defaultCopy.facebook.backSubtitle,
    badge: defaultCopy.facebook.badge,
    ctaText: defaultCopy.facebook.ctaText,
  }
};

const finalConfig = Astro.props.config || platformConfigs[platform];

// Generate truly embedded high-resolution vector QR Code data URI
let embeddedQrDataUrl = '';
try {
  embeddedQrDataUrl = await QRCode.toDataURL(finalConfig.href, {
    margin: 1,
    width: 256,
    color: {
      dark: '#0369a1',
      light: '#ffffff'
    },
    errorCorrectionLevel: 'M'
  });
} catch (e) {
  console.error('Failed to generate embedded QR code', e);
  embeddedQrDataUrl = finalConfig.qrImage || '';
}

// 确定性伪随机数生成器 (保证 SSG 构建一致性且具备绝对自然的星野分布)
function createCelestialRNG(seed = 42) {
  let s = seed;
  return function() {
    s = (s * 9301 + 49297) % 233280;
    return s / 233280;
  };
}

// 天文长曝光旋转同心星轨算法 (Celestial Pole Star Trails)
function arcPath(cx: number, cy: number, r: number, startDeg: number, endDeg: number) {
  const startRad = (startDeg * Math.PI) / 180;
  const endRad = (endDeg * Math.PI) / 180;
  const x1 = cx + r * Math.cos(startRad);
  const y1 = cy + r * Math.sin(startRad);
  const x2 = cx + r * Math.cos(endRad);
  const y2 = cy + r * Math.sin(endRad);
  const largeArc = Math.abs(endDeg - startDeg) > 180 ? 1 : 0;
  const sweep = endDeg > startDeg ? 1 : 0;
  return `M ${x1.toFixed(1)} ${y1.toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 ${largeArc} ${sweep} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
}

// 1. 自然随机散落的深空微恒星群 (48 颗多相独立闪烁，彻底告别死板静态与怪异滑动)
const randomStars = (() => {
  const rng = createCelestialRNG(88);
  const stars = [];
  const colors = ['#ffffff', '#ffffff', '#bae6fd', '#e0f2fe', '#7dd3fc'];
  for (let i = 0; i < 48; i++) {
    const x = 6 + rng() * 304;
    const y = 6 + rng() * 102;
    const isTextZone = (x > 50 && x < 185 && y > 25 && y < 85);
    const opacity = isTextZone ? (0.1 + rng() * 0.15) : (0.2 + rng() * 0.55);
    const r = Number((0.45 + rng() * 0.7).toFixed(1));
    const color = colors[Math.floor(rng() * colors.length)];
    const twGroup = `twinkle-phase-${(i % 6) + 1}`;
    stars.push({
      x: Number(x.toFixed(1)),
      y: Number(y.toFixed(1)),
      r,
      opacity: Number(opacity.toFixed(2)),
      color,
      twGroup
    });
  }
  return stars;
})();

// 2. 长曝光平滑连续同心星轨群 (22 轨自然非均匀圆弧，平滑静谧光晕，绝无虚线怪异滑动)
const frontStarTrails = (() => {
  const rng = createCelestialRNG(108);
  const cx = 345;
  const cy = -45;
  const count = 22;
  const items = [];
  for (let i = 0; i < count; i++) {
    const r = 52 + i * 14.5 + (rng() * 3 - 1.5);
    const s = 95 + rng() * 20;
    const span = 60 + rng() * 35;
    const e = s + span;
    
    const randMag = rng();
    const isMajor = randMag > 0.82;
    const strokeWidth = isMajor ? 0.95 : (randMag > 0.5 ? 0.6 : 0.4);
    const opacity = isMajor ? 0.65 : (randMag > 0.5 ? 0.32 : 0.16);
    const color = isMajor ? '#ffffff' : (randMag > 0.5 ? '#bae6fd' : (i % 2 === 0 ? '#38bdf8' : '#7dd3fc'));

    const d = arcPath(cx, cy, r, s, e);
    items.push({
      d,
      color,
      strokeWidth,
      opacity,
      isMajor
    });
  }
  return items;
})();

// 3. 背面 16 轨连续平滑星轨
const backStarTrails = (() => {
  const cx = 345;
  const cy = -45;
  const count = 16;
  const items = [];
  for (let i = 0; i < count; i++) {
    const r = 68 + i * 22;
    const s = 105 + ((i * 15) % 20);
    const e = 180 + ((i * 20) % 30);
    const isBright = (i % 4 === 0);
    const strokeWidth = isBright ? 0.85 : 0.5;
    const opacity = isBright ? 0.35 : 0.18;
    const color = isBright ? '#e0f2fe' : '#7dd3fc';
    const d = arcPath(cx, cy, r, s, e);
    items.push({ d, strokeWidth, opacity, color, isBright });
  }
  return items;
})();
---

<div class:list={['card-widget promo-widget', className]} id={id}>
  <div id="flip-wrapper">
    <div id="flip-content">
      
      <!-- ============================================== -->
      <!-- FRONT FACE: 方案A 极光流体天蓝 + 动态长曝光星轨正面 -->
      <!-- ============================================== -->
      <div
        class="face front-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感升维：纯净动态长曝光同心星流、呼吸十字衍射星芒、官方标准 3D 纸飞机 -->
        <div class="promo-scene-art promo-watermark" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- 官方标准 3D Telegram 纸飞机专属纯净光影渐变 (纯白大翼面 + 通透淡蓝展翼 + 纯净宝蓝龙骨，0黑斑) -->
              <linearGradient id="p-wing-main" x1="24.8" y1="111" x2="166" y2="75" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="70%" stop-color="#ffffff" />
                <stop offset="100%" stop-color="#f0f7ff" />
              </linearGradient>
              <linearGradient id="p-wing-side" x1="60" y1="120" x2="166" y2="75" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#93c5fd" />
                <stop offset="55%" stop-color="#bae6fd" />
                <stop offset="100%" stop-color="#e0f2fe" />
              </linearGradient>
              <linearGradient id="p-keel-clean" x1="80" y1="130" x2="120" y2="175" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#3b82f6" />
                <stop offset="100%" stop-color="#1d4ed8" />
              </linearGradient>
              <linearGradient id="p-keel-inner" x1="82" y1="132" x2="105" y2="175" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#2563eb" />
                <stop offset="100%" stop-color="#1e40af" />
              </linearGradient>
              <linearGradient id="p-spine-light" x1="24.8" y1="111" x2="166" y2="75" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
                <stop offset="85%" stop-color="#ffffff" stop-opacity="1" />
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0.6" />
              </linearGradient>
              <!-- 纯净大气软蓝漫射投影 (彻底杜绝深重黑边) -->
              <filter id="p-shadow" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="-2" dy="4" stdDeviation="3.5" flood-color="rgba(2, 44, 120, 0.28)" />
              </filter>
            </defs>

            <!-- 1. 48 颗多阶随机恒星，每颗拥有独立相位与闪烁周期 (有机闪烁，彻底告别死板与怪异滑动) -->
            {randomStars.map((star) => (
              <circle
                class={star.twGroup}
                cx={star.x}
                cy={star.y}
                r={star.r}
                fill={star.color}
                opacity={star.opacity}
              />
            ))}

            <!-- 2. 长曝光平滑连续星轨 (纯净连续弧线，绝无滑动虚线循环) -->
            {frontStarTrails.map((trail) => (
              <Fragment>
                {trail.isMajor && (
                  <path
                    class="trail-glow-aura"
                    d={trail.d}
                    fill="none"
                    stroke={trail.color}
                    stroke-width={trail.strokeWidth * 2.2}
                    opacity={trail.opacity * 0.3}
                    stroke-linecap="round"
                    filter="blur(1.2px)"
                  />
                )}
                <path
                  d={trail.d}
                  fill="none"
                  stroke={trail.color}
                  stroke-width={trail.strokeWidth}
                  opacity={trail.opacity}
                  stroke-linecap="round"
                />
              </Fragment>
            ))}

            <!-- 3. 动态【真实漫游与深空呼吸】的核心大亮星 (告别死寂站桩！) -->
            <!-- 亮星 1: 伴随星芒自转与呼吸绽放 -->
            <g class="celestial-beacon-1" transform="translate(196, 72)">
              <g class="beacon-spike-rotate">
                <path d="M 0 -8 Q 0 0 8 0 Q 0 0 0 8 Q 0 0 -8 0 Q 0 0 0 -8 Z" fill="#ffffff" />
              </g>
              <circle cx="0" cy="0" r="1.8" fill="#ffffff" />
              <circle class="beacon-glow-pulse" cx="0" cy="0" r="10" fill="#ffffff" opacity="0.35" filter="blur(1.5px)" />
            </g>

            <!-- 亮星 2: 沿天极圆弧做微漫游漂移 -->
            <g class="celestial-orbit-star" transform-origin="345px -45px">
              <g transform="translate(142, 22)">
                <path class="beacon-spike-pulse" d="M 0 -5 Q 0 0 5 0 Q 0 0 0 5 Q 0 0 -5 0 Q 0 0 0 -5 Z" fill="#bae6fd" />
                <circle cx="0" cy="0" r="1.4" fill="#ffffff" />
                <circle class="beacon-glow-pulse" cx="0" cy="0" r="7" fill="#bae6fd" opacity="0.35" filter="blur(1.2px)" />
              </g>
            </g>

            <!-- 亮星 3: 右下深空呼吸星 -->
            <g class="celestial-beacon-3" transform="translate(282, 86)">
              <path class="beacon-spike-pulse-alt" d="M 0 -4.5 Q 0 0 4.5 0 Q 0 0 0 4.5 Q 0 0 -4.5 0 Q 0 0 0 -4.5 Z" fill="#e0f2fe" />
              <circle cx="0" cy="0" r="1.2" fill="#ffffff" />
              <circle class="beacon-glow-pulse" cx="0" cy="0" r="6" fill="#e0f2fe" opacity="0.3" filter="blur(1px)" />
            </g>

            <!-- 4. 醒目、一眼必识的 3D Telegram 纸飞机 (52px，昂首翱翔，0 黑斑) -->
            <g class="tg-plane-flight-rig">
              <svg width="52" height="52" viewBox="0 0 170 170" fill="none" style="overflow: visible;">
                <g filter="url(#p-shadow)" transform="rotate(-8 85 85)">
                  <!-- 1. 折叠机腹内层三角 (折纸深层，纯净群青蓝，0黑斑) -->
                  <path d="M98 175c-3.8 0-3.2-1.5-4.5-5.2L82 132.2 152.8 88" fill="url(#p-keel-inner)" />
                  <!-- 2. 中腹折叠小角 (纯净宝蓝) -->
                  <path d="M98 175c3 0 4.3-1.4 6-3l16-15.5-20-12" fill="url(#p-keel-clean)" />
                  <!-- 3. 右展翼面 (下展副翼) -->
                  <polygon points="166,75 100,144.5 148.4,180.2" fill="url(#p-wing-side)" />
                  <!-- 4. 左主翼面 (主受光翼面) -->
                  <polygon points="166,75 24.8,111 100,144.5" fill="url(#p-wing-main)" />
                  <!-- 5. 机脊贯穿锋刃高光线 -->
                  <line x1="24.8" y1="111" x2="166" y2="75" stroke="url(#p-spine-light)" stroke-width="1.8" stroke-linecap="round" />
                  <!-- 6. 机尖破空耀斑微光点 -->
                  <circle cx="166" cy="75" r="2.2" fill="#ffffff" />
                </g>
              </svg>
            </g>
          </svg>
        </div>

        <!-- 正面主体布局：立体深空微光探测舱 + 形象化 3D 纸飞机 -->
        <div class="promo-front-body">
          <div class="promo-icon-emblem">
            <svg class="promo-icon-plane" width="24" height="24" viewBox="14 68 168 118" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M98 175c-3.8 0-3.2-1.5-4.5-5.2L82 132.2 152.8 88" fill="rgba(255,255,255,0.78)" />
              <path d="M98 175c3 0 4.3-1.4 6-3l16-15.5-20-12" fill="rgba(255,255,255,0.52)" />
              <path d="M100 144.5l48.4 35.7c5.6 3.1 9.6 1.5 11-5.2l19.5-92c2-8.3-3.2-12-8.6-9.6L24.8 111c-8 3.2-8 7.7-1.4 9.7l37.4 11.7 86.8-54.8c4.1-2.5 7.8-1.2 4.7 1.6" fill="#ffffff" />
            </svg>
          </div>
          <div class="promo-front-info">
            <div class="promo-title-row">
              <span class="promo-title">{finalConfig.title}</span>
              <span class="promo-badge">{platformConfigs[platform].badge}</span>
            </div>
            <div class="promo-subtitle">{finalConfig.subtitle}</div>
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- BACK FACE: 完整设计的正向展示扫码后板         -->
      <!-- ============================================== -->
      <div
        class="face back-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感：背面对应微透天文星轨底纹与十字星芒 -->
        <div class="promo-scene-art promo-scene-art--back promo-watermark promo-watermark--back" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            {backStarTrails.map((trail) => (
              <path
                d={trail.d}
                fill="none"
                stroke={trail.color}
                stroke-width={trail.strokeWidth}
                opacity={trail.opacity}
                stroke-linecap="round"
              />
            ))}
            <g class="celestial-beacon-2" transform="translate(120, 26)">
              <path class="beacon-spike-pulse" d="M 0 -4 Q 0 0 4 0 Q 0 0 0 4 Q 0 0 -4 0 Q 0 0 0 -4 Z" fill="#bae6fd" />
              <circle cx="0" cy="0" r="1.12" fill="#ffffff" />
              <circle class="beacon-glow-pulse" cx="0" cy="0" r="6.4" fill="#bae6fd" opacity="0.35" filter="blur(1px)" />
            </g>
            <g class="celestial-beacon-3" transform="translate(285, 82)">
              <path class="beacon-spike-pulse-alt" d="M 0 -3.5 Q 0 0 3.5 0 Q 0 0 0 3.5 Q 0 0 -3.5 0 Q 0 0 0 -3.5 Z" fill="#e0f2fe" />
              <circle cx="0" cy="0" r="0.98" fill="#ffffff" />
              <circle class="beacon-glow-pulse" cx="0" cy="0" r="5.6" fill="#e0f2fe" opacity="0.35" filter="blur(1px)" />
            </g>
          </svg>
        </div>

        <!-- 背面主体左右网格布局 -->
        <div class="promo-back-grid">
          <!-- 左侧文字说明与快捷按钮 -->
          <div class="promo-back-left">
            <div class="promo-back-title">{finalConfig.backTitle}</div>
            <div class="promo-back-subtitle">{finalConfig.backSubtitle}</div>
            <div class="promo-cta-action">
              <a
                href={finalConfig.href}
                target="_blank"
                rel="noopener noreferrer"
                class="promo-cta-btn"
                onclick="event.stopPropagation();"
              >
                <span>{platformConfigs[platform].ctaText}</span>
                <span class="cta-arrow">&nearr;</span>
              </a>
            </div>
          </div>

          <!-- 右侧内嵌高清矢量二维码 -->
          <div class="promo-qr-chassis">
            <div class="promo-qr-wrapper">
              <img
                src={embeddedQrDataUrl}
                alt={`${finalConfig.title} 二维码`}
                class="promo-qr-img"
                loading="eager"
                decoding="sync"
              />
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .promo-widget {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    padding: 0 !important;
    border: none;
    height: 114px;
    border-radius: 8px;
    margin: 0 !important;
    overflow: visible !important;
    cursor: pointer;
  }

  #flip-wrapper {
    -webkit-perspective: 1000px;
    perspective: 1000px;
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    /* 核心：方案A 极光四阶多色域流体渐变 (皇家宝蓝 -> 电光蓝 -> 晴空蓝 -> 湖绿青) */
    --promo-bg-gradient: 
      radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.35) 0%, transparent 40%),
      radial-gradient(circle at 92% 82%, rgba(6, 182, 212, 0.45) 0%, transparent 45%),
      linear-gradient(135deg, #1d4ed8 0%, #2563eb 38%, #0284c7 72%, #06b6d4 100%);
    --promo-card-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.38), 0 2px 6px rgba(0, 0, 0, 0.05);
    --promo-border-color: rgba(255, 255, 255, 0.48);
  }

  :global([data-theme="dark"]) #flip-wrapper {
    --promo-bg-gradient: 
      radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.15) 0%, transparent 40%),
      radial-gradient(circle at 92% 82%, rgba(6, 182, 212, 0.25) 0%, transparent 45%),
      linear-gradient(135deg, #0f172a 0%, #1e3a8a 38%, #1d4ed8 72%, #0369a1 100%);
    --promo-card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6), 0 2px 6px rgba(0, 0, 0, 0.4);
    --promo-border-color: rgba(255, 255, 255, 0.22);
  }

  #flip-content {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .face {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    box-sizing: border-box !important;
    border-radius: 8px;
    background: var(--promo-bg-gradient);
    border: 1px solid var(--promo-border-color);
    box-shadow: var(--promo-card-shadow);
    color: #ffffff;
    overflow: hidden;
    padding: 12px 16px !important;
    display: flex !important;
    align-items: center !important;
    -webkit-backface-visibility: hidden !important;
    backface-visibility: hidden !important;
    /* 核心动画优化：0.85s 从容丝滑缓动曲线 */
    transition: transform 0.85s cubic-bezier(0.25, 1, 0.35, 1), opacity 0.35s ease, visibility 0.35s ease;
    will-change: transform, opacity;
  }

  /* 正面板：默认正对用户 (0deg) */
  .front-face {
    -webkit-transform: rotateY(0deg) !important;
    transform: rotateY(0deg) !important;
    z-index: 2;
    opacity: 1;
    visibility: visible;
