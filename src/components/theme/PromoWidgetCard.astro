---
import QRCode from 'qrcode';
import { siteConfig } from '../../config/site';

interface Props {
  id?: string;
  className?: string;
  platform?: 'telegram' | 'wechat' | 'facebook' | 'whatsapp';
  config?: {
    href: string;
    qrImage: string;
    title: string;
    subtitle: string;
    backTitle?: string;
    backSubtitle?: string;
  };
}

const {
  id = 'promo-widget',
  className = '',
  platform = 'telegram',
} = Astro.props;

const defaultCopy = {
  telegram: {
    title: 'Telegram',
    subtitle: '专注隐私传播。海外更新、测试第一时间获取。',
    backTitle: '扫码加入',
    backSubtitle: '海外更新、测试通知与动态首发。',
    badge: '官方社群',
    ctaText: '立即直达'
  },
  wechat: {
    title: 'WeChat',
    subtitle: '微信公众号。快人一步获取最新文章与动态。',
    backTitle: '扫一扫关注',
    backSubtitle: '不错过精彩内容 · 微信动态订阅',
    badge: '官方微信',
    ctaText: '关注我们'
  },
  facebook: {
    title: 'Facebook',
    subtitle: '开放社群。加入我们，结识同好畅所欲言。',
    backTitle: '扫码关注主页',
    backSubtitle: '探索更多可能 · 开放社群交流',
    badge: '官方主页',
    ctaText: '前往主页'
  },
  whatsapp: {
    title: 'WhatsApp',
    subtitle: '快捷简单安全。即刻加入，随时保持密切联系。',
    backTitle: '扫码添加联系',
    backSubtitle: '开启即时通讯 · 保持密切连结',
    badge: '即时联系',
    ctaText: '添加好友'
  }
};

const platformConfigs = {
  telegram: {
    href: siteConfig.aside.telegramWidget?.href || 'https://t.me/chronoral',
    qrImage: siteConfig.aside.telegramWidget?.qrImage || '',
    title: siteConfig.aside.telegramWidget?.title || defaultCopy.telegram.title,
    subtitle: siteConfig.aside.telegramWidget?.subtitle || defaultCopy.telegram.subtitle,
    backTitle: siteConfig.aside.telegramWidget?.backLabel || defaultCopy.telegram.backTitle,
    backSubtitle: siteConfig.aside.telegramWidget?.summary || defaultCopy.telegram.backSubtitle,
    badge: defaultCopy.telegram.badge,
    ctaText: defaultCopy.telegram.ctaText,
  },
  wechat: {
    href: '#',
    qrImage: '',
    title: defaultCopy.wechat.title,
    subtitle: defaultCopy.wechat.subtitle,
    backTitle: defaultCopy.wechat.backTitle,
    backSubtitle: defaultCopy.wechat.backSubtitle,
    badge: defaultCopy.wechat.badge,
    ctaText: defaultCopy.wechat.ctaText,
  },
  whatsapp: {
    href: '#',
    qrImage: '',
    title: defaultCopy.whatsapp.title,
    subtitle: defaultCopy.whatsapp.subtitle,
    backTitle: defaultCopy.whatsapp.backTitle,
    backSubtitle: defaultCopy.whatsapp.backSubtitle,
    badge: defaultCopy.whatsapp.badge,
    ctaText: defaultCopy.whatsapp.ctaText,
  },
  facebook: {
    href: '#',
    qrImage: '',
    title: defaultCopy.facebook.title,
    subtitle: defaultCopy.facebook.subtitle,
    backTitle: defaultCopy.facebook.backTitle,
    backSubtitle: defaultCopy.facebook.backSubtitle,
    badge: defaultCopy.facebook.badge,
    ctaText: defaultCopy.facebook.ctaText,
  }
};

const finalConfig = Astro.props.config || platformConfigs[platform];

// Generate truly embedded high-resolution vector QR Code data URI
let embeddedQrDataUrl = '';
try {
  embeddedQrDataUrl = await QRCode.toDataURL(finalConfig.href, {
    margin: 1,
    width: 256,
    color: {
      dark: '#0369a1',
      light: '#ffffff'
    },
    errorCorrectionLevel: 'M'
  });
} catch (e) {
  console.error('Failed to generate embedded QR code', e);
  embeddedQrDataUrl = finalConfig.qrImage || '';
}

// 天文长曝光旋转同心星轨算法 (Celestial Pole Star Trails)
function arcPath(cx: number, cy: number, r: number, startDeg: number, endDeg: number) {
  const startRad = (startDeg * Math.PI) / 180;
  const endRad = (endDeg * Math.PI) / 180;
  const x1 = cx + r * Math.cos(startRad);
  const y1 = cy + r * Math.sin(startRad);
  const x2 = cx + r * Math.cos(endRad);
  const y2 = cy + r * Math.sin(endRad);
  const largeArc = Math.abs(endDeg - startDeg) > 180 ? 1 : 0;
  const sweep = endDeg > startDeg ? 1 : 0;
  return `M ${x1.toFixed(1)} ${y1.toFixed(1)} A ${r.toFixed(1)} ${r.toFixed(1)} 0 ${largeArc} ${sweep} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
}

// 正面 32 轨多级星等长曝光星轨群 (天极出框位于右上 cx: 340, cy: -40)
const frontStarTrails = (() => {
  const cx = 340;
  const cy = -40;
  const count = 32;
  const items = [];
  for (let i = 0; i < count; i++) {
    const r = 50 + i * (380 / count);
    const s = 100 + ((i * 17) % 24);
    const e = 188 + ((i * 23) % 36);
    const isMajor = (i % 7 === 0);
    const isMedium = (i % 3 === 0 && !isMajor);
    
    let strokeWidth = 0.55;
    let opacity = 0.18;
    let color = '#7dd3fc';
    
    if (isMajor) {
      strokeWidth = 1.35;
      opacity = 0.65;
      color = '#ffffff';
    } else if (isMedium) {
      strokeWidth = 0.85;
      opacity = 0.4;
      color = '#bae6fd';
    } else if (i % 2 === 0) {
      strokeWidth = 0.6;
      opacity = 0.26;
      color = '#38bdf8';
    }
    
    const d = arcPath(cx, cy, r, s, e);
    const isDashed = (i % 5 === 2);
    const dashArray = isDashed ? '36 9 18 6' : undefined;
    
    let nucleus: { x: number; y: number; r: number; opacity: number } | null = null;
    if (isMajor || i === 11 || i === 19 || i === 27) {
      const angle = s + (e - s) * 0.62;
      const rad = (angle * Math.PI) / 180;
      const sx = cx + r * Math.cos(rad);
      const sy = cy + r * Math.sin(rad);
      if (sx >= 5 && sx <= 315 && sy >= 5 && sy <= 109) {
        nucleus = {
          x: Number(sx.toFixed(1)),
          y: Number(sy.toFixed(1)),
          r: Number((strokeWidth * 0.9).toFixed(1)),
          opacity: Math.min(1, opacity + 0.35)
        };
      }
    }

    items.push({
      d,
      color,
      strokeWidth,
      opacity,
      isMajor,
      dashArray,
      nucleus
    });
  }
  return items;
})();

// 背面 16 轨微光星轨群
const backStarTrails = (() => {
  const cx = 340;
  const cy = -40;
  const count = 16;
  const items = [];
  for (let i = 0; i < count; i++) {
    const r = 70 + i * (350 / count);
    const s = 105 + ((i * 15) % 20);
    const e = 180 + ((i * 20) % 30);
    const isBright = (i % 4 === 0);
    const strokeWidth = isBright ? 1.0 : 0.6;
    const opacity = isBright ? 0.32 : 0.16;
    const color = isBright ? '#e0f2fe' : '#7dd3fc';
    const d = arcPath(cx, cy, r, s, e);
    items.push({ d, strokeWidth, opacity, color });
  }
  return items;
})();
---

<div class:list={['card-widget promo-widget', className]} id={id}>
  <div id="flip-wrapper">
    <div id="flip-content">
      
      <!-- ============================================== -->
      <!-- FRONT FACE: 方案A 极光流体天蓝 + 真实天文长曝光星轨正面 -->
      <!-- ============================================== -->
      <div
        class="face front-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感升维：真实天文长曝光同心星轨、四角十字衍射星芒、流星划痕与破空纸飞机 -->
        <div class="promo-scene-art promo-watermark" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="promo-meteor-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0"/>
                <stop offset="70%" stop-color="#bae6fd" stop-opacity="0.5"/>
                <stop offset="100%" stop-color="#ffffff" stop-opacity="0.95"/>
              </linearGradient>
              <linearGradient id="plane-body-grad" x1="20" y1="70" x2="180" y2="180" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="100%" stop-color="#e0edff" />
              </linearGradient>
              <linearGradient id="plane-fold-grad" x1="40" y1="110" x2="150" y2="180" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#93c5fd" />
                <stop offset="100%" stop-color="#60a5fa" />
              </linearGradient>
              <linearGradient id="plane-under-grad" x1="70" y1="130" x2="120" y2="190" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#3b82f6" />
                <stop offset="100%" stop-color="#1d4ed8" />
              </linearGradient>
              <filter id="plane-shadow" x="-40%" y="-40%" width="180%" height="180%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="rgba(2, 44, 120, 0.45)" />
              </filter>
            </defs>

            <!-- 1. 天文长曝光同心星轨群 (Long Exposure Star Trails) -->
            {frontStarTrails.map((trail) => (
              <Fragment>
                {trail.isMajor && (
                  <path
                    d={trail.d}
                    fill="none"
                    stroke={trail.color}
                    stroke-width={trail.strokeWidth * 2.2}
                    opacity={trail.opacity * 0.28}
                    stroke-linecap="round"
                    filter="blur(1px)"
                  />
                )}
                <path
                  d={trail.d}
                  fill="none"
                  stroke={trail.color}
                  stroke-width={trail.strokeWidth}
                  opacity={trail.opacity}
                  stroke-linecap="round"
                  stroke-dasharray={trail.dashArray}
                />
                {trail.nucleus && (
                  <circle
                    cx={trail.nucleus.x}
                    cy={trail.nucleus.y}
                    r={trail.nucleus.r}
                    fill="#ffffff"
                    opacity={trail.nucleus.opacity}
                  />
                )}
              </Fragment>
            ))}

            <!-- 2. 天文望远镜四角十字衍射星芒 (Diffraction Spikes) -->
            <g transform="translate(188, 76)" opacity="0.92">
              <path d="M 0 -7 Q 0 0 7 0 Q 0 0 0 7 Q 0 0 -7 0 Q 0 0 0 -7 Z" fill="#ffffff" />
              <circle cx="0" cy="0" r="1.96" fill="#ffffff" />
              <circle cx="0" cy="0" r="11.2" fill="#ffffff" opacity="0.35" filter="blur(1px)" />
            </g>
            <g transform="translate(136, 24)" opacity="0.8">
              <path d="M 0 -4.6 Q 0 0 4.6 0 Q 0 0 0 4.6 Q 0 0 -4.6 0 Q 0 0 0 -4.6 Z" fill="#bae6fd" />
              <circle cx="0" cy="0" r="1.28" fill="#ffffff" />
              <circle cx="0" cy="0" r="7.36" fill="#bae6fd" opacity="0.35" filter="blur(1px)" />
            </g>
            <g transform="translate(270, 86)" opacity="0.72">
              <path d="M 0 -4 Q 0 0 4 0 Q 0 0 0 4 Q 0 0 -4 0 Q 0 0 0 -4 Z" fill="#e0f2fe" />
              <circle cx="0" cy="0" r="1.12" fill="#ffffff" />
              <circle cx="0" cy="0" r="6.4" fill="#e0f2fe" opacity="0.35" filter="blur(1px)" />
            </g>
            <g transform="translate(218, 98)" opacity="0.58">
              <path d="M 0 -3.2 Q 0 0 3.2 0 Q 0 0 0 3.2 Q 0 0 -3.2 0 Q 0 0 0 -3.2 Z" fill="#7dd3fc" />
              <circle cx="0" cy="0" r="0.89" fill="#ffffff" />
              <circle cx="0" cy="0" r="5.12" fill="#7dd3fc" opacity="0.35" filter="blur(1px)" />
            </g>

            <!-- 3. 彗星流光划痕 (Shooting Meteor Trail) -->
            <path d="M 125 14 L 182 50" stroke="url(#promo-meteor-grad)" stroke-width="1.6" stroke-linecap="round" />
            <circle cx="182" cy="50" r="1.6" fill="#ffffff" />
            <circle cx="182" cy="50" r="4.2" fill="#38bdf8" opacity="0.6" filter="blur(1px)" />

            <!-- 4. 纸飞机破空切线航迹虚线与光晕 -->
            <path d="M 170 66 C 198 48, 222 34, 236 25" fill="none" stroke="rgba(255, 255, 255, 0.55)" stroke-width="1.2" stroke-dasharray="3 3" stroke-linecap="round" />

            <!-- 5. 右侧领航穿行 3D 折纸飞机 -->
            <g transform="translate(230, 16) rotate(15)">
              <circle cx="20" cy="20" r="22" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1" stroke-dasharray="3 3"/>
              <circle cx="20" cy="20" r="17" fill="rgba(255, 255, 255, 0.12)" />
              <svg x="5" y="5" width="30" height="30" viewBox="14 68 168 118" fill="none" style="overflow: visible;">
                <g filter="url(#plane-shadow)">
                  <polygon points="175,76 22,126 84,148" fill="url(#plane-body-grad)" />
                  <polygon points="175,76 84,148 108,184" fill="url(#plane-fold-grad)" />
                  <polygon points="84,148 108,184 100,154" fill="url(#plane-under-grad)" opacity="0.9" />
                </g>
              </svg>
            </g>
          </svg>
        </div>

        <!-- 正面主体布局：毛玻璃微光圆舱 + 官方白折纸飞机 -->
        <div class="promo-front-body">
          <div class="promo-icon-emblem">
            <svg width="27" height="27" viewBox="14 68 168 118" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M98 175c-3.8 0-3.2-1.5-4.5-5.2L82 132.2 152.8 88" fill="rgba(255,255,255,0.72)" />
              <path d="M98 175c3 0 4.3-1.4 6-3l16-15.5-20-12" fill="rgba(255,255,255,0.48)" />
              <path d="M100 144.5l48.4 35.7c5.6 3.1 9.6 1.5 11-5.2l19.5-92c2-8.3-3.2-12-8.6-9.6L24.8 111c-8 3.2-8 7.7-1.4 9.7l37.4 11.7 86.8-54.8c4.1-2.5 7.8-1.2 4.7 1.6" fill="#ffffff" />
            </svg>
          </div>
          <div class="promo-front-info">
            <div class="promo-title-row">
              <span class="promo-title">{finalConfig.title}</span>
              <span class="promo-badge">{platformConfigs[platform].badge}</span>
            </div>
            <div class="promo-subtitle">{finalConfig.subtitle}</div>
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- BACK FACE: 完整设计的正向展示扫码后板         -->
      <!-- ============================================== -->
      <div
        class="face back-face"
        onclick={finalConfig.href && finalConfig.href !== '#' ? `window.open("${finalConfig.href}", "_blank")` : undefined}
      >
        <!-- 画面感：背面对应微透天文星轨底纹与十字星芒 -->
        <div class="promo-scene-art promo-scene-art--back promo-watermark promo-watermark--back" aria-hidden="true">
          <svg viewBox="0 0 320 114" fill="none" xmlns="http://www.w3.org/2000/svg">
            {backStarTrails.map((trail) => (
              <path
                d={trail.d}
                fill="none"
                stroke={trail.color}
                stroke-width={trail.strokeWidth}
                opacity={trail.opacity}
                stroke-linecap="round"
              />
            ))}
            <g transform="translate(120, 26)" opacity="0.65">
              <path d="M 0 -4 Q 0 0 4 0 Q 0 0 0 4 Q 0 0 -4 0 Q 0 0 0 -4 Z" fill="#bae6fd" />
              <circle cx="0" cy="0" r="1.12" fill="#ffffff" />
              <circle cx="0" cy="0" r="6.4" fill="#bae6fd" opacity="0.35" filter="blur(1px)" />
            </g>
            <g transform="translate(285, 82)" opacity="0.55">
              <path d="M 0 -3.5 Q 0 0 3.5 0 Q 0 0 0 3.5 Q 0 0 -3.5 0 Q 0 0 0 -3.5 Z" fill="#e0f2fe" />
              <circle cx="0" cy="0" r="0.98" fill="#ffffff" />
              <circle cx="0" cy="0" r="5.6" fill="#e0f2fe" opacity="0.35" filter="blur(1px)" />
            </g>
          </svg>
        </div>

        <!-- 背面主体左右网格布局 -->
        <div class="promo-back-grid">
          <!-- 左侧文字说明与快捷按钮 -->
          <div class="promo-back-left">
            <div class="promo-back-title">{finalConfig.backTitle}</div>
            <div class="promo-back-subtitle">{finalConfig.backSubtitle}</div>
            <div class="promo-cta-action">
              <a
                href={finalConfig.href}
                target="_blank"
                rel="noopener noreferrer"
                class="promo-cta-btn"
                onclick="event.stopPropagation();"
              >
                <span>{platformConfigs[platform].ctaText}</span>
                <span class="cta-arrow">&nearr;</span>
              </a>
            </div>
          </div>

          <!-- 右侧内嵌高清矢量二维码 -->
          <div class="promo-qr-chassis">
            <div class="promo-qr-wrapper">
              <img
                src={embeddedQrDataUrl}
                alt={`${finalConfig.title} 二维码`}
                class="promo-qr-img"
                loading="eager"
                decoding="sync"
              />
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  .promo-widget {
    display: block !important;
    position: relative !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    padding: 0 !important;
    border: none;
    height: 114px;
    border-radius: 8px;
    margin: 0 !important;
    overflow: visible !important;
    cursor: pointer;
  }

  #flip-wrapper {
    -webkit-perspective: 1000px;
    perspective: 1000px;
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    /* 核心：方案A 极光四阶多色域流体渐变 (皇家宝蓝 -> 电光蓝 -> 晴空蓝 -> 湖绿青) */
    --promo-bg-gradient: 
      radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.35) 0%, transparent 40%),
      radial-gradient(circle at 92% 82%, rgba(6, 182, 212, 0.45) 0%, transparent 45%),
      linear-gradient(135deg, #1d4ed8 0%, #2563eb 38%, #0284c7 72%, #06b6d4 100%);
    --promo-card-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.38), 0 2px 6px rgba(0, 0, 0, 0.05);
    --promo-border-color: rgba(255, 255, 255, 0.48);
  }

  :global([data-theme="dark"]) #flip-wrapper {
    --promo-bg-gradient: 
      radial-gradient(circle at 10% 12%, rgba(255, 255, 255, 0.15) 0%, transparent 40%),
      radial-gradient(circle at 92% 82%, rgba(6, 182, 212, 0.25) 0%, transparent 45%),
      linear-gradient(135deg, #0f172a 0%, #1e3a8a 38%, #1d4ed8 72%, #0369a1 100%);
    --promo-card-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6), 0 2px 6px rgba(0, 0, 0, 0.4);
    --promo-border-color: rgba(255, 255, 255, 0.22);
  }

  #flip-content {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .face {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    box-sizing: border-box !important;
    border-radius: 8px;
    background: var(--promo-bg-gradient);
    border: 1px solid var(--promo-border-color);
    box-shadow: var(--promo-card-shadow);
    color: #ffffff;
    overflow: hidden;
    padding: 12px 16px !important;
    display: flex !important;
    align-items: center !important;
    -webkit-backface-visibility: hidden !important;
    backface-visibility: hidden !important;
    /* 核心动画优化：0.85s 从容丝滑缓动曲线 */
    transition: transform 0.85s cubic-bezier(0.25, 1, 0.35, 1), opacity 0.35s ease, visibility 0.35s ease;
    will-change: transform, opacity;
  }

  /* 正面板：默认正对用户 (0deg) */
  .front-face {
    -webkit-transform: rotateY(0deg) !important;
    transform: rotateY(0deg) !important;
    z-index: 2;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* 背面板：默认背对用户 (-180deg) */
  .back-face {
    -webkit-transform: rotateY(-180deg) !important;
    transform: rotateY(-180deg) !important;
    z-index: 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* 悬停或聚焦时：正面翻出 (180deg) 且淡出；背面翻入正向 (0deg) 且显现 */
  .promo-widget:hover .front-face,
  .promo-widget:focus-within .front-face,
  #flip-wrapper:hover .front-face {
    -webkit-transform: rotateY(180deg) !important;
    transform: rotateY(180deg) !important;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition-delay: 0.15s;
  }

  .promo-widget:hover .back-face,
  .promo-widget:focus-within .back-face,
  #flip-wrapper:hover .back-face {
    -webkit-transform: rotateY(0deg) !important;
    transform: rotateY(0deg) !important;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 3;
    transition-delay: 0.15s;
  }

  /* 方案A 破空航线与广播电波全景场景 (Aurora & Flight Trail) */
  .promo-scene-art,
  .promo-watermark {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none !important;
    z-index: 1 !important;
    overflow: hidden !important;
  }

  .promo-scene-art svg,
  .promo-watermark svg {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  /* FRONT FACE 样式 */
  .promo-front-body {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 13px;
    width: 100%;
  }

  .promo-icon-emblem {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
