    letter-spacing: -0.02em;
  }

  :root[data-theme='dark'] .lab-hero__title {
    color: #f1f5f9;
  }

  .lab-hero__desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: #64748b;
    margin: 0 0 24px;
    max-width: 960px;
  }

  :root[data-theme='dark'] .lab-hero__desc {
    color: #94a3b8;
  }

  .lab-stats {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--style-border, #e2e8f0);
    padding-top: 18px;
  }

  :root[data-theme='dark'] .lab-stats {
    border-color: rgba(255, 255, 255, 0.08);
  }

  .stat-item strong {
    display: block;
    font-size: 19px;
    font-weight: 800;
    color: #425aef;
    font-family: var(--font-family-code, monospace);
  }

  :root[data-theme='dark'] .stat-item strong {
    color: #a5b4fc;
  }

  .stat-item small {
    font-size: 12px;
    color: #64748b;
  }

  :root[data-theme='dark'] .stat-item small {
    color: #94a3b8;
  }

  /* 2. 筛选与搜索栏 */
  .lab-filter-bar {
    padding: 14px 18px;
    border-radius: 8px;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--style-border, #e2e8f0);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
