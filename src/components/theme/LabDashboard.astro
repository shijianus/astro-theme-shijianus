---
import { OFFICIAL_LAB_EXPERIMENTS } from '../../data/lab-experiments';
import { LAB_CATEGORY_META, type LabCategory } from '../../lib/lab-schema';

const experiments = OFFICIAL_LAB_EXPERIMENTS;
const categories = Object.entries(LAB_CATEGORY_META) as Array<
  [LabCategory, { label: string; shortLabel: string; description: string }]
>;
const allTags = Array.from(
  new Set(experiments.flatMap((exp) => exp.tags))
);
---

<section id="lab-dashboard" class="lab-dashboard">
  <!-- 1. 顶部实验室 Hero -->
  <div class="lab-hero theme-card">
    <div class="lab-hero__content">
      <div class="lab-hero__top-row">
        <div class="lab-hero__badge">
          <span class="badge-dot"></span>
          <span>LAB EXPERIMENTS · 极客交互代码实验平台</span>
        </div>
        <div class="lab-hero__cta-group">
          <a href="/lab/playground/" class="lab-hero__cta is-primary" data-testid="hero-link-playground">
            ⚡ 进入独立代码工坊
          </a>
          <a href="/lab/algorithm-execution-tracer/" class="lab-hero__cta" data-testid="hero-link-tracer">
            🧭 算法逐步执行可视化
          </a>
        </div>
      </div>

      <h1 class="lab-hero__title">探索代码边界，把物理回响与执行逻辑融入数字界面</h1>
      <p class="lab-hero__desc">
        这里是集「实时互动实验展厅」、「隔离沙盒代码工坊」与「程序执行逻辑逐步可视化」于一体的极客试验田。所有实验均支持查看原理说明、检视完整源码、在独立 Opaque-Origin 安全沙盒中在线修改运行及导出分享。
      </p>

      <div class="lab-stats">
        <div class="stat-item">
          <strong>{experiments.length}</strong>
          <small>官方在线实验</small>
        </div>
        <div class="stat-item">
          <strong>0</strong>
          <small>首屏重型编辑器依赖</small>
        </div>
        <div class="stat-item">
          <strong>60 FPS</strong>
          <small>GPU 硬件加速</small>
        </div>
        <div class="stat-item">
          <strong>Opaque Sandbox</strong>
          <small>零 Cookie/DOM 越权隔离</small>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. 实验广场筛选与检索工具栏 -->
  <div class="lab-filter-bar theme-card" role="region" aria-label="实验检索与分类筛选">
    <div class="lab-filter-categories" role="tablist" aria-label="按实验分类浏览">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        class="lab-cat-pill is-active"
        data-filter-category="all"
      >
        全部实验 ({experiments.length})
      </button>
      {categories.map(([catKey, meta]) => {
        const count = experiments.filter((e) => e.category === catKey).length;
        if (count === 0) return null;
        return (
          <button
            type="button"
            role="tab"
            aria-selected="false"
            class="lab-cat-pill"
            data-filter-category={catKey}
          >
            {meta.shortLabel} ({count})
          </button>
        );
      })}
    </div>

    <div class="lab-filter-right">
      <select id="lab-tag-select" class="lab-tag-select" aria-label="按技术标签筛选">
        <option value="all">全部技术栈标签</option>
        {allTags.map((tag) => (
          <option value={tag}>#{tag}</option>
        ))}
      </select>
      <input
        id="lab-search-input"
        type="search"
        placeholder="搜索实验名称、算法或标签..."
        aria-label="搜索实验"
        class="lab-search-input"
      />
    </div>
  </div>

  <!-- 3. 实验模块网格 (100% 保留原有 4 大实时交互实验，并扩展至 6 大完整实验) -->
  <div id="lab-experiments-grid" class="lab-grid">
    <!-- 实验 1：天体星轨模拟器 -->
    <article
      class="lab-card theme-card"
      data-exp-slug="star-trails-simulator"
      data-exp-category="physics"
      data-exp-tags="Canvas,物理仿真,天体力学,极坐标,60FPS"
      data-exp-title="天体星轨模拟器 Star Trails Simulator Canvas 极坐标长曝光天球旋转物理引擎"
    >
      <div class="lab-card__header">
        <div class="card-icon">🌌</div>
        <div class="card-title-group">
          <div class="card-title-row">
            <h2 class="card-title">天体星轨模拟器 (Star Trails Simulator)</h2>
            <span class="card-badge">官方精选 · v1.2.0</span>
          </div>
          <span class="card-sub">Canvas 极坐标长曝光天球旋转物理引擎</span>
        </div>
      </div>

      <div class="canvas-preview-box">
        <canvas id="lab-star-canvas" width="460" height="220" class="lab-canvas"></canvas>
      </div>

      <div class="controls-grid">
        <div class="control-row">
          <label>地平纬度 (Latitude): <span id="lat-val">39° N</span></label>
          <input type="range" id="star-lat-slider" min="0" max="90" value="39" class="lab-slider" />
        </div>
        <div class="control-row">
          <label>旋转角速度 (Speed): <span id="speed-val">1.5x</span></label>
          <input type="range" id="star-speed-slider" min="1" max="50" value="15" class="lab-slider" />
        </div>
        <div class="control-actions">
          <button id="btn-star-reset" type="button" class="lab-btn">重置清屏</button>
          <button id="btn-star-bloom" type="button" class="lab-btn is-active">镜头光晕: 开启</button>
        </div>
      </div>

      <div class="lab-card__footer">
        <div class="card-tag-row">
          <span class="tech-tag">#Canvas</span>
          <span class="tech-tag">#极坐标</span>
          <span class="tech-tag">#60FPS</span>
        </div>
        <div class="card-action-links">
          <button
            type="button"
            class="lab-link-btn btn-open-source-modal"
            data-target-slug="star-trails-simulator"
          >
            📄 源码与原理
          </button>
          <a href="/lab/star-trails-simulator/" class="lab-link-btn">🔍 实验详情</a>
          <a href="/lab/playground/?slug=star-trails-simulator" class="lab-link-btn is-accent">
            ⚡ 在线编辑运行
          </a>
          <a href="/lab/preview/star-trails-simulator/" class="lab-link-btn" title="独立预览入口">
            ↗ 预览
          </a>
        </div>
      </div>
    </article>

    <!-- 实验 2：3D 纸飞机与气动尾流仿真 -->
    <article
      class="lab-card theme-card"
      data-exp-slug="aerodynamic-contrail"
      data-exp-category="physics"
      data-exp-tags="CSS 3D,空间矩阵,欧拉角,硬件加速"
      data-exp-title="3D 纸飞机与气动尾流 Aerodynamic Contrail CSS 3D Transform 空间投射与粒子喷射仿真"
    >
      <div class="lab-card__header">
        <div class="card-icon">✈️</div>
        <div class="card-title-group">
          <div class="card-title-row">
            <h2 class="card-title">3D 纸飞机与气动尾流 (Aerodynamic Contrail)</h2>
            <span class="card-badge">官方精选 · v1.1.0</span>
          </div>
          <span class="card-sub">CSS 3D Transform 空间投射与粒子喷射仿真</span>
        </div>
      </div>

      <div class="plane-preview-box">
        <div id="plane-viewport" class="plane-viewport">
          <div id="plane-3d" class="plane-3d">
            <svg class="plane-svg" viewBox="0 0 24 24" fill="none">
              <path d="M21.5 2.5L2 9.5l8.5 3 3 8.5 8-18.5z" fill="#425aef" />
              <path d="M10.5 12.5L21.5 2.5" stroke="#ffffff" stroke-width="1.5" />
            </svg>
          </div>
          <div id="contrail-particles" class="contrail-particles"></div>
        </div>
      </div>

      <div class="controls-grid">
        <div class="control-row">
          <label>俯仰角 (Pitch): <span id="pitch-val">15°</span></label>
          <input type="range" id="pitch-slider" min="-45" max="45" value="15" class="lab-slider" />
        </div>
        <div class="control-row">
          <label>滚转角 (Roll): <span id="roll-val">-10°</span></label>
          <input type="range" id="roll-slider" min="-60" max="60" value="-10" class="lab-slider" />
        </div>
        <div class="control-actions">
          <button id="btn-plane-turbo" type="button" class="lab-btn">🚀 喷气加速模式</button>
        </div>
      </div>

      <div class="lab-card__footer">
        <div class="card-tag-row">
          <span class="tech-tag">#CSS 3D</span>
          <span class="tech-tag">#欧拉角</span>
          <span class="tech-tag">#硬件加速</span>
        </div>
        <div class="card-action-links">
          <button
            type="button"
            class="lab-link-btn btn-open-source-modal"
            data-target-slug="aerodynamic-contrail"
          >
            📄 源码与原理
          </button>
          <a href="/lab/aerodynamic-contrail/" class="lab-link-btn">🔍 实验详情</a>
          <a href="/lab/playground/?slug=aerodynamic-contrail" class="lab-link-btn is-accent">
            ⚡ 在线编辑运行
          </a>
          <a href="/lab/preview/aerodynamic-contrail/" class="lab-link-btn" title="独立预览入口">
            ↗ 预览
          </a>
        </div>
      </div>
    </article>

    <!-- 实验 3：Web Audio 触觉声效矩阵 -->
    <article
      class="lab-card theme-card"
      data-exp-slug="web-audio-haptics"
      data-exp-category="audio"
      data-exp-tags="Web Audio,数字信号处理,音频合成,零外部依赖"
      data-exp-title="Web Audio 触觉声效矩阵 Audio Haptics 振荡器实时调频合成交互音效"
    >
      <div class="lab-card__header">
        <div class="card-icon">🎛️</div>
        <div class="card-title-group">
          <div class="card-title-row">
            <h2 class="card-title">Web Audio 触觉声效矩阵 (Audio Haptics)</h2>
            <span class="card-badge">官方精选 · v1.1.0</span>
          </div>
          <span class="card-sub">振荡器实时调频合成交互音效，0 外部音频文件</span>
        </div>
      </div>

      <div class="sound-pad-grid">
        <button class="sound-pad" data-tone="cyber">
          <span class="pad-icon">✨</span>
          <span class="pad-name">Cyber Chime</span>
          <small>880Hz 正弦琶音</small>
        </button>
        <button class="sound-pad" data-tone="laser">
          <span class="pad-icon">🔫</span>
          <span class="pad-name">Laser Pulse</span>
          <small>指数下扫频</small>
        </button>
        <button class="sound-pad" data-tone="click">
          <span class="pad-icon">⌨️</span>
          <span class="pad-name">Mechanical Clack</span>
          <small>高通瞬态脉冲</small>
        </button>
        <button class="sound-pad" data-tone="shutter">
          <span class="pad-icon">📸</span>
          <span class="pad-name">Camera Shutter</span>
          <small>双重机械快门</small>
        </button>
        <button class="sound-pad" data-tone="chord">
          <span class="pad-icon">🔮</span>
          <span class="pad-name">Success Chord</span>
          <small>大三和弦共振</small>
        </button>
        <button class="sound-pad" data-tone="jump">
          <span class="pad-icon">👾</span>
          <span class="pad-name">8-Bit Jump</span>
          <small>方波跳跃阶跃</small>
        </button>
      </div>
      <p class="sound-note">提示：点击任意打击垫即可由浏览器实时数学合成音频波形，延迟低于 10ms。</p>

      <div class="lab-card__footer">
        <div class="card-tag-row">
          <span class="tech-tag">#Web Audio</span>
          <span class="tech-tag">#DSP合成</span>
          <span class="tech-tag">#零音频文件</span>
        </div>
        <div class="card-action-links">
          <button
            type="button"
            class="lab-link-btn btn-open-source-modal"
            data-target-slug="web-audio-haptics"
          >
            📄 源码与原理
          </button>
          <a href="/lab/web-audio-haptics/" class="lab-link-btn">🔍 实验详情</a>
          <a href="/lab/playground/?slug=web-audio-haptics" class="lab-link-btn is-accent">
            ⚡ 在线编辑运行
          </a>
          <a href="/lab/preview/web-audio-haptics/" class="lab-link-btn" title="独立预览入口">
            ↗ 预览
          </a>
        </div>
      </div>
    </article>

    <!-- 实验 4：多币种国际结算与汇率换算器 -->
    <article
      class="lab-card theme-card"
      data-exp-slug="fx-currency-converter"
      data-exp-category="utility"
      data-exp-tags="汇率算法,金融精度,Stripe,工程实用"
      data-exp-title="多币种实时汇率换算器 FX Converter Stripe 国际收银台多币种自适应转换基准算法"
    >
      <div class="lab-card__header">
        <div class="card-icon">💱</div>
        <div class="card-title-group">
          <div class="card-title-row">
            <h2 class="card-title">多币种实时汇率换算器 (FX Converter)</h2>
            <span class="card-badge">官方精选 · v1.1.0</span>
          </div>
          <span class="card-sub">Stripe 国际收银台多币种自适应转换基准算法</span>
        </div>
      </div>

      <div class="fx-calc-box">
        <div class="fx-input-row">
          <div class="fx-field">
            <label>输入基准金额</label>
            <input type="number" id="fx-input-val" value="10" min="1" max="10000" class="fx-input" />
          </div>
          <div class="fx-field">
            <label>原币种</label>
            <select id="fx-from-curr" class="fx-select">
              <option value="USD">USD · 美元</option>
              <option value="CNY">CNY · 人民币</option>
              <option value="EUR">EUR · 欧元</option>
              <option value="JPY">JPY · 日元</option>
              <option value="GBP">GBP · 英镑</option>
              <option value="TWD">TWD · 新台币</option>
              <option value="HKD">HKD · 港币</option>
            </select>
          </div>
        </div>

        <div class="fx-result-grid">
          <div class="fx-result-card">
            <span class="fx-curr-code">CNY (人民币)</span>
            <strong id="fx-cny-out">¥ 72.50</strong>
          </div>
          <div class="fx-result-card">
            <span class="fx-curr-code">USD (美元)</span>
            <strong id="fx-usd-out">$ 10.00</strong>
          </div>
          <div class="fx-result-card">
            <span class="fx-curr-code">EUR (欧元)</span>
            <strong id="fx-eur-out">€ 9.20</strong>
          </div>
          <div class="fx-result-card">
            <span class="fx-curr-code">JPY (日元)</span>
            <strong id="fx-jpy-out">¥ 1520</strong>
          </div>
        </div>
      </div>

      <div class="lab-card__footer">
        <div class="card-tag-row">
          <span class="tech-tag">#汇率算法</span>
          <span class="tech-tag">#金融精度</span>
          <span class="tech-tag">#Stripe</span>
        </div>
        <div class="card-action-links">
          <button
            type="button"
            class="lab-link-btn btn-open-source-modal"
            data-target-slug="fx-currency-converter"
          >
            📄 源码与原理
          </button>
          <a href="/lab/fx-currency-converter/" class="lab-link-btn">🔍 实验详情</a>
          <a href="/lab/playground/?slug=fx-currency-converter" class="lab-link-btn is-accent">
            ⚡ 在线编辑运行
          </a>
          <a href="/lab/preview/fx-currency-converter/" class="lab-link-btn" title="独立预览入口">
            ↗ 预览
          </a>
        </div>
      </div>
    </article>

    <!-- 实验 5：算法逐步执行与调用栈追踪器 -->
    <article
      class="lab-card theme-card"
      data-exp-slug="algorithm-execution-tracer"
      data-exp-category="algorithm"
      data-exp-tags="执行可视化,调用栈,冒泡排序,二分查找,递归分治"
      data-exp-title="算法逐步执行与调用栈追踪器 Algorithm Step Visualizer 冒泡排序 二分查找 递归快速排序"
    >
      <div class="lab-card__header">
        <div class="card-icon">🧭</div>
        <div class="card-title-group">
          <div class="card-title-row">
            <h2 class="card-title">算法逐步执行与调用栈追踪器 (Step Visualizer)</h2>
            <span class="card-badge is-highlight">差异化核心 · v1.0.0</span>
          </div>
          <span class="card-sub">源码逐行高亮、变量监视、条件分支成立判定与递归调用栈时间线</span>
        </div>
      </div>

      <div class="algo-mini-preview">
        <div class="algo-mini-code ignore-opencc" data-no-translate="true">
          <div class="mini-line"><span>5</span>for (let j = 0; j &lt; n - 1 - i; j++) &#123;</div>
          <div class="mini-line is-active"><span>▶ 6</span>  if (arr[j] &gt; arr[j + 1]) &#123; // 38 &gt; 14 → TRUE</div>
          <div class="mini-line"><span>7</span>    [arr[j], arr[j + 1]] = [arr[j + 1], arr[j]];</div>
        </div>
        <div class="algo-mini-bars ignore-opencc" data-no-translate="true">
          <div class="m-bar is-cmp" style="height: 82%"><span>38</span></div>
          <div class="m-bar is-cmp" style="height: 36%"><span>14</span></div>
          <div class="m-bar" style="height: 66%"><span>29</span></div>
          <div class="m-bar" style="height: 22%"><span>7</span></div>
          <div class="m-bar is-ok" style="height: 95%"><span>42</span></div>
        </div>
      </div>

      <p class="sound-note">
        支持冒泡排序、二分查找与递归快速排序的「上一步 / 下一步 / 暂停 / 倍速重播」全过程状态剖析。
      </p>

      <div class="lab-card__footer">
        <div class="card-tag-row">
          <span class="tech-tag">#执行可视化</span>
          <span class="tech-tag">#调用栈</span>
          <span class="tech-tag">#单步调试</span>
        </div>
        <div class="card-action-links">
          <button
            type="button"
            class="lab-link-btn btn-open-source-modal"
            data-target-slug="algorithm-execution-tracer"
          >
            📄 源码与原理
          </button>
          <a href="/lab/algorithm-execution-tracer/" class="lab-link-btn is-accent">
            🧭 进入逐步追踪器
          </a>
          <a href="/lab/playground/?slug=algorithm-execution-tracer" class="lab-link-btn">
            ⚡ 在线编辑运行
          </a>
          <a href="/lab/preview/algorithm-execution-tracer/" class="lab-link-btn">
            ↗ 预览
          </a>
        </div>
      </div>
    </article>

    <!-- 实验 6：Verlet 积分悬链线质点物理仿真 (TypeScript) -->
    <article
      class="lab-card theme-card"
      data-exp-slug="verlet-rope-physics"
      data-exp-category="visual"
      data-exp-tags="TypeScript,Verlet积分,物理引擎,约束求解"
      data-exp-title="Verlet 积分悬链线质点物理仿真 TypeScript 质点弹簧约束求解器"
    >
      <div class="lab-card__header">
        <div class="card-icon">🧶</div>
        <div class="card-title-group">
          <div class="card-title-row">
            <h2 class="card-title">Verlet 悬链线质点物理仿真 (TypeScript)</h2>
            <span class="card-badge">TS 安全转译 · v1.0.0</span>
          </div>
          <span class="card-sub">基于 TypeScript 编写的零依赖质点-弹簧距离约束求解器</span>
        </div>
      </div>

      <div class="canvas-preview-box">
        <canvas id="lab-verlet-canvas" width="460" height="220" class="lab-canvas"></canvas>
      </div>

      <div class="controls-grid">
        <div class="control-actions">
          <button id="btn-verlet-wave" type="button" class="lab-btn is-active">
            ⚡ 施加横向张力脉冲
          </button>
          <button id="btn-verlet-gravity" type="button" class="lab-btn">
            重力方向: 标准向下
          </button>
        </div>
      </div>

      <div class="lab-card__footer">
        <div class="card-tag-row">
          <span class="tech-tag">#TypeScript</span>
          <span class="tech-tag">#Verlet积分</span>
          <span class="tech-tag">#物理引擎</span>
        </div>
        <div class="card-action-links">
          <button
            type="button"
            class="lab-link-btn btn-open-source-modal"
            data-target-slug="verlet-rope-physics"
          >
            📄 源码与原理
          </button>
          <a href="/lab/verlet-rope-physics/" class="lab-link-btn">🔍 实验详情</a>
          <a href="/lab/playground/?slug=verlet-rope-physics" class="lab-link-btn is-accent">
            ⚡ 在线编辑运行
          </a>
          <a href="/lab/preview/verlet-rope-physics/" class="lab-link-btn">
            ↗ 预览
          </a>
        </div>
      </div>
    </article>
  </div>

  <!-- 4. 社区共建与安全隔离架构说明栏 -->
  <div class="lab-community-banner theme-card">
    <div class="community-banner__left">
      <span class="community-eyebrow">COMMUNITY & SECURITY ARCHITECTURE · 渐进式社区共建与安全隔离</span>
      <h3>想分享你的交互实验或算法可视化作品？</h3>
      <p>
        你可以在「独立代码工坊」中直接修改任意实验源码，通过 JSON 导出或安全链接分享给他人。所有社区代码均运行在无 <code>allow-same-origin</code> 的独立 Opaque Origin 沙盒（<code>window.origin === &quot;null&quot;</code>）与严格 <code>connect-src &apos;none&apos;</code> CSP 下，从根本上保护博客账户、Cookie 与数据库安全。
      </p>
    </div>
    <div class="community-banner__actions">
      <a href="/lab/playground/" class="lab-hero__cta is-primary">🛠️ 创建并导出我的实验</a>
    </div>
  </div>

  <!-- 5. 轻量按需源码与原理查看模态框 (避免主页首屏加载重型编辑器) -->
  <div
    id="lab-source-modal"
    class="lab-modal-backdrop"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="lab-modal-title"
  >
    <div class="lab-modal-dialog theme-card">
      <div class="lab-modal-header">
        <div>
          <h3 id="lab-modal-title" class="lab-modal-title">实验源码与原理说明</h3>
          <small id="lab-modal-sub" class="lab-modal-sub"></small>
        </div>
        <button id="btn-close-lab-modal" type="button" class="lab-modal-close" aria-label="关闭源码窗口">
          ✕ 关闭
        </button>
      </div>

      <div class="lab-modal-body">
        <div class="modal-principles-box">
          <strong>核心算法与物理原理</strong>
          <p id="lab-modal-summary"></p>
          <ul id="lab-modal-points"></ul>
        </div>

        <div class="modal-files-box">
          <div id="lab-modal-file-tabs" class="modal-file-tabs"></div>
          <pre id="lab-modal-code" class="modal-code-pre ignore-opencc" data-no-translate="true"></pre>
        </div>
      </div>

      <div class="lab-modal-footer">
        <button id="btn-modal-copy" type="button" class="lab-btn">📋 复制当前源码</button>
        <a id="link-modal-playground" href="/lab/playground/" class="lab-btn is-active">
          ⚡ 在代码工坊中修改并运行
        </a>
      </div>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    serializedExperiments: experiments.map((e) => ({
      slug: e.slug,
      title: e.title,
      subtitle: e.subtitle,
      principles: e.principles,
      files: e.files,
    })),
  }}
>
  (() => {
    // 1. 星轨模拟器 (保留原有完整逻辑)
    const canvas = document.getElementById('lab-star-canvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const latSlider = document.getElementById('star-lat-slider');
      const latVal = document.getElementById('lat-val');
      const speedSlider = document.getElementById('star-speed-slider');
      const speedVal = document.getElementById('speed-val');
      const btnReset = document.getElementById('btn-star-reset');
      const btnBloom = document.getElementById('btn-star-bloom');

      let angle = 0;
      let stars = [];
      let bloom = true;

      for (let i = 0; i < 120; i++) {
        stars.push({
          radius: Math.random() * 160 + 10,
          theta: Math.random() * Math.PI * 2,
          size: Math.random() * 1.5 + 0.5,
          color: i % 5 === 0 ? '#60a5fa' : i % 8 === 0 ? '#fde047' : '#ffffff',
        });
      }

      function drawStars() {
        requestAnimationFrame(drawStars);
        const speed = (speedSlider ? speedSlider.value : 15) * 0.0005;
        angle += speed;

        ctx.fillStyle = 'rgba(10, 15, 29, 0.15)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const cx = canvas.width / 2;
        const cy = canvas.height * (1 - ((latSlider ? latSlider.value : 39) / 90) * 0.7);

        stars.forEach((s) => {
          const curTheta = s.theta + angle;
          const x = cx + Math.cos(curTheta) * s.radius;
          const y = cy + Math.sin(curTheta) * (s.radius * 0.6);

          ctx.beginPath();
          ctx.arc(x, y, s.size, 0, Math.PI * 2);
          ctx.fillStyle = s.color;
          if (bloom) {
            ctx.shadowBlur = 6;
            ctx.shadowColor = s.color;
          } else {
            ctx.shadowBlur = 0;
          }
          ctx.fill();
        });
      }
      drawStars();

      if (latSlider && latVal) {
        latSlider.addEventListener('input', () => {
          latVal.textContent = latSlider.value + '° N';
        });
      }

      if (speedSlider && speedVal) {
        speedSlider.addEventListener('input', () => {
          speedVal.textContent = (speedSlider.value / 10).toFixed(1) + 'x';
        });
      }

      if (btnReset) {
        btnReset.addEventListener('click', () => {
          ctx.fillStyle = '#0a0f1d';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
        });
      }

      if (btnBloom) {
        btnBloom.addEventListener('click', () => {
          bloom = !bloom;
          btnBloom.textContent = bloom ? '镜头光晕: 开启' : '镜头光晕: 关闭';
          btnBloom.classList.toggle('is-active', bloom);
        });
      }
    }

    // 2. 3D 纸飞机 (保留原有完整逻辑)
    const plane = document.getElementById('plane-3d');
    const pitchSlider = document.getElementById('pitch-slider');
    const pitchVal = document.getElementById('pitch-val');
    const rollSlider = document.getElementById('roll-slider');
    const rollVal = document.getElementById('roll-val');
    const btnTurbo = document.getElementById('btn-plane-turbo');

    function updatePlaneTransform() {
      if (!plane) return;
      const p = pitchSlider ? pitchSlider.value : 15;
      const r = rollSlider ? rollSlider.value : -10;
      plane.style.transform = `rotateX(${p}deg) rotateZ(${r}deg)`;
    }

    if (pitchSlider && pitchVal) {
      pitchSlider.addEventListener('input', () => {
        pitchVal.textContent = pitchSlider.value + '°';
        updatePlaneTransform();
      });
    }

    if (rollSlider && rollVal) {
      rollSlider.addEventListener('input', () => {
        rollVal.textContent = rollSlider.value + '°';
        updatePlaneTransform();
      });
    }

    if (btnTurbo) {
      btnTurbo.addEventListener('click', () => {
        if (!plane) return;
        plane.classList.add('turbo-spin');
        setTimeout(() => plane.classList.remove('turbo-spin'), 1200);
      });
    }

    // 3. Web Audio 触觉声效矩阵 (保留原有完整逻辑)
    let audioCtx = null;
    function getAudioCtx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function playTone(type) {
      const ctx = getAudioCtx();
      const t = ctx.currentTime;

      if (type === 'cyber') {
        [880, 1108, 1318, 1760].forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.frequency.setValueAtTime(freq, t + idx * 0.05);
          gain.gain.setValueAtTime(0.1, t + idx * 0.05);
          gain.gain.exponentialRampToValueAtTime(0.001, t + idx * 0.05 + 0.3);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(t + idx * 0.05);
          osc.stop(t + idx * 0.05 + 0.35);
        });
      } else if (type === 'laser') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.frequency.setValueAtTime(1400, t);
        osc.frequency.exponentialRampToValueAtTime(100, t + 0.2);
        gain.gain.setValueAtTime(0.2, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(t);
        osc.stop(t + 0.25);
      } else if (type === 'click') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(600, t);
        gain.gain.setValueAtTime(0.15, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.04);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(t);
        osc.stop(t + 0.05);
      } else if (type === 'shutter') {
        [400, 250].forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(freq, t + idx * 0.08);
          gain.gain.setValueAtTime(0.12, t + idx * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.001, t + idx * 0.08 + 0.06);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(t + idx * 0.08);
          osc.stop(t + idx * 0.08 + 0.07);
        });
      } else if (type === 'chord') {
        [523.25, 659.25, 783.99, 1046.5].forEach((freq) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, t);
          gain.gain.setValueAtTime(0.08, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.6);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(t);
          osc.stop(t + 0.65);
        });
      } else if (type === 'jump') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(150, t);
        osc.frequency.linearRampToValueAtTime(600, t + 0.15);
        gain.gain.setValueAtTime(0.1, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.18);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(t);
        osc.stop(t + 0.2);
      }
    }

    const soundPads = document.querySelectorAll('.sound-pad');
    soundPads.forEach((pad) => {
      pad.addEventListener('click', () => {
        const tone = pad.dataset.tone;
        if (tone) playTone(tone);
      });
    });

    // 4. 多币种汇率换算器 (保留原有完整逻辑)
    const rates = {
      USD: 1,
      CNY: 7.25,
      EUR: 0.92,
      JPY: 152.0,
      GBP: 0.77,
      TWD: 32.1,
      HKD: 7.78,
    };

    const fxInput = document.getElementById('fx-input-val');
    const fxFrom = document.getElementById('fx-from-curr');
    const outCny = document.getElementById('fx-cny-out');
    const outUsd = document.getElementById('fx-usd-out');
    const outEur = document.getElementById('fx-eur-out');
    const outJpy = document.getElementById('fx-jpy-out');

    function calculateFX() {
      if (!fxInput || !fxFrom) return;
      const val = parseFloat(fxInput.value) || 0;
      const fromCurr = fxFrom.value;
      const inUSD = val / (rates[fromCurr] || 1);

      if (outCny) outCny.textContent = '¥ ' + (inUSD * rates.CNY).toFixed(2);
      if (outUsd) outUsd.textContent = '$ ' + inUSD.toFixed(2);
      if (outEur) outEur.textContent = '€ ' + (inUSD * rates.EUR).toFixed(2);
      if (outJpy) outJpy.textContent = '¥ ' + Math.round(inUSD * rates.JPY);
    }

    if (fxInput) fxInput.addEventListener('input', calculateFX);
    if (fxFrom) fxFrom.addEventListener('change', calculateFX);

    // 6. Verlet 悬链线质点物理仿真卡片预览
    const vCanvas = document.getElementById('lab-verlet-canvas');
    if (vCanvas) {
      const vCtx = vCanvas.getContext('2d');
      const btnWave = document.getElementById('btn-verlet-wave');
      const btnGrav = document.getElementById('btn-verlet-gravity');
      let gravDir = 1;
      const nodes = Array.from({ length: 16 }, (_, i) => ({
        x: 140 + i * 11,
        y: 35,
        oldX: 140 + i * 11,
        oldY: 35,
        pinned: i === 0,
      }));

      function drawVerlet() {
        requestAnimationFrame(drawVerlet);
        for (const p of nodes) {
          if (p.pinned) continue;
          const vx = (p.x - p.oldX) * 0.985;
          const vy = (p.y - p.oldY) * 0.985;
          p.oldX = p.x;
          p.oldY = p.y;
          p.x += vx;
          p.y += vy + 0.38 * gravDir;
        }
        for (let k = 0; k < 5; k++) {
          for (let i = 0; i < nodes.length - 1; i++) {
            const a = nodes[i];
            const b = nodes[i + 1];
            const dx = b.x - a.x;
            const dy = b.y - a.y;
            const d = Math.hypot(dx, dy) || 0.001;
            const diff = (10 - d) / d;
            if (!a.pinned) {
              a.x -= dx * diff * 0.5;
              a.y -= dy * diff * 0.5;
            }
            if (!b.pinned) {
              b.x += dx * diff * 0.5;
              b.y += dy * diff * 0.5;
            }
          }
        }
        vCtx.fillStyle = '#0a0f1d';
        vCtx.fillRect(0, 0, vCanvas.width, vCanvas.height);
        vCtx.beginPath();
        vCtx.moveTo(nodes[0].x, nodes[0].y);
        for (let i = 1; i < nodes.length; i++) vCtx.lineTo(nodes[i].x, nodes[i].y);
        vCtx.strokeStyle = '#60a5fa';
        vCtx.lineWidth = 3;
        vCtx.stroke();
        nodes.forEach((p, idx) => {
          vCtx.beginPath();
          vCtx.arc(p.x, p.y, idx === 0 || idx === nodes.length - 1 ? 5 : 3, 0, Math.PI * 2);
          vCtx.fillStyle = idx === 0 ? '#f59e0b' : idx === nodes.length - 1 ? '#34d399' : '#e2e8f0';
          vCtx.fill();
        });
      }
      drawVerlet();

      if (btnWave) {
        btnWave.addEventListener('click', () => {
          nodes[nodes.length - 1].oldX -= 28;
        });
      }
      if (btnGrav) {
        btnGrav.addEventListener('click', () => {
          gravDir = gravDir === 1 ? -0.5 : 1;
          btnGrav.textContent = gravDir === 1 ? '重力方向: 标准向下' : '重力方向: 微重力反演';
        });
      }
    }

    // 7. 分类、标签与关键词实时筛选
    let currentCat = 'all';
    let currentTag = 'all';
    let currentQuery = '';

    const catButtons = document.querySelectorAll('[data-filter-category]');
    const tagSelect = document.getElementById('lab-tag-select');
    const searchInput = document.getElementById('lab-search-input');
    const expCards = document.querySelectorAll('#lab-experiments-grid [data-exp-slug]');

    function applyFilters() {
      expCards.forEach((card) => {
        const cat = card.getAttribute('data-exp-category') || '';
        const tags = (card.getAttribute('data-exp-tags') || '').split(',');
        const title = (card.getAttribute('data-exp-title') || '').toLowerCase();
        const liveRenderedText = (card.textContent || '').toLowerCase();

        const matchCat = currentCat === 'all' || cat === currentCat;
        const matchTag = currentTag === 'all' || tags.includes(currentTag);
        const matchQuery =
          !currentQuery ||
          title.includes(currentQuery) ||
          liveRenderedText.includes(currentQuery) ||
          tags.some((t) => t.toLowerCase().includes(currentQuery));

        card.style.display = matchCat && matchTag && matchQuery ? '' : 'none';
      });
    }

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCat = btn.getAttribute('data-filter-category') || 'all';
        catButtons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        applyFilters();
      });
    });

    if (tagSelect) {
      tagSelect.addEventListener('change', () => {
        currentTag = tagSelect.value;
        applyFilters();
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        currentQuery = (searchInput.value || '').trim().toLowerCase();
        applyFilters();
      });
    }

    // 8. 源码与原理轻量查看弹窗
    const modal = document.getElementById('lab-source-modal');
    const modalTitle = document.getElementById('lab-modal-title');
    const modalSub = document.getElementById('lab-modal-sub');
    const modalSummary = document.getElementById('lab-modal-summary');
    const modalPoints = document.getElementById('lab-modal-points');
    const modalTabs = document.getElementById('lab-modal-file-tabs');
    const modalCode = document.getElementById('lab-modal-code');
    const modalClose = document.getElementById('btn-close-lab-modal');
    const modalCopy = document.getElementById('btn-modal-copy');
    const modalPgLink = document.getElementById('link-modal-playground');

    let lastModalTriggerEl = null;

    function closeSourceModal() {
      if (!modal || modal.hidden) return;
      modal.hidden = true;
      if (lastModalTriggerEl && typeof lastModalTriggerEl.focus === 'function') {
        lastModalTriggerEl.focus();
      }
      lastModalTriggerEl = null;
    }

    function openSourceModal(slug, triggerEl) {
      const exp = (serializedExperiments || []).find((item) => item.slug === slug);
      if (!exp || !modal) return;
      lastModalTriggerEl = triggerEl || document.activeElement;

      if (modalTitle) modalTitle.textContent = exp.title;
      if (modalSub) modalSub.textContent = exp.subtitle;
      if (modalSummary) modalSummary.textContent = exp.principles.summary;
      if (modalPoints) {
        modalPoints.innerHTML = '';
        (exp.principles.keyPoints || []).forEach((pt) => {
          const li = document.createElement('li');
          li.textContent = pt;
          modalPoints.appendChild(li);
        });
      }
      if (modalPgLink) {
        modalPgLink.setAttribute('href', `/lab/playground/?slug=${encodeURIComponent(exp.slug)}`);
      }

      function selectModalFile(idx) {
        const f = exp.files[idx] || exp.files[0];
        if (modalCode && f) modalCode.textContent = f.content;
        if (modalTabs) {
          Array.from(modalTabs.children).forEach((tabEl, i) => {
            tabEl.classList.toggle('is-active', i === idx);
          });
        }
      }

      if (modalTabs) {
        modalTabs.innerHTML = '';
        exp.files.forEach((f, idx) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = `modal-tab-btn ${idx === 0 ? 'is-active' : ''}`;
          b.textContent = f.name;
          b.addEventListener('click', () => selectModalFile(idx));
          modalTabs.appendChild(b);
        });
      }

      selectModalFile(0);
      modal.hidden = false;
      if (modalClose && typeof modalClose.focus === 'function') {
        modalClose.focus();
      }
    }

    document.querySelectorAll('.btn-open-source-modal').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-target-slug');
        if (slug) openSourceModal(slug, btn);
      });
    });

    if (modalClose && modal) {
      modalClose.addEventListener('click', closeSourceModal);
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeSourceModal();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.hidden) {
        e.preventDefault();
        closeSourceModal();
      }
    });

    if (modalCopy && modalCode) {
      modalCopy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(modalCode.textContent || '');
          modalCopy.textContent = '✓ 已复制源码';
          setTimeout(() => {
            modalCopy.textContent = '📋 复制当前源码';
          }, 2000);
        } catch {}
      });
    }
  })();
</script>

