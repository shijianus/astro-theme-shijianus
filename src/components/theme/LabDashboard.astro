---
import { siteConfig } from '../../config/site';

const site = siteConfig.site;
---

<section id="lab-dashboard" class="lab-dashboard">
  <!-- 1. 顶部实验室 Hero -->
  <div class="lab-hero theme-card">
    <div class="lab-hero__content">
      <div class="lab-hero__badge">
        <span class="badge-dot"></span>
        <span>LAB EXPERIMENTS · 极客试验场</span>
      </div>
      <h1 class="lab-hero__title">探索代码边界，把物理回响融入数字界面</h1>
      <p class="lab-hero__desc">
        这里是尚未并入主站常规阅读流的创新交互、物理渲染算法、Web Audio 声效与底层工程原型的孵化池。所有模块均可实时交互与参数调节。
      </p>

      <div class="lab-stats">
        <div class="stat-item">
          <strong>5</strong>
          <small>在线交互实验</small>
        </div>
        <div class="stat-item">
          <strong>0</strong>
          <small>依赖外部三方库</small>
        </div>
        <div class="stat-item">
          <strong>60 FPS</strong>
          <small>GPU 硬件加速</small>
        </div>
        <div class="stat-item">
          <strong>100%</strong>
          <small>原生 TS / Canvas</small>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. 实验模块网格 -->
  <div class="lab-grid">
    <!-- 实验 1：天体星轨模拟器 -->
    <div class="lab-card theme-card">
      <div class="lab-card__header">
        <div class="card-icon">🌌</div>
        <div class="card-title-group">
          <h2 class="card-title">天体星轨模拟器 (Star Trails Simulator)</h2>
          <span class="card-sub">Canvas 极坐标长曝光天球旋转物理引擎</span>
        </div>
      </div>

      <div class="canvas-preview-box">
        <canvas id="lab-star-canvas" width="460" height="220" class="lab-canvas"></canvas>
      </div>

      <div class="controls-grid">
        <div class="control-row">
          <label>地平纬度 (Latitude): <span id="lat-val">39° N</span></label>
          <input type="range" id="star-lat-slider" min="0" max="90" value="39" class="lab-slider" />
        </div>
        <div class="control-row">
          <label>旋转角速度 (Speed): <span id="speed-val">1.5x</span></label>
          <input type="range" id="star-speed-slider" min="1" max="50" value="15" class="lab-slider" />
        </div>
        <div class="control-actions">
          <button id="btn-star-reset" type="button" class="lab-btn">重置清屏</button>
          <button id="btn-star-bloom" type="button" class="lab-btn is-active">镜头光晕: 开启</button>
        </div>
      </div>
    </div>

    <!-- 实验 2：3D 纸飞机与气动尾流仿真 -->
    <div class="lab-card theme-card">
      <div class="lab-card__header">
        <div class="card-icon">✈️</div>
        <div class="card-title-group">
          <h2 class="card-title">3D 纸飞机与气动尾流 (Aerodynamic Contrail)</h2>
          <span class="card-sub">CSS 3D Transform 空间投射与粒子喷射仿真</span>
        </div>
      </div>

      <div class="plane-preview-box">
        <div id="plane-viewport" class="plane-viewport">
          <div id="plane-3d" class="plane-3d">
            <svg class="plane-svg" viewBox="0 0 24 24" fill="none">
              <path d="M21.5 2.5L2 9.5l8.5 3 3 8.5 8-18.5z" fill="#425aef" />
              <path d="M10.5 12.5L21.5 2.5" stroke="#ffffff" stroke-width="1.5" />
            </svg>
          </div>
          <div id="contrail-particles" class="contrail-particles"></div>
        </div>
      </div>

      <div class="controls-grid">
        <div class="control-row">
          <label>俯仰角 (Pitch): <span id="pitch-val">15°</span></label>
          <input type="range" id="pitch-slider" min="-45" max="45" value="15" class="lab-slider" />
        </div>
        <div class="control-row">
          <label>滚转角 (Roll): <span id="roll-val">-10°</span></label>
          <input type="range" id="roll-slider" min="-60" max="60" value="-10" class="lab-slider" />
        </div>
        <div class="control-actions">
          <button id="btn-plane-turbo" type="button" class="lab-btn">🚀 喷气加速模式</button>
        </div>
      </div>
    </div>

    <!-- 实验 3：Web Audio 触觉声效矩阵 -->
    <div class="lab-card theme-card">
      <div class="lab-card__header">
        <div class="card-icon">🎛️</div>
        <div class="card-title-group">
          <h2 class="card-title">Web Audio 触觉声效矩阵 (Audio Haptics)</h2>
          <span class="card-sub">振荡器实时调频合成交互音效，0 外部音频文件</span>
        </div>
      </div>

      <div class="sound-pad-grid">
        <button class="sound-pad" data-tone="cyber">
          <span class="pad-icon">✨</span>
          <span class="pad-name">Cyber Chime</span>
          <small>880Hz 正弦琶音</small>
        </button>
        <button class="sound-pad" data-tone="laser">
          <span class="pad-icon">🔫</span>
          <span class="pad-name">Laser Pulse</span>
          <small>指数下扫频</small>
        </button>
        <button class="sound-pad" data-tone="click">
          <span class="pad-icon">⌨️</span>
          <span class="pad-name">Mechanical Clack</span>
          <small>高通瞬态脉冲</small>
        </button>
        <button class="sound-pad" data-tone="shutter">
          <span class="pad-icon">📸</span>
          <span class="pad-name">Camera Shutter</span>
          <small>双重机械快门</small>
        </button>
        <button class="sound-pad" data-tone="chord">
          <span class="pad-icon">🔮</span>
          <span class="pad-name">Success Chord</span>
          <small>大三和弦共振</small>
        </button>
        <button class="sound-pad" data-tone="jump">
          <span class="pad-icon">👾</span>
          <span class="pad-name">8-Bit Jump</span>
          <small>方波跳跃阶跃</small>
        </button>
      </div>
      <p class="sound-note">提示：点击任意打击垫即可由浏览器实时数学合成音频波形，延迟低于 10ms。</p>
    </div>

    <!-- 实验 4：多币种国际结算与汇率换算器 -->
    <div class="lab-card theme-card">
      <div class="lab-card__header">
        <div class="card-icon">💱</div>
        <div class="card-title-group">
          <h2 class="card-title">多币种实时汇率换算器 (FX Converter)</h2>
          <span class="card-sub">Stripe 国际收银台多币种自适应转换基准算法</span>
        </div>
      </div>

      <div class="fx-calc-box">
        <div class="fx-input-row">
          <div class="fx-field">
            <label>输入基准金额</label>
            <input type="number" id="fx-input-val" value="10" min="1" max="10000" class="fx-input" />
          </div>
          <div class="fx-field">
            <label>原币种</label>
            <select id="fx-from-curr" class="fx-select">
              <option value="USD">USD · 美元</option>
              <option value="CNY">CNY · 人民币</option>
              <option value="EUR">EUR · 欧元</option>
              <option value="JPY">JPY · 日元</option>
              <option value="GBP">GBP · 英镑</option>
              <option value="TWD">TWD · 新台币</option>
              <option value="HKD">HKD · 港币</option>
            </select>
          </div>
        </div>

        <div class="fx-result-grid">
          <div class="fx-result-card">
            <span class="fx-curr-code">CNY (人民币)</span>
            <strong id="fx-cny-out">¥ 72.50</strong>
          </div>
          <div class="fx-result-card">
            <span class="fx-curr-code">USD (美元)</span>
            <strong id="fx-usd-out">$ 10.00</strong>
          </div>
          <div class="fx-result-card">
            <span class="fx-curr-code">EUR (欧元)</span>
            <strong id="fx-eur-out">€ 9.20</strong>
          </div>
          <div class="fx-result-card">
            <span class="fx-curr-code">JPY (日元)</span>
            <strong id="fx-jpy-out">¥ 1520</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    // 1. 星轨模拟器
    const canvas = document.getElementById('lab-star-canvas');
    if (canvas) {
      const ctx = canvas.getContext('2d');
      const latSlider = document.getElementById('star-lat-slider');
      const latVal = document.getElementById('lat-val');
      const speedSlider = document.getElementById('star-speed-slider');
      const speedVal = document.getElementById('speed-val');
      const btnReset = document.getElementById('btn-star-reset');
      const btnBloom = document.getElementById('btn-star-bloom');

      let angle = 0;
      let stars = [];
      let bloom = true;

      for (let i = 0; i < 120; i++) {
        stars.push({
          radius: Math.random() * 160 + 10,
          theta: Math.random() * Math.PI * 2,
          size: Math.random() * 1.5 + 0.5,
          color: i % 5 === 0 ? '#60a5fa' : i % 8 === 0 ? '#fde047' : '#ffffff',
        });
      }

      function drawStars() {
        requestAnimationFrame(drawStars);
        const speed = (speedSlider ? speedSlider.value : 15) * 0.0005;
        angle += speed;

        ctx.fillStyle = 'rgba(10, 15, 29, 0.15)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const cx = canvas.width / 2;
        const cy = canvas.height * (1 - (latSlider ? latSlider.value : 39) / 90 * 0.7);

        stars.forEach((s) => {
          const curTheta = s.theta + angle;
          const x = cx + Math.cos(curTheta) * s.radius;
          const y = cy + Math.sin(curTheta) * (s.radius * 0.6);

          ctx.beginPath();
          ctx.arc(x, y, s.size, 0, Math.PI * 2);
          ctx.fillStyle = s.color;
          if (bloom) {
            ctx.shadowBlur = 6;
            ctx.shadowColor = s.color;
          } else {
            ctx.shadowBlur = 0;
          }
          ctx.fill();
        });
      }
      drawStars();

      if (latSlider && latVal) {
        latSlider.addEventListener('input', () => {
          latVal.textContent = latSlider.value + '° N';
        });
      }

      if (speedSlider && speedVal) {
        speedSlider.addEventListener('input', () => {
          speedVal.textContent = (speedSlider.value / 10).toFixed(1) + 'x';
        });
      }

      if (btnReset) {
        btnReset.addEventListener('click', () => {
          ctx.fillStyle = '#0a0f1d';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
        });
      }

      if (btnBloom) {
        btnBloom.addEventListener('click', () => {
          bloom = !bloom;
          btnBloom.textContent = bloom ? '镜头光晕: 开启' : '镜头光晕: 关闭';
          btnBloom.classList.toggle('is-active', bloom);
        });
      }
    }

    // 2. 3D 纸飞机
    const plane = document.getElementById('plane-3d');
    const pitchSlider = document.getElementById('pitch-slider');
    const pitchVal = document.getElementById('pitch-val');
    const rollSlider = document.getElementById('roll-slider');
    const rollVal = document.getElementById('roll-val');
    const btnTurbo = document.getElementById('btn-plane-turbo');

    function updatePlaneTransform() {
      if (!plane) return;
      const p = pitchSlider ? pitchSlider.value : 15;
      const r = rollSlider ? rollSlider.value : -10;
      plane.style.transform = `rotateX(${p}deg) rotateZ(${r}deg)`;
    }

    if (pitchSlider && pitchVal) {
      pitchSlider.addEventListener('input', () => {
        pitchVal.textContent = pitchSlider.value + '°';
        updatePlaneTransform();
      });
    }

    if (rollSlider && rollVal) {
      rollSlider.addEventListener('input', () => {
        rollVal.textContent = rollSlider.value + '°';
        updatePlaneTransform();
      });
    }

    if (btnTurbo) {
      btnTurbo.addEventListener('click', () => {
        if (!plane) return;
        plane.classList.add('turbo-spin');
        setTimeout(() => plane.classList.remove('turbo-spin'), 1200);
      });
    }

    // 3. Web Audio 触觉声效矩阵
    let audioCtx = null;
    function getAudioCtx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function playTone(type) {
      const ctx = getAudioCtx();
      const t = ctx.currentTime;

      if (type === 'cyber') {
        [880, 1108, 1318, 1760].forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.frequency.setValueAtTime(freq, t + idx * 0.05);
          gain.gain.setValueAtTime(0.1, t + idx * 0.05);
          gain.gain.exponentialRampToValueAtTime(0.001, t + idx * 0.05 + 0.3);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(t + idx * 0.05);
          osc.stop(t + idx * 0.05 + 0.35);
        });
      } else if (type === 'laser') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.frequency.setValueAtTime(1400, t);
        osc.frequency.exponentialRampToValueAtTime(100, t + 0.2);
        gain.gain.setValueAtTime(0.2, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.2);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(t);
        osc.stop(t + 0.25);
      } else if (type === 'click') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(600, t);
        gain.gain.setValueAtTime(0.15, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.04);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(t);
        osc.stop(t + 0.05);
      } else if (type === 'shutter') {
        [400, 250].forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(freq, t + idx * 0.08);
          gain.gain.setValueAtTime(0.12, t + idx * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.001, t + idx * 0.08 + 0.06);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(t + idx * 0.08);
          osc.stop(t + idx * 0.08 + 0.07);
        });
      } else if (type === 'chord') {
        [523.25, 659.25, 783.99, 1046.5].forEach((freq) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, t);
          gain.gain.setValueAtTime(0.08, t);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.6);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(t);
          osc.stop(t + 0.65);
        });
      } else if (type === 'jump') {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(150, t);
        osc.frequency.linearRampToValueAtTime(600, t + 0.15);
        gain.gain.setValueAtTime(0.1, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.18);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(t);
        osc.stop(t + 0.2);
      }
    }

    const soundPads = document.querySelectorAll('.sound-pad');
    soundPads.forEach((pad) => {
      pad.addEventListener('click', () => {
        const tone = pad.dataset.tone;
        if (tone) playTone(tone);
      });
    });

    // 4. 多币种汇率换算器
    const rates = {
      USD: 1,
      CNY: 7.25,
      EUR: 0.92,
      JPY: 152.0,
      GBP: 0.77,
      TWD: 32.1,
      HKD: 7.78,
    };

    const fxInput = document.getElementById('fx-input-val');
    const fxFrom = document.getElementById('fx-from-curr');
    const outCny = document.getElementById('fx-cny-out');
    const outUsd = document.getElementById('fx-usd-out');
    const outEur = document.getElementById('fx-eur-out');
    const outJpy = document.getElementById('fx-jpy-out');

    function calculateFX() {
      if (!fxInput || !fxFrom) return;
      const val = parseFloat(fxInput.value) || 0;
      const fromCurr = fxFrom.value;
      const inUSD = val / (rates[fromCurr] || 1);

      if (outCny) outCny.textContent = '¥ ' + (inUSD * rates.CNY).toFixed(2);
      if (outUsd) outUsd.textContent = '$ ' + inUSD.toFixed(2);
      if (outEur) outEur.textContent = '€ ' + (inUSD * rates.EUR).toFixed(2);
      if (outJpy) outJpy.textContent = '¥ ' + Math.round(inUSD * rates.JPY);
    }

    if (fxInput) fxInput.addEventListener('input', calculateFX);
    if (fxFrom) fxFrom.addEventListener('change', calculateFX);
  })();
</script>

<style>
  .lab-dashboard {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 32px 20px 80px;
    box-sizing: border-box;
  }

  /* 1. Hero 看板 */
  .lab-hero {
    padding: 40px;
    border-radius: 12px;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--style-border, #e2e8f0);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    margin-bottom: 32px;
  }

  :root[data-theme='dark'] .lab-hero {
    background: #181c27;
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
  }

  .lab-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    font-family: var(--font-family-code, monospace);
    color: #425aef;
    background: rgba(66, 90, 239, 0.08);
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 16px;
  }

  :root[data-theme='dark'] .lab-hero__badge {
    color: #a5b4fc;
    background: rgba(99, 102, 241, 0.15);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #425aef;
  }

  .lab-hero__title {
    font-size: 30px;
    font-weight: 800;
    color: var(--font-color, #1e293b);
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  :root[data-theme='dark'] .lab-hero__title {
    color: #f1f5f9;
  }

  .lab-hero__desc {
    font-size: 15px;
    line-height: 1.6;
    color: #64748b;
    margin: 0 0 28px;
    max-width: 900px;
  }

  :root[data-theme='dark'] .lab-hero__desc {
    color: #94a3b8;
  }

  .lab-stats {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    border-top: 1px solid var(--style-border, #e2e8f0);
    padding-top: 20px;
  }

  :root[data-theme='dark'] .lab-stats {
    border-color: rgba(255, 255, 255, 0.08);
  }

  .stat-item strong {
    display: block;
    font-size: 20px;
    font-weight: 800;
    color: #425aef;
    font-family: var(--font-family-code, monospace);
  }

  :root[data-theme='dark'] .stat-item strong {
    color: #a5b4fc;
  }

  .stat-item small {
    font-size: 12px;
    color: #64748b;
  }

  :root[data-theme='dark'] .stat-item small {
    color: #94a3b8;
  }

  /* 2. 实验网格 */
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .lab-card {
    padding: 28px;
    border-radius: 10px;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--style-border, #e2e8f0);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
  }

  :root[data-theme='dark'] .lab-card {
    background: #181c27;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .lab-card__header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .card-icon {
    font-size: 24px;
  }

  .card-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--font-color, #1e293b);
    margin: 0;
  }

  :root[data-theme='dark'] .card-title {
    color: #f1f5f9;
  }

  .card-sub {
    font-size: 12px;
    color: #64748b;
  }

  :root[data-theme='dark'] .card-sub {
    color: #94a3b8;
  }

  /* 画布预览框 */
  .canvas-preview-box {
    width: 100%;
    height: 220px;
    background: #0a0f1d;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 20px;
    position: relative;
  }

  .lab-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* 控制栏 */
  .controls-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .control-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .control-row label {
    font-size: 12px;
    font-weight: 600;
    color: var(--font-color, #334155);
    display: flex;
    justify-content: space-between;
  }

  :root[data-theme='dark'] .control-row label {
    color: #cbd5e1;
  }

  .lab-slider {
    width: 100%;
    accent-color: #425aef;
    cursor: pointer;
  }

  .control-actions {
    display: flex;
    gap: 10px;
    margin-top: 6px;
  }

  .lab-btn {
    padding: 6px 14px;
    border-radius: 6px;
    border: 1px solid var(--style-border, #cbd5e1);
    background: var(--card-bg, #ffffff);
    color: var(--font-color, #1e293b);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .lab-btn:hover {
    border-color: #425aef;
