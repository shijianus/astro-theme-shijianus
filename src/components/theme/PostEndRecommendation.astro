---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getPostPath, resolveCover, resolveCoverAlt } from '../../lib/content';

interface Props {
  nextPost?: CollectionEntry<'posts'> | null;
}

const { nextPost = null } = Astro.props;
---

{nextPost && (
  <>
    <span class="pagination-sentinel" data-pagination-sentinel aria-hidden="true"></span>
    <nav id="pagination" class="pagination-post" data-end-pagination data-slug={nextPost.id} aria-label="接着读下一篇文章">
      <a class="next-post" href={getPostPath(nextPost)} rel="next">
        <img
          class="next-cover"
          src={resolveCover(nextPost)}
          alt={resolveCoverAlt(nextPost)}
          loading="lazy"
          data-fallback-src={siteConfig.post.hero.fallbackImage}
          data-remote-fallback-src={siteConfig.post.hero.remoteFallbackImage}
        />
        <span class="pagination-info">
          <span class="label">接着读</span>
          <strong class="next-info">{nextPost.data.title}</strong>
        </span>
        <span class="next-post-arrow" aria-hidden="true">→</span>
      </a>
      <button type="button" class="pagination-close" data-pagination-close aria-label="收起这条推荐">×</button>
    </nav>
  </>
)}

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-end-pagination]');
    if (!roots.length) return;

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      const post = root.closest('#post');
      const sentinel = post?.querySelector('[data-pagination-sentinel]');
      const closeButton = root.querySelector('[data-pagination-close]');
      const storageKey = `shijianus-pagination-dismissed:${root.dataset.slug || window.location.pathname}`;
      let dismissed = false;
      let hasScrolled = false;
      let frame = 0;
      let exitTimer = 0;

      try {
        dismissed = window.sessionStorage.getItem(storageKey) === 'true';
      } catch {}

      if (dismissed) {
        root.dataset.dismissed = 'true';
        return;
      }

      // Keep the popup out of filtered content layers so fixed positioning is
      // relative to the viewport rather than the article's containing block.
      document.body.appendChild(root);

      const show = () => {
        if (root.dataset.dismissed === 'true') return;
        window.clearTimeout(exitTimer);
        root.classList.remove('is-exiting');
        root.classList.add('is-visible');
      };

      const hideAfterComments = () => {
        if (!root.classList.contains('is-visible')) return;
        root.classList.remove('is-visible');
        root.classList.add('is-exiting');
        window.clearTimeout(exitTimer);
        exitTimer = window.setTimeout(() => {
          root.classList.remove('is-exiting');
        }, 360);
      };

      const update = () => {
        frame = 0;
        if (root.dataset.dismissed === 'true' || !(sentinel instanceof HTMLElement)) return;

        const sentinelTop = sentinel.getBoundingClientRect().top;
        const comments = document.getElementById('post-comment');
        // The comments section is followed by the site footer, so waiting for
        // its bottom to leave the viewport would be unreachable on short pages.
        // Once its top has crossed the viewport, the reader has moved beyond
        // the recommendation zone and the popup can leave the screen.
        const commentsPassed = comments instanceof HTMLElement && comments.getBoundingClientRect().top <= 0;
        const reachedArticleEnd = hasScrolled && window.scrollY > 48 && sentinelTop <= window.innerHeight * 0.9;

        if (commentsPassed) {
          hideAfterComments();
          return;
        }

        if (reachedArticleEnd) show();
      };

      const scheduleUpdate = () => {
        if (frame === 0) frame = window.requestAnimationFrame(update);
      };

      closeButton?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        root.classList.remove('is-visible', 'is-exiting');
        root.dataset.dismissed = 'true';
        try {
          window.sessionStorage.setItem(storageKey, 'true');
        } catch {}
      });

      if (!(sentinel instanceof HTMLElement)) return;

      window.addEventListener('scroll', () => {
        hasScrolled = true;
        scheduleUpdate();
      }, { passive: true });
      window.addEventListener('resize', scheduleUpdate, { passive: true });

      // Do not evaluate on load: restored scroll positions should still wait
      // for a real reader scroll before showing the recommendation.
    });
  })();
</script>
