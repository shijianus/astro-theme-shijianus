---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getPostPath, resolveCover, resolveCoverAlt } from '../../lib/content';

interface Props {
  nextPost?: CollectionEntry<'posts'> | null;
}

const { nextPost = null } = Astro.props;
---

{nextPost && (
  <nav id="pagination" class="pagination-post" data-end-pagination data-slug={nextPost.id} aria-label="接着读下一篇文章">
    <a class="next-post" href={getPostPath(nextPost)} rel="next">
      <img
        class="next-cover"
        src={resolveCover(nextPost)}
        alt={resolveCoverAlt(nextPost)}
        loading="lazy"
        decoding="async"
        data-fallback-src={siteConfig.post.hero.fallbackImage || '/media/shijianus/default.png'}
        data-remote-fallback-src={siteConfig.post.hero.remoteFallbackImage || '/media/shijianus/default.png'}
        onerror={`if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';if(!this.src.endsWith('${siteConfig.post.hero.fallbackImage || '/media/shijianus/default.png'}')){this.src='${siteConfig.post.hero.fallbackImage || '/media/shijianus/default.png'}';}else{this.onerror=null;}}else{this.onerror=null;}`}
      />
      <span class="pagination-info">
        <span class="label">接着读</span>
        <strong class="next-info">{nextPost.data.title}</strong>
      </span>
    </a>
    <button type="button" class="pagination-close" data-pagination-close aria-label="收起这条推荐">×</button>
  </nav>
)}

<script is:inline>
  (() => {
    const init = () => {
      const roots = document.querySelectorAll('[data-end-pagination]');
      if (!roots.length) return;

      roots.forEach((root) => {
        if (!(root instanceof HTMLElement)) return;
        if (root.dataset.initialized === 'true') return;
        root.dataset.initialized = 'true';

        const closeButton = root.querySelector('[data-pagination-close]');
        let dismissed = false;
        let ticking = false;

        // Keep the popup out of filtered content layers so fixed positioning is
        // relative to the viewport rather than the article's containing block.
        if (root.parentElement !== document.body) {
          document.body.appendChild(root);
        }

        const show = () => {
          if (dismissed) return;
          root.classList.add('is-visible');
        };

        const hide = () => {
          root.classList.remove('is-visible');
        };

        const update = () => {
          ticking = false;
          if (dismissed) {
            hide();
            return;
          }

          const comments = document.getElementById('post-comment');
          const nav = document.getElementById('nav');
          if (!(comments instanceof HTMLElement)) {
            hide();
            return;
          }

          const commentRect = comments.getBoundingClientRect();
          const navRect = nav instanceof HTMLElement ? nav.getBoundingClientRect() : null;
          const navThreshold = navRect ? navRect.bottom : 60;

          // 1. post-comment top has scrolled up to meet the nav header (commentRect.top <= navThreshold)
          // 2. post-comment has not scrolled completely past the top of the viewport (commentRect.bottom > 0)
          const shouldBeVisible = commentRect.top <= navThreshold && commentRect.bottom > 0;

          if (shouldBeVisible) {
            show();
          } else {
            hide();
          }
        };

        const scheduleUpdate = () => {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(update);
          }
        };

        closeButton?.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          dismissed = true;
          root.dataset.dismissed = 'true';
          hide();
        });

        window.addEventListener('scroll', scheduleUpdate, { passive: true });
        window.addEventListener('resize', scheduleUpdate, { passive: true });

        // Initial check on load/mount
        scheduleUpdate();
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
    document.addEventListener('pjax:complete', init);
    document.addEventListener('astro:page-load', init);
  })();
</script>
