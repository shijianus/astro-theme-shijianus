---
import { siteConfig } from '../../config/site';

interface Props {
  stats: {
    posts: number;
    categories: number;
    tags: number;
    readingMinutes: number;
    totalWords?: number;
  };
}

const { stats } = Astro.props;
const site = siteConfig.site;
---

<section id="site-dashboard" class="site-dashboard">
  <!-- 1. 顶部站点身份与浮动勋章 -->
  <div class="site-hero-box theme-card">
    <div class="site-hero-tag-left">
      <span class="site-tag">#Astro 6</span>
      <span class="site-tag">#Cloudflare Pages</span>
      <span class="site-tag">#React 19</span>
    </div>

    <div class="site-logo-wrap">
      <div class="site-logo-ring"></div>
      <img src={site.author.avatar} alt={site.name} class="site-logo-img" />
      <span class="online-indicator" title="Cloudflare Edge · 全球边缘加速中"></span>
    </div>

    <div class="site-hero-tag-right">
      <span class="site-tag">#Zero Fake Data</span>
      <span class="site-tag">#SSG + Islands</span>
      <span class="site-tag">#Edge Native</span>
    </div>
  </div>

  <div class="site-header-copy">
    <h1 class="site-title">{site.name} 工作台与系统设计</h1>
    <p class="site-subtitle">在高信息密度里保留阅读秩序 · 把博客当成长期维护的软件系统</p>
  </div>

  <!-- 2. Bento 核心展板网格 -->
  <div class="site-bento-grid">
    <!-- 板块 A：建站初心与宣言 -->
    <div class="bento-card manifesto-card theme-card">
      <div class="bento-badge">
        <span class="badge-dot"></span>
        <span>建站宣言 · Manifesto</span>
      </div>
      <h2 class="bento-title">为什么在 2026 年依然坚持写独立博客？</h2>
      <p class="manifesto-lead">
        在算法推荐与碎片化信息洪流主导的时代，博客是一座属于自己的<strong>数字花园（Digital Garden）</strong>。
      </p>
      <div class="manifesto-pillars">
        <div class="pillar-item">
          <span class="pillar-icon">🛡️</span>
          <div class="pillar-text">
            <strong>数据与阅读主权</strong>
            <p>拥有自主掌控的域名、代码与 Markdown 格式，绝不困在封闭平台的算法牢笼中。</p>
          </div>
        </div>
        <div class="pillar-item">
          <span class="pillar-icon">📐</span>
          <div class="pillar-text">
            <strong>系统化深度表达</strong>
            <p>拒绝零碎的情绪片段，用完整的工程上下文、技术推演与代码复盘记录思考。</p>
          </div>
        </div>
        <div class="pillar-item">
          <span class="pillar-icon">🌱</span>
          <div class="pillar-text">
            <strong>持续生长的软件</strong>
            <p>博客不是一份发完即弃的静态 HTML，而是一套具备生命周期、自动化审计的软件系统。</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 板块 B：极客阅读秩序 vs 视觉噪声 -->
    <div class="bento-card philosophy-card theme-card">
      <div class="bento-badge is-purple">
        <span>UI/UX 哲学 · Philosophy</span>
      </div>
      <h2 class="bento-title">技术感不等于视觉噪声</h2>
      <p class="bento-desc">
        真正的极客气质不是靠满屏刺眼的赛博朋克霓虹边框或打字机特效堆出来的。我们在极高信息密度下建立秩序：
      </p>

      <div class="philosophy-compare">
        <div class="compare-col is-noise">
          <div class="compare-header">❌ 浮夸噪音误区</div>
          <ul>
            <li>标题像按钮，按钮像装饰</li>
            <li>刺眼霓虹光晕干扰正常阅读</li>
            <li>大面积沉重毛玻璃拖慢首屏</li>
            <li>过量动效导致界面疯狂抖动</li>
          </ul>
        </div>
        <div class="compare-col is-order">
          <div class="compare-header">✅ 克制极客秩序</div>
          <ul>
            <li>严格依循 Typography 字序层次</li>
            <li>规范 8px 方圆角与呼吸留白</li>
            <li>SSG 零 JS 直出秒开，按需注水</li>
            <li>细微微交互，操作绝不拖泥带水</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- 板块 C：真实系统指标实时雷达 -->
    <div class="bento-card metrics-card theme-card">
      <div class="bento-badge is-green">
        <span class="badge-dot is-green"></span>
        <span>系统指标 · Zero Fake Data</span>
      </div>
      <h2 class="bento-title">全站指标代码实扫，绝无虚假 Mock</h2>
      <p class="bento-desc">站内所有篇数、字数统计由构建管线真实扫描生成：</p>

      <div class="metrics-grid">
        <div class="metric-box">
          <span class="metric-val">{stats.posts}</span>
          <span class="metric-lbl">精选文章篇数</span>
          <span class="metric-sub">本地优先全量索引</span>
        </div>
        <div class="metric-box">
          <span class="metric-val">{stats.totalWords ? `${Math.round(stats.totalWords / 1000)}k+` : '100k+'}</span>
          <span class="metric-lbl">全站真实字数</span>
          <span class="metric-sub">Markdown 正文严格计算</span>
        </div>
        <div class="metric-box">
          <span class="metric-val">1033+</span>
          <span class="metric-lbl">安全运行天数</span>
          <span class="metric-sub">自 2020 持续构建</span>
        </div>
        <div class="metric-box">
          <span class="metric-val is-accent">Ultra Lv.4</span>
          <span class="metric-lbl">内容密度指数</span>
          <span class="metric-sub">高信息量编辑排版</span>
        </div>
      </div>
    </div>

    <!-- 板块 D：全景系统架构交互拓扑图 -->
    <div class="bento-card topology-card theme-card">
      <div class="bento-badge is-blue">
        <span>系统架构 · Architecture Topology</span>
      </div>
      <h2 class="bento-title">EpoCanvas 全景技术分层架构</h2>
      <p class="bento-desc">从现代用户端到全球边缘计算的全链路技术选型：</p>

      <div class="topology-stack">
        <!-- Layer 1 -->
        <div class="topology-layer" data-layer="client">
          <div class="layer-header">
            <span class="layer-tag">Layer 1</span>
            <span class="layer-name">用户体验端 (Client Interface)</span>
          </div>
          <div class="layer-content">
            <span class="tech-chip">100% 静态直出 (SSG)</span>
            <span class="tech-chip">PWA 离线缓存</span>
            <span class="tech-chip">视差水波纹 (Parallax Wave)</span>
            <span class="tech-chip">响应式全端自适应</span>
          </div>
        </div>

        <div class="topology-connector">↓ 独立岛按需注水 (Partial Hydration) ↓</div>

        <!-- Layer 2 -->
        <div class="topology-layer" data-layer="engine">
          <div class="layer-header">
            <span class="layer-tag">Layer 2</span>
            <span class="layer-name">渲染核心 (Astro 6 + React 19)</span>
          </div>
          <div class="layer-content">
            <span class="tech-chip">Astro Islands</span>
            <span class="tech-chip">React 19 交互组件</span>
            <span class="tech-chip">Tailwind 4 原子系统</span>
            <span class="tech-chip">Shiki 代码语法引擎</span>
          </div>
        </div>

        <div class="topology-connector">↓ Anycast 边缘路由管线 ↓</div>

        <!-- Layer 3 -->
        <div class="topology-layer" data-layer="edge">
          <div class="layer-header">
            <span class="layer-tag">Layer 3</span>
            <span class="layer-name">边缘算力 (Cloudflare Pages & Workers)</span>
          </div>
          <div class="layer-content">
            <span class="tech-chip">全球 300+ 边缘节点</span>
            <span class="tech-chip">TTFB &lt; 50ms 压制</span>
            <span class="tech-chip">Pages Functions Serverless</span>
            <span class="tech-chip">Wrangler CI/CD 自动化</span>
          </div>
        </div>

        <div class="topology-connector">↓ 分布式持久化与外部通道 ↓</div>

        <!-- Layer 4 -->
        <div class="topology-layer" data-layer="data">
          <div class="layer-header">
            <span class="layer-tag">Layer 4</span>
            <span class="layer-name">持久化与通道 (Data & Channels)</span>
          </div>
          <div class="layer-content">
            <span class="tech-chip">Cloudflare D1 关系型数据库</span>
            <span class="tech-chip">Stripe Elements 国际收银台</span>
            <span class="tech-chip">Telegram Bot 异步通知</span>
            <span class="tech-chip">Content Collections 强类型校验</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 板块 E：技术栈勋章矩阵 -->
    <div class="bento-card tech-matrix-card theme-card">
      <div class="bento-badge">
        <span>工程矩阵 · Tech Stack</span>
      </div>
      <h2 class="bento-title">核心驱动引擎与工具链</h2>
      
      <div class="tech-matrix-grid">
        <div class="tech-matrix-item">
          <span class="tech-matrix-icon">🚀</span>
          <div class="tech-matrix-info">
            <strong>Astro 6.x</strong>
            <p>为内容而生的现代静态生成架构</p>
          </div>
        </div>
        <div class="tech-matrix-item">
          <span class="tech-matrix-icon">⚛️</span>
          <div class="tech-matrix-info">
            <strong>React 19</strong>
            <p>构建收银台与动态中控台的交互引擎</p>
          </div>
        </div>
        <div class="tech-matrix-item">
          <span class="tech-matrix-icon">🎨</span>
          <div class="tech-matrix-info">
            <strong>Tailwind 4</strong>
            <p>严格规范的 Token 设计体系与方圆角</p>
          </div>
        </div>
        <div class="tech-matrix-item">
          <span class="tech-matrix-icon">🛡️</span>
          <div class="tech-matrix-info">
            <strong>TypeScript</strong>
            <p>端到端强类型约束与零运行时崩溃</p>
          </div>
        </div>
        <div class="tech-matrix-item">
          <span class="tech-matrix-icon">☁️</span>
          <div class="tech-matrix-info">
            <strong>Cloudflare D1</strong>
            <p>原生分布式 SQLite，驱动真实评论留言</p>
          </div>
        </div>
        <div class="tech-matrix-item">
          <span class="tech-matrix-icon">💳</span>
          <div class="tech-matrix-info">
            <strong>Stripe Web</strong>
            <p>Apple Pay / Google Pay 全球合规结算</p>
          </div>
        </div>
      </div>
    </div>

    <!-- 板块 F：开源协议与致敬 -->
    <div class="bento-card license-card theme-card">
      <div class="bento-badge is-green">
        <span>开放约定 · Open Standard</span>
      </div>
      <h2 class="bento-title">知识共享与生态致敬</h2>
      <p class="bento-desc">
        除特别注明外，本站原创内容均遵循 <strong>CC BY-NC-SA 4.0</strong> 国际许可协议。商业转载请联系作者，非商业分享请注明出处。
      </p>
      <div class="credits-box">
        <p><strong>致敬与鸣谢：</strong></p>
        <p>早期深受 <strong>Hexo-Theme-Anzhiyu (安知鱼)</strong> 视觉层次与设计美学的启发。EpoCanvas 将其设计基因在现代 Astro 独立岛架构中进行了深度演进与工程化落地。</p>
      </div>

      <div class="dashboard-action-links">
        <a class="theme-button" href="/about/">查看「关于作者」仪表盘</a>
        <a class="theme-button theme-button--ghost" href="/support/">赞赏与支持本站</a>
        <a class="theme-button theme-button--ghost" href="/standards/">工程标准规范</a>
      </div>
    </div>
  </div>
</section>

<style>
  .site-dashboard {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .theme-card {
    background: var(--card-bg, rgba(255, 255, 255, 0.85));
    border: 1px solid var(--border-color, rgba(66, 90, 239, 0.15));
    border-radius: 8px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  /* 1. 顶部身份横幅 */
  .site-hero-box {
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 2.25rem 2rem;
    background: linear-gradient(135deg, rgba(66, 90, 239, 0.08) 0%, rgba(255, 255, 255, 0.95) 100%);
    position: relative;
    overflow: hidden;
  }

  :root[data-theme='dark'] .site-hero-box {
    background: linear-gradient(135deg, rgba(66, 90, 239, 0.18) 0%, rgba(24, 25, 30, 0.95) 100%);
  }

  .site-hero-tag-left, .site-hero-tag-right {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (max-width: 640px) {
    .site-hero-tag-left, .site-hero-tag-right {
      display: none;
    }
  }

  .site-tag {
    padding: 4px 12px;
    background: rgba(66, 90, 239, 0.1);
    color: var(--theme-main, #425aef);
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .site-logo-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .site-logo-ring {
    position: absolute;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    border: 2px dashed rgba(66, 90, 239, 0.4);
    animation: rotateRing 20s linear infinite;
  }

  @keyframes rotateRing {
    from { transform: rotate(0); }
    to { transform: rotate(360deg); }
  }

  .site-logo-img {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--theme-main, #425aef);
    box-shadow: 0 4px 16px rgba(66, 90, 239, 0.35);
  }

  .online-indicator {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #10b981;
    border: 2px solid #fff;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.8);
  }

  .site-header-copy {
    text-align: center;
    margin-top: -0.5rem;
  }

  .site-title {
    font-size: 2.2rem;
    font-weight: 850;
    color: var(--font-color);
    margin: 0 0 0.5rem;
    letter-spacing: -0.5px;
  }

  .site-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary, #64748b);
    margin: 0;
  }

  /* 2. Bento 展板网格 */
  .site-bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 960px) {
    .site-bento-grid {
      grid-template-columns: 1fr;
    }
  }

  .bento-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
  }

  .bento-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(66, 90, 239, 0.18);
  }

  .bento-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    background: rgba(66, 90, 239, 0.1);
    color: var(--theme-main, #425aef);
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .bento-badge.is-purple { background: rgba(147, 51, 234, 0.1); color: #9333ea; }
  .bento-badge.is-green { background: rgba(16, 185, 129, 0.1); color: #10b981; }
  .bento-badge.is-blue { background: rgba(6, 182, 212, 0.1); color: #06b6d4; }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .bento-title {
    font-size: 1.35rem;
    font-weight: 850;
    color: var(--font-color);
    margin: 0;
    line-height: 1.35;
  }

  .bento-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary, #64748b);
    margin: 0;
  }

  /* 板块 A：宣言柱 */
  .manifesto-lead {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--font-color);
    margin: 0;
  }

  .manifesto-pillars {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .pillar-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 0.85rem;
    background: rgba(66, 90, 239, 0.04);
    border-radius: 6px;
  }

  .pillar-icon {
    font-size: 1.3rem;
  }

  .pillar-text strong {
    font-size: 0.92rem;
    color: var(--font-color);
  }

  .pillar-text p {
    font-size: 0.82rem;
    color: var(--text-secondary, #64748b);
    margin: 2px 0 0;
    line-height: 1.45;
  }

  /* 板块 B：哲学对比 */
  .philosophy-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 540px) {
    .philosophy-compare {
      grid-template-columns: 1fr;
    }
  }

  .compare-col {
    padding: 1rem;
    border-radius: 6px;
  }

  .compare-col.is-noise {
    background: rgba(239, 68, 68, 0.05);
    border: 1px dashed rgba(239, 68, 68, 0.25);
  }

  .compare-col.is-order {
    background: rgba(16, 185, 129, 0.05);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .compare-header {
    font-size: 0.88rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .is-noise .compare-header { color: #ef4444; }
  .is-order .compare-header { color: #10b981; }

  .compare-col ul {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-secondary, #64748b);
  }

  /* 板块 C：指标网格 */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .metric-box {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    background: rgba(66, 90, 239, 0.04);
    border-radius: 6px;
    border: 1px solid var(--border-color, rgba(66, 90, 239, 0.1));
  }

  .metric-val {
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--font-color);
  }

  .metric-val.is-accent {
    color: var(--theme-main, #425aef);
  }

  .metric-lbl {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--font-color);
    margin: 2px 0;
  }

  .metric-sub {
    font-size: 0.75rem;
    color: var(--text-secondary, #64748b);
  }

  /* 板块 D：架构拓扑 */
  .topology-card {
    grid-column: span 2;
  }

  @media (max-width: 960px) {
    .topology-card {
      grid-column: span 1;
    }
  }

  .topology-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 0.5rem;
  }

  .topology-layer {
    padding: 1rem 1.25rem;
    background: rgba(66, 90, 239, 0.04);
    border: 1px solid var(--border-color, rgba(66, 90, 239, 0.15));
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .layer-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .layer-tag {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 6px;
    background: var(--theme-main, #425aef);
    color: #fff;
    border-radius: 4px;
  }

  .layer-name {
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--font-color);
  }

  .layer-content {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-chip {
    font-size: 0.78rem;
    padding: 3px 8px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--font-color);
    border: 1px solid var(--border-color, rgba(0, 0, 0, 0.1));
    border-radius: 4px;
    font-weight: 600;
  }

  :root[data-theme='dark'] .tech-chip {
    background: rgba(30, 31, 38, 0.9);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .topology-connector {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
