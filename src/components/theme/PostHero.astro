---
import { CalendarDays, Clock3, Eye, FileText, FolderOpen, RefreshCw, TimerReset, Tag as TagIcon, type LucideIcon } from 'lucide-react';
import { normalizeLangCode } from '../../lib/content';

type PostHeroMetaItem = {
  label: string;
  value: string;
  runtime?: 'views' | 'dwell';
  icon?: 'calendar' | 'refresh' | 'folder' | 'file' | 'clock' | 'eye' | 'timer' | 'tag';
};

interface Props {
  slug: string;
  title: string;
  summary?: string;
  image?: string;
  imageAlt?: string;
  video?: string;
  videoPoster?: string;
  fallbackImage?: string;
  remoteFallbackImage?: string;
  badges?: string[];
  meta?: PostHeroMetaItem[];
  runtimeMetrics?: boolean;
  maxTags?: number;
  autoFitTitle?: boolean;
  translations?: Record<string, {
    slug: string;
    url: string;
    title: string;
    lang: string;
  }>;
  currentLang?: string;
  uniformHeroHeight?: {
    desktop?: string;
    mobile?: string;
  };
  frontmatterHero?: {
    height?: string;
    mobileHeight?: string;
    titleSize?: string;
    align?: 'flex-start' | 'center' | 'space-between';
    paddingBottom?: string;
    paddingTop?: string;
    compactWhenShort?: boolean;
  };
  autoTitleSize?: string;
}

import { getLocaleMeta } from '../../config/i18n';
import { siteConfig } from '../../config/site';

const {
  slug,
  title,
  summary = '',
  image = '',
  imageAlt = '',
  video = '',
  videoPoster = image,
  fallbackImage = '/media/shijianus/default.png',
  remoteFallbackImage = 'https://drawing.shijian.qzz.io/file/AgACAgEAAyEGAAS6jkJbAAMUapQaP6X-fJmi1j0qYD5NgooECLwAAlEMaxuQM6BEoSo1dHbP8ioBAAMCAAN3AAM9BA.png',
  badges = [],
  meta = [],
  runtimeMetrics = true,
  maxTags = 10,
  autoFitTitle = true,
  uniformHeroHeight,
  frontmatterHero = {},
  autoTitleSize,
} = Astro.props;

const heroI18n = (siteConfig.post.hero as any).i18n || {
  mode: 'fixed',
  fixedStrategy: 'max-content',
  customHeights: {
    desktop: 'clamp(360px, 28vw, 420px)',
    mobile: 'clamp(320px, 40vh, 380px)',
  },
  contentAlign: 'center',
  maxLines: {
    title: 2,
    lede: 2,
  },
  smoothTransition: true,
};

const resolvedDesktopHeight =
  frontmatterHero.height ||
  (heroI18n.mode === 'fixed'
    ? uniformHeroHeight?.desktop || heroI18n.customHeights?.desktop || 'clamp(360px, 28vw, 420px)'
    : 'auto');
const resolvedMobileHeight =
  frontmatterHero.mobileHeight ||
  frontmatterHero.height ||
  (heroI18n.mode === 'fixed'
    ? uniformHeroHeight?.mobile || heroI18n.customHeights?.mobile || 'clamp(320px, 40vh, 380px)'
    : 'auto');

const effectiveTitleSize = frontmatterHero.titleSize || autoTitleSize || 'clamp(2.15rem, 3.8vw, 3.25rem)';
const effectiveContentAlign = frontmatterHero.align || heroI18n.contentAlign || 'center';

const heroMetaIconMap: Record<NonNullable<PostHeroMetaItem['icon']>, LucideIcon> = {
  calendar: CalendarDays,
  refresh: RefreshCw,
  folder: FolderOpen,
  file: FileText,
  clock: Clock3,
  eye: Eye,
  timer: TimerReset,
  tag: TagIcon,
};

const hasMedia = Boolean(image || video);
---

<section
  class:list={['post-hero', !hasMedia && 'is-pure-color']}
  data-post-hero
  data-hero-type="post"
  data-post-slug={slug}
  data-runtime-metrics={runtimeMetrics ? 'true' : 'false'}
  data-hero-i18n-mode={heroI18n.mode}
  data-hero-align={effectiveContentAlign}
  data-hero-smooth-transition={heroI18n.smoothTransition ? 'true' : 'false'}
  style={`--hero-uniform-height-desktop: ${resolvedDesktopHeight}; --hero-uniform-height-mobile: ${resolvedMobileHeight}; --hero-content-align: ${effectiveContentAlign}; --hero-title-max-lines: ${heroI18n.maxLines?.title ?? 2}; --hero-lede-max-lines: ${heroI18n.maxLines?.lede ?? 2}; --hero-title-size: ${effectiveTitleSize}; ${frontmatterHero.paddingBottom ? `--hero-custom-padding-bottom: ${frontmatterHero.paddingBottom};` : ''} ${frontmatterHero.paddingTop ? `--hero-custom-padding-top: ${frontmatterHero.paddingTop};` : ''}`}
>
  {hasMedia && (
    <div class="post-hero__cover">
      {video ? (
        <video
          src={video}
          poster={videoPoster}
          class="post-hero__video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          data-video-fallback={fallbackImage}
          data-video-remote-fallback={remoteFallbackImage}
        >
          <track kind="captions" />
        </video>
      ) : (
        <img
          src={image}
          alt={imageAlt}
          class="post-hero__image"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          data-fallback-src={fallbackImage || '/media/shijianus/default.png'}
          data-image-fallback={fallbackImage || '/media/shijianus/default.png'}
          data-remote-fallback={remoteFallbackImage}
          onerror={`if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';if(!this.src.endsWith('${fallbackImage || '/media/shijianus/default.png'}')){this.src='${fallbackImage || '/media/shijianus/default.png'}';}else{this.onerror=null;}}else{this.onerror=null;}`}
        />
      )}
      <div class="post-hero__overlay"></div>
    </div>
  )}

  <div class="post-hero__inner">
    {badges.length > 0 && (
      <div class="post-hero__badges" data-max-tags={maxTags}>
        {badges.map((item, index) => {
          if (index === 0 && (item === '原创' || item === '转载' || item === '受限')) {
            return <span class="post-hero__badge is-primary" data-badge-type={item}>{item}</span>;
          }
          const tagSlug = encodeURIComponent(
            item.toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-').replace(/^-+|-+$/g, '')
          );
          return (
            <a href={`/tags/${tagSlug}/`} class="post-hero__tag" data-hero-tag>
              <span class="post-hero__tag-hash">#</span>
              <span class="post-hero__tag-name">{item}</span>
            </a>
          );
        })}
      </div>
    )}

    <div
      class="post-hero__title-block"
      data-auto-fit-title={autoFitTitle ? 'true' : 'false'}
    >
      <h1 class="post-hero__title">{title}</h1>
      {summary && <p class="post-hero__lede">{summary}</p>}
    </div>

    {meta.length > 0 && (
      <div class="post-hero__meta-grid">
        {meta.map((item, index) => (
          <>
            {index > 0 && <span class="post-hero__meta-dot" aria-hidden="true">•</span>}
            <span class="post-hero__meta-item" data-runtime-meta={item.runtime ?? undefined}>
              {item.icon && (
                <span class="post-hero__meta-icon" aria-hidden="true">
                  {(() => {
                    const MetaIcon = heroMetaIconMap[item.icon];
                    return <MetaIcon className="post-hero__meta-icon-svg" aria-hidden="true" />;
                  })()}
                </span>
              )}
              <span class="post-hero__meta-label">{item.label}</span>
              <strong class="post-hero__meta-value">{item.value}</strong>
            </span>
          </>
        ))}
      </div>
    )}
  </div>

  <div class="post-hero__waves" aria-hidden="true">
    <svg class="post-hero__waves-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
      <defs>
        <path id="post-hero-wave" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v44h-352Z"></path>
      </defs>
      <g class="post-hero__waves-group">
        <use href="#post-hero-wave" x="48" y="0"></use>
        <use href="#post-hero-wave" x="48" y="3"></use>
        <use href="#post-hero-wave" x="48" y="5"></use>
        <use href="#post-hero-wave" x="48" y="7"></use>
      </g>
    </svg>
  </div>
</section>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-post-hero]');
    if (!roots.length) return;

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      const image = root.querySelector('.post-hero__image');
      const video = root.querySelector('.post-hero__video');
      const fallback = image instanceof HTMLElement ? image.getAttribute('data-image-fallback') || '' : '';
      const remoteFallback = image instanceof HTMLElement ? image.getAttribute('data-remote-fallback') || '' : '';
      const videoFallback = video instanceof HTMLElement ? video.getAttribute('data-video-fallback') || '' : '';
      const videoRemoteFallback = video instanceof HTMLElement ? video.getAttribute('data-video-remote-fallback') || '' : '';

      if (image instanceof HTMLImageElement) {
        image.addEventListener('error', () => {
          if (image.dataset.fallbackTier === '1' || (fallback && image.src.endsWith(fallback))) {
            if (remoteFallback && image.src !== remoteFallback) {
              image.dataset.fallbackTier = '2';
              image.src = remoteFallback;
            }
            return;
          }
          image.dataset.fallbackTier = '1';
          if (fallback && !image.src.endsWith(fallback)) {
            image.src = fallback;
          } else if (remoteFallback) {
            image.dataset.fallbackTier = '2';
            image.src = remoteFallback;
          }
        });
      }

      if (video instanceof HTMLVideoElement && (videoFallback || videoRemoteFallback)) {
        video.addEventListener('error', () => {
          const nextImage = document.createElement('img');
          nextImage.src = videoFallback || videoRemoteFallback;
          nextImage.alt = document.title;
          nextImage.className = 'post-hero__image post-hero__image--fallback';
          nextImage.setAttribute('loading', 'eager');
          nextImage.setAttribute('decoding', 'async');
          nextImage.setAttribute('fetchpriority', 'high');
          nextImage.setAttribute('data-image-fallback', videoFallback);
          nextImage.setAttribute('data-remote-fallback', videoRemoteFallback);
          video.replaceWith(nextImage);
        }, { once: true });
      }

      // 1. Tag space-based truncation prevention & horizontal limit
      const badgesContainer = root.querySelector('.post-hero__badges');
      if (badgesContainer instanceof HTMLElement) {
        const primaryBadge = badgesContainer.querySelector('.post-hero__badge.is-primary');
        const tagElements = Array.from(badgesContainer.querySelectorAll('[data-hero-tag]'));
        const maxTagsLimit = Number(badgesContainer.getAttribute('data-max-tags') || '10');

        const fitTagsToSpace = () => {
          tagElements.forEach((el) => {
            if (el instanceof HTMLElement) {
              el.removeAttribute('data-hidden-by-space');
              el.style.removeProperty('display');
            }
          });

          const parent = badgesContainer.parentElement || root;
          const containerRect = badgesContainer.getBoundingClientRect();
          const parentRect = parent.getBoundingClientRect();
          const parentStyle = window.getComputedStyle(parent);
          const parentPaddingRight = parseFloat(parentStyle.paddingRight) || 0;
          const parentInnerRight = parentRect.right - parentPaddingRight;

          // Strict spatial boundary: container left + 1100px maximum, but never exceeding parent inner right - 12px
          const maxRight = Math.min(containerRect.left + 1100, parentInnerRight - 12);

          let currentRight = containerRect.left;
          if (primaryBadge instanceof HTMLElement) {
            const pRect = primaryBadge.getBoundingClientRect();
            currentRight = pRect.right + 8;
          }

          let displayedCount = 0;

          for (const el of tagElements) {
            if (!(el instanceof HTMLElement)) continue;

            if (displayedCount >= maxTagsLimit) {
              el.setAttribute('data-hidden-by-space', 'true');
              el.style.setProperty('display', 'none', 'important');
              continue;
            }

            const tagWidth = el.offsetWidth;
            const gap = displayedCount === 0 && !primaryBadge ? 0 : 8;

            if (currentRight + gap + tagWidth <= maxRight) {
              el.removeAttribute('data-hidden-by-space');
              el.style.removeProperty('display');
              currentRight += gap + tagWidth;
              displayedCount++;
            } else {
              el.setAttribute('data-hidden-by-space', 'true');
              el.style.setProperty('display', 'none', 'important');
            }
          }
        };

        requestAnimationFrame(fitTagsToSpace);
        window.addEventListener('resize', fitTagsToSpace, { passive: true });
        if (document.fonts) {
          document.fonts.ready.then(fitTagsToSpace).catch(() => {});
        }
      }

      // 2. Title & lede auto-sizing & strict non-truncation guarantee
      const titleBlock = root.querySelector('.post-hero__title-block');
      if (titleBlock instanceof HTMLElement && titleBlock.getAttribute('data-auto-fit-title') === 'true') {
        const titleEl = titleBlock.querySelector('h1, .post-hero__title');
        const ledeEl = titleBlock.querySelector('.post-hero__lede');
        const metaGrid = root.querySelector('.post-hero__meta-grid');

        const fitTitleAndLede = () => {
          if (titleEl instanceof HTMLElement) {
            const isMobile = window.innerWidth <= 768;
            // Base title size: 40px on desktop (clamp 2rem ~ 2.75rem), 26px on mobile
            // Minimum title size: 28px on desktop (must be strictly larger than article body headings!), 18px on mobile
            const baseTitleSize = isMobile ? 26 : 40;
            const minTitleSize = isMobile ? 18 : 28;
            const maxTitleHeight = isMobile ? 140 : 175;

            titleEl.style.setProperty('font-size', `${baseTitleSize}px`, 'important');

            let currentSize = baseTitleSize;
            while (
              (titleEl.offsetHeight > maxTitleHeight || (metaGrid && metaGrid.getBoundingClientRect().bottom > root.getBoundingClientRect().bottom - 20)) &&
              currentSize > minTitleSize
            ) {
              currentSize -= isMobile ? 0.5 : 1;
              titleEl.style.setProperty('font-size', `${currentSize}px`, 'important');
            }
          }

          if (ledeEl instanceof HTMLElement) {
            const isMobile = window.innerWidth <= 768;
            const baseLedeSize = isMobile ? 13.5 : 15;
            const minLedeSize = isMobile ? 11.5 : 12;
            ledeEl.style.setProperty('font-size', `${baseLedeSize}px`, 'important');

            let currentSize = baseLedeSize;
            while (ledeEl.scrollHeight > ledeEl.clientHeight + 2 && currentSize > minLedeSize) {
              currentSize -= 0.5;
              ledeEl.style.setProperty('font-size', `${currentSize}px`, 'important');
            }
          }
        };

        requestAnimationFrame(fitTitleAndLede);
        window.addEventListener('resize', fitTitleAndLede, { passive: true });
        window.addEventListener('shijianus:localechange', () => {
          setTimeout(fitTitleAndLede, 25);
        });
        if (document.fonts) {
          document.fonts.ready.then(fitTitleAndLede).catch(() => {});
        }
      }

      if (root.dataset.runtimeMetrics !== 'true') return;

      const slug = root.dataset.postSlug;
      if (!slug) return;

      const viewedKey = `shijianus-post-viewed:${slug}`;
      const viewKey = `shijianus-post-views:${slug}`;
      const dwellKey = `shijianus-post-dwell:${slug}`;
      const viewsNode = root.querySelector('[data-runtime-meta="views"] .post-hero__meta-value');
      const dwellNode = root.querySelector('[data-runtime-meta="dwell"] .post-hero__meta-value');

      const safeSessionGet = (key) => {
        try {
          return window.sessionStorage.getItem(key);
        } catch {
          return null;
        }
      };

      const safeSessionSet = (key, value) => {
        try {
          window.sessionStorage.setItem(key, value);
        } catch {}
      };

      if (!safeSessionGet(viewedKey)) {
        const nextViews = Number(safeSessionGet(viewKey) || '0') + 1;
        safeSessionSet(viewKey, String(nextViews));
        safeSessionSet(viewedKey, '1');
      }

      const HERO_I18N = {
        'zh-CN': {
          badgeOriginal: '原创',
          badgeReprint: '转载',
          viewsUnit: '次',
          dwellUnit: '分钟',
        },
        'zh-Hant': {
          badgeOriginal: '原創',
          badgeReprint: '轉載',
          viewsUnit: '次',
          dwellUnit: '分鐘',
        },
        'en': {
          badgeOriginal: 'Original',
          badgeReprint: 'Reprint',
          viewsUnit: 'views',
          dwellUnit: 'min',
        },
        'es': {
          badgeOriginal: 'Original',
          badgeReprint: 'Reimpresión',
          viewsUnit: 'vistas',
          dwellUnit: 'min',
        },
        'de': {
          badgeOriginal: 'Original',
          badgeReprint: 'Nachdruck',
          viewsUnit: 'Aufrufe',
          dwellUnit: 'Min.',
        },
        'fr': {
          badgeOriginal: 'Original',
          badgeReprint: 'Réimpression',
          viewsUnit: 'vues',
          dwellUnit: 'min',
        },
      };

      let currentHeroLang = document.documentElement.lang || 'zh-CN';

      const updateHeroI18n = (targetLang) => {
        currentHeroLang = (targetLang || '').toLowerCase().startsWith('zh-hant') ? 'zh-Hant'
          : (targetLang || '').toLowerCase().startsWith('zh') ? 'zh-CN'
          : ['en', 'es', 'de', 'fr'].includes((targetLang || '').split('-')[0]) ? (targetLang || '').split('-')[0]
          : 'zh-CN';
        const t = HERO_I18N[currentHeroLang] || HERO_I18N['zh-CN'];

        const badgeEl = root.querySelector('.post-hero__badge.is-primary');
        if (badgeEl) {
          const type = badgeEl.getAttribute('data-badge-type') || badgeEl.textContent.trim();
          if (type === '原创' || type === 'Original' || type === '原創') {
            badgeEl.textContent = t.badgeOriginal;
          } else if (type === '转载' || type === 'Reprint' || type === '轉載') {
            badgeEl.textContent = t.badgeReprint;
          }
        }

        if (viewsNode instanceof HTMLElement) {
          viewsNode.textContent = `${Number(safeSessionGet(viewKey) || '0')} ${t.viewsUnit}`;
        }
        renderDwell();
      };

      let dwellSeconds = Number(safeSessionGet(dwellKey) || '0');
      const renderDwell = () => {
        if (!(dwellNode instanceof HTMLElement)) return;
        const t = HERO_I18N[currentHeroLang] || HERO_I18N['zh-CN'];
        const minutes = Math.max(0, Math.floor(dwellSeconds / 60));
        dwellNode.textContent = `${minutes} ${t.dwellUnit}`;
      };

      updateHeroI18n(currentHeroLang);

      const timer = window.setInterval(() => {
        if (document.visibilityState !== 'visible') return;
        dwellSeconds += 1;
        safeSessionSet(dwellKey, String(dwellSeconds));
        renderDwell();
      }, 1000);

      window.addEventListener('shijianus:localechange', (e) => {
        const next = typeof e?.detail === 'string' ? e.detail : (e?.detail?.lang || document.documentElement.lang || 'zh-CN');
        updateHeroI18n(next);
      });

      window.addEventListener(
        'pagehide',
        () => {
          window.clearInterval(timer);
        },
        { once: true },
      );
    });
  })();
</script>
