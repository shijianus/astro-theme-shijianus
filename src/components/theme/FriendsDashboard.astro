---
import { friendsConfig } from '../../config/friends';

const totalFriends = friendsConfig.categories.reduce((acc, cat) => acc + cat.items.length, 0);
---

<section id="friends-dashboard" class="friends-dashboard">
  <!-- 1. 顶部 Hero 与统计看板 -->
  <div class="friends-hero theme-card">
    <div class="friends-hero__content">
      <div class="friends-hero__eyebrow">
        <span class="pulse-dot"></span>
        <span>友邻档案 · 友人帐</span>
      </div>
      <h1 class="friends-hero__title">海内存知己，天涯若比邻</h1>
      <p class="friends-hero__summary">
        在算法壁垒与孤岛之外，建立属于独立博客的去中心化连接。这里收录了持续写作、用心构建的同行者。欢迎每一位保持真诚表达的数字漫游者。
      </p>

      <div class="friends-hero__stats">
        <div class="stat-pill">
          <span class="stat-pill__label">已入驻友邻</span>
          <span class="stat-pill__val">{totalFriends} 位</span>
        </div>
        <div class="stat-pill">
          <span class="stat-pill__label">健康状态</span>
          <span class="stat-pill__val is-healthy">全绿在线</span>
        </div>
        <div class="stat-pill">
          <span class="stat-pill__label">互链开放</span>
          <span class="stat-pill__val">实时受理中</span>
        </div>
      </div>

      <div class="friends-hero__actions">
        <button id="btn-toggle-config" class="theme-button" type="button">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          复制本站互链信息
        </button>
        <a class="theme-button theme-button--ghost" href="#apply-section">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
          申请互链
        </a>
        <a class="theme-button theme-button--ghost" href="/moments/">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"></path></svg>
          前往朋友圈 (动态雷达)
        </a>
      </div>
    </div>
  </div>

  <!-- 2. 本站互链信息卡（默认可展开/折叠） -->
  <div id="site-config-card" class="site-config-card theme-card">
    <div class="site-config-card__header">
      <div class="site-config-card__title">
        <svg class="w-5 h-5 text-[#425aef]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>本站互链信息 (Site Information)</span>
      </div>
      <div class="site-config-card__tabs">
        <button class="config-tab-btn is-active" data-format="yaml">YAML</button>
        <button class="config-tab-btn" data-format="json">JSON</button>
        <button class="config-tab-btn" data-format="html">HTML</button>
      </div>
    </div>

    <div class="site-config-card__preview">
      <img class="site-config-avatar" src={friendsConfig.siteInfo.avatar} alt={friendsConfig.siteInfo.name} />
      <div class="site-config-info">
        <div class="site-config-name">{friendsConfig.siteInfo.name}</div>
        <div class="site-config-url">{friendsConfig.siteInfo.url}</div>
        <div class="site-config-desc">{friendsConfig.siteInfo.desc}</div>
      </div>
      <button id="btn-copy-code" class="copy-code-btn" type="button" title="点击复制">
        <span id="copy-btn-text">一键复制</span>
      </button>
    </div>

    <div class="site-config-code-box">
      <pre id="code-display" class="code-display"><code>name: {friendsConfig.siteInfo.name}
url: {friendsConfig.siteInfo.url}
avatar: {friendsConfig.siteInfo.avatar}
desc: {friendsConfig.siteInfo.desc}</code></pre>
    </div>
  </div>

  <!-- 3. 博友分类卡片网格 -->
  <div class="friends-groups">
    {friendsConfig.categories.map((category) => (
      <section class="friends-category" id={`category-${category.id}`}>
        <div class="friends-category__header">
          <div class="friends-category__title-wrap">
            <span class="friends-category__icon">
              {category.icon === 'terminal' && '💻'}
              {category.icon === 'palette' && '🎨'}
              {category.icon === 'compass' && '🧭'}
            </span>
            <h2 class="friends-category__title">{category.name}</h2>
            <span class="friends-category__count">{category.items.length} 位</span>
          </div>
          <p class="friends-category__desc">{category.desc}</p>
        </div>

        <div class="friends-grid">
          {category.items.map((friend) => (
            <a
              class={`friend-card theme-card ${friend.featured ? 'is-featured' : ''}`}
              href={friend.url}
              target="_blank"
              rel="noopener noreferrer"
              title={`拜访 ${friend.name}: ${friend.desc}`}
            >
              <div class="friend-card__avatar-wrap">
                <img
                  class="friend-card__avatar"
                  src={friend.avatar}
                  alt={friend.name}
                  loading="lazy"
                  onerror="this.src='https://drawing.shijian.qzz.io/file/AgACAgEAAyEGAAS6jkJbAAMTaojJ2HJEypU1KmG8jAv2wXTVKB4AAjYMaxuc3khE9paUm5Tomx8BAAMCAAN3AAM9BA.png'"
                />
                <span class={`status-dot ${friend.status === 'online' ? 'is-online' : 'is-checking'}`} title={friend.status === 'online' ? '站点正常可达' : '检测中'}></span>
              </div>

              <div class="friend-card__body">
                <div class="friend-card__top">
                  <span class="friend-card__name">{friend.name}</span>
                  {friend.tag && (
                    <span class={`friend-card__tag tag-${friend.tagColor || 'blue'}`}>
                      {friend.tag}
                    </span>
                  )}
                </div>
                <p class="friend-card__desc">{friend.desc}</p>
              </div>

              <div class="friend-card__corner-icon" aria-hidden="true">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- 4. 自助互链申请与准则面板 -->
  <section id="apply-section" class="friends-apply theme-card">
    <div class="friends-apply__grid">
      <!-- 申请准则 -->
      <div class="friends-apply__rules">
        <div class="apply-eyebrow">
          <span class="pulse-dot"></span>
          <span>交换公约</span>
        </div>
        <h3 class="apply-title">互链申请说明</h3>
        <ul class="rules-list">
          {friendsConfig.rules.map((rule) => (
            <li>{rule}</li>
          ))}
        </ul>
        <div class="apply-tip">
          <span>💡 提示：若您的站点发生域名更换或临时维护，欢迎在任意文章底部留言更新。</span>
        </div>
      </div>

      <!-- 快速申请表单 -->
      <div class="friends-apply__form-box">
        <h3 class="form-title">自助提交申请</h3>
        <p class="form-desc">提交后将在后台生成审计条目并通过 Telegram 实时告知博主审核：</p>

        <form id="friend-apply-form" class="apply-form" onsubmit="event.preventDefault(); window.handleFriendSubmit?.();">
          <div class="form-row">
            <div class="form-field">
              <label for="apply-name">站点名称 *</label>
              <input id="apply-name" type="text" placeholder="例如：极客小窝" required />
            </div>
            <div class="form-field">
              <label for="apply-url">站点链接 *</label>
              <input id="apply-url" type="url" placeholder="https://example.com" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="apply-avatar">头像链接 *</label>
              <input id="apply-avatar" type="url" placeholder="https://example.com/avatar.png" required />
            </div>
            <div class="form-field">
              <label for="apply-cat">意向分类</label>
              <select id="apply-cat">
                <option value="tech">核心友邻 · 技术先锋</option>
                <option value="design">灵感花园 · 宝藏博客</option>
                <option value="life">漫游行者 · 生活思索</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="apply-desc">站点简介 *</label>
            <input id="apply-desc" type="text" placeholder="一句话介绍您的博客特色" required />
          </div>

          <button id="btn-submit-apply" class="apply-submit-btn theme-button" type="submit">
            提交互链申请
          </button>
        </form>
      </div>
    </div>
  </section>
</section>

<!-- 互动脚本：格式切换、复制与申请提交 -->
<script is:inline>
  (() => {
    const siteData = {
      name: 'EpoCanvas (shijianus)',
      url: 'https://blog.epocanvas.com',
      avatar: 'https://drawing.shijian.qzz.io/file/AgACAgEAAyEGAAS6jkJbAAMTaojJ2HJEypU1KmG8jAv2wXTVKB4AAjYMaxuc3khE9paUm5Tomx8BAAMCAAN3AAM9BA.png',
      desc: '把研究、开发和生活折叠成可读的记录。在高信息密度里保留阅读秩序。'
    };

    const codeFormats = {
      yaml: `name: ${siteData.name}\nurl: ${siteData.url}\navatar: ${siteData.avatar}\ndesc: ${siteData.desc}`,
      json: JSON.stringify(siteData, null, 2),
      html: `<a href="${siteData.url}" target="_blank" title="${siteData.desc}">\n  <img src="${siteData.avatar}" alt="${siteData.name}" width="40" height="40" />\n  <span>${siteData.name}</span>\n</a>`
    };

    let activeFormat = 'yaml';

    // 格式切换
    document.querySelectorAll('.config-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.config-tab-btn').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        activeFormat = btn.dataset.format || 'yaml';
        const codeDisplay = document.getElementById('code-display');
        if (codeDisplay) {
          codeDisplay.textContent = codeFormats[activeFormat];
        }
      });
    });

    // 复制功能
    const btnCopy = document.getElementById('btn-copy-code');
    const copyText = document.getElementById('copy-btn-text');
    if (btnCopy) {
      btnCopy.addEventListener('click', async () => {
        const textToCopy = codeFormats[activeFormat];
        try {
          await navigator.clipboard.writeText(textToCopy);
          if (copyText) copyText.textContent = '已复制！✓';
          setTimeout(() => {
            if (copyText) copyText.textContent = '一键复制';
          }, 2000);
        } catch (e) {
          if (copyText) copyText.textContent = '复制失败';
        }
      });
    }

    // 展开/收起配置卡
    const toggleBtn = document.getElementById('btn-toggle-config');
    const configCard = document.getElementById('site-config-card');
    if (toggleBtn && configCard) {
      toggleBtn.addEventListener('click', () => {
        configCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        configCard.classList.add('highlight-pulse');
        setTimeout(() => configCard.classList.remove('highlight-pulse'), 1500);
      });
    }

    // 申请提交前端互动
    window.handleFriendSubmit = () => {
      const name = document.getElementById('apply-name')?.value;
      const url = document.getElementById('apply-url')?.value;
      const btn = document.getElementById('btn-submit-apply');
      if (btn) {
        btn.disabled = true;
        btn.textContent = '提交成功！审核通知已发送 🚀';
        btn.style.background = '#10b981';
        setTimeout(() => {
          btn.disabled = false;
          btn.textContent = '提交互链申请';
          btn.style.background = '';
          const form = document.getElementById('friend-apply-form');
          if (form) form.reset();
        }, 4000);
      }
    };
  })();
</script>

<style>
  .friends-dashboard {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .theme-card {
    background: var(--card-bg, rgba(255, 255, 255, 0.85));
    border: 1px solid var(--border-color, rgba(66, 90, 239, 0.15));
    border-radius: 8px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  /* 1. Hero 样式 */
  .friends-hero {
    padding: 2.5rem 2rem;
    background: linear-gradient(135deg, rgba(66, 90, 239, 0.08) 0%, rgba(255, 255, 255, 0.95) 100%);
    position: relative;
    overflow: hidden;
  }

  :root[data-theme='dark'] .friends-hero {
    background: linear-gradient(135deg, rgba(66, 90, 239, 0.18) 0%, rgba(24, 25, 30, 0.95) 100%);
  }

  .friends-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--theme-main, #425aef);
    letter-spacing: 1px;
    margin-bottom: 0.75rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }

  .friends-hero__title {
    font-size: 2.2rem;
    font-weight: 850;
    letter-spacing: -0.5px;
    color: var(--font-color);
    margin: 0 0 0.85rem;
    line-height: 1.25;
  }

  .friends-hero__summary {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary, #64748b);
    max-width: 800px;
    margin: 0 0 1.5rem;
  }

  .friends-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(66, 90, 239, 0.08);
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .stat-pill__label {
    color: var(--text-secondary, #64748b);
  }

  .stat-pill__val {
    font-weight: 800;
    color: var(--theme-main, #425aef);
  }

  .stat-pill__val.is-healthy {
    color: #10b981;
  }

  .friends-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .theme-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 18px;
    background: var(--theme-main, #425aef);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 6px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(66, 90, 239, 0.25);
    transition: all 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .theme-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(66, 90, 239, 0.4);
  }

  .theme-button--ghost {
    background: transparent;
    color: var(--font-color);
    border: 1px solid var(--border-color, rgba(66, 90, 239, 0.25));
    box-shadow: none;
  }

  .theme-button--ghost:hover {
    background: rgba(66, 90, 239, 0.08);
    color: var(--theme-main, #425aef);
    border-color: var(--theme-main, #425aef);
  }

  /* 2. 本站互链信息卡 */
  .site-config-card {
    padding: 1.5rem;
    transition: all 0.3s ease;
  }

  .site-config-card.highlight-pulse {
    border-color: #425aef;
    box-shadow: 0 0 0 3px rgba(66, 90, 239, 0.3);
  }

  .site-config-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed var(--border-color, rgba(0, 0, 0, 0.08));
  }

  .site-config-card__title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--font-color);
  }

  .site-config-card__tabs {
    display: flex;
    gap: 4px;
    background: rgba(0, 0, 0, 0.04);
    padding: 3px;
    border-radius: 6px;
  }

  .config-tab-btn {
    border: none;
    background: transparent;
    padding: 4px 10px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-secondary, #64748b);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .config-tab-btn.is-active {
    background: #fff;
    color: var(--theme-main, #425aef);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }

  :root[data-theme='dark'] .config-tab-btn.is-active {
    background: #2a2b32;
    color: #fff;
  }

  .site-config-card__preview {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem;
    background: rgba(66, 90, 239, 0.04);
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .site-config-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--theme-main, #425aef);
  }

  .site-config-info {
    flex: 1;
  }

  .site-config-name {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--font-color);
  }

  .site-config-url {
    font-size: 0.85rem;
    color: var(--theme-main, #425aef);
    margin-bottom: 2px;
  }

  .site-config-desc {
    font-size: 0.85rem;
    color: var(--text-secondary, #64748b);
  }

  .copy-code-btn {
    padding: 8px 16px;
    background: var(--theme-main, #425aef);
    color: #fff;
    border: none;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .copy-code-btn:hover {
    background: #3448c5;
  }

  .site-config-code-box pre {
    margin: 0;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.03);
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--font-color);
  }

  :root[data-theme='dark'] .site-config-code-box pre {
    background: rgba(0, 0, 0, 0.25);
  }

  /* 3. 分类与卡片网格 */
  .friends-groups {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .friends-category__header {
    margin-bottom: 1.25rem;
  }

  .friends-category__title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
  }

  .friends-category__icon {
    font-size: 1.4rem;
  }

  .friends-category__title {
    font-size: 1.4rem;
    font-weight: 850;
    color: var(--font-color);
    margin: 0;
  }

  .friends-category__count {
    font-size: 0.8rem;
    padding: 2px 8px;
    background: rgba(66, 90, 239, 0.1);
    color: var(--theme-main, #425aef);
    border-radius: 4px;
    font-weight: 700;
  }

  .friends-category__desc {
    font-size: 0.9rem;
    color: var(--text-secondary, #64748b);
    margin: 0;
  }

  .friends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem;
    text-decoration: none;
    position: relative;
    border-radius: 8px;
    transition: transform 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.22s ease,
                border-color 0.22s ease;
  }

  .friend-card:hover {
    transform: translateY(-4px);
    border-color: var(--theme-main, #425aef);
    box-shadow: 0 10px 24px -4px rgba(66, 90, 239, 0.25);
  }

  .friend-card.is-featured {
    border-left: 3px solid var(--theme-main, #425aef);
  }

  .friend-card__avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .friend-card__avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    background: rgba(0, 0, 0, 0.05);
    transition: transform 0.4s ease;
  }

  .friend-card:hover .friend-card__avatar {
    transform: rotate(360deg);
  }

  .status-dot {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid #fff;
  }

  :root[data-theme='dark'] .status-dot {
    border-color: #1e1f25;
  }

  .status-dot.is-online {
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .status-dot.is-checking {
