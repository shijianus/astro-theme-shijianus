---
import { friendsConfig } from '../../config/friends';

const totalFriends = friendsConfig.categories.reduce((acc, cat) => acc + cat.items.length, 0);
---

<section id="friends-dashboard" class="friends-dashboard">
  <!-- 1. 顶部 Hero 与统计看板 -->
  <div class="friends-hero theme-card">
    <div class="friends-hero__content">
      <div class="friends-hero__eyebrow">
        <span class="pulse-dot"></span>
        <span>友邻档案 · 友人帐</span>
      </div>
      <h1 class="friends-hero__title">海内存知己，天涯若比邻</h1>
      <p class="friends-hero__summary">
        在算法壁垒与孤岛之外，建立属于独立博客的去中心化连接。这里收录了持续写作、用心构建的同行者。欢迎每一位保持真诚表达的数字漫游者。
      </p>

      <div class="friends-hero__stats">
        <div class="stat-pill">
          <span class="stat-pill__label">已入驻友邻</span>
          <span class="stat-pill__val">{totalFriends} 位</span>
        </div>
        <div class="stat-pill">
          <span class="stat-pill__label">健康状态</span>
          <span class="stat-pill__val is-healthy">全绿在线</span>
        </div>
        <div class="stat-pill">
          <span class="stat-pill__label">互链开放</span>
          <span class="stat-pill__val">实时受理中</span>
        </div>
      </div>

      <div class="friends-hero__actions">
        <button id="btn-open-apply-modal" class="theme-button" type="button">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
          申请互链
        </button>
        <a class="theme-button theme-button--ghost" href="/status/">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          互链规范与生态状态
        </a>
        <a class="theme-button theme-button--ghost" href="/moments/">
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"></path></svg>
          前往朋友圈 (动态雷达)
        </a>
      </div>
    </div>
  </div>

  <!-- 2. 博友分类卡片网格 -->
  <div class="friends-groups">
    {friendsConfig.categories.map((category) => (
      <section class="friends-category" id={`category-${category.id}`}>
        <div class="friends-category__header">
          <div class="friends-category__title-wrap">
            <span class="friends-category__icon">
              {category.icon === 'terminal' && '💻'}
              {category.icon === 'palette' && '🎨'}
              {category.icon === 'compass' && '🧭'}
            </span>
            <h2 class="friends-category__title">{category.name}</h2>
            <span class="friends-category__count">{category.items.length} 位</span>
          </div>
          <p class="friends-category__desc">{category.desc}</p>
        </div>

        <div class="friends-grid">
          {category.items.map((friend) => (
            <a
              class={`friend-card theme-card ${friend.featured ? 'is-featured' : ''}`}
              href={friend.url}
              target="_blank"
              rel="noopener noreferrer"
              title={`拜访 ${friend.name}: ${friend.desc}`}
            >
              <div class="friend-card__avatar-wrap">
                <img
                  class="friend-card__avatar"
                  src={friend.avatar}
                  alt={friend.name}
                  loading="lazy"
                  onerror="this.src='/media/brands/default-brand.svg'"
                />
                <span class={`status-dot ${friend.status === 'online' ? 'is-online' : 'is-checking'}`} title={friend.status === 'online' ? '站点正常可达' : '检测中'}></span>
              </div>

              <div class="friend-card__body">
                <div class="friend-card__top">
                  <span class="friend-card__name">{friend.name}</span>
                  {friend.tag && (
                    <span class={`friend-card__tag tag-${friend.tagColor || 'blue'}`}>
                      {friend.tag}
                    </span>
                  )}
                </div>
                <p class="friend-card__desc">{friend.desc}</p>
              </div>

              <div class="friend-card__corner-icon" aria-hidden="true">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- 3. 友链自助申请模态弹窗 (Popup Modal) -->
  <div id="friend-apply-modal" class="friend-modal" aria-hidden="true" role="dialog" aria-labelledby="friend-modal-title">
    <div class="friend-modal__backdrop" id="friend-modal-backdrop"></div>
    <div class="friend-modal__dialog theme-card">
      <div class="friend-modal__header">
        <div class="friend-modal__title-group">
          <div class="friend-modal__eyebrow">
            <span class="pulse-dot"></span>
            <span>交换公约 · 自助申请</span>
          </div>
          <h3 id="friend-modal-title" class="friend-modal__title">申请加入友邻</h3>
          <p class="friend-modal__subtitle">提交后系统将通过 Telegram 机器人实时通知站长审核并完成双向添加</p>
        </div>
        <button id="friend-modal-close" class="friend-modal__close-btn" type="button" aria-label="关闭弹窗">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="friend-modal__body">
        <form id="modal-friend-apply-form" class="modal-form">
          <div class="form-row">
            <div class="form-field">
              <label for="modal-apply-name">站点名称 <span class="required-star">*</span></label>
              <input id="modal-apply-name" name="name" type="text" placeholder="例如：极客小窝" required />
            </div>
            <div class="form-field">
              <label for="modal-apply-url">站点链接 <span class="required-star">*</span></label>
              <input id="modal-apply-url" name="url" type="url" placeholder="https://example.com" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="modal-apply-avatar">头像 / 图标链接 <span class="required-star">*</span></label>
              <input id="modal-apply-avatar" name="avatar" type="url" placeholder="https://example.com/avatar.png" required />
            </div>
            <div class="form-field">
              <label for="modal-apply-cat">意向分类</label>
              <select id="modal-apply-cat" name="category">
                <option value="核心友邻 · 技术先锋">核心友邻 · 技术先锋</option>
                <option value="灵感花园 · 宝藏博客">灵感花园 · 宝藏博客</option>
                <option value="漫游行者 · 生活思索">漫游行者 · 生活思索</option>
                <option value="品牌矩阵 · 原生生态">品牌矩阵 · 原生生态</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="modal-apply-desc">站点简介 <span class="required-star">*</span></label>
            <input id="modal-apply-desc" name="desc" type="text" placeholder="一句话介绍您的博客定位或特色" required />
          </div>

          <div class="form-field">
            <label for="modal-apply-contact">联系方式 / 留言附言 (选填)</label>
            <input id="modal-apply-contact" name="contact" type="text" placeholder="您的邮箱或 Telegram @handle" />
          </div>

          <div class="modal-tip">
            <span>💡 提示：申请前请先将本站 (<a href="/status/" target="_blank">查看互链配置规范</a>) 添加至贵站友链，互帮互助。</span>
          </div>

          <div id="modal-form-alert" class="modal-form-alert" style="display: none;"></div>

          <div class="modal-form__actions">
            <button id="modal-btn-cancel" class="theme-button theme-button--ghost" type="button">取消</button>
            <button id="modal-btn-submit" class="theme-button theme-button--primary" type="submit">
              <span id="modal-btn-submit-text">🚀 提交互链申请</span>
            </button>
          </div>
        </form>

        <!-- 成功状态卡 -->
        <div id="modal-apply-success" class="modal-apply-success" style="display: none;">
          <div class="success-icon-wrap">
            <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <h4>申请提交成功！</h4>
          <p>站长已在 Telegram 收到实时申请通知。审核通过后将即时完成互链双向添加。</p>
          <button id="modal-btn-done" class="theme-button" type="button">我知道了</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 互动脚本：模态弹窗开闭与异步提交 -->
<script is:inline>
  (() => {
    const modal = document.getElementById('friend-apply-modal');
    const btnOpen = document.getElementById('btn-open-apply-modal');
    const btnClose = document.getElementById('friend-modal-close');
    const btnCancel = document.getElementById('modal-btn-cancel');
    const backdrop = document.getElementById('friend-modal-backdrop');
    const btnDone = document.getElementById('modal-btn-done');
    const form = document.getElementById('modal-friend-apply-form');
    const successCard = document.getElementById('modal-apply-success');
    const submitBtn = document.getElementById('modal-btn-submit');
    const submitBtnText = document.getElementById('modal-btn-submit-text');
    const formAlert = document.getElementById('modal-form-alert');

    function openModal() {
      if (!modal) return;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('shijianus-modal-open');
      if (form) form.style.display = 'flex';
      if (successCard) successCard.style.display = 'none';
      if (formAlert) {
        formAlert.style.display = 'none';
        formAlert.textContent = '';
      }
      setTimeout(() => {
        document.getElementById('modal-apply-name')?.focus();
      }, 100);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('shijianus-modal-open');
    }

    btnOpen?.addEventListener('click', openModal);
    btnClose?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    btnDone?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
        closeModal();
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !submitBtnText) return;

      const name = (document.getElementById('modal-apply-name')?.value || '').trim();
      const url = (document.getElementById('modal-apply-url')?.value || '').trim();
      const avatar = (document.getElementById('modal-apply-avatar')?.value || '').trim();
      const category = (document.getElementById('modal-apply-cat')?.value || '').trim();
      const desc = (document.getElementById('modal-apply-desc')?.value || '').trim();
      const contact = (document.getElementById('modal-apply-contact')?.value || '').trim();

      if (!name || !url) {
        if (formAlert) {
          formAlert.style.display = 'block';
          formAlert.className = 'modal-form-alert is-error';
          formAlert.textContent = '请完整填写站点名称与站点链接！';
        }
        return;
      }

      submitBtn.disabled = true;
      submitBtnText.textContent = '正在提交并通知站长...';

      try {
        const res = await fetch('/api/friends/apply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            formId: 'friend-link-apply',
            title: '友邻互链申请',
            name,
            url,
            avatar,
            category,
            desc,
            contact,
            source: 'friends_modal',
          }),
        });

        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          if (form) form.style.display = 'none';
          if (successCard) successCard.style.display = 'flex';
          form.reset();
        } else {
          throw new Error(data.error || '提交失败，请稍后重试');
        }
      } catch (err) {
        if (formAlert) {
          formAlert.style.display = 'block';
          formAlert.className = 'modal-form-alert is-error';
          formAlert.textContent = err?.message || '网络连接异常，请重试';
        }
      } finally {
        submitBtn.disabled = false;
        submitBtnText.textContent = '🚀 提交互链申请';
      }
    });
  })();
</script>

<style>
  .friends-dashboard {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .theme-card {
    background: var(--card-bg, rgba(255, 255, 255, 0.85));
    border: 1px solid var(--border-color, rgba(66, 90, 239, 0.15));
    border-radius: 8px;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  /* 1. Hero 样式 */
  .friends-hero {
    padding: 2.5rem 2rem;
    background: linear-gradient(135deg, rgba(66, 90, 239, 0.08) 0%, rgba(255, 255, 255, 0.95) 100%);
    position: relative;
    overflow: hidden;
  }

  :root[data-theme='dark'] .friends-hero {
    background: linear-gradient(135deg, rgba(66, 90, 239, 0.18) 0%, rgba(24, 25, 30, 0.95) 100%);
  }

  .friends-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--theme-main, #425aef);
    letter-spacing: 1px;
    margin-bottom: 0.75rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }

  .friends-hero__title {
    font-size: 2.2rem;
    font-weight: 850;
    letter-spacing: -0.5px;
    color: var(--font-color);
    margin: 0 0 0.85rem;
    line-height: 1.25;
  }

  .friends-hero__summary {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary, #64748b);
    max-width: 800px;
    margin: 0 0 1.5rem;
  }

  .friends-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(66, 90, 239, 0.08);
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .stat-pill__label {
    color: var(--text-secondary, #64748b);
  }

  .stat-pill__val {
    font-weight: 800;
    color: var(--theme-main, #425aef);
  }

  .stat-pill__val.is-healthy {
    color: #10b981;
  }

  .friends-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .theme-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 18px;
    background: var(--theme-main, #425aef);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 6px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(66, 90, 239, 0.25);
    transition: all 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .theme-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(66, 90, 239, 0.4);
  }

  .theme-button--ghost {
    background: transparent;
    color: var(--font-color);
    border: 1px solid var(--border-color, rgba(66, 90, 239, 0.25));
    box-shadow: none;
  }

  .theme-button--ghost:hover {
    background: rgba(66, 90, 239, 0.08);
    color: var(--theme-main, #425aef);
    border-color: var(--theme-main, #425aef);
  }

  /* 2. 分类与卡片网格 */
  .friends-groups {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .friends-category__header {
    margin-bottom: 1.25rem;
  }

  .friends-category__title-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
  }

  .friends-category__icon {
    font-size: 1.4rem;
  }

  .friends-category__title {
    font-size: 1.4rem;
    font-weight: 850;
    color: var(--font-color);
    margin: 0;
  }

  .friends-category__count {
    font-size: 0.8rem;
    padding: 2px 8px;
    background: rgba(66, 90, 239, 0.1);
    color: var(--theme-main, #425aef);
    border-radius: 4px;
    font-weight: 700;
  }

  .friends-category__desc {
    font-size: 0.9rem;
    color: var(--text-secondary, #64748b);
    margin: 0;
  }

  .friends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .friend-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem;
    text-decoration: none;
    position: relative;
    border-radius: 8px;
    transition: transform 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.22s ease,
                border-color 0.22s ease;
  }

  .friend-card:hover {
    transform: translateY(-4px);
    border-color: var(--theme-main, #425aef);
    box-shadow: 0 10px 24px -4px rgba(66, 90, 239, 0.25);
  }

  .friend-card.is-featured {
    border-left: 3px solid var(--theme-main, #425aef);
  }

  .friend-card__avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .friend-card__avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    background: rgba(0, 0, 0, 0.05);
    transition: transform 0.4s ease;
  }

  .friend-card:hover .friend-card__avatar {
    transform: rotate(360deg);
  }

  .status-dot {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid #fff;
  }

  :root[data-theme='dark'] .status-dot {
    border-color: #1e1f25;
  }

  .status-dot.is-online {
    background: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
  }

  .status-dot.is-checking {
    background: #94a3b8;
  }

  .friend-card__body {
    flex: 1;
    min-width: 0;
  }

  .friend-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 4px;
  }

  .friend-card__name {
    font-size: 1rem;
    font-weight: 800;
    color: var(--font-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .friend-card__tag {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .tag-blue { background: rgba(66, 90, 239, 0.12); color: #425aef; }
  .tag-green { background: rgba(16, 185, 129, 0.12); color: #10b981; }
  .tag-purple { background: rgba(147, 51, 234, 0.12); color: #9333ea; }
  .tag-orange { background: rgba(249, 115, 22, 0.12); color: #f97316; }
  .tag-cyan { background: rgba(6, 182, 212, 0.12); color: #06b6d4; }

  .friend-card__desc {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--text-secondary, #64748b);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .friend-card__corner-icon {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 14px;
    height: 14px;
    color: var(--theme-main, #425aef);
    opacity: 0;
    transform: translate(-3px, 3px);
    transition: all 0.2s ease;
  }

  .friend-card:hover .friend-card__corner-icon {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* 3. 模态弹窗样式 */
  .friend-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
  }

  .friend-modal.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .friend-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .friend-modal__dialog {
    position: relative;
    z-index: 10000;
    width: 92%;
    max-width: 580px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 2rem;
