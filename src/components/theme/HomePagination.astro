---
import { buildHomePageUrl, getHomePaginationItems } from '../../lib/home-feed';

interface Props {
  currentPage: number;
  lastPage: number;
  total?: number;
}

const { currentPage, lastPage, total } = Astro.props;
const items = getHomePaginationItems(currentPage, lastPage);
---

{lastPage > 1 && (
  <nav id="home-pagination" class="theme-card home-pagination" aria-label="文章分页导航">
    <div class="home-pagination__status" aria-live="polite">
      <span class="home-pagination__badge">
        <span class="home-pagination__badge-dot" aria-hidden="true"></span>
        <span>第 <strong>{currentPage}</strong> / {lastPage} 页</span>
      </span>
      {typeof total === 'number' && total > 0 && (
        <span class="home-pagination__total">共 {total} 篇</span>
      )}
    </div>

    <div class="home-pagination__nav-group" aria-label="页码列表">
      {currentPage > 1 ? (
        <a
          class="home-pagination__btn home-pagination__prev"
          href={buildHomePageUrl(currentPage - 1)}
          rel="prev"
          title="上一页"
          aria-label="上一页"
        >
          <i class="anzhiyufont anzhiyu-icon-angle-left" aria-hidden="true"></i>
          <span class="home-pagination__btn-text">上页</span>
        </a>
      ) : (
        <span
          class="home-pagination__btn home-pagination__prev is-disabled"
          aria-disabled="true"
          title="已是第一页"
        >
          <i class="anzhiyufont anzhiyu-icon-angle-left" aria-hidden="true"></i>
          <span class="home-pagination__btn-text">上页</span>
        </span>
      )}

      <div class="home-pagination__numbers">
        {items.map((item) =>
          item === 'ellipsis' ? (
            <details class="home-pagination__jump-dropdown">
              <summary class="home-pagination__num home-pagination__ellipsis" title="快速跳转页码" aria-label="快速跳转页码">
                <span class="home-pagination__ellipsis-dots">…</span>
              </summary>
              <form class="home-pagination__jump-popup" data-home-pagination-jump data-max-page={lastPage}>
                <div class="home-pagination__jump-input-wrap">
                  <input
                    type="number"
                    min="1"
                    max={lastPage}
                    inputmode="numeric"
                    placeholder={`1-${lastPage}`}
                    required
                    aria-label="输入目标页码"
                  />
                  <button type="submit" class="home-pagination__jump-submit" title="前往">
                    前往
                  </button>
                </div>
              </form>
            </details>
          ) : item === currentPage ? (
            <span class="home-pagination__num is-current" aria-current="page">
              {item}
            </span>
          ) : (
            <a class="home-pagination__num" href={buildHomePageUrl(item)} title={`前往第 ${item} 页`}>
              {item}
            </a>
          ),
        )}
      </div>

      {currentPage < lastPage ? (
        <a
          class="home-pagination__btn home-pagination__next"
          href={buildHomePageUrl(currentPage + 1)}
          rel="next"
          title="下一页"
          aria-label="下一页"
        >
          <span class="home-pagination__btn-text">下页</span>
          <i class="anzhiyufont anzhiyu-icon-angle-right" aria-hidden="true"></i>
        </a>
      ) : (
        <span
          class="home-pagination__btn home-pagination__next is-disabled"
          aria-disabled="true"
          title="已是最后一页"
        >
          <span class="home-pagination__btn-text">下页</span>
          <i class="anzhiyufont anzhiyu-icon-angle-right" aria-hidden="true"></i>
        </span>
      )}
    </div>
  </nav>
)}

<script is:inline>
  (() => {
    const forms = document.querySelectorAll('[data-home-pagination-jump]');
    if (forms.length === 0) return;

    forms.forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return;
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const maxPage = Number.parseInt(form.dataset.maxPage || '1', 10);
        const input = form.querySelector('input');
        if (!(input instanceof HTMLInputElement)) return;
        const requestedPage = Number.parseInt(input.value || '1', 10);
        const nextPage = Math.min(Math.max(1, requestedPage), Math.max(1, maxPage));
        window.location.href = nextPage <= 1 ? '/' : `/page/${nextPage}/`;
      });
    });
  })();
</script>
