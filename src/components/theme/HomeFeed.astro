---
import type { CollectionEntry } from 'astro:content';
import { getCategoryPath } from '../../lib/content';
import type { HomeCategoryRail } from '../../config/site';
import PostCard from './PostCard.astro';
import HomePagination from './HomePagination.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
  currentPage: number;
  lastPage: number;
  total?: number;
  categories: Array<{
    label: string;
    slug: string;
    count: number;
  }>;
  categoryRail: HomeCategoryRail;
}

const {
  posts,
  currentPage,
  lastPage,
  total,
  categories,
  categoryRail,
} = Astro.props;

const isLastPage = currentPage >= lastPage;
---

<div
  id="recent-posts"
  class="recent-posts"
  data-feed-page={currentPage}
  data-feed-pages={lastPage}
  data-is-last-page={isLastPage ? 'true' : 'false'}
>
  <div id="categoryBar" class="categoryBar mb-4">
    <div
      class="category-bar group relative rounded-xl overflow-hidden bg-[var(--card-bg)] flex items-center border border-[var(--card-border)] shadow-xs transition-all duration-300"
      id="category-bar"
    >
      <div id="catalog-bar" class="w-full flex items-center gap-2.5">
        <div id="catalog-list" class="flex items-center gap-2 overflow-x-auto py-1 px-1">
          <div class="catalog-list-item is-active"><a href="/">{categoryRail.homeLabel}</a></div>
          {categories.map((item) => (
            <div class="catalog-list-item">
              <a href={getCategoryPath(item.slug)}>{item.label}</a>
            </div>
          ))}
        </div>
        <button
          class="category-bar-next"
          id="category-bar-next"
          type="button"
          onclick="document.getElementById('catalog-list')?.scrollBy({ left: 180, behavior: 'smooth' })"
          aria-label={categoryRail.nextLabel}
        >
          <i class="anzhiyufont anzhiyu-icon-angle-double-right"></i>
        </button>
        <a class="catalog-more" href="/categories/">{categoryRail.moreLabel}</a>
      </div>
    </div>
  </div>

  <div class="home-posts-sticky-group" id="home-posts-sticky-group">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      {posts.map((entry, index) => (
        <PostCard entry={entry} index={index} />
      ))}
    </div>

    <HomePagination currentPage={currentPage} lastPage={lastPage} total={total} />
  </div>
</div>
