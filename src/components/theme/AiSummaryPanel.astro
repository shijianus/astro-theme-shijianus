        refreshTitle: 'Zusammenfassung neu generieren',
        switchModeTitle: 'KI-Modell wechseln (LLMGPT / InstanceAI / PrimerAI)',
        modePillTitle: 'Aktueller KI-Modus',
        initialLoading: 'Wichtigste Erkenntnisse und Systemarchitektur werden via Chronral destilliert...',
        actions: {
          point: { label: '💡 Kernpunkte', title: 'Wichtigste Architekturargumente extrahieren' },
          audience: { label: '🎯 Zielgruppe', title: 'Zielgruppe und gelöste technische Probleme' },
          quick: { label: '⏱️ 30s Überblick', title: 'Schneller 3-Satz-Überblick' },
          insight: { label: '🧠 Praxistipps', title: 'Architekturentscheidungen und Fallstricke' },
          intro: { label: '👤 Über den Autor', title: 'Hintergrund des Autors und Bauphilosophie' },
          related: { label: '📚 Ähnliche Beiträge', title: 'KI-Empfehlungen zur Vertiefung' },
          top: { label: '🔝 Nach oben', title: 'Sanft nach oben scrollen' },
        },
        thinkingPrefix: 'Rufe',
        thinkingSuffix: 'zum Nachdenken auf...',
        thinkingSteps: [
          'Analysiere Kontext und Architekturentwicklung...',
          'Extrahiere Kernaussagen und Systementscheidungen...',
          'Formuliere dichte und präzise Zusammenfassung...',
        ],
        llmgptThinking: 'Destilliere Antwort via LLMGPT...',
        error429: 'Modell meldet 429! Zusammenfassung überlastet. Bitte {mode}-Dienst prüfen!',
        relatedIntro: 'Ausgewählte weiterführende Artikel zu "{title}":',
        authorIntroFallback: 'Kontinuierliche Entwicklung und Veröffentlichung nachhaltiger Softwaresysteme.',
      },
    };

    const getDeviceId = () => {
      const key = 'shijianus-device-id';
      try {
        const saved = window.localStorage.getItem(key);
        if (saved) return saved;
        const created = typeof crypto !== 'undefined' && crypto.randomUUID
          ? crypto.randomUUID()
          : `device-${Date.now()}-${Math.random().toString(16).slice(2)}`;
        window.localStorage.setItem(key, created);
        return created;
      } catch {
        return `device-${Date.now()}`;
      }
    };

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const typeInto = (node, value, onComplete) => {
      if (!(node instanceof HTMLElement)) return;
      const cursor = '<span class="shijianus-ai-summary__cursor"></span>';
      let index = 0;
      const text = (value || '').trim();
      if (!text) {
        node.textContent = '';
        if (onComplete) onComplete();
        return;
      }
      if (prefersReducedMotion || text.length > 280) {
        node.textContent = text;
        if (onComplete) onComplete();
        return;
      }
      const runId = `${Date.now()}-${Math.random().toString(16).slice(2)}`;
      node.dataset.typeRunId = runId;
      node.innerHTML = '';
      const step = text.length > 100 ? 3 : 2;

      const tick = () => {
        if (node.dataset.typeRunId !== runId) return;
        index = Math.min(text.length, index + step);
        node.innerHTML = `${text.slice(0, index)}${index < text.length ? cursor : ''}`;
        if (index < text.length) {
          window.setTimeout(tick, /[,.，。！？!?\n]/.test(text.charAt(index - 1)) ? 32 : 16);
        } else if (onComplete) {
          onComplete();
        }
      };

      tick();
    };

    const SUPPORTED_MODELS = [
      'kimi-k3',
      'deepseek-v4-flash',
      'gpt-oss-120b',
      'gpt-oss-20b',
      'deepseek-v4-pro',
      'glm-5.2',
    ];

    const getRandomModel = () => {
      return SUPPORTED_MODELS[Math.floor(Math.random() * SUPPORTED_MODELS.length)] || 'kimi-k3';
    };

    // 3 Primary Model Classes: LLMGPT (build-time static), InstanceAI (live with CoT thinking), PrimerAI (author markdown)
    const MODES = [
      { id: 'llmgpt', label: 'LLMGPT', desc: '离线预构建模型' },
      { id: 'instance', label: 'InstanceAI', desc: '实时推演模型（支持思考链）' },
      { id: 'primer', label: 'PrimerAI', desc: '作者自述摘要' },
    ];

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      const output = root.querySelector('[data-ai-output]');
      const brandTitleEl = root.querySelector('[data-ai-brand-title]');
      const modeLabel = root.querySelector('[data-ai-mode-label]');
      const switchBtn = root.querySelector('[data-ai-switch-mode]');
      const relatedBox = root.querySelector('[data-ai-related]');
      const refreshButton = root.querySelector('[data-ai-refresh]');
      const modePill = root.querySelector('.shijianus-ai-summary__mode-pill');
      const apiBase = root.dataset.apiBase || '/api';
      const slug = root.dataset.slug || '';
      const title = root.dataset.title || document.title;
      const primerSummary = root.dataset.primerSummary || '';
      const staticSummary = root.dataset.staticSummary || '';
      const url = root.dataset.url || window.location.href;
      const relatedEmptyMessage = root.dataset.relatedEmpty || '当前还没有找到合适的延伸阅读，可以先回到首页看看最近更新。';

      let staticSummaries = {};
      try {
        staticSummaries = JSON.parse(root.dataset.staticSummaries || '{}');
      } catch {}

      let introTemplatesZh = [];
      try {
        introTemplatesZh = JSON.parse(root.dataset.introTemplates || '[]');
      } catch {}

      let introTemplatesEn = [];
      try {
        introTemplatesEn = JSON.parse(root.dataset.introTemplatesEn || '[]');
      } catch {}

      let authorIntroIndex = 0;
      let currentModeIndex = 0; // 0: LLMGPT (default fast load), 1: InstanceAI, 2: PrimerAI
      let isLoading = false;
      let activeAbortController = null;
      let activeThinkingInterval = null;
      let activeActionName = null;
      let userExplicitlySwitchedLang = null;

      // Priority Rule:
      // 1. If user explicitly clicked a summary language tab (userExplicitlySwitchedLang), use that.
      // 2. The article's native language (root.dataset.articleLang) takes precedence so that
      //    an English article presents the English AI summary by default.
      // 3. Document element lang / dataset.localeVariant.
      // 4. Stored manual preference or fallback to zh-CN.
      const getTargetLanguage = () => {
        if (userExplicitlySwitchedLang) {
          return normalizeLocale(userExplicitlySwitchedLang);
        }

        const articleLang = root.dataset.articleLang;
        if (articleLang) {
          return normalizeLocale(articleLang);
        }

        const docVariant = document.documentElement.dataset.localeVariant || document.documentElement.lang;
        if (docVariant && docVariant !== 'zh-CN') {
          return normalizeLocale(docVariant);
        }

        const manualSelected = window.localStorage.getItem('shijianus-manual-locale-selected');
        if (manualSelected) {
          return normalizeLocale(manualSelected);
        }

        const storedVariant = window.localStorage.getItem('shijianus-locale-variant');
        if (storedVariant && storedVariant !== 'zh-CN') {
          return normalizeLocale(storedVariant);
        }

        return 'zh-CN';
      };

      const getI18n = () => {
        const lang = getTargetLanguage();
        return I18N_DICTIONARY[lang] || I18N_DICTIONARY['zh-CN'];
      };

      const get429ErrorMessage = (modeId) => {
        const i18n = getI18n();
        const modeLabelText = modeId === 'primer' ? 'PrimerAI' : modeId === 'llmgpt' ? 'LLMGPT' : 'InstanceAI';
        return i18n.error429.replace('{mode}', modeLabelText);
      };

      // Updates UI labels (brand, action buttons, tooltips) dynamically based on current language
      const updateUiLanguage = () => {
        const i18n = getI18n();
        if (brandTitleEl instanceof HTMLElement) {
          brandTitleEl.textContent = i18n.brandTitle;
        }
        if (refreshButton instanceof HTMLButtonElement) {
          refreshButton.title = i18n.refreshTitle;
          refreshButton.setAttribute('aria-label', i18n.refreshTitle);
        }
        if (switchBtn instanceof HTMLButtonElement) {
          switchBtn.title = i18n.switchModeTitle;
          switchBtn.setAttribute('aria-label', i18n.switchModeTitle);
        }
        if (modePill instanceof HTMLElement) {
          modePill.title = i18n.modePillTitle;
        }

        root.querySelectorAll('[data-ai-action]').forEach((btn) => {
          if (!(btn instanceof HTMLElement)) return;
          const actionKey = btn.dataset.aiAction;
          if (actionKey && i18n.actions[actionKey]) {
            btn.textContent = i18n.actions[actionKey].label;
            btn.title = i18n.actions[actionKey].title;
          }
        });
      };

      const cancelActiveRequest = () => {
        if (activeThinkingInterval) {
          window.clearInterval(activeThinkingInterval);
          activeThinkingInterval = null;
        }
        if (activeAbortController) {
          activeAbortController.abort();
          activeAbortController = null;
        }
        isLoading = false;
        if (refreshButton instanceof HTMLButtonElement) {
          refreshButton.disabled = false;
          refreshButton.classList.remove('is-spinning');
        }
      };

      const finishRequest = () => {
        if (activeThinkingInterval) {
          window.clearInterval(activeThinkingInterval);
          activeThinkingInterval = null;
        }
        activeAbortController = null;
        isLoading = false;
        if (refreshButton instanceof HTMLButtonElement) {
          refreshButton.disabled = false;
          refreshButton.classList.remove('is-spinning');
        }
      };

      const setActiveAction = (actionName = null) => {
        activeActionName = actionName;
        root.querySelectorAll('[data-ai-action]').forEach((btn) => {
          if (btn instanceof HTMLElement) {
            btn.classList.toggle('is-active', Boolean(actionName && btn.dataset.aiAction === actionName));
          }
        });
      };

      const setModeDisplay = (modeId) => {
        const target = MODES.find((m) => m.id === modeId) || MODES[0];
        if (modeLabel instanceof HTMLElement) {
          modeLabel.textContent = target.label;
        }
      };

      const renderRelatedDrawer = (reasonText = '') => {
        if (!(relatedBox instanceof HTMLElement)) return;
        let items = [];
        try {
          items = JSON.parse(root.dataset.related || '[]');
        } catch {}

        if (!Array.isArray(items) || items.length === 0) {
          relatedBox.hidden = true;
          typeInto(output, relatedEmptyMessage);
          return;
        }

        relatedBox.replaceChildren();
        items.slice(0, 3).forEach((item, index) => {
          if (!item || typeof item.title !== 'string' || typeof item.href !== 'string') return;
          const link = document.createElement('a');
          link.href = item.href;
          const number = document.createElement('span');
          number.textContent = String(index + 1).padStart(2, '0');
          const itemTitle = document.createElement('strong');
          itemTitle.textContent = item.title;
          link.append(number, itemTitle);
          relatedBox.append(link);
        });
        relatedBox.hidden = false;

        const i18n = getI18n();
        const explanation =
          reasonText ||
          i18n.relatedIntro.replace('{title}', title);
        typeInto(output, explanation);
      };

      // Real live AI caller with explicit language targeting
      const fetchLiveAi = async (params = {}) => {
        cancelActiveRequest();
        relatedBox instanceof HTMLElement && (relatedBox.hidden = true);

        const article = document.querySelector('#article-container');
        const content = (article?.textContent?.replace(/\s+/g, ' ').trim() || '').slice(0, 80000);
        if (!content) {
          typeInto(output, primerSummary || get429ErrorMessage(params.mode || 'instance'));
          return;
        }

        isLoading = true;
        activeAbortController = new AbortController();
        const currentController = activeAbortController;

        if (refreshButton instanceof HTMLButtonElement) {
          refreshButton.disabled = true;
          refreshButton.classList.add('is-spinning');
        }

        const mode = params.mode || MODES[currentModeIndex].id;
        const questionType = params.questionType || '';
        const targetLang = params.lang || getTargetLanguage();
        const assignedModel = getRandomModel();
        const isInstanceMode = mode === 'instance';
        const i18n = I18N_DICTIONARY[targetLang] || getI18n();

        const startTime = Date.now();

        // InstanceAI displays dynamic Thinking CoT preview in target language
        if (isInstanceMode && !params.skipThinking) {
          const thinkingSteps = [
            `${i18n.thinkingPrefix} ${assignedModel} ${i18n.thinkingSuffix}`,
            `${i18n.thinkingPrefix} ${assignedModel} ${i18n.thinkingSuffix} ${i18n.thinkingSteps[0]}`,
            `${i18n.thinkingPrefix} ${assignedModel} ${i18n.thinkingSuffix} ${i18n.thinkingSteps[1]}`,
            `${i18n.thinkingPrefix} ${assignedModel} ${i18n.thinkingSuffix} ${i18n.thinkingSteps[2]}`,
          ];

          let stepIndex = 0;
          if (output instanceof HTMLElement) {
            output.innerHTML = `<span class="shijianus-ai-summary__thinking">${thinkingSteps[0]}</span>`;
          }

          activeThinkingInterval = window.setInterval(() => {
            stepIndex = (stepIndex + 1) % thinkingSteps.length;
            if (output instanceof HTMLElement && isLoading) {
              output.innerHTML = `<span class="shijianus-ai-summary__thinking">${thinkingSteps[stepIndex]}</span>`;
            }
          }, 900);
        } else if (params.mode === 'llmgpt' && questionType) {
          if (output instanceof HTMLElement) {
            output.textContent = i18n.llmgptThinking;
          }
        }

        try {
          let relatedList = [];
          try {
            relatedList = JSON.parse(root.dataset.related || '[]');
          } catch {}

          const response = await fetch(`${apiBase}/ai-summary`, {
            method: 'POST',
            signal: currentController.signal,
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
              'X-Shijianus-Device-Id': getDeviceId(),
            },
            body: JSON.stringify({
              slug,
              title,
              summary: primerSummary,
              url,
              content,
              mode,
              questionType,
              lang: targetLang,
              related: relatedList,
            }),
          });

          const payload = await response.json();
          if (currentController.signal.aborted) return;
          if (!response.ok || !payload?.summary) {
            throw new Error(payload?.error || `Request failed with ${response.status}`);
          }

          // In InstanceAI mode, ensure 2.5s thinking perception
          if (isInstanceMode && !params.skipThinking) {
            const elapsed = Date.now() - startTime;
            const remainingWait = Math.max(0, 2500 - elapsed);
            if (remainingWait > 0) {
              await new Promise((r) => setTimeout(r, remainingWait));
            }
          }

          if (currentController.signal.aborted) return;
          if (activeThinkingInterval) {
            window.clearInterval(activeThinkingInterval);
            activeThinkingInterval = null;
          }

          if (questionType === 'related_reason') {
            renderRelatedDrawer(payload.summary);
          } else {
            typeInto(output, payload.summary);
          }
        } catch (error) {
          if (currentController.signal.aborted) return;
          if (activeThinkingInterval) {
            window.clearInterval(activeThinkingInterval);
            activeThinkingInterval = null;
          }
          if (questionType === 'related_reason') {
            renderRelatedDrawer();
          } else {
            const fallbackText = primerSummary || get429ErrorMessage(mode);
            typeInto(output, fallbackText);
          }
        } finally {
          if (activeAbortController === currentController) {
            finishRequest();
          }
        }
      };

      const applyMode = (modeId, options = {}) => {
        cancelActiveRequest();
        if (!options.preserveAction) {
          setActiveAction(null);
        }
        relatedBox instanceof HTMLElement && (relatedBox.hidden = true);
        setModeDisplay(modeId);
        updateUiLanguage();

        const targetLang = getTargetLanguage();
        const articleLang = normalizeLocale(root.dataset.articleLang || 'zh-CN');

        if (modeId === 'primer') {
          if (primerSummary) {
            if (targetLang === 'zh-Hant' && typeof window.__shijianus_convertText === 'function') {
              typeInto(output, window.__shijianus_convertText(primerSummary));
            } else {
              typeInto(output, primerSummary);
            }
          } else {
            typeInto(output, get429ErrorMessage('primer'));
          }
          return;
        }

        if (modeId === 'llmgpt') {
          // Check if we have a pre-baked static summary specifically for targetLang
          const candidateStatic = staticSummaries[targetLang];
          if (candidateStatic && !options.force) {
            typeInto(output, candidateStatic);
            return;
          }

          // If targetLang matches the article's native language, default staticSummary can be used directly
          if (targetLang === articleLang && staticSummary && !options.force) {
            typeInto(output, staticSummary);
            return;
          }

          // When targetLang is different from articleLang (e.g. English UI requested on a Chinese article),
          // call the API to fetch or generate the cached summary in targetLang!
          if (targetLang !== articleLang || options.force) {
            void fetchLiveAi({ mode: 'llmgpt', lang: targetLang, skipThinking: true });
            return;
          }

          if (staticSummary) {
            typeInto(output, staticSummary);
          } else if (primerSummary) {
            typeInto(output, primerSummary);
          } else {
            typeInto(output, get429ErrorMessage('llmgpt'));
          }
          return;
        }

        if (modeId === 'instance') {
          void fetchLiveAi({ mode: 'instance', lang: targetLang });
        }
      };

      // Switch mode button click (cycles LLMGPT -> InstanceAI -> PrimerAI)
      switchBtn?.addEventListener('click', () => {
        currentModeIndex = (currentModeIndex + 1) % MODES.length;
        const nextMode = MODES[currentModeIndex].id;
        applyMode(nextMode);
      });

      // Refresh button click (re-generates / resets summary for current mode)
      refreshButton?.addEventListener('click', () => {
        const mode = MODES[currentModeIndex].id;
        applyMode(mode, { force: true });
      });

      // Action buttons
      root.querySelectorAll('[data-ai-action]').forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLElement)) return;
          const action = button.dataset.aiAction;
          if (!action) return;

          if (action === 'top') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }

          setActiveAction(action);
          const currentMode = MODES[currentModeIndex].id;
          const targetLang = getTargetLanguage();
          const i18n = getI18n();

          if (action === 'intro') {
            cancelActiveRequest();
            relatedBox instanceof HTMLElement && (relatedBox.hidden = true);
            const templates = targetLang === 'en' && introTemplatesEn.length > 0 ? introTemplatesEn : introTemplatesZh;
            authorIntroIndex = (authorIntroIndex + 1) % Math.max(1, templates.length);
            const selected =
              templates[authorIntroIndex] ||
              templates[0] ||
              i18n.authorIntroFallback;
            typeInto(output, selected);
            return;
          }

          if (action === 'related') {
            if (currentMode === 'primer') {
              renderRelatedDrawer();
            } else {
              void fetchLiveAi({
                mode: currentMode,
                questionType: 'related_reason',
                lang: targetLang,
                skipThinking: currentMode !== 'instance',
              });
            }
            return;
          }

          if (['point', 'audience', 'quick', 'insight'].includes(action)) {
            if (currentMode === 'primer') {
              if (primerSummary) {
                const prefix = targetLang === 'en' ? '[Author Note] ' : targetLang === 'zh-Hant' ? '【作者手記】' : '【作者手记】';
                typeInto(output, `${prefix}${primerSummary}`);
              } else {
                typeInto(output, get429ErrorMessage('primer'));
              }
            } else {
              void fetchLiveAi({
                mode: currentMode,
                questionType: action,
                lang: targetLang,
                skipThinking: currentMode !== 'instance',
              });
            }
          }
        });
      });

      // Synchronize language switch in real-time across the entire page lifecycle
      const handleLocaleSwitch = (newLang) => {
        const normalized = normalizeLocale(newLang);
        if (userExplicitlySwitchedLang === normalized) return;
        userExplicitlySwitchedLang = normalized;
        updateUiLanguage();

        // If an action was active, re-distill in the new language
        if (activeActionName) {
          const actionBtn = root.querySelector(`[data-ai-action="${activeActionName}"]`);
          if (actionBtn instanceof HTMLElement) {
            actionBtn.click();
            return;
          }
        }

        // Otherwise, reload the summary in the new language
        const currentMode = MODES[currentModeIndex].id;
        applyMode(currentMode, { force: true });
      };

      window.addEventListener('shijianus:localechange', (e) => {
        handleLocaleSwitch(e?.detail);
      });

      // Mutation observer on <html data-locale-variant> to catch any direct DOM locale changes
      const htmlObserver = new MutationObserver((mutations) => {
        for (const m of mutations) {
          if (m.attributeName === 'data-locale-variant') {
            const next = document.documentElement.dataset.localeVariant;
            if (next) handleLocaleSwitch(next);
          }
        }
      });
      htmlObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-locale-variant'] });

      // Immediately synchronize UI language labels
      updateUiLanguage();

      // Intersection Observer for initial auto load
      const observer = new IntersectionObserver((entries) => {
        if (!entries[0]?.isIntersecting) return;
        observer.disconnect();
        updateUiLanguage();
        applyMode('llmgpt');
      }, { threshold: 0.15 });

      observer.observe(root);
    });
  })();
</script>
