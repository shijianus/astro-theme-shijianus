---
import { siteConfig } from '../../config/site';

interface RelatedItem {
  title: string;
  href: string;
}

interface Props {
  slug: string;
  title: string;
  summary?: string;
  url: string;
  related?: RelatedItem[];
}

const rawRuntimeApiBase = process.env.PUBLIC_RUNTIME_API_BASE?.trim() || '';
const runtimeApiBase = rawRuntimeApiBase.replace(/\/api\/?$/, '');
const apiBase = runtimeApiBase ? `${runtimeApiBase}/api` : '/api';
const { slug, title, summary = '', url, related = [] } = Astro.props;
const gptName = siteConfig.post.ai?.gptName || 'Shijianus';
const introTemplates = siteConfig.post.ai?.introTemplates || [
  '你好呀！我是这里的文章辅助智能助手，由博客作者打造。我可以帮你快速提炼文章精华、梳理重点内容，还可以推荐更多同类好文哦~',
  '嗨！我是 Shijianus GPT 知识助理。在浩瀚的文字宇宙中，我的使命是带你三分钟读懂每篇深度干货，快点击下方按钮和我互动吧！',
  '哈喽！我是你的专属阅读向导。不管是长篇架构解析还是前端实践心得，我都能为你瞬间提炼核心洞见，助你高效探索！',
  '欢迎来到这片知识自留地！我是常驻站点的 AI 阅读伴侣，为你提炼关键思路、指引延伸阅读，随时点击下方按钮试试吧！',
  '你好！我是本站的 AI 内容解析官。点击下方按钮，让我为你生成本文简介、推荐关联好文，或者带你漫游主页~',
];
---

<div
  class="post-ai-description"
  data-ai-panel
  data-api-base={apiBase}
  data-slug={slug}
  data-title={title}
  data-summary={summary}
  data-url={url}
  data-gpt-name={gptName}
  data-intros={JSON.stringify(introTemplates)}
  data-related={JSON.stringify(related)}
>
  <div class="ai-title">
    <div class="ai-title-left">
      <svg class="ai-gpt-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2a10 10 0 0 1 10 10c0 5.523-4.477 10-10 10S2 17.523 2 12A10 10 0 0 1 12 2z"></path>
        <path d="M12 6v6l4 2"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <div class="ai-title-text">AI-摘要</div>
    </div>
    <div class="ai-title-controls">
      <div id="ai-Toggle" class="ai-toggle-btn" title="切换模式">切换</div>
      <i class="ai-btn-refresh anzhiyufont anzhiyu-icon-arrow-rotate-right" title="重新生成摘要"></i>
      <i class="ai-btn-tts anzhiyufont anzhiyu-icon-circle-dot" title="朗读摘要"></i>
      <div id="ai-tag">{gptName} GPT</div>
    </div>
  </div>

  <div class="ai-explanation">
    <span class="ai-explanation-content">AI 初始化中...</span>
    <div class="ai-cursor"></div>
  </div>

  <div class="ai-btn-box">
    <div class="ai-btn-item" data-action="intro">介绍自己 🙈</div>
    <div class="ai-btn-item" data-action="summary">生成本文简介 👋</div>
    <div class="ai-btn-item" data-action="recommend">推荐相关文章 📖</div>
    <div class="ai-btn-item" data-action="home">前往主页 🏠</div>
  </div>
</div>

<script is:inline>
  (() => {
    const panels = document.querySelectorAll('[data-ai-panel]');
    if (!panels.length) return;

    panels.forEach((panel) => {
      if (!(panel instanceof HTMLElement)) return;
      if (panel.dataset.aiInitialized === 'true') return;
      panel.dataset.aiInitialized = 'true';

      const explanationContent = panel.querySelector('.ai-explanation-content');
      const cursor = panel.querySelector('.ai-cursor');
      const refreshBtn = panel.querySelector('.ai-btn-refresh');
      const toggleBtn = panel.querySelector('#ai-Toggle');
      const ttsBtn = panel.querySelector('.ai-btn-tts');
      const aiTag = panel.querySelector('#ai-tag');
      const actionBtns = Array.from(panel.querySelectorAll('.ai-btn-item'));

      const slug = panel.dataset.slug || '';
      const title = panel.dataset.title || document.title;
      const initialSummary = panel.dataset.summary || '';
      const gptName = panel.dataset.gptName || 'Shijianus';
      const apiBase = panel.dataset.apiBase || '/api';
      let intros = [];
      let relatedItems = [];

      try {
        intros = JSON.parse(panel.dataset.intros || '[]');
      } catch {}
      try {
        relatedItems = JSON.parse(panel.dataset.related || '[]');
      } catch {}

      let currentTimer = null;
      let isTyping = false;
      let lastIntroIdx = -1;
      let mode = 'summary'; // 'summary' | 'intro' | 'recommend'
      let refreshCount = 0;

      const clearAllTimers = () => {
        if (currentTimer) {
          clearTimeout(currentTimer);
          currentTimer = null;
        }
      };

      const startTypewriter = (text, isHtml = false, callback = null) => {
        clearAllTimers();
        if (!explanationContent) return;

        if (isHtml) {
          explanationContent.innerHTML = text;
          if (cursor) cursor.style.display = 'none';
          if (callback) callback();
          return;
        }

        if (cursor) cursor.style.display = 'inline-block';
        explanationContent.textContent = '';
        let idx = 0;
        isTyping = true;

        const typeNext = () => {
          if (idx < text.length) {
            const char = text.charAt(idx);
            explanationContent.textContent += char;
            idx++;
            const delay = /[,.，。！？!?\n]/.test(char) ? 140 : 22;
            currentTimer = setTimeout(typeNext, delay);
          } else {
            isTyping = false;
            if (cursor) cursor.style.display = 'none';
            if (callback) callback();
          }
        };

        typeNext();
      };

      const fetchLiveSummary = async () => {
        if (refreshBtn) {
          refreshCount++;
          refreshBtn.style.transform = `rotate(${refreshCount * 360}deg)`;
          refreshBtn.style.opacity = '0.3';
        }

        startTypewriter('正在整理文章结构，提炼核心论点并生成智能导读...');

        // Check sessionStorage cache
        const cacheKey = `shijianus-ai:${slug}`;
        try {
          const cached = sessionStorage.getItem(cacheKey);
          if (cached) {
            const parsed = JSON.parse(cached);
            if (parsed && parsed.summary) {
              setTimeout(() => {
                startTypewriter(parsed.summary);
                if (refreshBtn) refreshBtn.style.opacity = '1';
              }, 400);
              return;
            }
          }
        } catch {}

        try {
          const article = document.querySelector('#article-container');
          const content = article?.textContent?.replace(/\s+/g, ' ').trim() || '';

          const response = await fetch(`${apiBase}/ai-summary`, {
            method: 'POST',
            headers: {
              Accept: 'application/json',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ slug, title, summary: initialSummary, content: content.slice(0, 3000) }),
          });

          if (response.ok) {
            const data = await response.json();
            if (data?.summary) {
              sessionStorage.setItem(cacheKey, JSON.stringify({ summary: data.summary }));
              startTypewriter(data.summary);
              if (refreshBtn) refreshBtn.style.opacity = '1';
              return;
            }
          }
        } catch (e) {
          console.warn('AI summary fetch failed, using fallback summary:', e);
        }

        // Graceful fallback
        const fallback = initialSummary || `在这篇文章中，作者围绕「${title}」进行了深入探讨，梳理了关键原理、实现细节与实践心得。点击下方按钮可探索相关内容或作者介绍。`;
        setTimeout(() => {
          startTypewriter(fallback);
          if (refreshBtn) refreshBtn.style.opacity = '1';
        }, 500);
      };

      const handleIntro = () => {
        if (!intros.length) {
          startTypewriter(`你好，我是本站的智能阅读助手 ${gptName} GPT，点击下方按钮让我为你生成本文简介或推荐相关文章！`);
          return;
        }
        let rand = Math.floor(Math.random() * intros.length);
        if (rand === lastIntroIdx && intros.length > 1) {
          rand = (rand + 1) % intros.length;
        }
        lastIntroIdx = rand;
        startTypewriter(intros[rand]);
      };

      const handleRecommend = () => {
        let items = relatedItems;
        if (!items || !items.length) {
          const recentList = document.querySelectorAll('.card-widget.card-recent-post .aside-list-item');
          if (recentList.length) {
            items = Array.from(recentList).map((el) => {
              const a = el.querySelector('a') || el;
              const titleEl = el.querySelector('.title');
              return {
                title: titleEl?.textContent?.trim() || a.getAttribute('title') || '推荐文章',
                href: a.getAttribute('href') || '#',
              };
            });
          }
        }

        if (!items || !items.length) {
          startTypewriter('暂未找到更多同分类文章，建议前往主页或归档目录发现更多精彩内容~');
          return;
        }

        const listHtml = items.slice(0, 4).map((it, idx) => `
          <div class="ai-recommend-item">
            <span class="ai-recommend-idx">推荐 ${idx + 1}：</span>
            <a href="${it.href}" title="${it.title}">${it.title}</a>
          </div>
        `).join('');

        const containerHtml = `为你精心挑选了以下相关阅读：<br /><div class="ai-recommend">${listHtml}</div>`;
        startTypewriter(containerHtml, true);
      };

      const handleHome = () => {
        startTypewriter('正在前往博客主页，请稍候...', false, () => {
          setTimeout(() => {
            window.location.href = '/';
          }, 800);
        });
      };

      // Button binding
      actionBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.dataset.action;
          if (action === 'intro') handleIntro();
          else if (action === 'summary') fetchLiveSummary();
          else if (action === 'recommend') handleRecommend();
          else if (action === 'home') handleHome();
        });
      });

      if (refreshBtn) {
        refreshBtn.addEventListener('click', () => fetchLiveSummary());
      }

      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          if (mode === 'summary') {
            mode = 'intro';
            handleIntro();
          } else {
            mode = 'summary';
            fetchLiveSummary();
          }
        });
      }

      if (aiTag) {
        aiTag.addEventListener('click', () => handleIntro());
      }

      // Intersection observer to auto-start when visible
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          fetchLiveSummary();
        }
      }, { threshold: 0.1 });

      observer.observe(panel);
    });
  })();
</script>
