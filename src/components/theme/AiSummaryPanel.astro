---
import { siteConfig } from '../../config/site';
import { Bot, RefreshCw, SlidersHorizontal, Sparkles } from 'lucide-react';

interface RelatedItem {
  title: string;
  href: string;
}

interface Props {
  slug: string;
  title: string;
  summary?: string; // PrimerAI (author-written in markdown)
  staticSummary?: string; // LLMGPT (pre-baked Groq summary)
  staticSummariesByLang?: Record<string, string>; // Multi-lingual static summaries
  articleLang?: string; // Current article's native language
  url: string;
  related?: RelatedItem[];
}

const rawRuntimeApiBase = process.env.PUBLIC_RUNTIME_API_BASE?.trim() || '';
const runtimeApiBase = rawRuntimeApiBase.replace(/\/api\/?$/, '');
const apiBase = runtimeApiBase ? `${runtimeApiBase}/api` : '/api';
const {
  slug,
  title,
  summary = '',
  staticSummary = '',
  staticSummariesByLang = {},
  articleLang = 'zh-CN',
  url,
  related = []
} = Astro.props;

// Rich, detailed author introduction templates (Chinese)
const detailedAuthorIntros = [
  `${siteConfig.site.author.name}（时鉴）是一名通才型软件构建者、学生与长期内容写作者。专注于把博客当成可长期演进的软件系统来打造，技术栈涵盖 Astro、React、TypeScript、Tailwind、Cloudflare 与系统级工程设计。他崇尚“内容优先、结构优先、体验洁癖”，致力于在高信息密度中建立清晰秩序，把每一次技术重构与日常思考凝练为真实可读的实践档案。`,
  `这里是 ${siteConfig.site.author.name} 的个人数字工坊与研究日志。作者坚持独立开发与深度记录，拒绝浮躁的形式堆砌，主张以工程化视角打磨每一个阅读细节、交互手感与数据契约。无论是在前端工程、系统设计还是产品观察领域，都保持着敬畏秩序与持续构建的初心，希望每一篇记录都能穿越时间，为读者提供扎实的参考价值。`,
  `${siteConfig.site.author.name} 是一名偏好深度思考与动手实践的 INFJ / Builder。他将博客视为个人外脑与长期产品，持续打磨基于 SSR + Islands 架构的高性能个人站点。作者坚信“意图明确的构建远比一次性的热闹更重要”，在这里记录研究实验、技术架构判断与真实生活取舍，探索极客美学与极致可读性之间的完美平衡。`,
];

// Rich, detailed author introduction templates (English)
const detailedAuthorIntrosEn = [
  `${siteConfig.site.author.name} (Shijianus) is a generalist software builder, student, and long-term writer. Dedicated to treating the blog as a continuously evolving software system, his tech stack spans Astro, React, TypeScript, Tailwind, Cloudflare, and systems engineering. He advocates for "content-first, structure-first, and craft-driven ergonomics," striving to bring order to high-density knowledge and distilling every technical rebuild into readable, enduring artifacts.`,
  `This is the personal digital workshop and research log of ${siteConfig.site.author.name}. Resisting superficial ornamentation, the author focuses on refined reading ergonomics, tactile interactions, and data contracts from an engineering perspective. Whether in frontend architecture, systems design, or product analysis, each record is crafted to withstand time and provide solid reference value.`,
  `${siteConfig.site.author.name} is an INFJ / Builder driven by deep thinking and hands-on craftsmanship. Viewing the blog as an external brain and long-term product, he continuously polishes this SSR + Islands architecture. Believing that "purposeful construction matters far more than fleeting spectacle," he documents research experiments, architectural decisions, and the balance between geek aesthetics and ultimate readability.`,
];

