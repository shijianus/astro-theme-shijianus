const normalizedArticleLang = articleLang?.toLowerCase().startsWith('zh-hant')
  ? 'zh-Hant'
  : articleLang?.toLowerCase().startsWith('zh')
  ? 'zh-CN'
  : ['en', 'de', 'es', 'fr'].includes((articleLang || '').split('-')[0].toLowerCase())
  ? (articleLang || '').split('-')[0].toLowerCase()
  : 'zh-CN';

const ssrConfig = SSR_I18N[normalizedArticleLang] || SSR_I18N['zh-CN'];
const initialBrandTitle = ssrConfig.brandTitle;
const initialLoadingText = ssrConfig.loadingText;
const initialActions = ssrConfig.actions;
---

<section
  class="shijianus-ai-summary"
  data-ai-summary
  data-api-base={apiBase}
  data-slug={slug}
  data-title={title}
  data-primer-summary={summary}
  data-static-summary={staticSummary}
  data-static-summaries={JSON.stringify(staticSummariesByLang)}
  data-article-lang={articleLang}
  data-url={url}
  data-intro-templates={JSON.stringify(detailedAuthorIntros)}
  data-intro-templates-en={JSON.stringify(detailedAuthorIntrosEn)}
  data-ai-unavailable={siteConfig.post.ai.unavailableMessage}
  data-related-empty={siteConfig.post.ai.relatedEmptyMessage}
  data-related={JSON.stringify(related)}
>
  <div class="shijianus-ai-summary__head">
    <div class="shijianus-ai-summary__brand">
      <span class="shijianus-ai-summary__icon" aria-hidden="true">
        <Sparkles size={16} strokeWidth={2.2} />
      </span>
      <span class="shijianus-ai-summary__brand-title" data-ai-brand-title>{initialBrandTitle}</span>
      <button
        type="button"
        class="shijianus-ai-summary__btn-icon"
        data-ai-refresh
        aria-label="重新生成 / 刷新摘要"
        title="重新生成 / 刷新摘要 (Refresh Summary)"
      >
        <RefreshCw size={13} strokeWidth={2} />
      </button>
    </div>

    <div class="shijianus-ai-summary__controls">
      <div class="shijianus-ai-summary__mode-pill" title="当前摘要模式 (Current AI Mode)">
        <span class="shijianus-ai-summary__mode-dot"></span>
        <span data-ai-mode-label>LLMGPT</span>
      </div>
      <button
        type="button"
        class="shijianus-ai-summary__btn-icon shijianus-ai-summary__btn-switch"
        data-ai-switch-mode
        aria-label="切换摘要引擎 (LLMGPT / InstanceAI / PrimerAI)"
        title="切换摘要引擎 (LLMGPT / InstanceAI / PrimerAI)"
      >
        <SlidersHorizontal size={13} strokeWidth={2} />
      </button>
    </div>
  </div>

  <div class="shijianus-ai-summary__screen">
    <p class="shijianus-ai-summary__output" data-ai-output>{initialLoadingText}</p>
  </div>

  <div class="shijianus-ai-summary__actions">
    <button type="button" class="shijianus-ai-summary__action" data-ai-action="point" title={initialActions.point.title}>
      {initialActions.point.label}
    </button>
    <button type="button" class="shijianus-ai-summary__action" data-ai-action="audience" title={initialActions.audience.title}>
      {initialActions.audience.label}
    </button>
    <button type="button" class="shijianus-ai-summary__action" data-ai-action="quick" title={initialActions.quick.title}>
      {initialActions.quick.label}
    </button>
    <button type="button" class="shijianus-ai-summary__action" data-ai-action="insight" title={initialActions.insight.title}>
      {initialActions.insight.label}
    </button>
    <button type="button" class="shijianus-ai-summary__action" data-ai-action="intro" title={initialActions.intro.title}>
      {initialActions.intro.label}
    </button>
    <button type="button" class="shijianus-ai-summary__action" data-ai-action="related" title={initialActions.related.title}>
      {initialActions.related.label}
    </button>
    <button type="button" class="shijianus-ai-summary__action" data-ai-action="top" title={initialActions.top.title}>
      {initialActions.top.label}
    </button>
  </div>

  <div class="shijianus-ai-summary__related" data-ai-related hidden></div>
</section>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-ai-summary]');
    if (!roots.length) return;

    const normalizeLocale = (val) => {
      if (!val) return 'zh-CN';
      const clean = String(val).toLowerCase().trim();
      if (clean.startsWith('zh-hant') || clean.startsWith('zh-tw') || clean.startsWith('zh-hk')) return 'zh-Hant';
      if (clean.startsWith('zh')) return 'zh-CN';
      if (clean.startsWith('en')) return 'en';
      if (clean.startsWith('fr')) return 'fr';
      if (clean.startsWith('es')) return 'es';
      if (clean.startsWith('de')) return 'de';
      if (clean.startsWith('ja')) return 'ja';
      return 'zh-CN';
    };

