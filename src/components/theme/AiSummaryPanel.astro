---
import { siteConfig } from '../../config/site';

interface RelatedItem {
  title: string;
  href: string;
}

interface Props {
  slug: string;
  title: string;
  summary?: string;
  url: string;
  related?: RelatedItem[];
}

const rawRuntimeApiBase = process.env.PUBLIC_RUNTIME_API_BASE?.trim() || '';
const runtimeApiBase = rawRuntimeApiBase.replace(/\/api\/?$/, '');
const apiBase = runtimeApiBase ? `${runtimeApiBase}/api` : '/api';
const { slug, title, summary = '', url, related = [] } = Astro.props;

const introTemplates = [
  `我是 ${siteConfig.site.author.name}，一名热衷于系统重构、前端架构与硬核折腾的开发者。在这里分享真实实战与避坑指南。`,
  `你好！欢迎来到我的数字花园。我关注高可维护性架构、现代 Web 体验与底层系统设计。`,
  `这里记录了从 0 到 1 的技术探索。拒绝宏大叙事，只保留经过实践检验的技术总结与极客灵感。`,
  `我是本站作者，喜欢用代码构建清晰、优雅且具长生命周期的数字作品。感谢你的阅读与驻足。`,
  `探索数字边境，构筑外脑知识库。希望这里的每一篇文字与源码，都能为你带来启发与实效。`
];
---

<div
  class="post-ai-description"
  data-ai-summary
  data-api-base={apiBase}
  data-slug={slug}
  data-title={title}
  data-summary={summary}
  data-url={url}
  data-intros={JSON.stringify(introTemplates)}
  data-related={JSON.stringify(related)}
>
  <div class="ai-title">
    <div class="ai-title-left">
      <svg class="ai-gpt-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
      </svg>
      <span class="ai-title-text">AI-摘要</span>
      <button type="button" class="ai-toggle-btn" id="ai-Toggle" title="切换模式">切换</button>
    </div>
    <div class="ai-title-right">
      <button type="button" class="ai-refresh-btn" data-ai-refresh title="刷新摘要">
        <i class="anzhiyufont anzhiyu-icon-arrow-rotate-right"></i>
      </button>
      <div id="ai-tag">Shijianus GPT</div>
    </div>
  </div>

  <div class="ai-explanation" data-ai-output>
    {summary || '正在准备 AI 摘要，可点击下方按钮体验快速导读或相关推荐～'}
  </div>

  <div class="ai-btn-box">
    <div class="ai-btn-item" data-ai-action="intro">介绍自己 🙈</div>
    <div class="ai-btn-item" data-ai-action="summary">生成本文简介 👋</div>
    <div class="ai-btn-item" data-ai-action="related">推荐相关文章 📖</div>
    <a class="ai-btn-item" href="/">前往主页 🏠</a>
  </div>

  <div class="ai-related-box" data-ai-related hidden></div>
</div>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-ai-summary]');
    if (!roots.length) return;

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      if (root.dataset.aiBound === 'true') return;
      root.dataset.aiBound = 'true';

      const outputEl = root.querySelector('[data-ai-output]');
      const refreshBtn = root.querySelector('[data-ai-refresh]');
      const toggleBtn = root.querySelector('#ai-Toggle');
      const relatedBox = root.querySelector('[data-ai-related]');
      const actionBtns = root.querySelectorAll('[data-ai-action]');

      const defaultSummary = root.dataset.summary || '这篇文章介绍了系统架构设计与实现技巧，旨在帮助读者更好地理解与实践。';
      let intros = [];
      let related = [];
      try {
        intros = JSON.parse(root.dataset.intros || '[]');
      } catch {}
      try {
        related = JSON.parse(root.dataset.related || '[]');
      } catch {}

      let currentIntroIndex = 0;
      let isTyping = false;
      let typingTimer = null;

      const typeText = (text) => {
        if (!outputEl) return;
        if (typingTimer) clearInterval(typingTimer);
        outputEl.textContent = '';
        let i = 0;
        isTyping = true;
        typingTimer = setInterval(() => {
          if (i < text.length) {
            outputEl.textContent += text.charAt(i);
            i++;
          } else {
            clearInterval(typingTimer);
            isTyping = false;
          }
        }, 18);
      };

      actionBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-ai-action');
          if (relatedBox) relatedBox.hidden = true;

          if (action === 'intro') {
            if (intros.length > 0) {
              const text = intros[currentIntroIndex % intros.length];
              currentIntroIndex++;
              typeText(text);
            }
          } else if (action === 'summary') {
            typeText(defaultSummary);
          } else if (action === 'related') {
            if (related.length > 0) {
              typeText(`为你推荐以下 ${related.length} 篇相关文章：`);
              if (relatedBox) {
                relatedBox.hidden = false;
                relatedBox.innerHTML = related.map((r, idx) => `
                  <a href="${r.href}" class="ai-related-item">
                    <span class="ai-related-index">${idx + 1}.</span>
                    <span class="ai-related-title">${r.title}</span>
                  </a>
                `).join('');
              }
            } else {
              typeText('暂无更多关联文章，欢迎前往主页或标签页探索更多内容～');
            }
          }
        });
      });

      if (refreshBtn) {
        refreshBtn.addEventListener('click', () => {
          typeText(defaultSummary);
        });
      }

      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          if (intros.length > 0) {
            const text = intros[currentIntroIndex % intros.length];
            currentIntroIndex++;
            typeText(text);
          }
        });
      }
    });
  })();
</script>
