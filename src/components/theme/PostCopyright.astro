            data-share-platform="email"
            title="通过邮件分享"
            style="--platform-accent:#7c3aed; --platform-bg:rgba(124, 58, 237, 0.09);"
          >
            <Mail className="post-share-icon" aria-hidden="true" size={17} />
          </button>
        </div>
      </div>
    </div>

    {/* 5. 卡片最底部：版权声明（完全对齐安知鱼，无下划线，悬停变色） */}
    <div class="post-copyright__notice">
      <span class="post-copyright-info">
        除特别声明外，本博客所有文章均采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noopener external nofollow noreferrer" class="post-copyright-license-link" title="Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International">CC BY-NC-SA 4.0</a> 许可协议。转载请注明来自 <a href={siteConfig.site.url} class="post-copyright-site-link" title={authorName}>{authorName}</a> ！
      </span>
    </div>
  </div>

  {/* 全局透明遮罩（点击外部收起 Pinned 固定卡片） */}
  <div class="post-tools-mask" data-post-tools-mask style="display: none;"></div>
  <div class="post-tools__status" role="status" aria-live="polite"></div>
</section>

<script>
  (() => {
    const blocks = document.querySelectorAll('[data-post-tools]');
    if (!blocks.length) return;

    blocks.forEach((block) => {
      if (!(block instanceof HTMLElement)) return;

      const status = block.querySelector('.post-tools__status');
      const mask = block.querySelector('[data-post-tools-mask]');
      const rewardWrapper = block.querySelector('[data-reward-wrapper]');
      const qrWrapper = block.querySelector('[data-qr-wrapper]');
      const rewardMain = block.querySelector('#reward-main-popover');
      const qrMain = block.querySelector('#share-qrcode-popover');

      let statusTimer = 0;
      let activePinned: 'reward' | 'wechat' | '' = '';

      // 智能地区画像识别
      const detectRegion = (): 'cn' | 'hk' | 'tw' | 'jp' | 'intl' => {
        try {
          const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          const lang = (navigator.language || '').toLowerCase();

          if (tz.includes('Taipei') || lang === 'zh-tw') return 'tw';
          if (tz.includes('Hong_Kong') || lang === 'zh-hk') return 'hk';
          if (tz.includes('Tokyo') || lang.startsWith('ja')) return 'jp';
          if (
            tz.includes('Shanghai') ||
            tz.includes('Chongqing') ||
            tz.includes('Harbin') ||
            tz.includes('Urumqi') ||
            tz === 'PRC' ||
            lang === 'zh-cn'
          ) {
            return 'cn';
          }
        } catch {
          // fallback
        }
        return 'cn';
      };

      const userRegion = detectRegion();
      block.setAttribute('data-detected-region', userRegion);

      // 微信文案香港化
      if (userRegion === 'hk') {
        const qrBtn = block.querySelector('[data-share-platform="wechat"]');
        if (qrBtn) qrBtn.setAttribute('title', 'WeChat 扫码阅读');
        const rednoteBtn = block.querySelector('.share-link.rednote button');
        if (rednoteBtn) rednoteBtn.setAttribute('title', '分享到 Rednote');
      } else if (userRegion === 'cn') {
        const tiktokBtn = block.querySelector('.share-link.tiktok button');
        if (tiktokBtn) tiktokBtn.setAttribute('title', '分享到抖音');
      }

      // 双向智能定位：测量空间，向上即将触顶或空间不足时自动向下展示
      const computePopoverPosition = (wrapper: HTMLElement | null, popover: HTMLElement | null) => {
        if (!wrapper || !popover) return;
        const rect = wrapper.getBoundingClientRect();
        const popoverHeight = popover.offsetHeight || 280;
        const spaceAbove = rect.top;
        const spaceBelow = window.innerHeight - rect.bottom;

        // 如果向上小于面板高度+25px，或者向上不足240px且向下空间更宽阔，自动向下展示
        if (spaceAbove < popoverHeight + 25 || (spaceAbove < 240 && spaceBelow > spaceAbove)) {
          popover.classList.remove('popover-up');
          popover.classList.add('popover-down');
        } else {
          popover.classList.remove('popover-down');
          popover.classList.add('popover-up');
        }
      };

      const emitActivity = (message: string) => {
        window.dispatchEvent(new CustomEvent('shijianus:activity', { detail: { message } }));
      };

      const setStatus = (message: string) => {
        if (!(status instanceof HTMLElement)) return;
        window.clearTimeout(statusTimer);
        status.textContent = message;
        status.classList.add('is-visible');
        emitActivity(message);
        statusTimer = window.setTimeout(() => {
          status.classList.remove('is-visible');
        }, 2200);
      };

      const closeAllPinned = () => {
        activePinned = '';
        rewardMain?.classList.remove('is-pinned');
        qrMain?.classList.remove('is-pinned');
        if (mask instanceof HTMLElement) {
          mask.style.display = 'none';
        }
      };

      if (mask instanceof HTMLElement) {
        mask.addEventListener('click', () => {
          closeAllPinned();
        });
      }

      // 复制文本到剪贴板
      const copyText = async (text: string, successMessage: string) => {
        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(text);
          } else {
            const input = document.createElement('textarea');
            input.value = text;
            input.style.position = 'fixed';
            input.style.opacity = '0';
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
          }
          setStatus(successMessage);
        } catch (err) {
          console.warn('Copy failed:', err);
          setStatus('复制失败，请手动复制');
        }
      };

      // 复制二维码图片到剪贴板
      const copyQrImage = async (imgContainer: HTMLElement | null, fallbackUrl: string, name = '二维码') => {
        try {
          const img = imgContainer?.querySelector('img') || (imgContainer instanceof HTMLImageElement ? imgContainer : null);
          if (img instanceof HTMLImageElement && navigator.clipboard && window.ClipboardItem) {
            const canvas = document.createElement('canvas');
            canvas.width = img.naturalWidth || 200;
            canvas.height = img.naturalHeight || 200;
            const ctx = canvas.getContext('2d');
            if (ctx) {
              ctx.fillStyle = '#ffffff';
              ctx.fillRect(0, 0, canvas.width, canvas.height);
              ctx.drawImage(img, 0, 0);
              const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/png'));
              if (blob) {
                await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
                setStatus(`${name}已复制到剪贴板！`);
                return;
              }
            }
          }
        } catch (e) {
          console.warn('Copy image to clipboard failed:', e);
        }
        await copyText(fallbackUrl, `${name}对应链接已复制！`);
      };

      // 悬停动态计算方向
      qrWrapper?.addEventListener('mouseenter', () => {
        computePopoverPosition(qrWrapper as HTMLElement, qrMain as HTMLElement);
      });

      // 赞赏按钮点击唤起现代化地区路由打赏弹窗
      const rewardBtn = rewardWrapper?.querySelector('button');
      if (rewardBtn) {
        rewardBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          window.dispatchEvent(new CustomEvent('open-reward-modal'));
        });
      }

      // 手机二维码按钮点击切换固定
      const qrBtn = qrWrapper?.querySelector('button');
      if (qrBtn) {
        qrBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          computePopoverPosition(qrWrapper as HTMLElement, qrMain as HTMLElement);
          if (activePinned === 'wechat') {
            closeAllPinned();
          } else {
            closeAllPinned();
            activePinned = 'wechat';
            qrMain?.classList.add('is-pinned');
            if (mask instanceof HTMLElement) mask.style.display = 'block';
            const permalink = block.dataset.permalink || window.location.href;
            copyQrImage(qrMain instanceof HTMLElement ? qrMain : null, permalink, '文章二维码');
          }
        });
      }

      // 点击二维码图片直接复制
      block.querySelectorAll('[data-copy-qr-target]').forEach((target) => {
        target.addEventListener('click', (e) => {
          e.stopPropagation();
          const name = target.getAttribute('data-qr-name') || '收款码';
          const permalink = block.dataset.permalink || window.location.href;
          copyQrImage(target instanceof HTMLElement ? target : null, permalink, name);
        });
      });

      // 标题点击复制完整标题与文章链接
      const titleBtn = block.querySelector('.post-copyright-title');
      if (titleBtn) {
        titleBtn.addEventListener('click', () => {
          const permalink = block.dataset.permalink || window.location.href;
          const fullTitle = block.dataset.title || document.title;
          copyText(`${fullTitle} - ${permalink}`, '文章标题与链接已复制到剪贴板！');
        });
      }

      // 各平台真实分享跳转与互动
      const permalink = block.dataset.permalink || window.location.href;
      const docTitle = block.dataset.title || document.title;
      const shareUrl = encodeURIComponent(permalink);
      const shareTitle = encodeURIComponent(docTitle);
      const shareSummary = encodeURIComponent(block.dataset.summary || '');
      const shareCover = encodeURIComponent(block.dataset.cover || '');

      block.querySelectorAll('[data-share-platform]').forEach((button) => {
        const platform = button.getAttribute('data-share-platform');
        if (platform === 'wechat') return; // 二维码已单独处理

        button.addEventListener('click', async (e) => {
          e.preventDefault();

          switch (platform) {
            case 'copy':
              await copyText(permalink, '文章链接已复制到剪贴板！');
              break;
            case 'qq':
              window.open(`https://connect.qq.com/widget/shareqq/index.html?url=${shareUrl}&title=${shareTitle}&summary=${shareSummary}&pics=${shareCover}`, '_blank', 'noopener,noreferrer');
              break;
            case 'qzone':
              window.open(`https://sns.qzone.qq.com/cgi-bin/qzshare/cgi_qzshare_onekey?url=${shareUrl}&title=${shareTitle}&summary=${shareSummary}&pics=${shareCover}`, '_blank', 'noopener,noreferrer');
              break;
            case 'weibo':
              window.open(`https://service.weibo.com/share/share.php?title=${shareTitle}&url=${shareUrl}&pic=${shareCover}`, '_blank', 'noopener,noreferrer');
              break;
            case 'bilibili':
              window.open(`https://t.bilibili.com/?spm_id_from=333.999.0.0`, '_blank', 'noopener,noreferrer');
              await copyText(`${docTitle} ${permalink}`, '标题与链接已复制，正在前往 B站动态分享！');
              break;
            case 'rednote':
              await copyText(`${docTitle}\n${permalink}`, '图文标题与链接已复制，可直接粘贴到小红书 (Rednote)！');
              break;
            case 'tiktok':
              await copyText(`${docTitle}\n${permalink}`, '标题与链接已复制，可前往发布分享！');
              break;
            case 'whatsapp':
              window.open(`https://api.whatsapp.com/send?text=${shareTitle}%20${shareUrl}`, '_blank', 'noopener,noreferrer');
              break;
            case 'line':
              window.open(`https://social-plugins.line.me/lineit/share?url=${shareUrl}&text=${shareTitle}`, '_blank', 'noopener,noreferrer');
              break;
            case 'x':
              window.open(`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`, '_blank', 'noopener,noreferrer');
              break;
            case 'telegram':
              window.open(`https://t.me/share/url?url=${shareUrl}&text=${shareTitle}`, '_blank', 'noopener,noreferrer');
              break;
            case 'facebook':
              window.open(`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`, '_blank', 'noopener,noreferrer');
              break;
            case 'threads':
              window.open(`https://www.threads.net/intent/post?text=${shareTitle}%20${shareUrl}`, '_blank', 'noopener,noreferrer');
              break;
            case 'linkedin':
              window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`, '_blank', 'noopener,noreferrer');
              break;
            case 'reddit':
              window.open(`https://www.reddit.com/submit?url=${shareUrl}&title=${shareTitle}`, '_blank', 'noopener,noreferrer');
              break;
            case 'snapchat':
              await copyText(permalink, '文章链接已复制，可在 Snapchat 中发送给好友！');
              break;
            case 'email':
              window.location.href = `mailto:?subject=${shareTitle}&body=${shareUrl}`;
              break;
            default:
              await copyText(permalink, '链接已复制');
          }
        });
      });

      // 全局 Esc 键
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeAllPinned();
      });
    });
  })();
</script>
