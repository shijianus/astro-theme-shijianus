---
import { siteConfig } from '../../config/site';
import QrCodeImage from './QrCodeImage.astro';
import RewardRegionPanel from './RewardRegionPanel.astro';

interface Props {
  permalink: string;
  title: string;
  summary?: string;
  authorName: string;
  authorRole: string;
  authorAvatar: string;
  badge: string;
  copyrightTitle: string;
  notice: string;
  copyLabel: string;
  rewardLabel: string;
  rewardNote: string;
  aboutTitle: string;
  modeHref: string;
  modeLabel: string;
  modeDescription: string;
  shareLabel: string;
  rewardHref: string;
  rewardDescription: string;
  copyDoneLabel: string;
  shareDoneLabel: string;
  shareFallbackLabel: string;
}

const {
  permalink,
  title,
  summary = '',
  authorName,
  authorRole,
  authorAvatar,
  badge,
  copyrightTitle,
  notice,
  copyLabel,
  rewardLabel,
  rewardNote,
  aboutTitle,
  modeHref,
  modeLabel,
  modeDescription,
  shareLabel,
  rewardHref,
  rewardDescription,
  copyDoneLabel,
  shareDoneLabel,
  shareFallbackLabel,
} = Astro.props;

const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(permalink);
const weiboShareUrl = `https://service.weibo.com/share/share.php?title=${encodedTitle}&url=${encodedUrl}`;
const qqShareUrl = `https://connect.qq.com/widget/shareqq/index.html?url=${encodedUrl}&title=${encodedTitle}&summary=${encodeURIComponent(summary)}`;
const xShareUrl = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const telegramShareUrl = `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`;
---

<div
  class="post-copyright"
  data-post-copyright
  data-permalink={permalink}
  data-title={title}
  data-copy-done={copyDoneLabel}
>
  <div class="copyright-cc-box">
    <i class="anzhiyufont anzhiyu-icon-copyright"></i>
  </div>

  <div class="post-copyright__author_box">
    <a class="post-copyright__author_img" href="/about/" title={authorName}>
      <img class="post-copyright__author_img_back" src={authorAvatar} alt={authorName} loading="lazy" />
      <img class="post-copyright__author_img_front" src={authorAvatar} alt={authorName} loading="lazy" />
    </a>
    <div class="post-copyright__author_name">{authorName}</div>
    <div class="post-copyright__author_desc">{authorRole}</div>
  </div>

  <div class="post-copyright__post__info">
    <a class="post-copyright__original" href={permalink}>{badge}</a>
    <a class="post-copyright__title" href={permalink} title={title}>{title}</a>
    <div class="post-copyright__link">
      <a href={permalink} title={title}>{permalink}</a>
    </div>
  </div>

  <div class="post-copyright__notice">
    <span class="post-copyright-info">
      本博客所有文章除特别声明外，均采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a> 许可协议。转载请注明来自 <a href="/">{authorName}</a>！
    </span>
  </div>

  <div class="post-tools" id="post-tools">
    <div class="post-tools-left">
      <div class="reward-link mode">
        <button
          type="button"
          class="reward-link-button reward-button-square"
          data-reward-trigger
          title={rewardLabel}
          aria-expanded="false"
        >
          <svg class="reward-btn-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
          </svg>
          <span>{rewardLabel}</span>
        </button>
      </div>
    </div>

    <div class="shareRight">
      <div class="share-link mobile">
        <button type="button" class="share-button" data-share-wechat title="手机扫码阅读" aria-label="手机扫码阅读">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </button>
      </div>
      <div class="share-link weibo">
        <a class="share-button" target="_blank" rel="noopener noreferrer" href={weiboShareUrl} title="分享到微博" aria-label="分享到微博">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M10.07 19.86c-4.45 0-8.07-2.61-8.07-5.83 0-1.68 1.01-3.21 2.68-4.32 2.21-1.46 5.16-1.57 7.23-.26.65.41 1.15.93 1.5 1.51 1.77-.33 3.32.22 3.97 1.4.78 1.42-.08 3.19-2.02 4.41-1.48.94-3.32 1.49-5.29 1.49zm-.06-1.6c3.08 0 5.48-1.58 5.48-3.6 0-1.89-2.14-3.08-4.99-3.08-3.02 0-5.41 1.63-5.41 3.59 0 1.94 2.33 3.09 4.92 3.09zm8.56-8.24c-.45-.14-.7-.63-.56-1.08.43-1.37-.15-2.85-1.45-3.69-.4-.26-.51-.8-.25-1.2.26-.4.8-.51 1.2-.25 1.83 1.19 2.64 3.27 2.04 5.2-.14.45-.63.7-1.08.56z"></path>
          </svg>
        </a>
      </div>
      <div class="share-link qq">
        <a class="share-button" target="_blank" rel="noopener noreferrer" href={qqShareUrl} title="分享到QQ" aria-label="分享到QQ">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12c0 2.17.7 4.18 1.89 5.82L3 22l4.35-.87C8.89 21.68 10.39 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"></path>
          </svg>
        </a>
      </div>
      <div class="share-link telegram">
        <a class="share-button" target="_blank" rel="noopener noreferrer" href={telegramShareUrl} title="分享到Telegram" aria-label="分享到Telegram">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </a>
      </div>
      <div class="share-link twitter">
        <a class="share-button" target="_blank" rel="noopener noreferrer" href={xShareUrl} title="分享到X" aria-label="分享到X">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
        </a>
      </div>
      <div class="share-link copyurl">
        <button type="button" class="share-button" id="post-share-url" data-share-copy title={copyLabel} aria-label={copyLabel}>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Popover panels -->
  <div class="post-copyright-popover post-copyright-popover--reward" data-reward-popover hidden>
    <div class="post-copyright-popover__head">
      <span class="post-copyright-popover__title">打赏作者</span>
      <button type="button" class="post-copyright-popover__close" data-reward-close aria-label="关闭打赏面板">×</button>
    </div>
    <RewardRegionPanel variant="panel" />
  </div>

  <div class="post-copyright-popover post-copyright-popover--wechat" data-wechat-popover hidden>
    <div class="post-copyright-popover__head">
      <span class="post-copyright-popover__title">使用手机访问</span>
      <button type="button" class="post-copyright-popover__close" data-wechat-close aria-label="关闭二维码面板">×</button>
    </div>
    <div class="post-share-qrcode-body">
      <QrCodeImage value={permalink} alt={`${title} 分享二维码`} size={180} fgColor="#111827" />
      <p class="post-share-qrcode-tip">手机扫一扫在移动端继续阅读</p>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const copyrightBlocks = document.querySelectorAll('[data-post-copyright]');
    if (!copyrightBlocks.length) return;

    const copyText = async (text) => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch {}
      try {
        const input = document.createElement('textarea');
        input.value = text;
        input.setAttribute('readonly', '');
        input.style.position = 'fixed';
        input.style.left = '-9999px';
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
        return true;
      } catch {
        return false;
      }
    };

    copyrightBlocks.forEach((block) => {
      if (!(block instanceof HTMLElement)) return;

      const permalink = block.dataset.permalink || window.location.href;
      const copyDone = block.dataset.copyDone || '已复制当前页面链接';
      const rewardTrigger = block.querySelector('[data-reward-trigger]');
      const rewardPopover = block.querySelector('[data-reward-popover]');
      const rewardClose = block.querySelector('[data-reward-close]');
      const wechatTrigger = block.querySelector('[data-share-wechat]');
      const wechatPopover = block.querySelector('[data-wechat-popover]');
      const wechatClose = block.querySelector('[data-wechat-close]');
      const copyBtn = block.querySelector('[data-share-copy]');

      const showToast = (msg) => {
        window.dispatchEvent(new CustomEvent('shijianus:activity', { detail: { message: msg } }));
      };

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          await copyText(permalink);
          showToast(copyDone);
        });
      }

      if (rewardTrigger && rewardPopover) {
        rewardTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const isHidden = rewardPopover.hidden;
          rewardPopover.hidden = !isHidden;
          if (wechatPopover) wechatPopover.hidden = true;
          rewardTrigger.setAttribute('aria-expanded', String(!isHidden));
        });
      }

      if (rewardClose && rewardPopover) {
        rewardClose.addEventListener('click', () => {
          rewardPopover.hidden = true;
          if (rewardTrigger) rewardTrigger.setAttribute('aria-expanded', 'false');
        });
      }

      if (wechatTrigger && wechatPopover) {
        wechatTrigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const isHidden = wechatPopover.hidden;
          wechatPopover.hidden = !isHidden;
          if (rewardPopover) rewardPopover.hidden = true;
        });
      }

      if (wechatClose && wechatPopover) {
        wechatClose.addEventListener('click', () => {
          wechatPopover.hidden = true;
        });
      }

      document.addEventListener('click', (e) => {
        if (rewardPopover && !rewardPopover.hidden && !rewardPopover.contains(e.target) && e.target !== rewardTrigger) {
          rewardPopover.hidden = true;
          if (rewardTrigger) rewardTrigger.setAttribute('aria-expanded', 'false');
        }
        if (wechatPopover && !wechatPopover.hidden && !wechatPopover.contains(e.target) && e.target !== wechatTrigger) {
          wechatPopover.hidden = true;
        }
      });
    });
  })();
</script>
