---
import {
  Copy,
  Facebook,
  HeartHandshake,
  History,
  Linkedin,
  Mail,
  MessageCircle,
  QrCode,
  Radio,
  Send,
  Share2,
  Sparkles,
  Twitter,
  type LucideIcon,
} from 'lucide-react';
import { siteConfig } from '../../config/site';
import { getCategoryPath, getTagPath } from '../../lib/content';
import QrCodeImage from './QrCodeImage.astro';
import RewardRegionPanel from './RewardRegionPanel.astro';

interface Props {
  permalink: string;
  title: string;
  summary?: string;
  authorName: string;
  authorRole: string;
  authorAvatar: string;
  badge: string;
  copyrightTitle: string;
  notice: string;
  copyLabel: string;
  rewardLabel: string;
  rewardNote: string;
  category: string;
  tags: string[];
  aboutTitle: string;
  modeHref: string;
  modeLabel: string;
  modeDescription: string;
  shareLabel: string;
  rewardHref: string;
  rewardDescription: string;
  copyDoneLabel: string;
  shareDoneLabel: string;
  shareFallbackLabel: string;
}

const {
  permalink,
  title,
  summary = '',
  authorName,
  authorRole,
  authorAvatar,
  badge,
  copyrightTitle,
  notice,
  copyLabel,
  rewardLabel,
  rewardNote,
  category,
  tags,
  aboutTitle,
  modeHref,
  modeLabel,
  modeDescription,
  shareLabel,
  rewardHref,
  rewardDescription,
  copyDoneLabel,
  shareDoneLabel,
  shareFallbackLabel,
} = Astro.props;

const categoryHref = getCategoryPath(category);
const shareIconMap: Partial<Record<string, LucideIcon>> = {
  native: Share2,
  copy: Copy,
  wechat: QrCode,
  x: Twitter,
  facebook: Facebook,
  threads: MessageCircle,
  linkedin: Linkedin,
  weibo: Radio,
  telegram: Send,
  reddit: MessageCircle,
  qq: MessageCircle,
  email: Mail,
};
const enabledSharePlatforms = siteConfig.support.share.platforms.map((platform) => ({
  ...platform,
  Icon: shareIconMap[platform.id] ?? Share2,
}));
---

<section
  class="post-copyright-block"
  data-post-tools
  data-title={title}
  data-summary={summary}
  data-permalink={permalink}
  data-copy-done={copyDoneLabel}
  data-share-done={shareDoneLabel}
  data-share-fallback={shareFallbackLabel}
>
  <div class="post-copyright">
    <div class="copyright-cc-box">©</div>
    <div class="post-copyright__author_box">
      <a class="post-copyright__author_img" href="/about/" title={authorName}>
        <img class="post-copyright__author_img_back" src={authorAvatar} alt={authorName} loading="lazy" />
        <img class="post-copyright__author_img_front" src={authorAvatar} alt={authorName} loading="lazy" />
      </a>
      <div class="post-copyright__author_name">{authorName}</div>
      <div class="post-copyright__author_desc">{authorRole}</div>
    </div>

    <div class="post-copyright__post__info">
      <a class="post-copyright__original" href={permalink}>{badge}</a>
      <button type="button" class="post-copyright-title" data-tool="copy" title={copyLabel}>
        <span>{title}</span>
      </button>
    </div>

    <div class="post-copyright__notice">
      <span class="post-copyright-info">{notice}</span>
    </div>

    <div class="post-copyright__support">
      <div class="post-copyright__support-copy">
        <span class="post-copyright__support-eyebrow">{siteConfig.support.reward.title}</span>
        <strong>{rewardLabel}</strong>
        <p>{siteConfig.support.reward.summary}</p>
      </div>
      <div class="post-copyright__support-actions support-panel-actions">
        <div class="support-panel-popover" data-support-popover>
          <button
            type="button"
            class="support-panel-link support-panel-link--icon"
            data-panel-trigger="reward"
            aria-expanded="false"
            aria-controls="post-tools-panel-reward"
          >
            <HeartHandshake className="support-panel-link__icon" aria-hidden="true" />
            <span class="support-panel-link__copy">
              <strong>{rewardLabel}</strong>
              <small>请作者喝杯饮料</small>
            </span>
          </button>

          <div
            class="post-floating-panel post-floating-panel--popover"
            id="post-tools-panel-reward"
            data-panel="reward"
            role="region"
            aria-label={rewardLabel}
            hidden
          >
            <div class="post-floating-panel__head">
              <div>
                <span class="post-floating-panel__eyebrow">{siteConfig.support.reward.title}</span>
                <strong>{rewardLabel}</strong>
              </div>
              <button type="button" class="post-floating-panel__close" data-panel-close aria-label="Close">
                ×
              </button>
            </div>
            <RewardRegionPanel variant="panel" />
          </div>
        </div>

        <a class="support-panel-link support-panel-link--icon support-panel-link--secondary" href={rewardHref}>
          <History className="support-panel-link__icon" aria-hidden="true" />
          <span class="support-panel-link__copy">
            <strong>{siteConfig.support.reward.historyLabel}</strong>
            <small>看看已经收到的心意</small>
          </span>
        </a>
        <span class="support-panel-note">
          <Sparkles className="support-panel-note__icon" aria-hidden="true" />
          <span>{rewardNote}</span>
        </span>
      </div>
    </div>
  </div>

  <div class="post-tools-right">
    <div class="tag_share">
      <div class="post-meta__box">
        <div class="post-meta__box__category-list">
          <a href={categoryHref} class="post-meta__box__categoryes">
            <span class="categoryes-punctuation">#</span>
            {category}
          </a>
        </div>

        {tags.length > 0 && (
          <div class="post-meta__box__tag-list">
            {tags.map((tag) => (
              <a href={getTagPath(tag)} class="post-meta__box__tags">
                <span class="tags-punctuation">#</span>
                {tag}
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="post-share-actions" aria-label={siteConfig.support.share.title}>
        <span class="post-share-actions__eyebrow">{siteConfig.support.share.title}</span>
        <div class="post-share-grid">
          {enabledSharePlatforms.map((platform) => {
            const PlatformIcon = platform.Icon;
            const tooltip = `${platform.label} · ${platform.description}`;
            return (
              <button
                type="button"
                class="post-share-grid__item"
                style={`--platform-accent:${platform.accent};`}
                data-share-platform={platform.id}
                data-tooltip={tooltip}
                aria-label={tooltip}
              >
                <span class="post-share-grid__surface" aria-hidden="true">
                  <PlatformIcon className="post-share-grid__icon" aria-hidden="true" />
                  <span class="post-share-grid__label">{platform.label}</span>
                </span>
              </button>
            );
          })}
        </div>
      </div>
    </div>

    <div class="post-tools__status" aria-live="polite"></div>
    <button type="button" class="post-tools-overlay-backdrop" data-panel-backdrop hidden aria-label="Close panels"></button>
    <div class="post-tools-panels">
      <div
        class="post-floating-panel post-floating-panel--share"
        id="post-tools-panel-wechat"
        data-panel="wechat"
        role="region"
        aria-label={siteConfig.support.share.qrcodeLabel}
        hidden
      >
        <div class="post-floating-panel__head">
          <div>
            <span class="post-floating-panel__eyebrow">{siteConfig.support.share.qrcodeLabel}</span>
            <strong>WeChat / Mobile Share</strong>
          </div>
          <button type="button" class="post-floating-panel__close" data-panel-close aria-label="Close">
            ×
          </button>
        </div>
        <p class="post-floating-panel__summary">扫码后可在手机继续阅读，也可以直接转发给正在使用 WeChat 的朋友。</p>
        <div class="post-share-qrcode">
          <div class="post-share-qrcode__image">
            <QrCodeImage value={permalink} alt={`${title} 分享二维码`} size={198} fgColor="#111827" />
          </div>
          <div class="post-share-qrcode__meta">
            <strong>{title}</strong>
            <p>如果这篇文章帮你省下了时间，扫码后就能在另一台设备上继续阅读，或顺手把它分享给朋友。</p>
            <button type="button" class="post-share-qrcode__action" data-tool="copy">
              {copyLabel}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const sections = document.querySelectorAll('[data-post-tools]');
    if (sections.length === 0) return;

    const copyText = async (value) => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(value);
          return true;
        }
      } catch {}

      try {
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'absolute';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
        return true;
      } catch {
        return false;
      }
    };

    sections.forEach((section) => {
      if (!(section instanceof HTMLElement)) return;

      const permalink = section.dataset.permalink ?? window.location.href;
      const title = section.dataset.title ?? document.title;
      const summary = section.dataset.summary?.trim() ?? '';
      const copyDone = section.dataset.copyDone ?? '链接已复制';
      const shareDone = section.dataset.shareDone ?? '已唤起系统分享';
      const shareFallback = section.dataset.shareFallback ?? '当前环境不支持系统分享，已回退为复制链接';
      const status = section.querySelector('.post-tools__status');
      const backdrop = section.querySelector('[data-panel-backdrop]');
      const panels = Array.from(section.querySelectorAll('[data-panel]')).filter((node) => node instanceof HTMLElement);
      const rewardPopovers = Array.from(section.querySelectorAll('[data-support-popover]')).filter((node) => node instanceof HTMLElement);
      const panelControllers = Array.from(
        section.querySelectorAll('[data-panel-trigger], [data-share-platform="wechat"]'),
      ).filter((node) => node instanceof HTMLElement);
      let statusTimer = 0;

      const setStatus = (message) => {
        if (!(status instanceof HTMLElement)) return;
        window.clearTimeout(statusTimer);
        status.textContent = message;
        status.classList.add('is-visible');
        statusTimer = window.setTimeout(() => {
          status.classList.remove('is-visible');
        }, 2200);
      };

      const syncPanelControllers = (activePanel = '') => {
        panelControllers.forEach((control) => {
          const panelName =
            control.getAttribute('data-panel-trigger') || (control.getAttribute('data-share-platform') === 'wechat' ? 'wechat' : '');
          if (!panelName) return;
          control.setAttribute('aria-expanded', String(activePanel === panelName));
        });
      };

      const isPopoverPanel = (name) => name === 'reward';
      const panelAnchors = new Map();
      let rewardCloseTimer = 0;

      const clearRewardCloseTimer = () => {
        window.clearTimeout(rewardCloseTimer);
        rewardCloseTimer = 0;
      };

      const getActivePanel = () => panels.find((panel) => !panel.hidden)?.dataset.panel ?? '';

      const positionPanel = (panel, anchor) => {
        if (!(panel instanceof HTMLElement) || !(anchor instanceof HTMLElement)) return;

        const viewportWidth = window.innerWidth;
        const viewportHeight = window.innerHeight;
        const margin = 12;
        const preferredWidth = panel.dataset.panel === 'reward'
          ? Math.max(320, Math.min(560, Math.round(viewportWidth * 0.48)))
          : Math.max(320, Math.min(460, Math.round(viewportWidth * 0.44)));
        const previousVisibility = panel.style.visibility;
        const previousPointerEvents = panel.style.pointerEvents;
        const previousOpacity = panel.style.opacity;
        const previousTransform = panel.style.transform;

        panel.style.setProperty('--floating-panel-width', `${preferredWidth}px`);
        panel.style.visibility = 'hidden';
        panel.style.pointerEvents = 'none';
        panel.style.opacity = '0';
        panel.style.transform = 'none';

        const panelRect = panel.getBoundingClientRect();
        const anchorRect = anchor.getBoundingClientRect();
        const panelWidth = Math.min(panelRect.width || panel.offsetWidth || preferredWidth, viewportWidth - margin * 2);
        const panelHeight = Math.min(panelRect.height || panel.offsetHeight || 0, viewportHeight - margin * 2);
        const centerX = anchorRect.left + anchorRect.width / 2;
        const left = Math.max(margin, Math.min(centerX - panelWidth / 2, viewportWidth - panelWidth - margin));
        const spaceAbove = anchorRect.top - margin;
        const spaceBelow = viewportHeight - anchorRect.bottom - margin;
        const placeTop = spaceAbove > spaceBelow && spaceAbove > panelHeight;
        const top = placeTop
          ? Math.max(margin, anchorRect.top - panelHeight - 12)
          : Math.max(margin, Math.min(anchorRect.bottom + 12, viewportHeight - panelHeight - margin));

        panel.style.setProperty('--floating-panel-width', `${panelWidth}px`);
        panel.style.setProperty('--floating-panel-left', `${left}px`);
        panel.style.setProperty('--floating-panel-top', `${top}px`);
        panel.dataset.placement = placeTop ? 'top' : 'bottom';
        panel.style.visibility = previousVisibility;
        panel.style.pointerEvents = previousPointerEvents;
        panel.style.opacity = previousOpacity;
        panel.style.transform = previousTransform;
      };

      const renderPanelState = (activePanel = '') => {
        let showBackdrop = false;

        panels.forEach((panel) => {
          const panelName = panel.dataset.panel ?? '';
          const isActive = panelName === activePanel;
          panel.hidden = !isActive;
          panel.classList.toggle('is-open', isActive);
          if (isActive && !isPopoverPanel(panelName)) {
            showBackdrop = true;
          }
        });

        if (backdrop instanceof HTMLElement) {
          backdrop.hidden = !showBackdrop;
          backdrop.classList.toggle('is-open', showBackdrop);
        }

        syncPanelControllers(activePanel);

        if (activePanel) {
          const activeElement = panels.find((panel) => panel.dataset.panel === activePanel);
          const activeAnchor = panelAnchors.get(activePanel);
          if (activeElement instanceof HTMLElement && activeAnchor instanceof HTMLElement) {
            window.requestAnimationFrame(() => {
              positionPanel(activeElement, activeAnchor);
            });
          }
        }
      };

      const closePanels = () => {
        clearRewardCloseTimer();
        renderPanelState();
      };

      const openPanel = (name, anchor) => {
        clearRewardCloseTimer();
        if (anchor instanceof HTMLElement) panelAnchors.set(name, anchor);
        renderPanelState(name);
      };

      const togglePanel = (name, anchor) => {
        const currentPanel = getActivePanel();
        clearRewardCloseTimer();
        if (anchor instanceof HTMLElement) panelAnchors.set(name, anchor);
        renderPanelState(currentPanel === name ? '' : name);
      };

      const queueRewardClose = (delay = 150) => {
        clearRewardCloseTimer();
        rewardCloseTimer = window.setTimeout(() => {
          if (getActivePanel() === 'reward') {
            renderPanelState();
          }
        }, delay);
      };

      syncPanelControllers();

      rewardPopovers.forEach((popover) => {
        const trigger = popover.querySelector('[data-panel-trigger="reward"]');
        const panel = popover.querySelector('[data-panel="reward"]');
        popover.addEventListener('pointerenter', () => {
          clearRewardCloseTimer();
          openPanel('reward', trigger);
        });

        popover.addEventListener('pointerleave', () => {
          queueRewardClose();
        });

        panel?.addEventListener('pointerenter', () => {
          clearRewardCloseTimer();
        });

        panel?.addEventListener('pointerleave', () => {
          queueRewardClose();
        });
      });

      const buildShareUrl = (platform) => {
        const encodedUrl = encodeURIComponent(permalink);
        const encodedTitle = encodeURIComponent(title);
        const shortSummary = summary.slice(0, 120).trim();
        const shareText = `${title}${shortSummary ? `\n${shortSummary}` : ''}`;
        const shareParagraph = `${title}${shortSummary ? `\n\n${shortSummary}` : ''}\n${permalink}`;
        const encodedSummary = encodeURIComponent(shortSummary);
        const encodedShareText = encodeURIComponent(shareText);
        const encodedShareParagraph = encodeURIComponent(shareParagraph);
        const encodedFacebookQuote = encodeURIComponent(shortSummary ? `${title} · ${shortSummary}` : title);
        const encodedRedditTitle = encodeURIComponent(shortSummary ? `${title} · ${shortSummary}` : title);

        switch (platform) {
          case 'x':
            return `https://twitter.com/intent/tweet?text=${encodedShareText}&url=${encodedUrl}`;
          case 'facebook':
            return `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}&quote=${encodedFacebookQuote}`;
          case 'threads':
            return `https://www.threads.net/intent/post?text=${encodedShareParagraph}`;
          case 'linkedin':
            return `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
          case 'telegram':
            return `https://t.me/share/url?url=${encodedUrl}&text=${encodedShareText}`;
          case 'reddit':
            return `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedRedditTitle}`;
          case 'weibo':
            return `https://service.weibo.com/share/share.php?title=${encodedShareText}&url=${encodedUrl}`;
          case 'qq':
            return `https://connect.qq.com/widget/shareqq/index.html?url=${encodedUrl}&title=${encodedTitle}&summary=${encodedSummary}`;
          case 'email':
            return `mailto:?subject=${encodedTitle}&body=${encodedShareParagraph}`;
          default:
            return '';
        }
      };

      section.querySelectorAll('[data-tool="copy"]').forEach((button) => {
        button.addEventListener('click', async () => {
          const copied = await copyText(permalink);
          if (copied) setStatus(copyDone);
        });
      });

      section.querySelectorAll('[data-panel-trigger]').forEach((button) => {
        button.addEventListener('click', () => {
          const panelName = button.getAttribute('data-panel-trigger');
          if (!panelName) return;
          togglePanel(panelName, button);
          setStatus(panelName === 'reward' ? '已切换打赏面板' : '已切换扫码分享面板');
        });
      });

      section.querySelectorAll('[data-panel-close]').forEach((button) => {
        button.addEventListener('click', () => closePanels());
      });

      if (backdrop instanceof HTMLElement) {
        backdrop.addEventListener('click', () => closePanels());
      }

      section.querySelectorAll('[data-tool="share"]').forEach((button) => {
        button.addEventListener('click', async () => {
          if (navigator.share) {
            try {
              await navigator.share({ title, text: summary, url: permalink });
              setStatus(shareDone);
              return;
            } catch (error) {
              if (error instanceof DOMException && error.name === 'AbortError') return;
            }
          }

          const copied = await copyText(permalink);
          if (copied) setStatus(shareFallback);
        });
      });

      section.querySelectorAll('[data-share-platform]').forEach((button) => {
        button.addEventListener('click', async () => {
          const platform = button.getAttribute('data-share-platform');
          if (!platform) return;

          if (platform === 'copy') {
            const copied = await copyText(permalink);
            if (copied) setStatus(copyDone);
            return;
          }

          if (platform === 'native') {
            if (navigator.share) {
              try {
                await navigator.share({ title, text: summary, url: permalink });
                setStatus(shareDone);
                return;
              } catch (error) {
                if (error instanceof DOMException && error.name === 'AbortError') return;
              }
            }

            const copied = await copyText(permalink);
            if (copied) setStatus(shareFallback);
            return;
          }

          if (platform === 'wechat') {
            togglePanel('wechat', button);
            setStatus('已打开扫码分享面板');
            return;
          }

          const shareUrl = buildShareUrl(platform);
          if (!shareUrl) return;

          closePanels();
          if (platform === 'email') {
            window.location.href = shareUrl;
          } else {
            window.open(shareUrl, '_blank', 'noopener,noreferrer,width=860,height=720');
          }
          setStatus('已打开对应平台分享窗口');
        });
      });

      const repositionActivePanel = () => {
        const activePanelName = getActivePanel();
        if (!activePanelName) return;
        const activeElement = panels.find((panel) => panel.dataset.panel === activePanelName);
        const activeAnchor = panelAnchors.get(activePanelName);
        if (activeElement instanceof HTMLElement && activeAnchor instanceof HTMLElement) {
          positionPanel(activeElement, activeAnchor);
        }
      };

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closePanels();
      });
      window.addEventListener('resize', repositionActivePanel);
      window.addEventListener('scroll', repositionActivePanel, { passive: true });

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Node)) return;
        if (!section.contains(event.target)) closePanels();
      });
    });
  })();
</script>
