---
import { Heart, Link2, ScrollText, Share2, Smartphone } from 'lucide-react';
import { siteConfig } from '../../config/site';
import { slugifySegment } from '../../lib/content';
import QrCodeImage from './QrCodeImage.astro';
import RewardRegionPanel from './RewardRegionPanel.astro';

interface Props {
  permalink: string;
  title: string;
  authorName: string;
  authorRole: string;
  authorAvatar: string;
  badge: string;
  copyrightTitle: string;
  notice: string;
  copyLabel: string;
  rewardLabel: string;
  rewardNote: string;
  category: string;
  tags: string[];
  aboutTitle: string;
  modeHref: string;
  modeLabel: string;
  modeDescription: string;
  shareLabel: string;
  rewardHref: string;
  rewardDescription: string;
  copyDoneLabel: string;
  shareDoneLabel: string;
  shareFallbackLabel: string;
}

const {
  permalink,
  title,
  authorName,
  authorRole,
  authorAvatar,
  badge,
  copyrightTitle,
  notice,
  copyLabel,
  rewardLabel,
  rewardNote,
  category,
  tags,
  aboutTitle,
  modeHref,
  modeLabel,
  modeDescription,
  shareLabel,
  rewardHref,
  rewardDescription,
  copyDoneLabel,
  shareDoneLabel,
  shareFallbackLabel,
} = Astro.props;

const categoryHref = `/categories/${slugifySegment(category)}/`;
const sharePlatforms = siteConfig.support.share.platforms;
---

<section
  class="post-copyright-block"
  data-post-tools
  data-title={title}
  data-permalink={permalink}
  data-copy-done={copyDoneLabel}
  data-share-done={shareDoneLabel}
  data-share-fallback={shareFallbackLabel}
>
  <div class="post-tools">
    <div class="post-tools-left">
      <div class="rewardLeftButton">
        <button type="button" class="reward-link-button" data-panel-trigger="reward">
          <Heart class="post-tools__icon" aria-hidden="true" />
          <span>{rewardLabel}</span>
        </button>
        <a class="reward-link-button" href={modeHref}>
          <ScrollText class="post-tools__icon" aria-hidden="true" />
          <span>{modeLabel}</span>
        </a>
      </div>

      <div class="post-tools__about">
        <span class="post-tools__about-title">{aboutTitle}</span>
        <p>{modeDescription}</p>
      </div>
    </div>

    <div class="shareRight">
      <button type="button" class="share-button" title={siteConfig.support.share.qrcodeLabel} data-panel-trigger="wechat">
        <Smartphone class="post-tools__icon" aria-hidden="true" />
        <span>扫码</span>
      </button>
      <button type="button" class="share-button" title={copyLabel} data-tool="copy">
        <Link2 class="post-tools__icon" aria-hidden="true" />
        <span>{copyLabel}</span>
      </button>
      <button type="button" class="share-button" title={shareLabel} data-tool="share">
        <Share2 class="post-tools__icon" aria-hidden="true" />
        <span>{shareLabel}</span>
      </button>
    </div>

    <div class="post-tools__status" aria-live="polite"></div>
  </div>

  <div class="post-tools-panels">
    <div class="post-floating-panel" data-panel="reward" hidden>
      <div class="post-floating-panel__head">
        <div>
          <span class="post-floating-panel__eyebrow">{siteConfig.support.reward.title}</span>
          <strong>{rewardLabel}</strong>
        </div>
        <button type="button" class="post-floating-panel__close" data-panel-close aria-label="Close">
          ×
        </button>
      </div>
      <p class="post-floating-panel__summary">{siteConfig.support.reward.summary}</p>
      <RewardRegionPanel variant="panel" />
      <div class="post-floating-panel__footer">
        <a href={rewardHref}>{siteConfig.support.reward.historyLabel}</a>
        <span>{rewardNote}</span>
      </div>
    </div>

    <div class="post-floating-panel" data-panel="wechat" hidden>
      <div class="post-floating-panel__head">
        <div>
          <span class="post-floating-panel__eyebrow">{siteConfig.support.share.qrcodeLabel}</span>
          <strong>WeChat / Mobile Share</strong>
        </div>
        <button type="button" class="post-floating-panel__close" data-panel-close aria-label="Close">
          ×
        </button>
      </div>
      <p class="post-floating-panel__summary">{siteConfig.support.share.qrcodeDescription}</p>
      <div class="post-share-qrcode">
        <div class="post-share-qrcode__image">
          <QrCodeImage value={permalink} alt={`${title} 分享二维码`} size={198} fgColor="#111827" />
        </div>
        <div class="post-share-qrcode__meta">
          <strong>{title}</strong>
          <p>扫码后可在 WeChat、移动端浏览器或另一台设备上直接打开本文。</p>
          <button type="button" class="post-share-qrcode__action" data-tool="copy">
            {copyLabel}
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="post-copyright">
    <div class="copyright-cc-box">©</div>
    <div class="post-copyright__author_box">
      <a class="post-copyright__author_img" href="/about/" title={authorName}>
        <img class="post-copyright__author_img_back" src={authorAvatar} alt={authorName} loading="lazy" />
        <img class="post-copyright__author_img_front" src={authorAvatar} alt={authorName} loading="lazy" />
      </a>
      <div class="post-copyright__author_name">{authorName}</div>
      <div class="post-copyright__author_desc">{authorRole}</div>
    </div>

    <div class="post-copyright__post__info">
      <a class="post-copyright__original" href={permalink}>{badge}</a>
      <button type="button" class="post-copyright-title" data-tool="copy" title={copyLabel}>
        <span>{title}</span>
      </button>
    </div>

    <div class="post-copyright__notice">
      <span class="post-copyright-info">{notice}</span>
    </div>
  </div>

  <div class="post-tools-right">
    <div class="tag_share">
      <div class="post-meta__box">
        <div class="post-meta__box__heading">
          <span class="post-meta__box__title">{copyrightTitle}</span>
          <p>{rewardDescription}</p>
        </div>

        <div class="post-meta__box__category-list">
          <a href={categoryHref} class="post-meta__box__categoryes">
            <span class="categoryes-punctuation">#</span>
            {category}
          </a>
        </div>

        {tags.length > 0 && (
          <div class="post-meta__box__tag-list">
            {tags.map((tag) => (
              <a href={`/tags/${slugifySegment(tag)}/`} class="post-meta__box__tags">
                <span class="tags-punctuation">#</span>
                {tag}
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="post-share-grid">
        {sharePlatforms.map((platform) => (
          <button
            type="button"
            class="post-share-grid__item"
            style={`--platform-accent:${platform.accent};`}
            data-share-platform={platform.id}
          >
            <span class="post-share-grid__badge">{platform.shortLabel}</span>
            <strong>{platform.label}</strong>
            <span>{platform.description}</span>
          </button>
        ))}
      </div>
    </div>
    <p class="post-share-actions__note">{rewardNote}</p>
  </div>
</section>

<script is:inline>
  (() => {
    const sections = document.querySelectorAll('[data-post-tools]');
    if (sections.length === 0) return;

    const copyText = async (value) => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(value);
          return true;
        }
      } catch {}

      try {
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'absolute';
        textarea.style.left = '-9999px';
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        textarea.remove();
        return true;
      } catch {
        return false;
      }
    };

    sections.forEach((section) => {
      if (!(section instanceof HTMLElement)) return;

      const permalink = section.dataset.permalink ?? window.location.href;
      const title = section.dataset.title ?? document.title;
      const copyDone = section.dataset.copyDone ?? '链接已复制';
      const shareDone = section.dataset.shareDone ?? '已唤起系统分享';
      const shareFallback = section.dataset.shareFallback ?? '当前环境不支持系统分享，已回退为复制链接';
      const status = section.querySelector('.post-tools__status');
      const panels = Array.from(section.querySelectorAll('[data-panel]')).filter((node) => node instanceof HTMLElement);
      let statusTimer = 0;

      const setStatus = (message) => {
        if (!(status instanceof HTMLElement)) return;
        window.clearTimeout(statusTimer);
        status.textContent = message;
        status.classList.add('is-visible');
        statusTimer = window.setTimeout(() => {
          status.classList.remove('is-visible');
        }, 2200);
      };

      const closePanels = () => {
        panels.forEach((panel) => {
          panel.hidden = true;
          panel.classList.remove('is-open');
        });
      };

      const togglePanel = (name) => {
        panels.forEach((panel) => {
          const shouldOpen = panel.dataset.panel === name && panel.hidden;
          panel.hidden = !shouldOpen;
          panel.classList.toggle('is-open', shouldOpen);
        });
      };

      const buildShareUrl = (platform) => {
        const encodedUrl = encodeURIComponent(permalink);
        const encodedTitle = encodeURIComponent(title);
        const combined = encodeURIComponent(`${title} ${permalink}`);

        switch (platform) {
          case 'x':
            return `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
          case 'facebook':
            return `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
          case 'threads':
            return `https://threads.com/intent/post?text=${combined}`;
          case 'linkedin':
            return `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
          case 'telegram':
            return `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`;
          case 'reddit':
            return `https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`;
          case 'weibo':
            return `https://service.weibo.com/share/share.php?title=${encodedTitle}&url=${encodedUrl}`;
          case 'qq':
            return `https://connect.qq.com/widget/shareqq/index.html?url=${encodedUrl}&title=${encodedTitle}`;
          case 'email':
            return `mailto:?subject=${encodedTitle}&body=${encodeURIComponent(`${title}\n${permalink}`)}`;
          default:
            return '';
        }
      };

      section.querySelectorAll('[data-tool="copy"]').forEach((button) => {
        button.addEventListener('click', async () => {
          const copied = await copyText(permalink);
          if (copied) setStatus(copyDone);
        });
      });

      section.querySelectorAll('[data-panel-trigger]').forEach((button) => {
        button.addEventListener('click', () => {
          const panelName = button.getAttribute('data-panel-trigger');
          if (!panelName) return;
          togglePanel(panelName);
          setStatus(panelName === 'reward' ? '已打开支持二维码面板' : '已打开扫码分享面板');
        });
      });

      section.querySelectorAll('[data-panel-close]').forEach((button) => {
        button.addEventListener('click', () => closePanels());
      });

      section.querySelectorAll('[data-tool="share"]').forEach((button) => {
        button.addEventListener('click', async () => {
          if (navigator.share) {
            try {
              await navigator.share({ title, url: permalink });
              setStatus(shareDone);
              return;
            } catch (error) {
              if (error instanceof DOMException && error.name === 'AbortError') return;
            }
          }

          const copied = await copyText(permalink);
          if (copied) setStatus(shareFallback);
        });
      });

      section.querySelectorAll('[data-share-platform]').forEach((button) => {
        button.addEventListener('click', async () => {
          const platform = button.getAttribute('data-share-platform');
          if (!platform) return;

          if (platform === 'copy') {
            const copied = await copyText(permalink);
            if (copied) setStatus(copyDone);
            return;
          }

          if (platform === 'native') {
            if (navigator.share) {
              try {
                await navigator.share({ title, url: permalink });
                setStatus(shareDone);
                return;
              } catch (error) {
                if (error instanceof DOMException && error.name === 'AbortError') return;
              }
            }

            const copied = await copyText(permalink);
            if (copied) setStatus(shareFallback);
            return;
          }

          if (platform === 'wechat') {
            togglePanel('wechat');
            setStatus('已打开扫码分享面板');
            return;
          }

          const shareUrl = buildShareUrl(platform);
          if (!shareUrl) return;

          closePanels();
          if (platform === 'email') {
            window.location.href = shareUrl;
          } else {
            window.open(shareUrl, '_blank', 'noopener,noreferrer,width=860,height=720');
          }
          setStatus('已打开对应平台分享窗口');
        });
      });

      window.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closePanels();
      });
    });
  })();
</script>
