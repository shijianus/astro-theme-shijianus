---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import {
  getDisplayPostCategory,
  getDisplayPostTitle,
  getPostPath,
  getTagPath,
  resolveDisplayCover,
} from '../../lib/content';
import { formatDisplayDate } from '../../lib/theme';

interface Props {
  entry: CollectionEntry<'posts'>;
  index?: number;
  isLatest?: boolean;
}

const { entry, index = 0, isLatest = false } = Astro.props;

const link = getPostPath(entry);
const title = getDisplayPostTitle(entry);
const isSticky = Boolean(entry.data.sticky && entry.data.sticky > 0);
const category = getDisplayPostCategory(entry);
const cover = resolveDisplayCover(entry);
const tags = entry.data.tags ?? [];

// In hexo-theme-anzhiyu post-ui.pug:
// position = theme.cover.position
// leftOrRight = position === 'both' ? (index % 2 == 0 ? 'left' : 'right') : position
const leftOrRight = index % 2 === 0 ? 'left' : 'right';
const noCover = !cover;

const pubDateIso = entry.data.pubDate.toISOString();
const pubDateFormatted = formatDisplayDate(entry.data.pubDate);
---

<div
  class={`recent-post-item ${index === 0 && isLatest ? 'lastestpost-item' : ''}`}
  onclick={`location.href='${link}'`}
>
  {cover && (
    <div class={`post_cover ${leftOrRight}`}>
      <a href={link} title={title} style="display: flex; height: 100%;">
        <img
          class="post_bg"
          src={cover}
          alt={title}
          style="pointer-events: none;"
          loading="lazy"
          onerror={`this.onerror=null;this.src='${siteConfig.post.hero.fallbackImage}'`}
        />
      </a>
    </div>
  )}

  <div class={`recent-post-info ${noCover ? 'no-cover' : ''}`}>
    <div class="recent-post-info-top">
      <div class="recent-post-info-top-tips">
        {isSticky && (
          <span class="article-meta sticky-warp">
            <i class="anzhiyufont anzhiyu-icon-thumbtack sticky"></i>
            <span class="sticky">置顶</span>
          </span>
        )}
        {category && (
          <div class="article-categories-original">{category}</div>
        )}
        {isLatest && <span class="newPost">最新</span>}
        <a class="unvisited-post" href={link} title={title}>未读</a>
      </div>
      <a class="article-title" href={link} title={title}>{title}</a>
    </div>

    <div class="article-meta-wrap">
      <span class="post-meta-date">
        <i class="anzhiyufont anzhiyu-icon-calendar-days" style="font-size: 15px; display: none;"></i>
        <time datetime={pubDateIso} title={`发表于 ${pubDateFormatted}`}>{pubDateFormatted}</time>
      </span>

      {tags.length > 0 && (
        <span class="article-meta tags">
          {tags.map((tag) => (
            <a
              href={getTagPath(tag)}
              class="article-meta__tags"
              onclick="event.stopPropagation();"
            >
              <span>
                <i class="anzhiyufont anzhiyu-icon-hashtag"></i>
                {tag}
              </span>
            </a>
          ))}
        </span>
      )}
    </div>
  </div>
</div>
