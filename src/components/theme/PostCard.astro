---
import type { CollectionEntry } from 'astro:content';
import {
  estimateReadingMinutes,
  getExcerpt,
  getPostPath,
  resolveCategory,
  resolveCover,
  resolveCoverAlt,
  resolveGroup,
  slugifySegment,
} from '../../lib/content';
import { formatDisplayDate } from '../../lib/theme';

interface Props {
  entry: CollectionEntry<'posts'>;
  index?: number;
}

const { entry, index = 0 } = Astro.props;

const href = getPostPath(entry);
const reverse = index % 2 === 1;
const metaDate = formatDisplayDate(entry.data.pubDate);
---

<article class={`recent-post-item lastestpost-item ${reverse ? 'is-reverse' : ''}`}>
  <a href={href} class={`post_cover ${reverse ? 'right right_radius' : 'left_radius'}`} title={entry.data.title}>
    <img
      src={resolveCover(entry)}
      alt={resolveCoverAlt(entry)}
      class="post_bg"
      loading="lazy"
    />
  </a>

  <div class="recent-post-info">
    <div class="recent-post-info-top">
      <div class="recent-post-info-top-tips">
        {entry.data.featured && <span class="newPost">Recommend</span>}
        <a class="unvisited-post" href={href}>Unread</a>
      </div>

      <a href={href} class="article-title" title={entry.data.title}>
        {entry.data.title}
      </a>
    </div>

    <div class="article-meta-wrap">
      <span class="post-meta-date">
        <span class="article-meta-label">Created</span>
        <time datetime={entry.data.pubDate.toISOString()}>{metaDate}</time>
      </span>
      <span class="article-meta">
        <a href={`/categories/${slugifySegment(resolveCategory(entry))}/`} class="article-meta-link">
          {resolveCategory(entry)}
        </a>
        <span class="article-meta-separator">/</span>
        <span>{resolveGroup(entry)}</span>
        <span class="article-meta-separator">/</span>
        <span>{estimateReadingMinutes(entry)} min</span>
      </span>
    </div>

    <p class="content">{getExcerpt(entry, 190)}</p>

    {entry.data.tags.length > 0 && (
      <div class="post-card-tags">
        {entry.data.tags.slice(0, 4).map((tag) => (
          <a href={`/tags/${slugifySegment(tag)}/`} class="theme-chip theme-chip--soft">
            #{tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
