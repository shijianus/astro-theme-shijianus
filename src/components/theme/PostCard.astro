---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import {
  getDisplayPostCategory,
  getDisplayPostTitle,
  getPostPath,
  getTagPath,
  resolveDisplayCover,
} from '../../lib/content';
import { formatDisplayDate } from '../../lib/theme';

interface Props {
  entry: CollectionEntry<'posts'>;
  index?: number;
}

const { entry, index = 0 } = Astro.props;

const link = getPostPath(entry);
const title = getDisplayPostTitle(entry);
const isSticky = Boolean(entry.data.sticky && entry.data.sticky > 0);
const category = getDisplayPostCategory(entry);
const cover = resolveDisplayCover(entry);
const tags = entry.data.tags ?? [];

const pubDateIso = entry.data.pubDate.toISOString();
const pubDateFormatted = formatDisplayDate(entry.data.pubDate);
---

<div
  class="group relative rounded-xl overflow-hidden bg-[var(--card-bg)] flex flex-col border border-[var(--card-border)] transition-all duration-300 hover:-translate-y-1 hover:shadow-lg cursor-pointer"
  onclick={`location.href='${link}'`}
>
  <div class="aspect-[16/10] w-full overflow-hidden relative bg-[var(--secondbg)]">
    {cover ? (
      <img
        class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-105"
        src={cover}
        alt={title}
        loading="lazy"
        onerror={`this.onerror=null;this.src='${siteConfig.post.hero.fallbackImage}'`}
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-indigo-500/10 via-purple-500/10 to-pink-500/10">
        <span class="text-sm font-medium text-[var(--text-soft)] opacity-60 select-none">
          {category || siteConfig.site.title}
        </span>
      </div>
    )}

    {isSticky && (
      <div class="absolute top-2 left-2 z-10 flex items-center gap-1 rounded bg-[#FF7242] px-1.5 py-0.5 text-[10px] font-bold text-white shadow-sm">
        <i class="anzhiyufont anzhiyu-icon-thumbtack"></i>
        <span>置顶</span>
      </div>
    )}
  </div>

  <div class="p-3 flex flex-col gap-1.5 flex-1 justify-between">
    <div>
      <a
        href={link}
        class="text-[15px] font-semibold line-clamp-2 leading-snug text-[var(--font-color)] hover:text-[var(--theme-main)] transition-colors"
      >
        {title}
      </a>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-1.5 pt-1 mt-auto">
      <div class="flex flex-wrap gap-1.5 items-center">
        {tags.map((tag) => (
          <a
            href={getTagPath(tag)}
            class="px-2 py-0.5 rounded-full text-[11px] bg-[var(--tag-bg)] text-[var(--tag-text)] hover:bg-[var(--theme-op)] hover:text-[var(--theme-main)] transition-colors"
            onclick="event.stopPropagation();"
          >
            {tag}
          </a>
        ))}
      </div>
      <time datetime={pubDateIso} class="text-[11px] text-neutral-400 shrink-0">
        {pubDateFormatted}
      </time>
    </div>
  </div>
</div>
