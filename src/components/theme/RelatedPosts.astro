---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getPostPath, resolveCover, resolveCoverAlt } from '../../lib/content';
import { formatDisplayDate } from '../../lib/theme';
import articleI18nMap from '../../.generated/article-i18n-map.json';

interface Props {
  posts: CollectionEntry<'posts'>[];
  eyebrow: string;
  title: string;
}

const { posts, eyebrow, title } = Astro.props;

function getPostTitlesByLang(post: CollectionEntry<'posts'>): Record<string, string> {
  const i18nKey = post.data.i18nKey || post.id.replace(/(?:[.-])(en|zh-Hant|zh-CN|fr|es|de)$/i, '');
  const translations = (articleI18nMap as Record<string, any>)[i18nKey]?.translations || {};
  const titles: Record<string, string> = {
    'zh-CN': post.data.title,
  };
  for (const [l, meta] of Object.entries(translations)) {
    if ((meta as any)?.title) titles[l] = (meta as any).title;
  }
  return titles;
}
---

<section class="relatedPosts">
  <div class="relatedPosts__head">
    <div class="relatedPosts__heading">
      <p class="eyebrow" data-related-eyebrow>{eyebrow}</p>
      <h2 class="relatedPosts__title" data-related-title>{title}</h2>
    </div>
    <div class="relatedPosts__meta">
      <span data-related-meta data-count={posts.length}>{posts.length} 篇延伸阅读</span>
    </div>
  </div>

  <div class="relatedPosts-list">
    {posts.map((post, index) => {
      const titlesByLang = getPostTitlesByLang(post);
      return (
        <a class="relatedPosts-item" href={getPostPath(post)}>
          <img
            src={resolveCover(post)}
            alt={resolveCoverAlt(post)}
            loading="lazy"
            decoding="async"
            data-fallback-src={siteConfig.post.hero.fallbackImage || '/media/shijianus/default.png'}
            data-remote-fallback-src={siteConfig.post.hero.remoteFallbackImage || '/media/shijianus/default.png'}
            onerror={`if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';if(!this.src.endsWith('${siteConfig.post.hero.fallbackImage || '/media/shijianus/default.png'}')){this.src='${siteConfig.post.hero.fallbackImage || '/media/shijianus/default.png'}';}else{this.onerror=null;}}else{this.onerror=null;}`}
          />
          <span class="relatedPosts-item__index">{String(index + 1).padStart(2, '0')}</span>
          <div class="content">
            <div class="date">{formatDisplayDate(post.data.pubDate)}</div>
            <div class="title" data-related-post-title data-titles={JSON.stringify(titlesByLang)}>{post.data.title}</div>
          </div>
        </a>
      );
    })}
  </div>

  <script is:inline>
  (() => {
    const RELATED_I18N = {
      'zh-CN': {
        eyebrow: '相关推荐',
        title: '继续探索更多相关记录',
        meta: (n) => `${n} 篇延伸阅读`,
      },
      'zh-Hant': {
        eyebrow: '相關推薦',
        title: '繼續探索更多相關記錄',
        meta: (n) => `${n} 篇延伸閱讀`,
      },
      'en': {
        eyebrow: 'Related Posts',
        title: 'Continue Exploring Related Topics',
        meta: (n) => `${n} related articles`,
      },
      'es': {
        eyebrow: 'Publicaciones Relacionadas',
        title: 'Continuar Explorando Temas Relacionados',
        meta: (n) => `${n} artículos relacionados`,
      },
      'de': {
        eyebrow: 'Ähnliche Beiträge',
        title: 'Entdecken Sie weitere verwandte Themen',
        meta: (n) => `${n} weiterführende Artikel`,
      },
      'fr': {
        eyebrow: 'Articles Connexes',
        title: 'Poursuivez votre exploration',
        meta: (n) => `${n} lectures recommandées`,
      },
    };

    const updateRelated = (lang) => {
      const normalized = (lang || '').toLowerCase().startsWith('zh-hant') ? 'zh-Hant'
        : (lang || '').toLowerCase().startsWith('zh') ? 'zh-CN'
        : ['en', 'es', 'de', 'fr'].includes((lang || '').split('-')[0]) ? (lang || '').split('-')[0]
        : 'zh-CN';
      const t = RELATED_I18N[normalized] || RELATED_I18N['zh-CN'];

      const eyebrowEl = document.querySelector('[data-related-eyebrow]');
      if (eyebrowEl) eyebrowEl.textContent = t.eyebrow;

      const titleEl = document.querySelector('[data-related-title]');
      if (titleEl) titleEl.textContent = t.title;

      const metaEl = document.querySelector('[data-related-meta]');
      if (metaEl) {
        const count = parseInt(metaEl.getAttribute('data-count') || '0', 10);
        metaEl.textContent = t.meta(count);
      }

      // Update related post titles according to active language
      document.querySelectorAll('[data-related-post-title]').forEach((el) => {
        try {
          const dict = JSON.parse(el.dataset.titles || '{}');
          if (dict[normalized]) {
            el.textContent = dict[normalized];
          } else if (dict['en'] && !normalized.startsWith('zh')) {
            el.textContent = dict['en'];
          } else if (dict['zh-CN']) {
            el.textContent = dict['zh-CN'];
          }
        } catch (_) {}
      });
    };

    const curLang = document.documentElement.lang || 'zh-CN';
    updateRelated(curLang);

    window.addEventListener('shijianus:localechange', (e) => {
      const next = typeof e?.detail === 'string' ? e.detail : (e?.detail?.lang || document.documentElement.lang || 'zh-CN');
      updateRelated(next);
    });
  })();
  </script>
</section>
