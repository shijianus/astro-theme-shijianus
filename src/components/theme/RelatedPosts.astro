---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getPostPath, resolveCover, resolveCoverAlt } from '../../lib/content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  eyebrow?: string;
  title?: string;
}

const { posts, eyebrow = '相关推荐', title = '喜欢这篇文章的人也看了' } = Astro.props;

const formatPostDate = (date: Date) => {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
};
---

{posts.length > 0 && (
  <div class="relatedPosts">
    <div class="headline">
      <i class="anzhiyufont anzhiyu-icon-thumbs-up fa-fw"></i>
      <span>{title}</span>
    </div>
    <div class="relatedPosts-list">
      {posts.map((post) => (
        <div>
          <a href={getPostPath(post)} title={post.data.title}>
            <img
              class="cover"
              src={resolveCover(post)}
              alt={resolveCoverAlt(post)}
              loading="lazy"
              data-fallback-src={siteConfig.post.hero.fallbackImage}
            />
            <div class="content is-center">
              <div class="date">
                <i class="anzhiyufont anzhiyu-icon-calendar-days fa-fw"></i>
                <span>{formatPostDate(post.data.pubDate)}</span>
              </div>
              <div class="title">{post.data.title}</div>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
)}
