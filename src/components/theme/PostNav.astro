---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getPostPath, resolveCover } from '../../lib/content';

interface Props {
  previousPost?: CollectionEntry<'posts'> | null;
  nextPost?: CollectionEntry<'posts'> | null;
}

const { previousPost = null, nextPost = null } = Astro.props;
---

{(previousPost || nextPost) && (
  <nav class="pagination-post" id="pagination">
    {previousPost && (
      <div class:list={['prev-post', !nextPost && 'pull-full']}>
        <a href={getPostPath(previousPost)} title={previousPost.data.title}>
          <img
            class="prev-cover"
            src={resolveCover(previousPost)}
            alt={`上一篇：${previousPost.data.title}`}
            loading="lazy"
            data-fallback-src={siteConfig.post.hero.fallbackImage}
          />
          <div class="pagination-info">
            <div class="label">上一篇</div>
            <div class="prev_info">{previousPost.data.title}</div>
          </div>
        </a>
      </div>
    )}
    {nextPost && (
      <div class:list={['next-post', !previousPost && 'pull-full']}>
        <a href={getPostPath(nextPost)} title={nextPost.data.title}>
          <img
            class="next-cover"
            src={resolveCover(nextPost)}
            alt={`下一篇：${nextPost.data.title}`}
            loading="lazy"
            data-fallback-src={siteConfig.post.hero.fallbackImage}
          />
          <div class="pagination-info">
            <div class="label">下一篇</div>
            <div class="next_info">{nextPost.data.title}</div>
          </div>
        </a>
      </div>
    )}
  </nav>
)}

{nextPost && (
  <div class="floating-next-post" id="floating-next-post" data-floating-next>
    <a href={getPostPath(nextPost)} class="floating-next-post__inner">
      <div class="floating-next-post__label">下一篇推荐</div>
      <div class="floating-next-post__title">{nextPost.data.title}</div>
    </a>
  </div>
)}

<script is:inline>
  (() => {
    const floating = document.getElementById('floating-next-post');
    const pagination = document.getElementById('pagination');
    const comment = document.getElementById('post-comment');
    if (!floating) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          floating.classList.add('is-visible');
        } else {
          // If we scroll way back up
          if (window.scrollY < (document.documentElement.scrollHeight * 0.4)) {
            floating.classList.remove('is-visible');
          }
        }
      });
    }, { rootMargin: '0px 0px -10% 0px' });

    if (pagination) observer.observe(pagination);
    else if (comment) observer.observe(comment);
  })();
</script>
