---
import { CalendarDays, RefreshCw, Tag as TagIcon } from 'lucide-react';
import { siteConfig } from '../../config/site';

interface Props {
  title: string;
  description?: string;
  version?: string;
  pubDate?: Date | string;
  updatedDate?: Date | string;
}

const {
  title,
  description,
  version = 'v1.0.0',
  pubDate,
  updatedDate,
} = Astro.props;

const showVersion = (siteConfig.post.hero as any).showVersion !== false;
const showDates = (siteConfig.post.hero as any).showDates !== false;

const formatHeroDate = (dateInput?: Date | string) => {
  if (!dateInput) return '';
  const d = dateInput instanceof Date ? dateInput : new Date(dateInput);
  if (isNaN(d.getTime())) return String(dateInput);
  return `${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}/${String(d.getFullYear()).slice(-2)}`;
};

const pubStr = pubDate ? formatHeroDate(pubDate) : '';
const updStr = updatedDate ? formatHeroDate(updatedDate) : '';
const hasMeta = (showVersion && Boolean(version)) || (showDates && (Boolean(pubStr) || Boolean(updStr)));
---

<header
  class="standards-spec-header post-hero is-pure-color"
  data-post-hero
>
  <div class="post-hero__inner">
    <div class="post-hero__title-block" data-auto-fit-title="true">
      <h1 class="standards-spec-header__title post-hero__title">{title}</h1>
      {description && (
        <p class="standards-spec-header__desc post-hero__lede">{description}</p>
      )}
    </div>

    {hasMeta && (
      <div class="standards-spec-header__meta-grid post-hero__meta-grid">
        {showVersion && version && (
          <span class="post-hero__meta-item standards-spec-meta-item">
            <span class="post-hero__meta-icon" aria-hidden="true">
              <TagIcon className="post-hero__meta-icon-svg" aria-hidden="true" />
            </span>
            <span class="post-hero__meta-label">{(siteConfig.post.hero.metaLabels as any).version || '版本'}</span>
            <strong class="post-hero__meta-value">{version}</strong>
          </span>
        )}
        {showDates && pubStr && (
          <>
            {showVersion && version && <span class="post-hero__meta-dot" aria-hidden="true">•</span>}
            <span class="post-hero__meta-item standards-spec-meta-item">
              <span class="post-hero__meta-icon" aria-hidden="true">
                <CalendarDays className="post-hero__meta-icon-svg" aria-hidden="true" />
              </span>
              <span class="post-hero__meta-label">{siteConfig.post.hero.metaLabels.published}</span>
              <strong class="post-hero__meta-value">{pubStr}</strong>
            </span>
          </>
        )}
        {showDates && updStr && (
          <>
            <span class="post-hero__meta-dot" aria-hidden="true">•</span>
            <span class="post-hero__meta-item standards-spec-meta-item">
              <span class="post-hero__meta-icon" aria-hidden="true">
                <RefreshCw className="post-hero__meta-icon-svg" aria-hidden="true" />
              </span>
              <span class="post-hero__meta-label">{siteConfig.post.hero.metaLabels.updated}</span>
              <strong class="post-hero__meta-value">{updStr}</strong>
            </span>
          </>
        )}
      </div>
    )}
  </div>

  <div class="post-hero__waves" aria-hidden="true">
    <svg class="post-hero__waves-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
      <defs>
        <path id="post-hero-wave" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v44h-352Z"></path>
      </defs>
      <g class="post-hero__waves-group">
        <use href="#post-hero-wave" x="48" y="0"></use>
        <use href="#post-hero-wave" x="48" y="3"></use>
        <use href="#post-hero-wave" x="48" y="5"></use>
        <use href="#post-hero-wave" x="48" y="7"></use>
      </g>
    </svg>
  </div>
</header>
