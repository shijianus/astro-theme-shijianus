<script is:inline>
  (() => {
    const initFlipBack = () => {
      const toggle = document.getElementById('today-card-toggle');
      const topGroup = document.querySelector('.topGroup');
      const backboard = document.getElementById('topGroup-backboard');
      if (!toggle || !topGroup) return;

      const doRollback = () => {
        if (toggle.checked) {
          toggle.checked = false;
          toggle.dispatchEvent(new Event('change', { bubbles: true }));
        }
      };

      if (backboard) {
        backboard.addEventListener('click', (e) => {
          e.preventDefault();
          doRollback();
        });
      }

      // Clicking anywhere on topGroup outside cards rolls back
      topGroup.addEventListener('click', (e) => {
        if (!e.target.closest('.recent-post-item') && !e.target.closest('.todayCard')) {
          doRollback();
        }
      });

      // Prevent card clicks from bubbling to backboard
      topGroup.querySelectorAll('.recent-post-item').forEach((card) => {
        card.addEventListener('click', (e) => {
          e.stopPropagation();
        });
      });

      // ESC key to return
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle.checked) {
          doRollback();
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFlipBack);
    } else {
      initFlipBack();
    }
    document.addEventListener('astro:page-load', initFlipBack);
  })();
</script>

<style is:global>
  /* 彻底屏蔽旧版的 ::after 幽灵线 */
  body[data-type='home'] .categoryButton::after,
  body[data-type='home'] .categoryButton::before {
    display: none !important;
    content: none !important;
  }

  /* 修正内容区对齐：居中聚拢、向左靠齐，预留呼吸间距 */
  body[data-type='home'] .categoryItem-content {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: center !important; 
    padding: 10px 14px 10px 12px !important; /* 确保距离上下边界有足够呼吸感，左右分布均衡 */
    height: 100% !important;
    box-sizing: border-box !important;
    z-index: 2 !important;
    position: relative !important;
    pointer-events: none !important;
    min-width: 0 !important;
    width: 100% !important;
    background: transparent !important;
    overflow: hidden !important; /* 防止内容撑破 */
  }

  body[data-type='home'] .categoryButton {
    display: flex !important;
    flex: 1 1 100% !important;
    height: 100% !important;
    align-items: center !important;
    position: relative !important;
    overflow: hidden !important;
    border-radius: 12px !important;
    text-decoration: none !important;
    transform: none !important;
    transition: background 0.3s ease !important;
    max-width: none !important;
    min-width: 0 !important;
  }

  /* 分割线样式：原址替换，并推开下方的介绍文本 */
  body[data-type='home'] .categoryItem-content .divider {
    width: 20px !important;
    height: 2.5px !important;
    background-color: currentColor !important;
    border-radius: 2px !important;
    margin-top: 0 !important;
    margin-bottom: 4px !important;
    opacity: 0.82 !important;
    flex-shrink: 0 !important;
  }

  /* 标题样式：精致比例，不压迫空间 */
  body[data-type='home'] .categoryButtonText {
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    margin-bottom: 3px !important;
