---
import { BookOpen, Boxes, CodeXml, Compass, type LucideIcon } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getExcerpt, getPostPath, hasPostAccess, resolveCategory, resolveCover, resolveCoverAlt } from '../../lib/content';

interface Props {
  featuredPosts: CollectionEntry<'posts'>[];
  latestPosts: CollectionEntry<'posts'>[];
}

const { featuredPosts, latestPosts } = Astro.props;

const visibleFeaturedPosts = featuredPosts.filter((entry) => !hasPostAccess(entry));
const visibleLatestPosts = latestPosts.filter((entry) => !hasPostAccess(entry));
const topPosts = (visibleFeaturedPosts.length > 0 ? visibleFeaturedPosts : visibleLatestPosts).slice(0, 6);
const todayPost = topPosts[0] ?? visibleLatestPosts[0];
const stackPosts = topPosts.slice(0, 3);
const mobileFocusPost = topPosts[0] ?? todayPost;
const categoryItems = siteConfig.home.categories.slice(0, 3);
const showcase = siteConfig.home.hero.showcase;
const showcaseTiles = [...showcase.tiles, ...showcase.tiles];
const topDeck = siteConfig.home.hero.topDeck;
const randomHref = siteConfig.navigation.quickActions[0]?.href ?? (latestPosts[0] ? getPostPath(latestPosts[0]) : '/archives/');
const categoryIconMap: Record<(typeof categoryItems)[number]['icon'], LucideIcon> = {
  boxes: Boxes,
  code: CodeXml,
  book: BookOpen,
  compass: Compass,
};
---

<section id="home_top" aria-label="首页重点内容">
  <input id="today-card-toggle" class="today-card-toggle" type="checkbox" aria-hidden="true" />

  <div class="home-top-notice">
    <span class="home-top-notice__label">最新动态</span>
    <p>{siteConfig.home.announcement.summary}</p>
    <a href={siteConfig.home.announcement.href} data-tooltip="更多">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </a>
  </div>

  <div class="swiper_container_card">
    <div id="bannerGroup">
      <a id="random-banner" href={randomHref} aria-label={siteConfig.navigation.quickActions[0]?.label ?? '随机文章'}>
        <div class="random-banner__content">
          <span class="random-banner__eyebrow">{showcase.eyebrow}</span>
          <span class="random-banner__title">
            <span>{showcase.leadTop}</span>
            <span>{showcase.leadBottom}</span>
          </span>
          <span class="random-banner__domain">{showcase.foot}</span>
        </div>

        <div id="skills-tags-group-all" aria-hidden="true">
          <div class="tags-group-wrapper">
            {showcaseTiles.map((item, index) => (
              <span class="tags-group-icon-pair" style={`--delay:${index * 0.12}s;`}>
                <span class={`tags-group-icon is-${item.accent}`}>
                  <span class="tags-group-icon__short">{item.short}</span>
                  <span class="tags-group-icon__label">{item.label}</span>
                </span>
              </span>
            ))}
          </div>
          <div class="tags-group-wrapper tags-group-wrapper--offset">
            {showcaseTiles.slice().reverse().map((item, index) => (
              <span class="tags-group-icon-pair" style={`--delay:${index * 0.1}s;`}>
                <span class={`tags-group-icon is-${item.accent}`}>
                  <span class="tags-group-icon__short">{item.short}</span>
                  <span class="tags-group-icon__label">{item.label}</span>
                </span>
              </span>
            ))}
          </div>
        </div>

        <div id="random-hover">
          <span class="random-hover__lead">
            <span class="random-hover__icon" aria-hidden="true">{topDeck.hoverMonogram}</span>
            <span class="random-hover__body">
              <span class="bannerText">
                <span class="bannerText__label">{topDeck.hoverActionLabel}</span>
                <span class="bannerText__arrow" aria-hidden="true">→</span>
              </span>
              <span class="random-hover__hint">{topDeck.hoverActionHint}</span>
            </span>
          </span>
        </div>
      </a>

        <div class="categoryGroup" aria-label="首页分类入口">
          {categoryItems.map((item) => {
            const CategoryIcon = categoryIconMap[item.icon];
            return (
              <div class="categoryItem">
                <a class={`categoryButton ${item.accent}`} href={item.href}>
                  <div class="categoryItem-content">
                    <span class="categoryButtonText">{item.label}</span>
                    <div class="divider"></div>
                    <span class="categoryButtonDesc">{item.description}</span>
                  </div>
                  <CategoryIcon className="categoryButtonIcon" aria-hidden="true" />
                </a>
              </div>
            );
          })}
        </div>

      {mobileFocusPost && (
        <article class="home-mobile-focus-card">
          <a href={getPostPath(mobileFocusPost)} title={mobileFocusPost.data.title}>
            <img
              src={resolveCover(mobileFocusPost)}
              alt={resolveCoverAlt(mobileFocusPost)}
              loading="eager"
              data-fallback-src={siteConfig.post.hero.fallbackImage}
            />
            <span class="home-mobile-focus-card__body">
              <span class="home-mobile-focus-card__title">{mobileFocusPost.data.title}</span>
            </span>
          </a>
        </article>
      )}
    </div>

    <div class="topGroup">
      <div class="topGroup__stack" aria-hidden="true">
        <span class="topGroup__stack-back topGroup__stack-back--one"></span>
        <span class="topGroup__stack-back topGroup__stack-back--two"></span>
      </div>

      {stackPosts.map((entry, index) => (
        <article class="recent-post-item top-post-card" data-card-link={getPostPath(entry)} tabindex="0" role="link" aria-label={entry.data.title}>
          <a class="post_cover" href={getPostPath(entry)} title={entry.data.title}>
            <span class="recent-post-top-text">{index === 0 ? topDeck.primaryCardBadge : topDeck.secondaryCardBadge}</span>
            <img
              class="post_bg"
              src={resolveCover(entry)}
              alt={resolveCoverAlt(entry)}
              loading={index === 0 ? 'eager' : 'lazy'}
              data-fallback-src={siteConfig.post.hero.fallbackImage}
            />
          </a>
        </article>
      ))}

      {todayPost && (
        <article class="todayCard">
          <div class="todayCard__panel-label">{topDeck.panelLabel}</div>
          <a class="todayCard-link" href={getPostPath(todayPost)} aria-label={todayPost.data.title}>
            <div class="todayCard-info">
              <div class="todayCard-tips">{siteConfig.home.announcement.eyebrow}</div>
              <div class="todayCard-title">{siteConfig.home.announcement.title}</div>
              <p>{getExcerpt(todayPost, 90)}</p>
            </div>
            <img
              class="todayCard-cover"
              src={resolveCover(todayPost)}
              alt={resolveCoverAlt(todayPost)}
              loading="eager"
              data-fallback-src={siteConfig.post.hero.fallbackImage}
            />
          </a>
          <div class="banner-button-group">
            <label class="banner-button" for="today-card-toggle">
              <span class="banner-button__icon">+</span>
              <span class="banner-button-text">{topDeck.toggleLabel}</span>
            </label>
          </div>
          <div class="todayCard__footer">
            <span>{topDeck.panelFootnote}</span>
            <span>{topDeck.panelAction}</span>
          </div>
        </article>
      )}
    </div>
  </div>
</section>

<style is:global>
  /* 彻底屏蔽旧版的 ::after 幽灵线 */
  body[data-type='home'] .categoryButton::after,
  body[data-type='home'] .categoryButton::before {
    display: none !important;
    content: none !important;
  }

  /* 修正内容区对齐：居中聚拢、向左靠齐 */
  body[data-type='home'] .categoryItem-content {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: center !important; 
    padding: 8px 12px 8px 8px !important; /* 确保距离上下边界有足够距离，左侧极致贴近 */
    height: auto !important;
    box-sizing: border-box !important;
    z-index: 2 !important;
    position: relative !important;
    pointer-events: none !important;
    min-width: 0 !important;
    width: 100% !important;
    background: transparent !important;
    overflow: hidden !important; /* 防止内容撑破 */
  }

  body[data-type='home'] .categoryButton {
    display: flex !important;
    flex: 1 1 100% !important; /* Force fill parent */
    align-items: center !important;
    width: 100% !important;
    height: 100% !important;
    position: relative !important;
    text-decoration: none !important;
    padding: 0 !important;
    margin: 0 !important;
    transform: none !important;
    transition: background 0.3s ease !important;
    overflow: hidden !important;
    border-radius: 12px !important;
    max-width: none !important;
    min-width: 0 !important;
  }

  /* 分割线样式：原址替换，并推开下方的介绍文本 */
  body[data-type='home'] .categoryItem-content .divider {
    width: 24px !important;
    height: 3px !important;
    background-color: currentColor !important;
    border-radius: 2px !important;
    margin-top: 0 !important;
    margin-bottom: 2px !important; /* 介绍文本离分割线的距离 > 标题离分割线的距离 - 缩小空隙 */
    opacity: 0.8 !important;
    flex-shrink: 0 !important;
  }

  /* 标题样式：紧贴分割线 */
  body[data-type='home'] .categoryButtonText {
    font-size: 1.15rem !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    margin-bottom: 2px !important; /* 与分割线保持极近距离 */
    white-space: nowrap !important; /* 标题绝对锁定 */
    min-width: 90px !important;
    overflow: visible !important;
    width: 100% !important;
    text-align: left !important;
    display: block !important;
  }

  /* Remove any existing pseudo-element dividers */
  body[data-type='home'] .categoryButtonText::after {
    display: none !important;
  }

  /* Removing truncation */
  body[data-type='home'] .categoryButtonDesc {
    font-size: 0.85rem !important;
    opacity: 0.8 !important;
    line-height: 1.4 !important;
    width: 100% !important;
    text-align: left !important;
    white-space: normal !important;
    word-break: break-all !important;
    margin-top: 0 !important;
    height: auto !important;
    overflow: visible !important;
  }

  /* Flex/Grid Elastic Hover Interaction */
  body[data-type='home'] #bannerGroup {
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
  }

  /* 注意：严格保留对 .categoryGroup 的正确 Flex 设置，删除里面的 min-width 硬编码！ */
  body[data-type='home'] .categoryGroup {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    justify-content: flex-start !important; /* 彻底禁止浏览器在动画期间动态调节间隙 */
    gap: 0 !important; /* 彻底消除物理盲区，防止 Hover 状态在间隙中丢失 */
    margin: 0 -4px !important; /* 抵消子项的透明边框，确保外边距对齐 */
    width: 100% !important;
    height: auto !important;
    min-height: 76px !important;
    align-items: stretch !important;
    padding: 0 !important;
  }

  body[data-type='home'] .categoryItem {
    display: flex !important;
    flex: 1 1 0% !important;
    width: auto !important;
    transition: flex 1.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s ease, box-shadow 0.3s ease !important;
    overflow: hidden !important; /* 文本层级彻底防暴走 */
    border-radius: 12px !important;
    height: auto !important;
    position: relative !important;
    margin: 0 !important;
    box-sizing: border-box !important;
    min-width: 140px !important; /* 物理底线，确保标题不被挤压 */
    max-width: none !important;
    min-height: 0 !important;
    /* 核心修复：无缝感应区方案 */
    border-left: 4px solid transparent !important;
    border-right: 4px solid transparent !important;
    background-clip: padding-box !important; /* 极其重要：确保背景不渲染到透明边框下，从而伪造出 8px 视觉间隙 */
  }

  body[data-type='home'] .categoryItem:hover {
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 16px rgba(0,0,0,0.15) !important;
    z-index: 10 !important;
  }

  body[data-type='home'] .categoryGroup:hover .categoryItem:hover {
    flex: 2.5 1 0% !important; /* 适度拉伸，不再过度掠夺空间 */
  }

  body[data-type='home'] .categoryGroup:hover .categoryItem:not(:hover) {
    flex: 0.9 1 0% !important; /* 提升压缩下限 */
    opacity: 0.8 !important;
  }

  /* 挤压态下文本自适应容灾：去除省略号，实现纯净两行展示 */
  body[data-type='home'] .categoryGroup:hover .categoryItem:not(:hover) .categoryButtonDesc {
    display: block !important;
    white-space: normal !important;
    word-wrap: break-word !important;
    line-height: 1.4 !important;
    max-height: 2.8em !important; /* 精准锁定 2 行高度 (1.4 * 2) */
    overflow: hidden !important;
    font-size: 0.85em !important;
  }

  body[data-type='home'] .categoryButtonIcon {
    position: absolute !important;
    right: 8px !important;
    bottom: -15px !important;
    opacity: 0.15 !important;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s ease !important;
    z-index: 1 !important;
    width: 70px !important;
    height: 70px !important;
  }

  body[data-type='home'] .categoryItem:hover .categoryButtonIcon {
    transform: translate(-5px, -5px) rotate(-15deg) scale(1.1) !important; /* 产生相应的位移或放大反馈 */
    opacity: 0.25 !important;
  }
</style>
