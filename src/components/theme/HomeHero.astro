---
import { BookOpen, Boxes, CodeXml, Compass, type LucideIcon } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getExcerpt, getPostPath, hasPostAccess, resolveCategory, resolveCover, resolveCoverAlt } from '../../lib/content';

interface Props {
  featuredPosts: CollectionEntry<'posts'>[];
  latestPosts: CollectionEntry<'posts'>[];
}

const { featuredPosts, latestPosts } = Astro.props;

const visibleFeaturedPosts = featuredPosts.filter((entry) => !hasPostAccess(entry));
const visibleLatestPosts = latestPosts.filter((entry) => !hasPostAccess(entry));
const topPosts = (visibleFeaturedPosts.length > 0 ? visibleFeaturedPosts : visibleLatestPosts).slice(0, 6);
const todayPost = topPosts[0] ?? visibleLatestPosts[0];
const stackPosts = topPosts.slice(0, 6);
const mobileFocusPost = topPosts[0] ?? todayPost;
const categoryItems = siteConfig.home.categories.slice(0, 3);
const showcase = siteConfig.home.hero.showcase;
const showcaseTiles = [...showcase.tiles, ...showcase.tiles];
const topDeck = siteConfig.home.hero.topDeck;
const todayCardConfig = topDeck.todayCard ?? {
  tips: siteConfig.home.announcement.eyebrow,
  title: todayPost ? todayPost.data.title : siteConfig.home.announcement.title,
  href: todayPost ? getPostPath(todayPost) : siteConfig.home.announcement.href,
  cover: todayPost ? resolveCover(todayPost) : siteConfig.post.hero.fallbackImage,
  coverAlt: todayPost ? resolveCoverAlt(todayPost) : '推荐封面',
};
const isExternalTodayCard = Boolean(topDeck.todayCard?.href && /^https?:\/\//i.test(topDeck.todayCard.href));
const randomHref = siteConfig.navigation.quickActions[0]?.href ?? (latestPosts[0] ? getPostPath(latestPosts[0]) : '/archives/');
const categoryIconMap: Record<(typeof categoryItems)[number]['icon'], LucideIcon> = {
  boxes: Boxes,
  code: CodeXml,
  book: BookOpen,
  compass: Compass,
};
---

<section id="home_top" aria-label="首页重点内容">
  <input id="today-card-toggle" class="today-card-toggle" type="checkbox" aria-hidden="true" />

  <div class="home-top-notice">
    <span class="home-top-notice__label">最新动态</span>
    <p>{siteConfig.home.announcement.summary}</p>
    <a href={siteConfig.home.announcement.href} data-tooltip="更多" class="notice-more-btn" aria-label="更多">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </a>
  </div>

  <div class="swiper_container_card">
    <div id="bannerGroup">
      <a id="random-banner" href={randomHref} aria-label={siteConfig.navigation.quickActions[0]?.label ?? '随机文章'}>
        <div class="random-banner__content">
          <span class="random-banner__eyebrow">{showcase.eyebrow}</span>
          <span class="random-banner__title">
            <span>{showcase.leadTop}</span>
            <span>{showcase.leadBottom}</span>
          </span>
          <span class="random-banner__domain">{showcase.foot}</span>
        </div>

        <div id="skills-tags-group-all" aria-hidden="true">
          <div class="tags-group-wrapper">
            {showcaseTiles.map((item, index) => (
              <span class="tags-group-icon-pair" style={`--delay:${index * 0.12}s;`}>
                <span class={`tags-group-icon is-${item.accent}`}>
                  <span class="tags-group-icon__short">{item.short}</span>
                  <span class="tags-group-icon__label">{item.label}</span>
                </span>
              </span>
            ))}
          </div>
          <div class="tags-group-wrapper tags-group-wrapper--offset">
            {showcaseTiles.slice().reverse().map((item, index) => (
              <span class="tags-group-icon-pair" style={`--delay:${index * 0.1}s;`}>
                <span class={`tags-group-icon is-${item.accent}`}>
                  <span class="tags-group-icon__short">{item.short}</span>
                  <span class="tags-group-icon__label">{item.label}</span>
                </span>
              </span>
            ))}
          </div>
        </div>

        <div id="random-hover">
          <span class="random-hover__lead">
            <span class="random-hover__icon" aria-hidden="true">{topDeck.hoverMonogram}</span>
            <span class="random-hover__body">
              <span class="bannerText">
                <span class="bannerText__label">{topDeck.hoverActionLabel}</span>
                <span class="bannerText__arrow" aria-hidden="true">→</span>
              </span>
              <span class="random-hover__hint">{topDeck.hoverActionHint}</span>
            </span>
          </span>
        </div>
      </a>

        <div class="categoryGroup" aria-label="首页分类入口">
          {categoryItems.map((item) => {
            const CategoryIcon = categoryIconMap[item.icon];
            return (
              <div class="categoryItem">
                <a class={`categoryButton ${item.accent}`} href={item.href}>
                  <div class="categoryItem-content">
                    <span class="categoryButtonText">{item.label}</span>
                    <div class="divider"></div>
                    <span class="categoryButtonDesc">{item.description}</span>
                  </div>
                  <CategoryIcon className="categoryButtonIcon" aria-hidden="true" />
                </a>
              </div>
            );
          })}
        </div>

      {mobileFocusPost && (
        <article class="home-mobile-focus-card">
          <a href={getPostPath(mobileFocusPost)} title={mobileFocusPost.data.title}>
            <img
              src={resolveCover(mobileFocusPost)}
              alt={resolveCoverAlt(mobileFocusPost)}
              loading="eager"
              data-fallback-src={siteConfig.post.hero.fallbackImage}
            />
            <span class="home-mobile-focus-card__body">
              <span class="home-mobile-focus-card__title">{mobileFocusPost.data.title}</span>
            </span>
          </a>
        </article>
      )}
    </div>

    <div class="topGroup">
      <div class="topGroup__stack" aria-hidden="true">
        <span class="topGroup__stack-back topGroup__stack-back--one"></span>
        <span class="topGroup__stack-back topGroup__stack-back--two"></span>
      </div>

      {stackPosts.map((entry, index) => (
        <div class="recent-post-item" data-card-link={getPostPath(entry)}>
          <div class="post_cover left_radius">
            <a href={getPostPath(entry)} title={entry.data.title}>
              <span class="recent-post-top-text">{index === 0 ? topDeck.primaryCardBadge : topDeck.secondaryCardBadge}</span>
              <img
                class="post_bg"
                src={resolveCover(entry)}
                alt={resolveCoverAlt(entry)}
                loading={index === 0 ? 'eager' : 'lazy'}
                data-fallback-src={siteConfig.post.hero.fallbackImage}
              />
            </a>
          </div>
          <div class="recent-post-info">
            <a class="article-title" href={getPostPath(entry)} title={entry.data.title}>
              {entry.data.title}
            </a>
          </div>
        </div>
      ))}

      {todayCardConfig && (
        <article class="todayCard">
          <a
            class="todayCard-link"
            href={todayCardConfig.href}
            target={isExternalTodayCard ? '_blank' : undefined}
            rel={isExternalTodayCard ? 'noopener noreferrer' : undefined}
            aria-label={todayCardConfig.title}
          >
            <div class="todayCard-info">
              <div class="todayCard-tips">{todayCardConfig.tips}</div>
              <div class="todayCard-title">{todayCardConfig.title}</div>
            </div>
            <img
              class="todayCard-cover"
              src={todayCardConfig.cover}
              alt={todayCardConfig.coverAlt ?? todayCardConfig.title}
              loading="eager"
              data-fallback-src={siteConfig.post.hero.fallbackImage}
            />
          </a>
          <div class="banner-button-group">
            <label class="banner-button" for="today-card-toggle" aria-label={topDeck.toggleLabel}>
              <svg class="banner-button__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 16 16 12 12 8"></polyline>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
              <span class="banner-button-text">{topDeck.toggleLabel}</span>
            </label>
          </div>
        </article>
      )}
    </div>
  </div>
</section>

<style is:global>
  /* 彻底屏蔽旧版的 ::after 幽灵线 */
  body[data-type='home'] .categoryButton::after,
  body[data-type='home'] .categoryButton::before {
    display: none !important;
    content: none !important;
  }

  /* 修正内容区对齐：居中聚拢、向左靠齐 */
  body[data-type='home'] .categoryItem-content {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: center !important; 
    padding: 8px 12px 8px 8px !important; /* 确保距离上下边界有足够距离，左侧极致贴近 */
    height: auto !important;
    box-sizing: border-box !important;
    z-index: 2 !important;
    position: relative !important;
    pointer-events: none !important;
    min-width: 0 !important;
    width: 100% !important;
    background: transparent !important;
    overflow: hidden !important; /* 防止内容撑破 */
  }

  body[data-type='home'] .categoryButton {
    display: flex !important;
    flex: 1 1 100% !important; /* Force fill parent */
    align-items: center !important;
    width: 100% !important;
    height: 100% !important;
    position: relative !important;
    text-decoration: none !important;
    padding: 0 !important;
    margin: 0 !important;
    transform: none !important;
    transition: background 0.3s ease !important;
    overflow: hidden !important;
    border-radius: 12px !important;
    max-width: none !important;
    min-width: 0 !important;
  }

  /* 分割线样式：原址替换，并推开下方的介绍文本 */
  body[data-type='home'] .categoryItem-content .divider {
    width: 24px !important;
    height: 3px !important;
    background-color: currentColor !important;
    border-radius: 2px !important;
    margin-top: 0 !important;
    margin-bottom: 2px !important; /* 介绍文本离分割线的距离 > 标题离分割线的距离 - 缩小空隙 */
    opacity: 0.8 !important;
    flex-shrink: 0 !important;
  }

  /* 标题样式：紧贴分割线 */
  body[data-type='home'] .categoryButtonText {
    font-size: 1.15rem !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    margin-bottom: 2px !important; /* 与分割线保持极近距离 */
    white-space: nowrap !important; /* 标题绝对锁定 */
    min-width: 90px !important;
    overflow: visible !important;
    width: 100% !important;
    text-align: left !important;
    display: block !important;
  }

  /* Remove any existing pseudo-element dividers */
  body[data-type='home'] .categoryButtonText::after {
    display: none !important;
  }

  /* Removing truncation */
  body[data-type='home'] .categoryButtonDesc {
    font-size: 0.85rem !important;
    opacity: 0.8 !important;
    line-height: 1.4 !important;
    width: 100% !important;
    text-align: left !important;
    white-space: normal !important;
    word-break: break-all !important;
    margin-top: 0 !important;
    height: auto !important;
    overflow: visible !important;
  }

  /* Flex/Grid Elastic Hover Interaction */
  body[data-type='home'] #bannerGroup {
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 8px !important;
    box-sizing: border-box !important;
  }

  /* 注意：严格保留对 .categoryGroup 的正确 Flex 设置 */
  body[data-type='home'] .categoryGroup {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    justify-content: space-between !important;
    gap: 8px !important;
    margin: 0 !important;
    width: 100% !important;
    height: 80px !important;
    min-height: 80px !important;
    align-items: stretch !important;
    padding: 0 !important;
    box-sizing: border-box !important;
  }

  body[data-type='home'] .categoryItem {
    display: flex !important;
    flex: 1 1 0% !important;
    width: auto !important;
    /* 核心动效：纯单调平滑缓动曲线，杜绝过冲反弹，确保悬停即拉伸、解除悬停即时无延时回缩 */
    transition: flex 1.8s cubic-bezier(0.25, 1, 0.5, 1),
                transform 1.2s cubic-bezier(0.25, 1, 0.5, 1),
                box-shadow 1.2s cubic-bezier(0.25, 1, 0.5, 1) !important;
    overflow: hidden !important;
    border-radius: 12px !important;
    height: auto !important;
    position: relative !important;
    margin: 0 !important;
    box-sizing: border-box !important;
    min-width: 0 !important;
    max-width: none !important;
    min-height: 0 !important;
    border: none !important;
    background-clip: padding-box !important;
  }

  body[data-type='home'] .categoryItem:hover,
  body[data-type='home'] .categoryItem:focus-within {
    flex: 1.85 1 0% !important; /* 仅作用于当前悬停元素，其余卡片由 flexbox 自然均摊压缩，杜绝二次突变 */
    transform: translateY(-2px) !important;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.16) !important;
    z-index: 10 !important;
  }

  /* 介绍文本展示 */
  body[data-type='home'] .categoryButtonDesc {
    display: block !important;
    white-space: normal !important;
    word-wrap: break-word !important;
    line-height: 1.4 !important;
    max-height: 2.8em !important;
    overflow: hidden !important;
    font-size: 0.85em !important;
  }

  /* categoryButton & 按钮背景渐变平滑流动优化 */
  body[data-type='home'] .categoryButton {
    background-size: 200% 100% !important;
    background-position: 0% 50% !important;
    transition: background 1.8s cubic-bezier(0.25, 1, 0.5, 1),
                background-position 1.8s cubic-bezier(0.25, 1, 0.5, 1),
                transform 1.2s cubic-bezier(0.25, 1, 0.5, 1),
                box-shadow 1.2s cubic-bezier(0.25, 1, 0.5, 1) !important;
  }

  body[data-type='home'] .categoryItem:hover .categoryButton,
  body[data-type='home'] .categoryItem:focus-within .categoryButton {
    background-position: 100% 50% !important;
  }

  /* categoryButton.signal 专属视觉与阴影增强 */
  body[data-type='home'] .categoryButton.signal {
    background: linear-gradient(135deg, #358bff 0%, #15c6ff 50%, #00f0ff 100%) !important;
    background-size: 200% 100% !important;
    box-shadow: 0 8px 16px -3px rgba(40, 109, 234, 0.25), 0 2px 6px -1px rgba(21, 198, 255, 0.2) !important;
  }

  body[data-type='home'] .categoryItem:hover .categoryButton.signal,
  body[data-type='home'] .categoryItem:focus-within .categoryButton.signal {
    box-shadow: 0 14px 28px -4px rgba(40, 109, 234, 0.42), 0 6px 14px -2px rgba(21, 198, 255, 0.32) !important;
  }

  :root[data-theme='dark'] body[data-type='home'] .categoryButton.signal {
    background: linear-gradient(135deg, #0653b8 0%, #1a8cff 50%, #2fcbff 100%) !important;
    background-size: 200% 100% !important;
    box-shadow: 0 8px 18px -4px rgba(6, 83, 184, 0.45) !important;
  }

  :root[data-theme='dark'] body[data-type='home'] .categoryItem:hover .categoryButton.signal,
  :root[data-theme='dark'] body[data-type='home'] .categoryItem:focus-within .categoryButton.signal {
    box-shadow: 0 14px 30px -4px rgba(26, 140, 255, 0.55), 0 4px 12px -2px rgba(47, 203, 255, 0.35) !important;
  }

  body[data-type='home'] .categoryButtonIcon {
    position: absolute !important;
    right: 8px !important;
    bottom: -15px !important;
    opacity: 0.18 !important;
    transition: transform 1.8s cubic-bezier(0.25, 1, 0.5, 1), opacity 1.2s ease, filter 1.2s ease !important;
    z-index: 1 !important;
    width: 70px !important;
    height: 70px !important;
    filter: blur(0.5px);
  }

  body[data-type='home'] .categoryItem:hover .categoryButtonIcon,
  body[data-type='home'] .categoryItem:focus-within .categoryButtonIcon {
    transform: translate(-6px, -4px) rotate(-6deg) scale(1.08) !important;
    opacity: 0.38 !important;
    filter: blur(0);
  }

  /* topGroup 卡组尺寸与图片适配 */
  body[data-type='home'] .topGroup .recent-post-item {
    width: calc((100% - 1rem) / 3) !important;
    min-width: 0 !important;
    height: 164px !important;
    margin: 0 !important;
  }

  body[data-type='home'] .topGroup {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 0.5rem !important;
    align-content: space-between !important;
  }

  body[data-type='home'] .topGroup .recent-post-item .post_cover {
    width: 100% !important;
    height: 100px !important;
    min-height: 100px !important;
    position: relative !important;
    display: block !important;
    overflow: hidden !important;
  }

  body[data-type='home'] .topGroup .recent-post-item .post_cover a {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    position: relative !important;
  }

  body[data-type='home'] .topGroup .recent-post-item .post_cover img {
    width: 100% !important;
    height: 100% !important;
    min-height: 100px !important;
    object-fit: cover !important;
    display: block !important;
    border-radius: 18px 18px 0 0 !important;
  }

  body[data-type='home'] .topGroup .recent-post-item .recent-post-info {
    padding: 8px 10px !important;
  }

  body[data-type='home'] .topGroup .recent-post-item .article-title {
    font-size: 0.85rem !important;
    line-height: 1.3 !important;
    display: -webkit-box !important;
    -webkit-box-orient: vertical !important;
    -webkit-line-clamp: 2 !important;
    overflow: hidden !important;
  }
</style>
