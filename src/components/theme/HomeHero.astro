---
import { BookOpen, Boxes, CodeXml, Compass, type LucideIcon } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getExcerpt, getPostPath, hasPostAccess, resolveCategory, resolveCover, resolveCoverAlt } from '../../lib/content';

interface Props {
  featuredPosts: CollectionEntry<'posts'>[];
  latestPosts: CollectionEntry<'posts'>[];
}

const { featuredPosts, latestPosts } = Astro.props;

const visibleFeaturedPosts = featuredPosts.filter((entry) => !hasPostAccess(entry));
const visibleLatestPosts = latestPosts.filter((entry) => !hasPostAccess(entry));
// Guarantee full, balanced 6-card deck (2 rows of 3 cards)
const candidatePosts = [
  ...visibleFeaturedPosts,
  ...visibleLatestPosts.filter((p) => !visibleFeaturedPosts.some((f) => f.slug === p.slug)),
];
const stackPosts = candidatePosts.slice(0, 6);
const todayPost = stackPosts[0] ?? visibleLatestPosts[0];
const mobileFocusPost = stackPosts[0] ?? todayPost;
const categoryItems = siteConfig.home.categories.slice(0, 3);
const showcase = siteConfig.home.hero.showcase;
const showcaseTiles = [...showcase.tiles, ...showcase.tiles];
const topDeck = siteConfig.home.hero.topDeck;
const fallbackDefaultCover = siteConfig.post?.hero?.fallbackImage || '/media/shijianus/default.png';
const todayCardConfig = topDeck.todayCard ?? {
  tips: siteConfig.home.announcement.eyebrow,
  title: todayPost ? todayPost.data.title : siteConfig.home.announcement.title,
  href: todayPost ? getPostPath(todayPost) : siteConfig.home.announcement.href,
  cover: todayPost ? resolveCover(todayPost) : fallbackDefaultCover,
  coverAlt: todayPost ? resolveCoverAlt(todayPost) : '推荐封面',
};
const rawTodayCardCover = todayCardConfig?.cover;
const todayCardCover =
  rawTodayCardCover && typeof rawTodayCardCover === 'string' && rawTodayCardCover.trim().length > 0
    ? rawTodayCardCover.trim()
    : (todayPost ? resolveCover(todayPost) : fallbackDefaultCover);
const isExternalTodayCard = Boolean(todayCardConfig?.href && /^https?:\/\//i.test(todayCardConfig.href));
const randomHref = siteConfig.navigation.quickActions[0]?.href ?? (latestPosts[0] ? getPostPath(latestPosts[0]) : '/archives/');
const categoryIconMap: Record<(typeof categoryItems)[number]['icon'], LucideIcon> = {
  boxes: Boxes,
  code: CodeXml,
  book: BookOpen,
  compass: Compass,
};
---

<section id="home_top" aria-label="首页重点内容">
  <input id="today-card-toggle" class="today-card-toggle" type="checkbox" aria-hidden="true" />

  <div class="home-top-notice">
    <span class="home-top-notice__label">最新动态</span>
    <p>{siteConfig.home.announcement.summary}</p>
    <a href={siteConfig.home.announcement.href} data-tooltip="更多" class="notice-more-btn" aria-label="更多">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </a>
  </div>

  <div class="swiper_container_card">
    <div id="bannerGroup">
      <a id="random-banner" href={randomHref} aria-label={siteConfig.navigation.quickActions[0]?.label ?? '随机文章'}>
        <div class="random-banner__content">
          <span class="random-banner__eyebrow">{showcase.eyebrow}</span>
          <span class="random-banner__title">
            <span>{showcase.leadTop}</span>
            <span>{showcase.leadBottom}</span>
          </span>
          <span class="random-banner__domain">{showcase.foot}</span>
        </div>

        <div id="skills-tags-group-all" aria-hidden="true">
          <div class="tags-group-wrapper">
            {showcaseTiles.map((item, index) => (
              <span class="tags-group-icon-pair" style={`--delay:${index * 0.12}s;`}>
                <span class={`tags-group-icon is-${item.accent}`}>
                  <span class="tags-group-icon__short">{item.short}</span>
                  <span class="tags-group-icon__label">{item.label}</span>
                </span>
              </span>
            ))}
          </div>
          <div class="tags-group-wrapper tags-group-wrapper--offset">
            {showcaseTiles.slice().reverse().map((item, index) => (
              <span class="tags-group-icon-pair" style={`--delay:${index * 0.1}s;`}>
                <span class={`tags-group-icon is-${item.accent}`}>
                  <span class="tags-group-icon__short">{item.short}</span>
                  <span class="tags-group-icon__label">{item.label}</span>
                </span>
              </span>
            ))}
          </div>
        </div>

        <div id="random-hover">
          <span class="random-hover__lead">
            <span class="random-hover__icon" aria-hidden="true">{topDeck.hoverMonogram}</span>
            <span class="random-hover__body">
              <span class="bannerText">
                <span class="bannerText__label">{topDeck.hoverActionLabel}</span>
                <span class="bannerText__arrow" aria-hidden="true">→</span>
              </span>
              <span class="random-hover__hint">{topDeck.hoverActionHint}</span>
            </span>
          </span>
        </div>
      </a>

        <div class="categoryGroup" aria-label="首页分类入口">
          {categoryItems.map((item) => {
            const CategoryIcon = categoryIconMap[item.icon];
            return (
              <div class="categoryItem">
                <a class={`categoryButton ${item.accent}`} href={item.href}>
                  <div class="categoryItem-content">
                    <span class="categoryButtonText">{item.label}</span>
                    <div class="divider"></div>
                    <span class="categoryButtonDesc">{item.description}</span>
                  </div>
                  <CategoryIcon className="categoryButtonIcon" aria-hidden="true" />
                </a>
              </div>
            );
          })}
        </div>

      {mobileFocusPost && (
        <article class="home-mobile-focus-card">
          <a href={getPostPath(mobileFocusPost)} title={mobileFocusPost.data.title}>
            <img
              src={resolveCover(mobileFocusPost)}
              alt={resolveCoverAlt(mobileFocusPost)}
              loading="eager"
              decoding="async"
              data-fallback-src={fallbackDefaultCover}
              data-remote-fallback-src={siteConfig.post.hero.remoteFallbackImage || fallbackDefaultCover}
              onerror={`if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';if(!this.src.endsWith('${fallbackDefaultCover}')){this.src='${fallbackDefaultCover}';}else{this.onerror=null;}}else{this.onerror=null;}`}
            />
            <span class="home-mobile-focus-card__body">
              <span class="home-mobile-focus-card__title">{mobileFocusPost.data.title}</span>
            </span>
          </a>
        </article>
      )}
    </div>

    <div class="topGroup">
      <!-- 统一精致背板：对齐 bannerGroup 上下与 profileCard 最右侧，点击直接翻转回退今日推荐 -->
      <label
        for="today-card-toggle"
        class="topGroup__backboard"
        id="topGroup-backboard"
      ></label>

      {stackPosts.map((entry, index) => (
        <div class="recent-post-item" data-card-link={getPostPath(entry)}>
          <div class="post_cover left_radius">
            <a href={getPostPath(entry)} title={entry.data.title}>
              <span class="recent-post-top-text">{index === 0 ? topDeck.primaryCardBadge : topDeck.secondaryCardBadge}</span>
              <img
                class="post_bg"
                src={resolveCover(entry)}
                alt={resolveCoverAlt(entry)}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                data-fallback-src={fallbackDefaultCover}
                data-remote-fallback-src={siteConfig.post.hero.remoteFallbackImage || fallbackDefaultCover}
                onerror={`if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';if(!this.src.endsWith('${fallbackDefaultCover}')){this.src='${fallbackDefaultCover}';}else{this.onerror=null;}}else{this.onerror=null;}`}
              />
            </a>
          </div>
          <div class="recent-post-info">
            <a class="article-title" href={getPostPath(entry)} title={entry.data.title}>
              {entry.data.title}
            </a>
          </div>
        </div>
      ))}

      {todayCardConfig && (
        <article class="todayCard">
          <a
            class="todayCard-link"
            href={todayCardConfig.href}
            target={isExternalTodayCard ? '_blank' : undefined}
            rel={isExternalTodayCard ? 'noopener noreferrer' : undefined}
            aria-label={todayCardConfig.title}
          >
            <div class="todayCard-info">
              <div class="todayCard-tips">{todayCardConfig.tips}</div>
              <div class="todayCard-title">{todayCardConfig.title}</div>
            </div>
            <img
              class="todayCard-cover"
              src={todayCardCover}
              alt={todayCardConfig.coverAlt ?? todayCardConfig.title}
              loading="eager"
              decoding="async"
              data-fallback-src={fallbackDefaultCover}
              data-remote-fallback-src={siteConfig.post.hero.remoteFallbackImage || fallbackDefaultCover}
              onerror={`if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';if(!this.src.endsWith('${fallbackDefaultCover}')){this.src='${fallbackDefaultCover}';}else{this.onerror=null;}}else{this.onerror=null;}`}
            />
          </a>
          <div class="banner-button-group">
            <label class="banner-button" for="today-card-toggle" aria-label={topDeck.toggleLabel}>
              <svg class="banner-button__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 16 16 12 12 8"></polyline>
                <line x1="8" y1="12" x2="16" y2="12"></line>
              </svg>
              <span class="banner-button-text">{topDeck.toggleLabel}</span>
            </label>
          </div>
        </article>
      )}
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const initFlipBack = () => {
      const toggle = document.getElementById('today-card-toggle');
      const topGroup = document.querySelector('.topGroup');
      const backboard = document.getElementById('topGroup-backboard');
      if (!toggle || !topGroup) return;

      const doRollback = () => {
        if (toggle.checked) {
          toggle.checked = false;
          toggle.dispatchEvent(new Event('change', { bubbles: true }));
        }
      };

      if (backboard) {
        backboard.addEventListener('click', (e) => {
          e.preventDefault();
          doRollback();
        });
      }

      // Clicking anywhere on topGroup outside cards rolls back
      topGroup.addEventListener('click', (e) => {
        if (!e.target.closest('.recent-post-item') && !e.target.closest('.todayCard')) {
          doRollback();
        }
      });

      // Prevent card clicks from bubbling to backboard
      topGroup.querySelectorAll('.recent-post-item').forEach((card) => {
        card.addEventListener('click', (e) => {
          e.stopPropagation();
        });
      });

      // ESC key to return
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle.checked) {
          doRollback();
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFlipBack);
    } else {
      initFlipBack();
    }
    document.addEventListener('astro:page-load', initFlipBack);
  })();
</script>

<style is:global>
  /* 彻底屏蔽旧版的 ::after 幽灵线 */
  body[data-type='home'] .categoryButton::after,
  body[data-type='home'] .categoryButton::before {
    display: none !important;
    content: none !important;
  }

  /* 修正内容区对齐：居中聚拢、向左靠齐，预留呼吸间距 */
  body[data-type='home'] .categoryItem-content {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: center !important; 
    padding: 10px 14px 10px 12px !important; /* 确保距离上下边界有足够呼吸感，左右分布均衡 */
    height: 100% !important;
    box-sizing: border-box !important;
    z-index: 2 !important;
    position: relative !important;
    pointer-events: none !important;
    min-width: 0 !important;
    width: 100% !important;
    background: transparent !important;
    overflow: hidden !important; /* 防止内容撑破 */
  }

  body[data-type='home'] .categoryButton {
    display: flex !important;
    flex: 1 1 100% !important;
    height: 100% !important;
    align-items: center !important;
    position: relative !important;
    overflow: hidden !important;
    border-radius: 12px !important;
    text-decoration: none !important;
    transform: none !important;
    transition: background 0.3s ease !important;
    max-width: none !important;
    min-width: 0 !important;
  }

  /* 分割线样式：原址替换，并推开下方的介绍文本 */
  body[data-type='home'] .categoryItem-content .divider {
    width: 20px !important;
    height: 2.5px !important;
    background-color: currentColor !important;
    border-radius: 2px !important;
    margin-top: 0 !important;
    margin-bottom: 4px !important;
    opacity: 0.82 !important;
    flex-shrink: 0 !important;
  }

  /* 标题样式：精致比例，不压迫空间 */
  body[data-type='home'] .categoryButtonText {
    font-size: 1.05rem !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    margin-bottom: 3px !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    width: auto !important;
    max-width: 100% !important;
    text-align: left !important;
    display: block !important;
    letter-spacing: -0.01em !important;
  }

  /* Remove any existing pseudo-element dividers */
  body[data-type='home'] .categoryButtonText::after {
    display: none !important;
  }

  /* 介绍文本展示：优雅单行防挤压截断，溢出省略号，彻底消除折行被吞半截问题 */
  body[data-type='home'] .categoryButtonDesc {
    font-size: 0.8rem !important;
    line-height: 1.35 !important;
    opacity: 0.88 !important;
    width: 100% !important;
    max-width: 100% !important;
    text-align: left !important;
    white-space: nowrap !important;
    text-overflow: ellipsis !important;
    overflow: hidden !important;
    display: block !important;
    margin: 0 !important;
    transition: opacity 0.3s ease !important;
  }

  /* Flex/Grid Elastic Hover Interaction */
  body[data-type='home'] #bannerGroup {
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 8px !important;
    box-sizing: border-box !important;
  }

  /* 注意：严格保留对 .categoryGroup 的正确 Flex 设置，高度提升至 86px 赋予充足纵向呼吸空间 */
  body[data-type='home'] .categoryGroup {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    justify-content: space-between !important;
    gap: 8px !important;
    margin: 0 !important;
    width: 100% !important;
    height: 86px !important;
    min-height: 86px !important;
    align-items: stretch !important;
    padding: 0 !important;
    box-sizing: border-box !important;
  }

  body[data-type='home'] .categoryItem {
    display: flex !important;
    flex: 1 1 0% !important;
    width: auto !important;
    /* 核心动效：顺滑灵动缓动曲线，悬停即伸展、解除悬停即时平滑回缩 */
    transition: flex 0.65s cubic-bezier(0.25, 1, 0.5, 1),
                transform 0.35s ease,
                box-shadow 0.35s ease !important;
    overflow: hidden !important;
    border-radius: 12px !important;
    height: 100% !important;
    position: relative !important;
    margin: 0 !important;
    box-sizing: border-box !important;
    min-width: 0 !important;
    max-width: none !important;
    min-height: 0 !important;
    border: none !important;
    background-clip: padding-box !important;
  }

  body[data-type='home'] .categoryItem:hover,
  body[data-type='home'] .categoryItem:focus-within {
    flex: 1.45 1 0% !important; /* 黄金比例伸缩：悬停项获得显著展开，同时保障兄弟项充足展示空间不被过度挤压 */
    transform: translateY(-2px) !important;
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.16) !important;
    z-index: 10 !important;
  }

  /* 积雪主题下允许雪幔自然向上隆起 */
  html[data-background='snow'] body[data-type='home'] .categoryItem,
  html[data-background='snow'] body[data-type='home'] .topGroup .recent-post-item {
    overflow: visible !important;
  }

  /* categoryButton & 按钮背景渐变平滑流动优化 */
  body[data-type='home'] .categoryButton {
    background-size: 200% 100% !important;
    background-position: 0% 50% !important;
    transition: background 1.8s cubic-bezier(0.25, 1, 0.5, 1),
                background-position 1.8s cubic-bezier(0.25, 1, 0.5, 1),
                transform 1.2s cubic-bezier(0.25, 1, 0.5, 1),
                box-shadow 1.2s cubic-bezier(0.25, 1, 0.5, 1) !important;
  }

  body[data-type='home'] .categoryItem:hover .categoryButton,
  body[data-type='home'] .categoryItem:focus-within .categoryButton {
    background-position: 100% 50% !important;
  }

  /* categoryButton.signal 专属视觉与阴影增强 */
  body[data-type='home'] .categoryButton.signal {
    background: linear-gradient(135deg, #358bff 0%, #15c6ff 50%, #00f0ff 100%) !important;
    background-size: 200% 100% !important;
    box-shadow: 0 8px 16px -3px rgba(40, 109, 234, 0.25), 0 2px 6px -1px rgba(21, 198, 255, 0.2) !important;
  }

  body[data-type='home'] .categoryItem:hover .categoryButton.signal,
  body[data-type='home'] .categoryItem:focus-within .categoryButton.signal {
    box-shadow: 0 14px 28px -4px rgba(40, 109, 234, 0.42), 0 6px 14px -2px rgba(21, 198, 255, 0.32) !important;
  }

  :root[data-theme='dark'] body[data-type='home'] .categoryButton.signal {
    background: linear-gradient(135deg, #0653b8 0%, #1a8cff 50%, #2fcbff 100%) !important;
    background-size: 200% 100% !important;
    box-shadow: 0 8px 18px -4px rgba(6, 83, 184, 0.45) !important;
  }

  :root[data-theme='dark'] body[data-type='home'] .categoryItem:hover .categoryButton.signal,
  :root[data-theme='dark'] body[data-type='home'] .categoryItem:focus-within .categoryButton.signal {
    box-shadow: 0 14px 30px -4px rgba(26, 140, 255, 0.55), 0 4px 12px -2px rgba(47, 203, 255, 0.35) !important;
  }

  body[data-type='home'] .categoryButtonIcon {
    position: absolute !important;
    right: 8px !important;
    bottom: -15px !important;
    opacity: 0.18 !important;
    transition: transform 0.65s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.4s ease, filter 0.4s ease !important;
    z-index: 1 !important;
    width: 68px !important;
    height: 68px !important;
    filter: blur(0.5px);
  }

  body[data-type='home'] .categoryItem:hover .categoryButtonIcon,
  body[data-type='home'] .categoryItem:focus-within .categoryButtonIcon {
    transform: translate(-6px, -4px) rotate(-6deg) scale(1.08) !important;
    opacity: 0.38 !important;
    filter: blur(0);
  }

  /* 桌面端对齐：Swiper 与 topGroup 对齐 profileCard 最右侧，bannerGroup 与 topGroup 等高 348px */
  @media screen and (min-width: 1201px) {
    body[data-type='home'] #home_top {
      padding-right: 4px !important;
    }
    body[data-type='home'] .swiper_container_card {
      width: 1372px !important;
      max-width: 1372px !important;
      gap: 18px !important;
    }
    body[data-type='home'] #bannerGroup {
      width: 710px !important;
      height: 348px !important;
    }
    body[data-type='home'] .topGroup {
      width: 644px !important;
      height: 348px !important;
      padding: 8px !important;
      gap: 8px !important;
      box-sizing: border-box !important;
    }
  }

  /* topGroup 容器与统一背板 */
  body[data-type='home'] .topGroup {
    position: relative !important;
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    grid-template-rows: repeat(2, 1fr) !important;
    gap: 8px !important;
    height: 348px !important;
    border-radius: 16px !important;
    box-sizing: border-box !important;
    cursor: pointer !important;
  }

  /* 统一精致背板：对齐 bannerGroup 上下与 profileCard 最右侧，点击可直接翻转回退今日推荐 */
  body[data-type='home'] .topGroup__backboard {
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;
    display: block !important;
    border-radius: 16px !important;
    background: var(--card-bg) !important;
    border: 1px solid var(--card-border) !important;
    box-shadow: var(--anzhiyu-shadow-border) !important;
    cursor: pointer !important;
    transition: border-color 0.24s ease, box-shadow 0.24s ease !important;
    overflow: hidden !important;
    pointer-events: auto !important;
  }

  body[data-type='home'] .topGroup__backboard:hover {
    border-color: color-mix(in srgb, var(--theme-main) 36%, var(--card-border)) !important;
    box-shadow: 0 8px 24px -6px rgba(66, 90, 239, 0.16) !important;
  }

  /* todayCard 全覆盖并保持平齐 */
  body[data-type='home'] .topGroup .todayCard {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    border-radius: 16px !important;
    z-index: 10 !important;
    transition: opacity 0.32s cubic-bezier(0.4, 0, 0.2, 1), transform 0.32s cubic-bezier(0.4, 0, 0.2, 1) !important;
    transform-origin: center right !important;
  }

  body[data-type='home'] .today-card-toggle:checked ~ .swiper_container_card .todayCard {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: scale(0.96) !important;
  }

  body[data-type='home'] .topGroup .recent-post-item {
    position: relative !important;
    z-index: 2 !important;
    width: 100% !important;
    min-width: 0 !important;
    height: 162px !important;
    max-height: 162px !important;
    margin: 0 !important;
    border-radius: 12px !important;
    background: var(--card-bg) !important;
    border: 1px solid var(--card-border) !important;
    box-shadow: var(--anzhiyu-shadow-border) !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease !important;
    cursor: pointer !important;
  }

  body[data-type='home'] .topGroup .recent-post-item:hover {
    transform: translateY(-2px) !important;
    border-color: var(--theme-main) !important;
    box-shadow: 0 8px 16px -4px rgba(66, 90, 239, 0.2) !important;
  }

  body[data-type='home'] .topGroup .recent-post-item .post_cover {
    width: 100% !important;
    height: 92px !important;
    min-height: 92px !important;
    max-height: 92px !important;
    position: relative !important;
    display: block !important;
    overflow: hidden !important;
    flex: 0 0 92px !important;
  }

  body[data-type='home'] .topGroup .recent-post-item .post_cover a {
