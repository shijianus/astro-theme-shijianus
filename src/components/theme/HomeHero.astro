---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getExcerpt, getPostPath, resolveCategory, resolveCover, resolveCoverAlt } from '../../lib/content';

interface Props {
  featuredPosts: CollectionEntry<'posts'>[];
  latestPosts: CollectionEntry<'posts'>[];
}

const { featuredPosts, latestPosts } = Astro.props;

const topPosts = (featuredPosts.length > 0 ? featuredPosts : latestPosts).slice(0, 6);
const todayPost = topPosts[0] ?? latestPosts[0];
const categoryItems = siteConfig.home.categories.slice(0, 3);
const skillTags = [...siteConfig.home.hero.skillFlow, ...siteConfig.home.hero.chips];
const randomHref = siteConfig.navigation.quickActions[0]?.href ?? (latestPosts[0] ? getPostPath(latestPosts[0]) : '/archives/');
---

<section id="home_top" aria-label="Home highlight modules">
  <input id="today-card-toggle" class="today-card-toggle" type="checkbox" aria-hidden="true" />

  <div class="swiper_container_card">
    <div id="bannerGroup">
      <a id="random-banner" href={randomHref} aria-label={siteConfig.navigation.quickActions[0]?.label ?? '随机文章'}>
        <div id="skills-tags-group-all" aria-hidden="true">
          <div class="tags-group-wrapper">
            {skillTags.map((item, index) => (
              <span class="tags-group-icon" style={`--delay:${index * 0.12}s;`}>
                {item}
              </span>
            ))}
          </div>
          <div class="tags-group-wrapper tags-group-wrapper--offset">
            {skillTags.slice().reverse().map((item, index) => (
              <span class="tags-group-icon" style={`--delay:${index * 0.1}s;`}>
                {item}
              </span>
            ))}
          </div>
        </div>

        <span id="random-hover">
          <span class="random-hover__icon">SJ</span>
          <span class="bannerText">
            {siteConfig.navigation.quickActions[0]?.label ?? '随便逛逛'}
            <span class="bannerText__arrow">-></span>
          </span>
        </span>
      </a>

      <div class="categoryGroup" aria-label="Featured categories">
        {categoryItems.map((item) => (
          <div class="categoryItem">
            <a class={`categoryButton ${item.accent}`} href={item.href}>
              <span class="categoryButtonText">{item.label}</span>
              <span class="categoryButtonDesc">{item.description}</span>
              <span class="categoryButtonIcon">{item.label.slice(0, 2)}</span>
            </a>
          </div>
        ))}
      </div>
    </div>

    <div class="topGroup">
      {topPosts.map((entry, index) => (
        <article class="recent-post-item top-post-card">
          <a class="post_cover" href={getPostPath(entry)} title={entry.data.title}>
            <span class="recent-post-top-text">{index === 0 ? '荐' : '文'}</span>
            <img
              class="post_bg"
              src={resolveCover(entry)}
              alt={resolveCoverAlt(entry)}
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </a>
          <div class="recent-post-info">
            <a class="article-title" href={getPostPath(entry)} title={entry.data.title}>
              {entry.data.title}
            </a>
            <span class="top-post-card__meta">{resolveCategory(entry)}</span>
          </div>
        </article>
      ))}

      {todayPost && (
        <article class="todayCard">
          <a class="todayCard-link" href={getPostPath(todayPost)} aria-label={todayPost.data.title}>
            <div class="todayCard-info">
              <div class="todayCard-tips">{siteConfig.home.announcement.eyebrow}</div>
              <div class="todayCard-title">{siteConfig.home.announcement.title}</div>
              <p>{getExcerpt(todayPost, 90)}</p>
            </div>
            <img class="todayCard-cover" src={resolveCover(todayPost)} alt={resolveCoverAlt(todayPost)} loading="eager" />
          </a>
          <div class="banner-button-group">
            <label class="banner-button" for="today-card-toggle">
              <span class="banner-button__icon">+</span>
              <span class="banner-button-text">更多推荐</span>
            </label>
          </div>
        </article>
      )}
    </div>
  </div>
</section>
