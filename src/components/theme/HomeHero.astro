---
import { BookOpen, Boxes, CodeXml, Compass, type LucideIcon } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '../../config/site';
import { getExcerpt, getPostPath, hasPostAccess, resolveCategory, resolveCover, resolveCoverAlt } from '../../lib/content';

interface Props {
  featuredPosts: CollectionEntry<'posts'>[];
  latestPosts: CollectionEntry<'posts'>[];
}

const { featuredPosts, latestPosts } = Astro.props;

const visibleFeaturedPosts = featuredPosts.filter((entry) => !hasPostAccess(entry));
const visibleLatestPosts = latestPosts.filter((entry) => !hasPostAccess(entry));
// Guarantee full, balanced 6-card deck (2 rows of 3 cards)
const candidatePosts = [
  ...visibleFeaturedPosts,
  ...visibleLatestPosts.filter((p) => !visibleFeaturedPosts.some((f) => f.slug === p.slug)),
];
const stackPosts = candidatePosts.slice(0, 6);
const todayPost = stackPosts[0] ?? visibleLatestPosts[0];
const mobileFocusPost = stackPosts[0] ?? todayPost;
const categoryItems = siteConfig.home.categories.slice(0, 3);
const showcase = siteConfig.home.hero.showcase;
const showcaseTiles = [...showcase.tiles, ...showcase.tiles];
const topDeck = siteConfig.home.hero.topDeck;
const fallbackDefaultCover = siteConfig.post?.hero?.fallbackImage || '/media/shijianus/default.png';
const todayCardConfig = topDeck.todayCard ?? {
  tips: siteConfig.home.announcement.eyebrow,
  title: todayPost ? todayPost.data.title : siteConfig.home.announcement.title,
  href: todayPost ? getPostPath(todayPost) : siteConfig.home.announcement.href,
  cover: todayPost ? resolveCover(todayPost) : fallbackDefaultCover,
  coverAlt: todayPost ? resolveCoverAlt(todayPost) : '推荐封面',
};
const rawTodayCardCover = todayCardConfig?.cover;
const todayCardCover =
  rawTodayCardCover && typeof rawTodayCardCover === 'string' && rawTodayCardCover.trim().length > 0
    ? rawTodayCardCover.trim()
    : (todayPost ? resolveCover(todayPost) : fallbackDefaultCover);
const isExternalTodayCard = Boolean(todayCardConfig?.href && /^https?:\/\//i.test(todayCardConfig.href));
const randomHref = siteConfig.navigation.quickActions[0]?.href ?? (latestPosts[0] ? getPostPath(latestPosts[0]) : '/archives/');
const categoryIconMap: Record<(typeof categoryItems)[number]['icon'], LucideIcon> = {
  boxes: Boxes,
  code: CodeXml,
  book: BookOpen,
  compass: Compass,
};
---

<section id="home_top" aria-label="首页重点内容">
  <input id="today-card-toggle" class="today-card-toggle" type="checkbox" aria-hidden="true" />

  <div class="home-top-notice">
    <span class="home-top-notice__label">最新动态</span>
    <p>{siteConfig.home.announcement.summary}</p>
    <a href={siteConfig.home.announcement.href} data-tooltip="更多" class="notice-more-btn" aria-label="更多">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </a>
  </div>

  <div class="swiper_container_card">
    <div id="bannerGroup">
      <a id="random-banner" href={randomHref} aria-label={siteConfig.navigation.quickActions[0]?.label ?? '随机文章'}>
        <div class="random-banner__content">
          <span class="random-banner__eyebrow">{showcase.eyebrow}</span>
          <span class="random-banner__title">
            <span>{showcase.leadTop}</span>
            <span>{showcase.leadBottom}</span>
          </span>
          <span class="random-banner__domain">{showcase.foot}</span>
        </div>

        <div id="skills-tags-group-all" aria-hidden="true">
          <div class="tags-group-wrapper">
            {showcaseTiles.map((item, index) => (
              <span class="tags-group-icon-pair" style={`--delay:${index * 0.12}s;`}>
                <span class={`tags-group-icon is-${item.accent}`}>
                  <span class="tags-group-icon__short">{item.short}</span>
                  <span class="tags-group-icon__label">{item.label}</span>
                </span>
              </span>
            ))}
          </div>
          <div class="tags-group-wrapper tags-group-wrapper--offset">
            {showcaseTiles.slice().reverse().map((item, index) => (
              <span class="tags-group-icon-pair" style={`--delay:${index * 0.1}s;`}>
                <span class={`tags-group-icon is-${item.accent}`}>
                  <span class="tags-group-icon__short">{item.short}</span>
                  <span class="tags-group-icon__label">{item.label}</span>
                </span>
              </span>
            ))}
          </div>
        </div>

        <div id="random-hover">
          <span class="random-hover__lead">
            <span class="random-hover__icon" aria-hidden="true">{topDeck.hoverMonogram}</span>
            <span class="random-hover__body">
              <span class="bannerText">
                <span class="bannerText__label">{topDeck.hoverActionLabel}</span>
                <span class="bannerText__arrow" aria-hidden="true">→</span>
              </span>
              <span class="random-hover__hint">{topDeck.hoverActionHint}</span>
            </span>
          </span>
        </div>
      </a>

        <div class="categoryGroup" aria-label="首页分类入口">
          {categoryItems.map((item) => {
            const CategoryIcon = categoryIconMap[item.icon];
            return (
              <div class="categoryItem">
                <a class={`categoryButton ${item.accent}`} href={item.href}>
                  <div class="categoryItem-content">
                    <span class="categoryButtonText">{item.label}</span>
                    <div class="divider"></div>
                    <span class="categoryButtonDesc">{item.description}</span>
                  </div>
                  <CategoryIcon className="categoryButtonIcon" aria-hidden="true" />
                </a>
              </div>
            );
          })}
        </div>

      {mobileFocusPost && (
        <article class="home-mobile-focus-card">
          <a href={getPostPath(mobileFocusPost)} title={mobileFocusPost.data.title}>
            <img
              src={resolveCover(mobileFocusPost)}
              alt={resolveCoverAlt(mobileFocusPost)}
              loading="eager"
              decoding="async"
              data-fallback-src={fallbackDefaultCover}
              data-remote-fallback-src={siteConfig.post.hero.remoteFallbackImage || fallbackDefaultCover}
              onerror={`if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';if(!this.src.endsWith('${fallbackDefaultCover}')){this.src='${fallbackDefaultCover}';}else{this.onerror=null;}}else{this.onerror=null;}`}
            />
            <span class="home-mobile-focus-card__body">
              <span class="home-mobile-focus-card__title">{mobileFocusPost.data.title}</span>
            </span>
          </a>
        </article>
      )}
    </div>

    <div class="topGroup">
      <!-- 统一精致背板：对齐 bannerGroup 上下与 profileCard 最右侧，点击直接翻转回退今日推荐 -->
      <label
        for="today-card-toggle"
        class="topGroup__backboard"
        id="topGroup-backboard"
      ></label>

      {stackPosts.map((entry, index) => (
        <div
          class="recent-post-item"
          data-card-link={getPostPath(entry)}
          data-card-id={entry.slug || getPostPath(entry)}
          data-card-index={index}
        >
          <div class="post_cover left_radius">
            <a href={getPostPath(entry)} title={entry.data.title}>
              <span class="recent-post-top-text">{index === 0 ? topDeck.primaryCardBadge : topDeck.secondaryCardBadge}</span>
              <img
                class="post_bg"
                src={resolveCover(entry)}
                alt={resolveCoverAlt(entry)}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                data-fallback-src={fallbackDefaultCover}
                data-remote-fallback-src={siteConfig.post.hero.remoteFallbackImage || fallbackDefaultCover}
                onerror={`if(!this.dataset.fallbackApplied){this.dataset.fallbackApplied='true';if(!this.src.endsWith('${fallbackDefaultCover}')){this.src='${fallbackDefaultCover}';}else{this.onerror=null;}}else{this.onerror=null;}`}
              />
            </a>
          </div>
          <div class="recent-post-info">
            <a class="article-title" href={getPostPath(entry)} title={entry.data.title}>
              {entry.data.title}
            </a>
          </div>
        </div>
      ))}

      {todayCardConfig && (
        <article class="todayCard">
          <a
            class="todayCard-link"
            href={todayCardConfig.href}
            target={isExternalTodayCard ? '_blank' : undefined}
            rel={isExternalTodayCard ? 'noopener noreferrer' : undefined}
            aria-label={todayCardConfig.title}
          >
            <div class="todayCard-info">
              <div class="todayCard-tips">{todayCardConfig.tips}</div>
              <div class="todayCard-title">{todayCardConfig.title}</div>
            </div>
            <svg class="todayCard-cover" xmlns="http://www.w3.org/2000/svg" aria-label="hello, welcome to epocanvas" height="100%" preserveAspectRatio="xMidYMid slice" role="img" viewBox="0 0 1600 1000" width="100%">
              <defs>
                <!-- 1. 笔触四色流光渐变（核心连笔母色彩） -->
                <linearGradient gradientUnits="userSpaceOnUse" id="inkH" x1="-109.0607" x2="2395" y1="0" y2="0">
                  <stop offset="0" stop-color="#ff6a3d"/>
                  <stop offset=".35" stop-color="#ff3d9a"/>
                  <stop offset=".7" stop-color="#7a5cff"/>
                  <stop offset="1" stop-color="#18b6ff"/>
                </linearGradient>
                <linearGradient gradientUnits="userSpaceOnUse" id="ink1" x1="0" x2="15711" y1="0" y2="0">
                  <stop offset="0" stop-color="#ff6a3d"/>
                  <stop offset=".35" stop-color="#ff3d9a"/>
                  <stop offset=".7" stop-color="#7a5cff"/>
                  <stop offset="1" stop-color="#18b6ff"/>
                </linearGradient>
                <linearGradient gradientUnits="userSpaceOnUse" id="ink2" x1="0" x2="14667" y1="0" y2="0">
                  <stop offset="0" stop-color="#ff6a3d"/>
                  <stop offset=".35" stop-color="#ff3d9a"/>
                  <stop offset=".7" stop-color="#7a5cff"/>
                  <stop offset="1" stop-color="#18b6ff"/>
                </linearGradient>

                <!-- 2. 暗色模式：多层次暮光丝绸底色（暖紫 -> 暮粉 -> 深海蓝 -> 极光青） -->
                <linearGradient id="silkBaseDark" x1="0%" x2="100%" y1="0%" y2="100%">
                  <stop offset="0%" stop-color="#26133d"/>
                  <stop offset="32%" stop-color="#351852"/>
                  <stop offset="68%" stop-color="#17285c"/>
                  <stop offset="100%" stop-color="#0f385c"/>
                </linearGradient>

                <!-- 亮色模式：多层次晨曦极光轻丝绸（柔暖桃杏 -> 暮云粉霞 -> 丁香薰衣草 -> 晶莹天青） -->
                <linearGradient id="silkBaseLight" x1="0%" x2="100%" y1="0%" y2="100%">
                  <stop offset="0%" stop-color="#fff5f0"/>
                  <stop offset="32%" stop-color="#fdf0f7"/>
                  <stop offset="68%" stop-color="#eff2fe"/>
                  <stop offset="100%" stop-color="#e5f5ff"/>
                </linearGradient>

                <!-- 暗色对角环境柔光层 -->
                <radialGradient cx="18%" cy="22%" id="ambientWarmDark" r="65%">
                  <stop offset="0%" stop-color="#ff5e62" stop-opacity="0.34"/>
                  <stop offset="45%" stop-color="#b82578" stop-opacity="0.16"/>
                  <stop offset="100%" stop-color="#26133d" stop-opacity="0"/>
                </radialGradient>
                <radialGradient cx="84%" cy="78%" id="ambientCoolDark" r="68%">
                  <stop offset="0%" stop-color="#00c6ff" stop-opacity="0.32"/>
                  <stop offset="48%" stop-color="#5b38ff" stop-opacity="0.18"/>
                  <stop offset="100%" stop-color="#0f385c" stop-opacity="0"/>
                </radialGradient>
                <radialGradient cx="50%" cy="52%" id="centerStageGlowDark" r="55%">
                  <stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.24"/>
                  <stop offset="55%" stop-color="#ec4899" stop-opacity="0.09"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
                </radialGradient>

                <!-- 亮色对角环境柔光层 -->
                <radialGradient cx="18%" cy="22%" id="ambientWarmLight" r="65%">
                  <stop offset="0%" stop-color="#ff7a59" stop-opacity="0.15"/>
                  <stop offset="45%" stop-color="#ff3d9a" stop-opacity="0.08"/>
                  <stop offset="100%" stop-color="#fff5f0" stop-opacity="0"/>
                </radialGradient>
                <radialGradient cx="84%" cy="78%" id="ambientCoolLight" r="68%">
                  <stop offset="0%" stop-color="#00b4d8" stop-opacity="0.14"/>
                  <stop offset="48%" stop-color="#7a5cff" stop-opacity="0.08"/>
                  <stop offset="100%" stop-color="#e5f5ff" stop-opacity="0"/>
                </radialGradient>
                <radialGradient cx="50%" cy="52%" id="centerStageGlowLight" r="55%">
                  <stop offset="0%" stop-color="#7a5cff" stop-opacity="0.08"/>
                  <stop offset="55%" stop-color="#ec4899" stop-opacity="0.04"/>
                  <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
                </radialGradient>

                <!-- 3. 随笔触从左至右依次点亮的四色墨韵光场（与笔触四色严格对应） -->
                <radialGradient cx="50%" cy="50%" id="zoneCoral" r="50%">
                  <stop offset="0%" stop-color="#ff6a3d" stop-opacity="0.42"/>
                  <stop offset="100%" stop-color="#ff6a3d" stop-opacity="0"/>
                </radialGradient>
                <radialGradient cx="50%" cy="50%" id="zoneRose" r="50%">
                  <stop offset="0%" stop-color="#ff3d9a" stop-opacity="0.40"/>
                  <stop offset="100%" stop-color="#ff3d9a" stop-opacity="0"/>
                </radialGradient>
                <radialGradient cx="50%" cy="50%" id="zoneViolet" r="50%">
                  <stop offset="0%" stop-color="#7a5cff" stop-opacity="0.44"/>
                  <stop offset="100%" stop-color="#7a5cff" stop-opacity="0"/>
                </radialGradient>
                <radialGradient cx="50%" cy="50%" id="zoneCyan" r="50%">
                  <stop offset="0%" stop-color="#18b6ff" stop-opacity="0.42"/>
                  <stop offset="100%" stop-color="#18b6ff" stop-opacity="0"/>
                </radialGradient>

                <!-- 4. 18.4s 收尾字面高光遮罩 -->
                <linearGradient id="shimmerMaskGrad" x1="0%" x2="100%" y1="0%" y2="0%">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0"/>
                  <stop offset="25%" stop-color="#ffffff" stop-opacity="0.25"/>
                  <stop offset="50%" stop-color="#ffffff" stop-opacity="1"/>
                  <stop offset="75%" stop-color="#ffffff" stop-opacity="0.25"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
                </linearGradient>
                <mask height="1000" id="shimmerMask" maskContentUnits="userSpaceOnUse" maskUnits="userSpaceOnUse" width="1600" x="0" y="0">
                  <g transform="skewX(-22)">
                    <rect class="shimmer-sweeper" fill="url(#shimmerMaskGrad)" height="1400" width="460" x="-520" y="-200"/>
                  </g>
                </mask>

                <!-- 巨幅背景景深重影滤镜（将笔触放大模糊为背景流体光带） -->
                <filter filterUnits="userSpaceOnUse" height="1000" id="dofBlur" width="1600" x="0" y="0">
                  <feGaussianBlur stdDeviation="68"/>
                </filter>

                <!-- 贴身同轨墨晕滤镜 -->
                <filter filterUnits="userSpaceOnUse" height="1000" id="inkHalo" width="1600" x="0" y="0">
                  <feGaussianBlur stdDeviation="32"/>
                </filter>

                <!-- 笔尖追光彗星滤镜 -->
                <filter filterUnits="userSpaceOnUse" height="1000" id="cometGlow" width="1600" x="0" y="0">
                  <feGaussianBlur result="blur1" stdDeviation="5"/>
                  <feGaussianBlur result="blur2" stdDeviation="18"/>
                  <feMerge>
                    <feMergeNode in="blur2"/>
                    <feMergeNode in="blur1"/>
                    <feMergeNode in="SourceGraphic"/>
                  </feMerge>
                </filter>

                <style>
                  /* ================= 1. 随书写进程依次唤醒的背景四色光场 ================= */
                  .ink-zone {
                    opacity: 0;
                  }
                  .z-coral {
                    transform-origin: 260px 580px;
                    animation: zoneAwake 2.8s ease-out 5.1s forwards, zoneBreathe 7s ease-in-out 7.9s infinite alternate;
                  }
                  .z-rose {
                    transform-origin: 640px 560px;
                    animation: zoneAwake 2.8s ease-out 6.8s forwards, zoneBreathe 8s ease-in-out 9.6s infinite alternate-reverse;
                  }
                  .z-violet {
                    transform-origin: 1020px 620px;
                    animation: zoneAwake 2.8s ease-out 8.5s forwards, zoneBreathe 7.5s ease-in-out 11.3s infinite alternate;
                  }
                  .z-cyan {
                    transform-origin: 1380px 600px;
                    animation: zoneAwake 2.8s ease-out 10.2s forwards, zoneBreathe 8.5s ease-in-out 13.0s infinite alternate-reverse;
                  }
                  @keyframes zoneAwake {
                    0%   { opacity: 0; transform: scale(0.6); }
                    100% { opacity: 0.85; transform: scale(1); }
                  }
                  @keyframes zoneBreathe {
                    0%   { opacity: 0.85; transform: scale(1) translate(0px, 0px); }
                    100% { opacity: 1;    transform: scale(1.12) translate(25px, -20px); }
                  }

                  /* ================= 2. 笔触景深重影层（Depth-of-Field Calligraphy Echo） ================= */
                  .dof-echo {
                    filter: url(#dofBlur);
                    transform-origin: 800px 540px;
                    transform: scale(1.38) translateY(-18px);
                    pointer-events: none;
                  }

                  /* 贴合字面的同轨体积光晕 */
                  .ink-halo {
                    filter: url(#inkHalo);
                    pointer-events: none;
                    transform-origin: 800px 560px;
                    animation: haloFinale 2.2s cubic-bezier(.25, 0, .2, 1) 18.40s forwards;
                  }
                  @keyframes haloFinale {
                    0%   { opacity: 0.68; transform: scale(1); }
                    45%  { opacity: 1;    transform: scale(1.03); }
                    100% { opacity: 0.78; transform: scale(1); }
                  }

                  /* ================= 3. 核心笔触与追光彗星 ================= */
                  .h, .w, .e {
                    fill: none;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                    stroke-dasharray: 1 2;
                    stroke-dashoffset: 1;
                    visibility: hidden;
                  }
                  .h { stroke: url(#inkH); stroke-width: 127; }
                  .w { stroke: url(#ink1); stroke-width: 326; }
                  .e { stroke: url(#ink2); stroke-width: 305; }

                  .spine-overlay {
                    transform: translate(-2px, -3px);
                    pointer-events: none;
                  }

                  /* 笔尖实时追光彗星 */
                  .nib {
                    fill: none;
                    stroke: #ffffff;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                    stroke-dasharray: 0.016 2;
                    stroke-dashoffset: 0.016;
                    visibility: hidden;
                  }
                  .nh { stroke-width: 155; }
                  .nw { stroke-width: 395; }
                  .ne { stroke-width: 370; }

                  @keyframes draw {
                    0%   { stroke-dashoffset: 1; visibility: visible; }
                    100% { stroke-dashoffset: 0; visibility: visible; }
                  }
                  @keyframes nibDraw {
                    0%   { stroke-dashoffset: 0.016; opacity: 0; visibility: visible; }
                    5%   { opacity: 1; }
                    93%  { opacity: 1; }
                    100% { stroke-dashoffset: -0.984; opacity: 0; visibility: hidden; }
                  }
                  @keyframes park {
                    to { transform: translate(0px, 0px) scale(1, 1); }
                  }

                  /* ================= 4. 严格同步的匀速时间轴 (628.9 px/s) ================= */
                  /* Line 0: hello（开场居中，3.7s 平滑归位至左上角 y=235） */
                  .hello-park {
                    transform: translate(479.1px, 333.0px) scale(0.8086, 0.8086);
                    animation: park 1.2s cubic-bezier(.65, 0, .35, 1) 3.7s forwards;
                  }
                  .h1  { animation: draw    0.90s cubic-bezier(.4, 0, .4, 1) 0.40s forwards; }
                  .nh1 { animation: nibDraw 0.90s cubic-bezier(.4, 0, .4, 1) 0.40s forwards; }
                  .h2  { animation: draw    2.40s linear 1.30s forwards; }
                  .nh2 { animation: nibDraw 2.40s linear 1.30s forwards; }

                  /* Line 1: welcome to（位于画布黄金中心上行 y=520） */
                  .w1  { animation: draw    4.72s linear 5.10s forwards; }
                  .nw1 { animation: nibDraw 4.72s linear 5.10s forwards; }
                  .w2  { animation: draw    1.25s linear 9.94s forwards; }
                  .nw2 { animation: nibDraw 1.25s linear 9.94s forwards; }
                  .w3  { animation: draw    0.12s linear 11.27s forwards; }
                  .nw3 { animation: nibDraw 0.12s linear 11.27s forwards; }

                  /* Line 2: epocanvas（位于画布黄金中心下行 y=700） */
                  .e1  { animation: draw    1.67s linear 11.65s forwards; }
                  .ne1 { animation: nibDraw 1.67s linear 11.65s forwards; }
                  .e2  { animation: draw    5.01s linear 13.40s forwards; }
                  .ne2 { animation: nibDraw 5.01s linear 13.40s forwards; }

                  /* ================= 5. 18.4s 全字面流光扫掠（Shimmer Finale） ================= */
                  .shimmer-sweeper {
                    animation: shimmerPass 1.65s cubic-bezier(.22, 1, .36, 1) 18.40s forwards;
                  }
                  @keyframes shimmerPass {
                    0%   { transform: translateX(0px); }
                    100% { transform: translateX(2650px); }
                  }
                  .shimmer-flare {
                    pointer-events: none;
                  }
                  .shimmer-specular {
                    pointer-events: none;
                  }

                  /* ================= 6. 深浅色无缝自适应系统 (Theme Adaptive Matrix) ================= */
                  /* 6.1 亮色模式 (Light Mode Default) */
                  .bg-base { fill: url(#silkBaseLight); }
                  .bg-warm { fill: url(#ambientWarmLight); }
                  .bg-cool { fill: url(#ambientCoolLight); }
                  .bg-center { fill: url(#centerStageGlowLight); }
                  .ink-zone { mix-blend-mode: multiply; opacity: 0.52; }
                  .dof-echo { opacity: 0.12; mix-blend-mode: multiply; }
                  .ink-halo { opacity: 0.28; mix-blend-mode: multiply; }
                  .stroke-shadow { filter: drop-shadow(0px 8px 20px rgba(66, 90, 239, 0.20)); }
                  .spine-overlay { opacity: 0.42; mix-blend-mode: overlay; }
                  .shimmer-flare { filter: url(#cometGlow) brightness(1.2) saturate(1.4); mix-blend-mode: multiply; }
                  .shimmer-specular { filter: brightness(1.8) contrast(1.2); mix-blend-mode: overlay; opacity: 0.85; }

                  /* 6.2 系统级深色模式 (OS-level Dark Mode Preference) */
                  @media (prefers-color-scheme: dark) {
                    .bg-base { fill: url(#silkBaseDark); }
                    .bg-warm { fill: url(#ambientWarmDark); }
                    .bg-cool { fill: url(#ambientCoolDark); }
                    .bg-center { fill: url(#centerStageGlowDark); }
                    .ink-zone { mix-blend-mode: screen; }
                    .dof-echo { opacity: 0.42; mix-blend-mode: screen; }
                    .ink-halo { opacity: 0.68; mix-blend-mode: screen; }
                    .stroke-shadow { filter: drop-shadow(0px 14px 26px rgba(8, 5, 20, 0.62)); }
                    .spine-overlay { opacity: 0.34; mix-blend-mode: screen; }
                    .shimmer-flare { filter: url(#cometGlow) brightness(1.9) saturate(1.4); mix-blend-mode: screen; }
                    .shimmer-specular { filter: brightness(3.2) contrast(1.5); mix-blend-mode: overlay; opacity: 0.95; }
                  }

                  /* 6.3 页面显式深色模式覆盖 (Page Attribute: data-theme="dark") */
                  :root[data-theme='dark'] .bg-base,
