<script is:inline>
  (() => {
    const copyText = async (value) => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(value);
          return true;
        }
      } catch {}

      try {
        const textarea = document.createElement('textarea');
        textarea.value = value;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.left = '-9999px';
        textarea.style.top = '0';
        document.body.appendChild(textarea);
        textarea.select();
        const copied = document.execCommand('copy');
        textarea.remove();
        return copied;
      } catch {
        return false;
      }
    };

    const escapeHtml = (str) => {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    };

    const unescapeHtml = (str) => {
      return str
        .replace(/&amp;/g, '&')
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&quot;/g, '"')
        .replace(/&#123;/g, '{')
        .replace(/&#125;/g, '}')
        .replace(/&#39;/g, "'")
        .replace(/&apos;/g, "'");
    };

    const KEYWORDS_JS = new Set([
      'import', 'export', 'from', 'default', 'as', 'const', 'let', 'var', 'function',
      'return', 'if', 'else', 'switch', 'case', 'break', 'continue', 'for', 'while',
      'do', 'try', 'catch', 'finally', 'throw', 'new', 'typeof', 'instanceof', 'in',
      'of', 'async', 'await', 'yield', 'class', 'extends', 'implements', 'interface',
      'type', 'enum', 'public', 'private', 'protected', 'readonly', 'static', 'override',
      'abstract', 'void', 'any', 'unknown', 'never', 'symbol', 'bigint', 'this', 'super'
    ]);

    const BUILTINS_JS = new Set([
      'useState', 'useEffect', 'useRef', 'useMemo', 'useCallback', 'useContext',
      'useReducer', 'useId', 'useTransition', 'useDeferredValue', 'ref', 'computed',
      'reactive', 'watch', 'watchEffect', 'onMounted', 'onUnmounted', '$state',
      '$derived', '$effect', '$props', '$bindable', 'Astro', 'console', 'document',
      'window', 'globalThis', 'Math', 'JSON', 'Promise', 'Object', 'Array', 'String',
      'Number', 'Boolean', 'RegExp', 'Date', 'Error', 'Map', 'Set', 'WeakMap',
      'WeakSet', 'Symbol', 'setTimeout', 'clearTimeout', 'setInterval', 'clearInterval',
      'fetch', 'Response', 'Request', 'Headers', 'CustomEvent', 'Event'
    ]);

    const LITERALS_JS = new Set(['true', 'false', 'null', 'undefined', 'NaN', 'Infinity']);

    const highlightBash = (code) => {
      const lines = code.split('\n');
      return lines.map((line) => {
        if (/^\s*#/.test(line)) {
          return `<span class="tok-comment">${escapeHtml(line)}</span>`;
        }

        let result = '';
        const tokenRegex = /(#[^\n]*)|("[^"\\]*(?:\\.[^"\\]*)*"|'[^'\\]*(?:\\.[^'\\]*)*')|(\$[a-zA-Z_0-9{}-]+)|(--?[a-zA-Z0-9_-]+(?:=[^\s"']*)?)|(@[a-zA-Z0-9_.-]+\/[a-zA-Z0-9_.-]+|[a-zA-Z0-9_.-]+(?=\s|$))|(\|{1,2}|&&|>>?|<|2>&1|\\|;)|(\s+)|([^\s]+)/g;

        let match;
        let isCommandPosition = true;
        let isSubcommandPosition = false;

        while ((match = tokenRegex.exec(line)) !== null) {
          const [full, comment, string, variable, flag, word, operator, space, other] = match;

          if (comment) {
            result += `<span class="tok-comment">${escapeHtml(comment)}</span>`;
          } else if (string) {
            result += `<span class="tok-string">${escapeHtml(string)}</span>`;
            isCommandPosition = false;
          } else if (variable) {
            result += `<span class="tok-var">${escapeHtml(variable)}</span>`;
            isCommandPosition = false;
          } else if (flag) {
            result += `<span class="tok-flag">${escapeHtml(flag)}</span>`;
            isCommandPosition = false;
          } else if (operator) {
            result += `<span class="tok-operator">${escapeHtml(operator)}</span>`;
            if (operator === '|' || operator === '||' || operator === '&&' || operator === ';') {
              isCommandPosition = true;
              isSubcommandPosition = false;
            }
          } else if (space) {
            result += space;
          } else if (word) {
            if (isCommandPosition) {
              result += `<span class="tok-cmd">${escapeHtml(word)}</span>`;
              isCommandPosition = false;
              if (['pnpm', 'npm', 'yarn', 'bun', 'git', 'docker', 'docker-compose', 'npx', 'wrangler', 'astro', 'cargo', 'go', 'pip', 'brew', 'apt', 'sudo', 'node'].includes(word.toLowerCase())) {
                isSubcommandPosition = true;
              }
            } else if (isSubcommandPosition) {
              if (['add', 'install', 'i', 'run', 'build', 'dev', 'start', 'preview', 'init', 'create', 'commit', 'push', 'pull', 'checkout', 'branch', 'merge', 'rebase', 'status', 'log', 'diff', 'config', 'set', 'get', 'remove', 'uninstall', 'update', 'upgrade', 'test', 'clean', 'pages', 'deploy', 'migrate', 'exec', 'ps', 'up', 'down', 'logs'].includes(word.toLowerCase())) {
                result += `<span class="tok-subcmd">${escapeHtml(word)}</span>`;
              } else if (word.startsWith('@') || word.includes('/')) {
                result += `<span class="tok-pkg">${escapeHtml(word)}</span>`;
              } else {
                result += `<span class="tok-pkg">${escapeHtml(word)}</span>`;
              }
              isSubcommandPosition = false;
            } else if (word.startsWith('@') || ['remark-math', 'rehype-katex', 'katex', 'mermaid', 'react', 'react-dom', 'lucide-react', 'tailwindcss', 'clsx', 'tailwind-merge', 'opencc-js', 'qrcode', 'maxmind'].includes(word)) {
              result += `<span class="tok-pkg">${escapeHtml(word)}</span>`;
            } else if (/^\d+$/.test(word)) {
              result += `<span class="tok-number">${escapeHtml(word)}</span>`;
            } else {
              result += `<span class="tok-arg">${escapeHtml(word)}</span>`;
            }
          } else if (other) {
            result += escapeHtml(other);
          }
        }
        return result;
      }).join('\n');
    };

    const highlightJsTsx = (code) => {
      let result = '';
      const tokenRegex = /(\/\/[^\n]*|\/\*[\s\S]*?\*\/)|(`(?:\\.|[^`\\])*`|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*')|(<\/?(?:[A-Za-z0-9_.-]+)|(?:\/>|>))|(\b\d+(?:\.\d+)?(?:e[+-]?\d+)?\b)|([a-zA-Z_$][a-zA-Z0-9_$]*)|(=>|===|!==|==|!=|<=|>=|&&|\|\||\+\+|--|\+|-|\*|\/|%|\?|:|\.\.\.|\.|,|;|\{|\}|\(|\)|\[|\]|=|<|>)/g;

      let lastIndex = 0;
      let match;

      while ((match = tokenRegex.exec(code)) !== null) {
        if (match.index > lastIndex) {
          result += escapeHtml(code.slice(lastIndex, match.index));
        }
        lastIndex = tokenRegex.lastIndex;

        const [full, comment, string, jsxTag, number, ident, punct] = match;

        if (comment) {
          result += `<span class="tok-comment">${escapeHtml(comment)}</span>`;
        } else if (string) {
          result += `<span class="tok-string">${escapeHtml(string)}</span>`;
        } else if (jsxTag) {
          if (jsxTag.startsWith('</')) {
            const tagName = jsxTag.slice(2);
            result += `&lt;/<span class="tok-tag">${escapeHtml(tagName)}</span>`;
          } else if (jsxTag.startsWith('<')) {
            const tagName = jsxTag.slice(1);
            result += `&lt;<span class="tok-tag">${escapeHtml(tagName)}</span>`;
          } else if (jsxTag === '/>') {
            result += `/<span class="tok-operator">&gt;</span>`;
          } else if (jsxTag === '>') {
            result += `&gt;`;
          }
        } else if (number) {
          result += `<span class="tok-number">${escapeHtml(number)}</span>`;
        } else if (ident) {
          if (KEYWORDS_JS.has(ident)) {
            result += `<span class="tok-keyword">${escapeHtml(ident)}</span>`;
          } else if (BUILTINS_JS.has(ident) || ident.startsWith('use') || ident.startsWith('$')) {
            result += `<span class="tok-builtin">${escapeHtml(ident)}</span>`;
          } else if (LITERALS_JS.has(ident)) {
            result += `<span class="tok-bool">${escapeHtml(ident)}</span>`;
          } else if (/^[A-Z][a-zA-Z0-9_$]*$/.test(ident)) {
            result += `<span class="tok-type">${escapeHtml(ident)}</span>`;
          } else {
            const rest = code.slice(lastIndex);
            if (/^\s*\(/.test(rest)) {
              result += `<span class="tok-function">${escapeHtml(ident)}</span>`;
            } else if (/^\s*=/.test(rest) && !/^\s*==/.test(rest) && !/^\s*=>/.test(rest)) {
              result += `<span class="tok-prop">${escapeHtml(ident)}</span>`;
            } else {
              result += `<span class="tok-var">${escapeHtml(ident)}</span>`;
            }
          }
        } else if (punct) {
          if (['=>', '===', '!==', '==', '!=', '<=', '>=', '&&', '||', '+', '-', '*', '/', '?', ':', '='].includes(punct)) {
            result += `<span class="tok-operator">${escapeHtml(punct)}</span>`;
          } else {
            result += `<span class="tok-punct">${escapeHtml(punct)}</span>`;
          }
        }
      }

      if (lastIndex < code.length) {
        result += escapeHtml(code.slice(lastIndex));
      }

      return result;
    };

    const highlightTag = (tagStr) => {
      return tagStr.replace(/(<\/?)([a-zA-Z0-9_:-]+)((?:\s+[a-zA-Z0-9_:@#.-]+(?:=(?:"[^"]*"|'[^']*'|[^\s>]+))?)*\s*)(\/?>)/g, (_, open, tag, attrs, close) => {
        let highlightedAttrs = '';
        if (attrs) {
          highlightedAttrs = attrs.replace(/([a-zA-Z0-9_:@#.-]+)(?:(=)("[^"]*"|'[^']*'|[^\s>]+))?/g, (m, attrName, eq, attrVal) => {
            let attrHtml = `<span class="tok-attr">${escapeHtml(attrName)}</span>`;
            if (eq) {
              attrHtml += `<span class="tok-operator">=</span>`;
            }
            if (attrVal) {
              attrHtml += `<span class="tok-string">${escapeHtml(attrVal)}</span>`;
            }
            return attrHtml;
          });
        }
        return `&lt;${open.includes('/') ? '/' : ''}<span class="tok-tag">${escapeHtml(tag)}</span>${highlightedAttrs}${close.includes('/') ? '/' : ''}&gt;`;
      });
    };

    const highlightHtmlVueAstro = (code) => {
      let result = '';
      if (code.startsWith('---')) {
        const secondFence = code.indexOf('---', 3);
        if (secondFence !== -1) {
          const frontmatter = code.slice(3, secondFence);
          result += `<span class="tok-keyword">---</span>\n${highlightJsTsx(frontmatter.trim())}\n<span class="tok-keyword">---</span>\n`;
          code = code.slice(secondFence + 3).trimStart();
        }
      }

      const tagRegex = /(<!--[\s\S]*?-->)|(<script[^>]*>)([\s\S]*?)(<\/script>)|(<\/?[a-zA-Z0-9_:-]+)((?:\s+[a-zA-Z0-9_:@#.-]+(?:=(?:"[^"]*"|'[^']*'|[^\s>]+))?)*\s*)(\/?>)|(\{\{[\s\S]*?\}\}|\{[a-zA-Z0-9_$.]+\})/g;

      let lastIndex = 0;
      let match;

      while ((match = tagRegex.exec(code)) !== null) {
        if (match.index > lastIndex) {
          result += escapeHtml(code.slice(lastIndex, match.index));
        }
        lastIndex = tagRegex.lastIndex;

        const [full, comment, scriptOpen, scriptBody, scriptClose, tagOpen, tagAttrs, tagClose, expr] = match;

        if (comment) {
          result += `<span class="tok-comment">${escapeHtml(comment)}</span>`;
        } else if (scriptOpen) {
          result += highlightTag(scriptOpen) + highlightJsTsx(scriptBody) + highlightTag(scriptClose);
        } else if (tagOpen) {
          result += highlightTag(tagOpen + (tagAttrs || '') + (tagClose || ''));
        } else if (expr) {
          result += `<span class="tok-expr">${highlightJsTsx(expr)}</span>`;
        }
      }

      if (lastIndex < code.length) {
        result += escapeHtml(code.slice(lastIndex));
      }

      return result;
    };

    const highlightCodeString = (rawCode, lang) => {
      const l = (lang || '').toLowerCase();
      if (l === 'bash' || l === 'sh' || l === 'zsh' || l === 'shell' || l === 'cmd' || l === 'terminal') {
        return highlightBash(rawCode);
      }
      if (l === 'tsx' || l === 'jsx' || l === 'ts' || l === 'typescript' || l === 'js' || l === 'javascript') {
        return highlightJsTsx(rawCode);
      }
      if (l === 'html' || l === 'vue' || l === 'astro' || l === 'svelte' || l === 'xml') {
        return highlightHtmlVueAstro(rawCode);
      }
      // General fallback to JS/TSX style tokenization
      return highlightJsTsx(rawCode);
    };

    const resolveCodeLang = () => {
      // 1. Article container data-lang (most specific: the article itself explicitly states its language)
      const article = document.querySelector('article[data-lang]');
      const articleLang = article?.getAttribute('data-lang')?.trim();
      if (articleLang) {
        if (articleLang.startsWith('zh-Hant') || articleLang.toLowerCase() === 'zh-hant' || articleLang === 'zh-TW' || articleLang === 'zh-HK') return 'zh-Hant';
        if (articleLang.toLowerCase() === 'zh-cn' || articleLang.toLowerCase() === 'zh') return 'zh-CN';
        const base = articleLang.split('-')[0].toLowerCase();
        if (['en', 'es', 'de', 'fr'].includes(base)) return base;
      }

      // 2. Explicit language in URL pathname
      const path = (typeof window !== 'undefined' ? window.location.pathname : '').toLowerCase();
      if (path.includes('-es/') || path.endsWith('-es') || path.includes('/es/')) return 'es';
      if (path.includes('-en/') || path.endsWith('-en') || path.includes('/en/')) return 'en';
      if (path.includes('-fr/') || path.endsWith('-fr') || path.includes('/fr/')) return 'fr';
      if (path.includes('-de/') || path.endsWith('-de') || path.includes('/de/')) return 'de';
      if (path.includes('-zh-hant') || path.includes('/zh-hant/')) return 'zh-Hant';
      const matched = path.match(/\/(en|zh-Hant|fr|es|de)(\/|$)/i);
      if (matched) return matched[1].toLowerCase() === 'zh-hant' ? 'zh-Hant' : matched[1].toLowerCase();

      // 3. Document element lang or data-locale-variant
      const docLang = (document.documentElement.lang || document.documentElement.getAttribute('data-locale-variant') || '').trim();
      if (docLang) {
        if (docLang.startsWith('zh-Hant') || docLang.toLowerCase() === 'zh-hant' || docLang === 'zh-TW' || docLang === 'zh-HK') return 'zh-Hant';
        if (docLang.toLowerCase() === 'zh-cn' || docLang.toLowerCase() === 'zh') return 'zh-CN';
        const base = docLang.split('-')[0].toLowerCase();
        if (['en', 'es', 'de', 'fr'].includes(base)) return base;
      }

      // 4. User's manual selection in localStorage (only as fallback for non-article UI)
      try {
        const stored = window.localStorage.getItem('shijianus-manual-locale-selected') ||
                       window.localStorage.getItem('shijianus-locale-variant');
        if (stored) {
          if (stored.startsWith('zh-Hant') || stored.toLowerCase() === 'zh-hant' || stored === 'zh-TW' || stored === 'zh-HK') return 'zh-Hant';
          if (stored.startsWith('zh')) return 'zh-CN';
          const base = stored.split('-')[0].toLowerCase();
          if (['en', 'es', 'de', 'fr', 'zh-hant'].includes(base)) {
            return base === 'zh-hant' ? 'zh-Hant' : base;
          }
        }
      } catch (_) {}

      return 'zh-CN';
    };

    const CODE_BLOCK_I18N = {
      'zh-CN': {
        copy: '复制',
        copyTitle: '复制代码',
        copied: '已复制',
        copiedMsg: '已复制代码块',
        failed: '失败',
        failedTitle: '复制失败',
        failedMsg: '代码复制失败',
        expand: (lines) => `展开全部代码 (${lines} 行)`,
        collapse: '收起代码',
      },
      'zh-Hant': {
        copy: '複製',
        copyTitle: '複製代碼',
        copied: '已複製',
        copiedMsg: '已複製程式碼區塊',
        failed: '失敗',
        failedTitle: '複製失敗',
        failedMsg: '程式碼複製失敗',
        expand: (lines) => `展開全部代碼 (${lines} 行)`,
        collapse: '收起代碼',
      },
      'en': {
        copy: 'Copy',
        copyTitle: 'Copy code',
        copied: 'Copied',
        copiedMsg: 'Code block copied',
        failed: 'Failed',
        failedTitle: 'Copy failed',
        failedMsg: 'Failed to copy code block',
        expand: (lines) => `Expand all code (${lines} lines)`,
        collapse: 'Collapse code',
      },
      'es': {
        copy: 'Copiar',
        copyTitle: 'Copiar código',
        copied: 'Copiado',
        copiedMsg: 'Bloque de código copiado',
        failed: 'Error',
        failedTitle: 'Error al copiar',
        failedMsg: 'Error al copiar el bloque de código',
        expand: (lines) => `Expandir todo el código (${lines} líneas)`,
        collapse: 'Contraer código',
      },
      'de': {
        copy: 'Kopieren',
        copyTitle: 'Code kopieren',
        copied: 'Kopiert',
        copiedMsg: 'Codeblock kopiert',
        failed: 'Fehler',
        failedTitle: 'Kopieren fehlgeschlagen',
        failedMsg: 'Fehler beim Kopieren des Codeblocks',
        expand: (lines) => `Gesamten Code anzeigen (${lines} Zeilen)`,
        collapse: 'Code einklappen',
      },
      'fr': {
        copy: 'Copier',
        copyTitle: 'Copier le code',
        copied: 'Copié',
        copiedMsg: 'Bloc de code copié',
        failed: 'Échec',
        failedTitle: 'Échec de la copie',
        failedMsg: 'Échec de la copie du bloc de code',
        expand: (lines) => `Développer tout le code (${lines} lignes)`,
        collapse: 'Réduire le code',
      },
    };

    const getLanguage = (pre, code) => {
      const dataLanguage = pre.dataset.language || code?.dataset.language;
      if (dataLanguage) return dataLanguage.toUpperCase();

      const className = `${pre.className} ${code?.className ?? ''}`;
      const match = className.match(/language-([a-z0-9_+-]+)/i);
      return match?.[1]?.toUpperCase() ?? 'CODE';
    };

    const attachEmbeddedCopyBtn = (pre, code) => {
      if (pre.querySelector('.embedded-code-copy-btn')) return;

      const codeLang = resolveCodeLang();
      const tCode = CODE_BLOCK_I18N[codeLang] || CODE_BLOCK_I18N['zh-CN'];

      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'embedded-code-copy-btn';
      copyBtn.title = tCode.copyTitle;
      copyBtn.innerHTML = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg><span>${tCode.copy}</span>`;

      let resetTimer = 0;
      copyBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const rawText = code?.textContent ?? pre.textContent ?? '';
        const cleanedText = rawText.replace(/^\+\s/gm, '').replace(/^-\s/gm, '');
        const copied = await copyText(cleanedText);
        window.clearTimeout(resetTimer);

        if (copied) {
          copyBtn.classList.add('copied');
          copyBtn.querySelector('span').textContent = tCode.copied;
          window.dispatchEvent(new CustomEvent('shijianus:activity', { detail: { message: tCode.copiedMsg } }));
          resetTimer = window.setTimeout(() => {
            copyBtn.classList.remove('copied');
            copyBtn.querySelector('span').textContent = tCode.copy;
          }, 1800);
        } else {
          copyBtn.classList.add('copy-failed');
          copyBtn.querySelector('span').textContent = tCode.failed;
          window.dispatchEvent(new CustomEvent('shijianus:activity', { detail: { message: tCode.failedMsg } }));
          resetTimer = window.setTimeout(() => {
            copyBtn.classList.remove('copy-failed');
            copyBtn.querySelector('span').textContent = tCode.copy;
          }, 1800);
        }
      });

      pre.appendChild(copyBtn);
    };

    const enhanceCodeBlocks = () => {
      const emitActivity = (message) => {
        window.dispatchEvent(new CustomEvent('shijianus:activity', { detail: { message } }));
      };

      document.querySelectorAll('.article-body pre').forEach((pre) => {
        if (!(pre instanceof HTMLElement)) return;
        if (pre.closest('.mermaid-diagram-wrap, .mindmap-wrapper, .mindmap-container, .katex-display')) return;

        const code = pre.querySelector('code');
        const langStr = getLanguage(pre, code);
        if (langStr === 'MERMAID' || langStr === 'MINDMAP' || langStr === 'MARKMAP') return;

        // 1. Client Syntax Highlighting for code blocks without Shiki spans
        if (code && !code.querySelector('.line, .tok-keyword, .tok-cmd, .token')) {
          const rawText = unescapeHtml(code.innerHTML || code.textContent || '');
          const highlightedHtml = highlightCodeString(rawText, langStr);
          code.innerHTML = highlightedHtml;
        }

        // 2. Embedded code blocks in tabs or dropdowns or .no-code-enhance
        const isEmbedded = pre.closest('.article-tabs__panel, .article-dropdown-panel, .no-code-enhance') || pre.classList.contains('no-code-enhance');
        if (isEmbedded) {
          attachEmbeddedCopyBtn(pre, code);
          return;
        }

        if (pre.dataset.enhanced === 'true') return;
        pre.dataset.enhanced = 'true';

        // Check diff lines in code
        if (code) {
          const lines = code.innerHTML.split('\n');
          let hasDiff = false;
          const processed = lines.map((line) => {
            if (/^\s*\+\s|^\s*\/\/\s*\[!code \+\+\]/.test(line) || line.includes('class="line inserted"')) {
              hasDiff = true;
              return `<span class="diff-add">${line.replace(/\/\/\s*\[!code \+\+\]/, '')}</span>`;
            }
            if (/^\s*-\s|^\s*\/\/\s*\[!code --\]/.test(line) || line.includes('class="line deleted"')) {
              hasDiff = true;
              return `<span class="diff-remove">${line.replace(/\/\/\s*\[!code --\]/, '')}</span>`;
            }
            return line;
          });
          if (hasDiff) {
            code.innerHTML = processed.join('\n');
          }
        }

        const shell = document.createElement('div');
        const toolbar = document.createElement('div');
        const lights = document.createElement('span');
        const metaWrap = document.createElement('div');
        const lang = document.createElement('span');
        const button = document.createElement('button');
        const buttonText = document.createElement('span');

        const codeLang = resolveCodeLang();
        const tCode = CODE_BLOCK_I18N[codeLang] || CODE_BLOCK_I18N['zh-CN'];

        shell.className = 'code-block-shell';
        toolbar.className = 'code-block-toolbar';
        lights.className = 'code-block-lights';
        metaWrap.className = 'code-block-meta';
        lang.className = 'code-block-lang';
        button.className = 'code-copy-button';
        button.type = 'button';
        button.title = tCode.copyTitle;
        button.dataset.copyState = 'idle';
        buttonText.textContent = tCode.copy;

        lights.innerHTML = '<i></i><i></i><i></i>';
        lang.textContent = langStr;
        metaWrap.append(lang);

        button.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
        button.append(buttonText);
        toolbar.append(lights, metaWrap, button);

        pre.parentNode?.insertBefore(shell, pre);

        // Long code block collapse support
        const lineCount = (code?.textContent || pre.textContent || '').split('\n').length;
        if (lineCount > 22) {
          const collapseWrap = document.createElement('div');
          collapseWrap.className = 'code-collapse-wrap';
          const mask = document.createElement('div');
          mask.className = 'code-collapse-mask';
          const expandBtn = document.createElement('button');
          expandBtn.type = 'button';
          expandBtn.className = 'code-expand-btn';
          expandBtn.innerHTML = `<span>${tCode.expand(lineCount)}</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>`;

          expandBtn.addEventListener('click', () => {
            const isExpanded = collapseWrap.classList.toggle('is-expanded');
            if (isExpanded) {
              expandBtn.innerHTML = `<span>${tCode.collapse}</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>`;
            } else {
              expandBtn.innerHTML = `<span>${tCode.expand(lineCount)}</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>`;
              shell.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          });

          mask.append(expandBtn);
          collapseWrap.append(pre, mask);
          shell.append(toolbar, collapseWrap);
        } else {
          shell.append(toolbar, pre);
        }

        let resetTimer = 0;

        button.addEventListener('click', async () => {
          const rawText = code?.textContent ?? pre.textContent ?? '';
          const cleanedText = rawText.replace(/^\+\s/gm, '').replace(/^-\s/gm, '');
          const copied = await copyText(cleanedText);
          window.clearTimeout(resetTimer);

          if (!copied) {
            button.classList.remove('copied');
            button.classList.add('copy-failed');
            button.dataset.copyState = 'error';
            button.title = tCode.failedTitle;
            buttonText.textContent = tCode.failed;
            emitActivity(tCode.failedMsg);
            resetTimer = window.setTimeout(() => {
              button.classList.remove('copy-failed');
              button.dataset.copyState = 'idle';
              button.title = tCode.copyTitle;
              buttonText.textContent = tCode.copy;
            }, 1800);
            return;
          }

          button.classList.remove('copy-failed');
          button.classList.add('copied');
          button.dataset.copyState = 'success';
          button.title = tCode.copied;
          buttonText.textContent = tCode.copied;
          emitActivity(tCode.copiedMsg);
          resetTimer = window.setTimeout(() => {
            button.classList.remove('copied');
            button.dataset.copyState = 'idle';
            button.title = tCode.copyTitle;
            buttonText.textContent = tCode.copy;
          }, 1800);
        });
      });
    };

    // Re-localize all code buttons on global locale change
    window.addEventListener('shijianus:localechange', (e) => {
      const nextLang = (e && e.detail) ? e.detail : resolveCodeLang();
      const tNext = CODE_BLOCK_I18N[nextLang] || CODE_BLOCK_I18N['zh-CN'];
      document.querySelectorAll('.code-copy-button').forEach((btn) => {
        btn.title = tNext.copyTitle;
        const textSpan = btn.querySelector('span');
        if (textSpan && btn.dataset.copyState !== 'success' && btn.dataset.copyState !== 'error') {
          textSpan.textContent = tNext.copy;
        }
      });
      document.querySelectorAll('.code-expand-btn').forEach((btn) => {
        const isExpanded = btn.closest('.code-collapse-wrap')?.classList.contains('is-expanded');
        const countMatch = btn.textContent?.match(/\d+/);
        const count = countMatch ? parseInt(countMatch[0], 10) : 30;
        const span = btn.querySelector('span');
        if (span) {
          span.textContent = isExpanded ? tNext.collapse : tNext.expand(count);
        }
      });
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', enhanceCodeBlocks, { once: true });
    } else {
      enhanceCodeBlocks();
    }
    document.addEventListener('astro:page-load', enhanceCodeBlocks);
  })();
</script>
