---
export interface OutlineItem {
  id: string;
  label: string;
}

interface Props {
  items: OutlineItem[];
  variant: 'mobile' | 'desktop';
}

const { items, variant } = Astro.props;
---

{variant === 'mobile' ? (
  <details class="status-mobile-toc" id="status-mobile-toc">
    <summary class="status-mobile-toc__summary">
      <span>文档目录 · 快速跳转（{items.length} 节）</span>
      <span aria-hidden="true">▾</span>
    </summary>
    <ol class="status-mobile-toc__list">
      {items.map((item) => (
        <li>
          <a href={`#${item.id}`} class="status-outline-link" data-outline-link={item.id}>
            {item.label}
          </a>
        </li>
      ))}
    </ol>
  </details>
) : (
  <aside class="status-doc-rail" aria-label="文档章节目录">
    <nav class="status-outline-card" aria-label="本页目录">
      <div class="status-outline-card__header">
        <span class="status-outline-card__title">本页目录</span>
        <span class="status-outline-card__progress" data-status-scroll-progress>0%</span>
      </div>
      <ol class="status-outline-list" data-status-outline-list>
        {items.map((item, idx) => (
          <li>
            <a
              href={`#${item.id}`}
              class:list={['status-outline-link', idx === 0 && 'is-active']}
              data-outline-link={item.id}
              aria-current={idx === 0 ? 'location' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ol>
      <div class="status-outline-card__actions">
        <a href="#apply-friend-link" class="status-btn status-btn--primary status-btn--sm">
          前往互链申请
        </a>
        <a href="#top" class="status-outline-top" data-status-scroll-top>
          ↑ 返回页面顶部
        </a>
      </div>
    </nav>
  </aside>
)}
