---
export interface Props {
  className?: string;
  id?: string;
}

const { className = '', id = 'center-console-button-astro' } = Astro.props;
---

<div 
  class={`shijianus-dashboard-icon ${className}`} 
  id={id}
  data-shijianus-tooltip="中控台"
>
  <button class="icon-button" aria-label="中控台">
    <div class="icon-container">
      <div class="matrix-icon">
        <span class="shape top-bar"></span>
        <span class="shape bottom-left-dot"></span>
        <span class="shape bottom-right-bar"></span>
      </div>
      <div class="close-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </div>
    </div>
  </button>
</div>

<style>
  .shijianus-dashboard-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    margin-left: 0.5rem;
    cursor: pointer;
    z-index: 50;
    transition: all 0.3s ease;
  }

  .shijianus-dashboard-icon.is-active {
    background: var(--anzhiyu-main, #4259ef);
    border-radius: 50%;
    color: white !important;
  }
  
  .icon-button {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
    cursor: pointer;
    color: inherit;
  }
  
  .icon-container {
    --icon-size: 22px;
    position: relative;
    width: var(--icon-size);
    height: var(--icon-size);
  }

  .matrix-icon, .close-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .close-icon {
    opacity: 0;
    transform: scale(0.5) rotate(-90deg);
  }

  .is-active .matrix-icon {
    opacity: 0;
    transform: scale(0.5) rotate(90deg);
  }

  .is-active .close-icon {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
  
  .shape {
    background: currentColor;
    position: absolute;
    border-radius: calc(var(--icon-size) * 0.15);
    transition: 0.5s;
    inset: 0;
    margin: auto;
    right: auto;
    width: calc(var(--icon-size) / 3);
    height: calc(var(--icon-size) / 3);
    transform: translateY(calc(var(--icon-size) / 4));
  }
  
  .top-bar {
    width: 100%;
    transform: translateY(calc(var(--icon-size) / -4));
  }
  
  .bottom-right-bar {
    left: auto;
    right: 0;
    width: calc(var(--icon-size) / 2);
  }
  
  /* Hover states */
  .shijianus-dashboard-icon:not(.is-active):hover .top-bar {
    width: calc(var(--icon-size) / 2.5);
  }
  
  .shijianus-dashboard-icon:not(.is-active):hover .bottom-left-dot {
    opacity: 0.5;
    width: calc(var(--icon-size) / 2.5);
  }
  
  .shijianus-dashboard-icon:not(.is-active):hover .bottom-right-bar {
    width: calc(var(--icon-size) / 2.5);
    height: calc(var(--icon-size) / 1.15);
    transform: none;
  }
</style>

<script>
  // Add listener for multiple instances if needed, though usually just one
  document.querySelectorAll('.shijianus-dashboard-icon').forEach((wrapper) => {
    let consoleOpen = false;
    
    // Sync state from window events
    window.addEventListener('shijianus:console-visibility', ((event: Event) => {
      const customEvent = event as CustomEvent<boolean>;
      consoleOpen = Boolean(customEvent.detail);
      if (consoleOpen) {
        wrapper.classList.add('is-active');
      } else {
        wrapper.classList.remove('is-active');
      }
    }) as EventListener);

    wrapper.addEventListener('click', (e) => {
      e.preventDefault();
      if (consoleOpen) {
        window.dispatchEvent(new CustomEvent('shijianus:close-console'));
      } else {
        window.dispatchEvent(new CustomEvent('shijianus:open-console'));
      }
    });
  });
</script>