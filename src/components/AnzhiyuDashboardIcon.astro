---
export interface Props {
  className?: string;
  id?: string;
}

const { className = '', id = 'center-console-button-astro' } = Astro.props;
---

<div 
  class={`shijianus-dashboard-icon ${className}`} 
  id={id}
  data-shijianus-tooltip="中控台"
>
  <button class="icon-button" type="button" aria-label="中控台">
    <div class="icon-container">
      <span class="shape top-bar"></span>
      <span class="shape bottom-left-dot"></span>
      <span class="shape bottom-right-bar"></span>
    </div>
  </button>
</div>

<style>
  .shijianus-dashboard-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    margin-left: 0.5rem;
    cursor: pointer;
    z-index: 50;
  }
  
  .icon-button {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
    cursor: pointer;
  }
  
  .icon-container {
    --icon-size: 22px;
    position: relative;
    width: var(--icon-size);
    height: var(--icon-size);
    transition: 1s;
  }
  
  .shape {
    background: var(--font-color, currentColor);
    position: absolute;
    border-radius: calc(var(--icon-size) * 0.15);
    transition: 0.5s;
    inset: 0;
    margin: auto;
    right: auto;
    width: calc(var(--icon-size) / 3);
    height: calc(var(--icon-size) / 3);
    transform: translateY(calc(var(--icon-size) / 4));
  }
  
  .top-bar {
    width: 100%;
    transform: translateY(calc(var(--icon-size) / -4));
  }
  
  .bottom-right-bar {
    left: auto;
    right: 0;
    width: calc(var(--icon-size) / 2);
  }
  
  /* Hover and active states - NO ROTATION! */
  .shijianus-dashboard-icon:hover .top-bar,
  .shijianus-dashboard-icon.is-active .top-bar {
    width: calc(var(--icon-size) / 2.5);
  }
  
  .shijianus-dashboard-icon:hover .bottom-left-dot,
  .shijianus-dashboard-icon.is-active .bottom-left-dot {
    opacity: 0.5;
    width: calc(var(--icon-size) / 2.5);
  }
  
  .shijianus-dashboard-icon:hover .bottom-right-bar,
  .shijianus-dashboard-icon.is-active .bottom-right-bar {
    width: calc(var(--icon-size) / 2.5);
    height: calc(var(--icon-size) / 1.15);
    transform: none; /* Reset translateY for centering */
  }

  /* Hide when console is open to prevent tooltip ghosting */
  :global(body.theme-overlay-open) .shijianus-dashboard-icon {
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>

<script>
  // Use event delegation on document to avoid timing issues with React client:idle hydration.
  // The .shijianus-dashboard-icon lives inside the SiteHeader React island which hydrates
  // asynchronously — direct querySelectorAll at DOMContentLoaded may miss it or get stale refs.
  
  let consoleOpen = false;

  // Sync console state from the visibility event broadcast by ThemeOverlays
  window.addEventListener('shijianus:console-visibility', ((event: Event) => {
    const customEvent = event as CustomEvent<boolean>;
    consoleOpen = Boolean(customEvent.detail);
    // Update all dashboard icon active states
    document.querySelectorAll('.shijianus-dashboard-icon').forEach((wrapper) => {
      if (consoleOpen) {
        wrapper.classList.add('is-active');
      } else {
        wrapper.classList.remove('is-active');
      }
    });
  }) as EventListener);

  // Use event delegation: listen on document, check if click target is inside dashboard icon
  document.addEventListener('click', (e: MouseEvent) => {
    const target = e.target as Element | null;
    if (!target) return;
    const wrapper = target.closest('.shijianus-dashboard-icon');
    if (!wrapper) return;
    e.preventDefault();
    if (consoleOpen) {
      window.dispatchEvent(new CustomEvent('shijianus:close-console'));
    } else {
      window.dispatchEvent(new CustomEvent('shijianus:open-console'));
    }
  });
</script>