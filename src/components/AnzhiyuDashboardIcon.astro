---
export interface Props {
  className?: string;
  id?: string;
}

const { className = '', id = 'center-console-button-astro' } = Astro.props;
---

<div 
  class={`anzhiyu-dashboard-icon ${className}`} 
  id={id}
  data-anzhiyu-tooltip="中控台"
>
  <button class="icon-button" aria-label="中控台">
    <div class="icon-container">
      <span class="shape top-bar"></span>
      <span class="shape mid-bar"></span>
      <span class="shape bottom-bar"></span>
    </div>
  </button>
</div>

<style>
  .anzhiyu-dashboard-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    margin-left: 0.5rem;
    cursor: pointer;
    z-index: 50;
    border-radius: var(--radius-full);
    transition: all 0.3s ease;
  }
  
  .anzhiyu-dashboard-icon:hover,
  .anzhiyu-dashboard-icon.is-active {
    background: var(--theme-main);
    color: var(--white);
  }
  
  .anzhiyu-dashboard-icon:hover .shape,
  .anzhiyu-dashboard-icon.is-active .shape {
    background: var(--white);
  }

  .icon-button {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
    cursor: pointer;
  }
  
  .icon-container {
    --icon-size: 18px;
    --stroke-width: 2px;
    position: relative;
    width: var(--icon-size);
    height: var(--icon-size);
    transition: 0.4s var(--animation-on);
  }
  
  .shape {
    background: var(--font-color, currentColor);
    position: absolute;
    border-radius: 999px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    inset: 0;
    margin: auto;
    width: 100%;
    height: var(--stroke-width);
  }
  
  .top-bar {
    transform: translateY(-6px);
  }
  
  .mid-bar {
    transform: translateY(0);
  }
  
  .bottom-bar {
    transform: translateY(6px);
  }
  
  /* Hover and active states - NO ROTATION! */
  /* Left Dots + Right Vertical Bar */
  
  .anzhiyu-dashboard-icon:hover .top-bar,
  .anzhiyu-dashboard-icon.is-active .top-bar {
    width: 4px;
    height: 4px;
    transform: translate(-6px, -5px);
    opacity: 0.7;
  }
  
  .anzhiyu-dashboard-icon:hover .mid-bar,
  .anzhiyu-dashboard-icon.is-active .mid-bar {
    width: 4px;
    height: 4px;
    transform: translate(-6px, 5px);
    opacity: 0.7;
  }
  
  .anzhiyu-dashboard-icon:hover .bottom-bar,
  .anzhiyu-dashboard-icon.is-active .bottom-bar {
    width: 3px;
    height: 100%;
    transform: translate(6px, 0);
  }

  /* Transition refinement */
  .anzhiyu-dashboard-icon:hover .icon-container {
    transform: scale(0.95);
  }
</style>

<script>
  // Add listener for multiple instances if needed, though usually just one
  document.querySelectorAll('.anzhiyu-dashboard-icon').forEach((wrapper) => {
    let consoleOpen = false;
    
    // Sync state from window events
    window.addEventListener('shijianus:console-visibility', ((event: Event) => {
      const customEvent = event as CustomEvent<boolean>;
      consoleOpen = Boolean(customEvent.detail);
      if (consoleOpen) {
        wrapper.classList.add('is-active');
      } else {
        wrapper.classList.remove('is-active');
      }
    }) as EventListener);

    wrapper.addEventListener('click', (e) => {
      e.preventDefault();
      if (consoleOpen) {
        window.dispatchEvent(new CustomEvent('shijianus:close-console'));
      } else {
        window.dispatchEvent(new CustomEvent('shijianus:open-console'));
      }
    });
  });
</script>
