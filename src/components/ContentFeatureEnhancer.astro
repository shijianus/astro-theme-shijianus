<script is:inline>
  (() => {
    const articles = document.querySelectorAll('[data-content-features]');
    if (!articles.length) return;

    const createSpoiler = (text) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'spoiler-mask';
      button.setAttribute('aria-pressed', 'false');
      button.setAttribute('aria-label', '点击显示剧透内容');
      button.textContent = text;
      button.addEventListener('click', () => {
        button.classList.add('is-visible');
        button.setAttribute('aria-pressed', 'true');
      }, { once: true });
      return button;
    };

    const createHiddenInline = (text) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'hidden-inline-lock';
      button.setAttribute('aria-label', '点击显示隐藏内容');
      button.textContent = '隐藏内容';
      button.addEventListener('click', () => {
        button.textContent = text;
        button.classList.add('is-visible');
      });
      return button;
    };

    const transformTextNode = (node) => {
      const value = node.nodeValue || '';
      const pattern = /(\|\|([^|]+)\|\|)|%%([^%]+)%%/g;
      if (!pattern.test(value)) return;
      pattern.lastIndex = 0;

      const fragment = document.createDocumentFragment();
      let lastIndex = 0;
      let match;

      while ((match = pattern.exec(value))) {
        if (match.index > lastIndex) {
          fragment.append(document.createTextNode(value.slice(lastIndex, match.index)));
        }

        if (match[2]) {
          fragment.append(createSpoiler(match[2]));
        } else {
          fragment.append(createHiddenInline(match[3] || ''));
        }

        lastIndex = pattern.lastIndex;
      }

      if (lastIndex < value.length) {
        fragment.append(document.createTextNode(value.slice(lastIndex)));
      }

      node.parentNode?.replaceChild(fragment, node);
    };

    const enhanceInlineFeatures = (article) => {
      if (article.dataset.contentEnhanced === 'true') return;
      article.dataset.contentEnhanced = 'true';

      const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          const parent = node.parentElement;
          if (!parent) return NodeFilter.FILTER_REJECT;
          if (parent.closest('pre, code, kbd, script, style, textarea, .spoiler-mask, .hidden-inline-lock, .content-access-panel')) {
            return NodeFilter.FILTER_REJECT;
          }
          return /(\|\|[^|]+\|\|)|%%[^%]+%%/.test(node.nodeValue || '')
            ? NodeFilter.FILTER_ACCEPT
            : NodeFilter.FILTER_REJECT;
        },
      });

      const nodes = [];
      while (walker.nextNode()) nodes.push(walker.currentNode);
      nodes.forEach(transformTextNode);
    };

    const enhanceArticleMedia = (article) => {
      article.querySelectorAll('img').forEach((image) => {
        if (!(image instanceof HTMLImageElement)) return;
        if (!image.loading) image.loading = 'lazy';
        image.decoding = 'async';

        image.addEventListener('error', () => {
          if (image.src.endsWith('/media/shijianus/default-cover.jpg')) return;
          image.src = '/media/shijianus/default-cover.jpg';
        }, { once: true });
      });

      article.querySelectorAll('video').forEach((video) => {
        if (!(video instanceof HTMLVideoElement)) return;
        video.controls = true;
        video.preload = video.preload || 'metadata';
        video.playsInline = true;
        if (!video.poster) video.poster = '/media/shijianus/default-cover.jpg';

        video.addEventListener('error', () => {
          if (video.poster) return;
          video.poster = '/media/shijianus/default-cover.jpg';
        }, { once: true });
      });
    };

    articles.forEach((article) => {
      if (!(article instanceof HTMLElement)) return;
      enhanceInlineFeatures(article);
      enhanceArticleMedia(article);
    });
  })();
</script>
