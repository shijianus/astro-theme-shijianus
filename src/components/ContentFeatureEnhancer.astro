---
interface Props {
  externalEncryptData?: {
    hash: string;
    hint: string;
    normalPostUrl: string;
    isEncryptedRoute: boolean;
  };
  /** Array of encrypted variant buttons (one per config with showButton:true) */
  showEncryptButtons?: Array<{
    href: string;   // full URL including /posts/ prefix
    title: string;  // article/variant title
    hint?: string;  // optional hint text
  }>;
}

const { externalEncryptData, showEncryptButtons } = Astro.props;
---
<script is:inline>
  (() => {
    // =========================================================
    // MODULE-LEVEL SINGLETON STATE
    // These are initialized ONCE and persist across Astro page
    // transitions. They must NOT be re-created on astro:page-load.
    // =========================================================
    let _modalInitialized = false;
    let _currentActiveTarget = null;
    let _modalOverlay = null;
    let _modalInput = null;
    let _modalError = null;
    let _modalHint = null;
    let _modalCard = null;
    let _modalLevelTag = null;

    // -------------------------------------------------------
    // SHA-256 — works in both secure (HTTPS/localhost) and
    // non-secure (plain HTTP) contexts.
    // crypto.subtle is only available in secure contexts;
    // we fall back to a pure-JS implementation for plain HTTP.
    // -------------------------------------------------------

    // Pure-JS SHA-256 (RFC 6234 compliant, no dependencies)
    const _sha256Pure = (() => {
      const K = new Uint32Array([
        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
      ]);
      const rotr = (x, n) => (x >>> n) | (x << (32 - n));
      return (str) => {
        const msg = new TextEncoder().encode(str);
        const len = msg.length;
        const bitLen = len * 8;
        // Pad message
        const padLen = ((len + 9 + 63) & ~63);
        const padded = new Uint8Array(padLen);
        padded.set(msg);
        padded[len] = 0x80;
        new DataView(padded.buffer).setUint32(padLen - 4, bitLen >>> 0, false);
        // Initial hash values
        let h0=0x6a09e667,h1=0xbb67ae85,h2=0x3c6ef372,h3=0xa54ff53a;
        let h4=0x510e527f,h5=0x9b05688c,h6=0x1f83d9ab,h7=0x5be0cd19;
        const w = new Uint32Array(64);
        for (let i = 0; i < padLen; i += 64) {
          const dv = new DataView(padded.buffer, i, 64);
          for (let j = 0; j < 16; j++) w[j] = dv.getUint32(j * 4, false);
          for (let j = 16; j < 64; j++) {
            const s0 = rotr(w[j-15],7) ^ rotr(w[j-15],18) ^ (w[j-15] >>> 3);
            const s1 = rotr(w[j-2],17) ^ rotr(w[j-2],19) ^ (w[j-2] >>> 10);
            w[j] = (w[j-16] + s0 + w[j-7] + s1) >>> 0;
          }
          let a=h0,b=h1,c=h2,d=h3,e=h4,f=h5,g=h6,h=h7;
          for (let j = 0; j < 64; j++) {
            const S1 = rotr(e,6) ^ rotr(e,11) ^ rotr(e,25);
            const ch = (e & f) ^ (~e & g);
            const tmp1 = (h + S1 + ch + K[j] + w[j]) >>> 0;
            const S0 = rotr(a,2) ^ rotr(a,13) ^ rotr(a,22);
            const maj = (a & b) ^ (a & c) ^ (b & c);
            const tmp2 = (S0 + maj) >>> 0;
            h=g; g=f; f=e; e=(d + tmp1) >>> 0;
            d=c; c=b; b=a; a=(tmp1 + tmp2) >>> 0;
          }
          h0=(h0+a)>>>0; h1=(h1+b)>>>0; h2=(h2+c)>>>0; h3=(h3+d)>>>0;
          h4=(h4+e)>>>0; h5=(h5+f)>>>0; h6=(h6+g)>>>0; h7=(h7+h)>>>0;
        }
        return [h0,h1,h2,h3,h4,h5,h6,h7]
          .map(v => v.toString(16).padStart(8,'0')).join('');
      };
    })();

    const computeSha256 = async (str) => {
      // Prefer Web Crypto (only available in secure contexts: HTTPS or localhost)
      if (typeof crypto !== 'undefined' && crypto.subtle && crypto.subtle.digest) {
        try {
          const enc = new TextEncoder();
          const buf = await crypto.subtle.digest('SHA-256', enc.encode(str));
          return Array.from(new Uint8Array(buf))
            .map((b) => b.toString(16).padStart(2, '0'))
            .join('');
        } catch (_) {
          // fall through to pure-JS
        }
      }
      // Fallback: pure-JS SHA-256 (works on plain HTTP / non-secure contexts)
      return _sha256Pure(str);
    };

    // -------------------------------------------------------
    // Modal initialization (runs exactly once per DOM lifetime)
    // -------------------------------------------------------
    const initModal = () => {
      if (_modalInitialized) return;
      _modalInitialized = true;

      _modalOverlay = document.querySelector('.encrypted-modal-overlay');
      if (!_modalOverlay) {
        _modalOverlay = document.createElement('div');
        _modalOverlay.className = 'encrypted-modal-overlay';
        _modalOverlay.innerHTML = `
          <div class="encrypted-modal-card">
            <div class="encrypted-modal__icon">🔐</div>
            <div class="encrypted-modal__level-tag" style="margin-bottom:0.5rem;"></div>
            <h3 class="encrypted-modal__title">验证安全访问凭证</h3>
            <p class="encrypted-modal__hint">该部分为受保护加密内容，请输入密码进行校验。</p>
            <input type="password" class="encrypted-modal__input" placeholder="输入访问密钥 / 密码" autocomplete="current-password" />
            <div class="encrypted-modal__error" style="display:none;color:#ef4444;font-size:0.84rem;font-weight:600;margin-bottom:0.8rem;">凭证校验失败，请重新输入</div>
            <div class="encrypted-modal__actions">
              <button type="button" class="encrypted-modal__cancel">取消</button>
              <button type="button" class="encrypted-modal__submit">验证并解密</button>
            </div>
          </div>
        `;
        document.body.appendChild(_modalOverlay);
      }

      _modalInput = _modalOverlay.querySelector('.encrypted-modal__input');
      _modalError = _modalOverlay.querySelector('.encrypted-modal__error');
      _modalHint = _modalOverlay.querySelector('.encrypted-modal__hint');
      _modalCard = _modalOverlay.querySelector('.encrypted-modal-card');
      _modalLevelTag = _modalOverlay.querySelector('.encrypted-modal__level-tag');
      const modalCancel = _modalOverlay.querySelector('.encrypted-modal__cancel');
      const modalSubmit = _modalOverlay.querySelector('.encrypted-modal__submit');

      const closeModal = () => {
        _modalOverlay.classList.remove('is-open');
        _modalInput.value = '';
        _modalError.style.display = 'none';
        _modalCard.classList.remove('is-shaking');
        _currentActiveTarget = null;
        // ── Restore scroll ──
        document.documentElement.classList.remove('modal-scroll-locked');
        document.body.classList.remove('modal-scroll-locked');
        document.removeEventListener('touchmove', _modalPreventTouch);
      };

      const handlePasswordSubmit = async () => {
        if (!_currentActiveTarget) return;
        const enteredPass = _modalInput.value.trim();
        if (!enteredPass) return;

        const expectedHash = _currentActiveTarget.dataset.hash;
        const fallbackPass = _currentActiveTarget.dataset.password;
        let isMatch = false;

        if (expectedHash) {
          const inputHash = await computeSha256(enteredPass);
          isMatch = inputHash.toLowerCase() === expectedHash.toLowerCase();
        } else if (fallbackPass) {
          isMatch = enteredPass === fallbackPass;
        } else {
          // Default fallback hash for shijianus2026
          const inputHash = await computeSha256(enteredPass);
          isMatch = inputHash.toLowerCase() === 'd7fb6c64b9aa44cc0c3b427edaa623369dee1a9778329801f68fdaa34b09d351';
        }

        if (isMatch) {
          const target = _currentActiveTarget;
          const isGate = target.classList.contains('article-external-decrypt-gate');
          const level = target.dataset.level || '1';

          target.classList.add('is-unlocked');
          target.classList.remove('was-relocked');

          if (isGate) {
            // Use gateId as the session key for gates
            const gateId = target.dataset.gateId;
            if (gateId) sessionStorage.setItem(`unlocked-${gateId}`, 'true');
          } else {
            // For encrypted boxes
            const boxId = target.dataset.boxId;
            if (level === '1' || level === '2') {
              if (boxId) sessionStorage.setItem(`unlocked-${boxId}`, 'true');
            }
            if (level === '2') {
              setupMaskToolbar(target);
            }
            if (level === '3') {
              // Level 3: no session persistence, auto-lock is already watching
              // (observer already attached on init — do nothing extra)
            }
          }

          closeModal();
          window.dispatchEvent(
            new CustomEvent('shijianus:activity', {
              detail: { message: `🔓 ${isGate ? '外联分段密文已解密挂载' : `${level}级加密内容已解锁`}` },
            })
          );
        } else {
          _modalError.style.display = 'block';
          _modalCard.classList.remove('is-shaking');
          void _modalCard.offsetWidth;
          _modalCard.classList.add('is-shaking');
          _modalInput.select();
        }
      };

      modalSubmit.addEventListener('click', handlePasswordSubmit);
      modalCancel.addEventListener('click', closeModal);
      _modalOverlay.addEventListener('click', (e) => {
        if (e.target === _modalOverlay) closeModal();
      });
      _modalInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') handlePasswordSubmit();
        if (e.key === 'Escape') closeModal();
      });
    };

    // ── Modal touch-scroll prevention helper ──
    const _modalPreventTouch = (e) => {
      if (_modalCard && _modalCard.contains(e.target)) return;
      e.preventDefault();
    };

    // -------------------------------------------------------
    // Helper: open modal and set active target
    // -------------------------------------------------------
    const openModal = (target, levelTag, hint) => {
      _currentActiveTarget = target;
      if (_modalHint) _modalHint.textContent = hint;
      if (_modalLevelTag) _modalLevelTag.innerHTML = levelTag;
      if (_modalError) _modalError.style.display = 'none';
      if (_modalInput) _modalInput.value = '';
      _modalOverlay.classList.add('is-open');
      // ── Lock scroll while modal is open ──
      document.documentElement.classList.add('modal-scroll-locked');
      document.body.classList.add('modal-scroll-locked');
      document.addEventListener('touchmove', _modalPreventTouch, { passive: false });
      setTimeout(() => _modalInput?.focus(), 50);
    };

    // -------------------------------------------------------
    // Helper: Mask toolbar for Level 2
    // -------------------------------------------------------
    const setupMaskToolbar = (box) => {
      const content = box.querySelector('.encrypted-box__content');
      if (!content || content.dataset.maskSetup === 'true') return;
      content.dataset.maskSetup = 'true';

      // 1. Resolve mask protection mode (default: blur)
      const maskMap = {
        blur: 'blur',
        gaussian: 'blur',
        '高斯模糊': 'blur',
        mosaic: 'mosaic',
        '马赛克': 'mosaic',
        spoiler: 'spoiler',
        '剧透': 'spoiler',
        '剧透遮罩': 'spoiler',
        reveal: 'reveal',
        none: 'reveal',
        '无': 'reveal',
        '显露': 'reveal',
        '显露正文': 'reveal'
      };
      const rawMask = (box.dataset.mask || box.dataset.maskMode || box.dataset.maskType || '').trim().toLowerCase();
      const currentMask = maskMap[rawMask] || 'blur';

      // 2. Scan if author wrote a custom toolbar in Markdown DOM
      let toolbar = content.querySelector('.encrypted-mask-toolbar');
      const hasCustomToolbar = !!toolbar;

      // 3. Resolve user selection switch (default: false unless custom toolbar or enabled)
      const allowSelect = hasCustomToolbar ||
                          box.dataset.allowSelect === 'true' ||
                          box.dataset.allowSwitch === 'true' ||
                          box.dataset.allowCustom === 'true' ||
                          box.dataset.maskSelector === 'true' ||
                          box.dataset.maskToolbar === 'true' ||
                          box.dataset.toolbar === 'true';

      // 4. Resolve whether toolbar is masked (default: true / inside masked body)
      const isToolbarMasked = !(
        box.dataset.toolbarMasked === 'false' ||
        box.dataset.maskToolbarOutside === 'true' ||
        box.dataset.toolbarOutside === 'true' ||
        box.dataset.maskToolbar === 'false'
      );

      // 5. Generate default/custom options toolbar if allowSelect is true and no HTML toolbar was found
      if (allowSelect && !toolbar) {
        const optionDefs = {
          blur: { mask: 'blur', label: '🌫️ 高斯模糊' },
          mosaic: { mask: 'mosaic', label: '🏁 马赛克' },
          spoiler: { mask: 'spoiler', label: '⬛ 剧透遮罩' },
          reveal: { mask: 'reveal', label: '👁️ 显露正文' }
        };

        let optionsToRender = ['blur', 'mosaic', 'spoiler', 'reveal'];
        if (box.dataset.maskOptions) {
          const customOpts = box.dataset.maskOptions
            .split(/[,|]/)
            .map((s) => maskMap[s.trim().toLowerCase()] || s.trim().toLowerCase())
            .filter((s) => optionDefs[s]);
          if (customOpts.length > 0) {
            optionsToRender = [...new Set(customOpts)];
          }
        }

        toolbar = document.createElement('div');
        toolbar.className = 'encrypted-mask-toolbar';
        const labelText = box.dataset.toolbarLabel || '🔒 遮罩防窥保护中：';
        const buttonsHtml = optionsToRender
          .map((opt) => {
            const def = optionDefs[opt] || { mask: opt, label: opt };
            const isActive = opt === currentMask ? ' is-active' : '';
            return `<button type="button" class="mask-btn${isActive}" data-mask="${def.mask}">${def.label}</button>`;
          })
          .join('');

        toolbar.innerHTML = `
          <span class="mask-toolbar__label">${labelText}</span>
          <div class="mask-toolbar__buttons">
            ${buttonsHtml}
          </div>
        `;
      }

      // 6. Wrap content into .encrypted-masked-body with appropriate mask class
      let body = content.querySelector('.encrypted-masked-body');
      if (!body) {
        body = document.createElement('div');
        body.className = `encrypted-masked-body mask-${currentMask}`;

        if (toolbar && !isToolbarMasked) {
          if (toolbar.parentElement === content) toolbar.remove();
          while (content.firstChild) {
            body.appendChild(content.firstChild);
          }
          content.appendChild(toolbar);
          content.appendChild(body);
        } else {
          while (content.firstChild) {
            body.appendChild(content.firstChild);
          }
          if (toolbar && body.firstChild !== toolbar) {
            body.insertBefore(toolbar, body.firstChild);
          }
          content.appendChild(body);
        }
      } else {
        body.classList.remove('mask-blur', 'mask-mosaic', 'mask-spoiler', 'mask-reveal');
        body.classList.add(`mask-${currentMask}`);
        if (toolbar) {
          if (isToolbarMasked) {
            if (toolbar.parentElement !== body || body.firstChild !== toolbar) {
              body.insertBefore(toolbar, body.firstChild);
            }
          } else {
            if (toolbar.parentElement !== content) {
              content.insertBefore(toolbar, body);
            }
          }
        }
      }

      // 7. Bind click interactions to toolbar buttons
      if (toolbar) {
        const buttons = toolbar.querySelectorAll('.mask-btn, button[data-mask]');
        let hasActive = false;
        buttons.forEach((btn) => {
          const btnMask = maskMap[(btn.dataset.mask || '').trim().toLowerCase()] || btn.dataset.mask;
          if (btnMask === currentMask) {
            btn.classList.add('is-active');
            hasActive = true;
          } else {
            btn.classList.remove('is-active');
          }
        });
        if (!hasActive && buttons.length > 0) {
          buttons[0].classList.add('is-active');
        }

        buttons.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            buttons.forEach((b) => b.classList.remove('is-active'));
            btn.classList.add('is-active');
            const rawBtnMask = (btn.dataset.mask || 'blur').trim().toLowerCase();
            const maskType = maskMap[rawBtnMask] || 'blur';
            body.className = `encrypted-masked-body mask-${maskType}`;
          });
        });
      }
    };

    // -------------------------------------------------------
    // Helper: Level 3 auto-lock observer
    // -------------------------------------------------------
    const setupLevel3AutoLock = (box) => {
      if (box.dataset.observerAttached === 'true') return;
      box.dataset.observerAttached = 'true';

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting && box.classList.contains('is-unlocked')) {
            box.classList.remove('is-unlocked');
            box.classList.add('was-relocked');
            window.dispatchEvent(
              new CustomEvent('shijianus:activity', {
                detail: { message: '🔒 3级加密内容离开视口，已自动重新上锁' },
              })
            );
          }
        });
      }, { threshold: 0.05 });

      observer.observe(box);

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden' && box.classList.contains('is-unlocked')) {
          box.classList.remove('is-unlocked');
          box.classList.add('was-relocked');
        }
      });
    };

    // -------------------------------------------------------
    // Main per-page enhancement runner
    // -------------------------------------------------------
    const initContentEnhancements = async () => {
      const articles = document.querySelectorAll('[data-content-features]');
      if (!articles.length) return;

      // 1. Spoilers and Hidden Inline Text Nodes
      const createSpoiler = (text) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'spoiler-mask';
        button.setAttribute('aria-pressed', 'false');
        button.setAttribute('aria-label', '点击显示剧透内容');
        button.textContent = text;
        button.addEventListener('click', () => {
          button.classList.add('is-visible');
          button.setAttribute('aria-pressed', 'true');
        }, { once: true });
        return button;
      };

      const createHiddenInline = (text) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'hidden-inline-lock';
        button.setAttribute('aria-label', '点击显示隐藏内容');
        button.textContent = '隐藏内容';
        button.addEventListener('click', () => {
          button.textContent = text;
          button.classList.add('is-visible');
        });
        return button;
      };

      const transformTextNodes = (article) => {
        if (article.dataset.inlineTransformed === 'true') return;
        article.dataset.inlineTransformed = 'true';

        const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            const parent = node.parentElement;
            if (!parent) return NodeFilter.FILTER_REJECT;
            if (parent.closest('pre, code, kbd, script, style, textarea, .spoiler-mask, .hidden-inline-lock, .content-access-panel, .katex')) {
              return NodeFilter.FILTER_REJECT;
            }
            return /(\|\|[^|]+\|\|)|%%[^%]+%%|==[^=]+==/.test(node.nodeValue || '')
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_REJECT;
          },
        });

        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);

        nodes.forEach((node) => {
          const value = node.nodeValue || '';
          const pattern = /(\|\|([^|]+)\|\|)|%%([^%]+)%%|==(?:(yellow|green|blue|pink|purple|orange|red|cyan):)?([^=]+)==/g;
          const fragment = document.createDocumentFragment();
          let lastIndex = 0;
          let match;

          while ((match = pattern.exec(value))) {
            if (match.index > lastIndex) {
              fragment.append(document.createTextNode(value.slice(lastIndex, match.index)));
            }
            if (match[2]) {
              fragment.append(createSpoiler(match[2]));
            } else if (match[3]) {
              fragment.append(createHiddenInline(match[3] || ''));
            } else if (match[5]) {
              const mark = document.createElement('mark');
              const color = (match[4] || 'yellow').toLowerCase();
              mark.className = `mark-${color}`;
              mark.textContent = match[5];
              fragment.append(mark);
            }
            lastIndex = pattern.lastIndex;
          }

          if (lastIndex < value.length) {
            fragment.append(document.createTextNode(value.slice(lastIndex)));
          }

          node.parentNode?.replaceChild(fragment, node);
        });
      };

      // 2. Table Responsive Wrap
      const enhanceTables = (article) => {
        article.querySelectorAll('table').forEach((table) => {
          if (table.parentElement?.classList.contains('article-table-wrap')) return;
          const wrap = document.createElement('div');
          wrap.className = 'article-table-wrap';
          table.parentNode?.insertBefore(wrap, table);
          wrap.appendChild(table);
        });
      };

      // 3. GitHub Alerts & Admonitions
      const alertIcons = {
        note: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`,
        tip: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>`,
        important: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
        warning: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
        caution: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
        danger: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`,
        success: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
        question: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
        quote: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/></svg>`,
        info: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`,
        todo: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
        bug: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="14" x="8" y="6" rx="4"/><path d="m19 7-3 2"/><path d="m5 7 3 2"/><path d="m19 19-3-2"/><path d="m5 19 3-2"/><path d="M20 13h-4"/><path d="M4 13h4"/><path d="m10 4 1 2"/><path d="m14 4-1 2"/></svg>`,
        example: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31"/><path d="M14 2v7.31"/><path d="M8.5 2h7"/><path d="M14 9.3a6.5 6.5 0 1 1-4 0"/><path d="M5.52 16h12.96"/></svg>`
      };

      const defaultTitles = {
        note: '注意 (Note)',
        tip: '提示 (Tip)',
        important: '重点 (Important)',
        warning: '警告 (Warning)',
        caution: '危险 (Caution)',
        danger: '致命 (Danger)',
        success: '成功 (Success)',
        question: '疑问 (Question)',
        quote: '引用 (Quote)',
        info: '信息 (Info)',
        todo: '待办 (Todo)',
        bug: '缺陷 (Bug)',
        example: '示例 (Example)'
      };

      const enhanceAlerts = (article) => {
        article.querySelectorAll('blockquote').forEach((bq) => {
          if (bq.dataset.alertEnhanced === 'true') return;
          const firstP = bq.querySelector('p');
          if (!firstP) return;

          const rawHtml = firstP.innerHTML.trim();
          const match = rawHtml.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION|DANGER|SUCCESS|QUESTION|QUOTE|INFO|TODO|BUG|EXAMPLE)\]([+-]?)([\s\S]*)$/i);
          if (!match) return;

          bq.dataset.alertEnhanced = 'true';
          const type = match[1].toLowerCase();
          const isCollapsible = match[2] === '-' || match[2] === '+';
          const isDefaultOpen = match[2] === '+';
          let restContent = match[3].trim();

          restContent = restContent.replace(/^(<br\s*\/?>|\n|\r)+/i, '').trim();

          let customTitle = defaultTitles[type] || type.toUpperCase();

          const strongMatch = restContent.match(/^<strong>(.*?)<\/strong>[:：\s]*(.*)/is);
          if (strongMatch) {
            customTitle = strongMatch[1].trim();
            restContent = strongMatch[2].trim();
          } else {
            const firstLineBreak = restContent.search(/<br\s*\/?>|\n/i);
            if (firstLineBreak > 0) {
              const possibleTitle = restContent.slice(0, firstLineBreak).replace(/<[^>]+>/g, '').trim();
              if (possibleTitle && possibleTitle.length < 50) {
                customTitle = possibleTitle;
                restContent = restContent.slice(firstLineBreak).replace(/^(<br\s*\/?>|\n|\r)+/i, '').trim();
              }
            }
          }

          if (restContent) {
            firstP.innerHTML = restContent;
          } else {
            firstP.remove();
          }

          const iconSvg = alertIcons[type] || alertIcons.note;

          if (isCollapsible) {
            const details = document.createElement('details');
            details.className = `admonition-details admonition-${type}`;
            if (isDefaultOpen) details.open = true;

            const summary = document.createElement('summary');
            summary.innerHTML = `<span style="display:flex;align-items:center;gap:0.5rem;">${iconSvg}<span>${customTitle}</span></span><span class="summary-icon">▶</span>`;

            const contentDiv = document.createElement('div');
            contentDiv.className = 'details-content';
            while (bq.firstChild) {
              contentDiv.appendChild(bq.firstChild);
            }

            details.append(summary, contentDiv);
            bq.parentNode?.replaceChild(details, bq);
          } else {
            const card = document.createElement('div');
            card.className = `admonition admonition-${type}`;

            const header = document.createElement('div');
            header.className = 'admonition-title';
            header.innerHTML = `${iconSvg}<span>${customTitle}</span>`;

            const contentDiv = document.createElement('div');
            contentDiv.className = 'admonition-content';
            while (bq.firstChild) {
              contentDiv.appendChild(bq.firstChild);
            }

            card.append(header, contentDiv);
            bq.parentNode?.replaceChild(card, bq);
          }
        });
      };

      // 4. Interactive Tabs
      const enhanceTabs = (article) => {
        article.querySelectorAll('.article-tabs').forEach((tabs) => {
          if (tabs.dataset.tabsBound === 'true') return;
          tabs.dataset.tabsBound = 'true';

          const buttons = tabs.querySelectorAll('.article-tabs__button');
          const panels = tabs.querySelectorAll('.article-tabs__panel');

          buttons.forEach((button, index) => {
            button.addEventListener('click', () => {
              buttons.forEach((btn) => btn.classList.remove('is-active'));
              panels.forEach((pnl) => pnl.classList.remove('is-active'));

              button.classList.add('is-active');
              if (panels[index]) {
                panels[index].classList.add('is-active');
              }
            });
          });
        });
      };

      // 4.1 Interactive Dropdown Select & Switchers
      const enhanceDropdowns = (article) => {
        article.querySelectorAll('.article-dropdown-switcher').forEach((switcher) => {
          if (switcher.dataset.dropdownBound === 'true') return;
          switcher.dataset.dropdownBound = 'true';

          const select = switcher.querySelector('select.article-select, select.dropdown-switcher__select');
          const panels = switcher.querySelectorAll('.article-dropdown-panel');
          if (!select) return;

          const updatePanels = () => {
            const val = select.value;
            panels.forEach((panel) => {
              if (panel.dataset.panel === val || panel.id === val) {
                panel.classList.add('is-active');
              } else {
                panel.classList.remove('is-active');
              }
            });
          };

          select.addEventListener('change', updatePanels);
          updatePanels();
        });

        article.querySelectorAll('.interactive-calc-select').forEach((calcWrap) => {
          if (calcWrap.dataset.calcBound === 'true') return;
          calcWrap.dataset.calcBound = 'true';
          const sel = calcWrap.querySelector('select');
          const output = calcWrap.querySelector('.calc-output-value');
          if (sel && output) {
            sel.addEventListener('change', () => {
              output.textContent = sel.options[sel.selectedIndex]?.dataset.desc || sel.value;
            });
          }
        });
      };

      // 4.2 Single-Open Accordion Groups
      const enhanceAccordionGroups = (article) => {
        article.querySelectorAll('.article-accordion-group[data-single="true"]').forEach((group) => {
          if (group.dataset.accordionBound === 'true') return;
          group.dataset.accordionBound = 'true';
          const items = group.querySelectorAll('details');
          items.forEach((item) => {
            item.addEventListener('toggle', () => {
              if (item.open) {
                items.forEach((other) => {
                  if (other !== item) other.open = false;
                });
              }
            });
          });
        });
      };

      // 4.3 Audio Player Vinyl Disc Sync
      const enhanceAudioSync = (article) => {
        article.querySelectorAll('.article-audio-card').forEach((card) => {
          if (card.dataset.audioBound === 'true') return;
          card.dataset.audioBound = 'true';
          const audio = card.querySelector('audio');
          if (!audio) return;
          audio.addEventListener('play', () => card.classList.add('is-playing'));
          audio.addEventListener('pause', () => card.classList.remove('is-playing'));
          audio.addEventListener('ended', () => card.classList.remove('is-playing'));
        });
      };

      // 5. Encrypted Boxes & External Gates
      const enhanceEncryptedBoxes = (article) => {
        // Ensure modal is initialized (singleton guard)
        initModal();

        // 5a. In-article encrypted boxes (Level 1, Level 2, Level 3)
        article.querySelectorAll('.article-encrypted-box').forEach((box, idx) => {
          if (box.dataset.encBound === 'true') return;
          box.dataset.encBound = 'true';

          const level = box.dataset.level || '1';
          const boxId = box.dataset.boxId || `enc-box-${level}-${idx}`;
          box.dataset.boxId = boxId;

          // Restore from session (Level 1 and 2 only)
          if (level !== '3' && sessionStorage.getItem(`unlocked-${boxId}`) === 'true') {
            box.classList.add('is-unlocked');
            if (level === '2') setupMaskToolbar(box);
          }

          // Level 3: always set up auto-lock observer
          if (level === '3') {
            setupLevel3AutoLock(box);
          }

          const btn = box.querySelector('.encrypted-box__btn');
          if (!btn) return;

          btn.addEventListener('click', () => {
            let levelTag = '';
            if (level === '1') {
              levelTag = '<span class="badge badge-success">🛡️ 1级加密 · 会话持久</span>';
            } else if (level === '2') {
              levelTag = '<span class="badge badge-warning">🛡️ 2级加密 · 遮罩防窥保护</span>';
            } else if (level === '3') {
              levelTag = '<span class="badge badge-danger">🛡️ 3级加密 · 视口防窥离开即锁</span>';
            }
            const hint = box.dataset.hint || '该部分为受限加密内容，请输入凭证解锁。';
            openModal(box, levelTag, hint);
          });
        });

        // 5b. External Decryption Gate (外联分段解密卡片)
        article.querySelectorAll('.article-external-decrypt-gate').forEach((gate, idx) => {
          if (gate.dataset.gateBound === 'true') return;
          gate.dataset.gateBound = 'true';

          const gateId = gate.dataset.gateId || `gate-${idx}`;
          gate.dataset.gateId = gateId;

          // Restore from session using gateId
          if (sessionStorage.getItem(`unlocked-${gateId}`) === 'true') {
            gate.classList.add('is-unlocked');
          }

          const btn = gate.querySelector('.external-gate__btn');
          if (!btn) return;

          btn.addEventListener('click', () => {
            const hint = gate.dataset.hint || '请输入外联安全分段凭证以挂载密文正文。';
            const levelTag = '<span class="badge badge-purple">🌐 外联分段安全解密</span> <span class="badge badge-cyan">端点分片存储</span>';
            openModal(gate, levelTag, hint);
          });
        });
      };

      // 6. Image Lightbox
      let lightbox = document.querySelector('.article-lightbox');
      if (!lightbox) {
        lightbox = document.createElement('div');
        lightbox.className = 'article-lightbox';
        lightbox.innerHTML = `
          <button type="button" class="article-lightbox__close" aria-label="关闭预览">✕</button>
          <div class="article-lightbox__img-wrap">
            <img class="article-lightbox__img" src="" alt="" />
          </div>
          <div class="article-lightbox__caption"></div>
        `;
        document.body.appendChild(lightbox);

        const closeBtn = lightbox.querySelector('.article-lightbox__close');
        closeBtn?.addEventListener('click', () => lightbox.classList.remove('is-open'));
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox || e.target.classList.contains('article-lightbox__img-wrap')) {
            lightbox.classList.remove('is-open');
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && lightbox.classList.contains('is-open')) {
            lightbox.classList.remove('is-open');
          }
        });
      }

      const lightboxImg = lightbox.querySelector('.article-lightbox__img');
      const lightboxCaption = lightbox.querySelector('.article-lightbox__caption');

      const enhanceLightbox = (article) => {
        article.querySelectorAll('img').forEach((img) => {
          if (img.closest('.site-header, .theme-dock, .article-lightbox, .profile-widget, .avatar-image, button')) return;
          if (img.dataset.lightboxBound === 'true') return;
          img.dataset.lightboxBound = 'true';
          img.style.cursor = 'zoom-in';
          img.addEventListener('click', () => {
            if (lightboxImg) lightboxImg.src = img.src;
            if (lightboxCaption) lightboxCaption.textContent = img.alt || img.getAttribute('title') || '';
            lightbox.classList.add('is-open');
          });
        });
      };

      // 7. Footnotes Tooltips
      let footnoteTooltip = document.querySelector('.footnote-tooltip-popover');
      if (!footnoteTooltip) {
        footnoteTooltip = document.createElement('div');
        footnoteTooltip.className = 'footnote-tooltip-popover';
        document.body.appendChild(footnoteTooltip);
      }

      const enhanceFootnotes = (article) => {
        article.querySelectorAll('sup a[href*="fn-"], sup a[href*="user-content-fn-"], a[data-footnote-ref]').forEach((ref) => {
          if (ref.dataset.footnoteBound === 'true') return;
          ref.dataset.footnoteBound = 'true';

          ref.addEventListener('mouseenter', () => {
            const href = ref.getAttribute('href');
            if (!href || !href.startsWith('#')) return;
            const targetId = href.slice(1);
            const targetEl = document.getElementById(targetId) || document.getElementById(decodeURIComponent(targetId));
            if (!targetEl) return;

            const text = targetEl.textContent?.replace(/↩.*/, '').trim() || '';
            if (!text) return;

            footnoteTooltip.textContent = text;
            const rect = ref.getBoundingClientRect();
            footnoteTooltip.style.top = `${Math.max(10, rect.top - 48)}px`;
            footnoteTooltip.style.left = `${Math.min(window.innerWidth - 330, Math.max(10, rect.left - 20))}px`;
            footnoteTooltip.classList.add('is-visible');
          });

          ref.addEventListener('mouseleave', () => {
            footnoteTooltip.classList.remove('is-visible');
          });
        });
      };

      // 8. Blur and Mosaic Toggles
      const enhanceBlurMosaic = (article) => {
        article.querySelectorAll('.blur-text, .mosaic-text').forEach((el) => {
          if (el.dataset.blurBound === 'true') return;
          el.dataset.blurBound = 'true';
          el.addEventListener('click', () => {
            el.classList.toggle('is-unblurred');
            el.classList.toggle('is-revealed');
          });
        });

        article.querySelectorAll('.blur-image-wrap').forEach((wrap) => {
          if (wrap.dataset.blurBound === 'true') return;
          wrap.dataset.blurBound = 'true';
          wrap.addEventListener('click', () => {
            wrap.classList.toggle('is-unblurred');
          });
        });

        article.querySelectorAll('.hidden-box').forEach((box) => {
          if (box.dataset.hiddenBound === 'true') return;
          box.dataset.hiddenBound = 'true';
          const toggle = box.querySelector('.hidden-box__toggle');
          toggle?.addEventListener('click', () => {
            box.classList.toggle('is-open');
          });
        });
      };

      // 9. Mermaid Diagram Renderer
      const enhanceMermaid = async (article) => {
        const mermaidPreBlocks = article.querySelectorAll('pre[data-language="mermaid"], pre:has(code.language-mermaid), pre:has(code[data-language="mermaid"]), pre.mermaid, code.language-mermaid');
        if (!mermaidPreBlocks.length) return;

        try {
          let mermaid;
          try {
            const mod = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
            mermaid = mod.default || mod;
          } catch {
            const mod = await import('mermaid');
            mermaid = mod.default || mod;
          }
          if (!mermaid) return;

          const isDark = document.documentElement.dataset.theme === 'dark';
          mermaid.initialize({
            startOnLoad: false,
            theme: isDark ? 'dark' : 'default',
            securityLevel: 'loose',
            fontFamily: 'inherit',
          });

          let counter = 0;
          for (const block of mermaidPreBlocks) {
            const pre = block.tagName === 'PRE' ? block : block.closest('pre');
            if (!pre || pre.dataset.mermaidRendered === 'true') continue;
            pre.dataset.mermaidRendered = 'true';

            const shell = pre.closest('.code-block-shell');

            const rawCode = (pre.querySelector('code')?.textContent || pre.textContent || '').trim();
            const graphId = `mermaid-svg-${Date.now()}-${counter++}`;
            const wrap = document.createElement('div');
            wrap.className = 'mermaid-diagram-wrap';

            try {
              const { svg } = await mermaid.render(graphId, rawCode);
              wrap.innerHTML = svg;
              if (shell) {
                shell.parentNode?.replaceChild(wrap, shell);
              } else {
                pre.parentNode?.replaceChild(wrap, pre);
              }
            } catch (err) {
              console.warn('Mermaid render error:', err);
            }
          }
        } catch (e) {
          console.warn('Could not load mermaid engine:', e);
        }
      };

      // Execute on all articles
      articles.forEach((article) => {
        if (!(article instanceof HTMLElement)) return;
        transformTextNodes(article);
        enhanceTables(article);
        enhanceAlerts(article);
        enhanceTabs(article);
        enhanceDropdowns(article);
        enhanceAccordionGroups(article);
        enhanceAudioSync(article);
        enhanceEncryptedBoxes(article);
        enhanceLightbox(article);
        enhanceFootnotes(article);
        enhanceBlurMosaic(article);
        enhanceMermaid(article);
      });
    };

    // -------------------------------------------------------
    // Astro page lifecycle hooks
    // On astro:page-load (view transitions), the DOM changes
    // so we re-run article enhancements, BUT the modal
    // singleton (_modalInitialized) persists across navigations
    // via the closure scope of this outer IIFE.
    //
    // However: astro:page-load replaces the DOM body, so the
    // modal overlay is destroyed! We must reset _modalInitialized
    // so it gets re-created on the new page.
    // -------------------------------------------------------
    document.addEventListener('astro:before-swap', () => {
      // Reset modal state — it will be re-created on next page
      _modalInitialized = false;
      _currentActiveTarget = null;
      _modalOverlay = null;
      _modalInput = null;
      _modalError = null;
      _modalHint = null;
      _modalCard = null;
      _modalLevelTag = null;
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContentEnhancements, { once: true });
    } else {
      initContentEnhancements();
    }
    document.addEventListener('astro:page-load', initContentEnhancements);
  })();
</script>

{/* ============================================================
    FULL-SCREEN EXTERNAL ENCRYPT GATE
    Rendered only when visiting an encrypted route URL.
    The gate is a full-viewport overlay; correct password reveals
    the article content beneath. Cancel → navigate to normal URL.
    ============================================================ */}
{externalEncryptData?.isEncryptedRoute && (
  <div
    id="ext-encrypt-gate"
    class="ext-encrypt-gate"
    data-hash={externalEncryptData.hash}
    data-hint={externalEncryptData.hint}
    data-fallback-url={externalEncryptData.normalPostUrl}
    aria-modal="true"
    role="dialog"
  >
    <div class="ext-encrypt-gate__backdrop"></div>
    <div class="ext-encrypt-gate__card">
      <div class="ext-encrypt-gate__icon">🔐</div>
      <div class="ext-encrypt-gate__badge">
        <span class="badge badge-purple">🌐 外联加密文章</span>
        <span class="badge badge-cyan">端点隔离存储</span>
      </div>
      <h2 class="ext-encrypt-gate__title">验证访问凭证</h2>
      <p class="ext-encrypt-gate__hint">{externalEncryptData.hint || '这是一篇加密文章，请输入访问密码继续阅读完整内容。'}</p>
      <div class="ext-encrypt-gate__field">
        <input
          type="password"
          id="ext-encrypt-gate__input"
          class="ext-encrypt-gate__input"
          placeholder="输入访问密钥 / 密码"
          autocomplete="current-password"
        />
      </div>
      <div class="ext-encrypt-gate__error" id="ext-encrypt-gate__error" hidden>
        凭证校验失败，请重新输入
      </div>
      <div class="ext-encrypt-gate__actions">
        <button type="button" class="ext-encrypt-gate__cancel" id="ext-encrypt-gate__cancel">
          取消，返回原文
        </button>
        <button type="button" class="ext-encrypt-gate__submit" id="ext-encrypt-gate__submit">
          🔓 验证并解密
        </button>
      </div>
      <p class="ext-encrypt-gate__footer">
        取消后将自动跳转至未加密版本
      </p>
    </div>
  </div>
  <div id="ext-encrypt-content-wrap" class="ext-encrypt-content-wrap" hidden>
    <!-- Article content is visible but this wrapper is hidden until gate passes -->
  </div>
  <script is:inline>
  // External encrypt gate client-side logic
  (() => {
    // Reuse the pure-JS SHA-256 from ContentFeatureEnhancer (already defined in this page)
    // It's available as window._sha256Pure if we expose it — but since that IIFE runs first,
    // we define a local version here for the gate.
    const _gateSha256Pure = (() => {
      const K = new Uint32Array([
        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2
      ]);
      const rotr = (x, n) => (x >>> n) | (x << (32 - n));
      return (str) => {
        const msg = new TextEncoder().encode(str);
        const len = msg.length;
        const bitLen = len * 8;
        const padLen = ((len + 9 + 63) & ~63);
        const padded = new Uint8Array(padLen);
        padded.set(msg);
        padded[len] = 0x80;
        new DataView(padded.buffer).setUint32(padLen - 4, bitLen >>> 0, false);
        let h0=0x6a09e667,h1=0xbb67ae85,h2=0x3c6ef372,h3=0xa54ff53a;
        let h4=0x510e527f,h5=0x9b05688c,h6=0x1f83d9ab,h7=0x5be0cd19;
        const w = new Uint32Array(64);
        for (let i = 0; i < padLen; i += 64) {
          const dv = new DataView(padded.buffer, i, 64);
          for (let j = 0; j < 16; j++) w[j] = dv.getUint32(j * 4, false);
          for (let j = 16; j < 64; j++) {
            const s0 = rotr(w[j-15],7) ^ rotr(w[j-15],18) ^ (w[j-15] >>> 3);
            const s1 = rotr(w[j-2],17) ^ rotr(w[j-2],19) ^ (w[j-2] >>> 10);
            w[j] = (w[j-16] + s0 + w[j-7] + s1) >>> 0;
          }
          let a=h0,b=h1,c=h2,d=h3,e=h4,f=h5,g=h6,h=h7;
          for (let j = 0; j < 64; j++) {
            const S1 = rotr(e,6) ^ rotr(e,11) ^ rotr(e,25);
            const ch = (e & f) ^ (~e & g);
            const tmp1 = (h + S1 + ch + K[j] + w[j]) >>> 0;
            const S0 = rotr(a,2) ^ rotr(a,13) ^ rotr(a,22);
            const maj = (a & b) ^ (a & c) ^ (b & c);
            const tmp2 = (S0 + maj) >>> 0;
            h=g; g=f; f=e; e=(d + tmp1) >>> 0;
            d=c; c=b; b=a; a=(tmp1 + tmp2) >>> 0;
          }
          h0=(h0+a)>>>0; h1=(h1+b)>>>0; h2=(h2+c)>>>0; h3=(h3+d)>>>0;
          h4=(h4+e)>>>0; h5=(h5+f)>>>0; h6=(h6+g)>>>0; h7=(h7+h)>>>0;
        }
        return [h0,h1,h2,h3,h4,h5,h6,h7].map(v => v.toString(16).padStart(8,'0')).join('');
      };
    })();

    const gateHash = async (str) => {
      if (typeof crypto !== 'undefined' && crypto.subtle && crypto.subtle.digest) {
        try {
          const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
          return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
        } catch (_) {}
      }
      return _gateSha256Pure(str);
    };

    const gate = document.getElementById('ext-encrypt-gate');
    if (!gate) return;

    const expectedHash = gate.dataset.hash || '';
    const fallbackUrl = gate.dataset.fallbackUrl || '/';
    const input = document.getElementById('ext-encrypt-gate__input');
    const errorEl = document.getElementById('ext-encrypt-gate__error');
    const submitBtn = document.getElementById('ext-encrypt-gate__submit');
    const cancelBtn = document.getElementById('ext-encrypt-gate__cancel');
    const card = gate.querySelector('.ext-encrypt-gate__card');

    // ── Scroll lock helpers ──────────────────────────────────────
    // Saves and restores the scroll position so layout doesn't jump
    let _savedScrollTop = 0;

    const lockScroll = () => {
      _savedScrollTop = window.scrollY || document.documentElement.scrollTop;
      document.documentElement.classList.add('ext-gate-open');
      document.body.classList.add('ext-gate-open');
      // Prevent touch-based scroll on iOS
      document.addEventListener('touchmove', _preventTouch, { passive: false });
    };

    const unlockScroll = () => {
      document.documentElement.classList.remove('ext-gate-open');
      document.body.classList.remove('ext-gate-open');
      document.removeEventListener('touchmove', _preventTouch);
      // Restore scroll position (CSS overflow:hidden moves scroll to 0)
      window.scrollTo(0, _savedScrollTop);
    };

    const _preventTouch = (e) => {
      // Allow scroll inside the gate card itself
      if (gate.contains(e.target)) return;
      e.preventDefault();
    };
    // ────────────────────────────────────────────────────────────

    // Hide the article content behind the gate until password is correct
    document.getElementById('article-container')?.setAttribute('data-gate-locked', 'true');

    const shakeCard = () => {
      card.classList.remove('is-shaking');
      void card.offsetWidth;
      card.classList.add('is-shaking');
    };

    const goToFallback = () => {
      unlockScroll();
      window.location.href = fallbackUrl;
    };

    const handleSubmit = async () => {
      const pass = input.value.trim();
      if (!pass) return;
      submitBtn.disabled = true;
      submitBtn.textContent = '校验中…';

      const inputHash = await gateHash(pass);
      if (inputHash.toLowerCase() === expectedHash.toLowerCase()) {
        // Correct — unlock the content
        gate.classList.add('is-unlocking');
        document.getElementById('article-container')?.removeAttribute('data-gate-locked');
        sessionStorage.setItem(`shijianus-ext-gate:${window.location.pathname}`, 'unlocked');

        setTimeout(() => {
          gate.remove();
          unlockScroll();
          window.dispatchEvent(new CustomEvent('shijianus:activity', {
            detail: { message: '🔓 外联加密文章已成功验证解锁' }
          }));
        }, 550);
      } else {
        submitBtn.disabled = false;
        submitBtn.textContent = '🔓 验证并解密';
        errorEl.hidden = false;
        shakeCard();
        input.select();
      }
    };

    // Check if already unlocked in this session
    if (sessionStorage.getItem(`shijianus-ext-gate:${window.location.pathname}`) === 'unlocked') {
      gate.remove();
      document.getElementById('article-container')?.removeAttribute('data-gate-locked');
      // No scroll lock needed — gate is immediately removed
    } else {
      // ── BODY TELEPORT ─────────────────────────────────────────────────────
      // Move gate to <body> level to guarantee true fullscreen coverage
      // regardless of any parent stacking contexts (position:relative, etc.)
      if (gate.parentElement !== document.body) {
        document.body.appendChild(gate);
      }
      // ─────────────────────────────────────────────────────────────────────

      // Show gate + lock scroll
      lockScroll();
      gate.classList.add('is-active');
      setTimeout(() => input?.focus(), 200);
    }

    submitBtn.addEventListener('click', handleSubmit);
    cancelBtn.addEventListener('click', goToFallback);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') handleSubmit();
      if (e.key === 'Escape') goToFallback();
    });
  })();
  </script>
)}

