<script is:inline>
  (() => {
    const initContentEnhancements = async () => {
      const articles = document.querySelectorAll('[data-content-features]');
      if (!articles.length) return;

      // 1. Spoilers and Hidden Inline Text Nodes
      const createSpoiler = (text) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'spoiler-mask';
        button.setAttribute('aria-pressed', 'false');
        button.setAttribute('aria-label', '点击显示剧透内容');
        button.textContent = text;
        button.addEventListener('click', () => {
          button.classList.add('is-visible');
          button.setAttribute('aria-pressed', 'true');
        }, { once: true });
        return button;
      };

      const createHiddenInline = (text) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'hidden-inline-lock';
        button.setAttribute('aria-label', '点击显示隐藏内容');
        button.textContent = '隐藏内容';
        button.addEventListener('click', () => {
          button.textContent = text;
          button.classList.add('is-visible');
        });
        return button;
      };

      const transformTextNodes = (article) => {
        if (article.dataset.inlineTransformed === 'true') return;
        article.dataset.inlineTransformed = 'true';

        const walker = document.createTreeWalker(article, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            const parent = node.parentElement;
            if (!parent) return NodeFilter.FILTER_REJECT;
            if (parent.closest('pre, code, kbd, script, style, textarea, .spoiler-mask, .hidden-inline-lock, .content-access-panel, .katex')) {
              return NodeFilter.FILTER_REJECT;
            }
            return /(\|\|[^|]+\|\|)|%%[^%]+%%/.test(node.nodeValue || '')
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_REJECT;
          },
        });

        const nodes = [];
        while (walker.nextNode()) nodes.push(walker.currentNode);

        nodes.forEach((node) => {
          const value = node.nodeValue || '';
          const pattern = /(\|\|([^|]+)\|\|)|%%([^%]+)%%/g;
          const fragment = document.createDocumentFragment();
          let lastIndex = 0;
          let match;

          while ((match = pattern.exec(value))) {
            if (match.index > lastIndex) {
              fragment.append(document.createTextNode(value.slice(lastIndex, match.index)));
            }
            if (match[2]) {
              fragment.append(createSpoiler(match[2]));
            } else {
              fragment.append(createHiddenInline(match[3] || ''));
            }
            lastIndex = pattern.lastIndex;
          }

          if (lastIndex < value.length) {
            fragment.append(document.createTextNode(value.slice(lastIndex)));
          }

          node.parentNode?.replaceChild(fragment, node);
        });
      };

      // 2. Table Responsive Wrap
      const enhanceTables = (article) => {
        article.querySelectorAll('table').forEach((table) => {
          if (table.parentElement?.classList.contains('article-table-wrap')) return;
          const wrap = document.createElement('div');
          wrap.className = 'article-table-wrap';
          table.parentNode?.insertBefore(wrap, table);
          wrap.appendChild(table);
        });
      };

      // 3. GitHub Alerts & Admonitions
      const alertIcons = {
        note: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`,
        tip: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>`,
        important: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
        warning: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
        caution: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
        danger: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>`,
        success: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
        question: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
        quote: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/></svg>`
      };

      const defaultTitles = {
        note: '注意 (Note)',
        tip: '提示 (Tip)',
        important: '重点 (Important)',
        warning: '警告 (Warning)',
        caution: '危险 (Caution)',
        danger: '危险 (Danger)',
        success: '成功 (Success)',
        question: '疑问 (Question)',
        quote: '引用 (Quote)'
      };

      const enhanceAlerts = (article) => {
        article.querySelectorAll('blockquote').forEach((bq) => {
          if (bq.dataset.alertEnhanced === 'true') return;
          const firstP = bq.querySelector('p');
          if (!firstP) return;

          const rawHtml = firstP.innerHTML.trim();
          const match = rawHtml.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION|DANGER|SUCCESS|QUESTION|QUOTE)\]([+-]?)([\s\S]*)$/i);
          if (!match) return;

          bq.dataset.alertEnhanced = 'true';
          const type = match[1].toLowerCase();
          const isCollapsible = match[2] === '-' || match[2] === '+';
          const isDefaultOpen = match[2] === '+';
          let restContent = match[3].trim();

          // Clean leading <br> or whitespace
          restContent = restContent.replace(/^(<br\s*\/?>|\n|\r)+/i, '').trim();

          let customTitle = defaultTitles[type] || type.toUpperCase();

          // Check if restContent starts with <strong>Title</strong> or plaintext on first line
          const strongMatch = restContent.match(/^<strong>(.*?)<\/strong>[:：\s]*(.*)/is);
          if (strongMatch) {
            customTitle = strongMatch[1].trim();
            restContent = strongMatch[2].trim();
          } else {
            const firstLineBreak = restContent.search(/<br\s*\/?>|\n/i);
            if (firstLineBreak > 0) {
              const possibleTitle = restContent.slice(0, firstLineBreak).replace(/<[^>]+>/g, '').trim();
              if (possibleTitle && possibleTitle.length < 50) {
                customTitle = possibleTitle;
                restContent = restContent.slice(firstLineBreak).replace(/^(<br\s*\/?>|\n|\r)+/i, '').trim();
              }
            }
          }

          if (restContent) {
            firstP.innerHTML = restContent;
          } else {
            firstP.remove();
          }

          const iconSvg = alertIcons[type] || alertIcons.note;

          if (isCollapsible) {
            const details = document.createElement('details');
            details.className = `admonition-details admonition-${type}`;
            if (isDefaultOpen) details.open = true;

            const summary = document.createElement('summary');
            summary.innerHTML = `<span style="display:flex;align-items:center;gap:0.5rem;">${iconSvg}<span>${customTitle}</span></span><span class="summary-icon">▶</span>`;

            const contentDiv = document.createElement('div');
            contentDiv.className = 'details-content';
            while (bq.firstChild) {
              contentDiv.appendChild(bq.firstChild);
            }

            details.append(summary, contentDiv);
            bq.parentNode?.replaceChild(details, bq);
          } else {
            const card = document.createElement('div');
            card.className = `admonition admonition-${type}`;

            const header = document.createElement('div');
            header.className = 'admonition-title';
            header.innerHTML = `${iconSvg}<span>${customTitle}</span>`;

            const contentDiv = document.createElement('div');
            contentDiv.className = 'admonition-content';
            while (bq.firstChild) {
              contentDiv.appendChild(bq.firstChild);
            }

            card.append(header, contentDiv);
            bq.parentNode?.replaceChild(card, bq);
          }
        });
      };

      // 4. Interactive Tabs
      const enhanceTabs = (article) => {
        article.querySelectorAll('.article-tabs').forEach((tabs) => {
          if (tabs.dataset.tabsBound === 'true') return;
          tabs.dataset.tabsBound = 'true';

          const buttons = tabs.querySelectorAll('.article-tabs__button');
          const panels = tabs.querySelectorAll('.article-tabs__panel');

          buttons.forEach((button, index) => {
            button.addEventListener('click', () => {
              buttons.forEach((btn) => btn.classList.remove('is-active'));
              panels.forEach((pnl) => pnl.classList.remove('is-active'));

              button.classList.add('is-active');
              if (panels[index]) {
                panels[index].classList.add('is-active');
              }
            });
          });
        });
      };

      // 5. Password Modal Dialog & Encrypted Box
      let modalOverlay = document.querySelector('.encrypted-modal-overlay');
      if (!modalOverlay) {
        modalOverlay = document.createElement('div');
        modalOverlay.className = 'encrypted-modal-overlay';
        modalOverlay.innerHTML = `
          <div class="encrypted-modal-card">
            <div class="encrypted-modal__icon">🔐</div>
            <h3 class="encrypted-modal__title">验证访问密码</h3>
            <p class="encrypted-modal__hint">该部分为受限内容，请输入正确密码解锁。</p>
            <input type="password" class="encrypted-modal__input" placeholder="输入访问密钥 / 密码" />
            <div class="encrypted-modal__error">密码错误，请重新输入</div>
            <div class="encrypted-modal__actions">
              <button type="button" class="encrypted-modal__cancel">取消</button>
              <button type="button" class="encrypted-modal__submit">确认解密</button>
            </div>
          </div>
        `;
        document.body.appendChild(modalOverlay);
      }

      const modalInput = modalOverlay.querySelector('.encrypted-modal__input');
      const modalError = modalOverlay.querySelector('.encrypted-modal__error');
      const modalHint = modalOverlay.querySelector('.encrypted-modal__hint');
      const modalCancel = modalOverlay.querySelector('.encrypted-modal__cancel');
      const modalSubmit = modalOverlay.querySelector('.encrypted-modal__submit');
      const modalCard = modalOverlay.querySelector('.encrypted-modal-card');
      let currentActiveBox = null;

      const closeModal = () => {
        modalOverlay.classList.remove('is-open');
        modalInput.value = '';
        modalError.style.display = 'none';
        modalCard.classList.remove('is-shaking');
        currentActiveBox = null;
      };

      modalCancel?.addEventListener('click', closeModal);
      modalOverlay.addEventListener('click', (e) => {
        if (e.target === modalOverlay) closeModal();
      });

      const handlePasswordSubmit = () => {
        if (!currentActiveBox) return;
        const targetPass = currentActiveBox.dataset.password || 'shijianus2026';
        const enteredPass = modalInput.value.trim();

        if (enteredPass === targetPass) {
          currentActiveBox.classList.add('is-unlocked');
          const boxId = currentActiveBox.dataset.boxId || `enc-${Date.now()}`;
          currentActiveBox.dataset.boxId = boxId;
          sessionStorage.setItem(`unlocked-${boxId}`, 'true');
          closeModal();
          window.dispatchEvent(new CustomEvent('shijianus:activity', { detail: { message: '🔓 加密内容已解锁' } }));
        } else {
          modalError.style.display = 'block';
          modalCard.classList.remove('is-shaking');
          void modalCard.offsetWidth; // Trigger reflow
          modalCard.classList.add('is-shaking');
          modalInput.select();
        }
      };

      modalSubmit?.addEventListener('click', handlePasswordSubmit);
      modalInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') handlePasswordSubmit();
        if (e.key === 'Escape') closeModal();
      });

      const enhanceEncryptedBoxes = (article) => {
        article.querySelectorAll('.article-encrypted-box').forEach((box, idx) => {
          const boxId = box.dataset.boxId || `enc-box-${idx}`;
          box.dataset.boxId = boxId;

          if (sessionStorage.getItem(`unlocked-${boxId}`) === 'true') {
            box.classList.add('is-unlocked');
          }

          const btn = box.querySelector('.encrypted-box__btn');
          btn?.addEventListener('click', () => {
            currentActiveBox = box;
            if (modalHint) {
              modalHint.textContent = box.dataset.hint || '该部分为受限内容，请输入正确密码解锁。';
            }
            modalOverlay.classList.add('is-open');
            setTimeout(() => modalInput?.focus(), 50);
          });
        });
      };

      // 6. Image Lightbox
      let lightbox = document.querySelector('.article-lightbox');
      if (!lightbox) {
        lightbox = document.createElement('div');
        lightbox.className = 'article-lightbox';
        lightbox.innerHTML = `
          <button type="button" class="article-lightbox__close" aria-label="关闭预览">✕</button>
          <div class="article-lightbox__img-wrap">
            <img class="article-lightbox__img" src="" alt="" />
          </div>
          <div class="article-lightbox__caption"></div>
        `;
        document.body.appendChild(lightbox);

        const closeBtn = lightbox.querySelector('.article-lightbox__close');
        closeBtn?.addEventListener('click', () => lightbox.classList.remove('is-open'));
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox || e.target.classList.contains('article-lightbox__img-wrap')) {
            lightbox.classList.remove('is-open');
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && lightbox.classList.contains('is-open')) {
            lightbox.classList.remove('is-open');
          }
        });
      }

      const lightboxImg = lightbox.querySelector('.article-lightbox__img');
      const lightboxCaption = lightbox.querySelector('.article-lightbox__caption');

      const enhanceLightbox = (article) => {
        article.querySelectorAll('img').forEach((img) => {
          if (img.closest('.site-header, .theme-dock, .article-lightbox, .profile-widget, .avatar-image, button')) return;
          img.style.cursor = 'zoom-in';
          img.addEventListener('click', () => {
            if (lightboxImg) lightboxImg.src = img.src;
            if (lightboxCaption) lightboxCaption.textContent = img.alt || img.getAttribute('title') || '';
            lightbox.classList.add('is-open');
          });
        });
      };

      // 7. Footnotes Tooltips
      let footnoteTooltip = document.querySelector('.footnote-tooltip-popover');
      if (!footnoteTooltip) {
        footnoteTooltip = document.createElement('div');
        footnoteTooltip.className = 'footnote-tooltip-popover';
        document.body.appendChild(footnoteTooltip);
      }

      const enhanceFootnotes = (article) => {
        article.querySelectorAll('sup a[href*="fn-"], sup a[href*="user-content-fn-"], a[data-footnote-ref]').forEach((ref) => {
          ref.addEventListener('mouseenter', () => {
            const href = ref.getAttribute('href');
            if (!href || !href.startsWith('#')) return;
            const targetId = href.slice(1);
            const targetEl = document.getElementById(targetId) || document.getElementById(decodeURIComponent(targetId));
            if (!targetEl) return;

            const text = targetEl.textContent?.replace(/↩.*/, '').trim() || '';
            if (!text) return;

            footnoteTooltip.textContent = text;
            const rect = ref.getBoundingClientRect();
            footnoteTooltip.style.top = `${Math.max(10, rect.top - 48)}px`;
            footnoteTooltip.style.left = `${Math.min(window.innerWidth - 330, Math.max(10, rect.left - 20))}px`;
            footnoteTooltip.classList.add('is-visible');
          });

          ref.addEventListener('mouseleave', () => {
            footnoteTooltip.classList.remove('is-visible');
          });
        });
      };

      // 8. Blur and Mosaic Toggles
      const enhanceBlurMosaic = (article) => {
        article.querySelectorAll('.blur-text, .mosaic-text').forEach((el) => {
          el.addEventListener('click', () => {
            el.classList.toggle('is-unblurred');
            el.classList.toggle('is-revealed');
          });
        });

        article.querySelectorAll('.blur-image-wrap').forEach((wrap) => {
          wrap.addEventListener('click', () => {
            wrap.classList.toggle('is-unblurred');
          });
        });

        article.querySelectorAll('.hidden-box').forEach((box) => {
          const toggle = box.querySelector('.hidden-box__toggle');
          toggle?.addEventListener('click', () => {
            box.classList.toggle('is-open');
          });
        });
      };

      // 9. Mermaid Diagram Renderer
      const enhanceMermaid = async (article) => {
        const mermaidPreBlocks = article.querySelectorAll('pre[data-language="mermaid"], pre:has(code.language-mermaid), pre:has(code[data-language="mermaid"]), pre.mermaid, code.language-mermaid');
        if (!mermaidPreBlocks.length) return;

        try {
          let mermaid;
          try {
            const mod = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
            mermaid = mod.default || mod;
          } catch {
            const mod = await import('mermaid');
            mermaid = mod.default || mod;
          }
          if (!mermaid) return;

          const isDark = document.documentElement.dataset.theme === 'dark';
          mermaid.initialize({
            startOnLoad: false,
            theme: isDark ? 'dark' : 'default',
            securityLevel: 'loose',
            fontFamily: 'inherit',
          });

          let counter = 0;
          for (const block of mermaidPreBlocks) {
            const pre = block.tagName === 'PRE' ? block : block.closest('pre');
            if (!pre || pre.dataset.mermaidRendered === 'true') continue;
            pre.dataset.mermaidRendered = 'true';

            // Clean code block if wrapped in shell
            const shell = pre.closest('.code-block-shell');

            const rawCode = (pre.querySelector('code')?.textContent || pre.textContent || '').trim();
            const graphId = `mermaid-svg-${Date.now()}-${counter++}`;
            const wrap = document.createElement('div');
            wrap.className = 'mermaid-diagram-wrap';

            try {
              const { svg } = await mermaid.render(graphId, rawCode);
              wrap.innerHTML = svg;
              if (shell) {
                shell.parentNode?.replaceChild(wrap, shell);
              } else {
                pre.parentNode?.replaceChild(wrap, pre);
              }
            } catch (err) {
              console.warn('Mermaid render error:', err);
            }
          }
        } catch (e) {
          console.warn('Could not load mermaid engine:', e);
        }
      };

      // Execute on all articles
      articles.forEach((article) => {
        if (!(article instanceof HTMLElement)) return;
        transformTextNodes(article);
        enhanceTables(article);
        enhanceAlerts(article);
        enhanceTabs(article);
        enhanceEncryptedBoxes(article);
        enhanceLightbox(article);
        enhanceFootnotes(article);
        enhanceBlurMosaic(article);
        enhanceMermaid(article);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContentEnhancements, { once: true });
    } else {
      initContentEnhancements();
    }
    document.addEventListener('astro:page-load', initContentEnhancements);
  })();
</script>

