    ENCRYPTED VERSION ENTRY BUTTONS (多变体支持)
    Shown in the normal article for each encrypted variant that
    has showButton:true. Supports multiple encrypted variants.
    ============================================================ */}
{showEncryptButtons && showEncryptButtons.length > 0 && showEncryptButtons.map((btn, idx) => (
  <div class="ext-encrypt-entry-banner" data-enc-idx={idx}>
    <div class="ext-encrypt-entry-banner__inner">
      <div class="ext-encrypt-entry-banner__left">
        <span class="ext-encrypt-entry-banner__icon">🔐</span>
        <div>
          <div class="ext-encrypt-entry-banner__label">
            {showEncryptButtons.length > 1 ? `加密版本 ${idx + 1}` : '存在加密扩展版本'}
          </div>
          <div class="ext-encrypt-entry-banner__desc">
            {btn.hint || '这篇文章拥有一个加密的完整版本，输入密码后可访问全部内容。'}
          </div>
        </div>
      </div>
      <a
        href={btn.href}
        class="ext-encrypt-entry-banner__btn"
        aria-label={`进入加密版本：${btn.title}`}
      >
        🔑 进入加密版本
      </a>
    </div>
  </div>
))}
