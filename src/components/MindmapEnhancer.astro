---
// MindmapEnhancer.astro - Dynamic interactive Mindmap (Markmap) renderer for all Markdown articles
---
<script>
  import { Transformer } from 'markmap-lib';
  import { Markmap } from 'markmap-view';
  import * as d3 from 'd3';

  // Harmonious theme color palette for branching
  const PALETTE = [
    '#6366f1', // Indigo
    '#10b981', // Emerald
    '#8b5cf6', // Violet
    '#f59e0b', // Amber
    '#f43f5e', // Rose
    '#06b6d4', // Cyan
    '#3b82f6', // Blue
    '#ec4899', // Pink
    '#14b8a6', // Teal
  ];

  const transformer = new Transformer();

  // Helper: Count total nodes in tree
  const countNodes = (node: any): number => {
    if (!node) return 0;
    let count = 1;
    if (node.children && Array.isArray(node.children)) {
      for (const child of node.children) {
        count += countNodes(child);
      }
    }
    return count;
  };

  // Helper: Calculate max depth
  const getTreeDepth = (node: any, current = 1): number => {
    if (!node || !node.children || !node.children.length) return current;
    let max = current;
    for (const child of node.children) {
      max = Math.max(max, getTreeDepth(child, current + 1));
    }
    return max;
  };

  // Helper: Set fold state according to targetLevel
  // targetLevel = 1: Root (depth 0) is folded (single block mode, children hidden until clicked)
  // targetLevel = 2: Root (depth 0) unfolded, direct children (depth 1) folded
  const setFoldLevel = (node: any, currentDepth = 0, targetLevel = 1) => {
    if (!node) return;
    if (!node.payload) node.payload = {};
    node.payload.fold = currentDepth >= (targetLevel - 1) ? 1 : 0;
    if (node.children && Array.isArray(node.children)) {
      for (const child of node.children) {
        setFoldLevel(child, currentDepth + 1, targetLevel);
      }
    }
  };

  // Helper: Unfold all nodes in tree
  const unfoldAllNodes = (node: any) => {
    if (!node) return;
    if (node.payload) node.payload.fold = 0;
    if (node.children && Array.isArray(node.children)) {
      for (const child of node.children) {
        unfoldAllNodes(child);
      }
    }
  };

  // ── i18n UI String Dictionary ──────────────────────────────────────────────
  // All locale-specific UI strings for the mindmap component.
  // The page locale is read from <html lang="..."> at runtime.
  const MINDMAP_I18N: Record<string, {
    defaultTitle: string;
    nodesLabel: (n: number) => string;
    depthLabel: (d: number) => string;
    stateCollapsed: string;
    stateExpanded: string;
    stateBranchMode: string;
    stateAllExpanded: string;
    stateAllCollapsed: string;
    hintPill: string;
    footerGuide: string;
    zoomIn: string; zoomOut: string; fitView: string;
    expandAll: string; collapseAll: string;
    fullscreen: string; exitFullscreen: string;
    copySource: string;
    actZoomIn: string; actZoomOut: string; actFitView: string;
    actExpandAll: string; actEnterFullscreen: string; actExitFullscreen: string;
    actCopied: string;
  }> = {
    'zh-CN': {
      defaultTitle: '交互式多向分支思维导图',
      nodesLabel: (n) => `${n} 个节点`,
      depthLabel: (d) => `${d} 层分支结构`,
      stateCollapsed: '单块已折叠 · 点击展开多向分支',
      stateExpanded: '多向分支已展开',
      stateBranchMode: '多级分支模式',
      stateAllExpanded: '全部分支已展开',
      stateAllCollapsed: '单块已收起 · 点击展开多向分支',
      hintPill: '默认仅展示单块核心 · 点击节点或圆点展开多向分支 · 按住拖拽平移 · 滚轮缩放',
      footerGuide: '💡 点击节点或小圆点散开/收起分支 · 滚轮缩放 · 鼠标拖拽平移 · 工具栏支持居中/展开/全屏(Esc)',
      zoomIn: '放大视图 (+)', zoomOut: '缩小视图 (-)', fitView: '自适应居中视野 (Fit View)',
      expandAll: '一键展开全部多向分支', collapseAll: '一键收起至单块（恢复初始状态）',
      fullscreen: '全屏沉浸模式 (按 Esc 退出)', exitFullscreen: '退出全屏 (Esc)',
      copySource: '复制 Markdown 节点源码',
      actZoomIn: '🔍 思维导图视图已放大', actZoomOut: '🔍 思维导图视图已缩小',
      actFitView: '🎯 思维导图视野已自适应居中', actExpandAll: '🧠 思维导图已一键展开全部多向分支',
      actEnterFullscreen: '⛶ 已进入全屏思维导图探索（按 Esc 键随时退出）',
      actExitFullscreen: '⛶ 已退出全屏思维导图模式', actCopied: '📋 思维导图结构源码已复制到剪贴板',
    },
    'zh-Hant': {
      defaultTitle: '互動式多向分支思維導圖',
      nodesLabel: (n) => `${n} 個節點`,
      depthLabel: (d) => `${d} 層分支結構`,
      stateCollapsed: '單塊已摺疊 · 點擊展開多向分支',
      stateExpanded: '多向分支已展開', stateBranchMode: '多級分支模式',
      stateAllExpanded: '全部分支已展開', stateAllCollapsed: '單塊已收起 · 點擊展開多向分支',
      hintPill: '預設僅展示單塊核心 · 點擊節點或圓點展開多向分支 · 按住拖曳平移 · 滾輪縮放',
      footerGuide: '💡 點擊節點或小圓點散開/收起分支 · 滾輪縮放 · 滑鼠拖曳平移 · 工具列支援置中/展開/全螢幕(Esc)',
      zoomIn: '放大視圖 (+)', zoomOut: '縮小視圖 (-)', fitView: '自適應置中視野 (Fit View)',
      expandAll: '一鍵展開全部多向分支', collapseAll: '一鍵收起至單塊（恢復初始狀態）',
      fullscreen: '全螢幕沉浸模式 (按 Esc 退出)', exitFullscreen: '退出全螢幕 (Esc)',
      copySource: '複製 Markdown 節點原始碼',
      actZoomIn: '🔍 思維導圖視圖已放大', actZoomOut: '🔍 思維導圖視圖已縮小',
      actFitView: '🎯 思維導圖視野已自適應置中', actExpandAll: '🧠 思維導圖已一鍵展開全部多向分支',
      actEnterFullscreen: '⛶ 已進入全螢幕思維導圖探索（按 Esc 鍵隨時退出）',
      actExitFullscreen: '⛶ 已退出全螢幕思維導圖模式', actCopied: '📋 思維導圖結構原始碼已複製到剪貼板',
    },
    en: {
      defaultTitle: 'Interactive Multi-Branch Mind Map',
      nodesLabel: (n) => `${n} nodes`,
      depthLabel: (d) => `${d}-level branch structure`,
      stateCollapsed: 'Collapsed · Click to expand branches',
      stateExpanded: 'Branches expanded', stateBranchMode: 'Multi-level branch mode',
      stateAllExpanded: 'All branches expanded', stateAllCollapsed: 'Collapsed · Click to expand branches',
      hintPill: 'Shows single root by default · Click a node or dot to expand · Drag to pan · Scroll to zoom',
      footerGuide: '💡 Click nodes or dots to expand/collapse · Scroll to zoom · Drag to pan · Toolbar: center / expand / fullscreen (Esc)',
      zoomIn: 'Zoom in (+)', zoomOut: 'Zoom out (-)', fitView: 'Fit view (center)',
      expandAll: 'Expand all branches', collapseAll: 'Collapse to root (reset)',
      fullscreen: 'Fullscreen immersive mode (Esc to exit)', exitFullscreen: 'Exit fullscreen (Esc)',
      copySource: 'Copy Markdown node source',
      actZoomIn: '🔍 Mind map zoomed in', actZoomOut: '🔍 Mind map zoomed out',
      actFitView: '🎯 Mind map view centered', actExpandAll: '🧠 All branches expanded',
      actEnterFullscreen: '⛶ Entered fullscreen mind map mode (press Esc to exit)',
      actExitFullscreen: '⛶ Exited fullscreen mind map mode', actCopied: '📋 Mind map source copied to clipboard',
    },
    fr: {
      defaultTitle: 'Carte mentale interactive multi-branches',
      nodesLabel: (n) => `${n} nœuds`,
      depthLabel: (d) => `Structure à ${d} niveaux`,
      stateCollapsed: 'Réduit · Cliquez pour développer les branches',
      stateExpanded: 'Branches développées', stateBranchMode: 'Mode multi-niveaux',
      stateAllExpanded: 'Toutes les branches développées', stateAllCollapsed: 'Réduit · Cliquez pour développer les branches',
      hintPill: 'Affiche uniquement la racine par défaut · Cliquez sur un nœud ou un point pour développer · Glisser pour déplacer · Molette pour zoomer',
      footerGuide: "💡 Cliquez sur les nœuds ou points pour développer/réduire · Molette : zoom · Glisser : déplacer · Barre d'outils : centrer / développer / plein écran (Esc)",
      zoomIn: 'Zoom avant (+)', zoomOut: 'Zoom arrière (-)', fitView: 'Ajuster la vue (centrer)',
      expandAll: 'Développer toutes les branches', collapseAll: 'Réduire à la racine (réinitialiser)',
      fullscreen: 'Mode plein écran immersif (Esc pour quitter)', exitFullscreen: 'Quitter le plein écran (Esc)',
      copySource: 'Copier le source Markdown',
      actZoomIn: '🔍 Carte mentale agrandie', actZoomOut: '🔍 Carte mentale réduite',
      actFitView: '🎯 Vue de la carte mentale centrée', actExpandAll: '🧠 Toutes les branches développées',
      actEnterFullscreen: '⛶ Mode plein écran activé (appuyez sur Esc pour quitter)',
      actExitFullscreen: '⛶ Mode plein écran désactivé', actCopied: '📋 Source de la carte mentale copié dans le presse-papiers',
    },
    es: {
      defaultTitle: 'Mapa mental interactivo multi-rama',
      nodesLabel: (n) => `${n} nodos`,
      depthLabel: (d) => `Estructura de ${d} niveles`,
      stateCollapsed: 'Contraído · Clic para expandir ramas',
      stateExpanded: 'Ramas expandidas', stateBranchMode: 'Modo multi-nivel',
      stateAllExpanded: 'Todas las ramas expandidas', stateAllCollapsed: 'Contraído · Clic para expandir ramas',
      hintPill: 'Muestra solo la raíz por defecto · Clic en nodo o punto para expandir · Arrastrar para mover · Rueda para zoom',
      footerGuide: '💡 Clic en nodos o puntos para expandir/contraer · Rueda: zoom · Arrastrar: mover · Barra de herramientas: centrar / expandir / pantalla completa (Esc)',
      zoomIn: 'Acercar (+)', zoomOut: 'Alejar (-)', fitView: 'Ajustar vista (centrar)',
      expandAll: 'Expandir todas las ramas', collapseAll: 'Contraer a la raíz (restablecer)',
      fullscreen: 'Modo pantalla completa (Esc para salir)', exitFullscreen: 'Salir de pantalla completa (Esc)',
      copySource: 'Copiar fuente Markdown',
      actZoomIn: '🔍 Mapa mental ampliado', actZoomOut: '🔍 Mapa mental reducido',
      actFitView: '🎯 Vista del mapa mental centrada', actExpandAll: '🧠 Todas las ramas expandidas',
      actEnterFullscreen: '⛶ Modo pantalla completa activado (Esc para salir)',
      actExitFullscreen: '⛶ Modo pantalla completa desactivado', actCopied: '📋 Fuente del mapa mental copiado al portapapeles',
    },
    de: {
      defaultTitle: 'Interaktive Multi-Zweig-Mindmap',
      nodesLabel: (n) => `${n} Knoten`,
      depthLabel: (d) => `${d}-stufige Verzweigungsstruktur`,
      stateCollapsed: 'Eingeklappt · Klicken zum Erweitern',
      stateExpanded: 'Zweige erweitert', stateBranchMode: 'Mehrstufiger Zweigmodus',
      stateAllExpanded: 'Alle Zweige erweitert', stateAllCollapsed: 'Eingeklappt · Klicken zum Erweitern',
      hintPill: 'Zeigt standardmäßig nur die Wurzel · Knoten oder Punkt klicken zum Erweitern · Ziehen zum Verschieben · Scrollen zum Zoomen',
      footerGuide: '💡 Knoten oder Punkte klicken zum Ein-/Ausklappen · Scrollen: Zoom · Ziehen: Verschieben · Werkzeuge: zentrieren / erweitern / Vollbild (Esc)',
      zoomIn: 'Vergrößern (+)', zoomOut: 'Verkleinern (-)', fitView: 'Ansicht anpassen (zentrieren)',
      expandAll: 'Alle Zweige erweitern', collapseAll: 'Zur Wurzel einklappen (zurücksetzen)',
      fullscreen: 'Vollbild-Immersionsmodus (Esc zum Beenden)', exitFullscreen: 'Vollbild beenden (Esc)',
      copySource: 'Markdown-Quellcode kopieren',
      actZoomIn: '🔍 Mindmap vergrößert', actZoomOut: '🔍 Mindmap verkleinert',
      actFitView: '🎯 Mindmap-Ansicht zentriert', actExpandAll: '🧠 Alle Zweige erweitert',
      actEnterFullscreen: '⛶ Vollbild-Mindmap-Modus aktiviert (Esc zum Beenden)',
      actExitFullscreen: '⛶ Vollbild-Mindmap-Modus beendet', actCopied: '📋 Mindmap-Quellcode in die Zwischenablage kopiert',
    },
  };

  // Resolve page locale from <html lang="..."> attribute, with fallback to zh-CN
  const resolveLocale = (): string => {
    const lang = (document.documentElement.lang || 'zh-CN').trim();
    if (lang.startsWith('zh-Hant') || lang === 'zh-TW' || lang === 'zh-HK') return 'zh-Hant';
    if (lang.startsWith('zh')) return 'zh-CN';
    const base = lang.split('-')[0].toLowerCase();
    if (MINDMAP_I18N[lang]) return lang;
    if (MINDMAP_I18N[base]) return base;
    return 'zh-CN';
  };

  // Main enhancement runner
  const initMindmaps = () => {
    // Select all mindmap code blocks or container elements
    const selectors = [
      '.article-body .mindmap-container',
      '.article-body .mindmap-block',
      '.article-body pre[data-language="mindmap"]',
      '.article-body pre[data-language="markmap"]',
      '.article-body pre:has(code.language-mindmap)',
      '.article-body pre:has(code.language-markmap)',
      '.article-body pre.mindmap-block',
      '.article-body pre.mindmap',
      '.article-body pre.markmap',
      '.article-body markmap',
      '[data-content-features] .mindmap-container',
      '[data-content-features] .mindmap-block',
      '[data-content-features] pre[data-language="mindmap"]',
      '[data-content-features] pre[data-language="markmap"]',
      '[data-content-features] pre:has(code.language-mindmap)',
      '[data-content-features] pre:has(code.language-markmap)',
      '[data-content-features] pre.mindmap-block',
      '[data-content-features] pre.mindmap',
      '[data-content-features] pre.markmap',
    ];

    const mindmapBlocks = document.querySelectorAll<HTMLElement>(selectors.join(', '));
    if (!mindmapBlocks.length) return;

    let counter = 0;

    mindmapBlocks.forEach((block) => {
      const pre = block.tagName === 'PRE' ? block : block.closest('pre') || block;
      if (pre.dataset.mindmapRendered === 'true') return;
      pre.dataset.mindmapRendered = 'true';

      const shell = pre.closest('.code-block-shell');

      // Extract raw code / markdown content
      let rawCode = (pre.querySelector('code')?.textContent || pre.textContent || '').trim();

      // Check for inline JSON config at start (e.g. {"initialExpandLevel": 1, "height": "480px"})
      let customOptions: Record<string, any> = {};
      const jsonConfigMatch = rawCode.match(/^\{\s*("[^"]+"\s*:\s*[^,}]+\s*,?\s*)+\}\s*\n/);
      if (jsonConfigMatch) {
        try {
          customOptions = JSON.parse(jsonConfigMatch[0]);
          rawCode = rawCode.slice(jsonConfigMatch[0].length).trim();
        } catch (_) {}
      }

      // Default expand level: 1 (Default: single root block, expands outwards on click)
      const initialExpandLevel = typeof customOptions.initialExpandLevel === 'number'
        ? customOptions.initialExpandLevel
        : parseInt(pre.dataset.initialExpandLevel || '1', 10);

      const customHeight = customOptions.height || pre.dataset.height || '460px';
      // Resolve locale-aware strings — reads <html lang="..."> at runtime
      const loc = MINDMAP_I18N[resolveLocale()] || MINDMAP_I18N['zh-CN'];
      const customTitle = customOptions.title || pre.dataset.title || loc.defaultTitle;

      // Parse Markdown into Markmap AST
      const { root } = transformer.transform(rawCode);
      if (!root) return;

      const totalNodes = countNodes(root);
      const maxDepth = getTreeDepth(root);

      // Apply initial fold: level 1 means depth >= 1 are collapsed into 1 single block
      setFoldLevel(root, 0, initialExpandLevel);

      const mindmapId = `mindmap-${Date.now()}-${counter++}`;

      // Build container DOM
      const wrapper = document.createElement('div');
      wrapper.className = 'mindmap-wrapper';
      wrapper.id = mindmapId;
      wrapper.style.setProperty('--mindmap-height', customHeight);

      wrapper.innerHTML = `
        <div class="mindmap-header">
          <div class="mindmap-header__left">
            <div class="mindmap-header__badge">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mindmap-icon">
                <path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z"/>
                <path d="M9 21h6"/>
              </svg>
              <span class="mindmap-header__title">${customTitle}</span>
            </div>
            <div class="mindmap-header__meta">
              <span class="mindmap-meta-pill mindmap-meta-nodes">
                <span class="meta-dot"></span>${loc.nodesLabel(totalNodes)}
              </span>
              <span class="mindmap-meta-pill mindmap-meta-depth">
                ${loc.depthLabel(maxDepth)}
              </span>
              <span class="mindmap-state-tag is-collapsed">
                ${initialExpandLevel === 1 ? loc.stateCollapsed : loc.stateBranchMode}
              </span>
            </div>
          </div>
          <div class="mindmap-toolbar">
            <button type="button" class="mindmap-btn mindmap-btn--zoom-in" title="${loc.zoomIn}" aria-label="${loc.zoomIn}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </button>
            <button type="button" class="mindmap-btn mindmap-btn--zoom-out" title="${loc.zoomOut}" aria-label="${loc.zoomOut}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
            </button>
            <button type="button" class="mindmap-btn mindmap-btn--fit" title="${loc.fitView}" aria-label="${loc.fitView}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="2" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="22" y2="12"/></svg>
            </button>
            <button type="button" class="mindmap-btn mindmap-btn--expand-all" title="${loc.expandAll}" aria-label="${loc.expandAll}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            </button>
            <button type="button" class="mindmap-btn mindmap-btn--collapse-all" title="${loc.collapseAll}" aria-label="${loc.collapseAll}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
            </button>
            <button type="button" class="mindmap-btn mindmap-btn--fullscreen" title="${loc.fullscreen}" aria-label="${loc.fullscreen}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><polyline points="21 15 21 21 15 21"/><polyline points="3 9 3 3 9 3"/></svg>
            </button>
            <button type="button" class="mindmap-btn mindmap-btn--copy" title="${loc.copySource}" aria-label="${loc.copySource}">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            </button>
          </div>
        </div>
        <div class="mindmap-canvas-container">
          <svg class="mindmap-svg" id="${mindmapId}-svg"></svg>
          <div class="mindmap-hint-pill">
            <span class="pulse-dot"></span> ${loc.hintPill}
          </div>
        </div>
        <div class="mindmap-footer">
          <div class="mindmap-footer__guide">
            ${loc.footerGuide}
          </div>
          <div class="mindmap-footer__brand">
            <span>EpoCanvas Mindmap Engine</span>
          </div>
        </div>
      `;

      // Replace container, shell or pre with mindmap wrapper
      const targetElement = pre.closest('.mindmap-container') || shell || pre;
      targetElement.parentNode?.replaceChild(wrapper, targetElement);

      // Initialize Markmap SVG
      const svg = wrapper.querySelector<SVGElement>(`#${mindmapId}-svg`);
      if (!svg) return;

      const stateTag = wrapper.querySelector<HTMLElement>('.mindmap-state-tag');
      const hintPill = wrapper.querySelector<HTMLElement>('.mindmap-hint-pill');

      // Create color function based on harmonious palette
      const colorScale = d3.scaleOrdinal(PALETTE);

      const mm = Markmap.create(svg, {
        duration: 350,
        autoFit: true,
        fitRatio: 0.92,
        maxInitialScale: 1.8,
        initialExpandLevel: initialExpandLevel,
        zoom: true,
        pan: true,
        color: (node: any) => {
          if (!node.state) return PALETTE[0];
          return colorScale(String(node.state.index % PALETTE.length));
        },
        paddingX: 12,
        spacingHorizontal: 80,
        spacingVertical: 8,
      }, root);

      // Fit view nicely after mounting
      requestAnimationFrame(() => {
        setTimeout(() => {
          mm.fit();
        }, 150);
      });

      // Hide hint pill on first interaction
      const dismissHint = () => {
        if (hintPill && !hintPill.classList.contains('is-dismissed')) {
          hintPill.classList.add('is-dismissed');
        }
      };

      // Sensitive click handler with expanded hit target
      svg.addEventListener('click', (e) => {
        dismissHint();
        const target = e.target as HTMLElement | SVGElement;
        const nodeGroup = target?.closest<SVGGElement>('.markmap-node');
        if (nodeGroup) {
          const datum = (nodeGroup as any).__data__;
          if (datum) {
            // Toggle node directly if clicking text/line (where Markmap doesn't toggle natively)
            if (!target.closest('circle')) {
              mm.toggleNode(datum);
            }
          }
          setTimeout(() => {
            mm.fit();
          }, 380);
          if (stateTag) {
            stateTag.textContent = loc.stateExpanded;
            stateTag.className = 'mindmap-state-tag is-expanded';
          }
        }
      });
      svg.addEventListener('wheel', dismissHint, { passive: true });
      svg.addEventListener('touchstart', dismissHint, { passive: true });

      // Toolbar Controls
      const zoomInBtn = wrapper.querySelector<HTMLButtonElement>('.mindmap-btn--zoom-in');
      const zoomOutBtn = wrapper.querySelector<HTMLButtonElement>('.mindmap-btn--zoom-out');
      const fitBtn = wrapper.querySelector<HTMLButtonElement>('.mindmap-btn--fit');
      const expandAllBtn = wrapper.querySelector<HTMLButtonElement>('.mindmap-btn--expand-all');
      const collapseAllBtn = wrapper.querySelector<HTMLButtonElement>('.mindmap-btn--collapse-all');
      const fullscreenBtn = wrapper.querySelector<HTMLButtonElement>('.mindmap-btn--fullscreen');
      const copyBtn = wrapper.querySelector<HTMLButtonElement>('.mindmap-btn--copy');

      zoomInBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        dismissHint();
        mm.rescale(1.25);
        window.dispatchEvent(new CustomEvent('shijianus:activity', {
          detail: { message: loc.actZoomIn }
        }));
      });

      zoomOutBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        dismissHint();
        mm.rescale(0.8);
        window.dispatchEvent(new CustomEvent('shijianus:activity', {
          detail: { message: loc.actZoomOut }
        }));
      });

      fitBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        dismissHint();
        mm.fit();
        window.dispatchEvent(new CustomEvent('shijianus:activity', {
          detail: { message: loc.actFitView }
        }));
      });

      expandAllBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        dismissHint();
        unfoldAllNodes(root);
        mm.renderData(root);
        setTimeout(() => {
          mm.fit();
        }, 380);
        if (stateTag) {
          stateTag.textContent = loc.stateAllExpanded;
          stateTag.className = 'mindmap-state-tag is-expanded';
        }
        window.dispatchEvent(new CustomEvent('shijianus:activity', {
          detail: { message: loc.actExpandAll }
        }));
      });

      collapseAllBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        dismissHint();
        setFoldLevel(root, 0, 1);
        mm.renderData(root);
        setTimeout(() => {
          mm.fit();
        }, 380);
        if (stateTag) {
          stateTag.textContent = loc.stateAllCollapsed;
          stateTag.className = 'mindmap-state-tag is-collapsed';
        }
        window.dispatchEvent(new CustomEvent('shijianus:activity', {
          detail: { message: loc.stateAllCollapsed }
        }));
      });

      // Robust Teleport Fullscreen (under #page-header, with Esc key exit)
      let placeholder: Comment | null = null;

      const toggleFullscreen = (forceState?: boolean) => {
        dismissHint();
        const willBeFullscreen = typeof forceState === 'boolean'
          ? forceState
          : !wrapper.classList.contains('is-fullscreen');

        if (willBeFullscreen) {
          if (!placeholder) {
            placeholder = document.createComment(`mindmap-placeholder-${mindmapId}`);
          }
          wrapper.parentNode?.insertBefore(placeholder, wrapper);
          document.body.appendChild(wrapper);
          wrapper.classList.add('is-fullscreen');
          document.body.classList.add('mindmap-fullscreen-active');
          
          fullscreenBtn?.setAttribute('title', loc.exitFullscreen);
          fullscreenBtn?.setAttribute('aria-label', loc.exitFullscreen);
          if (fullscreenBtn) {
            fullscreenBtn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 14 10 14 10 20"/><polyline points="20 10 14 10 14 4"/><polyline points="14 20 14 14 20 14"/><polyline points="10 4 10 10 4 10"/></svg>`;
          }
          window.dispatchEvent(new CustomEvent('shijianus:activity', {
            detail: { message: loc.actEnterFullscreen }
          }));
        } else {
          wrapper.classList.remove('is-fullscreen');
          document.body.classList.remove('mindmap-fullscreen-active');
          if (placeholder && placeholder.parentNode) {
            placeholder.parentNode.insertBefore(wrapper, placeholder);
            placeholder.remove();
            placeholder = null;
          }
          fullscreenBtn?.setAttribute('title', loc.fullscreen);
          fullscreenBtn?.setAttribute('aria-label', loc.fullscreen);
          if (fullscreenBtn) {
            fullscreenBtn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><polyline points="21 15 21 21 15 21"/><polyline points="3 9 3 3 9 3"/></svg>`;
          }
          window.dispatchEvent(new CustomEvent('shijianus:activity', {
            detail: { message: loc.actExitFullscreen }
          }));
        }

        setTimeout(() => {
          mm.fit();
        }, 160);
      };

      fullscreenBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        toggleFullscreen();
      });

      const handleKeydown = (e: KeyboardEvent) => {
        if (e.key === 'Escape' && wrapper.classList.contains('is-fullscreen')) {
          e.preventDefault();
          toggleFullscreen(false);
        }
      };
      document.addEventListener('keydown', handleKeydown);

      copyBtn?.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(rawCode);
          } else {
            const ta = document.createElement('textarea');
            ta.value = rawCode;
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          }
          copyBtn.classList.add('is-copied');
          window.dispatchEvent(new CustomEvent('shijianus:activity', {
            detail: { message: loc.actCopied }
          }));
          setTimeout(() => {
            copyBtn.classList.remove('is-copied');
          }, 1800);
        } catch (_) {}
      });

      // Handle window resize & orientation change
      window.addEventListener('resize', () => {
        mm.fit();
      });
    });
  };

  // Lifecycle listeners
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMindmaps, { once: true });
  } else {
    initMindmaps();
  }
  document.addEventListener('astro:page-load', initMindmaps);
</script>
