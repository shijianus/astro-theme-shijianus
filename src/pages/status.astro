---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import { getPublicPosts, estimateWordCount, estimateReadingMinutes } from '../lib/content';
import { createSidebarData } from '../lib/theme';
import { siteConfig } from '../config/site';

const allPosts = await getCollection('posts');
const posts = getPublicPosts(allPosts);
const sidebarData = createSidebarData(posts);

const totalReadingMinutes = allPosts.reduce((acc, post) => acc + estimateReadingMinutes(post), 0);
const totalWords = allPosts.reduce((acc, post) => acc + estimateWordCount(post), 0);

const runtimeDays = Math.max(
  1,
  Math.floor((Date.now() - new Date(siteConfig.footer.startedAt).valueOf()) / 86_400_000),
);
const startedAtLabel = new Date(siteConfig.footer.startedAt).toLocaleDateString('zh-CN').replaceAll('/', '.');
const currentPhase = siteConfig.home.statusCards[0]?.value ?? siteConfig.site.author.statusLabel;
const latestPublishedAt = posts[0]?.data.pubDate ?? null;
const latestPublishedLabel = latestPublishedAt ? latestPublishedAt.toLocaleDateString('zh-CN').replaceAll('/', '.') : '持续更新';

const stats = {
  posts: sidebarData.totalPosts ?? 0,
  categories: sidebarData.totalCategories ?? 0,
  tags: sidebarData.totalTags ?? 0,
  readingMinutes: totalReadingMinutes,
  totalWords: totalWords,
};
---

<BlogLayout title="站点状态" showAside={false} pageType="page" sidebarData={sidebarData}>
  <div class="status-page-content">
    <section class="card-widget card-webinfo-full">
      <div class="item-headline">
        <span class="shijianusfont shijianus-icon-circle-info" aria-hidden="true"></span>
        <span>站点状态</span>
      </div>
      
      <div class="webinfo-panel">
        <div class="status-grid">
          <div class="status-item">
            <div class="status-label">建站天数</div>
            <div class="status-value">{runtimeDays} 天</div>
          </div>
          <div class="status-item">
            <div class="status-label">文章总数</div>
            <div class="status-value">{stats.posts} 篇</div>
          </div>
          <div class="status-item">
            <div class="status-label">全站字数</div>
            <div class="status-value">{Math.round(stats.totalWords / 1000) / 10}W 字</div>
          </div>
          <div class="status-item">
            <div class="status-label">阅读时长</div>
            <div class="status-value">{stats.readingMinutes} 分钟</div>
          </div>
          <div class="status-item">
            <div class="status-label">分类数目</div>
            <div class="status-value">{stats.categories} 个</div>
          </div>
          <div class="status-item">
            <div class="status-label">标签数目</div>
            <div class="status-value">{stats.tags} 个</div>
          </div>
        </div>

        <hr class="card-utility-separator" style="margin: 2rem 0 !important;" />

        <div class="status-list">
          <div class="webinfo-item">
            <div class="item-name">最后更新时间 :</div>
            <div class="item-count">{latestPublishedLabel}</div>
          </div>
          <div class="webinfo-item">
            <div class="item-name">始于 :</div>
            <div class="item-count">{startedAtLabel}</div>
          </div>
          <div class="webinfo-item">
            <div class="item-name">当前阶段 :</div>
            <div class="item-count">{currentPhase}</div>
          </div>
        </div>
      </div>
    </section>

    <section class="card-widget status-details">
      <div class="item-headline">
        <span class="shijianusfont shijianus-icon-box-archive" aria-hidden="true"></span>
        <span>运行详情</span>
      </div>
      <div class="status-notes">
        <p>这个页面展示了站点的实时运行数据和开发进度。</p>
        <ul>
          <li>接入运行时间、构建状态、评论数据库与访问统计。</li>
          <li>路径、布局和导航层级已基本固定。</li>
          <li>持续优化的 UI/UX 体验，对标 Anheyu 主题。</li>
        </ul>
      </div>
    </section>
  </div>
</BlogLayout>

<style>
  .status-page-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0;
  }
  
  .card-webinfo-full {
    background: var(--anzhiyu-card-bg);
    border: var(--style-border-always);
    box-shadow: var(--anzhiyu-shadow-border);
    border-radius: 12px;
    padding: 2rem 2.5rem !important;
  }
  
  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 1rem;
  }
  
  .status-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .status-label {
    font-size: 13px;
    color: var(--anzhiyu-secondtext);
  }
  
  .status-value {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--anzhiyu-fontcolor);
    line-height: 1;
  }
  
  .status-list {
    margin-top: 1rem;
  }
  
  .webinfo-item {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px dashed var(--anzhiyu-theme-op);
  }
  
  .webinfo-item:last-child {
    border-bottom: none;
  }
  
  .item-name {
    color: var(--anzhiyu-secondtext);
  }
  
  .item-count {
    font-weight: 700;
    color: var(--anzhiyu-fontcolor);
  }
  
  .item-headline {
    display: flex;
    align-items: center;
    font-weight: 700;
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
  }
  
  .item-headline .shijianusfont {
    margin-right: 10px;
    font-size: 1.4rem;
  }
  
  .status-notes {
    margin-top: 0;
    line-height: 1.8;
    color: var(--anzhiyu-secondtext);
  }
  
  .status-notes ul {
    margin-top: 0.8rem;
    padding-left: 1.5rem;
  }
  
  .status-notes li {
    margin-bottom: 0.6rem;
  }
  
  .status-details {
    padding: 2rem 2.5rem !important;
    background: var(--anzhiyu-card-bg);
    border: var(--style-border-always);
    box-shadow: var(--anzhiyu-shadow-border);
    border-radius: 12px;
  }
</style>
