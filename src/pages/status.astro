---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import ContentFeatureEnhancer from '../components/ContentFeatureEnhancer.astro';
import { createSidebarData } from '../lib/theme.ts';
import {
  Content,
  frontmatter,
} from '../../docs/standards/status.md';

const allPosts = await getCollection('posts');
const sidebarData = createSidebarData(allPosts);
---

<BlogLayout
  title={frontmatter.title}
  description={frontmatter.description}
  showAside={false}
  pageType="standards"
  sidebarData={sidebarData}
  lang="zh-CN"
>
  <div class="standards-spec-shell">
    <header class="standards-spec-header">
      <div class="standards-spec-header__meta">
        <span class="standards-badge standards-badge--primary">运行状态拓扑</span>
        <span class="standards-badge standards-badge--status">● 生产环境持续生效</span>
        <span class="standards-badge standards-badge--version">Runtime Status Specification</span>
      </div>
      <h1 class="standards-spec-header__title">{frontmatter.title}</h1>
      <p class="standards-spec-header__desc">{frontmatter.description}</p>
    </header>

    <article
      id="article-container"
      class="article-body post-content standards-article-body"
      data-content-features="true"
      data-lang="zh-CN"
    >
      <Content />
    </article>
  </div>

  <ContentFeatureEnhancer lang="zh-CN" />
</BlogLayout>
