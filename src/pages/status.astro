---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import ContentFeatureEnhancer from '../components/ContentFeatureEnhancer.astro';
import StandardsHero from '../components/theme/StandardsHero.astro';
import StatusOutlineNav, { type OutlineItem } from '../components/status/StatusOutlineNav.astro';
import StatusOfficialCard from '../components/status/StatusOfficialCard.astro';
import StatusFriendApplySection from '../components/status/StatusFriendApplySection.astro';
import StatusDocEnhancer from '../components/status/StatusDocEnhancer.astro';
import StatusVisuals from '../components/status/StatusVisuals.astro';
import { createSidebarData } from '../lib/theme.ts';
import { siteConfig } from '../config/site';
import {
  compiledContent,
  frontmatter,
} from '../../docs/standards/status.md';
import '../styles/status-docs.css';

const allPosts = await getCollection('posts');
const sidebarData = createSidebarData(allPosts);

const pageLang = frontmatter.lang || 'zh-CN';
const formatIso = (d?: Date | string) => {
  if (!d) return '2026-11-16';
  const parsed = d instanceof Date ? d : new Date(d);
  return Number.isNaN(parsed.getTime()) ? String(d) : parsed.toISOString().slice(0, 10);
};
const pubIso = formatIso(frontmatter.pubDate);
const updatedIso = formatIso(frontmatter.updatedDate);

const canonicalBase = Astro.site?.href || siteConfig.site.url;
const canonicalUrl = new URL('/status/', canonicalBase).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: frontmatter.title,
  description: frontmatter.description,
  url: canonicalUrl,
  inLanguage: pageLang,
  datePublished: pubIso,
  dateModified: updatedIso,
  version: frontmatter.version,
  author: {
    '@type': 'Person',
    name: siteConfig.site.author.name,
    url: canonicalBase,
  },
  publisher: {
    '@type': 'Person',
    name: siteConfig.site.name,
    url: canonicalBase,
  },
};

const outlineItems: OutlineItem[] = [
  { id: 'guide-overview', label: '简介与阅读概览' },
  { id: 'about-shijianus', label: '认识 shijianus' },
  { id: 'site-status', label: '站点状态与运行边界' },
  { id: 'friends-system', label: '友邻系统如何工作' },
  { id: 'exchange-rules', label: '友邻交换与收录规则' },
  { id: 'official-friend-info', label: 'shijianus 官方友链信息' },
  { id: 'apply-friend-link', label: '互链申请（Microsoft Forms）' },
  { id: 'privacy-and-data', label: '隐私与数据处理' },
  { id: 'faq', label: '常见问题' },
  { id: 'glossary', label: '术语表与版本反馈' },
];

const drawerHeadings = outlineItems.map((item) => ({
  depth: 2,
  slug: item.id,
  text: item.label,
}));

const rawHtml = await compiledContent();
const SLOT_REGEX = /<div\s+data-status-slot="([a-z0-9-]+)"\s*><\/div>/g;

type DocChunk = { type: 'html'; html: string } | { type: 'slot'; name: string };
const chunks: DocChunk[] = [];
let cursor = 0;
let slotMatch: RegExpExecArray | null;
while ((slotMatch = SLOT_REGEX.exec(rawHtml)) !== null) {
  if (slotMatch.index > cursor) {
    chunks.push({ type: 'html', html: rawHtml.slice(cursor, slotMatch.index) });
  }
  chunks.push({ type: 'slot', name: slotMatch[1] });
  cursor = SLOT_REGEX.lastIndex;
}
if (cursor < rawHtml.length) {
  chunks.push({ type: 'html', html: rawHtml.slice(cursor) });
}

const VISUAL_SLOTS = new Set([
  'lead-hero',
  'overview-grid',
  'friends-pipeline',
  'rules-matrix',
  'divider-about',
  'divider-status',
  'divider-friends',
  'divider-rules',
  'divider-card',
  'divider-apply',
  'divider-privacy',
  'divider-faq',
  'divider-glossary',
]);
---

<BlogLayout
  title={frontmatter.title}
  description={frontmatter.description}
  showAside={false}
  pageType="standards"
  sidebarData={sidebarData}
  lang={pageLang}
  canonicalUrl={canonicalUrl}
  ogType="article"
  structuredData={structuredData}
  enableTocDrawer={true}
  tocHeadings={drawerHeadings}
>
  <StandardsHero
    slot="hero"
    title={frontmatter.title}
    description={frontmatter.description}
    version={frontmatter.version}
    pubDate={frontmatter.pubDate}
    updatedDate={frontmatter.updatedDate}
  />

  <div class="status-doc-root" id="top">
    <StatusOutlineNav items={outlineItems} variant="mobile" />

    <div class="status-doc-layout">
      <StatusOutlineNav items={outlineItems} variant="desktop" />

      <div class="status-doc-article">
        <div class="status-doc-article__inner">
          {chunks.map((chunk) => {
            if (chunk.type === 'html') {
              return <Fragment set:html={chunk.html} />;
            }
            if (VISUAL_SLOTS.has(chunk.name)) {
              return <StatusVisuals variant={chunk.name as any} />;
            }
            if (chunk.name === 'official-friend-card') {
              return <StatusOfficialCard />;
            }
            if (chunk.name === 'friend-apply-section') {
              return <StatusFriendApplySection />;
            }
            if (chunk.name === 'version-meta') {
              return (
                <section id="version-and-feedback" class="status-version-footer" aria-labelledby="version-and-feedback-heading">
                  <h3 id="version-and-feedback-heading">版本记录与问题反馈</h3>
                  <ul>
                    <li><strong>文档版本：</strong><code>{frontmatter.version}</code>（与页首元数据单一来源同步）</li>
                    <li><strong>首次发布：</strong><time datetime={pubIso}>{pubIso}</time> · <strong>最后修订：</strong><time datetime={updatedIso}>{updatedIso}</time> · <strong>最近核验：</strong><code>2026-11-16</code></li>
                    <li><strong>主要修订（{frontmatter.version}）：</strong>全面采用 Google 政策式图文阅读节奏与矢量 SVG 章节分割（移除顶部按钮堆砌）；全站重构高对比荧光笔 <code>&lt;mark&gt;</code> 高亮体系；互链申请升级为 Markdown 原生扫描式 Microsoft Forms 外链问卷并保留四阶段真实状态回执。</li>
                    <li><strong>反馈与申诉：</strong>致信 <a href="mailto:shijianus@epocanvas.com">shijianus@epocanvas.com</a> / <a href="mailto:contact@epocanvas.com">contact@epocanvas.com</a>，或查看 <a href="/community/reporting-and-appeals/">举报与申诉说明</a>、<a href="/guestbook/">留言板</a>。</li>
                  </ul>
                </section>
              );
            }
            return null;
          })}
        </div>
      </div>
    </div>
  </div>

  <StatusDocEnhancer />
  <ContentFeatureEnhancer lang={pageLang} />
</BlogLayout>
