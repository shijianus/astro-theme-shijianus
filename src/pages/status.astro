---
import { getCollection } from 'astro:content';
import PlaceholderPageShell from '../components/theme/PlaceholderPageShell.astro';
import BlogLayout from '../layouts/BlogLayout.astro';
import { sortPostsByDate } from '../lib/content';
import { createSidebarData } from '../lib/theme';

const posts = sortPostsByDate(await getCollection('posts'));
const sidebarData = createSidebarData(posts);
---

<BlogLayout title="站点状态" showAside={false} pageType="page" sidebarData={sidebarData}>
  <PlaceholderPageShell
    eyebrow="shijianus / status"
    title="站点状态"
    summary="这个页面预留给运行状态、重构里程碑、页面完成度和后续路线图，让读者能直接看到当前主题还在做什么。"
    statusLabel="状态面板待接入"
    notes={[
      '之后可以直接接入运行时间、构建状态、评论数据库与访问统计。',
      '现在先把路径、布局和导航层级固定下来，避免以后再拆菜单。',
      '占位页借用 404 的建设中语义，但本身已经是正式可访问页面。',
    ]}
  />
</BlogLayout>
