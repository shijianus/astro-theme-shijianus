---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import ContentFeatureEnhancer from '../../components/ContentFeatureEnhancer.astro';
import StandardsHero from '../../components/theme/StandardsHero.astro';
import { createSidebarData } from '../../lib/theme.ts';
import { Content, frontmatter } from '../../../docs/operations/release-and-incident-runbook.md';

const allPosts = await getCollection('posts');
const sidebarData = createSidebarData(allPosts);
---

<BlogLayout title={frontmatter.title} description={frontmatter.description} showAside={false} pageType="standards" sidebarData={sidebarData} lang="zh-Hant">
  <StandardsHero slot="hero" title={frontmatter.title} description={frontmatter.description} version={frontmatter.version} pubDate={frontmatter.pubDate} updatedDate={frontmatter.updatedDate} />
  <Content />
  <ContentFeatureEnhancer lang="zh-Hant" />
</BlogLayout>
