---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import VersionDashboard from '../components/theme/VersionDashboard.astro';
import { getPublicPosts } from '../lib/content';
import { createSidebarData } from '../lib/theme';

const posts = getPublicPosts(await getCollection('posts'));
const sidebarData = createSidebarData(posts);
---

<BlogLayout
  title="版本规范 | EpoCanvas 版本与架构规范"
  description="说明 EpoCanvas 如何管理内容与程序版本、Git 提交追溯、Astro 构建分层、依赖契约与授权边界"
  showAside={false}
  pageType="standards"
  sidebarData={sidebarData}
>
  <VersionDashboard />
</BlogLayout>
