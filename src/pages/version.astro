---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import ContentFeatureEnhancer from '../components/ContentFeatureEnhancer.astro';
import { createSidebarData } from '../lib/theme.ts';
import {
  Content,
  frontmatter,
} from '../../docs/standards/version.md';

const allPosts = await getCollection('posts');
const sidebarData = createSidebarData(allPosts);
---

<BlogLayout
  title={frontmatter.title}
  description={frontmatter.description}
  showAside={false}
  pageType="standards"
  sidebarData={sidebarData}
  lang="zh-CN"
>
  <div class="standards-spec-shell">
    <header class="standards-spec-header">
      <div class="standards-spec-header__meta">
        <span class="standards-badge standards-badge--primary">EES-004</span>
        <span class="standards-badge standards-badge--status">● 生产环境持续生效</span>
        <span class="standards-badge standards-badge--version">Sub-Spec: Version & Architecture</span>
      </div>
      <h1 class="standards-spec-header__title">{frontmatter.title}</h1>
      <p class="standards-spec-header__desc">{frontmatter.description}</p>

      <nav class="standards-spec-nav" aria-label="工程标准体系规范导航">
        <a href="/standards/" class="spec-nav-pill">
          <span class="pill-id">EES-001</span>
          <span class="pill-name">工程标准总纲</span>
        </a>
        <a href="/standards/activity-level/" class="spec-nav-pill">
          <span class="pill-id">EES-002</span>
          <span class="pill-name">活跃等级规范</span>
        </a>
        <a href="/standards/content-density/" class="spec-nav-pill">
          <span class="pill-id">EES-003</span>
          <span class="pill-name">内容密度规范</span>
        </a>
        <a href="/version/" class="spec-nav-pill is-active" aria-current="page">
          <span class="pill-id">EES-004</span>
          <span class="pill-name">版本协议规范</span>
        </a>
        <a href="/status/" class="spec-nav-pill">
          <span class="pill-id">EES-005</span>
          <span class="pill-name">运行状态规范</span>
        </a>
      </nav>
    </header>

    <article
      id="article-container"
      class="article-body post-content standards-article-body"
      data-content-features="true"
      data-lang="zh-CN"
    >
      <Content />
    </article>
  </div>

  <ContentFeatureEnhancer lang="zh-CN" />
</BlogLayout>
