---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import ContentFeatureEnhancer from '../components/ContentFeatureEnhancer.astro';
import StandardsHero from '../components/theme/StandardsHero.astro';
import { createSidebarData } from '../lib/theme.ts';
import {
  Content,
  frontmatter,
} from '../../docs/standards/version.md';

const allPosts = await getCollection('posts');
const sidebarData = createSidebarData(allPosts);
---

<BlogLayout
  title={frontmatter.title}
  description={frontmatter.description}
  showAside={false}
  pageType="standards"
  sidebarData={sidebarData}
  lang="zh-CN"
>
  <StandardsHero
    slot="hero"
    title={frontmatter.title}
    description={frontmatter.description}
  />

  <Content />

  <ContentFeatureEnhancer lang="zh-CN" />
</BlogLayout>
