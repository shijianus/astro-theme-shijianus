---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import SiteDashboard from '../../components/theme/SiteDashboard.astro';
import { getPublicPosts } from '../../lib/content';
import { createSidebarData } from '../../lib/theme';

const posts = getPublicPosts(await getCollection('posts'));
const sidebarData = createSidebarData(posts);
---

<BlogLayout
  title="关于本站 | EpoCanvas 工作台与系统设计"
  description="在高信息密度里保留阅读秩序 · 把博客当成长期维护的软件系统"
  showAside={false}
  pageType="about"
  sidebarData={sidebarData}
>
  <SiteDashboard
    stats={{
      posts: sidebarData.totalPosts,
      categories: sidebarData.totalCategories,
      tags: sidebarData.totalTags,
      readingMinutes: sidebarData.totalReadingMinutes,
    }}
  />
</BlogLayout>
