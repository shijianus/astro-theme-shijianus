---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import FriendsDashboard from '../components/theme/FriendsDashboard.astro';
import { getPublicPosts } from '../lib/content';
import { createSidebarData } from '../lib/theme';

const posts = getPublicPosts(await getCollection('posts'));
const sidebarData = createSidebarData(posts);
---

<BlogLayout title="友人帐 | 友邻档案" showAside={false} pageType="page" sidebarData={sidebarData}>
  <FriendsDashboard />
</BlogLayout>
