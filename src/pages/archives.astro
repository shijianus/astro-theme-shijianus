---
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site';
import BlogLayout from '../layouts/BlogLayout.astro';
import { getPostPath, resolveCategory, resolveCover, resolveCoverAlt, sortPostsByDate } from '../lib/content';
import { createSidebarData, formatCompactDate, groupPostsByYear } from '../lib/theme';

const posts = sortPostsByDate(await getCollection('posts'));
const sidebarData = createSidebarData(posts);
const years = groupPostsByYear(posts);
let articleIndex = 0;
---

<BlogLayout title="归档" sidebarData={sidebarData} pageType="archives">
  <section id="archive" class="archive-page">
    <div class="article-sort-title">
      {siteConfig.pages.archives.title}
      <span> - {posts.length}</span>
    </div>

    <div class="article-sort">
      {years.map(([year, items]) => (
        <>
          <div class="article-sort-item year">{year}</div>
          {items.map((entry) => {
            articleIndex += 1;
            return (
              <article class="article-sort-item">
                <a class="article-sort-item-img" href={getPostPath(entry)}>
                  <img src={resolveCover(entry)} alt={resolveCoverAlt(entry)} loading="lazy" />
                </a>
                <div class="article-sort-item-info">
                  <a class="article-sort-item-title" href={getPostPath(entry)}>{entry.data.title}</a>
                  <div class="article-meta-wrap">
                    <span class="article-sort-item-time">
                      <time datetime={entry.data.pubDate.toISOString()}>{formatCompactDate(entry.data.pubDate)}</time>
                    </span>
                    <span class="article-sort-item-tags">{resolveCategory(entry)}</span>
                  </div>
                  <span class="article-sort-item-index">{articleIndex}</span>
                </div>
              </article>
            );
          })}
        </>
      ))}
    </div>
  </section>
</BlogLayout>
