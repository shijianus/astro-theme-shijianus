---
import { getCollection } from 'astro:content';
import PageHero from '../../components/theme/PageHero.astro';
import PostCard from '../../components/theme/PostCard.astro';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { collectCategories, resolveCategory, slugifySegment, sortPostsByDate } from '../../lib/content';
import { createSidebarData } from '../../lib/theme';

export async function getStaticPaths() {
  const posts = sortPostsByDate(await getCollection('posts'));
  const categories = collectCategories(posts);

  return categories.map((item) => ({
    params: { slug: item.slug },
    props: { categoryLabel: item.label },
  }));
}

const { categoryLabel } = Astro.props;
const posts = sortPostsByDate(await getCollection('posts'));
const currentPosts = posts.filter((entry) => slugifySegment(resolveCategory(entry)) === slugifySegment(categoryLabel));
const sidebarData = createSidebarData(posts);
---

<BlogLayout title={`分类: ${categoryLabel}`} sidebarData={sidebarData} pageType="category-detail">
  <Fragment slot="hero">
    <PageHero
      eyebrow="Category Detail"
      title={categoryLabel}
      summary={`当前分类下共有 ${currentPosts.length} 篇文章，统一沿用主题文章卡片系统。`}
      image="/media/shijianus/workbench.jpg"
      imageAlt="category detail background"
      meta={[`${currentPosts.length} posts`]}
    />
  </Fragment>

  <section class="space-y-4">
    {currentPosts.map((entry, index) => (
      <PostCard entry={entry} index={index} />
    ))}
  </section>
</BlogLayout>
