---
import { getCollection } from 'astro:content';
import PostCard from '../../components/theme/PostCard.astro';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { collectCategories, getCategoryPath, getPublicPosts, resolveCategory, slugifySegment } from '../../lib/content';
import { createSidebarData } from '../../lib/theme';

export const prerender = true;

export async function getStaticPaths() {
  const posts = getPublicPosts(await getCollection('posts'));
  const categories = collectCategories(posts);

  return categories.map((item) => ({
    params: { slug: item.slug },
    props: { categoryLabel: item.label },
  }));
}

const { categoryLabel } = Astro.props;
const posts = getPublicPosts(await getCollection('posts'));
const currentPosts = posts.filter((entry) => slugifySegment(resolveCategory(entry)) === slugifySegment(categoryLabel));
const sidebarData = createSidebarData(posts);
const latestEntry = currentPosts[0];
const earliestEntry = currentPosts[currentPosts.length - 1];
const latestYear = latestEntry?.data.pubDate.getFullYear();
const earliestYear = earliestEntry?.data.pubDate.getFullYear();
---

<BlogLayout title={`分类: ${categoryLabel}`} showAside={false} sidebarData={sidebarData} pageType="category-detail">
  <section class="taxonomy-page taxonomy-page--detail">
    <div class="taxonomy-shell">
      <header class="taxonomy-hero-card taxonomy-hero-card--category-detail theme-card" style="--taxonomy-accent:#5b8cff;">
        <div class="taxonomy-hero-card__content">
          <p class="eyebrow">分类详情</p>
          <h1>{categoryLabel}</h1>
          <p class="taxonomy-hero-card__summary">
            当前分类下共有 {currentPosts.length} 篇文章，沿用统一文章卡片顺序展开。
            {latestEntry && ` 最近更新于 ${latestEntry.data.pubDate.toLocaleDateString('zh-CN')}。`}
          </p>
          <div class="taxonomy-cloud taxonomy-cloud--categories">
            <a href="/categories/" style="--taxonomy-accent:#5b8cff;">
              <span>#全部分类</span>
            </a>
            <a href={getCategoryPath(categoryLabel)} style="--taxonomy-accent:#5b8cff;">
              <span>#{categoryLabel}</span>
              <sup>{currentPosts.length}</sup>
            </a>
          </div>
        </div>

        <div class="taxonomy-hero-card__stats">
          <span>
            <strong>{currentPosts.length}</strong>
            <small>文章</small>
          </span>
          <span>
            <strong>{latestYear ?? '-'}</strong>
            <small>最近年份</small>
          </span>
          <span>
            <strong>{earliestYear ?? '-'}</strong>
            <small>起始年份</small>
          </span>
        </div>
      </header>

      <section class="taxonomy-section-card taxonomy-section-card--detail" style="--taxonomy-accent:#5b8cff;">
        <div class="taxonomy-section-card__head">
          <p class="eyebrow">分类文章</p>
          <h2>该分类下的文章</h2>
          <p>继续使用站内统一卡片体系，便于和首页、归档页保持一致阅读节奏。</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {currentPosts.map((entry, index) => (
            <PostCard entry={entry} index={index} />
          ))}
        </div>
      </section>
    </div>
  </section>
</BlogLayout>
