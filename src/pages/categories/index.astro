---
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { collectCategories, sortPostsByDate } from '../../lib/content';
import { createSidebarData } from '../../lib/theme';

const posts = sortPostsByDate(await getCollection('posts'));
const categories = collectCategories(posts);
const sortedCategories = [...categories].sort(
  (left, right) => right.label.length - left.label.length || right.count - left.count || left.label.localeCompare(right.label),
);
const sidebarData = createSidebarData(posts);
const latestEntry = posts[0];
---

<BlogLayout title="分类" showAside={false} pageType="categories" sidebarData={sidebarData}>
  <section class="taxonomy-page taxonomy-page--categories">
    <div class="taxonomy-index-card theme-card" style="--taxonomy-accent:#5b8cff;">
      <header class="taxonomy-index-card__head">
        <p class="taxonomy-index-card__eyebrow">Category Index</p>
        <div class="taxonomy-index-card__title">
          <h1>{siteConfig.pages.categories.title}</h1>
          <p>
            {siteConfig.pages.categories.summary}
            {latestEntry && ` 最近更新于 ${latestEntry.data.pubDate.toLocaleDateString('zh-CN')}。`}
          </p>
        </div>
        <div class="taxonomy-index-card__meta" aria-label="分类页统计">
          <span>
            <strong>{categories.length}</strong>
            分类
          </span>
          <span>
            <strong>{posts.length}</strong>
            文章
          </span>
        </div>
      </header>

      <div class="tag-cloud-list is-center">
        <div id="tag">
          <div class="category-lists" id="tag-page-tags">
            {sortedCategories.map((item) => (
              <a href={`/categories/${item.slug}/`}>
                <span class="tags-punctuation">#</span>
                {item.label}
                <span class="tagsPageCount">{item.count}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BlogLayout>
