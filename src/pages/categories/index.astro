---
import { getCollection } from 'astro:content';
import PageHero from '../../components/theme/PageHero.astro';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { collectCategories, sortPostsByDate } from '../../lib/content';
import { createSidebarData, getLatestByCategory } from '../../lib/theme';

const posts = sortPostsByDate(await getCollection('posts'));
const categories = collectCategories(posts);
const latestByCategory = getLatestByCategory(posts);
const sidebarData = createSidebarData(posts);
---

<BlogLayout title="分类" sidebarData={sidebarData}>
  <Fragment slot="hero">
    <PageHero
      eyebrow="Category Index"
      title="从主题到文章的稳定入口"
      summary="分类页延续参考主题的强入口思路，但把视觉层次收紧，让入口更稳定、信息更容易扫读。"
      image="/media/shijianus/system.jpg"
      imageAlt="categories background"
      meta={[`${categories.length} categories`, `${posts.length} posts`]}
    />
  </Fragment>

  <section class="grid gap-4 md:grid-cols-2">
    {categories.map((item) => (
      <a href={`/categories/${item.slug}/`} class="theme-card theme-card--interactive block space-y-3">
        <p class="eyebrow">Category</p>
        <h2 class="text-2xl font-semibold text-[var(--text-strong)]">{item.label}</h2>
        <p class="text-sm text-[var(--text-soft)]">{item.count} 篇文章</p>
        <p class="text-sm leading-7 text-[var(--text-muted)]">最新文章：{latestByCategory.get(item.label) ?? '暂无'}</p>
      </a>
    ))}
  </section>
</BlogLayout>
