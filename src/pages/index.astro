---
import { getCollection } from 'astro:content';
import HomeFeed from '../components/theme/HomeFeed.astro';
import HomeHero from '../components/theme/HomeHero.astro';
import { siteConfig } from '../config/site';
import BlogLayout from '../layouts/BlogLayout.astro';
import { collectCategories, getFeaturedPosts, getPublicPosts } from '../lib/content';
import { getHomeFeedPage, resolveHomeFeedPageSize } from '../lib/home-feed';
import { createSidebarData } from '../lib/theme';

const posts = getPublicPosts(await getCollection('posts'));
const featuredPosts = getFeaturedPosts(posts, 4);
const categories = collectCategories(posts);
const sidebarData = createSidebarData(posts);
const categoryRail = siteConfig.home.categoryRail;
const homeFeed = getHomeFeedPage(posts, 1, resolveHomeFeedPageSize(siteConfig.home.feed.pageSize));
---

<BlogLayout title="首页" sidebarData={sidebarData} pageType="home">
  <Fragment slot="hero">
    <HomeHero featuredPosts={featuredPosts} latestPosts={posts} />
  </Fragment>

  <HomeFeed
    posts={homeFeed.posts}
    currentPage={homeFeed.currentPage}
    lastPage={homeFeed.lastPage}
    categories={categories}
    categoryRail={categoryRail}
  />
</BlogLayout>
