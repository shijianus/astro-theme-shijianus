---
import { getCollection } from 'astro:content';
import HomeHero from '../components/theme/HomeHero.astro';
import PostCard from '../components/theme/PostCard.astro';
import BlogLayout from '../layouts/BlogLayout.astro';
import { collectCategories, getFeaturedPosts, sortPostsByDate } from '../lib/content';
import { createSidebarData } from '../lib/theme';

const posts = sortPostsByDate(await getCollection('posts'));
const featuredPosts = getFeaturedPosts(posts, 4);
const categories = collectCategories(posts);
const sidebarData = createSidebarData(posts);
---

<BlogLayout title="首页" sidebarData={sidebarData} pageType="home">
  <Fragment slot="hero">
    <HomeHero featuredPosts={featuredPosts} latestPosts={posts} />
  </Fragment>

  <section id="recent-posts" class="recent-posts">
    <div id="categoryBar">
      <div class="category-bar" id="category-bar">
        <div id="catalog-bar">
          <div id="catalog-list">
            <div class="catalog-list-item is-active"><a href="/">首页</a></div>
            {categories.map((item) => (
              <div class="catalog-list-item">
                <a href={`/categories/${item.slug}/`}>{item.label}</a>
              </div>
            ))}
          </div>
          <a class="catalog-more" href="/categories/">更多</a>
        </div>
      </div>
    </div>

    {posts.map((entry, index) => (
      <PostCard entry={entry} index={index} />
    ))}
  </section>
</BlogLayout>
