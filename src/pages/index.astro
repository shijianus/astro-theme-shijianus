---
import { getCollection } from 'astro:content';
import { MacCodeBlock } from '../components/MacCodeBlock';
import HomeHero from '../components/theme/HomeHero.astro';
import PostCard from '../components/theme/PostCard.astro';
import BlogLayout from '../layouts/BlogLayout.astro';
import {
  collectArchives,
  collectCategories,
  collectTags,
  estimateReadingMinutes,
  getFeaturedPosts,
  sortPostsByDate,
} from '../lib/content';

const posts = sortPostsByDate(await getCollection('posts'));
const featuredPosts = getFeaturedPosts(posts, 4);
const categories = collectCategories(posts);
const tags = collectTags(posts);
const archives = collectArchives(posts);
const totalReadingMinutes = posts.reduce((total, entry) => total + estimateReadingMinutes(entry), 0);

const themeSnippet = `export const theme = {
  brand: 'shijianus',
  renderer: ['Astro', 'React'],
  sections: ['hero', 'feed', 'aside'],
  dataSource: 'local-now-api-later',
};`;
---

<BlogLayout
  title="首页"
  sidebarData={{
    recentPosts: posts,
    tags,
    archives,
    totalPosts: posts.length,
    totalCategories: categories.length,
    totalTags: tags.length,
    totalReadingMinutes,
  }}
>
  <Fragment slot="hero">
    <HomeHero featuredPosts={featuredPosts} latestPosts={posts} />
  </Fragment>

  <section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="space-y-3">
      <p class="eyebrow">Feed Overview</p>
      <h2 class="text-3xl font-semibold text-[var(--text-strong)] md:text-4xl">近期更新</h2>
      <p class="max-w-2xl text-sm leading-6 text-[var(--text-soft)]">
        版式延续强结构首页的阅读优势，但把信息组织改成更适合 shijianus 的节奏：明确分类入口、可扩展侧栏和稳定的内容流。
      </p>
      <div class="flex flex-wrap gap-2 border-y border-[var(--line)] py-3">
        <a href="/categories/" class="rounded-md bg-[var(--surface-muted)] px-3 py-1.5 text-sm text-[var(--text-soft)]">全部分类</a>
        {categories.map((item) => (
          <a
            href={`/categories/${item.slug}/`}
            class="rounded-md border border-[var(--line)] px-3 py-1.5 text-sm text-[var(--text-soft)] transition-colors hover:border-[var(--signal)] hover:text-[var(--text-strong)]"
          >
            {item.label} <span class="text-[var(--text-muted)]">({item.count})</span>
          </a>
        ))}
      </div>
    </div>
    <MacCodeBlock code={themeSnippet} language="ts" title="Theme Contract" client:load />
  </section>

  <section class="space-y-4">
    {posts.map((entry, index) => (
      <PostCard entry={entry} index={index} />
    ))}
  </section>
</BlogLayout>
