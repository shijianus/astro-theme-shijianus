---
import GeekLayout from '../layouts/GeekLayout.astro';
import { getCollection } from 'astro:content';
import { MacCodeBlock } from '../components/MacCodeBlock';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const welcomeCode = `// Welcome to SmartKevin's Blog v2
const profile = {
  name: "SmartKevin",
  role: "Biological Sciences & Web Dev",
  motto: "Code is the DNA of the future"
};

function explore() {
  console.log("Initializing geek experience...");
}

explore();`;
---

<GeekLayout title="Home">
	<section class="space-y-6">
		<div class="space-y-2">
			<h1 class="text-4xl md:text-6xl font-extrabold tracking-tighter">
				EXPLORING THE <span class="text-primary italic">FRONTIER</span>
			</h1>
			<p class="text-lg text-gray-400 font-medium">
				A digital sanctuary for thoughts on biology, engineering, and everything in between.
			</p>
		</div>

		<MacCodeBlock code={welcomeCode} language="typescript" client:load />

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			{sortedPosts.map((post) => (
				<a href={`/posts/${post.slug}`} class="group relative overflow-hidden rounded-3xl bg-white/5 border border-white/10 p-6 transition-all hover:bg-white/10 hover:border-primary/50">
					<div class="absolute top-0 right-0 p-4 opacity-20 group-hover:opacity-100 transition-opacity">
						<div class="text-[10px] font-mono font-bold uppercase tracking-[0.2em] text-primary bg-primary/10 px-2 py-1 rounded">
							{post.data.space}
						</div>
					</div>
					<div class="space-y-4">
						<span class="text-[10px] font-mono text-gray-500 uppercase tracking-widest">
							{post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
						</span>
						<h2 class="text-xl font-bold group-hover:text-primary transition-colors leading-tight">
							{post.data.title}
						</h2>
						<p class="text-sm text-gray-400 line-clamp-2">
							{post.data.description}
						</p>
						<div class="flex gap-2">
							{post.data.tags.map(tag => (
								<span class="text-[10px] bg-white/5 px-2 py-1 rounded-md text-gray-400">#{tag}</span>
							))}
						</div>
					</div>
				</a>
			))}
		</div>
	</section>
</GeekLayout>
