---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import GuestbookDashboard from '../components/theme/GuestbookDashboard.astro';
import { getPublicPosts } from '../lib/content';
import { createSidebarData } from '../lib/theme';

const posts = getPublicPosts(await getCollection('posts'));
const sidebarData = createSidebarData(posts);
---

<BlogLayout
  title="留言板 | 尺素寸心 · 读者留言与交流广场"
  description="欢迎来到 EpoCanvas 读者留言板。留下你的足迹、想法与问候，参与社区互动讨论与思想碰撞。"
  showAside={false}
  pageType="page"
  sidebarData={sidebarData}
>
  <GuestbookDashboard />
</BlogLayout>
