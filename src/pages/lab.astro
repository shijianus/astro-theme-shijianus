---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import LabDashboard from '../components/theme/LabDashboard.astro';
import { getPublicPosts } from '../lib/content';
import { createSidebarData } from '../lib/theme';

const posts = getPublicPosts(await getCollection('posts'));
const sidebarData = createSidebarData(posts);
---

<BlogLayout
  title="实验田 | 极客组件与交互实验室"
  description="探索代码表现力的边界。包含天体星轨模拟器、3D 气动纸飞机、Web Audio 触觉声效矩阵与多币种结算实验。"
  showAside={false}
  pageType="page"
  sidebarData={sidebarData}
>
  <LabDashboard />
</BlogLayout>
