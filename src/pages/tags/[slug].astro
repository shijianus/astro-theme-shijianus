---
import { getCollection } from 'astro:content';
import PostCard from '../../components/theme/PostCard.astro';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { collectTags, slugifySegment, sortPostsByDate } from '../../lib/content';
import { createSidebarData } from '../../lib/theme';

export async function getStaticPaths() {
  const posts = sortPostsByDate(await getCollection('posts'));
  const tags = collectTags(posts);

  return tags.map((item) => ({
    params: { slug: item.slug },
    props: { tagLabel: item.label },
  }));
}

const { tagLabel } = Astro.props;
const posts = sortPostsByDate(await getCollection('posts'));
const currentPosts = posts.filter((entry) => entry.data.tags.some((tag) => slugifySegment(tag) === slugifySegment(tagLabel)));
const sidebarData = createSidebarData(posts);
const latestEntry = currentPosts[0];
const earliestEntry = currentPosts[currentPosts.length - 1];
const latestYear = latestEntry?.data.pubDate.getFullYear();
const earliestYear = earliestEntry?.data.pubDate.getFullYear();
---

<BlogLayout title={`标签: ${tagLabel}`} showAside={false} sidebarData={sidebarData} pageType="tag-detail">
  <section class="taxonomy-page taxonomy-page--detail">
    <div class="taxonomy-shell">
      <header class="taxonomy-hero-card taxonomy-hero-card--tag-detail theme-card" style="--taxonomy-accent:#ff7d55;">
        <div class="taxonomy-hero-card__content">
          <p class="eyebrow">Tag Detail</p>
          <h1>#{tagLabel}</h1>
          <p class="taxonomy-hero-card__summary">
            当前标签下共有 {currentPosts.length} 篇文章，沿用统一文章卡片顺序展开。
            {latestEntry && ` 最近更新于 ${latestEntry.data.pubDate.toLocaleDateString('zh-CN')}。`}
          </p>
          <div class="taxonomy-cloud taxonomy-cloud--categories">
            <a href="/tags/" style="--taxonomy-accent:#ff7d55;">
              <span>#全部标签</span>
            </a>
            <a href={`/tags/${slugifySegment(tagLabel)}/`} style="--taxonomy-accent:#ff7d55;">
              <span>#{tagLabel}</span>
              <sup>{currentPosts.length}</sup>
            </a>
          </div>
        </div>

        <div class="taxonomy-hero-card__stats">
          <span>
            <strong>{currentPosts.length}</strong>
            <small>文章</small>
          </span>
          <span>
            <strong>{latestYear ?? '-'}</strong>
            <small>最近年份</small>
          </span>
          <span>
            <strong>{earliestYear ?? '-'}</strong>
            <small>起始年份</small>
          </span>
        </div>
      </header>

      <section class="taxonomy-section-card taxonomy-section-card--detail" style="--taxonomy-accent:#ff7d55;">
        <div class="taxonomy-section-card__head">
          <p class="eyebrow">Tag Posts</p>
          <h2>该标签下的文章</h2>
          <p>继续使用站内统一卡片体系，方便和首页、归档页保持一致阅读节奏。</p>
        </div>

        <div class="taxonomy-post-list">
          {currentPosts.map((entry, index) => (
            <PostCard entry={entry} index={index} />
          ))}
        </div>
      </section>
    </div>
  </section>
</BlogLayout>
