---
import { getCollection } from 'astro:content';
import PageHero from '../../components/theme/PageHero.astro';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { collectTags, sortPostsByDate } from '../../lib/content';
import { createSidebarData } from '../../lib/theme';

const posts = sortPostsByDate(await getCollection('posts'));
const tags = collectTags(posts);
const sidebarData = createSidebarData(posts);
---

<BlogLayout title="标签" sidebarData={sidebarData}>
  <Fragment slot="hero">
    <PageHero
      eyebrow="Tag Index"
      title="用标签串起相邻的主题"
      summary="标签页延续参考主题的高可点击密度，让相关内容之间的跳转保持直接和轻量。"
      image="/media/shijianus/frontend.jpg"
      imageAlt="tags background"
      meta={[`${tags.length} tags`, `${posts.length} posts`]}
    />
  </Fragment>

  <section class="theme-card theme-card--soft space-y-5">
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <a href={`/tags/${tag.slug}/`} class="theme-chip theme-chip--soft">
          #{tag.label}
          <span class="text-[var(--text-muted)]">({tag.count})</span>
        </a>
      ))}
    </div>
  </section>
</BlogLayout>
