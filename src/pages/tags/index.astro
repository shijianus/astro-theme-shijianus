---
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { collectTags, getTagPath, sortPostsByDate } from '../../lib/content';
import { createSidebarData } from '../../lib/theme';

const posts = sortPostsByDate(await getCollection('posts'));
const tags = collectTags(posts);
const sortedTags = [...tags].sort(
  (left, right) => right.label.length - left.label.length || right.count - left.count || left.label.localeCompare(right.label),
);
const sidebarData = createSidebarData(posts);
const latestEntry = posts[0];
---

<BlogLayout title="标签" showAside={false} pageType="tags" sidebarData={sidebarData}>
  <section class="taxonomy-page taxonomy-page--tags">
    <div class="taxonomy-index-card theme-card" style="--taxonomy-accent:#ff7d55;">
      <header class="taxonomy-index-card__head">
        <p class="taxonomy-index-card__eyebrow">Tag Index</p>
        <div class="taxonomy-index-card__title">
          <h1>{siteConfig.pages.tags.title}</h1>
          <p>
            {siteConfig.pages.tags.summary}
            {latestEntry && ` 最近更新于 ${latestEntry.data.pubDate.toLocaleDateString('zh-CN')}。`}
          </p>
        </div>
        <div class="taxonomy-index-card__meta" aria-label="标签页统计">
          <span>
            <strong>{tags.length}</strong>
            标签
          </span>
          <span>
            <strong>{posts.length}</strong>
            文章
          </span>
        </div>
      </header>

      <div class="tag-cloud-list is-center">
        <div id="tag">
          <div id="tag-page-tags">
            {sortedTags.map((tag, index) => (
              <a href={getTagPath(tag.slug)} style={`--tag-index:${index};`}>
                <span class="tags-punctuation">#</span>
                {tag.label}
                <span class="tagsPageCount">{tag.count}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BlogLayout>
