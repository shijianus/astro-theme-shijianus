---
import BlogLayout from '../layouts/BlogLayout.astro';
import PageHero from '../components/theme/PageHero.astro';
---

<BlogLayout title="404" showAside={false} pageType="404">
  <Fragment slot="hero">
    <PageHero
      eyebrow="404"
      title="这条路还没有被记录下来"
      summary="你可以回到首页继续浏览，或者直接进入归档查看现有文章。"
      image="/media/shijianus/network.jpg"
      imageAlt="404 background"
      meta={['Not Found']}
    />
  </Fragment>

  <section class="theme-card flex flex-wrap gap-3">
    <a href="/" class="theme-button">返回首页</a>
    <a href="/archives/" class="theme-button theme-button--ghost">查看归档</a>
  </section>
</BlogLayout>
