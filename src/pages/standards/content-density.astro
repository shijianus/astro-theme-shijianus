---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { calculateSiteMetrics } from '../../lib/site-metrics.ts';
import { createSidebarData } from '../../lib/theme.ts';
import { siteConfig } from '../../config/site.ts';
import { standardsConfig, matchContentDensityTier } from '../../config/standards.ts';
import { getPublicPosts, estimateWordCount, estimateReadingMinutes, getPostCanonicalSlug, getPostPath } from '../../lib/content.ts';

const allPosts = await getCollection('posts');
const publicPosts = getPublicPosts(allPosts);
const metrics = calculateSiteMetrics(allPosts);
const sidebarData = createSidebarData(allPosts);

const currentTier = matchContentDensityTier(metrics.avgWordsPerPost);

// 获取代表性长文深度样板（用于真实数据实证展示）
const sampleDeepPosts = [...publicPosts]
  .map((p) => {
    const words = (p.data as any).wordCount ?? estimateWordCount(p);
    const reading = (p.data as any).readingMinutes ?? estimateReadingMinutes(p);
    return {
      post: p,
      words,
      reading,
      title: p.data.title,
      path: getPostPath(p),
      canonical: getPostCanonicalSlug(p.id),
      tier: matchContentDensityTier(words),
    };
  })
  .sort((a, b) => b.words - a.words)
  .slice(0, 6);
---

<BlogLayout 
  title="全站内容密度分级与度量规范 (EES-003) - EpoCanvas Standards" 
  description="倡导硬核深度的技术沉淀，拒绝碎片灌水；基于全站物理文本字数、代码加权与信息密度的分级评定体系。"
  showAside={false}
  pageType="standards"
  sidebarData={sidebarData}
>
  <div class="standards-doc-container">
    <!-- 规范文档元信息头部 (RFC / Technical Spec Header) -->
    <header class="standards-doc-header">
      <div class="standards-doc-header__badge-row">
        <span class="standards-spec-badge">EES-2026.4 / Sub-Spec</span>
        <span class="standards-spec-status">● 生产环境持续生效</span>
        <span class="standards-spec-code">SPEC-ID: EES-003 (Content Density)</span>
      </div>
      <h1 class="standards-doc-header__title">系统工程标准：全站内容密度分级与度量规范</h1>
      <p class="standards-doc-header__lede">
        本规范（EES-003）是 EpoCanvas 工程标准体系的核心支柱之一，专门度量技术博客的信息厚度与篇幅深度。
        拒绝无意义灌水与碎片空洞，倡导体系化、高质量、图文代码兼备的深度硬核沉淀。
      </p>

      <div class="standards-doc-meta-grid">
        <div class="meta-item">
          <span class="meta-item__k">规范协议标准</span>
          <strong class="meta-item__v">EES-003 / v2.6.0</strong>
        </div>
        <div class="meta-item">
          <span class="meta-item__k">当前实时判定</span>
          <strong id="live-header-density-level" class="meta-item__v" style={{ color: currentTier.badgeColor }}>
            {currentTier.level} {currentTier.title} ({currentTier.status})
          </strong>
        </div>
        <div class="meta-item">
          <span class="meta-item__k">平均单篇字数</span>
          <strong class="meta-item__v">{metrics.avgWordsPerPost.toLocaleString()} 字/篇</strong>
        </div>
        <div class="meta-item">
          <span class="meta-item__k">上级标准总纲</span>
          <strong class="meta-item__v"><a href="/standards/">EES-001 工程标准总纲</a></strong>
        </div>
      </div>
    </header>

    <!-- 文档快速导航条 (Document Navigation Anchors) -->
    <nav class="standards-doc-nav" aria-label="内容密度规范目录导航">
      <a href="#section-assessment" class="doc-nav-pill">§ 1. 运行态实时判定与指标</a>
      <a href="#section-empirical" class="doc-nav-pill">§ 2. 深度长文样板实录</a>
      <a href="#section-pipeline" class="doc-nav-pill">§ 3. 纯文本清洗与度量流水线</a>
      <a href="#section-tiers" class="doc-nav-pill">§ 4. 四级密度阶梯完整对照表</a>
      <a href="#section-philosophy" class="doc-nav-pill">§ 5. 深度长文创作哲学</a>
      <a href="#section-config" class="doc-nav-pill">§ 6. 管理员配置白皮书</a>
      <a href="#section-related" class="doc-nav-pill">§ 7. 关联工程规范</a>
    </nav>

    <!-- § 1. 运行态实时判定与指标 -->
    <section class="standards-doc-section" id="section-assessment">
      <div class="section-title-wrap">
        <div class="section-num">1.0</div>
        <div>
          <h2 class="standards-section-title">运行态实时判定与核心指标快照 (Live Assessment Snapshot)</h2>
          <p class="standards-section-desc">当前站点在全量构建与边缘运行时精算的内容厚度物理快照。</p>
        </div>
      </div>

      <div class="card-webinfo-grid standards-webinfo-grid">
        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>当前密度等级</span>
          </div>
          <strong class="highlight-val" style={{ color: currentTier.badgeColor }}>
            {currentTier.level} ({currentTier.title})
          </strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>全站物理字数</span>
          </div>
          <strong>{metrics.totalWords.toLocaleString()} 字</strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>单篇平均字数</span>
          </div>
          <strong class="highlight-val">{metrics.avgWordsPerPost.toLocaleString()} 字</strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>阅读总耗时</span>
          </div>
          <strong>~{metrics.totalReadingMinutes} 分钟</strong>
        </div>
      </div>

      <!-- 进度条提示 -->
      <div class="tier-progress-card">
        <div class="tier-progress-card__header">
          <span class="tier-progress-label">内容深度指标饱和度 (Current Tier Saturation)</span>
          <span class="tier-progress-value">{metrics.standards.contentDensity.progressPercent}%</span>
        </div>
        <div class="tier-progress-bar">
          <div class="tier-progress-fill" style={`width: ${metrics.standards.contentDensity.progressPercent}%; background: ${currentTier.badgeColor};`}></div>
        </div>
        <p class="tier-progress-hint">
          {metrics.standards.contentDensity.nextMilestone}。全站已达最高阶梯 Lv.4 硬核深度长文标准。
        </p>
      </div>
    </section>

    <!-- § 2. 深度长文样板实录 -->
    <section class="standards-doc-section" id="section-empirical">
      <div class="section-title-wrap">
        <div class="section-num">2.0</div>
        <div>
          <h2 class="standards-section-title">全站代表性深度长文样板字数核验表 (Empirical Word Count Samples)</h2>
          <p class="standards-section-desc">直接提取本站物理文章库中最具代表性的深度专栏，验证度量结果。</p>
        </div>
      </div>

      <div class="standards-card">
        <h3 class="standards-card__title">2.1 代表性样板篇目实录</h3>
        <p>
          全站经去重后的 <strong>{publicPosts.length}</strong> 篇公开文章中，按清洗后的纯文本有效字符数降序排列，
          头部最具代表性的硬核技术博文样板如下表所示：
        </p>

        <div class="standards-table-wrapper" style="margin-top: 16px;">
          <table class="standards-table">
            <thead>
              <tr>
                <th style="width: 50px;">序号</th>
                <th>文章标题</th>
                <th>规范标识 (Canonical Slug)</th>
                <th>物理字数 (清洗后)</th>
                <th>预估阅读</th>
                <th>富媒体组件支撑</th>
                <th>单篇密度评级</th>
              </tr>
            </thead>
            <tbody>
              {sampleDeepPosts.map((item, idx) => (
                <tr>
                  <td style="font-family: var(--font-family-mono); font-weight: 700; color: var(--text-muted);">{idx + 1}</td>
                  <td>
                    <a href={item.path} class="post-table-link">
                      <strong>{item.title}</strong>
                    </a>
                  </td>
                  <td style="font-family: var(--font-family-mono); font-size: 11.5px; color: var(--text-muted);">{item.canonical}</td>
                  <td style="font-family: var(--font-family-mono); font-weight: 700;">{item.words.toLocaleString()} 字</td>
                  <td style="font-family: var(--font-family-mono);">{item.reading} 分钟</td>
                  <td>
                    <span class="rich-media-tag">Markmap + 代码块 + 表格</span>
                  </td>
                  <td>
                    <span class="current-badge-indicator" style={{ background: item.tier.badgeColor, color: '#fff' }}>
                      {item.tier.level} {item.tier.title}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="audit-summary-note" style="margin-top: 16px;">
          <strong>审计结论：</strong>
          全站 {publicPosts.length} 篇公开文章物理文本总字数累计为 <strong>{metrics.totalWords.toLocaleString()} 字</strong>，
          单篇加权平均字数达到 <strong>{metrics.avgWordsPerPost.toLocaleString()} 字/篇</strong>，
          远超 EES-003 规范设定的 Lv.4 硬核深度长文门槛（&gt; 3,000 字），
          客观物理判定本站整体内容深度为最高梯队 <strong>{currentTier.level} {currentTier.title}</strong>。
        </div>
      </div>
    </section>

    <!-- § 3. 纯文本清洗与度量流水线 -->
    <section class="standards-doc-section" id="section-pipeline">
      <div class="section-title-wrap">
        <div class="section-num">3.0</div>
        <div>
          <h2 class="standards-section-title">纯文本清洗与字数度量流水线 (Text Normalization Pipeline)</h2>
          <p class="standards-section-desc">严谨的字数统计算法，排除 HTML 标签、Frontmatter 噪音与 Markdown 语法虚增。</p>
        </div>
      </div>

      <div class="standards-card">
        <h3 class="standards-card__title">3.1 算法模型与噪声过滤</h3>
        <p>
          未经处理的原始 Markdown 文件往往包含大量 YAML Frontmatter 元数据、HTML 行内标记、图片直链与语法控制字符。
          若直接统计字节或原生字符，将造成严重的字数虚高。EES-003 强制执行标准化文本清洗流水线：
        </p>
        <div class="formula-box">
          <code>RawFile → StripYAML(Frontmatter) → CleanMarkdown(AST) → Tokenize(CJK + Latin)</code><br />
          <code>WordCount = Count(CJK_Chars) + Count(Latin_Word_Tokens)</code>
        </div>
        <p>
          系统将中日韩（CJK）单字与连续拉丁单词（英文、德文、法文单词以空格为界）统一归一化计算，确保多语言文章字数测算具备跨语种的一致性与可比性。
        </p>

        <h3 class="standards-card__title" style="margin-top: 24px;">3.2 代码块与多媒体加权规则</h3>
        <ul class="standards-list">
          <li><strong>代码块内容规范计入</strong>：可执行的技术代码、架构配置与命令段落是技术文章的重要组成部分，算法剥离纯空行与闭合花括号后，按标准词法单元计入正文字数；</li>
          <li><strong>数学公式 (LaTeX) 适度加权</strong>：复杂的数学推导块按公式符号与变量个数归一化为等效词数；</li>
          <li><strong>严禁图片直链刷量</strong>：图片 Base64 或长图直链 URL 严格剔除，杜绝利用资源 URL 伪造巨幅字数。</li>
        </ul>
      </div>
    </section>

    <!-- § 4. 四级密度阶梯完整对照表 -->
    <section class="standards-doc-section" id="section-tiers">
      <div class="section-title-wrap">
        <div class="section-num">4.0</div>
        <div>
          <h2 class="standards-section-title">四级密度阶梯完整对照表 (Density Tiers Matrix)</h2>
          <p class="standards-section-desc">合理梯度划分：从碎片化速记到万字系统工程长文的阶梯定位。</p>
        </div>
      </div>

      <div class="standards-table-wrapper">
        <table class="standards-table">
          <thead>
            <tr>
              <th style="width: 100px;">阶梯代号</th>
              <th style="width: 150px;">阶梯名称</th>
              <th style="width: 160px;">单篇平均字数阈值</th>
              <th style="width: 120px;">系统状态</th>
              <th>评估基准与内容形态指引</th>
              <th style="width: 100px;">当前匹配</th>
            </tr>
          </thead>
          <tbody>
            {standardsConfig.contentDensityLevels.map((tier) => {
              const isMatch = tier.level === currentTier.level;
              return (
                <tr class={isMatch ? 'is-current-tier' : ''}>
                  <td style="font-family: var(--font-family-mono); font-weight: 700; color: tier.badgeColor;">
                    {tier.level}
                  </td>
                  <td>
                    <strong>{tier.title}</strong>
                  </td>
                  <td style="font-family: var(--font-family-mono);">
                    {tier.maxAvgWords ? `${tier.minAvgWords} ~ ${tier.maxAvgWords} 字` : `> ${tier.minAvgWords - 1} 字`}
                  </td>
                  <td>
                    <span class="status-code-badge">{tier.status}</span>
                  </td>
                  <td>{tier.description} ({tier.readingExpectation})</td>
                  <td>
                    {isMatch ? (
                      <span class="current-badge-indicator" style={{ background: tier.badgeColor, color: '#fff' }}>
                        当前命中
                      </span>
                    ) : (
                      <span class="non-current-dash">-</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- § 5. 深度长文创作哲学 -->
    <section class="standards-doc-section" id="section-philosophy">
      <div class="section-title-wrap">
        <div class="section-num">5.0</div>
        <div>
          <h2 class="standards-section-title">深度长文创作哲学 (Engineering Content Philosophy)</h2>
          <p class="standards-section-desc">为什么 EpoCanvas 坚定推崇 3000+ 字的硬核深度长文？</p>
        </div>
      </div>

      <div class="standards-card">
        <h3 class="standards-card__title">5.1 拒绝碎片灌水，坚守技术复现性</h3>
        <p>
          在信息快餐时代，仅贴几行命令或简单配置的“碎碎念”缺乏系统性思考与长远沉淀价值。
          一篇真正能穿越时间的技术博文，必须包含<strong>背景动机、架构演进对比、边界踩坑记录、完整复现步骤与性能压测数据</strong>。
          这类文章往往自然达到 3,000 字以上。
        </p>

        <h3 class="standards-card__title" style="margin-top: 24px;">5.2 强大排版引擎对长文的护航</h3>
        <p>
          长篇技术博文若缺乏优秀的排版工具，容易引起读者的阅读疲劳。
          为此，本博客专门实装并打磨了：
        </p>
        <ul class="standards-list">
          <li><strong>粘性浮动目录 (Sticky TOC)</strong>：多层级唯一高亮聚焦，支持卡片内平滑独立滚动；</li>
          <li><strong>交互式思维导图 (Markmap Engine)</strong>：在正文中将万字复杂架构自动渲染为可缩放、折叠的心智图谱；</li>
          <li><strong>代码组与多语言标签切换 (Code Groups & Tabs)</strong>：在有限视口内优雅容纳多语言、多平台实现方案；</li>
          <li><strong>沉浸式阅读模式 (Immersive Readmode)</strong>：一键屏蔽所有外部干扰，聚焦纯净代码与长文精读。</li>
        </ul>
      </div>
    </section>

    <!-- § 6. 管理员配置白皮书 -->
    <section class="standards-doc-section" id="section-config">
      <div class="section-title-wrap">
        <div class="section-num">6.0</div>
        <div>
          <h2 class="standards-section-title">管理员配置白皮书 (Administrator Configuration)</h2>
          <p class="standards-section-desc">开放透明、支持个性化定制的配置文件机制。</p>
        </div>
      </div>

      <div class="standards-card">
        <p>
          站长可在 <code>src/config/standards.ts</code> 中按需定义或微调单篇字数梯队阈值：
        </p>
        <pre class="code-block-preview"><code>{`// src/config/standards.ts
export const standardsConfig = {
  contentDensityTiers: [
    { min: 0, max: 800, level: 'Lv.1', status: 'Level 1 (Micro)', title: '微动态速记', badgeColor: '#8c959f', ... },
    { min: 801, max: 1500, level: 'Lv.2', status: 'Level 2 (Standard)', title: '标准技术博文', badgeColor: '#2da44e', ... },
    { min: 1501, max: 3000, level: 'Lv.3', status: 'Level 3 (Comprehensive)', title: '详实系统专栏', badgeColor: '#0969da', ... },
    { min: 3001, max: Infinity, level: 'Lv.4', status: 'Level 4 (Ultra)', title: '硬核深度长文', badgeColor: '#8250df', ... },
  ],
};`}</code></pre>
      </div>
    </section>

    <!-- § 7. 关联工程规范 -->
    <section class="standards-doc-section" id="section-related">
      <div class="section-title-wrap">
        <div class="section-num">7.0</div>
        <div>
          <h2 class="standards-section-title">关联工程规范 (Cross-Specification Links)</h2>
          <p class="standards-section-desc">EpoCanvas 工程标准体系由多个互锁规范共同构建。</p>
        </div>
      </div>

      <div class="cross-spec-grid">
        <a href="/standards/activity-level/" class="cross-spec-card">
          <div class="cross-spec-card__badge">EES-002</div>
          <div class="cross-spec-card__title">系统工程标准：站长活跃等级分级与评估规范 →</div>
          <p class="cross-spec-card__desc">
            深入探索滚动 30 天滑动窗口发布模型、多语言版本去重流水线与五级创作活跃度判定。
          </p>
        </a>

        <a href="/standards/" class="cross-spec-card">
          <div class="cross-spec-card__badge">EES-001</div>
          <div class="cross-spec-card__title">返回系统工程标准总纲 (Portal Hub) →</div>
          <p class="cross-spec-card__desc">
            查阅 8 项核心仪表盘、架构 SLA 指标清单、徽章体系与完整数据字典 API 契约。
          </p>
        </a>
      </div>
    </section>

    <!-- 客户端边缘动态校准脚本 -->
    <script is:inline>
      (async function checkLiveDensityStatus() {
        try {
          const res = await fetch('/api/console/data');
          if (!res.ok) return;
          const data = await res.json();
          if (!data || !data.stats) return;

          const densityLevel = data.stats.densityLevel;
          const densityTitle = data.stats.densityTitle;

          const liveHeaderEl = document.getElementById('live-header-density-level');
          if (liveHeaderEl) liveHeaderEl.textContent = densityLevel + ' ' + densityTitle;
        } catch (_) {}
      })();
    </script>
  </div>
</BlogLayout>

<style>
  .standards-doc-container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .standards-doc-header__badge-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .standards-spec-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--theme-main, #425aef);
    background: rgba(66, 90, 239, 0.1);
    padding: 4px 10px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    font-family: var(--font-family-mono, monospace);
  }

  .standards-spec-status {
    font-size: 12px;
    font-weight: 500;
    color: #2da44e;
  }

  .standards-spec-code {
    font-size: 11px;
    color: var(--text-muted, #656d76);
    font-family: var(--font-family-mono, monospace);
    margin-left: auto;
  }

  .standards-doc-header__title {
    font-size: 30px;
    font-weight: 800;
    margin: 0 0 14px 0;
    color: var(--font-color, #1f2328);
    letter-spacing: -0.6px;
    line-height: 1.25;
  }

  .standards-doc-header__lede {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-muted, #57606a);
    margin: 0 0 24px 0;
    max-width: 900px;
  }

  .standards-doc-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid rgba(66, 90, 239, 0.15);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meta-item__k {
    font-size: 11px;
    color: var(--text-muted, #8c959f);
    text-transform: uppercase;
