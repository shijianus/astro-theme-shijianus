    flex-direction: column;
    justify-content: space-between;
    min-height: 80px;
  }

  .standards-webinfo-grid .webinfo-item-label {
    font-size: 12px;
    color: var(--font-color-sub);
  }

  .standards-webinfo-grid .webinfo-item strong {
    font-size: 18px !important;
    font-weight: 800;
    font-family: var(--font-family-mono);
    color: var(--font-color);
  }

  .tier-progress-card {
    background: var(--theme-card-bg);
    border: 1px solid var(--theme-border-light);
    border-radius: 8px;
    padding: 18px;
  }

  .tier-progress-card__header {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .tier-progress-bar {
    width: 100%;
    height: 8px;
    background: rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 8px;
  }

  .tier-progress-fill {
    height: 100%;
    transition: width 0.3s ease;
  }

  .tier-progress-hint {
    font-size: 12px;
    color: var(--font-color-sub);
    margin: 0;
  }

  .standards-card {
    background: var(--theme-card-bg);
    border: 1px solid var(--theme-border-light);
    border-radius: 8px;
    padding: 24px;
    line-height: 1.7;
    font-size: 14px;
  }

  .standards-card__title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 10px 0;
    color: var(--font-color);
  }

  .formula-box {
    background: rgba(0, 0, 0, 0.04);
    border-left: 3px solid var(--theme-main);
    padding: 12px 16px;
    border-radius: 4px;
    margin: 14px 0;
    font-family: var(--font-family-mono);
    font-size: 13px;
  }

  .standards-list {
    margin: 10px 0 0 0;
    padding-left: 20px;
  }

  .standards-list li {
    margin-bottom: 8px;
  }

  .standards-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--theme-border-light);
    border-radius: 8px;
    background: var(--theme-card-bg);
  }

  .standards-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }

  .standards-table th {
    background: rgba(0, 0, 0, 0.03);
    padding: 12px 16px;
    font-weight: 700;
    color: var(--font-color-sub);
    border-bottom: 1px solid var(--theme-border-light);
  }

  .standards-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--theme-border-light);
    color: var(--font-color);
  }

  .standards-table tr.is-current-tier {
    background: rgba(66, 90, 239, 0.07);
  }

  .standards-table tr.is-current-tier td {
    font-weight: 600;
  }

  .tier-badge {
    font-family: var(--font-family-mono);
