---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { calculateSiteMetrics } from '../../lib/site-metrics.ts';
import { createSidebarData } from '../../lib/theme.ts';
import { siteConfig } from '../../config/site.ts';
import { standardsConfig, matchActivityTier } from '../../config/standards.ts';
import { getPublicPosts, estimateWordCount, getPostCanonicalSlug, getPostPath } from '../../lib/content.ts';

const allPosts = await getCollection('posts');
const publicPosts = getPublicPosts(allPosts);
const metrics = calculateSiteMetrics(allPosts);
const sidebarData = createSidebarData(allPosts);

const currentTier = matchActivityTier(metrics.recentPostCount30d);

const now = new Date();
const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);

// 获取处于近 30 天滑动窗口内的实际文章列表（用于真实数据实证展示）
const recentActivePosts = publicPosts
  .filter((post) => {
    const pub = new Date(post.data.pubDate);
    return pub >= thirtyDaysAgo && pub <= now;
  })
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<BlogLayout 
  title="站长活跃等级分级与评估规范 (EES-002) - EpoCanvas Standards" 
  description="基于滚动时间窗口发布频度、心跳持续度与防刷去重机制的站长活跃度物理精算模型与分级规范。"
  showAside={false}
  pageType="standards"
  sidebarData={sidebarData}
>
  <div class="standards-doc-container">
    <!-- 规范文档元信息头部 (RFC / Technical Spec Header) -->
    <header class="standards-doc-header">
      <div class="standards-doc-header__badge-row">
        <span class="standards-spec-badge">EES-2026.4 / Sub-Spec</span>
        <span class="standards-spec-status">● 生产环境持续生效</span>
        <span class="standards-spec-code">SPEC-ID: EES-002 (Activity Level)</span>
      </div>
      <h1 class="standards-doc-header__title">系统工程标准：站长活跃等级分级与评估规范</h1>
      <p class="standards-doc-header__lede">
        本规范（EES-002）是 EpoCanvas 工程标准体系的重要支柱，专门定义站长与内容维护团队的发布活跃度度量准则。
        杜绝“伪活跃”与商业化“日更水文”，以滚动 30 天为时间窗口，客观映射技术沉淀与系统维护节奏。
      </p>

      <div class="standards-doc-meta-grid">
        <div class="meta-item">
          <span class="meta-item__k">规范协议标准</span>
          <strong class="meta-item__v">EES-002 / v2.6.0</strong>
        </div>
        <div class="meta-item">
          <span class="meta-item__k">当前实时判定</span>
          <strong id="live-header-active-level" class="meta-item__v" style={{ color: currentTier.badgeColor }}>
            {currentTier.level} {currentTier.title} ({currentTier.status})
          </strong>
        </div>
        <div class="meta-item">
          <span class="meta-item__k">精算时间窗口</span>
          <strong class="meta-item__v">Rolling 30 Days (滑动 30 天)</strong>
        </div>
        <div class="meta-item">
          <span class="meta-item__k">上级标准总纲</span>
          <strong class="meta-item__v"><a href="/standards/">EES-001 工程标准总纲</a></strong>
        </div>
      </div>
    </header>

    <!-- 文档快速导航条 (Document Navigation Anchors) -->
    <nav class="standards-doc-nav" aria-label="活跃等级规范目录导航">
      <a href="#section-assessment" class="doc-nav-pill">§ 1. 运行态实时判定与实证</a>
      <a href="#section-empirical" class="doc-nav-pill">§ 2. 近30天发文实录</a>
      <a href="#section-algorithm" class="doc-nav-pill">§ 3. 评定算法与数学模型</a>
      <a href="#section-tiers" class="doc-nav-pill">§ 4. 五级阶梯完整对照表</a>
      <a href="#section-cadence" class="doc-nav-pill">§ 5. 创作节奏与心跳衰减</a>
      <a href="#section-config" class="doc-nav-pill">§ 6. 管理员配置白皮书</a>
      <a href="#section-related" class="doc-nav-pill">§ 7. 关联工程规范</a>
    </nav>

    <!-- § 1. 运行态实时判定与实证 -->
    <section class="standards-doc-section" id="section-assessment">
      <div class="section-title-wrap">
        <div class="section-num">1.0</div>
        <div>
          <h2 class="standards-section-title">运行态实时判定与指标快照 (Live Assessment Snapshot)</h2>
          <p class="standards-section-desc">当前站点构建与边缘运行时双向校准的核心物理数据，杜绝虚假造假。</p>
        </div>
      </div>

      <div class="card-webinfo-grid standards-webinfo-grid">
        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>当前活跃等级</span>
          </div>
          <strong id="live-active-level" class="highlight-val" style={{ color: currentTier.badgeColor }}>
            {currentTier.level} ({currentTier.title})
          </strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>近 30 天有效发文</span>
          </div>
          <strong id="live-recent-count">{metrics.recentPostCount30d} 篇</strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>全站公开文章总数</span>
          </div>
          <strong>{metrics.totalPosts} 篇</strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>全站安全运行</span>
          </div>
          <strong id="live-uptime-days">{metrics.uptimeDays} 天</strong>
        </div>
      </div>

      <!-- 进度条提示 -->
      <div class="tier-progress-card">
        <div class="tier-progress-card__header">
          <span class="tier-progress-label">活跃度指标进展 (Current Tier Progress)</span>
          <span id="live-progress-val" class="tier-progress-value">{metrics.standards.activeLevel.progressPercent}%</span>
        </div>
        <div class="tier-progress-bar">
          <div id="live-progress-fill" class="tier-progress-fill" style={`width: ${metrics.standards.activeLevel.progressPercent}%; background: ${currentTier.badgeColor};`}></div>
        </div>
        <p id="live-milestone-hint" class="tier-progress-hint">
          {metrics.standards.activeLevel.nextMilestone}。数据严格基于近 30 天公开 Markdown 正文时间戳计算。
        </p>
      </div>
    </section>

    <!-- § 2. 近30天发文实录 -->
    <section class="standards-doc-section" id="section-empirical">
      <div class="section-title-wrap">
        <div class="section-num">2.0</div>
        <div>
          <h2 class="standards-section-title">近 30 天滑动窗口发文实录与时间戳核验表 (Rolling 30-Day Empirical Audit)</h2>
          <p class="standards-section-desc">直接提取本站物理文章库，公开接受真实性审计与校验。</p>
        </div>
      </div>

      <div class="standards-card">
        <h3 class="standards-card__title">2.1 物理发文审计明细清单</h3>
        <p>
          在当前请求或构建时刻 $T$，系统扫描全站所有 <code>src/content/posts/</code> 目录下的 Markdown/MDX 条目，
          经多语言版本归一化去重后，共筛选出 <strong>{publicPosts.length}</strong> 篇独立有效文章。
          其中发布时间落入时间窗口 <code>[T - 30d, T]</code> 的文章明细如下表所示：
        </p>

        <div class="standards-table-wrapper" style="margin-top: 16px;">
          <table class="standards-table">
            <thead>
              <tr>
                <th style="width: 50px;">序号</th>
                <th>文章标题</th>
                <th>规范标识 (Canonical Slug)</th>
                <th>发布日期 (pubDate)</th>
                <th>距今周期</th>
                <th>物理字数</th>
                <th>判定状态</th>
              </tr>
            </thead>
            <tbody>
              {recentActivePosts.length === 0 ? (
                <tr>
                  <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 24px;">
                    近 30 天暂无新发布文章，系统处于 Lv.0 维护休眠周期。
                  </td>
                </tr>
              ) : (
                recentActivePosts.map((post, idx) => {
                  const pDate = new Date(post.data.pubDate);
                  const daysAgo = Math.floor((now.getTime() - pDate.getTime()) / (1000 * 60 * 60 * 24));
                  const words = (post.data as any).wordCount ?? estimateWordCount(post);
                  const path = getPostPath(post);
                  const canonical = getPostCanonicalSlug(post.id);
                  return (
                    <tr>
                      <td style="font-family: var(--font-family-mono); font-weight: 700; color: var(--text-muted);">{idx + 1}</td>
                      <td>
                        <a href={path} class="post-table-link">
                          <strong>{post.data.title}</strong>
                        </a>
                      </td>
                      <td style="font-family: var(--font-family-mono); font-size: 11.5px; color: var(--text-muted);">{canonical}</td>
                      <td style="font-family: var(--font-family-mono);">{pDate.toLocaleDateString('zh-CN')}</td>
                      <td>
                        <span class="days-ago-badge">{daysAgo === 0 ? '今日发布' : `${daysAgo} 天前`}</span>
                      </td>
                      <td style="font-family: var(--font-family-mono);">{words.toLocaleString()} 字</td>
                      <td>
                        <span class="tier-status-pill tier-status-pill--active">✓ 计入有效活跃</span>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>

        <div class="audit-summary-note" style="margin-top: 16px;">
          <strong>审计结论：</strong>
          全站共有 {publicPosts.length} 篇去重公开发表文章，当前 30 天滑动窗口内的实际发文数为 <strong>{recentActivePosts.length} 篇</strong>，
          其余 {Math.max(0, publicPosts.length - recentActivePosts.length)} 篇已安全归档为站内长效资产。
          根据 EES-002 规则，{recentActivePosts.length} 篇严格落入 <code>[{currentTier.minPosts}, {currentTier.maxPosts ?? '∞'}]</code> 梯队区间，
          故本站当前权威评级物理裁决为 <strong>{currentTier.level} {currentTier.title}</strong>。
        </div>
      </div>
    </section>

    <!-- § 3. 评定算法与数学模型 -->
    <section class="standards-doc-section" id="section-algorithm">
      <div class="section-title-wrap">
        <div class="section-num">3.0</div>
        <div>
          <h2 class="standards-section-title">评定算法与数学模型 (Algorithm & Formula)</h2>
          <p class="standards-section-desc">客观严谨的算法设计，杜绝日更疲劳，杜绝跨月数据断崖。</p>
        </div>
      </div>

      <div class="standards-card">
        <h3 class="standards-card__title">3.1 为什么采用滚动 30 天窗口 (Rolling 30-Day Window)？</h3>
        <p>
          传统博客若按“自然月”统计（如每月 1 号重置为 0），会导致月初全站数据跌入“断崖休眠态”，严重扭曲真实的创作节奏。
          EES-002 规范强制采用<strong>时间滑动窗口</strong>：
        </p>
        <div class="formula-box">
          <code>{'Window(t) = [t - 30 days, t]'}</code><br />
          <code>{'Score(t) = Count(validPosts where pubDate ∈ Window(t))'}</code>
        </div>
        <p>
          任意时刻客户端或 API 请求到达时，系统精确截取当前时间戳前推 720 小时的时间切片，真实反映近期的连续维护热度。
        </p>

        <h3 class="standards-card__title" style="margin-top: 24px;">3.2 多语言版本归一化去重流水线</h3>
        <p>
          本站作为多语言国际化技术博客，单篇深度长文通常提供简体中文、繁体中文、英文、法文、德文、西班牙文等多语种版本。
          若将翻译衍生版本计为新发文章，将产生严重的“虚假繁荣”欺骗。为此，EES-002 执行如下流水线：
        </p>
        <ul class="standards-list">
          <li><strong>Canonical Key 提取</strong>：通过正则清洗后缀 <code>-en</code>, <code>-zh-hant</code>, <code>-fr</code> 等，提取唯一母体标识；</li>
          <li><strong>时间戳物理继承</strong>：各翻译版本严格共享母体文章的原始 <code>pubDate</code>；</li>
          <li><strong>多对一合并映射</strong>：同一个 Canonical Key 在 30 天窗口内无论存在多少个语言变体，<strong>仅且计入 1 篇</strong>；</li>
          <li><strong>草稿与隐藏条目隔离</strong>：标记 <code>draft: true</code> 或包含 <code>access</code> 权限锁定的条目直接排除在计数外。</li>
        </ul>

        <h3 class="standards-card__title" style="margin-top: 24px;">3.3 未来时间戳异常拦截 (Future-dating Protection)</h3>
        <p>
          若博主在文章 frontmatter 中误填或预设了未来日期（即 <code>t_pub &gt; t_now</code>），
          算法一律视为未到期预告，严格不计入有效活跃篇数，杜绝通过篡改时间抢跑指标。
        </p>
      </div>
    </section>

    <!-- § 4. 五级阶梯完整对照表 -->
    <section class="standards-doc-section" id="section-tiers">
      <div class="section-title-wrap">
        <div class="section-num">4.0</div>
        <div>
          <h2 class="standards-section-title">五级阶梯完整对照表 (Tiers Specification)</h2>
          <p class="standards-section-desc">合理梯度划分：既不过于苛刻（非商业日更媒体），也不过低失效。</p>
        </div>
      </div>

      <div class="standards-table-wrapper">
        <table class="standards-table">
          <thead>
            <tr>
              <th style="width: 100px;">阶梯代号</th>
              <th style="width: 140px;">阶梯名称</th>
              <th style="width: 140px;">近 30 天篇数阈值</th>
              <th style="width: 120px;">系统状态</th>
              <th>评估基准与创作节奏指引</th>
              <th style="width: 100px;">当前匹配</th>
            </tr>
          </thead>
          <tbody>
            {standardsConfig.activityLevels.map((tier) => {
              const isMatch = tier.level === currentTier.level;
              return (
                <tr class={isMatch ? 'is-current-tier' : ''}>
                  <td style="font-family: var(--font-family-mono); font-weight: 700; color: tier.badgeColor;">
                    {tier.level}
                  </td>
                  <td>
                    <strong>{tier.title}</strong>
                  </td>
                  <td style="font-family: var(--font-family-mono);">
                    {tier.maxPosts ? `${tier.minPosts} ~ ${tier.maxPosts} 篇` : `≥ ${tier.minPosts} 篇`}
                  </td>
                  <td>
                    <span class="status-code-badge">{tier.status}</span>
                  </td>
                  <td>{tier.description} ({tier.paceGuide})</td>
                  <td>
                    {isMatch ? (
                      <span class="current-badge-indicator" style={{ background: tier.badgeColor, color: '#fff' }}>
                        当前命中
                      </span>
                    ) : (
                      <span class="non-current-dash">-</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- § 5. 创作节奏与心跳衰减 -->
    <section class="standards-doc-section" id="section-cadence">
      <div class="section-title-wrap">
        <div class="section-num">5.0</div>
        <div>
          <h2 class="standards-section-title">创作节奏与心跳衰减 (Cadence & Heartbeat Decay)</h2>
          <p class="standards-section-desc">动态平衡：文章滑出窗口时的优雅衰减与可持续维护理念。</p>
        </div>
      </div>

      <div class="standards-card">
        <h3 class="standards-card__title">5.1 动态心跳衰减机制 (Decay Lifecycle)</h3>
        <p>
          由于采用滚动 30 天滑动窗口，随着时间推移，30 天前发布的历史文章将逐篇滑出统计窗口：
        </p>
        <ul class="standards-list">
          <li><strong>自然衰减</strong>：若站长在过去 30 天内发布了 6 篇文章（Lv.3），在随后的 15 天内未发布任何新文章，早期的 3 篇文章将超出 30 天窗口，活跃篇数自然回落至 3 篇（降级至 Lv.2 稳定维护）；</li>
          <li><strong>平稳过渡</strong>：衰减过程基于物理日历日连续演变，绝不出现月末月初始终重置为零的突兀震荡；</li>
          <li><strong>持续心跳</strong>：站长仅需保持每周 1~2 篇的稳定产出节奏，即可长期稳固在 Lv.3 高频迭代状态。</li>
        </ul>

        <h3 class="standards-card__title" style="margin-top: 24px;">5.2 质量第一导向：为何不设立“日更狂潮”？</h3>
        <p>
          EpoCanvas 坚决反对为了追求所谓“极客狂热 (Lv.4)”而进行无思考的低质“水文灌水”。
          真正的系统工程与技术演进需要经历<strong>调研、实验、代码落地、压测与经验提炼</strong>。
          因此，EES-002 将 Lv.3 (5~8篇/月) 作为技术博客推荐的“黄金高频段”，倡导保持思考沉淀的从容创作。
        </p>
      </div>
    </section>

    <!-- § 6. 管理员配置白皮书 -->
    <section class="standards-doc-section" id="section-config">
      <div class="section-title-wrap">
        <div class="section-num">6.0</div>
        <div>
          <h2 class="standards-section-title">管理员配置白皮书 (Administrator Configuration)</h2>
          <p class="standards-section-desc">开放透明、支持个性化定制的配置文件机制。</p>
        </div>
      </div>

      <div class="standards-card">
        <p>
          站长可在 <code>src/config/standards.ts</code> 中根据个人创作习惯自由调整各阶梯的阈值与文案描述。
          修改后，全站 SSG 编译构建、侧边栏小部件、控制台热力图与边缘 Functions API 将自动完成镜像同步：
        </p>
        <pre class="code-block-preview"><code>{`// src/config/standards.ts
export const standardsConfig = {
  activityLevelTiers: [
    { min: 0, max: 0, level: 'Lv.0', status: 'Status 0', title: '维护休眠', badgeColor: '#8c959f', ... },
    { min: 1, max: 2, level: 'Lv.1', status: 'Status 1', title: '周期推送', badgeColor: '#2da44e', ... },
    { min: 3, max: 4, level: 'Lv.2', status: 'Status 2', title: '稳定维护', badgeColor: '#0969da', ... },
    { min: 5, max: 8, level: 'Lv.3', status: 'Status 3', title: '高频迭代', badgeColor: '#425aef', ... },
    { min: 9, max: Infinity, level: 'Lv.4', status: 'Status 4', title: '极客狂热', badgeColor: '#8250df', ... },
  ],
};`}</code></pre>
      </div>
    </section>

    <!-- § 7. 关联工程规范 -->
    <section class="standards-doc-section" id="section-related">
      <div class="section-title-wrap">
        <div class="section-num">7.0</div>
        <div>
          <h2 class="standards-section-title">关联工程规范 (Cross-Specification Links)</h2>
          <p class="standards-section-desc">EpoCanvas 工程标准体系由多个互锁规范共同构建。</p>
        </div>
      </div>

      <div class="cross-spec-grid">
        <a href="/standards/content-density/" class="cross-spec-card">
          <div class="cross-spec-card__badge">EES-003</div>
          <div class="cross-spec-card__title">系统工程标准：全站内容密度分级与度量规范 →</div>
          <p class="cross-spec-card__desc">
            探索全站 100,922 物理纯文本字数度量模型、单篇信息厚度加权与四级内容深度评级。
          </p>
        </a>

        <a href="/standards/" class="cross-spec-card">
          <div class="cross-spec-card__badge">EES-001</div>
          <div class="cross-spec-card__title">返回系统工程标准总纲 (Portal Hub) →</div>
          <p class="cross-spec-card__desc">
            查阅 8 项核心仪表盘、架构 SLA 指标清单、徽章体系与完整数据字典 API 契约。
          </p>
        </a>
      </div>
    </section>

    <!-- 客户端边缘动态校准脚本：确保护航状态永远客观同步 -->
    <script is:inline>
      (async function checkLiveActiveStatus() {
        try {
          const res = await fetch('/api/console/data');
          if (!res.ok) return;
          const data = await res.json();
          if (!data || !data.stats) return;

          const recentCount = data.stats.recentPostCount30d;
          const activeLevel = data.stats.activeLevel;
          const activeTitle = data.stats.activeTitle;

          const liveRecentEl = document.getElementById('live-recent-count');
          if (liveRecentEl) liveRecentEl.textContent = recentCount + ' 篇';

          const liveLevelEl = document.getElementById('live-active-level');
          if (liveLevelEl) liveLevelEl.textContent = activeLevel + ' (' + activeTitle + ')';

          const liveHeaderEl = document.getElementById('live-header-active-level');
          if (liveHeaderEl) liveHeaderEl.textContent = activeLevel + ' ' + activeTitle;
        } catch (_) {}
      })();
    </script>
  </div>
</BlogLayout>

