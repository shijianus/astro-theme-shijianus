---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { calculateSiteMetrics } from '../../lib/site-metrics.ts';
import { createSidebarData } from '../../lib/theme.ts';

const allPosts = await getCollection('posts');
const metrics = calculateSiteMetrics(allPosts);
const sidebarData = createSidebarData(allPosts);
---

<BlogLayout 
  title="站点工程标准与分级规范 - EpoCanvas" 
  description="客观映射系统活跃等级、内容密度、代码工程规范与性能物理指标体系。"
  showAside={false}
  pageType="standards"
  sidebarData={sidebarData}
>
  <div class="standards-doc-container">
    <!-- 规范文档元信息头部 (RFC / Technical Spec Header) -->
    <header class="standards-doc-header">
      <div class="standards-doc-header__badge-row">
        <span class="standards-spec-badge">EES-2026.4 / Living Standard</span>
        <span class="standards-spec-status">● 生产环境持续生效</span>
        <span class="standards-spec-code">SPEC-ID: EES-001</span>
      </div>
      <h1 class="standards-doc-header__title">系统工程标准与指标分级规范</h1>
      <p class="standards-doc-header__lede">
        EpoCanvas Engineering Standards (EES) 为本站系统工程架构、内容密度、日常活跃与边缘计算性能的最高执行准则。
        全站所有状态指标均由底层构建引擎、D1 物理数据库与 Cloudflare 全球边缘节点物理精算，杜绝任何人工虚假修饰。
      </p>

      <div class="standards-doc-meta-grid">
        <div class="meta-item">
          <span class="meta-item__k">标准定义版本</span>
          <strong class="meta-item__v">v2.6.0 (2026 Revision)</strong>
        </div>
        <div class="meta-item">
          <span class="meta-item__k">运行时架构</span>
          <strong class="meta-item__v">Astro 5 Islands + Cloudflare Edge</strong>
        </div>
        <div class="meta-item">
          <span class="meta-item__k">计算刷新机制</span>
          <strong class="meta-item__v">边缘动态精算 / 每日自动归档</strong>
        </div>
        <div class="meta-item">
          <span class="meta-item__k">权威数据源</span>
          <strong class="meta-item__v"><a href="/api/console/data" target="_blank">GET /api/console/data</a></strong>
        </div>
      </div>
    </header>

    <!-- 文档快速导航条 (Document Navigation Anchors) -->
    <nav class="standards-doc-nav" aria-label="规范文档目录导航">
      <a href="#section-dashboard" class="doc-nav-pill">§ 1. 核心状态仪表盘</a>
      <a href="#section-active-level" class="doc-nav-pill">§ 2. 活跃等级规范</a>
      <a href="#section-content-density" class="doc-nav-pill">§ 3. 内容密度规范</a>
      <a href="#section-engineering-sla" class="doc-nav-pill">§ 4. 架构与 SLA 规范</a>
      <a href="#section-badges" class="doc-nav-pill">§ 5. 徽章体系与认证</a>
      <a href="#section-schema" class="doc-nav-pill">§ 6. 数据字典与 API</a>
    </nav>

    <!-- § 1. 核心状态仪表盘 -->
    <section class="standards-doc-section" id="section-dashboard">
      <div class="section-title-wrap">
        <div class="section-num">1.0</div>
        <div>
          <h2 class="standards-section-title">核心状态仪表盘 (Live Metrics Dashboard)</h2>
          <p class="standards-section-desc">当前站点运行态核心指标精算快照，数据严格同源同步。</p>
        </div>
      </div>

      <div class="card-webinfo-grid standards-webinfo-grid">
        <a href="/standards/activity-level/" class="webinfo-item webinfo-item--link" title="查看活跃等级独立规范全文 (EES-002)">
          <div class="webinfo-item-label">
            <span>活跃等级 (Active) ↗</span>
          </div>
          <strong class="highlight-val">{metrics.activeLevel.level}</strong>
        </a>

        <a href="/standards/content-density/" class="webinfo-item webinfo-item--link" title="查看内容密度独立规范全文 (EES-003)">
          <div class="webinfo-item-label">
            <span>内容密度 (Density) ↗</span>
          </div>
          <strong class="highlight-val">{metrics.densityLevel.shortLevel}</strong>
        </a>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>安全运行天数</span>
          </div>
          <strong>{metrics.uptimeDays} 天</strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>全站物理字数</span>
          </div>
          <strong>{metrics.totalWords.toLocaleString()} 字</strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>公开文章总数</span>
          </div>
          <strong>{metrics.totalPosts} 篇</strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>平均单篇字数</span>
          </div>
          <strong>{metrics.avgWordsPerPost.toLocaleString()} 字/篇</strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>预估总阅读</span>
          </div>
          <strong>{metrics.totalReadingMinutes} 分钟</strong>
        </div>

        <div class="webinfo-item">
          <div class="webinfo-item-label">
            <span>近30天发布</span>
          </div>
          <strong>{metrics.recentPostCount30d} 篇</strong>
        </div>
      </div>
    </section>

    <!-- § 2. 活跃等级分级规范 -->
    <section class="standards-doc-section" id="section-active-level">
      <div class="section-title-wrap">
        <div class="section-num">2.0</div>
        <div>
          <h2 class="standards-section-title">活跃等级分级规范 (Active Level Specification)</h2>
          <p class="standards-section-desc">基于全站近 30 天内公开文章的物理发布与修订更新频率进行客观动态阶梯评定。</p>
        </div>
      </div>
      <!-- 独立规范文章入口卡片 -->
      <div class="doc-split-entry-card">
        <div class="doc-split-entry-card__content">
          <div class="doc-split-entry-card__tag-row">
            <span class="doc-split-badge">独立规范文章 · EES-002</span>
            <span class="doc-split-status">★ 当前实测达标：{metrics.activeLevel.level} ({metrics.activeLevel.title})</span>
          </div>
          <h3 class="doc-split-title">《系统工程标准：站长活跃等级分级与评估规范》</h3>
          <p class="doc-split-desc">
            本规范已独立拆分为专项技术文章体系，完整阐释滚动 30 天滑动窗口数学模型、防刷去重准则、心跳衰减机制与五级完整阶梯对照表。
          </p>
        </div>
        <a href="/standards/activity-level/" class="doc-split-btn">
          阅读活跃等级独立文章全文 →
        </a>
      </div>

      <div class="doc-callout doc-callout--info">
        <div class="doc-callout__icon">ℹ️</div>
        <div class="doc-callout__content">
          <strong>计算公式与采样准则：</strong>
          统计窗口设定为自然日 [T - 30天, T]。仅统计具备独立 URL 的公开文章节点（排除多语言副本衍生），
          当日发布记为首发，后续技术勘误与深度补充均由热力图双重维度追踪。
        </div>
      </div>

      <div class="standards-table-wrapper">
        <table class="standards-table">
          <thead>
            <tr>
              <th>等级标识</th>
              <th>评级名称</th>
              <th>发文数量阈值 (近30天)</th>
              <th>维护状态与节奏描述</th>
              <th>当前达标判定</th>
            </tr>
          </thead>
          <tbody>
            {metrics.standards.activeLevel.thresholds.map((tier) => (
              <tr class={tier.isCurrent ? 'is-current-tier' : ''}>
                <td>
                  <span class={`tier-badge ${tier.isCurrent ? 'tier-badge--current' : ''}`}>{tier.badge}</span>
                </td>
                <td><strong>{tier.title}</strong></td>
                <td>{tier.description}</td>
                <td>
                  {tier.level === 'Status 4' && '高密度极速迭代，多专栏并行推进，周更 >= 2 篇'}
                  {tier.level === 'Status 3' && '高频深度迭代，系统保持周更或半周更节奏'}
                  {tier.level === 'Status 2' && '稳定节奏维护，稳步推进技术专题与知识沉淀'}
                  {tier.level === 'Status 1' && '周期常规推送，系统处于基础维护状态'}
                  {tier.level === 'Status 0' && '近30天暂无更新，系统处于休眠维护中'}
                </td>
                <td>
                  {tier.isCurrent ? (
                    <span class="status-indicator current">✓ 当前实测达标 ({metrics.recentPostCount30d} 篇)</span>
                  ) : (
                    <span class="status-indicator">未激活</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="standards-summary-box">
        <div class="summary-meta">
          <span>近 30 天实测发文：<strong>{metrics.recentPostCount30d} 篇</strong></span>
          <span>{metrics.standards.activeLevel.nextMilestone}</span>
        </div>
        <div class="standards-progress-bar">
          <div class="standards-progress-fill" style={`width: ${metrics.standards.activeLevel.progressPercent}%;`}></div>
        </div>
      </div>
    </section>

    <!-- § 3. 内容密度分级规范 -->
    <section class="standards-doc-section" id="section-content-density">
      <div class="section-title-wrap">
        <div class="section-num">3.0</div>
        <div>
          <h2 class="standards-section-title">内容密度分级规范 (Content Density Specification)</h2>
          <p class="standards-section-desc">基于全站公开文章物理总字数与有效篇数的加权单篇信息密度评级体系。</p>
        </div>
      </div>
      <!-- 独立规范文章入口卡片 -->
      <div class="doc-split-entry-card">
        <div class="doc-split-entry-card__content">
          <div class="doc-split-entry-card__tag-row">
            <span class="doc-split-badge">独立规范文章 · EES-003</span>
            <span class="doc-split-status">★ 当前实测达标：{metrics.densityLevel.shortLevel} ({metrics.densityLevel.title})</span>
          </div>
          <h3 class="doc-split-title">《系统工程标准：全站内容密度分级与度量规范》</h3>
          <p class="doc-split-desc">
            本规范已独立拆分为专项技术文章体系，深入剖析文本分词清洗流水线、全站均值精算模型、长文排版支撑准则与四级完整阶梯对照表。
          </p>
        </div>
        <a href="/standards/content-density/" class="doc-split-btn">
          阅读内容密度独立文章全文 →
        </a>
      </div>

      <div class="doc-callout doc-callout--info">
        <div class="doc-callout__icon">📐</div>
        <div class="doc-callout__content">
          <strong>统计模型：</strong>
          字数统计对 Markdown 语法符号（如 `#`, `*`, `[]`, 代码围栏标记）进行预清理，
          中文字符按物理字频计算，西文字符按空格词项（Tokens）加权合并，真实反应文章技术含金量与叙事厚度。
        </div>
      </div>

      <div class="standards-table-wrapper">
        <table class="standards-table">
          <thead>
            <tr>
              <th>密度等级</th>
              <th>评级定位</th>
              <th>单篇平均字数阈值</th>
              <th>排版规范与内容要求</th>
              <th>当前达标判定</th>
            </tr>
          </thead>
          <tbody>
            {metrics.standards.contentDensity.thresholds.map((tier) => (
              <tr class={tier.isCurrent ? 'is-current-tier' : ''}>
                <td>
                  <span class={`tier-badge ${tier.isCurrent ? 'tier-badge--current' : ''}`}>{tier.badge}</span>
                </td>
                <td><strong>{tier.title}</strong></td>
                <td>{tier.description}</td>
                <td>
                  {tier.level === 'Level 4' && '深度硬核长文，图文并茂，配备完整架构剖析、KaTeX 公式或交互导图'}
                  {tier.level === 'Level 3' && '系统级专栏教程，逻辑严谨，涵盖完整代码演练'}
                  {tier.level === 'Level 2' && '标准技术博文，聚焦单一技术点或特定问题解决方案'}
                  {tier.level === 'Level 1' && '碎片化微动态、速记随笔或轻量提示卡'}
                </td>
                <td>
                  {tier.isCurrent ? (
                    <span class="status-indicator current">✓ 当前实测达标 (均篇 {metrics.avgWordsPerPost.toLocaleString()} 字)</span>
                  ) : (
                    <span class="status-indicator">未激活</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="standards-summary-box">
        <div class="summary-meta">
          <span>公开文章数：<strong>{metrics.totalPosts} 篇</strong></span>
          <span>物理总字数：<strong>{metrics.totalWords.toLocaleString()} 字</strong></span>
          <span>平均单篇字数：<strong>{metrics.avgWordsPerPost.toLocaleString()} 字/篇</strong></span>
        </div>
        <div class="standards-progress-bar">
          <div class="standards-progress-fill" style={`width: ${metrics.standards.contentDensity.progressPercent}%;`}></div>
        </div>
      </div>
    </section>

    <!-- § 4. 架构与性能工程 SLA -->
    <section class="standards-doc-section" id="section-engineering-sla">
      <div class="section-title-wrap">
        <div class="section-num">4.0</div>
        <div>
          <h2 class="standards-section-title">系统架构与性能硬性限制 (Engineering SLA)</h2>
          <p class="standards-section-desc">基于 Astro 现代化 Islands 架构与 Cloudflare 全球分布式边缘计算的性能承诺。</p>
        </div>
      </div>

      <div class="standards-table-wrapper">
        <table class="standards-table">
          <thead>
            <tr>
              <th>指标维度 (Metric)</th>
              <th>推荐阈值 (Target)</th>
              <th>硬性容忍限制 (Hard Limit)</th>
              <th>实测表现 (Measured)</th>
              <th>影响范围 (Scope)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>API 边缘响应延迟</strong></td>
              <td>&lt; 50ms</td>
              <td>&lt; 150ms</td>
              <td><span class="perf-tag">&lt; 35ms (CF Edge)</span></td>
              <td>控制台指标、评论系统、国际收银台</td>
            </tr>
            <tr>
              <td><strong>首屏打包体积 (Bundle Size)</strong></td>
              <td>&lt; 150KB</td>
              <td>&lt; 300KB</td>
              <td><span class="perf-tag">~ 112KB (Gzip)</span></td>
              <td>全站首屏水合与静态资产极速加载</td>
            </tr>
            <tr>
              <td><strong>LCP (最大内容绘制)</strong></td>
              <td>&lt; 1.0s</td>
              <td>&lt; 2.2s</td>
              <td><span class="perf-tag">~ 0.65s</span></td>
              <td>用户首屏即刻阅读体验</td>
            </tr>
            <tr>
              <td><strong>组件非必要重渲染</strong></td>
              <td>0 ~ 1 次</td>
              <td>&lt; 3 次</td>
              <td><span class="perf-tag">0 次 (Islands Isolated)</span></td>
              <td>复杂热力图、TOC 目录交互、控制台展开</td>
            </tr>
            <tr>
              <td><strong>国际化容错度 (Polyglot Fallback)</strong></td>
              <td>100% 自动降级</td>
              <td>不允许 404</td>
              <td><span class="perf-tag">100% Canonical 兜底</span></td>
              <td>多语言未翻译页面平滑回退中文/英文主版本</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- § 5. 徽章体系与认证规则 -->
    <section class="standards-doc-section" id="section-badges">
      <div class="section-title-wrap">
        <div class="section-num">5.0</div>
        <div>
          <h2 class="standards-section-title">徽章体系与认证规则 (Badges & Certification)</h2>
          <p class="standards-section-desc">站点各卡片与文章头部分配的视觉徽章标准及其实际含义。</p>
        </div>
      </div>

      <div class="standards-badge-grid">
        <div class="badge-card">
          <div class="badge-card__preview">
            <span class="tier-badge tier-badge--current">Lv.3 High</span>
          </div>
          <div class="badge-card__content">
            <h4>高频迭代徽标</h4>
            <p>近 30 天内公开发布文章达 5~8 篇，系统保持稳定快节奏迭代时在规范与控制台点亮。</p>
          </div>
        </div>

        <div class="badge-card">
          <div class="badge-card__preview">
            <span class="tier-badge tier-badge--current">Lv.4 Ultra</span>
          </div>
          <div class="badge-card__content">
            <h4>超强密度徽标</h4>
            <p>全站平均单篇字数超过 3,000 字，系统文章普遍具备深度技术拆解与思维导图时点亮。</p>
          </div>
        </div>

        <div class="badge-card">
          <div class="badge-card__preview">
            <span class="tier-badge">1000d+</span>
          </div>
          <div class="badge-card__content">
            <h4>千日长青徽标</h4>
            <p>自 2024-01-01 起安全稳定运营满 1,000 天，代表站点长期维护、永不闭源与数据持久化。</p>
          </div>
        </div>

        <div class="badge-card">
          <div class="badge-card__preview">
            <span class="tier-badge">10w+ 字</span>
          </div>
          <div class="badge-card__content">
            <h4>十万字量级徽标</h4>
            <p>全站原创技术文档与剖析总字数突破 100,000 字，达到中大型技术专栏知识库规模。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- § 6. 数据字典与 API 合约 -->
    <section class="standards-doc-section" id="section-schema">
      <div class="section-title-wrap">
        <div class="section-num">6.0</div>
        <div>
          <h2 class="standards-section-title">数据字典与 API 合约 (Data Dictionary & API)</h2>
          <p class="standards-section-desc">面向自动化审计、监控探针与第三方调用的 JSON 数据合约规范。</p>
        </div>
      </div>

      <div class="doc-code-block">
        <div class="doc-code-block__header">
          <span>GET /api/console/data (Response Contract)</span>
          <span>application/json</span>
        </div>
        <pre><code>{`{
  "ok": true,
  "stats": {
    "posts": ${metrics.totalPosts},
    "totalWords": ${metrics.totalWords},
    "readingMinutes": ${metrics.totalReadingMinutes},
    "avgWordsPerPost": ${metrics.avgWordsPerPost},
    "uptimeDays": ${metrics.uptimeDays},
    "recentPostCount30d": ${metrics.recentPostCount30d},
    "activeStatus": "${metrics.activeLevel.status}",
    "activeLevel": "${metrics.activeLevel.level}",
    "densityStatus": "${metrics.densityLevel.level}",
    "densityLevel": "${metrics.densityLevel.shortLevel}"
  },
  "activity": [
    {
      "date": "2026-08-28",
      "displayDate": "2026/8/28",
      "level": 4,
      "posts": [ ... ],
      "isFuture": false
    }
  ],
  "servedAt": "${new Date().toISOString()}"
}`}</code></pre>
      </div>
    </section>
  </div>
</BlogLayout>

<style>
  .standards-doc-container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .standards-doc-header {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(66, 90, 239, 0.15);
    box-shadow: none;
    padding: 0 0 32px 0;
  }

  .standards-doc-header__badge-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .standards-spec-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--theme-main, #425aef);
    background: rgba(66, 90, 239, 0.1);
    padding: 4px 10px;
    border-radius: 4px;
    letter-spacing: 0.5px;
    font-family: var(--font-family-mono, monospace);
  }

  .standards-spec-status {
    font-size: 12px;
    font-weight: 500;
    color: #2da44e;
  }

  .standards-spec-code {
    font-size: 11px;
    color: var(--text-muted, #656d76);
    font-family: var(--font-family-mono, monospace);
    margin-left: auto;
  }

  .standards-doc-header__title {
    font-size: 32px;
    font-weight: 800;
    margin: 0 0 14px 0;
