---
import { getCollection, render } from 'astro:content';
import PostHero from '../../components/theme/PostHero.astro';
import PostCopyright from '../../components/theme/PostCopyright.astro';
import RelatedPosts from '../../components/theme/RelatedPosts.astro';
import { PostComments } from '../../components/theme/PostComments';
import { siteConfig } from '../../config/site';
import BlogLayout from '../../layouts/BlogLayout.astro';
import {
  estimateReadingMinutes,
  estimateWordCount,
  getRelatedPosts,
  resolveCategory,
  resolveCover,
  resolveCoverAlt,
  resolveGroup,
  sortPostsByDate,
} from '../../lib/content';
import { createSidebarData } from '../../lib/theme';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;
const allPosts = sortPostsByDate(await getCollection('posts'));
const entry = allPosts.find((post) => post.id === slug);

if (!entry) {
  throw new Error(`Post not found: ${slug}`);
}

const { Content, headings } = await render(entry);
const relatedPosts = getRelatedPosts(allPosts, entry, 3);
const sidebarData = createSidebarData(allPosts, headings);
sidebarData.recentPosts = allPosts.filter((post) => post.id !== entry.id);

const wordCount = estimateWordCount(entry);
const meta = [
  `发表于 ${entry.data.pubDate.toLocaleDateString('zh-CN')}`,
  `更新于 ${entry.data.pubDate.toLocaleDateString('zh-CN')}`,
  `字数 ${wordCount.toLocaleString('zh-CN')}`,
  `阅读 ${estimateReadingMinutes(entry)} 分钟`,
];

const badges = ['原创', resolveCategory(entry), ...entry.data.tags.slice(0, 2)];
---

<BlogLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebarData={sidebarData}
  pageType="post"
>
  <Fragment slot="hero">
    <PostHero
      title={entry.data.title}
      image={resolveCover(entry)}
      imageAlt={resolveCoverAlt(entry)}
      badges={badges}
      meta={meta}
    />
  </Fragment>

  <section id="post" class="post-page-shell">
    <article id="article-container" class="theme-card article-body post-content">
      <Content />
    </article>
  </section>

  {siteConfig.theme.features.postCopyright && (
    <PostCopyright
      permalink={Astro.url.href}
      title={entry.data.title}
      authorName={siteConfig.site.author.name}
      authorRole={siteConfig.site.author.role}
      authorAvatar={siteConfig.site.author.avatar}
      badge={siteConfig.post.copyright.badge}
      copyrightTitle={siteConfig.post.copyright.title}
      notice={siteConfig.post.copyright.notice}
      copyLabel={siteConfig.post.copyright.copyLabel}
      rewardLabel={siteConfig.post.copyright.rewardLabel}
      rewardNote={siteConfig.post.copyright.rewardNote}
      aboutTitle={siteConfig.post.tools.aboutTitle}
      modeHref={siteConfig.post.tools.modeHref}
      modeLabel={siteConfig.post.tools.modeLabel}
      modeDescription={siteConfig.post.tools.modeDescription}
      shareLabel={siteConfig.post.tools.shareLabel}
      rewardHref={siteConfig.post.tools.rewardHref}
      rewardDescription={siteConfig.post.tools.rewardDescription}
      copyDoneLabel={siteConfig.post.tools.copyDoneLabel}
      shareDoneLabel={siteConfig.post.tools.shareDoneLabel}
      shareFallbackLabel={siteConfig.post.tools.shareFallbackLabel}
      category={resolveCategory(entry)}
      tags={entry.data.tags}
    />
  )}

  {siteConfig.theme.features.relatedPosts && relatedPosts.length > 0 && (
    <RelatedPosts
      posts={relatedPosts}
      eyebrow={siteConfig.post.related.eyebrow}
      title={siteConfig.post.related.title}
    />
  )}

  <PostComments
    client:visible
    slug={entry.id}
    title={entry.data.title}
    heading={siteConfig.post.comments.title}
    policyLabel={siteConfig.post.comments.policyLabel}
    notice={siteConfig.post.comments.notice}
    submitLabel={siteConfig.post.comments.submitLabel}
    previewLabel={siteConfig.post.comments.previewLabel}
    emptyTitle={siteConfig.post.comments.emptyTitle}
    emptySummary={siteConfig.post.comments.emptySummary}
    tips={siteConfig.post.comments.tips}
  />
</BlogLayout>
