---
import { getCollection, getEntry, render } from 'astro:content';
import { Globe } from 'lucide-react';
import ContentFeatureEnhancer from '../../components/ContentFeatureEnhancer.astro';
import AiSummaryPanel from '../../components/theme/AiSummaryPanel.astro';
import PostHero from '../../components/theme/PostHero.astro';
import PostCopyright from '../../components/theme/PostCopyright.astro';
import RelatedPosts from '../../components/theme/RelatedPosts.astro';
import PostEndRecommendation from '../../components/theme/PostEndRecommendation.astro';
import PostOutdateNotice from '../../components/theme/PostOutdateNotice.astro';
import { PostComments } from '../../components/theme/PostComments';
import { siteConfig } from '../../config/site';
import { getSerializedTocDictionary } from '../../config/i18n';
import aiSummaries from '../../data/ai-summaries.json';
import BlogLayout from '../../layouts/BlogLayout.astro';
import {
  estimateReadingMinutes,
  estimateWordCount,
  getPublicPosts,
  getRelatedPosts,
  PROTECTED_POST_CATEGORY,
  PROTECTED_POST_SUMMARY,
  PROTECTED_POST_TITLE,
  resolveCategory,
  resolveCover,
  resolveExplicitCover,
  resolveCoverAlt,
  sortPostsByDate,
  getPostCanonicalSlug,
  normalizeLangCode,
  LANG_SUFFIX_REGEX,
} from '../../lib/content';
import { hasConfiguredCommentDatabase } from '../../lib/comment-integration';
import { createSidebarData } from '../../lib/theme';
import { evaluatePostAccess, getAccessPasswordHash, verifyAccessPassword } from '../../lib/access-control';
import {
  buildEncryptedSlugMap,
  findEncryptedRouteMatch,
  getPostEncryptConfigs,
  resolveConfigSlug,
} from '../../lib/external-encrypt';

export const prerender = import.meta.env.PUBLIC_STATIC_EXPORT === '1';
const STATIC_EXPORT = import.meta.env.PUBLIC_STATIC_EXPORT === '1';

export async function getStaticPaths() {
  if (import.meta.env.PUBLIC_STATIC_EXPORT !== '1') return [];
  const posts = await getCollection('posts');
  const existingPostIds = new Set(posts.map((p) => p.id));

  const paths = [];
  const registeredSlugs = new Set<string>();
  function pushSlug(s: string) {
    if (!s || registeredSlugs.has(s)) return;
    registeredSlugs.add(s);
    paths.push({ params: { slug: s } });
  }

  for (const post of posts) {
    pushSlug(post.id);
    if (post.id.toLowerCase() !== post.id) {
      pushSlug(post.id.toLowerCase());
    }
    if (post.id.includes('.')) {
      pushSlug(post.id.replace(/\./g, '-'));
      pushSlug(post.id.replace(/\./g, '-').toLowerCase());
    }
    // Also guarantee canonical slug is generated even if all sibling files have language suffixes
    const canonical = getPostCanonicalSlug(post.id);
    if (canonical) {
      pushSlug(canonical);
      if (canonical.toLowerCase() !== canonical) {
        pushSlug(canonical.toLowerCase());
      }
      if (canonical.includes('.')) {
        pushSlug(canonical.replace(/\./g, '-'));
        pushSlug(canonical.replace(/\./g, '-').toLowerCase());
      }
    }
  }

  // Build encrypted slug map with conflict detection
  const { slugMap, warnings } = buildEncryptedSlugMap(posts, existingPostIds);

  for (const w of warnings) {
    console.warn(`[ExternalEncrypt] ${w.type}: "${w.encryptedSlug}" → auto-resolved to "${w.autoResolvedTo}"`);
  }

  for (const encSlug of slugMap.keys()) {
    pushSlug(encSlug);
  }

  return paths;
}

const { slug } = Astro.params;
const langSuffixRegex = LANG_SUFFIX_REGEX;
const isSuffixRoute = langSuffixRegex.test(slug ?? '');
const canonicalSlug = getPostCanonicalSlug(slug ?? '');
const matchLang = (slug ?? '').match(langSuffixRegex);
const targetLang = matchLang ? normalizeLangCode(matchLang[1]) : 'zh-CN';

// In SSR mode, immediately redirect legacy language URLs to canonical without rendering
if (isSuffixRoute && !STATIC_EXPORT) {
  return Astro.redirect(`/posts/${canonicalSlug}/`, 301);
}

const allPosts = sortPostsByDate(await getCollection('posts'));
const publicPosts = getPublicPosts(allPosts);
const existingPostIds = new Set(allPosts.map((p) => p.id));

// ── Normal post lookup (with case-insensitive fallback) ─────────────────────
let entry = allPosts.find((post) =>
  post.id === slug ||
  post.id.toLowerCase() === slug?.toLowerCase() ||
  post.id.replace(/\./g, '-') === slug ||
  post.id.replace(/\./g, '-').toLowerCase() === slug?.toLowerCase() ||
  (isSuffixRoute && (
    post.id === canonicalSlug ||
    post.id.toLowerCase() === canonicalSlug.toLowerCase() ||
    post.id.replace(/\./g, '-') === canonicalSlug ||
    post.id.replace(/\./g, '-').toLowerCase() === canonicalSlug.toLowerCase()
  ))
);

// Fallback for canonical routes of groups where all files have language suffixes
if (!entry) {
  entry = allPosts.find((post) => {
    const pCanon = getPostCanonicalSlug(post.id);
    const pKey = post.data.i18nKey || pCanon;
    const target = canonicalSlug || slug || '';
    return (
      pCanon === target ||
      pCanon.toLowerCase() === target.toLowerCase() ||
      pCanon.replace(/\./g, '-') === target ||
      pCanon.replace(/\./g, '-').toLowerCase() === target.toLowerCase() ||
      pKey === target ||
      pKey.toLowerCase() === target.toLowerCase()
    );
  });
}

// ── Encrypted route lookup ──────────────────────────────────────────────────
let matchedEncryptConfig = null;
let isEncryptedRoute = false;
let contentEntry = null;

if (!entry && !isSuffixRoute) {
  const match = findEncryptedRouteMatch(slug ?? '', allPosts);
  if (match) {
    entry = match.post;
    matchedEncryptConfig = match.config;
    isEncryptedRoute = true;

    if (match.config.contentSlug) {
      const crossEntry = allPosts.find((p) => p.id === match.config.contentSlug);
      if (crossEntry) {
        contentEntry = crossEntry;
      } else {
        console.warn(`[ExternalEncrypt] contentSlug "${match.config.contentSlug}" not found for post "${entry.id}"`);
      }
    }
  }
}

if (!entry && !isSuffixRoute) {
  throw new Error(`Post not found: ${slug}`);
}

// Fallback dummy for suffix redirects to satisfy compiler
const postEntry = entry || allPosts[0];
const contentSourceEntry = contentEntry ?? postEntry;
const normalPostUrl = `/posts/${canonicalSlug}/`;
const allEncryptConfigs = postEntry ? getPostEncryptConfigs(postEntry.data) : [];

// ──── Multilingual i18n Translation Resolution ─────────────────────────────
const inferredLangMatch = postEntry.id.match(langSuffixRegex);
const normalizedInferredLang = inferredLangMatch ? normalizeLangCode(inferredLangMatch[1]) : undefined;
const inferredKey = getPostCanonicalSlug(postEntry.id);
const currentI18nKey = postEntry.data.i18nKey || inferredKey;
const currentLang = (postEntry.data.lang ? normalizeLangCode(postEntry.data.lang) : undefined) || normalizedInferredLang || 'zh-CN';

// Find all sibling translations with the same i18nKey or shared base slug
const siblingTranslations = allPosts.filter((p) => {
  const pInferredKey = getPostCanonicalSlug(p.id);
  const pKey = p.data.i18nKey || pInferredKey;

  const normCurrentKey = (currentI18nKey || '').toLowerCase().replace(/[._-]+/g, '-');
  const normInferredKey = (inferredKey || '').toLowerCase().replace(/[._-]+/g, '-');
  const normCanonicalSlug = (canonicalSlug || '').toLowerCase().replace(/[._-]+/g, '-');
  const normPKey = (pKey || '').toLowerCase().replace(/[._-]+/g, '-');
  const normPInferredKey = (pInferredKey || '').toLowerCase().replace(/[._-]+/g, '-');

  return (
    normPKey === normCurrentKey ||
    normPInferredKey === normInferredKey ||
    normPInferredKey === normCanonicalSlug ||
    normPKey === normCanonicalSlug ||
    pKey === currentI18nKey ||
    pInferredKey === inferredKey ||
    pInferredKey === canonicalSlug ||
    pKey === canonicalSlug
  );
});

const typedAiSummaries = aiSummaries as Record<string, { summary: string; model?: string }>;
const staticSummariesByLang: Record<string, string> = {};
if (typedAiSummaries[postEntry.id]?.summary) {
  staticSummariesByLang[currentLang] = typedAiSummaries[postEntry.id].summary;
}
for (const p of siblingTranslations) {
  const pSuffix = p.id.match(langSuffixRegex);
  const pNorm = pSuffix ? normalizeLangCode(pSuffix[1]) : undefined;
  const pLang = (p.data.lang ? normalizeLangCode(p.data.lang) : undefined) || pNorm || 'zh-CN';
  const pSum = typedAiSummaries[p.id]?.summary;
  if (pSum && !staticSummariesByLang[pLang]) {
    staticSummariesByLang[pLang] = pSum;
  }
}

// Access Control
const access = isEncryptedRoute ? undefined : postEntry.data.access;
const accessPasswordHash = getAccessPasswordHash(access);
const accessCookieName = accessPasswordHash ? `shijianus-post-access:${postEntry.id}` : '';
let unlockErrorMessage = '';

if (!STATIC_EXPORT && Astro.request.method.toUpperCase() === 'POST' && accessPasswordHash) {
  const formData = await Astro.request.formData();
  const submittedPassword = String(formData.get('post-password') ?? '').trim();

  if (verifyAccessPassword(access, submittedPassword)) {
    Astro.cookies.set(
      accessCookieName,
      (await evaluatePostAccess({
        slug: postEntry.id,
        access,
        headers: Astro.request.headers,
      })).cookieValue,
      {
        httpOnly: true,
        sameSite: 'lax',
        secure: Astro.url.protocol === 'https:',
        path: `/posts/${canonicalSlug}/`,
        maxAge: 60 * 60 * 8,
      },
    );

    return Astro.redirect(Astro.url.pathname, 303);
  }

  unlockErrorMessage = '密码不正确，请重试。';
}

const accessState = STATIC_EXPORT
  ? await evaluatePostAccess({
      slug: postEntry.id,
      access,
      headers: new Headers(),
      cookieValue: undefined,
    })
  : await evaluatePostAccess({
      slug: postEntry.id,
      access,
      headers: Astro.request.headers,
      cookieValue: accessCookieName ? Astro.cookies.get(accessCookieName)?.value : undefined,
    });

const isUnlocked = isEncryptedRoute ? true : accessState.unlocked;
const publicFacingTitle = isUnlocked ? postEntry.data.title : PROTECTED_POST_TITLE;
const publicFacingDescription = isUnlocked ? postEntry.data.description ?? siteConfig.post.hero.summaryFallback : PROTECTED_POST_SUMMARY;

type RenderedVariant = {
  lang: string;
  post: (typeof allPosts)[0];
  Content: Awaited<ReturnType<typeof render>>['Content'];
  headings: Awaited<ReturnType<typeof render>>['headings'];
  title: string;
  summary: string;
};

const renderedVariants: RenderedVariant[] = [];
const variantHeadings: Record<string, Awaited<ReturnType<typeof render>>['headings']> = {};

if (!isSuffixRoute && isUnlocked) {
  for (const p of siblingTranslations) {
    const pSuffixMatch = p.id.match(langSuffixRegex);
    const pNormLang = pSuffixMatch ? normalizeLangCode(pSuffixMatch[1]) : undefined;
    const vLang = (p.data.lang ? normalizeLangCode(p.data.lang) : undefined) || pNormLang || 'zh-CN';

    const existingIdx = renderedVariants.findIndex((v) => v.lang === vLang);
    if (existingIdx >= 0) {
      if (!p.data.isAiGenerated) {
        const rendered = await render(p);
        renderedVariants[existingIdx] = {
          lang: vLang,
          post: p,
          Content: rendered.Content,
          headings: rendered.headings,
          title: p.data.title,
          summary: p.data.description ?? siteConfig.post.hero.summaryFallback,
        };
        variantHeadings[vLang] = rendered.headings;
      }
      continue;
    }

    const rendered = await render(p);
    renderedVariants.push({
      lang: vLang,
      post: p,
      Content: rendered.Content,
      headings: rendered.headings,
      title: p.data.title,
      summary: p.data.description ?? siteConfig.post.hero.summaryFallback,
    });
    variantHeadings[vLang] = rendered.headings;
  }

  // Ensure canonical entry is present (check by id and by normalized lang)
  if (!renderedVariants.some((v) => v.post.id === contentSourceEntry.id || v.lang === currentLang)) {
    const rendered = await render(contentSourceEntry);
    renderedVariants.unshift({
      lang: currentLang,
      post: contentSourceEntry,
      Content: rendered.Content,
      headings: rendered.headings,
      title: contentSourceEntry.data.title,
      summary: contentSourceEntry.data.description ?? siteConfig.post.hero.summaryFallback,
    });
    variantHeadings[currentLang] = rendered.headings;
  }
}

// Canonical content & headings fallback
const effectiveCurrentLang = renderedVariants.some((v) => v.lang === currentLang)
  ? currentLang
  : (renderedVariants[0]?.lang || currentLang);
const primaryVariant = renderedVariants.find((v) => v.lang === effectiveCurrentLang) || renderedVariants[0];
let Content = primaryVariant?.Content ?? null;
let headings = primaryVariant?.headings ?? [];

const translationsByLang: Record<
  string,
  {
    slug: string;
    url: string;
    title: string;
    lang: string;
    isAiGenerated: boolean;
  }
> = {};

for (const v of renderedVariants) {
  translationsByLang[v.lang] = {
    slug: v.post.id,
    url: `/posts/${canonicalSlug}/`, // URL is strictly canonical!
    title: v.title,
    lang: v.lang,
    isAiGenerated: Boolean(v.post.data.isAiGenerated),
  };
}
const hasTranslations = Object.keys(translationsByLang).length > 1;

const relatedPosts = isUnlocked ? getRelatedPosts(publicPosts, postEntry, 6) : [];
const publicPostIndex = publicPosts.findIndex((post) => post.id === postEntry.id);
const previousPost = publicPostIndex > 0 ? publicPosts[publicPostIndex - 1] : null;
const nextPost = publicPostIndex >= 0 && publicPostIndex < publicPosts.length - 1 ? publicPosts[publicPostIndex + 1] : null;
const hasTocAside = !isEncryptedRoute && isUnlocked && siteConfig.theme.features.postToc && postEntry.data.toc !== false && !postEntry.data.hideToc && headings.some((heading) => heading.depth >= 2 && heading.depth <= 6);
const sidebarData = !isSuffixRoute ? createSidebarData(publicPosts, hasTocAside ? headings : []) : null;
if (sidebarData) {
  sidebarData.recentPosts = publicPosts.filter((post) => post.id !== postEntry.id);
  sidebarData.previousPost = previousPost;
  sidebarData.nextPost = nextPost;
  sidebarData.variantHeadings = variantHeadings;
}

const wordCount = estimateWordCount(postEntry);
type HeroMetaItem = {
  label: string;
  value: string;
  runtime?: 'views' | 'dwell';
  icon?: 'calendar' | 'refresh' | 'folder' | 'file' | 'clock' | 'eye' | 'timer';
};
const formatHeroDate = (date: Date) => {
  return `${String(date.getMonth() + 1).padStart(2, '0')}/${String(date.getDate()).padStart(2, '0')}/${String(date.getFullYear()).slice(-2)}`;
};
const category = resolveCategory(postEntry);
const publicCategory = isUnlocked ? category : PROTECTED_POST_CATEGORY;
const isOriginal = postEntry.data.author.trim().toLowerCase() === siteConfig.site.author.name.trim().toLowerCase();
const originalBadge = siteConfig.post.hero.detectOriginalTag ? [isOriginal ? '原创' : '转载'] : [];
const formatLabels: Record<string, string> = {
  aside: '便签',
  status: '动态',
  quote: '语录',
  gallery: '画廊',
  video: '视频',
  audio: '音频',
  link: '链接',
  chat: '对话',
  image: '相片',
};
const formatBadge = postEntry.data.postFormat && postEntry.data.postFormat !== 'standard' ? [formatLabels[postEntry.data.postFormat] || postEntry.data.postFormat] : [];
const scannedTags = [...new Set(postEntry.data.tags.map((tag) => tag.trim()).filter(Boolean))];
const tagLimit = Math.max(0, siteConfig.post.hero.maxTags - originalBadge.length - formatBadge.length);
const badges = isUnlocked ? [...originalBadge, ...formatBadge, ...scannedTags.slice(0, tagLimit)] : ['受限'];
const heroImage = isUnlocked ? resolveExplicitCover(postEntry) : '';
const heroImageAlt = isUnlocked ? resolveCoverAlt(postEntry) : PROTECTED_POST_TITLE;
const heroImageUrl = heroImage ? new URL(heroImage, siteConfig.site.url) : null;
const heroImageOrigin = heroImageUrl && heroImageUrl.origin !== new URL(siteConfig.site.url).origin ? heroImageUrl.origin : '';
const publicMeta = [
  { label: siteConfig.post.hero.metaLabels.published, value: formatHeroDate(postEntry.data.pubDate), icon: 'calendar' as const },
  postEntry.data.updatedDate && {
    label: siteConfig.post.hero.metaLabels.updated,
    value: formatHeroDate(postEntry.data.updatedDate),
    icon: 'refresh' as const,
  },
].filter(Boolean);
const fullMeta = [
  ...publicMeta,
  { label: siteConfig.post.hero.metaLabels.category, value: publicCategory, icon: 'folder' as const },
  { label: siteConfig.post.hero.metaLabels.words, value: wordCount.toLocaleString('zh-CN'), icon: 'file' as const },
  { label: siteConfig.post.hero.metaLabels.reading, value: `${estimateReadingMinutes(postEntry)} 分钟`, icon: 'clock' as const },
  { label: siteConfig.post.hero.metaLabels.views, value: '0 次', runtime: 'views' as const, icon: 'eye' as const },
  { label: siteConfig.post.hero.metaLabels.dwell, value: '0 分钟', runtime: 'dwell' as const, icon: 'timer' as const },
];
const meta = (isUnlocked ? fullMeta : publicMeta) as HeroMetaItem[];
const commentsEnabled = isUnlocked && hasConfiguredCommentDatabase(siteConfig.integrations.comments);

const tagCounts: Record<string, number> = {};
publicPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    const trimmed = tag.trim();
    if (trimmed) {
      tagCounts[trimmed] = (tagCounts[trimmed] || 0) + 1;
    }
  });
});

const heroSummary = isUnlocked
  ? postEntry.data.description ?? siteConfig.post.hero.summaryFallback
  : accessState.denialReason || '这篇文章设置了访问条件，完成验证后才会展示正文。';
---

{isSuffixRoute ? (
  <html lang={targetLang}>
    <head>
      <meta charset="utf-8" />
      <title>Redirecting to /posts/{canonicalSlug}/...</title>
      <meta http-equiv="refresh" content={`0;url=/posts/${canonicalSlug}/`} />
      <link rel="canonical" href={`/posts/${canonicalSlug}/`} />
      <script is:inline define:vars={{ canonicalSlug, targetLang }}>
        try {
          window.localStorage.setItem('shijianus-manual-locale-selected', targetLang);
          window.localStorage.setItem('shijianus-locale-variant', targetLang);
        } catch (_) {}
        window.location.replace('/posts/' + canonicalSlug + '/');
      </script>
    </head>
    <body>
      <p>Redirecting to <a href={`/posts/${canonicalSlug}/`}>/posts/{canonicalSlug}/</a>...</p>
    </body>
  </html>
) : (
  <BlogLayout
    title={publicFacingTitle}
    description={publicFacingDescription}
    sidebarData={sidebarData}
    pageType="post"
    showAside={true}
    lang={currentLang}
  >
    <Fragment slot="head">
      {heroImage && heroImageOrigin && <link rel="preconnect" href={heroImageOrigin} crossorigin="anonymous" />}
      {heroImage && (
        <link
          rel="preload"
          as="image"
          href={heroImage}
          crossorigin={heroImageOrigin ? 'anonymous' : undefined}
        />
      )}
      <link rel="canonical" href={new URL(`/posts/${canonicalSlug}/`, siteConfig.site.url).href} />
      {hasTranslations && (
        <>
          <link rel="alternate" hreflang="x-default" href={new URL(`/posts/${canonicalSlug}/`, siteConfig.site.url).href} />
          {renderedVariants.map((v) => (
            <link rel="alternate" hreflang={v.lang} href={new URL(`/posts/${canonicalSlug}/`, siteConfig.site.url).href} />
          ))}
        </>
      )}
    </Fragment>

    <Fragment slot="hero">
      <PostHero
        slug={postEntry.id}
        title={publicFacingTitle}
        summary={heroSummary}
        image={heroImage}
        imageAlt={heroImageAlt}
        video={postEntry.data.coverVideo}
        videoPoster={postEntry.data.coverVideoPoster ?? heroImage}
        fallbackImage={siteConfig.post.hero.fallbackImage}
        remoteFallbackImage={siteConfig.post.hero.remoteFallbackImage}
        badges={badges}
        meta={meta}
        runtimeMetrics={siteConfig.post.hero.runtimeMetrics && isUnlocked}
        translations={translationsByLang}
        currentLang={effectiveCurrentLang}
      />
    </Fragment>

    <div id="post" class="post post-page-shell">
      {isUnlocked && (
        <AiSummaryPanel
          slug={postEntry.id}
          title={publicFacingTitle}
          summary={(postEntry.data as any).aiSummary || (postEntry.data as any).ai_summary || (postEntry.data as any).summary || postEntry.data.description || ''}
          staticSummary={typedAiSummaries[postEntry.id]?.summary || ''}
          staticSummariesByLang={staticSummariesByLang}
          articleLang={effectiveCurrentLang}
          url={Astro.url.href}
          related={relatedPosts.map((post) => ({
            title: post.data.title,
            href: `/posts/${getPostCanonicalSlug(post.id)}/`,
          }))}
        />
      )}

      <article
        id="article-container"
        class="article-body post-content"
        data-content-features={isUnlocked ? 'true' : undefined}
        data-route={isEncryptedRoute ? 'encrypted' : 'normal'}
        data-lang={effectiveCurrentLang}
      >
        {isUnlocked && renderedVariants.length > 0 ? (
          renderedVariants.map(({ lang: vLang, Content: VariantContent }) => (
            <div
              class="article-translation-variant"
              data-lang={vLang}
              style={vLang === effectiveCurrentLang ? '' : 'display: none;'}
            >
              <VariantContent />
            </div>
          ))
        ) : isUnlocked && Content ? (
          <Content />
        ) : (
          <section class="content-access-panel content-access-panel--server">
            <span class="content-access-panel__eyebrow">访问验证</span>
            <h2>{accessState.locationAllowed ? '这篇文章需要解锁后阅读' : '当前网络环境不可访问这篇文章'}</h2>
            <p>{unlockErrorMessage || accessState.denialReason}</p>
            {accessState.requiresPassword && accessState.locationAllowed && (
              <form method="post" class="content-access-panel__form">
                <input type="password" name="post-password" autocomplete="current-password" placeholder="输入文章密码" required />
                <button type="submit">解锁文章</button>
              </form>
            )}
            {siblingTranslations.length > 1 && (
              <div class="content-access-panel__i18n-hint">
                <Globe className="content-access-panel__i18n-icon" aria-hidden="true" />
                <span>包含 {siblingTranslations.length} 种语言译本，解锁后可自由切换阅读</span>
              </div>
            )}
            {!accessState.locationAllowed && (
              <div class="content-access-panel__status" data-state="error">
                已根据当前请求地址与地区策略拦截访问。
              </div>
            )}
            {unlockErrorMessage && (
              <div class="content-access-panel__status" data-state="error">
                {unlockErrorMessage}
              </div>
            )}
          </section>
        )}
      </article>

      {isUnlocked && <ContentFeatureEnhancer
        lang={currentLang}
        externalEncryptData={isEncryptedRoute && matchedEncryptConfig ? {
          hash: matchedEncryptConfig.hash,
          hint: matchedEncryptConfig.hint ?? '',
          normalPostUrl,
          isEncryptedRoute: true,
        } : undefined}
        showEncryptButtons={!isEncryptedRoute && allEncryptConfigs.length > 0 ? (
          allEncryptConfigs
            .filter((c) => c.showButton !== false && c.hash)
            .map((c) => ({
              href: `/posts/${resolveConfigSlug(postEntry.id, c)}/`,
              title: c.title ?? postEntry.data.title,
              hint: c.hint ?? '',
            }))
        ) : undefined}
      />}

      {isUnlocked && (
        <PostOutdateNotice
          referenceDate={postEntry.data.updatedDate ?? postEntry.data.pubDate}
          configuredDays={postEntry.data.outdateDays ?? postEntry.data.validDays}
        />
      )}

      {isUnlocked && siteConfig.theme.features.postCopyright && (
        <PostCopyright
          permalink={new URL(`/posts/${canonicalSlug}/`, siteConfig.site.url).href}
          title={publicFacingTitle}
          shortTitle={postEntry.data.shortTitle || postEntry.data.short_title}
          cover={heroImage}
          summary={postEntry.data.description ?? ''}
          authorName={siteConfig.site.author.name}
          authorRole={siteConfig.site.author.role}
          authorAvatar={siteConfig.site.author.avatar}
          badge={isOriginal ? siteConfig.post.copyright.badge : '转载'}
          copyrightTitle={siteConfig.post.copyright.title}
          notice={siteConfig.post.copyright.notice}
          copyLabel={siteConfig.post.copyright.copyLabel}
          rewardLabel={siteConfig.post.copyright.rewardLabel}
          rewardNote={siteConfig.post.copyright.rewardNote}
          aboutTitle={siteConfig.post.tools.aboutTitle}
          modeHref={siteConfig.post.tools.modeHref}
          modeLabel={siteConfig.post.tools.modeLabel}
          modeDescription={siteConfig.post.tools.modeDescription}
          shareLabel={siteConfig.post.tools.shareLabel}
          rewardHref={siteConfig.post.tools.rewardHref}
          rewardDescription={siteConfig.post.tools.rewardDescription}
          copyDoneLabel={siteConfig.post.tools.copyDoneLabel}
          shareDoneLabel={siteConfig.post.tools.shareDoneLabel}
          shareFallbackLabel={siteConfig.post.tools.shareFallbackLabel}
        />
      )}

      {isUnlocked && scannedTags.length > 0 && (
        <div class="post-tools-right post-tags-row">
          <div class="tag_share">
            <div class="post-meta__box">
              <div class="post-meta__box__tag-list">
                {scannedTags.map((tag) => (
                  <a class="post-meta__box__tags" href={`/tags/${encodeURIComponent(tag.toLowerCase())}/`}>
                    <span class="tags-punctuation"><i class="anzhiyufont anzhiyu-icon-tag"></i></span>
                    {tag}
                    <span class="tagsPageCount">{tagCounts[tag] || 1}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      )}

      {isUnlocked && siteConfig.theme.features.relatedPosts && relatedPosts.length > 0 && (
        <RelatedPosts
          posts={relatedPosts}
          eyebrow={siteConfig.post.related.eyebrow}
          title={siteConfig.post.related.title}
        />
      )}

      {isUnlocked && <PostEndRecommendation nextPost={nextPost} />}

      {commentsEnabled && <hr class="custom-hr" />}

      {commentsEnabled && (
        <PostComments
          client:idle
          slug={canonicalSlug}
          title={publicFacingTitle}
          heading={siteConfig.post.comments.title}
          policyLabel={siteConfig.post.comments.policyLabel}
          notice={siteConfig.post.comments.notice}
          submitLabel={siteConfig.post.comments.submitLabel}
          previewLabel={siteConfig.post.comments.previewLabel}
          emptyTitle={siteConfig.post.comments.emptyTitle}
          emptySummary={siteConfig.post.comments.emptySummary}
          tips={siteConfig.post.comments.tips}
          integration={siteConfig.integrations.comments}
        />
      )}

      {hasTranslations && (
        <script
          id="shijianus-article-variants-data"
          type="application/json"
          set:html={JSON.stringify({
            canonicalSlug,
            defaultLang: effectiveCurrentLang,
            availableLangs: renderedVariants.map((v) => v.lang),
            tocDictionary: getSerializedTocDictionary(),
            variantsMeta: Object.fromEntries(
              renderedVariants.map((v) => [
                v.lang,
                {
                  title: v.title,
                  summary: v.summary,
                  lang: v.lang,
                  tags: v.post?.data?.tags || [],
                },
              ])
            ),
            staticSummariesByLang,
          })}
        />
      )}

      {hasTranslations && (
        <script is:inline>
          (function () {
            const dataEl = document.getElementById('shijianus-article-variants-data');
            if (!dataEl) return;
            let config;
            try {
              config = JSON.parse(dataEl.textContent || '{}');
            } catch (_) {
              return;
            }

            const {
              availableLangs = [],
              variantsMeta = {},
              staticSummariesByLang = {},
              defaultLang = 'zh-CN',
              tocDictionary = {},
            } = config;

            function normalizeLang(raw) {
              if (!raw) return 'zh-CN';
              const trimmed = String(raw).trim().toLowerCase().replace(/_/g, '-');
              if (trimmed === 'zh-cn' || trimmed === 'zh' || trimmed === 'zh-hans') return 'zh-CN';
              if (trimmed === 'zh-hant' || trimmed === 'zh-tw' || trimmed === 'zh-hk' || trimmed === 'zh-mo') return 'zh-Hant';
              if (trimmed.startsWith('en')) return 'en';
              if (trimmed.startsWith('es')) return 'es';
              if (trimmed.startsWith('de')) return 'de';
              if (trimmed.startsWith('fr')) return 'fr';
              if (trimmed.startsWith('ja')) return 'ja';
              if (trimmed.startsWith('ko')) return 'ko';
              if (trimmed.startsWith('ru')) return 'ru';
              if (trimmed.startsWith('it')) return 'it';
              if (trimmed.startsWith('pt')) return 'pt';
              if (trimmed.startsWith('vi')) return 'vi';
              if (trimmed.startsWith('ar')) return 'ar';
              if (trimmed.startsWith('nl')) return 'nl';
              if (trimmed.startsWith('pl')) return 'pl';
              if (trimmed.startsWith('tr')) return 'tr';
              if (trimmed.startsWith('sv')) return 'sv';
              if (trimmed.startsWith('no')) return 'no';
              if (trimmed.startsWith('da')) return 'da';
              if (trimmed.startsWith('fi')) return 'fi';
              if (trimmed.startsWith('th')) return 'th';
              if (trimmed.startsWith('id')) return 'id';
              if (trimmed.startsWith('uk')) return 'uk';
              return trimmed;
            }

            let lastSwitchTime = 0;

            window.switchArticleLanguage = function (targetLang) {
              const now = Date.now();
              if (now - lastSwitchTime < 60) return;
              lastSwitchTime = now;

              targetLang = normalizeLang(targetLang);
              if (!availableLangs.includes(targetLang)) {
                const match = availableLangs.find((l) => l.toLowerCase() === targetLang.toLowerCase());
                if (match) targetLang = match;
                else targetLang = defaultLang;
              }

              // 0. Capture current reading position anchor before switching
              let anchorSelector = null;
              const currentVariant = document.querySelector('.article-translation-variant:not([style*="display: none"])');
              if (currentVariant && window.scrollY > 150) {
                const headings = Array.from(currentVariant.querySelectorAll('h1, h2, h3, h4, [id]'));
                for (let i = headings.length - 1; i >= 0; i--) {
                  const h = headings[i];
                  const rect = h.getBoundingClientRect();
                  if (rect.top <= 140 && rect.bottom >= -600) {
                    anchorSelector = { index: i, id: h.id };
                    break;
                  }
                }
              }

              // 1. Switch visible variant
              const variants = document.querySelectorAll('.article-translation-variant');
              variants.forEach((v) => {
                if (v.dataset.lang === targetLang) {
                  v.style.display = '';
                } else {
                  v.style.display = 'none';
                }
              });

              // 2. Update article and html language attributes
              const article = document.getElementById('article-container');
              if (article) article.dataset.lang = targetLang;
              document.documentElement.lang = targetLang;
              document.documentElement.dataset.localeVariant = targetLang;

              // 3. Update Hero Title & Summary & Document Title
              const meta = variantsMeta[targetLang];
              if (meta) {
                const titleEl = document.querySelector('.post-hero__title-block h1');
                if (titleEl && meta.title) titleEl.textContent = meta.title;
                const ledeEl = document.querySelector('.post-hero__lede');
                if (ledeEl && meta.summary) ledeEl.textContent = meta.summary;
                if (meta.title) {
                  const parts = document.title.split(' - ');
                  const suffix = parts.length > 1 ? parts.slice(1).join(' - ') : '';
                  document.title = suffix ? `${meta.title} - ${suffix}` : meta.title;
                }
              }

              // 4. Update PostHero buttons active state
              document.querySelectorAll('.post-hero__lang-tag').forEach((btn) => {
                const isMatch = btn.dataset.targetLang === targetLang;
                btn.classList.toggle('is-active', isMatch);
                btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
                if (isMatch) btn.setAttribute('aria-current', 'page');
                else btn.removeAttribute('aria-current');
              });

              // 5. Update AI Summary text if present
              const aiSummaryContent = document.querySelector('.ai-summary__content, .ai-summary__text');
              if (aiSummaryContent && staticSummariesByLang[targetLang]) {
                aiSummaryContent.textContent = staticSummariesByLang[targetLang];
              }

              // 5.1 Update article footer tags if present
              if (meta && Array.isArray(meta.tags) && meta.tags.length > 0) {
                const tagContainer = document.querySelector('.post-meta__box__tag-list');
                if (tagContainer) {
                  tagContainer.innerHTML = meta.tags
                    .map((t) => `<a class="post-meta__box__tags" href="/tags/${encodeURIComponent(t.toLowerCase())}/"><span class="tags-punctuation"><i class="anzhiyufont anzhiyu-icon-tag"></i></span>${t}</a>`)
                    .join('');
                }
              }

              // 6. Update TOC: title, count, and active variant TOC (from centralized config)
              const tMeta = tocDictionary[targetLang] ||
                            tocDictionary[targetLang.split('-')[0]] ||
                            (targetLang.startsWith('zh') ? tocDictionary['zh-CN'] : (tocDictionary['en'] || { title: 'Contents', unit: 'sections' }));
              const tocTitleEl = document.querySelector('#card-toc [data-i18n-toc-title]');
              if (tocTitleEl && tMeta) tocTitleEl.textContent = tMeta.title;

              document.querySelectorAll('.variant-toc-list').forEach((vtoc) => {
                const isActive = vtoc.dataset.lang === targetLang;
                vtoc.style.display = isActive ? '' : 'none';
                if (isActive) {
                  const countEl = document.querySelector('#card-toc [data-i18n-toc-count]');
                  if (countEl && vtoc.dataset.tocCount) {
                    countEl.textContent = vtoc.dataset.tocCount;
                  }
                }
              });

              // 7. Store user preference in localStorage
              try {
                window.localStorage.setItem('shijianus-manual-locale-selected', targetLang);
                window.localStorage.setItem('shijianus-locale-variant', targetLang);
              } catch (_) {}

              // 8. Restore reading scroll position gently if midway through reading
              if (anchorSelector) {
                const newVariant = document.querySelector('.article-translation-variant:not([style*="display: none"])');
                if (newVariant) {
                  let targetNode = null;
                  if (anchorSelector.id) {
                    try {
                      targetNode = newVariant.querySelector('[id="' + CSS.escape(anchorSelector.id) + '"]');
                    } catch (_) {}
                  }
                  if (!targetNode && typeof anchorSelector.index === 'number') {
                    const newHeadings = Array.from(newVariant.querySelectorAll('h1, h2, h3, h4, [id]'));
                    targetNode = newHeadings[anchorSelector.index] || newHeadings[0];
                  }
                  if (targetNode) {
                    const prevBehavior = document.documentElement.style.scrollBehavior;
                    document.documentElement.style.scrollBehavior = 'auto';
                    const targetTop = targetNode.getBoundingClientRect().top + window.scrollY - 110;
                    window.scrollTo({ top: Math.max(0, targetTop), behavior: 'instant' });
                    requestAnimationFrame(() => {
                      document.documentElement.style.scrollBehavior = prevBehavior;
                    });
                  }
                }
              }

              // 9. Re-trigger content feature enhancement & trigger global resize for Mermaid / KaTeX / code blocks
              window.dispatchEvent(new CustomEvent('shijianus:localechange', { detail: targetLang }));
              window.dispatchEvent(new Event('resize'));
              document.documentElement.lang = targetLang;
              document.documentElement.dataset.localeVariant = targetLang;
              setTimeout(() => {
                document.documentElement.lang = targetLang;
                document.documentElement.dataset.localeVariant = targetLang;
                window.dispatchEvent(new Event('resize'));
              }, 10);
            };

            // Attach click listeners to PostHero language buttons
            document.querySelectorAll('.post-hero__lang-tag[data-target-lang]').forEach((btn) => {
              btn.addEventListener('click', function (e) {
                e.preventDefault();
                const tLang = this.dataset.targetLang;
                if (tLang) window.switchArticleLanguage(tLang);
              });
            });

            // Listen for global locale changes from header/account drawer
            window.addEventListener('shijianus:localechange', function (e) {
              const nextLang = e && e.detail ? e.detail : '';
              if (nextLang && availableLangs.includes(nextLang)) {
                const currentVisible = document.querySelector('.article-translation-variant:not([style*="display: none"])');
                if (currentVisible && currentVisible.dataset.lang !== nextLang) {
                  window.switchArticleLanguage(nextLang);
                }
              }
            });

            // Determine initial language:
            // Priority 1: Manual user choice
            // Priority 2: Stored locale variant
            // Priority 3 (First-time visitor): Browser language persona
            let initialLang = '';
            try {
              initialLang = window.localStorage.getItem('shijianus-manual-locale-selected') ||
                            window.localStorage.getItem('shijianus-locale-variant') || '';
            } catch (_) {}

            if (!initialLang) {
              const navLang = (navigator.language || navigator.userLanguage || '').toLowerCase();
              if (navLang.startsWith('en')) initialLang = 'en';
              else if (navLang.startsWith('es')) initialLang = 'es';
              else if (navLang.startsWith('de')) initialLang = 'de';
              else if (navLang.startsWith('fr')) initialLang = 'fr';
              else if (navLang.startsWith('ja')) initialLang = 'ja';
              else if (navLang.startsWith('ko')) initialLang = 'ko';
              else if (navLang.startsWith('ru')) initialLang = 'ru';
              else if (navLang.startsWith('it')) initialLang = 'it';
              else if (navLang.startsWith('pt')) initialLang = 'pt';
              else if (navLang.startsWith('vi')) initialLang = 'vi';
              else if (navLang.startsWith('ar')) initialLang = 'ar';
              else if (navLang === 'zh-tw' || navLang === 'zh-hk' || navLang.includes('hant')) initialLang = 'zh-Hant';
              else if (navLang.startsWith('zh')) initialLang = 'zh-CN';
              else {
                const prefix = navLang.split('-')[0];
                if (availableLangs.includes(prefix)) initialLang = prefix;
              }
            }

            if (initialLang && availableLangs.includes(initialLang) && initialLang !== defaultLang) {
              window.switchArticleLanguage(initialLang);
            }

            // Calibrate hash scroll anchor to the active variant
            if (window.location.hash) {
              const rawHash = window.location.hash.slice(1);
              try {
                const target = document.querySelector('.article-translation-variant:not([style*="display: none"]) [id="' + CSS.escape(decodeURIComponent(rawHash)) + '"]');
                if (target) {
                  setTimeout(() => target.scrollIntoView({ behavior: 'smooth' }), 120);
                }
              } catch (_) {}
            }
          })();
        </script>
      )}
    </div>
  </BlogLayout>
)}
