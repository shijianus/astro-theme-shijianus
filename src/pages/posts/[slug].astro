---
import { createHash } from 'node:crypto';
import { getCollection, render } from 'astro:content';
import ContentFeatureEnhancer from '../../components/ContentFeatureEnhancer.astro';
import PostHero from '../../components/theme/PostHero.astro';
import PostCopyright from '../../components/theme/PostCopyright.astro';
import Sidebar from '../../components/theme/Sidebar.astro';
import PostNav from '../../components/theme/PostNav.astro';
import RelatedPosts from '../../components/theme/RelatedPosts.astro';
import { PostComments } from '../../components/theme/PostComments';
import { siteConfig } from '../../config/site';
import BlogLayout from '../../layouts/BlogLayout.astro';
import {
  estimateReadingMinutes,
  estimateWordCount,
  getCategoryPath,
  getRelatedPosts,
  getTagPath,
  resolveCategory,
  resolveCover,
  resolveCoverAlt,
  sortPostsByDate,
} from '../../lib/content';
import { hasConfiguredCommentDatabase } from '../../lib/comment-integration';
import { createSidebarData } from '../../lib/theme';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;
const allPosts = sortPostsByDate(await getCollection('posts'));
const entry = allPosts.find((post) => post.id === slug);

if (!entry) {
  throw new Error(`Post not found: ${slug}`);
}

const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 6);
const relatedPosts = getRelatedPosts(allPosts, entry, 3);
const sidebarData = createSidebarData(allPosts, headings);
sidebarData.recentPosts = allPosts.filter((post) => post.id !== entry.id);
const postIndex = allPosts.findIndex((post) => post.id === entry.id);
const previousPost = postIndex > 0 ? allPosts[postIndex - 1] : null;
const nextPost = postIndex >= 0 && postIndex < allPosts.length - 1 ? allPosts[postIndex + 1] : null;

const wordCount = estimateWordCount(entry);
const formatHeroDate = (date: Date) => {
  return `${String(date.getMonth() + 1).padStart(2, '0')}/${String(date.getDate()).padStart(2, '0')}/${String(date.getFullYear()).slice(-2)}`;
};
const category = resolveCategory(entry);
const isOriginal = entry.data.author.trim().toLowerCase() === siteConfig.site.author.name.trim().toLowerCase();
const originalBadge = siteConfig.post.hero.detectOriginalTag ? [isOriginal ? '原创' : '转载'] : [];
const scannedTags = [...new Set(entry.data.tags.map((tag) => tag.trim()).filter(Boolean))];
const tagLimit = Math.max(0, siteConfig.post.hero.maxTags - originalBadge.length);
const badges = [...originalBadge, ...scannedTags.slice(0, tagLimit)];
const heroImage = resolveCover(entry);
const heroImageAlt = resolveCoverAlt(entry);
const heroImageUrl = new URL(heroImage, siteConfig.site.url);
const heroImageOrigin = heroImageUrl.origin !== new URL(siteConfig.site.url).origin ? heroImageUrl.origin : '';
const meta = [
  { label: siteConfig.post.hero.metaLabels.published, value: formatHeroDate(entry.data.pubDate), icon: 'calendar' as const },
  entry.data.updatedDate && {
    label: siteConfig.post.hero.metaLabels.updated,
    value: formatHeroDate(entry.data.updatedDate),
    icon: 'refresh' as const,
  },
  { label: siteConfig.post.hero.metaLabels.category, value: category, icon: 'folder' as const },
  { label: siteConfig.post.hero.metaLabels.words, value: wordCount.toLocaleString('zh-CN'), icon: 'file' as const },
  { label: siteConfig.post.hero.metaLabels.reading, value: `${estimateReadingMinutes(entry)} min`, icon: 'clock' as const },
  { label: siteConfig.post.hero.metaLabels.views, value: '0 次', runtime: 'views' as const, icon: 'eye' as const },
  { label: siteConfig.post.hero.metaLabels.dwell, value: '0 min', runtime: 'dwell' as const, icon: 'timer' as const },
].filter(Boolean) as {
  label: string;
  value: string;
  runtime?: 'views' | 'dwell';
  icon?: 'calendar' | 'refresh' | 'folder' | 'file' | 'clock' | 'eye' | 'timer';
}[];
const access = entry.data.access;
const accessPasswordHash = access?.passwordHash ?? (access?.password ? createHash('sha256').update(access.password).digest('hex') : '');
const accessBlockedCountries = access?.blockedCountries?.map((item) => item.toUpperCase()).join(',') ?? '';
const accessBlockedIps = access?.blockedIps?.map((item) => item.toUpperCase()).join(',') ?? '';
const hasAccessGate = Boolean(accessPasswordHash || accessBlockedCountries || accessBlockedIps);
const commentsEnabled = hasConfiguredCommentDatabase(siteConfig.integrations.comments);
const hasTocAside = siteConfig.theme.features.postToc && tocHeadings.length > 0;
sidebarData.postContext = {
  title: entry.data.title,
  summary: entry.data.description,
  category: {
    label: category,
    href: getCategoryPath(category),
  },
  meta: [
    `${siteConfig.post.hero.metaLabels.published} ${formatHeroDate(entry.data.pubDate)}`,
    `${wordCount.toLocaleString('zh-CN')} 字`,
    `${estimateReadingMinutes(entry)} min`,
  ],
  tags: scannedTags.slice(0, 8).map((tag) => ({
    label: tag,
    href: getTagPath(tag),
  })),
  actions: [
    ...(commentsEnabled ? [{ label: '跳到评论', href: '#post-comment', kind: 'comment' as const }] : []),
    { label: '支持作者', href: '/about/#about-reward', kind: 'reward' as const },
    { label: '查看归档', href: '/archives/', kind: 'archive' as const },
  ],
};
const hasSecondaryAside = Boolean(sidebarData.postContext || sidebarData.recentPosts.length || sidebarData.tags.length || sidebarData.archives.length);
---

<BlogLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebarData={sidebarData}
  pageType="post"
  showAside={false}
>
  <Fragment slot="head">
    {heroImageOrigin && <link rel="preconnect" href={heroImageOrigin} crossorigin="anonymous" />}
    <link
      rel="preload"
      as="image"
      href={heroImage}
      crossorigin={heroImageOrigin ? 'anonymous' : undefined}
    />
  </Fragment>

  <Fragment slot="hero">
    <PostHero
      slug={entry.id}
      title={entry.data.title}
      summary={entry.data.description ?? siteConfig.post.hero.summaryFallback}
      image={heroImage}
      imageAlt={heroImageAlt}
      fallbackImage={siteConfig.post.hero.fallbackImage}
      badges={badges}
      meta={meta}
      runtimeMetrics={siteConfig.post.hero.runtimeMetrics}
    />
  </Fragment>

  <div class="post-layout-stack">
    <section class:list={['post-layout-row', 'post-layout-row--article', !hasTocAside && 'post-layout-row--single']}>
      <div class="post-layout-row__main">
        <section id="post" class="post-page-shell">
          <article
            id="article-container"
            class="theme-card article-body post-content"
            data-content-features
            data-access-locked={hasAccessGate ? 'true' : undefined}
            data-access-password-hash={accessPasswordHash || undefined}
            data-access-blocked-countries={accessBlockedCountries || undefined}
            data-access-blocked-ips={accessBlockedIps || undefined}
            data-access-message={access?.message ?? undefined}
          >
            <Content />
          </article>
          <ContentFeatureEnhancer />
        </section>
      </div>

      {hasTocAside && (
        <aside class="post-layout-row__aside post-layout-row__aside--toc">
          <Sidebar {...sidebarData} pageType="post-toc" asideId="post-toc-aside" />
        </aside>
      )}
    </section>

    <section class:list={['post-layout-row', 'post-layout-row--support', !hasSecondaryAside && 'post-layout-row--single']}>
      <div class="post-layout-row__main">
        {siteConfig.theme.features.postCopyright && (
          <PostCopyright
            permalink={Astro.url.href}
            title={entry.data.title}
            summary={entry.data.description ?? ''}
            authorName={siteConfig.site.author.name}
            authorRole={siteConfig.site.author.role}
            authorAvatar={siteConfig.site.author.avatar}
            badge={isOriginal ? siteConfig.post.copyright.badge : '转载'}
            copyrightTitle={siteConfig.post.copyright.title}
            notice={siteConfig.post.copyright.notice}
            copyLabel={siteConfig.post.copyright.copyLabel}
            rewardLabel={siteConfig.post.copyright.rewardLabel}
            rewardNote={siteConfig.post.copyright.rewardNote}
            aboutTitle={siteConfig.post.tools.aboutTitle}
            modeHref={siteConfig.post.tools.modeHref}
            modeLabel={siteConfig.post.tools.modeLabel}
            modeDescription={siteConfig.post.tools.modeDescription}
            shareLabel={siteConfig.post.tools.shareLabel}
            rewardHref={siteConfig.post.tools.rewardHref}
            rewardDescription={siteConfig.post.tools.rewardDescription}
            copyDoneLabel={siteConfig.post.tools.copyDoneLabel}
            shareDoneLabel={siteConfig.post.tools.shareDoneLabel}
            shareFallbackLabel={siteConfig.post.tools.shareFallbackLabel}
            category={category}
            tags={entry.data.tags}
          />
        )}

        <PostNav previousPost={previousPost} nextPost={nextPost} />

        {siteConfig.theme.features.relatedPosts && relatedPosts.length > 0 && (
          <RelatedPosts
            posts={relatedPosts}
            eyebrow={siteConfig.post.related.eyebrow}
            title={siteConfig.post.related.title}
          />
        )}

        {commentsEnabled && (
          <PostComments
            client:only="react"
            slug={entry.id}
            title={entry.data.title}
            heading={siteConfig.post.comments.title}
            policyLabel={siteConfig.post.comments.policyLabel}
            notice={siteConfig.post.comments.notice}
            submitLabel={siteConfig.post.comments.submitLabel}
            previewLabel={siteConfig.post.comments.previewLabel}
            emptyTitle={siteConfig.post.comments.emptyTitle}
            emptySummary={siteConfig.post.comments.emptySummary}
            tips={siteConfig.post.comments.tips}
            integration={siteConfig.integrations.comments}
          />
        )}
      </div>

      {hasSecondaryAside && (
        <aside class="post-layout-row__aside post-layout-row__aside--secondary">
          <Sidebar {...sidebarData} pageType="post-secondary" asideId="post-secondary-aside" />
        </aside>
      )}
    </section>
  </div>
</BlogLayout>
