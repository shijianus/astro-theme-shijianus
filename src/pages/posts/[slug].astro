---
import { getCollection, render } from 'astro:content';
import PageHero from '../../components/theme/PageHero.astro';
import PostCard from '../../components/theme/PostCard.astro';
import { siteConfig } from '../../config/site';
import BlogLayout from '../../layouts/BlogLayout.astro';
import {
  estimateReadingMinutes,
  getRelatedPosts,
  resolveCategory,
  resolveCover,
  resolveCoverAlt,
  resolveGroup,
  sortPostsByDate,
} from '../../lib/content';
import { createSidebarData } from '../../lib/theme';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;
const allPosts = sortPostsByDate(await getCollection('posts'));
const entry = allPosts.find((post) => post.id === slug);

if (!entry) {
  throw new Error(`Post not found: ${slug}`);
}

const { Content, headings } = await render(entry);
const relatedPosts = getRelatedPosts(allPosts, entry, 3);
const sidebarData = createSidebarData(allPosts, headings);
sidebarData.recentPosts = allPosts.filter((post) => post.id !== entry.id);

const meta = [
  resolveCategory(entry),
  resolveGroup(entry),
  `${estimateReadingMinutes(entry)} min read`,
  entry.data.pubDate.toLocaleDateString('zh-CN'),
];
---

<BlogLayout title={entry.data.title} description={entry.data.description} sidebarData={sidebarData}>
  <Fragment slot="hero">
    <PageHero
      eyebrow={`${resolveCategory(entry)} / ${resolveGroup(entry)}`}
      title={entry.data.title}
      summary={entry.data.description ?? ''}
      image={resolveCover(entry)}
      imageAlt={resolveCoverAlt(entry)}
      meta={meta}
    />
  </Fragment>

  <article class="theme-card article-body">
    <Content />
  </article>

  {siteConfig.theme.features.postCopyright && (
    <section class="theme-card theme-card--soft grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
      <div class="space-y-2">
        <p class="eyebrow">版权提示</p>
        <h2 class="text-2xl font-semibold text-[var(--text-strong)]">转载或引用请保留来源</h2>
        <p class="text-sm leading-7 text-[var(--text-soft)]">
          本文属于 {siteConfig.site.name} 的长期写作记录，欢迎分享观点，但请保留原始链接与作者署名。
        </p>
      </div>
      <a href={Astro.url.href} class="theme-button theme-button--ghost break-all">
        复制文章链接
      </a>
    </section>
  )}

  {entry.data.tags.length > 0 && (
    <section class="theme-card theme-card--soft space-y-4">
      <p class="eyebrow">Tags</p>
      <div class="flex flex-wrap gap-2">
        {entry.data.tags.map((tag) => (
          <a href={`/tags/${tag.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fa5]+/g, '-').replace(/^-+|-+$/g, '')}/`} class="theme-chip theme-chip--soft">
            #{tag}
          </a>
        ))}
      </div>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="space-y-4">
      <div class="space-y-2">
        <p class="eyebrow">Related Posts</p>
        <h2 class="text-3xl font-semibold text-[var(--text-strong)]">继续阅读</h2>
      </div>
      <div class="space-y-4">
        {relatedPosts.map((post, index) => (
          <PostCard entry={post} index={index} />
        ))}
      </div>
    </section>
  )}
</BlogLayout>
