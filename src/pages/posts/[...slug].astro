---
import { getCollection } from 'astro:content';
import GeekLayout from '../../layouts/GeekLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<GeekLayout title={entry.data.title}>
  <article class="prose prose-invert prose-primary max-w-none">
    <div class="mb-12 space-y-4">
      <div class="flex items-center gap-4 text-sm font-mono text-primary uppercase tracking-widest">
        <span>{entry.data.space}</span>
        <span class="text-white/20">/</span>
        <span>{entry.data.group}</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight !mb-0">{entry.data.title}</h1>
      <p class="text-xl text-gray-400 font-medium italic">{entry.data.description}</p>
      <div class="flex items-center gap-6 pt-4 border-t border-white/10">
        <div class="flex items-center gap-2">
          <div class="h-8 w-8 rounded-full bg-white/10 border border-white/20" />
          <span class="text-sm font-bold">{entry.data.author}</span>
        </div>
        <div class="h-4 w-px bg-white/10" />
        <span class="text-sm text-gray-500 font-mono">
          {entry.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </span>
      </div>
    </div>
    
    <div class="content-wrapper prose-pre:!p-0">
      <Content />
    </div>

    <div class="mt-24 pt-12 border-t border-white/5">
      <div class="flex flex-wrap gap-2">
        {entry.data.tags.map(tag => (
          <span class="px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-xs font-bold text-primary">#{tag}</span>
        ))}
      </div>
    </div>
  </article>
</GeekLayout>

<style is:global>
  .content-wrapper h2 {
    @apply text-3xl font-bold mt-12 mb-6 border-l-4 border-primary pl-4;
  }
  .content-wrapper p {
    @apply text-gray-300 leading-relaxed mb-6;
  }
  .content-wrapper ul {
    @apply list-disc list-inside space-y-2 mb-6 text-gray-300;
  }
</style>
