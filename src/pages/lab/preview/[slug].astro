---
import { getCollection } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import {
  OFFICIAL_LAB_EXPERIMENTS,
  getExperimentBySlug,
} from '../../../data/lab-experiments';
import {
  buildIsolatedSandboxSrcDoc,
  resolveExperimentSourceKind,
  resolveSafeExternalSandboxOrigin,
} from '../../../lib/lab-sandbox-protocol';
import { getPublicPosts } from '../../../lib/content';
import { createSidebarData } from '../../../lib/theme';

export function getStaticPaths() {
  return OFFICIAL_LAB_EXPERIMENTS.map((exp) => ({
    params: { slug: exp.slug },
    props: { experiment: exp },
  }));
}

const { slug } = Astro.params;
const experiment =
  Astro.props.experiment ||
  getExperimentBySlug(slug || '') ||
  OFFICIAL_LAB_EXPERIMENTS[0];

const sourceKind = resolveExperimentSourceKind(experiment.author);

const rawSandboxOrigin =
  import.meta.env.PUBLIC_LAB_SANDBOX_ORIGIN ||
  process.env.PUBLIC_LAB_SANDBOX_ORIGIN ||
  '';
const sandboxResolution = resolveSafeExternalSandboxOrigin(rawSandboxOrigin);
const safeExternalOrigin = sandboxResolution.enabled ? sandboxResolution.origin || '' : '';

// 严禁在静态构建期固化单次 sessionId 或 CSP Nonce；构建期仅写入占位符，每次浏览器访问与重置均使用客户端 CSPRNG 动态签发一次性随机令牌
const BUILD_SESSION_PLACEHOLDER = '__LAB_RUNTIME_SESSION_ID__';
const BUILD_NONCE_PLACEHOLDER = 'LAB_RUNTIME_CSP_NONCE_PLACEHOLDER';
const initialSrcDoc = buildIsolatedSandboxSrcDoc({
  sessionId: BUILD_SESSION_PLACEHOLDER,
  cspNonce: BUILD_NONCE_PLACEHOLDER,
  files: experiment.files,
  theme: 'dark',
});

const posts = getPublicPosts(await getCollection('posts'));
const sidebarData = createSidebarData(posts);
---

<BlogLayout
  title={`独立预览: ${experiment.title} | 实验田 Lab`}
  description={`在独立沙盒视口中预览实验「${experiment.title}」的实时交互效果。`}
  showAside={false}
  pageType="page"
  sidebarData={sidebarData}
>
  <section
    class="lab-standalone-preview"
    data-preview-slug={experiment.slug}
    data-session-id=""
    data-source-kind={sourceKind}
    data-frame-title={`Standalone Sandbox Preview - ${experiment.title}`}
    data-external-sandbox-origin={safeExternalOrigin}
  >
    <template id="standalone-srcdoc-payload" data-srcdoc={initialSrcDoc}></template>

    <!-- 顶部导航壳层 (区分「用于导航的预览页面」与「真正执行代码的隔离沙盒 Iframe」) -->
    <div class="preview-nav-shell theme-card">
      <div class="preview-nav__left">
        <a href="/lab/" class="preview-back-btn">← 实验广场</a>
        <a href={`/lab/${experiment.slug}/`} class="preview-back-btn">📄 实验详情</a>
        <div class="preview-title-wrap">
          <span class="preview-icon">{experiment.icon}</span>
          <strong>{experiment.title}</strong>
          <span
            id="preview-isolation-badge"
            class="preview-sec-tag"
            title="内部 iframe 采用无 allow-same-origin 的 Opaque Sandbox 隔离运行"
          >
            {safeExternalOrigin ? '🔒 Cross-Site + Opaque 双层隔离中' : '🔒 Opaque Fallback 隔离运行中'}
          </span>
        </div>
      </div>

      <div class="preview-nav__right">
        <button id="btn-preview-reload" type="button" class="preview-action-btn">
          ↺ 重置并重新运行
        </button>
        <a
          href={`/lab/playground/?slug=${experiment.slug}`}
          class="preview-action-btn is-primary"
        >
          ⚡ 在代码工坊中编辑源码
        </a>
      </div>
    </div>

    <!-- 降级或失败关闭提示横幅 -->
    <div
      id="preview-fallback-banner"
      class="preview-fallback-notice"
      role="status"
      aria-live="polite"
      data-testid="preview-fallback-banner"
      hidden
    ></div>

    <!-- 真正执行代码的隔离沙盒容器（SSR 阶段不直接注入 srcdoc，由客户端安全门禁校验后挂载） -->
    <div id="preview-stage-mount" class="preview-stage-card theme-card"></div>
  </section>
</BlogLayout>

<script is:inline>
  (() => {
    const PROTOCOL = 'LAB_SANDBOX_PROTOCOL_V1';
    const rootEl = document.querySelector('.lab-standalone-preview');
    const mountEl = document.getElementById('preview-stage-mount');
    const payloadTpl = document.getElementById('standalone-srcdoc-payload');
    const reloadBtn = document.getElementById('btn-preview-reload');
    const badgeEl = document.getElementById('preview-isolation-badge');
    const noticeEl = document.getElementById('preview-fallback-banner');
    if (!rootEl || !mountEl || !payloadTpl) return;

    const SESSION_PLACEHOLDER = '__LAB_RUNTIME_SESSION_ID__';
    const NONCE_PLACEHOLDER = 'LAB_RUNTIME_CSP_NONCE_PLACEHOLDER';

    const baseSrcDoc = payloadTpl.getAttribute('data-srcdoc') || '';
    const sourceKind = rootEl.getAttribute('data-source-kind') || 'official';
    const frameTitle = rootEl.getAttribute('data-frame-title') || 'Standalone Sandbox Preview';
    const extOriginRaw = (rootEl.getAttribute('data-external-sandbox-origin') || '').trim();
    let sessionId = '';
    let iframe = null;

    const mintCsprngHex = () => {
      if (!window.crypto || typeof window.crypto.getRandomValues !== 'function') {
        return null;
      }
      const bytes = new Uint8Array(16);
      window.crypto.getRandomValues(bytes);
      return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
    };

    const rotateSessionId = () => {
      const hex = mintCsprngHex();
      if (!hex) return null;
      sessionId = `lab-sess-${hex}`;
      rootEl.setAttribute('data-session-id', sessionId);
      return sessionId;
    };

    const readTheme = () =>
      document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';

    const buildFreshRuntimeSrcDoc = (theme, activeSessionId) => {
      const nonceHex = mintCsprngHex();
      if (!nonceHex || !activeSessionId) return null;
      const freshNonce = `labnonce${nonceHex}`;
      return baseSrcDoc
        .split(SESSION_PLACEHOLDER)
        .join(activeSessionId)
        .split(NONCE_PLACEHOLDER)
        .join(freshNonce)
        .replace(/<html([^>]*)data-theme="(?:dark|light)"/, `<html$1data-theme="${theme}"`);
    };

    const isBlockedSharedHostname = (hostname) =>
      hostname === 'epocanvas.com' ||
      hostname.endsWith('.epocanvas.com') ||
      hostname === 'epocanvas.tech' ||
      hostname.endsWith('.epocanvas.tech') ||
      hostname === 'pvzos.com' ||
      hostname.endsWith('.pvzos.com') ||
      hostname === 'shijianus.com' ||
      hostname.endsWith('.shijianus.com') ||
      hostname === 'shijianus-blog.pages.dev' ||
      hostname.endsWith('.shijianus-blog.pages.dev') ||
      hostname === 'shijianus-github-io.pages.dev' ||
      hostname.endsWith('.shijianus-github-io.pages.dev') ||
      hostname === 'shijianus.github.io' ||
      hostname === 'shijian.qzz.io' ||
      hostname.endsWith('.shijian.qzz.io') ||
      hostname === '831511.xyz' ||
      hostname.endsWith('.831511.xyz');

    let validatedExternalOrigin = '';
    if (extOriginRaw && !extOriginRaw.includes('*') && !/\s/.test(extOriginRaw)) {
      try {
        const parsed = new URL(extOriginRaw);
        const hostname = parsed.hostname.toLowerCase();
        const isLoopback = hostname === 'localhost' || hostname === '127.0.0.1';
        const hostIsLoopback =
          window.location.protocol === 'http:' &&
          (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1');
        const protoAllowed =
          parsed.protocol === 'https:' || (parsed.protocol === 'http:' && isLoopback && hostIsLoopback);
        if (
          protoAllowed &&
          !parsed.username &&
          !parsed.password &&
          (!parsed.pathname || parsed.pathname === '/') &&
          !parsed.search &&
          !parsed.hash &&
          parsed.origin !== window.location.origin &&
          !isBlockedSharedHostname(hostname)
        ) {
          validatedExternalOrigin = parsed.origin;
        }
      } catch (_err) {
        validatedExternalOrigin = '';
      }
    }
    const hasValidExternalOrigin = Boolean(validatedExternalOrigin);

    let useExternalBridge = hasValidExternalOrigin;
    let bridgeAck = false;
    let bridgeSent = false;
    let handshakeTimer = null;
    let pingInterval = null;

    const clearBridgeTimers = () => {
      if (handshakeTimer) {
        clearTimeout(handshakeTimer);
        handshakeTimer = null;
      }
      if (pingInterval) {
        clearInterval(pingInterval);
        pingInterval = null;
      }
    };

    const showNotice = (text, isFailClosed) => {
      if (!noticeEl) return;
      noticeEl.textContent = text;
      noticeEl.className = isFailClosed
        ? 'preview-fallback-notice is-fail-closed'
        : 'preview-fallback-notice';
      noticeEl.hidden = false;
    };

    const hideNotice = () => {
      if (noticeEl) noticeEl.hidden = true;
    };

    const mountFailClosed = (reason) => {
      useExternalBridge = false;
      clearBridgeTimers();
      if (badgeEl) badgeEl.textContent = '🛑 Fail-Closed 已阻断';
      showNotice(reason, true);
      mountEl.innerHTML = '';
      const empty = document.createElement('div');
      empty.className = 'preview-fail-closed-box';
      empty.setAttribute('data-testid', 'preview-fail-closed-box');
      empty.textContent = reason;
      mountEl.appendChild(empty);
      iframe = null;
    };

    const mountLocalSrcDoc = (fallbackReason) => {
      if (sourceKind !== 'official') {
        mountFailClosed(
          '[Sandbox Fail-Closed] 非官方代码禁止回退至本地 opaque srcdoc，独立跨站沙盒未就绪，已强制失败关闭。'
        );
        return;
      }
      useExternalBridge = false;
      const nextSession = rotateSessionId();
      const nextDoc = nextSession ? buildFreshRuntimeSrcDoc(readTheme(), nextSession) : null;
      if (!nextSession || !nextDoc) {
        mountFailClosed('[Sandbox Fail-Closed] 当前浏览器缺少安全随机数生成器 (CSPRNG)，已拒绝启动沙盒。');
        return;
      }
      if (badgeEl) badgeEl.textContent = '🔒 Opaque Fallback 隔离运行中';
      showNotice(
        fallbackReason ||
          'ℹ️ 官方实验提示：当前未配置外部独立跨站沙盒，该受审阅官方实验已回退至本地无 allow-same-origin 的 Opaque srcdoc 强隔离模式运行。',
        false
      );
      const fresh = document.createElement('iframe');
      fresh.id = 'standalone-sandbox-iframe';
      fresh.title = frameTitle;
      fresh.setAttribute('sandbox', 'allow-scripts');
      fresh.setAttribute('referrerpolicy', 'no-referrer');
      fresh.setAttribute('data-testid', 'standalone-preview-iframe');
      fresh.setAttribute('data-isolation-mode', 'opaque-srcdoc');
      fresh.setAttribute('data-session-id', nextSession);
      fresh.className = 'standalone-sandbox-frame';
      fresh.srcdoc = nextDoc;
      mountEl.innerHTML = '';
      mountEl.appendChild(fresh);
      iframe = fresh;
    };

    const mountCrossOriginBridge = () => {
      const nextSession = rotateSessionId();
      if (!nextSession) {
        mountFailClosed('[Sandbox Fail-Closed] 当前浏览器缺少安全随机数生成器 (CSPRNG)，已拒绝启动沙盒。');
        return;
      }
      useExternalBridge = true;
      bridgeAck = false;
      bridgeSent = false;
      clearBridgeTimers();
      hideNotice();
      if (badgeEl) badgeEl.textContent = '🔒 Cross-Site + Opaque 双层隔离中';

      const fresh = document.createElement('iframe');
      fresh.id = 'standalone-sandbox-iframe';
      fresh.title = frameTitle;
      fresh.setAttribute('sandbox', 'allow-scripts allow-same-origin');
      fresh.setAttribute('referrerpolicy', 'no-referrer');
      fresh.setAttribute('data-testid', 'standalone-preview-iframe');
      fresh.setAttribute('data-isolation-mode', 'cross-origin');
      fresh.setAttribute('data-session-id', nextSession);
      fresh.className = 'standalone-sandbox-frame';
      fresh.src = validatedExternalOrigin + '/';
      const sendPing = () => {
        if (bridgeAck || !useExternalBridge || sessionId !== nextSession) {
          if (pingInterval) {
            clearInterval(pingInterval);
            pingInterval = null;
          }
          return;
        }
        try {
          fresh.contentWindow?.postMessage(
            { protocol: PROTOCOL, sessionId: nextSession, type: 'PING', payload: {} },
            validatedExternalOrigin
          );
        } catch (_e) {}
      };
      fresh.addEventListener('load', () => {
        sendPing();
        if (pingInterval) clearInterval(pingInterval);
        pingInterval = setInterval(sendPing, 300);
      });
      mountEl.innerHTML = '';
      mountEl.appendChild(fresh);
      iframe = fresh;

      handshakeTimer = setTimeout(() => {
        if (!bridgeAck && sessionId === nextSession) {
          if (sourceKind === 'official') {
            mountLocalSrcDoc(
              `ℹ️ 官方实验回退提示：独立跨站沙盒 (${validatedExternalOrigin}) 握手超时，官方预设实验已在明确提示后回退至本地 Opaque srcdoc 强隔离模式。`
            );
          } else {
            mountFailClosed(
              `🛑 [Sandbox Fail-Closed] 独立跨站沙盒 (${validatedExternalOrigin}) 不可达，非官方实验禁止降级执行，已强制失败关闭。`
            );
          }
        }
      }, 4500);
    };

    const handleInboundMessage = (evt) => {
      if (!useExternalBridge || !iframe || evt.source !== iframe.contentWindow) return;
      if (evt.origin !== validatedExternalOrigin || !evt.data || evt.data.protocol !== PROTOCOL) return;

      if (
        evt.data.type === 'SANDBOX_BRIDGE_READY' &&
        !bridgeSent &&
        (evt.data.sessionId === sessionId || evt.data.sessionId === '__bridge_init__')
      ) {
        const themedDoc = buildFreshRuntimeSrcDoc(readTheme(), sessionId);
        if (!themedDoc) {
          mountFailClosed('[Sandbox Fail-Closed] 无法签发一次性 CSP Nonce，已阻断沙盒运行。');
          return;
        }
        bridgeAck = true;
        bridgeSent = true;
        clearBridgeTimers();
        iframe.contentWindow?.postMessage(
          {
            protocol: PROTOCOL,
            sessionId,
            type: 'EXECUTE_CODE',
            payload: { srcDoc: themedDoc },
          },
          validatedExternalOrigin
        );
      } else if (evt.data.type === 'SANDBOX_READY' && evt.data.sessionId === sessionId) {
        bridgeAck = true;
        clearBridgeTimers();
      }
    };
    window.addEventListener('message', handleInboundMessage);

    if (sourceKind !== 'official') {
      // 非官方代码严禁自动执行
      mountFailClosed(
        '⚠️ 非官方代码已禁止在独立预览页自动运行，请前往代码工坊审阅并在独立跨站沙盒可用时手动运行。'
      );
    } else if (hasValidExternalOrigin) {
      mountCrossOriginBridge();
    } else {
      mountLocalSrcDoc();
    }

    const themeObs = new MutationObserver(() => {
      const nextTheme = readTheme();
      if (iframe && iframe.contentWindow) {
        if (useExternalBridge && !bridgeAck) return;
        const target = useExternalBridge ? validatedExternalOrigin : '*';
        try {
          iframe.contentWindow.postMessage(
            {
              protocol: PROTOCOL,
              sessionId,
              type: 'SET_THEME',
              payload: { theme: nextTheme },
            },
            target
          );
        } catch (_e) {}
      }
    });
    themeObs.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    const cleanupStandalonePreview = () => {
      clearBridgeTimers();
      themeObs.disconnect();
      window.removeEventListener('message', handleInboundMessage);
      if (useExternalBridge && bridgeAck && validatedExternalOrigin && iframe?.contentWindow && sessionId) {
        try {
          iframe.contentWindow.postMessage(
            { protocol: PROTOCOL, sessionId, type: 'TERMINATE_SESSION', payload: {} },
            validatedExternalOrigin
          );
        } catch (_e) {}
      }
      if (mountEl) mountEl.innerHTML = '';
      iframe = null;
    };
    window.addEventListener('pagehide', cleanupStandalonePreview, { once: true });

    if (reloadBtn) {
      reloadBtn.addEventListener('click', () => {
        if (sourceKind !== 'official') {
          if (hasValidExternalOrigin) {
            mountCrossOriginBridge();
          } else {
            mountFailClosed(
              '🛑 [Sandbox Fail-Closed] 独立跨站沙盒未配置或不可用，非官方实验禁止运行。'
            );
          }
          return;
        }
        if (hasValidExternalOrigin) {
          mountCrossOriginBridge();
        } else {
          mountLocalSrcDoc();
        }
      });
    }
  })();
</script>

<style>
  .lab-standalone-preview {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px 20px 60px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .preview-nav-shell {
    padding: 12px 18px;
    border-radius: 8px;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--style-border, #e2e8f0);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  :root[data-theme='dark'] .preview-nav-shell {
    background: #181c27;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .preview-nav__left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .preview-back-btn,
  .preview-action-btn {
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid var(--line-strong, #cbd5e1);
    background: #ffffff;
    color: var(--font-color, #1e293b);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .preview-action-btn.is-primary {
    background: #425aef;
    border-color: #425aef;
    color: #ffffff;
  }

  :root[data-theme='dark'] .preview-back-btn,
  :root[data-theme='dark'] .preview-action-btn {
    background: #1e2433;
    border-color: rgba(255, 255, 255, 0.14);
    color: #f1f5f9;
  }

  :root[data-theme='dark'] .preview-action-btn.is-primary {
    background: #425aef;
    color: #ffffff;
  }

  .preview-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    flex-wrap: wrap;
  }

  .preview-sec-tag {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(16, 185, 129, 0.12);
    color: #059669;
  }

  .preview-nav__right {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .preview-stage-card {
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--style-border, #e2e8f0);
    background: var(--card-bg, #0f1420);
    height: calc(100vh - 210px);
    min-height: 460px;
  }

  .preview-fallback-notice {
    padding: 10px 14px;
    border-radius: 8px;
    background: rgba(66, 90, 239, 0.08);
    border: 1px solid rgba(66, 90, 239, 0.32);
    color: #1e40af;
    font-size: 12px;
    line-height: 1.5;
  }

  :root[data-theme='dark'] .preview-fallback-notice {
    color: #bfdbfe;
    background: rgba(66, 90, 239, 0.16);
  }

  .preview-fallback-notice.is-fail-closed {
    background: rgba(239, 68, 68, 0.12);
    border-color: rgba(239, 68, 68, 0.45);
    color: #b91c1c;
  }

  :root[data-theme='dark'] .preview-fallback-notice.is-fail-closed {
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.18);
  }

  .preview-fail-closed-box {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    color: #fca5a5;
    font-size: 13px;
  }

  .standalone-sandbox-frame {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
</style>
