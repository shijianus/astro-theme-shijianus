{
  "extends": "astro/tsconfigs/base",
  "include": [
    ".astro/types.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "themes",
    "scratch",
    "scripts",
    "src/components/theme/GuestbookBoard.tsx",
    "src/components/ThemeOverlays.tsx",
    "src/components/theme/PostComments.tsx"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}