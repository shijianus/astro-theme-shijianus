{
  "name": "shijianus-blog-v2",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "start": "astro dev --host 0.0.0.0",
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "preview:host": "astro preview --host 0.0.0.0",
    "broadcast:sync": "node scripts/sync-broadcast.mjs",
    "sync:i18n": "node scripts/sync-post-i18n.mjs",
    "i18n:translate": "node scripts/sync-post-i18n.mjs --cli",
    "console:sync": "node scripts/sync-console-metrics.mjs",
    "version:sync": "node scripts/sync-content-versions.mjs",
    "moments:sync": "node scripts/sync-friends-moments.mjs",
    "prebuild": "node scripts/sync-lab-sandbox-env.mjs && node scripts/sync-content-versions.mjs && node scripts/sync-broadcast.mjs && node scripts/sync-post-i18n.mjs && node scripts/sync-console-metrics.mjs && node scripts/sync-friends-moments.mjs",
    "build": "node scripts/sync-lab-sandbox-env.mjs && node scripts/sync-content-versions.mjs && node scripts/sync-broadcast.mjs && node scripts/sync-post-i18n.mjs && node scripts/sync-console-metrics.mjs && node scripts/sync-friends-moments.mjs && BLOG_BUILD_TARGET=static PUBLIC_STATIC_EXPORT=1 astro build",
    "build:static": "node scripts/sync-lab-sandbox-env.mjs && node scripts/sync-content-versions.mjs && node scripts/sync-broadcast.mjs && node scripts/sync-post-i18n.mjs && node scripts/sync-console-metrics.mjs && node scripts/sync-friends-moments.mjs && BLOG_BUILD_TARGET=static PUBLIC_STATIC_EXPORT=1 astro build",
    "clean": "node scripts/clean.mjs",
    "build:clean": "npm run clean && npm run build",
    "pages:build": "npm run clean && npm run build:static",
    "pages:dev": "npm run pages:build && wrangler pages dev dist --compatibility-date=2026-04-27",
    "cf:d1:create": "wrangler d1 create shijianus-blog-db",
    "cf:d1:migrate": "wrangler d1 migrations apply DB --remote",
    "cf:deploy": "npm run pages:build && wrangler pages deploy dist --project-name shijianus-blog --branch main --commit-dirty=true",
    "new:post": "node scripts/new-content.mjs --type post",
    "new:draft": "node scripts/new-content.mjs --type draft",
    "new:page": "node scripts/new-content.mjs --type page",
    "repo:remote": "node scripts/repo-remote.mjs",
    "repo:push": "node scripts/repo-push.mjs",
    "repo:publish": "node scripts/repo-publish.mjs",
    "brand": "node scripts/brand-banner.mjs",
    "test:brand": "node scripts/brand-banner.mjs",
    "audit:gate": "node scripts/verify-audit-exceptions.mjs",
    "license:report": "node scripts/generate-license-report.mjs",
    "test:i18n": "node scripts/audit-article-translation-variants.mjs",
    "test:lab:gate": "node scripts/verify-lab-release-gate.mjs",
    "test:lab:browsers": "node scripts/verify-lab-platform.mjs",
    "test:lab:preview": "node scripts/verify-lab-cloudflare-preview.mjs",
    "sandbox:dry-run:prod": "node scripts/deploy-lab-sandbox.mjs --project-name epocanvas-lab-sandbox --env production --dry-run",
    "sandbox:dry-run:staging": "node scripts/deploy-lab-sandbox.mjs --project-name epocanvas-lab-sandbox-staging --env staging --dry-run",
    "test": "node scripts/brand-banner.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/node": "^11.1.11",
    "@astrojs/react": "^7.1.4",
    "@stripe/stripe-js": "^9.15.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.4.7",
    "clsx": "^2.1.1",
    "js-yaml": "^5.5.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.460.0",
    "markmap-lib": "^0.18.12",
    "markmap-toolbar": "^0.18.12",
    "markmap-view": "^0.18.12",
    "maxmind": "^5.0.6",
    "mermaid": "^12.3.0",
    "opencc-js": "^1.0.5",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/js-yaml": "^4.0.9",
    "autoprefixer": "^10.5.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.13",
    "puppeteer": "^25.17.0",
    "simple-icons": "^16.29.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.11.35",
    "browserslist": "^4.29.5",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "markdown-it": "^14.3.3",
    "sharp": "^0.35.5",
    "undici": "^7.30.2",
    "vite": "^7.3.8",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  }
}
